  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Generates and sends syslog or Kafka telemetry events.</data>
    </node>
    <node id="1">
      <data key="d5">S3 Telemetry Logs</data>
      <data key="d6">S3</data>
      <data key="d7">AWS telemetry log source stored in S3.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Notification service trigger for log notifications.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers events for ingestion workflows.</data>
    </node>
    <node id="4">
      <data key="d5">AWS CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Records AWS API activities and events.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon GuardDuty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Intelligent threat detection log source.</data>
    </node>
    <node id="6">
      <data key="d5">Apache NiFi</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Builds workflows to pull telemetry events from AWS.</data>
    </node>
    <node id="7">
      <data key="d5">Apache Metron</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">The heart of the SOC. Handles parsing, enrichment, and real-time profiling.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR jobs pick up persistent data from HDFS and transform it into S3 format.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Serverless data lake holding months or years of long-term security telemetry.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries the data lake using SQL to build long-term models and forensics.</data>
    </node>
    <node id="11">
      <data key="d5">SOAR (Blitz)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Security Orchestration, Automation, and Response platform (open source).</data>
    </node>
    <node id="12">
      <data key="d5">SOC Analyst</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Analyst who triages issues on a single pane of glass and triggers mitigation actions.</data>
    </node>
    <node id="13">
      <data key="d5">AWS WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall used to block malicious IP sources.</data>
    </node>
    <edge source="0" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Directly ingests syslog or Kafka events into Apache Metron.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">NiFi pulls log files from S3.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">NiFi integrates with SNS events.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">NiFi consumes events from SQS queue.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">NiFi pulls CloudTrail audit logs.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">NiFi ingests GuardDuty security findings.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">NiFi ingests aggregated AWS telemetry into Apache Metron.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Persistent HDFS telemetry data is picked up by EMR.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Apache Metron pushes security alerts to Blitz SOAR.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR writes transformed security logs into the long-term S3 Security Data Lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena performs interactive SQL queries and log mining.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Feeds model and profiling updates from Athena analytics back into Apache Metron.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">Blitz orchestrates, enriches, and displays alerts to the SOC Analyst.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="12" target="13" id="0">
      <data key="d8">2</data>
      <data key="d9">Analyst triggers block instructions on AWS WAF at the click of a button.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">MakeMyTrip next-gen Security Operations Center (SOC) Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-3lnf5lzsH0</data>
    <data key="d2">An automated and semi-automated SOC platform processing ~5000 events per second and indexing over 250 million events per day in a security data lake.</data>
    <data key="d3">Security, Threat Detection, Data Lake</data>
