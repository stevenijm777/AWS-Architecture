<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">AWS public cloud data sources generating telemetry events like CloudTrail, GuardDuty, S3, SQS, and SNS.</data>
    </node>
    <node id="1">
      <data key="d5">ON-PREM</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premise data center telemetry sources integrated via Syslog and Kafka.</data>
    </node>
    <node id="2">
      <data key="d5">APACHE METRON</data>
      <data key="d6">EC2</data>
      <data key="d7">Central stream processing and ingestion engine that parses, enriches, and tags telemetry logs in real time.</data>
    </node>
    <node id="3">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Amazon EMR cluster running batch jobs to extract HDFS telemetry data from Metron and transform it into S3.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central Security Data Lake bucket storing long-term telemetry log events.</data>
    </node>
    <node id="5">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query engine used for log mining, analytics, forensics, and SQL queries against S3 data.</data>
    </node>
    <node id="6">
      <data key="d5">SOAR</data>
      <data key="d6">EC2</data>
      <data key="d7">Security Orchestration, Automation, and Response platform (Blitz) for incident response and alert contextualization.</data>
    </node>
    <node id="7">
      <data key="d5">ALERTS</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">SOC Analyst team receiving unified alert notifications and actionable context.</data>
    </node>
    <node id="8">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF service used for automated and semi-automated incident response actions like IP blocking.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS cloud telemetry logs ingested into Apache Metron.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premise Syslog/Kafka logs ingested into Apache Metron.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR job extracts persistent telemetry log data from Apache Metron HDFS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Apache Metron forwards real-time security alerts to the Blitz SOAR platform.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR transforms and stores telemetry logs into Amazon S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries log data stored in S3 for security analytics and log mining.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Long-term profiles and ML behavioral models generated in Security Data Lake fed back into Apache Metron.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">SOAR platform enriches alert details and delivers actionable insights to SOC Analysts.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">SOC Analyst triggers automated mitigation actions on AWS WAF to block detected threats.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">MakeMyTrip Next-Gen SOC Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-3lnf5lzsH0</data>
    <data key="d2">MakeMyTrip built a Next-Gen SOC system using Apache Metron, a serverless Security Data Lake (EMR, S3, Athena), and Blitz SOAR for real-time behavioral anomaly detection and incident response.</data>
    <data key="d3">Security, Data Lake, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
