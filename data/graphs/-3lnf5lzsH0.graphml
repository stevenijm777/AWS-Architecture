  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS Source S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket acting as a telemetry event source.</data>
    </node>
    <node id="1">
      <data key="d5">AWS Source SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">SNS topic acting as a telemetry event source.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Source SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS queue acting as a telemetry event source.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Source CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">AWS CloudTrail logs acting as a telemetry event source.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Source GuardDuty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">AWS GuardDuty findings acting as a telemetry event source.</data>
    </node>
    <node id="5">
      <data key="d5">On-Premises Data Sources</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premise syslog or Kafka event sources.</data>
    </node>
    <node id="6">
      <data key="d5">Apache Metron</data>
      <data key="d6">EC2</data>
      <data key="d7">Stream processing layer running Apache Metron for parsing, enrichment, and profiling.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR cluster running jobs to transform persistent data from Metron's HDFS backbone.</data>
    </node>
    <node id="8">
      <data key="d5">Security Data Lake S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing transformed telemetry events over a long period of time.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Amazon Athena used for SQL queries, log mining, analytics, and forensics.</data>
    </node>
    <node id="10">
      <data key="d5">SOAR (Blitz)</data>
      <data key="d6">EC2</data>
      <data key="d7">Security Orchestration, Automation, and Response (SOAR) platform called Blitz.</data>
    </node>
    <node id="11">
      <data key="d5">SOC Analysts</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Security Operations Center analysts triaging alerts.</data>
    </node>
    <node id="12">
      <data key="d5">AWS WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF used for automated or analyst-triggered threat mitigation.</data>
    </node>
