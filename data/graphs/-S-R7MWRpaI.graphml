<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Supernode (SN Top)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Edge supernode registered with EKS and discovery service.</data>
    </node>
    <node id="1">
      <data key="d5">Supernode (SN Middle)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Edge supernode listening to local edge nodes and registering them.</data>
    </node>
    <node id="2">
      <data key="d5">Node (N)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Standard edge device node (e.g., Android/iOS) connecting to a supernode.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs central discovery service (MDS) and orchestrates edge node registrations.</data>
    </node>
    <node id="4">
      <data key="d5">MongoDB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Document database used to define node clusters by proximity.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores profiles and hierarchical peer associations for microservice management.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Kinesis Data Streams</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingests API logs and operational metrics at high throughput.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams incoming log data directly into S3 long-term storage.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Archive destination for raw telemetry and operational logs.</data>
    </node>
    <node id="9">
      <data key="d5">Snowflake</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data warehouse running SQL queries against archived data in S3 for real-time and historical analytics.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Supernode registers directly with EKS discovery service.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Supernode registers the newly discovered edge node with EKS.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">New edge node listens and connects to local supernode.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS persists node discovery metadata into MongoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS updates profile and peer association details in DynamoDB.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API logs and operational telemetry are forwarded to Kinesis Data Streams.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis Data Streams pushes continuous data stream to Kinesis Data Firehose.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis Data Firehose writes stream batches to Amazon S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Snowflake queries S3 directly for real-time and long-term analytics.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mimic Edge Engine Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-S-R7MWRpaI</data>
    <data key="d2">Architecture for Mimic Edge Engine enabling edge microservices on mobile devices with central discovery on EKS and analytics pipeline via Kinesis, S3, and Snowflake.</data>
    <data key="d3">Edge Computing, Analytics, Serverless &amp; Data Mesh</data>
    <data key="d4">True</data>
  </graph>
</graphml>
