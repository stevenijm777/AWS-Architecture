<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts multi-tenant SaaS loan origination system running on dedicated pods per tenant for isolation.</data>
    </node>
    <node id="1">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">PostgreSQL database storing customer data in isolated schemas per tenant.</data>
    </node>
    <node id="2">
      <data key="d5">TRANSIT GATEWAY</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Peers multi-tenant application VPC with single-tenant customer analytics VPCs.</data>
    </node>
    <node id="3">
      <data key="d5">CONTROL TOWER</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Automates onboarding of new tenants by provisioning new single-tenant AWS accounts via Account Factory for Terraform.</data>
    </node>
    <node id="4">
      <data key="d5">QUICKSIGHT</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Pre-provisioned in single-tenant accounts to allow customers to visualize loan origination data.</data>
    </node>
    <node id="5">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">Establishes secure IPSec connection to customer on-premises data sources (or Direct Connect).</data>
    </node>
    <node id="6">
      <data key="d5">CUST DATA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises customer data sources from community banks integrated into QuickSight dashboards.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS pods write application data into tenant-isolated Aurora database schemas.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Transit Gateway routes data requests from QuickSight to Postgres Aurora.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Control Tower provisions the single-tenant account pre-configured with QuickSight.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">QuickSight sends query traffic through Transit Gateway to access backend database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">VPN delivers on-premises bank data to QuickSight to combine with loan origination data.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">On-premises customer data travels across VPN into the single-tenant AWS environment.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Summit Technology Group Single-Tenant Data Consumption Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-ahWdCysMYw</data>
    <data key="d2">Architecture for Summit Technology Group's multi-tenant loan origination system on AWS EKS and Aurora, enabling single-tenant data consumption via QuickSight, Transit Gateway, AWS Control Tower, and VPN integration to on-premises customer data.</data>
    <data key="d3">Analytics, Multi-Tenant SaaS, Hybrid Cloud</data>
    <data key="d4">True</data>
  </graph>
</graphml>
