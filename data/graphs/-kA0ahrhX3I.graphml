  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Security Engineers</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Analyze findings and work with bucket owners to remediate security risks.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Macie (Top Right)</data>
      <data key="d6">Macie</data>
      <data key="d7">Scans S3 buckets in the top-right AWS account for sensitive data.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon S3 (Top Right)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket being scanned in the top-right AWS account.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Macie (Bottom Right)</data>
      <data key="d6">Macie</data>
      <data key="d7">Scans S3 buckets in the bottom-right AWS account for sensitive data.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon S3 (Bottom Right)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket being scanned in the bottom-right AWS account.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Macie (Main)</data>
      <data key="d6">Macie</data>
      <data key="d7">Main account Macie instance aggregating findings.</data>
    </node>
    <node id="6">
      <data key="d5">S3 Bucket (Findings)</data>
      <data key="d6">S3</data>
      <data key="d7">Central S3 bucket storing aggregated Macie findings metadata.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries findings stored in the central S3 bucket using SQL.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualizes findings and builds dashboards to tell a better story of risky buckets.</data>
    </node>
    <node id="9">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Automates ETL processes to load and aggregate findings data.</data>
    </node>
    <node id="10">
      <data key="d5">MySQL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">MySQL database used as a data lake to store aggregated findings.</data>
    </node>
