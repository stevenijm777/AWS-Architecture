<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Security Engineers</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Interact with QuickSight dashboards to review PII findings and initiate remediation with data owners.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Macie (Main)</data>
      <data key="d6">Macie</data>
      <data key="d7">Acts as the central administrator for Amazon Macie, aggregating findings and exporting them to the S3 bucket.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Macie (Top Right)</data>
      <data key="d6">Macie</data>
      <data key="d7">Scans S3 buckets in the first external production AWS account.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon S3 (Top Right)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Production S3 bucket being scanned for sensitive information such as SSNs and ITINs.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Macie (Bottom Right)</data>
      <data key="d6">Macie</data>
      <data key="d7">Scans S3 buckets in the second external production AWS account.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon S3 (Bottom Right)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Production S3 bucket containing financial and customer data being scanned.</data>
    </node>
    <node id="6">
      <data key="d5">S3 Findings Bucket</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Central repository storing findings and metadata. No raw PII is written to this bucket.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Provides SQL query capability over findings stored in the S3 findings bucket.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Performs ETL processes to automatically fetch, transform, and aggregate findings data.</data>
    </node>
    <node id="9">
      <data key="d5">MySQL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External/custom MySQL database serving as the main data lake for consolidated findings.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualizes top risky S3 buckets by PII type, telling a better story for targeted remediation.</data>
    </node>
    <edge source="0" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Security engineers interact with QuickSight dashboards to discover and remediate PII exposures.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Central Macie writes findings and metadata into the centralized S3 findings bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie triggers scans and inspects S3 object contents in the top-right account.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie triggers scans and inspects S3 object contents in the bottom-right account.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries raw JSON finding metadata directly from the findings bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue jobs read findings from S3 to execute transformation pipelines.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue loads and aggregates structured finding results into the MySQL data lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">QuickSight queries Athena to load security findings dynamic dashboards.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Opportune Automated Sensitive Data Discovery and Remediation with Amazon Macie</data>
    <data key="d1">https://www.youtube.com/watch?v=-kA0ahrhX3I</data>
    <data key="d2">An AWS Organization-wide data discovery posture management (DSPM) architecture. Macie scans S3 buckets across multiple member production accounts, centralizes discovery metadata in an S3 findings bucket, runs Athena and Glue ETL to populate a MySQL data lake, and visualizes top-risk buckets using Amazon QuickSight.</data>
    <data key="d3">Security, Identity, &amp; Compliance; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
