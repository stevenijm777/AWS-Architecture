  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon Macie (Central)</data>
      <data key="d6">Macie</data>
      <data key="d7">Central Macie instance aggregating sensitive data discovery finding metadata.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3 (Central Bucket)</data>
      <data key="d6">S3</data>
      <data key="d7">Central S3 bucket storing aggregated finding metadata (no raw PII).</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL-based discovery tool that queries finding metadata directly in S3.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">BI dashboard tool used to present risky bucket findings and remediation metrics.</data>
    </node>
    <node id="4">
      <data key="d5">MySQL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom MySQL data lake for aggregated finding storage.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Automates processes that extract, load, and aggregate finding data.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Macie (Account 1)</data>
      <data key="d6">Macie</data>
      <data key="d7">Macie instance monitoring Account 1 production S3 buckets.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Simple Storage Service (Account 1)</data>
      <data key="d6">S3</data>
      <data key="d7">Production S3 bucket in Account 1 scanned for sensitive data.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Macie (Account 2)</data>
      <data key="d6">Macie</data>
      <data key="d7">Macie instance monitoring Account 2 production S3 buckets.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Simple Storage Service (Account 2)</data>
      <data key="d6">S3</data>
      <data key="d7">Production S3 bucket in Account 2 scanned for sensitive data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie exports sensitive data discovery findings into the central S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Findings data is synchronized and loaded into the MySQL data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries finding metadata stored in the central S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">QuickSight retrieves finding metadata from S3/Athena to visualize DSPM dashboards.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Bidirectional synchronization occurs between central S3 findings and MySQL data lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue runs automated workflows to process and aggregate finding data.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie scans S3 bucket in Account 1 for sensitive data.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie scans S3 bucket in Account 2 for sensitive data.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">AWS Data Security Posture Management with Macie and Athena</data>
    <data key="d1">https://www.youtube.com/watch?v=-kA0ahrhX3I</data>
    <data key="d2">Architecture illustrating automated data security posture management (DSPM) across multiple AWS accounts using Amazon Macie, central S3 finding aggregation, Athena querying, Glue ETL automation, and QuickSight visualization alongside a custom MySQL data lake.</data>
    <data key="d3">Security, Data Governance, Analytics</data>
    <data key="d4">True</data>
  </graph>
