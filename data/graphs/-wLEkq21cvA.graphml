<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ON-PREM</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises server stack containing the source servers to be migrated.</data>
    </node>
    <node id="1">
      <data key="d5">SLACK</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Slack chatops interface used to trigger migration commands.</data>
    </node>
    <node id="2">
      <data key="d5">APP DISCOVERY SERVICE</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">AWS Application Discovery Service collecting metadata and performance metrics from on-premises servers.</data>
    </node>
    <node id="3">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB database storing migration metadata, target configurations, and tags.</data>
    </node>
    <node id="4">
      <data key="d5">MIGRATION FACTORY EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">The Migration Factory EC2 instance orchestrating the migration workflow.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 HOT REPLICA</data>
      <data key="d6">EC2</data>
      <data key="d7">Staging EC2 instance receiving continuous block-level replication from the on-premises server.</data>
    </node>
    <node id="6">
      <data key="d5">CLOUDENDURE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">CloudEndure migration service performing continuous volume replication.</data>
    </node>
    <node id="7">
      <data key="d5">BAKE AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">Amazon Machine Image baked from the hot replica.</data>
    </node>
    <node id="8">
      <data key="d5">SHARED AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">AMI shared securely with the target AWS account.</data>
    </node>
    <node id="9">
      <data key="d5">EC2 TARGET</data>
      <data key="d6">EC2</data>
      <data key="d7">The final launched EC2 instance in the target account, configured with tags and proper sizing.</data>
    </node>
    <edge source="0" target="2">
      <data key="d8">0</data>
      <data key="d9">Inbound/outbound TCP connections and performance metrics collected by agent.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="0" target="5">
      <data key="d8">0</data>
      <data key="d9">Continuous block-by-block volume replication.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="4">
      <data key="d8">1</data>
      <data key="d9">Triggers migration factory via API call from Slack command.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="2">
      <data key="d8">1</data>
      <data key="d9">Queries server metadata and performance metrics.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="3">
      <data key="d8">1</data>
      <data key="d9">Reads target metadata, configurations, and tags.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="6">
      <data key="d8">1</data>
      <data key="d9">API call to stop replication.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="7">
      <data key="d8">1</data>
      <data key="d9">Triggers AMI baking from the hot replica.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="9">
      <data key="d8">1</data>
      <data key="d9">Launches and configures the target EC2 instance using shared AMI and DynamoDB metadata.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="5">
      <data key="d8">0</data>
      <data key="d9">Manages the hot replica instance and replication process.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="8">
      <data key="d8">1</data>
      <data key="d9">Shares the baked AMI to the target account using encryption.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Versent: The Migration Factory</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">This architecture demonstrates an automated migration factory that reduces migration time from 4 hours to 10 minutes. It uses AWS Application Discovery Service for metadata collection, CloudEndure for continuous block-level replication, DynamoDB for target metadata/tags, and an EC2-based Migration Factory triggered via Slack to orchestrate the final cutover and target instance launch.</data>
    <data key="d3">Migration, Automation, DevOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
