<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">MIGRATION TEAM</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Operations and migration team initiating and configuring migration runs.</data>
    </node>
    <node id="1">
      <data key="d5">SLACK</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">ChatOps interface used to trigger migration commands via API call.</data>
    </node>
    <node id="2">
      <data key="d5">ON-PREM</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises source servers being migrated to AWS.</data>
    </node>
    <node id="3">
      <data key="d5">APP DISCOVERY SERVICE</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Collects inbound/outbound TCP connections and utilization data from on-premises servers.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores target account metadata, subnet, IP addresses, RTO/RPO, and EC2 tags (~10 tags per instance).</data>
    </node>
    <node id="5">
      <data key="d5">EC2 (Migration Factory)</data>
      <data key="d6">EC2</data>
      <data key="d7">Central orchestrator running API integrations to coordinate discovery, CloudEndure, AMI baking, and deployment.</data>
    </node>
    <node id="6">
      <data key="d5">CLOUDENDURE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Manages continuous block-level volume replication from on-premises to AWS.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 HOT REPLICA</data>
      <data key="d6">EC2</data>
      <data key="d7">Staging instance in AWS receiving continuous live block replication.</data>
    </node>
    <node id="8">
      <data key="d5">BAKE AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">Amazon Machine Image created from the hot replica staging disk.</data>
    </node>
    <node id="9">
      <data key="d5">SHARED AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">Encrypted AMI shared across account boundaries into the destination target account.</data>
    </node>
    <node id="10">
      <data key="d5">EC2 (Target Account)</data>
      <data key="d6">EC2</data>
      <data key="d7">Final production instance launched in target AWS account with populated sizing, IP, and tags.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration team populates operational metadata and target specifications into DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration team issues single command in Slack to start migration.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Slack calls API endpoint on EC2 Migration Factory instance.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Discovery agent sends TCP connection and resource utilization metadata to Application Discovery Service.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises server continuously replicates block-level data to EC2 Hot Replica.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory queries Application Discovery Service for connection metadata.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory retrieves target account, subnet, IP, and tagging metadata from DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory calls CloudEndure API to stop continuous block replication.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory triggers AMI baking from the staging hot replica.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory shares encrypted AMI to the target account.</data>
      <data key="d10">7</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory launches final EC2 instance in target account with sizing, IP, and tags.</data>
      <data key="d10">8</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudEndure halts replication state on EC2 Hot Replica.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Versent Automated Migration Factory Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Automated migration factory pipeline using CloudEndure, Application Discovery Service, DynamoDB, Slack, and EC2 to orchestrate fast, 10-minute server migrations into AWS target accounts.</data>
    <data key="d3">Migration &amp; Transfer, Automation, Compute</data>
    <data key="d4">True</data>
  </graph>
</graphml>
