<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Migration Team</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Initiates the automated migration process and sets up configurations.</data>
    </node>
    <node id="1">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Receives chat commands to trigger the migration workflow via API call.</data>
    </node>
    <node id="2">
      <data key="d5">On-Premises Server</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">The source servers running discovery and replication agents.</data>
    </node>
    <node id="3">
      <data key="d5">Application Discovery Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Gathers TCP mapping, system metadata, and utilization metrics.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores migration metadata, target accounts, tags, IPs, and RTO/RPO requirements.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 (Migration Factory)</data>
      <data key="d6">EC2</data>
      <data key="d7">The orchestration server running scripts to automate the migration process.</data>
    </node>
    <node id="6">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Manages block-level volume replication to the replication instance.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Hot Replica</data>
      <data key="d6">EC2</data>
      <data key="d7">The replication instance receiving live updates from the on-premises server.</data>
    </node>
    <node id="8">
      <data key="d5">Target EC2 Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">The final launched server in the target AWS account.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration team populates target configurations, tags, subnets, and IPs into DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration team triggers the migration using a Slack command.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Slack makes an API call to initiate execution on the EC2 Migration Factory orchestrator.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Application Discovery Service agent collects TCP dependencies and system resource usage.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">On-prem data is replicated continuously block-by-block using CloudEndure agents.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory queries Application Discovery Service for TCP connections and performance metrics.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory retrieves target metadata, instance sizes, and custom tags from DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory requests CloudEndure to halt active block-level replication.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory creates (bakes) an Amazon Machine Image (AMI) from the EC2 Hot Replica volumes.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory shares the baked AMI with the target account and launches the final target EC2 instance with custom tagging and network configurations.</data>
      <data key="d10">7</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudEndure agent pauses the continuous replication to prepare for AMI creation.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Automated AWS Migration Factory Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Automates the migration of on-premises servers to AWS in approximately 10 minutes per server by utilizing CloudEndure and AWS Application Discovery Service coordinated by an EC2-hosted Migration Factory.</data>
    <data key="d3">Migration, Orchestration, Automation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
