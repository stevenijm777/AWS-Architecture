<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">UI Portal</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Frontend portal where data scientists upload model artifacts, library dependencies, and attribute files.</data>
    </node>
    <node id="1">
      <data key="d5">AWS Fargate (Platform API)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Platform API backend that handles initial upload requests, registers models, stores artifacts, and initiates builds.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon OpenSearch Service</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Serves as the model registry datastore for tracking model entries and endpoint metadata.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded raw model artifacts, pickle files, and code dependencies.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon MSK</data>
      <data key="d6">MSK</data>
      <data key="d7">Managed Streaming for Apache Kafka, orchestrates asynchronous build triggers and deployment status updates.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Build machine running Docker that compiles artifacts into SageMaker-compatible container images.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Container registry storing built Docker images for SageMaker deployment.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Provisions managed endpoints, applies auto-scaling policies, and performs ML model inferencing.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Monitors SageMaker state changes and emits endpoint status events.</data>
    </node>
    <node id="9">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes EventBridge status events and posts updates back to Kafka.</data>
    </node>
    <node id="10">
      <data key="d5">AWS Fargate (Consumer App)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Consumer application processing completion events to update OpenSearch and return deployment status to the UI Portal.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User submits upload request via UI Portal to the Platform API.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Platform API creates an initial entry in the OpenSearch model registry.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Platform API writes uploaded model artifacts to S3.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Platform API emits a build initiation event to an MSK Kafka topic.</data>
      <data key="d10">1''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">MSK event triggers the build process on the EC2 build machine.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">MSK triggers the consumer application running on AWS Fargate.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 build machine fetches model artifacts from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 builds Docker container image and pushes it to Amazon ECR.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 creates SageMaker endpoint configuration and deploys the model endpoint.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">SageMaker emits endpoint status change events to EventBridge.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">EventBridge triggers AWS Lambda function upon endpoint state change.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda function writes deployment status notification event to Kafka topic.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">Consumer app updates UI Portal with deployment success/failure status.</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Consumer app updates endpoint details in OpenSearch model registry.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Experian Custom Model Onboarding Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=-yCol_7qH2U</data>
    <data key="d2">Architecture for rapidly onboarding custom client machine learning models at Experian, taking build-to-production time from months to days using MSK, SageMaker, EC2, and Fargate.</data>
    <data key="d3">Machine Learning, Event-Driven Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
