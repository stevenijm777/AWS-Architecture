<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End user requesting photo animation and fetching generated video artifacts.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CloudFront CDN delivering generated animation artifacts with edge caching.</data>
    </node>
    <node id="2">
      <data key="d5">API</data>
      <data key="d6">EC2</data>
      <data key="d7">API server running on EC2 handling user requests, generating presigned S3 URLs, and serving status updates.</data>
    </node>
    <node id="3">
      <data key="d5">MySQL</data>
      <data key="d6">RDS</data>
      <data key="d7">MySQL database holding user metadata, animation task status, and execution state.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing uploaded ancestor photos and output animation media files.</data>
    </node>
    <node id="5">
      <data key="d5">Main SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Main queue holding incoming photo animation work requests in the primary region.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function dynamically routing animation tasks across AWS regions based on spot capacity.</data>
    </node>
    <node id="7">
      <data key="d5">GPU</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 GPU instance fleet in main region executing deep learning photo animations.</data>
    </node>
    <node id="8">
      <data key="d5">Notification SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS queue receiving completion status notifications from GPU worker instances.</data>
    </node>
    <node id="9">
      <data key="d5">State Manager</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 State Manager instance consuming completion notifications and updating status in MySQL.</data>
    </node>
    <node id="10">
      <data key="d5">Regional SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Local SQS queue inside additional 5+ AWS regions receiving routed tasks.</data>
    </node>
    <node id="11">
      <data key="d5">Regional GPU</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 GPU instance fleet in additional 5+ AWS regions executing animation jobs.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">User initiates animation request to API server.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="1">
      <data key="d8">3</data>
      <data key="d9">User continuously polls API server for completion status.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">User directly uploads photo to S3 via pre-signed URL.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">3</data>
      <data key="d9">User downloads completed animation via CloudFront CDN.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">CloudFront fetches media artifacts from S3 bucket origin.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">API server generates pre-signed S3 URL for upload.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API server records task state in MySQL database.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API server enqueues animation task into Main SQS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Main SQS triggers Lambda function for cross-region distribution.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda routes tasks to Regional SQS in additional 5+ AWS regions.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Main region GPU worker fleet polls tasks from Main SQS.</data>
      <data key="d10">2'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">GPU worker stores generated animation output files directly into S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">GPU worker sends completion notification to Notification SQS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">State Manager consumes completion notification from Notification SQS.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">State Manager updates task status and results in MySQL database.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">State Manager notifies API server of task completion.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Regional GPU instances poll tasks from Regional SQS.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">MyHeritage - Deep Nostalgia Cross-Region GPU Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=0-db3wFRfSc</data>
    <data key="d2">Architecture for MyHeritage Deep Nostalgia processing over 50 million photo animations using cross-region EC2 GPU spot instances, SQS queues, Lambda routing, and CloudFront CDN delivery.</data>
    <data key="d3">Compute, Queueing, Serverless, Machine Learning, Storage</data>
    <data key="d4">True</data>
  </graph>
