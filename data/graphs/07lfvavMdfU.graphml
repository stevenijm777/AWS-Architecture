<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Uploads source video content from camera cards or remote devices.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Secure raw video ingestion bucket.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates video proxy creation, visual ML analysis, and audio translation workflows.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Elemental MediaConvert</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Generates low-resolution browser-friendly video proxies for preview and visual verification.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless function triggered by Step Functions to calculate video checksums and extract technical metadata.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Extracts timecoded visual metadata including celebrities, nudity, and safety tags.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts the audio track from the media file into raw text transcripts.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Performs Natural Language Processing to extract key entities and pinpoint occurrences of profanity.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">A temporary NoSQL store holding aggregated visual, technical, and linguistic metadata until ingested into Reach Engine.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Part of the Reach Engine hosting platform, providing scalable virtual servers for media orchestration.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Part of the Reach Engine hosting platform, orchestrating container workloads for video search, playback, and monetization UI.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User uploads raw media files directly to Amazon S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">An S3 upload event triggers the Step Functions orchestration state machine.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions initiates proxy transcoding inside Elemental MediaConvert.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions triggers Lambda functions to collect system-level metadata.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Step Functions triggers Amazon Rekognition to parse visual timeline markers.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Step Functions kicks off audio-to-text transcription via Amazon Transcribe.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Saves transcoded low-resolution file information and frame rate details to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda stores checksums and standard media details into DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Stores visual metadata linked with timecodes inside DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Forwards transcription text directly to Amazon Comprehend for entity analysis.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Stores text entities, sentiments, and profanity flags inside DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">4</data>
      <data key="d9">Aggregated metadata is ingested from DynamoDB into the Reach Engine platform running on EC2.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">4</data>
      <data key="d9">Aggregated metadata is ingested from DynamoDB into the Reach Engine platform running on EKS.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Levels Beyond Reach Engine - Media to Cloud Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=07lfvavMdfU</data>
    <data key="d2">A scalable, event-driven video ingestion pipeline that utilizes managed AWS machine learning services (Rekognition, Transcribe, Comprehend) and serverless compute to process and enrich video metadata for ingestion into Levels Beyond's Reach Engine platform running on EC2 and EKS.</data>
    <data key="d3">Media &amp; Entertainment, Serverless, Machine Learning, Container &amp; Compute</data>
    <data key="d4">True</data>
  </graph>
