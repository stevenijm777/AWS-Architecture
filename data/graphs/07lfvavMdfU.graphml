<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Uploads media files to S3 bucket to start the workflow.</data>
    </node>
    <node id="1">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded media files and triggers Step Functions.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the media processing and metadata extraction workflow.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Elemental MediaConvert</data>
      <data key="d6">MediaConvert</data>
      <data key="d7">Generates proxy videos for browser playback and extracts basic metadata.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Extracts checksums and standard technical metadata.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Identifies celebrities, violence, nudity, and other visual metadata with timecodes.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts audio from the media content into text.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Analyzes transcribed text to extract entities and detect profanity.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Acts as a temporary metadata store before ingestion into Reach Engine.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon EC2 (Reach Engine)</data>
      <data key="d6">EC2</data>
      <data key="d7">Part of the Reach Engine platform hosting orchestration and playback services.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon EKS (Reach Engine)</data>
      <data key="d6">EKS</data>
      <data key="d7">Part of the Reach Engine platform hosting containerized orchestration services.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">User uploads media file to S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">S3 upload triggers Step Functions workflow</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">Step Functions kicks off transcode job</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="4">
      <data key="d8">0</data>
      <data key="d9">Step Functions triggers Lambda functions</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="5">
      <data key="d8">1</data>
      <data key="d9">Step Functions triggers Rekognition for video analysis</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="6">
      <data key="d8">1</data>
      <data key="d9">Step Functions triggers Transcribe for audio-to-text</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="8">
      <data key="d8">0</data>
      <data key="d9">MediaConvert outputs proxy metadata to DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="8">
      <data key="d8">0</data>
      <data key="d9">Lambda stores checksums and technical metadata in DynamoDB</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="8">
      <data key="d8">1</data>
      <data key="d9">Rekognition stores visual metadata with timecodes in DynamoDB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="7">
      <data key="d8">1</data>
      <data key="d9">Transcribe sends text to Comprehend for analysis</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="8">
      <data key="d8">1</data>
      <data key="d9">Comprehend stores text analysis results in DynamoDB</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="8" target="9">
      <data key="d8">2</data>
      <data key="d9">DynamoDB data is ingested into Reach Engine (EC2)</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="8" target="10">
      <data key="d8">2</data>
      <data key="d9">DynamoDB data is ingested into Reach Engine (EKS)</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Levels Beyond: Digital Content Orchestration</data>
    <data key="d1">https://www.youtube.com/watch?v=07lfvavMdfU</data>
    <data key="d2">This architecture demonstrates Levels Beyond's Media to Cloud workflow using AWS Step Functions to orchestrate media transcoding via Elemental MediaConvert, metadata extraction via AWS Lambda, and AI/ML analysis via Rekognition, Transcribe, and Comprehend. All metadata is temporarily stored in DynamoDB before being ingested into the Reach Engine platform running on EC2 and EKS.</data>
    <data key="d3">Media &amp; Entertainment, AI/ML, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
