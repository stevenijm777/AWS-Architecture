  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores user-uploaded raw media files.</data>
    </node>
    <node id="1">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates media processing workflows.</data>
    </node>
    <node id="2">
      <data key="d5">Elemental MediaConvert</data>
      <data key="d6">MediaConvert</data>
      <data key="d7">Generates browser-playable video proxies.</data>
    </node>
    <node id="3">
      <data key="d5">Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Analyzes video for celebrities, violence, nudity, and visual metadata.</data>
    </node>
    <node id="4">
      <data key="d5">Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts audio from media files into text.</data>
    </node>
    <node id="5">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Extracts entities and analyzes sentiment/profanity from transcribed text.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Temporary metadata database store.</data>
    </node>
    <node id="7">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute instance hosting Reach Engine platform.</data>
    </node>
    <node id="8">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Container platform hosting Reach Engine microservices.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">File upload to S3 triggers AWS Step Functions workflow.</data>
