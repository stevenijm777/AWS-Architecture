  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">External DNS service handling initial domain resolution.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN distribution layer delivering content and caching requests.</data>
    </node>
    <node id="2">
      <data key="d5">Route 53 (Internal)</data>
      <data key="d6">Route53</data>
      <data key="d7">Internal DNS used for real-time weighted traffic distribution between ECS and API Gateway.</data>
    </node>
    <node id="3">
      <data key="d5">AWS SDK</data>
      <data key="d6">Lambda</data>
      <data key="d7">Logic component executing AWS SDK commands to dynamically adjust Route 53 weight parameters based on load.</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors system load and metrics to inform real-time weight adjustment.</data>
    </node>
    <node id="5">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Elastic Container Service managing containerized workload orchestration.</data>
    </node>
    <node id="6">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Serverless compute engine executing ECS container tasks.</data>
    </node>
    <node id="7">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API Gateway serving as entry point for serverless API endpoints.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute functions handling API requests during burst capacity.</data>
    </node>
    <node id="9">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory caching layer for fast response times and volatile data.</data>
    </node>
    <node id="10">
      <data key="d5">Document DB</data>
      <data key="d6">DocumentDB</data>
      <data key="d7">Document database stored for unstructured and high-read volume data.</data>
    </node>
    <node id="11">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database service handling primary transactional CRUD operations.</data>
    </node>
    <node id="12">
      <data key="d5">ElasticSearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Search engine for apartment address searches and application logging/troubleshooting.</data>
    </node>
    <edge source="0" target="1" id="0">
