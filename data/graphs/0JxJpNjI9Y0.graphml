<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Public</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Public end-users requesting web pages like WashingtonPost.com.</data>
    </node>
    <node id="1">
      <data key="d5">Developer / Newsroom</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Newsroom creators managing web templates and developers deploying rendering code.</data>
    </node>
    <node id="2">
      <data key="d5">ECS (Origin)</data>
      <data key="d6">ECS</data>
      <data key="d7">Origin traffic routing service running on Amazon ECS.</data>
    </node>
    <node id="3">
      <data key="d5">STATIC RESOURCES</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing JavaScript, CSS, and other static web assets.</data>
    </node>
    <node id="4">
      <data key="d5">PRE-RENDER CONTENT</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket caching pre-rendered HTML content for quick page loads.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function dynamically rendering pages upon cache misses.</data>
    </node>
    <node id="6">
      <data key="d5">ECS (Content Proxy)</data>
      <data key="d6">ECS</data>
      <data key="d7">Secondary ECS service acting as a content proxy to fetch stories, galleries, and videos.</data>
    </node>
    <node id="7">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Amazon DynamoDB storing web page templates created via Page Builder Admin.</data>
    </node>
    <node id="8">
      <data key="d5">ELASTICACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Amazon ElastiCache caching raw content JSON payloads with a TTL.</data>
    </node>
    <node id="9">
      <data key="d5">CMS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External CMS and third-party APIs (sports, weather, internal content sources).</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Public users send web requests to the origin ECS cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Newsroom users define and write web templates directly into DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Developers deploy web rendering JavaScript code deployments into Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Origin ECS fetches static JavaScript and CSS resources from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Origin ECS checks S3 for pre-rendered HTML page content.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Cache misses trigger Lambda to dynamically render the requested web page.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda queries DynamoDB for page template layout definitions.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda writes rendered pages to the pre-rendered content S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Content proxy ECS fetches stories, galleries, and media from external CMS / APIs.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Content proxy stores raw content JSON objects into ElastiCache with a TTL.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Arc Publishing Web Rendering Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=0JxJpNjI9Y0</data>
    <data key="d2">Web rendering and content management architecture built by Arc Publishing at The Washington Post using ECS, Lambda, S3, DynamoDB, and ElastiCache.</data>
    <data key="d3">Media &amp; Entertainment, Serverless, Content Delivery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
