<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">APPLICATIONS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Customer applications generating security and transactional data streams.</data>
    </node>
    <node id="1">
      <data key="d5">KINESIS</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingests real-time application data streams.</data>
    </node>
    <node id="2">
      <data key="d5">FARGATE</data>
      <data key="d6">Fargate</data>
      <data key="d7">Parses ingested streams, performs analysis scoping, and decorates/processes violation notifications.</data>
    </node>
    <node id="3">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores parsed application data for relational querying.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores parsed log data and transformed ETL output.</data>
    </node>
    <node id="5">
      <data key="d5">SCHEDULER</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Triggers scheduled compliance analysis jobs (hourly or multi-minute basis).</data>
    </node>
    <node id="6">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs Spark jobs to analyze data from Aurora and S3 and execute compliance rules.</data>
    </node>
    <node id="7">
      <data key="d5">EVENTBRIDGE</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Receives violation events emitted by EMR Spark analysis.</data>
    </node>
    <node id="8">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers violation event messages for Fargate processing.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Customer applications stream transaction and security data to Kinesis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis forwards data streams to Fargate for parsing.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate writes parsed structured data to Aurora.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate writes parsed unstructured/log data to S3.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Fargate initiates EMR Spark analysis job.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR job retrieves relational data from Aurora for analysis.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR job retrieves log data from S3 for analysis.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Scheduler triggers analysis scoping on Fargate.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR publishes violation events to EventBridge.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EventBridge routes violation messages to SQS queue.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Fargate reads violation messages from SQS to process, decorate, and trigger customer notifications.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Infor Governance Risk and Compliance Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=0gNMEyei-co</data>
    <data key="d2">Processes millions of records per day per customer across hundreds of customer applications for risk and compliance auditing.</data>
    <data key="d3">Analytics, Security &amp; Compliance, Serverless</data>
    <data key="d4">True</data>
  </graph>
