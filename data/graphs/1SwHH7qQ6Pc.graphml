<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SFDC</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Salesforce CRM storing product and creative information entered by sales reps.</data>
    </node>
    <node id="1">
      <data key="d5">CREATIVE API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">AWS API Gateway entry point receiving automated event payload triggers from Salesforce.</data>
    </node>
    <node id="2">
      <data key="d5">PARSING</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function that normalizes unstructured Salesforce data into standardized JSON format.</data>
    </node>
    <node id="3">
      <data key="d5">ROUTING</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function managing ad routing logic and credentials for downstream systems.</data>
    </node>
    <node id="4">
      <data key="d5">WORKFLOW</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function executing creative workflow tasks like proofing and ad generation.</data>
    </node>
    <node id="5">
      <data key="d5">CONFIG</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB table storing routing rules and system login credentials.</data>
    </node>
    <node id="6">
      <data key="d5">AD DATA</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB table storing parsed, standardized advertisement details.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket hosting the static web front-end application.</data>
    </node>
    <node id="8">
      <data key="d5">COGNITO</data>
      <data key="d6">Cognito</data>
      <data key="d7">Amazon Cognito handling authentication and user pool management for secure single sign-on.</data>
    </node>
    <node id="9">
      <data key="d5">Mobile App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Front-end application interface used by creative teams to build and proof ads.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Salesforce sends trigger payload to Creative API Gateway upon order completion.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Salesforce triggers Parsing Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Parsing Lambda writes standardized ad data into DynamoDB AD DATA table.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Routing Lambda reads routing configuration and downstream credentials from DynamoDB CONFIG table.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Mobile app reads parsed ad information from DynamoDB AD DATA table.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 serves web application code to the mobile app client.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Mobile app invokes Workflow Lambda function to execute ad creation steps.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Advanced Local Serverless Ad Creation Workflows</data>
    <data key="d1">https://www.youtube.com/watch?v=1SwHH7qQ6Pc</data>
    <data key="d2">Advanced Local uses a serverless AWS architecture combining API Gateway, Lambda, DynamoDB, S3, and Cognito to automate ad creation workflows from Salesforce data.</data>
    <data key="d3">Media &amp; Entertainment, Serverless, Migration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
