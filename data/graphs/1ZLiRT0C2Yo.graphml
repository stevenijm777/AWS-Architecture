<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Center (TX / WA)</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises data centers located in Texas and Washington State.</data>
    </node>
    <node id="1">
      <data key="d5">Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Centralized transit gateway interconnecting on-premises data centers and AWS VPCs.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer routing incoming traffic into multi-AZ Kubernetes application VPCs.</data>
    </node>
    <node id="3">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute nodes running standardized Kubernetes clusters and containers.</data>
    </node>
    <node id="4">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">AWS RDS databases consumed directly by application microservices.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage used for application data and assets.</data>
    </node>
    <node id="6">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Centralized logging, monitoring, and observability service integrated with Prometheus.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises data centers connect to AWS Transit Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Transit Gateway routes network traffic to load balancers inside application VPCs.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB distributes incoming application requests to Kubernetes pods running on EC2.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Applications hosted on EC2 read and write data to RDS instances.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Kubernetes infrastructure and workloads push logs and metrics to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">T-Mobile Multi-Region Cloud Infrastructure</data>
    <data key="d1">https://www.youtube.com/watch?v=1ZLiRT0C2Yo</data>
    <data key="d2">T-Mobile's standardized Kubernetes infrastructure deployment using GitOps, Terraform, Transit Gateway for hybrid connectivity, and AWS Local Zones for ultra-low latency.</data>
    <data key="d3">Hybrid Cloud &amp; Infrastructure Automation</data>
    <data key="d4">True</data>
  </graph>
