<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">End User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Accesses the Orion portal to trigger environment creation requests.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Resolves DNS requests for the Orion platform.</data>
    </node>
    <node id="2">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Distributes incoming traffic to the backend services on the Kubernetes cluster.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon EKS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Orchestrates microservices and Kubernetes jobs. Scaled from 100 pods to over 10,000 pods.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 Spot Instances</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Hosts 100% of the application and provisioning jobs to optimize costs. Employs AWS Node Termination Handler to drain nodes gracefully.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon SNS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Receives launch progress and state registration events from the microservice provisioning jobs.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon SQS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Holds persistent queue messages of unfinished provisioning tasks.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests Orion portal domain resolution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 resolves traffic to the ALB.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards the environment creation requests to the main application pod on EKS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS schedules microservice provisioning jobs onto EC2 Spot Instances.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Provisioning jobs publish progress and initialization status to SNS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS fans out execution state and status events to SQS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Newly scheduled replacement jobs on EC2 Spot watch SQS to fetch unfinished tasks and resume provisioning state.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">OLX Autos - Resilient Environment Provisioning on EKS with 100% Spot Instances</data>
    <data key="d1">https://www.youtube.com/watch?v=1aYoIZvabbk</data>
    <data key="d2">Main portal backend running on EKS orchestrates environment creation by triggering Kubernetes jobs on EC2 Spot Instances. By persisting state through SNS and SQS, replacement jobs can resume unfinished provisioning tasks when Spot nodes are terminated, achieving resilience with 100% Spot instances.</data>
    <data key="d3">Compute, Containers, Application Integration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
