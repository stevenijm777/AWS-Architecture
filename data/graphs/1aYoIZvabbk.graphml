<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Handles DNS resolution for incoming requests to the Orion portal.</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer that routes web traffic to EKS pods.</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS container orchestrator running over 10,000 pods to manage microservices.</data>
    </node>
    <node id="3">
      <data key="d5">SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">100% EC2 Spot instances hosting pods and microservices, monitored by AWS Node Termination Handler.</data>
    </node>
    <node id="4">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes events whenever microservice deployment jobs are triggered.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Stores job state messages fanned out from SNS to track unfinished tasks.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 resolves DNS domain to the Application Load Balancer.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes incoming user requests to EKS pods.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB directs traffic to workloads on EC2 Spot instances.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS microservice provisioning jobs send execution events to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS fans out state message events to the SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Replacement jobs running on Spot instances watch SQS for unfinished tasks and complete them.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">OLX Autos Developer Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=1aYoIZvabbk</data>
    <data key="d2">OLX Autos architecture using 100% EC2 Spot instances managed by Amazon EKS, resiliently handling spot terminations using SNS and SQS for state tracking.</data>
    <data key="d3">compute, containers, messaging, networking</data>
    <data key="d4">True</data>
  </graph>
</graphml>
