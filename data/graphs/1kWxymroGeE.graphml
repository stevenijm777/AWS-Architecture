<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Monolith Data</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Legacy monolith data containing Binary, Relational, Key-Value, and Encrypted components.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores unstructured binary blob data and unstructured document files.</data>
    </node>
    <node id="2">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Aurora Serverless used for per-tenant core relational application definitions.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores configuration data and key-value pairs offloaded from relational storage.</data>
    </node>
    <node id="4">
      <data key="d5">Secrets Manager</data>
      <data key="d6">SecretsManager</data>
      <data key="d7">Securely stores sensitive encrypted data directly instead of pre-encrypting in relational DB.</data>
    </node>
    <node id="5">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Generates per-tenant keys enabling multi-tenancy and Bring-Your-Own-Key (BYOK) encryption strategies.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Offloads binary unstructured data to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Migrates core relational items to Aurora Serverless instances.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Offloads key-value configuration data to DynamoDB.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Offloads sensitive encrypted information to Secrets Manager.</data>
      <data key="d10">0'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Applies per-tenant KMS encryption keys to S3 storage.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Applies per-tenant KMS encryption keys to Aurora Serverless.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Applies per-tenant KMS encryption keys to DynamoDB.</data>
      <data key="d10">0''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Applies per-tenant KMS encryption keys to Secrets Manager.</data>
      <data key="d10">0'''</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">OutSystems Monolith Data Decomposition Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=1kWxymroGeE</data>
    <data key="d2">OutSystems decomposes its legacy monolith database into purpose-built AWS storage and database services (S3, Aurora Serverless, DynamoDB, Secrets Manager) with multi-tenant encryption managed by KMS.</data>
    <data key="d3">Migration, Security, Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
