<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Network Load Balancer acting as the single entry point mapped from the user alias.</data>
    </node>
    <node id="1">
      <data key="d5">Route Table</data>
      <data key="d6">VPC</data>
      <data key="d7">VPC Route Table containing 3 sets of overlay IPs pointing to active EC2 service instances.</data>
    </node>
    <node id="2">
      <data key="d5">ASCS</data>
      <data key="d6">EC2</data>
      <data key="d7">SAP ABAP Central Services running on EC2 in AZ1.</data>
    </node>
    <node id="3">
      <data key="d5">ERS</data>
      <data key="d6">EC2</data>
      <data key="d7">SAP Enqueue Replication Server running on EC2 in AZ2 for lock table replication.</data>
    </node>
    <node id="4">
      <data key="d5">PAS</data>
      <data key="d6">EC2</data>
      <data key="d7">SAP Primary Application Server running on EC2 in AZ1.</data>
    </node>
    <node id="5">
      <data key="d5">AAS</data>
      <data key="d6">EC2</data>
      <data key="d7">SAP Additional Application Server running on EC2 in AZ2.</data>
    </node>
    <node id="6">
      <data key="d5">HANA Primary</data>
      <data key="d6">SAP</data>
      <data key="d7">Primary SAP HANA database node in AZ1.</data>
    </node>
    <node id="7">
      <data key="d5">HANA Secondary</data>
      <data key="d6">SAP</data>
      <data key="d7">Secondary SAP HANA database node in AZ2 receiving system replication.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB routes user traffic using overlay IP entries in the VPC Route Table.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Overlay IP entry routes ASCS connection traffic to active ASCS EC2 instance in AZ1.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Overlay IP entry maps to Enqueue Replication Server node in AZ2.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Overlay IP entry routes database connections directly to the active SAP HANA Primary node.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">HANA System Replication transfers database updates from Primary in AZ1 to Secondary in AZ2.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Whirlpool SAP High Availability Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=1tGmQd0yOzE</data>
    <data key="d2">SAP deployment across two Availability Zones using VPC Route Table overlay IPs and Network Load Balancing to achieve seamless high availability and automatic failover.</data>
    <data key="d3">Enterprise Application HA</data>
    <data key="d4">True</data>
  </graph>
</graphml>
