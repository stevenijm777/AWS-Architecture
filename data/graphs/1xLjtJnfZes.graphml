  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End users submitting credential verification requests.</data>
    </node>
    <node id="1">
      <data key="d5">CREDENTIAL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Digital credential provided as a photo, screenshot, or PDF.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer acting as the central entry point for incoming requests.</data>
    </node>
    <node id="3">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF performing request validation, checking headers, and filtering traffic.</data>
    </node>
    <node id="4">
      <data key="d5">SHIELD ADVANCED</data>
      <data key="d6">ShieldAdvanced</data>
      <data key="d7">AWS Shield Advanced providing DDoS protection and rapid response.</data>
    </node>
    <node id="5">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS cluster hosting microservices that process credential verification.</data>
    </node>
    <node id="6">
      <data key="d5">AUTOSCALING</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">AWS Auto Scaling managing compute capacity based on request demand spikes.</data>
    </node>
    <node id="7">
      <data key="d5">TERRAFORM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Terraform used for infrastructure as code to consistently provision environments.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users present credential files for verification.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Credential requests hit the Elastic Load Balancer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB sends requests to AWS WAF for inspection and filtering.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB leverages AWS Shield Advanced for DDoS protection.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Validated requests are routed to microservices in Amazon EKS.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Matter Verifier API Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=1xLjtJnfZes</data>
    <data key="d2">Architecture for verifying digital identity credentials like the New Zealand My Vaccine Pass at scale using ELB, WAF, Shield Advanced, and EKS.</data>
    <data key="d3">Security, Containers</data>
    <data key="d4">True</data>
  </graph>
