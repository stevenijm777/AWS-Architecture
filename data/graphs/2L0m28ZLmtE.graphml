<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Sanofi Data Scientists</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">The internal users who need to perform data analysis and translations on smart datasets.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront Distribution</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Reduces costs and securely serves the static web portal assets.</data>
    </node>
    <node id="2">
      <data key="d5">S3 (Web Portal)</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts the static web portal files.</data>
    </node>
    <node id="3">
      <data key="d5">Sanofi SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sanofi corporate SSO used for federated user authentication.</data>
    </node>
    <node id="4">
      <data key="d5">Cognito User Pool</data>
      <data key="d6">Cognito</data>
      <data key="d7">Identifies users and manages federation with Sanofi's enterprise SSO.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles dynamic requests and forwards metadata/traces to DynamoDB.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB Metadata Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores user actions, session metadata, and provides strong audit traceability.</data>
    </node>
    <node id="7">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Uses CloudFormation to provision specific, isolated analytics workspaces for each user.</data>
    </node>
    <node id="8">
      <data key="d5">R Studio Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">R Studio instances provisioned dynamically on AWS.</data>
    </node>
    <node id="9">
      <data key="d5">SageMaker Notebooks</data>
      <data key="d6">SageMaker</data>
      <data key="d7">On-demand, encrypted Jupyter notebooks provisioned per user with 100GB disk space.</data>
    </node>
    <node id="10">
      <data key="d5">Lambda Orchestrator</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by API Gateway to run SDK-based calls to translation and NLP services.</data>
    </node>
    <node id="11">
      <data key="d5">Amazon Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Automates the translation of bulk raw medical files.</data>
    </node>
    <node id="12">
      <data key="d5">Comprehend Medical</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Used to identify medical entities and metadata in raw text files.</data>
    </node>
    <node id="13">
      <data key="d5">Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Houses sensitive medical dataset securely, segregated by user permissions.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Users access the web portal.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">CloudFront serves static files from the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="4">
      <data key="d8">0</data>
      <data key="d9">Authenticates the user session.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="7">
      <data key="d8">1</data>
      <data key="d9">User requests R Studio or SageMaker workspace from the portal.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="5">
      <data key="d8">2</data>
      <data key="d9">Sends dynamic request (e.g. translation, NLP).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="4">
      <data key="d8">0</data>
      <data key="d9">Returns authentication token.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="3">
      <data key="d8">0</data>
      <data key="d9">Federates authentication request to corporate SSO.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="2">
      <data key="d8">0</data>
      <data key="d9">Validates the user's session with the web app.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="6">
      <data key="d8">2</data>
      <data key="d9">Logs user activity metadata for audit trails.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="10">
      <data key="d8">2</data>
      <data key="d9">Invokes backend processing logic.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="8">
      <data key="d8">1</data>
      <data key="d9">Service Catalog deploys an R Studio workspace.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="9">
      <data key="d8">1</data>
      <data key="d9">Service Catalog deploys a SageMaker Notebook.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="8" target="13">
      <data key="d8">3</data>
      <data key="d9">R Studio retrieves/saves dataset to the user home folder in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="9" target="13">
      <data key="d8">3</data>
      <data key="d9">SageMaker workspace processes data stored in S3.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="10" target="11">
      <data key="d8">2</data>
      <data key="d9">Triggers batch machine translation.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="10" target="12">
      <data key="d8">2</data>
      <data key="d9">Triggers clinical entity detection.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Sanofi with TeamWork: OnDemand Data Science Environment</data>
    <data key="d1">https://www.youtube.com/watch?v=2L0m28ZLmtE</data>
    <data key="d2">Darwin is an analytics and data science portal used by Sanofi's data scientists to securely analyze medical and clinical dataset. It uses automated translation and Comprehend Medical via API Gateway and Lambda, alongside R Studio and SageMaker provisioned on-demand through Service Catalog.</data>
    <data key="d3">Healthcare, Analytics, Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
