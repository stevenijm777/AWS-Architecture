  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Data scientists and analysts accessing the Real World Evidence analytics platform.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CloudFront CDN distribution holding the SSL certificate and reducing portal serving costs.</data>
    </node>
    <node id="2">
      <data key="d5">Sanofi SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Corporate identity provider integrated for single sign-on.</data>
    </node>
    <node id="3">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user identity federation and authentication with Sanofi SSO.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Portal Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Static website hosting bucket serving as the user entry portal.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API management layer handling dynamic portal requests and user tracking.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores user metadata and audit logs for all actions performed on the portal.</data>
    </node>
    <node id="7">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Deploys standardized data science products using CloudFormation.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless orchestration functions invoking Translate and Comprehend Medical SDKs.</data>
    </node>
    <node id="9">
      <data key="d5">R Studio</data>
      <data key="d6">EC2</data>
      <data key="d7">Dedicated compute instances provisioned for R Studio data analysis.</data>
    </node>
    <node id="10">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker Notebook instances provisioned with 100GB encrypted disks per user.</data>
    </node>
    <node id="11">
      <data key="d5">Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Performs bulk automated translation of raw data files.</data>
    </node>
    <node id="12">
      <data key="d5">Comprehend Medical</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Identifies medical entities and sensitive medical metadata in raw files.</data>
    </node>
    <node id="13">
      <data key="d5">Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake with user home buckets enforcing strict data segregation.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users connect to the static web portal via CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
