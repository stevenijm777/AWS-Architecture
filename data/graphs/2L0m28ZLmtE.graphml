    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Users request creation of analytics environments through Service Catalog.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Portal triggers Lambda functions to perform NLP data processing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway records user actions and metadata in DynamoDB for traceability.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions R Studio compute instances.</data>
      <data key="d10">1</data>
