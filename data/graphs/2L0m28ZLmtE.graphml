    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions SageMaker Notebooks with encrypted disks.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda uses the Translate SDK for automated document translation.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="12" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda uses the Comprehend Medical SDK to identify medical entities.</data>
