<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Data scientists and analysts accessing the analytics workspace portal.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Edge distribution serving the web portal with integrated SSL certificates.</data>
    </node>
    <node id="2">
      <data key="d5">SANOFI SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External Identity Provider (IdP) for federated enterprise login.</data>
    </node>
    <node id="3">
      <data key="d5">COGNITO</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles identity federation and issues secure tokens to users.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Static Website</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts the frontend static assets of the self-service web portal.</data>
    </node>
    <node id="5">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes REST endpoints for portal activity and triggers processing services.</data>
    </node>
    <node id="6">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores user metadata and platform audit logs to maintain a strict trace of user actions.</data>
    </node>
    <node id="7">
      <data key="d5">SERVICE CATALOG</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Provisions CloudFormation-based data science environments in an isolated, secure template fashion.</data>
    </node>
    <node id="8">
      <data key="d5">R STUDIO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Analytical IDE provisioned via Service Catalog for smart dataset evaluation.</data>
    </node>
    <node id="9">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Machine learning notebook instances with customized storage (e.g., 100 GB volumes).</data>
    </node>
    <node id="10">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless functions executing SDK logic for mass translation and medical entity recognition.</data>
    </node>
    <node id="11">
      <data key="d5">TRANSLATE</data>
      <data key="d6">Translate</data>
      <data key="d7">Converts clinical raw files into target analysis languages.</data>
    </node>
    <node id="12">
      <data key="d5">COMPREHEND MEDICAL</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Identifies critical medical metadata and PHI inside raw datasets.</data>
    </node>
    <node id="13">
      <data key="d5">DATA LAKE</data>
      <data key="d6">S3</data>
      <data key="d7">Secure centralized clinical data lake with strict access control; data never leaves this perimeter.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User opens the web application.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront serves the web portal files from the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">SSO returns assertion and redirects back.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Cognito federates authentication request to Sanofi's enterprise SSO.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Cognito issues identity tokens to the portal web application.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Redirects to Cognito for authentication.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">User submits a self-service provisioning request for an environment.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Portal interacts with API Gateway for actions and audit registration.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Saves system event metadata and security audits to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Triggers serverless pipeline execution for file processing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Launches R Studio server instance dynamically.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Launches dedicated Amazon SageMaker environment.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="13" id="0">
      <data key="d8">1</data>
      <data key="d9">R Studio accesses workspace data directly inside the S3 Data Lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="13" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker loads and processes clinical data securely from S3.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Invokes Amazon Translate SDK to execute bulk document translations.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="12" id="0">
      <data key="d8">3</data>
      <data key="d9">Invokes Amazon Comprehend Medical to redact or identify medical terminology.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="13" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda reads raw clinical files and writes back the enriched/translated files into S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Sanofi Darwin Real World Evidence Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=2L0m28ZLmtE</data>
    <data key="d2">Secure AWS analytics platform used by Sanofi to process clinical trial and medical data securely, ensuring absolute data residency and no external export capability.</data>
    <data key="d3">Healthcare and Life Sciences, Analytics, Serverless, Security &amp; Compliance</data>
    <data key="d4">True</data>
  </graph>
