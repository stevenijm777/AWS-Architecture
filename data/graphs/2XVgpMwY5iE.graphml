  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Hospital</data>
      <data key="d6">UserConsumerHospital</data>
      <data key="d7">Client hospital providing medical imaging data</data>
    </node>
    <node id="1">
      <data key="d5">Pathologist</data>
      <data key="d6">UserCompanyDomainExpert</data>
      <data key="d7">Medical expert who annotates images and validates trained models</data>
    </node>
    <node id="2">
      <data key="d5">S3 (Input Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores around 5TB of input medical image data per project</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Kubernetes cluster hosting the labeling application and running inference</data>
    </node>
    <node id="4">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains machine learning models in Docker containers</data>
