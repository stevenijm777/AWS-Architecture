    <node id="5">
      <data key="d5">S3 (Model Storage)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores trained model artifacts</data>
    </node>
    <node id="6">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">High performance file system for SageMaker training I/O</data>
    </node>
    <node id="7">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Provides data security, access control, and compliance governance</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Hospital uploads medical images into S3 input bucket</data>
