  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Fire Hydrant</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">IoT device collecting acoustic audio signals from pipe networks.</data>
    </node>
    <node id="1">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Secures and authenticates incoming daily acoustic data pushes.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage persisting raw acoustic recording files.</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs daily batch processing microservices performing processor-intensive acoustic correlation algorithms.</data>
    </node>
    <node id="4">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Machine learning endpoint classifying persistent correlations and calculating leak probabilities.</data>
    </node>
    <node id="5">
      <data key="d5">ANALYST</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Human analyst reviewing leak probability scores to qualify field investigation needs.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Daily acoustic audio files are pushed from fire hydrants to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway authenticates requests and persists acoustic files into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Daily batch process on ECS ingests acoustic files from S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Persistent correlations identified by ECS microservices are sent to SageMaker.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker delivers leak probability scores to the human analyst team.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Muller Water Products Intelligent Water Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=2e3vOxsHekE</data>
    <data key="d2">Architecture ingesting acoustic audio data from smart fire hydrants to detect and classify water pipe leaks using AWS API Gateway, S3, ECS batch microservices, and SageMaker.</data>
    <data key="d3">IoT, Machine Learning, Batch Processing</data>
    <data key="d4">True</data>
