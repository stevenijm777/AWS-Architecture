<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart Fire Hydrant Network</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Collects and records daily acoustic signals on the pipe network to detect potential leaks.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles secure ingestion with authentication for the incoming IoT acoustic files.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores and persists the daily acoustic signal files.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs microservice containerized batch jobs to execute processor-intensive acoustic correlation algorithms.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Predicts and assigns a leak probability score to persistent correlations.</data>
    </node>
    <node id="5">
      <data key="d5">Human Analyst Team</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Receives leak scores, qualifies potential leaks, and schedules field investigations.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Pushes daily acoustic files to the ingest endpoint.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">Stores and persists the acoustic data files securely.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">ECS batch jobs retrieve the raw acoustic files from S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="4">
      <data key="d8">0</data>
      <data key="d9">Sends calculated persistent correlation data to the SageMaker ML model endpoint.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="5">
      <data key="d8">0</data>
      <data key="d9">Feeds the predicted leak probability scores to the analyst team for classification.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Mueller Water Products: A Water Intelligent Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=2e3vOxsHekE</data>
    <data key="d2">Logical architecture of Muller Water Products' intelligent water platform for acoustic leak detection using IoT devices, containerized microservices, and machine learning.</data>
    <data key="d3">IoT, Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
