<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Fire Hydrant IoT Devices</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Acoustic sensors on fire hydrants recording daily noise signals on the pipe network.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Secures data ingestion layer, performing authentication for incoming IoT device uploads.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Saves and persists raw daily acoustic files safely.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs processor-intensive acoustic correlation algorithms as containerized batch microservices.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Hosts the ML endpoint that assigns a leak probability score to persistent correlations.</data>
    </node>
    <node id="5">
      <data key="d5">Analyst</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Human analyst team who reviews leak scores and qualifies leaks with utilities.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Daily acoustic files are uploaded securely via API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Persists and stores daily uploaded acoustic data files in Amazon S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS pulls and processes the raw acoustic data daily as node pairs to check for correlations.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS forwards persistent correlations to SageMaker ML endpoint for classification.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker leak score and classification is surfaced to human analysts for review.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Muller Water Products - Intelligent Water Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=2e3vOxsHekE</data>
    <data key="d2">An intelligent water monitoring and leak detection system utilizing acoustic data processing with ECS and SageMaker.</data>
    <data key="d3">IoT, Analytics, Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
