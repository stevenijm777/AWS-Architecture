  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CONTROL TOWER</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Uses guardrails to manage and enforce security/compliance policies across accounts.</data>
    </node>
    <node id="1">
      <data key="d5">ORGANIZATIONS</data>
      <data key="d6">Organizations</data>
      <data key="d7">Provides account isolation with dedicated AWS accounts for each customer.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts React-based single-page application for cloud automation management.</data>
    </node>
    <node id="3">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point REST API for management application requests.</data>
    </node>
    <node id="4">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes account management, cluster provisioning, and update tasks.</data>
    </node>
    <node id="5">
      <data key="d5">COGNITO</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user authentication using OpenID Connect, integrating with external IdPs.</data>
    </node>
    <node id="6">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Performs request routing and SSL offloading for the Appway cluster.</data>
    </node>
    <node id="7">
      <data key="d5">Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Client browser running React frontend application.</data>
    </node>
    <node id="8">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs Appway Java/Tomcat cluster nodes with Hazelcast across multi-AZs.</data>
    </node>
    <node id="9">
      <data key="d5">EFS</data>
      <data key="d6">EFS</data>
      <data key="d7">Shared central storage for all Appway cluster nodes.</data>
    </node>
    <node id="10">
      <data key="d5">S2S VPN</data>
      <data key="d6">S2SVPN</data>
      <data key="d7">Dedicated VPN connection to customer in-house data centers and core banking systems.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Control Tower applies compliance guardrails to AWS Organizations.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Management SPA hosted on S3 interacts with API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway triggers Lambda functions for management operations.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB routes web application requests to EC2 cluster nodes.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Client authenticates directly with Cognito.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Client sends application requests to EC2.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Appway EC2 cluster validates user authentication via Cognito OIDC.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 cluster instances store and access data on EFS.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 cluster accesses customer internal systems via S2S VPN.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Appway Cloud Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=2f_NYiPJQt4</data>
    <data key="d2">Appway's cloud deployment architecture features dedicated customer accounts managed via Organizations and Control Tower, a multi-node cluster on EC2 with ALB and EFS, Cognito authentication, S2S VPN for enterprise integration, and a serverless DevOps toolchain.</data>
    <data key="d3">SaaS Multi-tenant Enterprise Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
