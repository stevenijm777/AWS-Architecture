<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded PDF documents containing text and images.</data>
    </node>
    <node id="1">
      <data key="d5">EVENTBRIDGE</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Main event bus that triggers processing workflows and receives completion notifications.</data>
    </node>
    <node id="2">
      <data key="d5">STEP FUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates multi-stage document processing workflow.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Powers Step Functions steps, converting pages to images and conducting semantic post-processing.</data>
    </node>
    <node id="4">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Real-time endpoint hosting custom machine learning model for page image analysis.</data>
    </node>
    <node id="5">
      <data key="d5">MANAGED TEXTRACT</data>
      <data key="d6">Textract</data>
      <data key="d7">Managed API used for extracting text from document pages.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Provides document reference payload stored in S3 to processing workflow.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge triggers Step Functions execution upon document upload event.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes Managed Textract for document text extraction.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Step Functions sends completion notification events back to EventBridge.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda passes converted page images to SageMaker endpoint for visual model analysis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker returns ML inference analysis results back to Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Textract returns extracted text to Step Functions workflow.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Docebo AI Powered Document Processing Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=37T7Nd8pL-c</data>
    <data key="d2">Docebo uses this serverless architecture to process 10-20 documents per day (30-50 pages per minute) and reduce document noise by about 80%. Uploaded PDFs stored in S3 send events through EventBridge to trigger a Step Functions workflow powered by Lambda. The pipeline uses a custom ML model on SageMaker real-time endpoints for image analysis and Managed Textract for text extraction, returning completion notifications to EventBridge.</data>
    <data key="d3">machine_learning, orchestration, serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
