<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile &amp; Web Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Over 1.5M registered users, around 500k active team creators per match.</data>
    </node>
    <node id="1">
      <data key="d5">API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives user requests from mobile apps and web frontend.</data>
    </node>
    <node id="2">
      <data key="d5">CW</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Provides automated triggers (events) after match starts to ingest data.</data>
    </node>
    <node id="3">
      <data key="d5">GAME APIs</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External sports score APIs sending real-time point and score updates.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless backend functions processing API requests and score events.</data>
    </node>
    <node id="5">
      <data key="d5">MongoDB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Primary database storing user teams, match details, and computed leaderboards.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central storage/data lake storing score changes and match historical data.</data>
    </node>
    <node id="7">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Executes Spark jobs to compute ranks and estimated winnings.</data>
    </node>
    <node id="8">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for analytics on free entries and coupon targeting.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users send API requests to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers backend Lambda functions.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch triggers Lambda after a match starts.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Game APIs trigger Lambda whenever scores or points change.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda reads and writes user team data to MongoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda stores detected score changes directly into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Match-related data from MongoDB is backed up and stored in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">EMR Spark jobs read raw match data from S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">4</data>
      <data key="d9">Data from S3 is loaded into Redshift for business analytics.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">EMR writes computed user rankings and winnings back into MongoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">FanFight Daily Fantasy Sports Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=3WgTBTDlQN8</data>
    <data key="d2">Architecture handles 1.5M new monthly registered users and 500k active users per match. Features real-time score ingestion, serverless API execution, batch leaderboard processing with EMR Spark, and analytics with Redshift.</data>
    <data key="d3">Gaming, Data Processing, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
