<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End users including architects, city surveyors, and field devices uploading geospatial data.</data>
    </node>
    <node id="1">
      <data key="d5">S3 Data</data>
      <data key="d6">S3</data>
      <data key="d7">Central data account S3 bucket storing all primary geospatial datasets.</data>
    </node>
    <node id="2">
      <data key="d5">EKS Data</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS cluster in the AWS Data account handling streaming data logic.</data>
    </node>
    <node id="3">
      <data key="d5">VPC Peering</data>
      <data key="d6">VPCPeering</data>
      <data key="d7">Enables private, secure, low-latency VPC peering between the AWS Data account and AWS User/Pro accounts.</data>
    </node>
    <node id="4">
      <data key="d5">EKS User/Pro</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS cluster hosting user experience logic and microservice containers listening to processing queues.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue storing S3 event notifications and decoupling processing task messages.</data>
    </node>
    <node id="6">
      <data key="d5">ASG</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling Group of EC2 instances pulling container images from ECR to execute pipeline processing steps.</data>
    </node>
    <node id="7">
      <data key="d5">S3 User/Pro</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket receiving direct uploads via pre-signed URLs and storing final processed geospatial artifacts.</data>
    </node>
    <edge source="0" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">User uploads file directly to S3 User/Pro bucket using a pre-signed URL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS Data accesses raw geospatial data stored in S3 Data bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS Data routes data streams across account boundaries via VPC Peering.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">VPC Peering securely delivers data to EKS User/Pro across the AWS backbone network.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Container on EKS User/Pro listens to and polls SQS for incoming messages.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS messaging system dispatches task information to EC2 instances in the Auto Scaling Group.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Processed geospatial output files are written back from EC2 instances to S3 User/Pro.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 event notification triggers an upload event message into SQS.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Hexagon Digital Reality Geospatial Data Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=3yJZ6rPoZfg</data>
    <data key="d2">Architecture for Hexagon's cloud-based data store and processing pipeline for geospatial data using AWS EKS, S3, VPC Peering, SQS, and Auto Scaling groups.</data>
    <data key="d3">Data Analytics, Application Integration, Compute</data>
    <data key="d4">True</data>
  </graph>
</graphml>
