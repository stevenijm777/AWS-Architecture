<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs the customized Sixpack core engine and API service instances, managing up to 10,000 QPS with Kubernetes deployment object auto-scaling.</data>
    </node>
    <node id="1">
      <data key="d5">ELASTICACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">ElastiCache Redis serves as the fast low-latency data store for A/B test experiments and feature deployment configs.</data>
    </node>
    <node id="2">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Receives real-time log and metric data streamed from ElastiCache for indexing and fast search.</data>
    </node>
    <node id="3">
      <data key="d5">KIBANA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party visualization tool connected to Elasticsearch for real-time monitoring of metrics.</data>
    </node>
    <node id="4">
      <data key="d5">AIR FLOW</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Apache Airflow deployed on EKS orchestrates periodic data ingestion and refining workflows.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database storing relational service data used during experiment evaluation.</data>
    </node>
    <node id="6">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Elastic MapReduce cluster used for heavy batch ETL and data refinement.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central object storage for streaming logs and refined metrics data.</data>
    </node>
    <node id="8">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query service used to analyze experiment results stored in S3.</data>
    </node>
    <node id="9">
      <data key="d5">BI DASHBOARD</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Visualization dashboard displaying A/B test analysis results derived from Athena queries.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS application service uses ElastiCache Redis as low-latency cache/storage.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ElastiCache streams real-time log and metric data directly to Elasticsearch.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">ElastiCache simultaneously streams real-time metric logs into S3 for storage.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Elasticsearch feeds index data to Kibana for real-time dashboarding.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Apache Airflow orchestrates periodic data refining jobs running on EMR.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">RDS service data is ingested into EMR for refining and processing.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR outputs refined metrics and processed data into S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Data stored in S3 is queried using Amazon Athena.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena query results feed A/B test analysis metrics into the BI Dashboard.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mesh Korea A/B Testing Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=40dhk6OABJE</data>
    <data key="d2">Mesh Korea built an A/B testing platform handling 10,000 QPS. It runs microservices on EKS, relies on ElastiCache Redis for fast caching, uses Elasticsearch and Kibana for real-time streaming metrics, orchestrates EMR batch refining via Apache Airflow from RDS data into S3, and analyzes final metrics via Athena and a BI Dashboard.</data>
    <data key="d3"> Analytics &amp; Data Lakes, Compute, Databases</data>
    <data key="d4">True</data>
  </graph>
</graphml>
