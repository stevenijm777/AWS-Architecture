<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">N3 / HSCN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Secure NHS private network accessed by health and care workers.</data>
    </node>
    <node id="1">
      <data key="d5">DX</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">AWS Direct Connect connection providing secure data transfer into AWS.</data>
    </node>
    <node id="2">
      <data key="d5">Integration Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Microservice handling integration requests and external third-party system queries.</data>
    </node>
    <node id="3">
      <data key="d5">RDS Integration</data>
      <data key="d6">RDS</data>
      <data key="d7">Dedicated PostgreSQL RDS instance for the Integration Service.</data>
    </node>
    <node id="4">
      <data key="d5">FHIR Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Microservice responsible for normalizing health data into HL7 FHIR standard format.</data>
    </node>
    <node id="5">
      <data key="d5">RDS FHIR</data>
      <data key="d6">RDS</data>
      <data key="d7">Dedicated PostgreSQL RDS instance storing structured FHIR patient records.</data>
    </node>
    <node id="6">
      <data key="d5">Primary / Social Care</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External care providers generating unstructured documents like clinic letters.</data>
    </node>
    <node id="7">
      <data key="d5">Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">AWS Storage Gateway providing a local bridge to upload documents into S3.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing patient document content.</data>
    </node>
    <node id="9">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Amazon SQS queue buffering upload events from S3 for processing.</data>
    </node>
    <node id="10">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function processing document business logic and metadata extraction.</data>
    </node>
    <node id="11">
      <data key="d5">Document Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Microservice managing document metadata and linking structured views.</data>
    </node>
    <node id="12">
      <data key="d5">RDS Document</data>
      <data key="d6">RDS</data>
      <data key="d7">Dedicated PostgreSQL RDS instance storing document metadata.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User patient request originates from N3/HSCN network into AWS Direct Connect.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Direct Connect routes user request to the Integration Service microservice.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Integration Service queries and updates its dedicated RDS database.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Integration Service hands off retrieved third-party clinical data to the FHIR Service.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">FHIR Service stores normalized FHIR records into RDS FHIR.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Primary and Social Care systems send document content via AWS Storage Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Storage Gateway syncs document files into the Amazon S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 triggers event notifications to the SQS queue upon document arrival.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS queue triggers processing execution in Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda passes extracted metadata to the Document Service.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda stores finalized document content directly back into S3.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">1</data>
      <data key="d9">Document Service persists document metadata in RDS Document.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Kainos Healthcare Interoperability Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=4WjXH8Wp0E4</data>
    <data key="d2">Architecture for aggregating structured FHIR data and unstructured care documents at scale across NHS systems using microservices and serverless components.</data>
    <data key="d3">Healthcare</data>
    <data key="d4">True</data>
  </graph>
</graphml>
