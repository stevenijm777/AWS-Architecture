<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Filters incoming web traffic and applies IP blocking rules.</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Web cluster processing legitimate traffic and detecting malicious actors using honey traps.</data>
    </node>
    <node id="2">
      <data key="d5">DATA PIPELINE</data>
      <data key="d6">DataPipeline</data>
      <data key="d7">Extracts user and mobile mining data for analytics.</data>
    </node>
    <node id="3">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Performs post-analysis and gamified fraud rule evaluation.</data>
    </node>
    <node id="4">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database storing user and mobile mining data.</data>
    </node>
    <node id="5">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for instant payment requests from mobile devices.</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes payment logic and verifies payment criteria.</data>
    </node>
    <node id="7">
      <data key="d5">DYNAMO</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores instant payment status outcomes (success or failure).</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Filtered web traffic passes from WAF to EC2 instances.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 feeds malicious IP addresses back to WAF for dynamic blocking.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Pipeline pushes processed data into Athena for analytical querying.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">User and mobile mining data sent from RDS into Data Pipeline.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes instant payment requests to Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda records transaction outcome status into DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Electroneum Fraud Protection and Instant Payment Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=4zVB5RbSTCo</data>
    <data key="d2">Electroneum uses a multi-layered security setup with WAF, EC2, Data Pipeline, and Athena to perform gamified fraud detection while using API Gateway, Lambda, and DynamoDB for low-latency cryptocurrency instant payments.</data>
    <data key="d3">Security, Analytics, Serverless, Mobile</data>
    <data key="d4">True</data>
  </graph>
</graphml>
