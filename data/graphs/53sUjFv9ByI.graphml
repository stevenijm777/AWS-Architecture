<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Ad-hoc virtual machines used by data engineers to ingest raw genomic sequencing data (ATCGs).</data>
    </node>
    <node id="1">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">High-performance file system holding ingested raw genomic data, mounted on EKS worker nodes.</data>
    </node>
    <node id="2">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Private container registry storing versioned pipeline container images for reproducible processing.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Kubernetes cluster executing containerized curation pipelines, scaling dynamically from 0 to 100+ nodes.</data>
    </node>
    <node id="4">
      <data key="d5">DATA LAKE</data>
      <data key="d6">S3</data>
      <data key="d7">S3 Data Lake storing final curated genomic output matrices for downstream statistical analysis.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 instances write ingested raw genomic sequencing data directly to Amazon FSx.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Pipeline code and dependencies on EC2 are containerized and published as versioned images to ECR.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon FSx is mounted onto EKS worker nodes to supply raw input genomic data to curation workloads.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS pulls versioned pipeline container images from ECR.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS curation workloads write processed genomic output matrices directly into the Data Lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Biopharma Genomic Data Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=53sUjFv9ByI</data>
    <data key="d2">Architecture for ingesting raw genomic data, versioning software pipelines in ECR, running scalable curation on EKS, and persisting resulting matrices to an S3 Data Lake.</data>
    <data key="d3">Genomics, Data Curation, Containers, Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
