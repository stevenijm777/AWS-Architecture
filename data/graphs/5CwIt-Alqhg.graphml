  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IOT</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests environmental data (e.g., temperature) from farm sensors and shipping containers.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Evaluates sensor thresholds and invokes application backend.</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer distributing traffic to Hyperledger Fabric container nodes.</data>
    </node>
    <node id="3">
      <data key="d5">BLOCKCHAIN</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS cluster running Hyperledger Fabric containerized blockchain nodes and smart contracts.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores off-chain ledger data to enable fast queries and visualization.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Aggregates historical off-chain transaction logs for long-term analytics.</data>
    </node>
    <node id="6">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Builds predictive ML models to forecast produce spoilage, delays, and supply disruptions.</data>
    </node>
    <node id="7">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Triggers push notifications and alerts when smart contract parameters are breached.</data>
    </node>
    <node id="8">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors EKS blockchain container nodes for health, performance, and auto-scaling.</data>
    </node>
    <node id="9">
      <data key="d5">KEYS</data>
      <data key="d6">CloudHSM</data>
      <data key="d7">FIPS-compliant Hardware Security Module managing cryptographic keys for blockchain transactions.</data>
    </node>
    <node id="10">
      <data key="d5">Users / Drivers</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Receives real-time route change and threshold breach notifications on mobile devices.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT sensor threshold trigger invokes Lambda function.</data>
