<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CONTENT ORIGINATORS</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Advertisers and publishers uploading video ad assets via UI, API, or Java media uploader.</data>
    </node>
    <node id="1">
      <data key="d5">MEDIA OUTLETS</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Broadcasters and digital channels downloading broadcast-ready video ad assets.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer routing incoming API and web application requests.</data>
    </node>
    <node id="3">
      <data key="d5">FIREWALL</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall monitoring and filtering promiscuous incoming traffic to the ELB.</data>
    </node>
    <node id="4">
      <data key="d5">APP</data>
      <data key="d6">EC2</data>
      <data key="d7">Application server tier running front-end UI, API services, and system business logic.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 storing master video uploads and converted broadcast-ready files.</data>
    </node>
    <node id="6">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN distributing digital video ad content directly to digital media outlets.</data>
    </node>
    <node id="7">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Amazon SQS priority queues managing asynchronous transcoding, QC, and batch workloads.</data>
    </node>
    <node id="8">
      <data key="d5">QC TRANS</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances running video quality control and video transcoding tools.</data>
    </node>
    <node id="9">
      <data key="d5">BATCH</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 batch instances executing background system maintenance and workflow jobs.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Content originators connect through ELB via UI, API, or Java agent.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Direct upload of master ad assets to S3 via Java uploader or UI.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Media outlets check into the system via ELB.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB routes verified requests to application tier EC2 servers.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS WAF firewall monitors and filters traffic entering ELB.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Application tier pushes asynchronous jobs into prioritized SQS queues.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront reads origin media assets stored in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Media outlets directly download broadcast video files from S3.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront delivers digital video advertising to media outlets.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Transcoding and QC worker instances poll SQS queues for work.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Batch processing instances poll SQS queues for background tasks.</data>
      <data key="d10">1'</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Extreme Reach Adbridge Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=5EmA67lSJEs</data>
    <data key="d2">Extreme Reach processes around 80% of video ad traffic in the US using S3 direct uploads, prioritized SQS queues, EC2 transcoding/batch workers, and CloudFront CDN distribution.</data>
    <data key="d3">Media &amp; Content Distribution</data>
    <data key="d4">True</data>
  </graph>
