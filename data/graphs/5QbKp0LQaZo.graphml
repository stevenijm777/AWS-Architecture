<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Clients</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Standard clients submitting web page classification requests.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for standard web page classification requests.</data>
    </node>
    <node id="2">
      <data key="d5">Main Region EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs main RESTful API and orchestration engine for AI classification.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Main classification database holding ~15TB of contextual data.</data>
    </node>
    <node id="4">
      <data key="d5">GumGum AI ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs microservices for NLP and Computer Vision AI model inference.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Outposts</data>
      <data key="d6">Outpost</data>
      <data key="d7">On-premises infrastructure container housing sub-10ms low-latency stack.</data>
    </node>
    <node id="6">
      <data key="d5">ElastiCache Redis</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">1TB Redis cluster on Outposts operating with Least Recently Used (LRU) eviction policy.</data>
    </node>
    <node id="7">
      <data key="d5">Edge API EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">High-performance API written in Go running on Outpost EKS.</data>
    </node>
    <node id="8">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer on Outposts for routing low-latency client traffic.</data>
    </node>
    <node id="9">
      <data key="d5">Low-Latency Clients</data>
      <data key="d6">UserConsumerAPI</data>
      <data key="d7">Clients with sub-10ms SLA sending up to 100k requests per second.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Clients send web page classification requests to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway forwards request to Main Region RESTful API on EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Main Region EKS performs database lookup on DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Orchestrator initiates AI classification request to ECS NLP and Computer Vision microservices.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Real-time replication syncs classification data from DynamoDB (15TB) to ElastiCache Redis (1TB).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">AI microservices store updated classification results into DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Edge API performs fast cache lookup in ElastiCache Redis.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="2" id="0">
      <data key="d8">4</data>
      <data key="d9">On cache miss, Edge API triggers Main Region EKS to initiate AI classification.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">ALB routes low-latency requests to Go Edge API running on EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Low-latency clients send 100k req/s requests requiring sub-10ms SLA to Outpost ALB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">GumGum Verity Contextual Intelligence Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=5QbKp0LQaZo</data>
    <data key="d2">Hybrid architecture leveraging AWS Region and AWS Outposts to achieve sub-10ms SLA at 100k requests per second using Go-based Edge API and ElastiCache Redis.</data>
    <data key="d3">AI/ML, Low Latency, Hybrid Infrastructure</data>
    <data key="d4">True</data>
  </graph>
</graphml>
