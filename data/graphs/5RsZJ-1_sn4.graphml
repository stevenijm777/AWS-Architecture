<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon Managed Streaming for Apache Kafka</data>
      <data key="d6">MSK</data>
      <data key="d7">Handles incoming event streams at the top left of the whiteboard.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon DynamoDB (Apps Data)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores data coming from external apps (~20 machines).</data>
    </node>
    <node id="2">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Central IoT platform connected to approximately 40 milling machines.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda (MSK Ingestion)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Ingests data directly from Amazon MSK into Job DynamoDB.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon SQS (Job Queue)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues job-related telemetry from IoT Core and Apps DynamoDB.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Lambda (Job Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes messages from Job SQS Queue.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon DynamoDB (Job Storage)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores consolidated job telemetry and restoration status.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon SQS (OEE Queue)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues Overall Equipment Effectiveness (OEE) telemetry from IoT Core.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Lambda (OEE Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes machine performance and OEE metrics.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon DynamoDB (OEE Storage)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores processed OEE metrics.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores evaluations and feedback received from dentists.</data>
    </node>
    <node id="11">
      <data key="d5">AWS Lambda (Statistical Service)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Calculates granular machine, app, and operational statistics and monitors built-in thresholds.</data>
    </node>
    <node id="12">
      <data key="d5">Amazon DynamoDB (Statistics Storage)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores output statistics and trend records.</data>
    </node>
    <node id="13">
      <data key="d5">Amazon SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends real-time threshold notifications to support channels (e.g., Teams).</data>
    </node>
    <node id="14">
      <data key="d5">Amazon SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends email alerts to supervisors and managers.</data>
    </node>
    <node id="15">
      <data key="d5">Amazon Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Provides authentication for proprietary analytics dashboard.</data>
    </node>
    <node id="16">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API layer backing executive dashboard analytics.</data>
    </node>
    <node id="17">
      <data key="d5">AWS Lambda (Dashboard Service)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Backend service for serving dynamic analytics queries.</data>
    </node>
    <node id="18">
      <data key="d5">Amazon DynamoDB (Ticketing Data)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores internal support tickets and maintenance history.</data>
    </node>
    <node id="19">
      <data key="d5">AWS Lambda (Ticketing Service)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles automated ticket creation for degraded machines.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">MSK triggers MSK ingestion Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">App data sent to Job Queue SQS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">IoT Core forwards device job data to Job Queue SQS.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">IoT Core streams OEE machine telemetry into OEE Queue SQS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">MSK ingestion Lambda writes data to Job Storage DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Job Queue triggers Job Processing Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Job Processing Lambda persists processed data to Job Storage DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Statistical Lambda reads job records from Job Storage DynamoDB.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">OEE Queue triggers OEE Processing Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">OEE Processing Lambda writes machine OEE data into OEE Storage DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Statistical Lambda reads OEE metrics from OEE Storage DynamoDB.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Statistical Lambda reads dentist evals stored in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">3</data>
      <data key="d9">Calculated statistics are stored in Statistics Storage DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="13" id="0">
      <data key="d8">4</data>
      <data key="d9">Statistical service publishes threshold alert messages to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="12" target="14" id="0">
      <data key="d8">4</data>
      <data key="d9">Statistics DynamoDB triggers email notifications via SES for managers and supervisors.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Glidewell Laboratories IoT Restorations Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=5RsZJ-1_sn4</data>
    <data key="d2">Architecture for processing high-volume manufacturing telemetry from dental restoration milling machines and apps, scaling down message ingestion to ~1 million messages daily to trigger recalibrations and alerts.</data>
    <data key="d3">IoT, Analytics, Serverless Telemetry</data>
    <data key="d4">True</data>
