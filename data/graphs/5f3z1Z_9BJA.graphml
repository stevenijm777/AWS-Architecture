<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Prem Database</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Hosts historical database source systems (~20 TB total).</data>
    </node>
    <node id="1">
      <data key="d5">Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">AWS Storage Gateway deployed on-premises using NFS volumes to ingest daily database increments (100 GB/day).</data>
    </node>
    <node id="2">
      <data key="d5">Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Dual 10G AWS Direct Connect aggregated links with SSL encryption.</data>
    </node>
    <node id="3">
      <data key="d5">Landing S3</data>
      <data key="d6">S3</data>
      <data key="d7">Landing zone S3 bucket with 2-day retention period (1 active + 1 buffer day).</data>
    </node>
    <node id="4">
      <data key="d5">Quality Cleansing</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 compute instances executing data quality and cleansing checks.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL RDS storing all ELT metadata, pipeline controls, and transformation scripts.</data>
    </node>
    <node id="6">
      <data key="d5">Transformation S3</data>
      <data key="d6">S3</data>
      <data key="d7">Transformation zone S3 bucket with a 1-day retention period.</data>
    </node>
    <node id="7">
      <data key="d5">Transformation</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 compute instances transforming cleansed data into facts and dimensions.</data>
    </node>
    <node id="8">
      <data key="d5">RedShift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Amazon Redshift cluster storing dimensional model data, queried via Redshift Spectrum.</data>
    </node>
    <node id="9">
      <data key="d5">Publish S3</data>
      <data key="d6">S3</data>
      <data key="d7">Publish zone S3 bucket feeding daily reporting dashboards with a retention of 1 year and 1 month.</data>
    </node>
    <node id="10">
      <data key="d5">Glacier</data>
      <data key="d6">S3</data>
      <data key="d7">S3 Glacier archive for long-term retention of historical data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">On-prem database ingests daily changes into Storage Gateway via NFS volumes.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Storage Gateway streams data over Direct Connect connection.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Direct Connect delivers ingested datasets to the Landing S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Quality Cleansing EC2 nodes pull raw files from Landing S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Quality Cleansing EC2 writes cleansed data into Transformation S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">RDS supplies metadata and cleansing scripts to Quality Cleansing EC2 instances.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">RDS provides metadata and ELT transformation logic to Transformation EC2 instances.</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Transformation EC2 instances pull cleansed data from Transformation S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Transformation EC2 loads transformed facts and dimension tables into Redshift.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Redshift Spectrum publishes daily aggregated reporting datasets to Publish S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Lifecycle rule transitions data from Publish S3 to S3 Glacier after 1 year and 1 month.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Capgemini Life Sciences Netezza to Redshift Data Migration &amp; Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=5f3z1Z_9BJA</data>
    <data key="d2">This HIPAA-compliant architecture ingests 100 GB daily increments over a 2x 10G Direct Connect link. It replaces a legacy Netezza data warehouse with Amazon Redshift using an ELT model driven by RDS Postgres metadata.</data>
    <data key="d3">Migration &amp; Data Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
