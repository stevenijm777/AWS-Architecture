<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Vehicles</data>
      <data key="d6">UserConsumerEdge</data>
      <data key="d7">Vehicles collecting anonymized sensor and visual inspection data on roads worldwide.</data>
    </node>
    <node id="1">
      <data key="d5">REST API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Ingestion REST API located in a separate AWS account to ingest raw data from vehicles.</data>
    </node>
    <node id="2">
      <data key="d5">Raw S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw incoming vehicle observation data.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffer queue that triggers and distributes processing workload to EKS workers.</data>
    </node>
    <node id="4">
      <data key="d5">Process EKS Workers</data>
      <data key="d6">EKS</data>
      <data key="d7">Scales automatically from 100 to 800 workers based on SQS queue size to process 10M daily observations.</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates complex algorithm execution flows (e.g., detecting construction zones, clustering, aggregation).</data>
    </node>
    <node id="6">
      <data key="d5">Store S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores preprocessed, formatted, and algorithm-calculated output data.</data>
    </node>
    <node id="7">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Document-based self-indexing search store for quick querying of mobility intelligence.</data>
    </node>
    <node id="8">
      <data key="d5">CockroachDB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Distributed relational database hosted on EKS to support high-frequency updates to tables.</data>
    </node>
    <node id="9">
      <data key="d5">Consume API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes REST API endpoints for enterprise customers and city planners.</data>
    </node>
    <node id="10">
      <data key="d5">Consume EKS Cluster</data>
      <data key="d6">EKS</data>
      <data key="d7">Serves secured REST API backend and powers web application data access.</data>
    </node>
    <node id="11">
      <data key="d5">Web App</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web application interface for visualizing mobility intelligence and live traffic events.</data>
    </node>
    <node id="12">
      <data key="d5">Enterprise Customers</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">City planners and road operators consuming traffic, pedestrian, and construction zone insights.</data>
    </node>
    <node id="13">
      <data key="d5">End Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End consumers accessing mobility services and real-time road insights.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Vehicles send collected sensor data to the ingestion REST API.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">REST API writes incoming raw data to Raw S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Raw S3 bucket triggers/enqueues work items into SQS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Process EKS workers pull messages from SQS and scale based on queue depth.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS workers trigger Step Functions for parallel algorithm flows.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS workers directly format and store preprocessed data into Store S3.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS workers store calculated observations and document indices in Elasticsearch.</data>
      <data key="d10">2''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS workers write high-frequency updates into CockroachDB.</data>
      <data key="d10">2'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions output algorithmic processing results into Store S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Store S3 data is exposed via API Gateway to enterprise users.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Elasticsearch provides indexed search data to Consume EKS Cluster.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">CockroachDB provides relational state data to Consume EKS Cluster.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway provides mobility API access to enterprise customers.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Consume EKS Cluster serves backend services for the Web App.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="13" id="0">
      <data key="d8">2</data>
      <data key="d9">Web App delivers interactive mobility dashboards to end users.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mobileye Dynamic RAM Mobility Intelligence Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=5hjkSczrke4</data>
    <data key="d2">Dynamic RAM processes 10M daily observations from vehicles using an auto-scaling EKS cluster (100 to 800 workers), Step Functions state machines, and dynamic storage across S3, Elasticsearch, and CockroachDB.</data>
    <data key="d3">Automotive &amp; Data Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
