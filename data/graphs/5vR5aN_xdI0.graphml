<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer Data</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Structured or unstructured customer data source sending via HTTP Event Collector (HEC).</data>
    </node>
    <node id="1">
      <data key="d5">Customer Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless customer processing sending data into Splunk.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams data from AWS directly into Splunk via sticky sessions.</data>
    </node>
    <node id="3">
      <data key="d5">Customer S3</data>
      <data key="d6">S3</data>
      <data key="d7">Target bucket for customer self-storage dynamic data export.</data>
    </node>
    <node id="4">
      <data key="d5">Top ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer handling standard HTTP Event Collector (HEC) ingestion traffic.</data>
    </node>
    <node id="5">
      <data key="d5">Bottom ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Dedicated load balancer enforcing sticky sessions required for Kinesis Data Firehose.</data>
    </node>
    <node id="6">
      <data key="d5">Splunk EC2 Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Auto Scaling EC2 instances acting as indexers and search heads with local smart caching tier.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Glacier</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term cold archive for compliance, rehydratable through Splunk UI.</data>
    </node>
    <node id="8">
      <data key="d5">Splunk S3</data>
      <data key="d6">S3</data>
      <data key="d7">Primary persistent storage backing Splunk cluster after smart cache eviction.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Standard customer data sent across account boundary into Top ELB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Data Firehose streams into Bottom ELB requiring sticky sessions.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Top ELB forwards traffic to EC2 indexer instances.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Bottom ELB forwards sticky Firehose stream to EC2 indexer instances.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Unsearched or evicted cache data is shuttled from EC2 to Splunk S3 storage.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Historical data archived directly to Glacier.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Dynamic data self-storage exports data from Splunk S3 back to Customer S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Splunk Cloud Data Ingestion and Multi-Tier Storage Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=5vR5aN_xdI0</data>
    <data key="d2">Separation of storage and compute architecture showcasing dynamic multi-tier caching and archiving from EC2 to S3 and Glacier, along with customer self-storage export.</data>
    <data key="d3">Analytics, Data Ingestion, Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
