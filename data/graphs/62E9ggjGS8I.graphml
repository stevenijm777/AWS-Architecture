<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal user or developer requesting automated account provisioning.</data>
    </node>
    <node id="1">
      <data key="d5">ITSM Tool</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">IT Service Management tool running workflows for self-service account requests.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Located in Root account; provisions new AWS accounts with required baselines.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Located in Root account; provisions VPCs into vended accounts.</data>
    </node>
    <node id="4">
      <data key="d5">Transit Gateway (Vended)</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Transit Gateway attachment created in the vended account.</data>
    </node>
    <node id="5">
      <data key="d5">VPC (Vended)</data>
      <data key="d6">VPC</data>
      <data key="d7">VPC provisioned in the vended account with tagging for network orchestration.</data>
    </node>
    <node id="6">
      <data key="d5">Transit Gateway (Network)</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Central Transit Gateway located in the core Network Services account.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User triggers self-service workflow via ITSM tool.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ITSM approval kicks off AWS Control Tower in the Root account to create a new account.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Service Catalog provisions a VPC with tags into the Vended account.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Transit Gateway attachment in Vended account connects to central Network account Transit Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DISH Network Automated Multi-Account and Network Provisioning Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=62E9ggjGS8I</data>
    <data key="d2">DISH Network uses an ITSM tool integrated with AWS Control Tower and AWS Service Catalog to automate account vending and Transit Gateway network connectivity across hundreds of AWS accounts.</data>
    <data key="d3">Multi-Account, Networking, Automation, Provisioning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
