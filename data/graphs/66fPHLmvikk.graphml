  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Scientist</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Coordinates model prototyping, experiment runs, and pushes custom container images.</data>
    </node>
    <node id="1">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores custom Docker container images extended via SageMaker container libraries.</data>
    </node>
    <node id="2">
      <data key="d5">S3 DATASET</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw and preprocessed datasets used for SageMaker training.</data>
    </node>
    <node id="3">
      <data key="d5">NOTEBOOK</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker Notebook instance used by data scientists for analysis and triggering training runs.</data>
    </node>
    <node id="4">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker service managing training execution and hyperparameter tuning.</data>
    </node>
    <node id="5">
      <data key="d5">TRAIN</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Training job execution stage.</data>
    </node>
    <node id="6">
      <data key="d5">MODEL</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trained machine learning model representation.</data>
    </node>
    <node id="7">
      <data key="d5">S3 MODEL</data>
      <data key="d6">S3</data>
      <data key="d7">Stores trained model artifacts generated from training jobs.</data>
    </node>
    <node id="8">
      <data key="d5">ENDPOINT</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Hosted SageMaker endpoint serving real-time model inference.</data>
    </node>
    <node id="9">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute function that invokes SageMaker Endpoint and enriches response payload.</data>
    </node>
    <node id="10">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts production application infrastructure initiating real-time prediction requests.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Scientist pushes custom Docker images to ECR.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Scientist coordinates experiments via SageMaker Notebook.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker retrieves base custom container images from ECR.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker Endpoint uses custom images from ECR for model hosting.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker retrieves dataset from S3 DATASET bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Notebook triggers training job execution.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Training job produces trained model artifact.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker Endpoint loads trained model artifacts stored in S3 MODEL bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda invokes SageMaker Endpoint to retrieve model predictions.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 application invokes Lambda function for real-time requests.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Content Wise Machine Learning Platform on SageMaker</data>
    <data key="d1">https://www.youtube.com/watch?v=66fPHLmvikk</data>
    <data key="d2">Architecture used by Content Wise to build, train, and deploy custom machine learning algorithms for digital content personalization using Amazon SageMaker, AWS Lambda, and Amazon EC2.</data>
    <data key="d3">Machine Learning, Analytics &amp; Data Processing, Compute &amp; Serverless</data>
