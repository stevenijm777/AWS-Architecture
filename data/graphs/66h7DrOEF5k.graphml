<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Input Data</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw training datasets and training scripts.</data>
    </node>
    <node id="1">
      <data key="d5">Kubernetes</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Container orchestrator managing GPU instance training jobs.</data>
    </node>
    <node id="2">
      <data key="d5">GPU Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances equipped with GPUs for deep learning training workloads.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Model Storage</data>
      <data key="d6">S3</data>
      <data key="d7">Stores trained ML models ready for deployment to inference environments.</data>
    </node>
    <node id="4">
      <data key="d5">LOAD BALANCER</data>
      <data key="d6">ALB</data>
      <data key="d7">Receives external incoming HTTP/HTTPS inference requests.</data>
    </node>
    <node id="5">
      <data key="d5">Proxy Service</data>
      <data key="d6">ECS</data>
      <data key="d7">Reverse proxy container running on ECS that dynamically routes requests using DynamoDB IP lookups.</data>
    </node>
    <node id="6">
      <data key="d5">ECS Services</data>
      <data key="d6">ECS</data>
      <data key="d7">Target inference services hosting ML models for blue-green deployments.</data>
    </node>
    <node id="7">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Lookup table storing mapping of active service names to endpoint IP addresses.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless function that processes lifecycle events and updates service IPs in DynamoDB.</data>
    </node>
    <node id="9">
      <data key="d5">CLOUDWATCH EVENTS</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Captures ECS task state change events.</data>
    </node>
    <node id="10">
      <data key="d5">EC2 SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">Spot instances used to minimize compute infrastructure costs.</data>
    </node>
    <node id="11">
      <data key="d5">spotinst</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party platform used to manage EC2 Spot instance autoscaling and cost optimization.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Training data and scripts are pulled from S3 into the GPU cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Trained ML model artifacts are saved to S3 model storage.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Models stored in S3 are deployed to ECS inference services.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Inference traffic is forwarded from ALB to the Proxy Service.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Proxy Service queries DynamoDB for target service IP.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Proxy Service forwards traffic to the corresponding ECS inference service endpoint.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS deployment state changes trigger CloudWatch Events.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB returns the active service IP mapping to Proxy Service.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda registers updated service names and IP addresses into DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch Events invokes the Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">ABEJA Platform ML Training and Inference Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=66h7DrOEF5k</data>
    <data key="d2">This architecture describes the ABEJA Platform for end-to-end machine learning workflows on AWS. It features a Kubernetes GPU training cluster, S3 model artifacts storage, blue-green deployment using ECS, and custom dynamic service discovery driven by CloudWatch Events, Lambda, and DynamoDB.</data>
    <data key="d3">ML/AI, Containers, Compute</data>
    <data key="d4">True</data>
  </graph>
</graphml>
