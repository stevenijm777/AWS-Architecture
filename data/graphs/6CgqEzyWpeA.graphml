  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client Devices</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Web and mobile devices requesting and playing personalized videos.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point that implements usage plans and API keys to manage customer load.</data>
    </node>
    <node id="2">
      <data key="d5">RAS Frontend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Performs initial validations and manages SQS workflows.</data>
    </node>
    <node id="3">
      <data key="d5">SQS Jobs Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues rendering instructions for the rendering engine.</data>
    </node>
    <node id="4">
      <data key="d5">SQS Responses Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives rapid job acknowledgments and playlist details.</data>
    </node>
    <node id="5">
      <data key="d5">Rendering EC2 Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Spot instances rendering personalized video segments.</data>
    </node>
    <node id="6">
      <data key="d5">Auto Scaling Group</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Spans multiple AZs with diversified spot instance types.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores completed personalized video segments.</data>
    </node>
    <node id="8">
      <data key="d5">CloudFront CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Delivers personalized video segments efficiently to clients.</data>
    </node>
    <node id="9">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers custom scaling Lambda execution every 15 seconds.</data>
    </node>
    <node id="10">
      <data key="d5">Scaling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Analyzes metrics and commands the ASG to adjust capacity.</data>
    </node>
    <node id="11">
      <data key="d5">CloudWatch Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects rendering performance metrics and intercepts spot termination notifications.</data>
    </node>
    <node id="12">
      <data key="d5">Interruption Handler Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggers on spot interruptions to safely drain rendering jobs and detach EC2 instances.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">User requests monthly personalized video bill.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="0" target="8">
      <data key="d8">1</data>
      <data key="d9">User device requests video streaming segment.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">API Gateway proxies validated requests to the frontend Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">Pushes rendering job details onto the jobs SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="0">
      <data key="d8">0</data>
      <data key="d9">Provides the video playlist link directly back to user device player.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="5">
      <data key="d8">0</data>
      <data key="d9">Rendering instances pull rendering tasks when capacity is free.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="2">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda polls for response status and video playlist details.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="4">
      <data key="d8">0</data>
      <data key="d9">Immediately acknowledges job receipt and sends initial status back to response SQS queue.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="7">
      <data key="d8">1</data>
      <data key="d9">Finished video segments are uploaded directly to the S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="11">
      <data key="d8">3</data>
      <data key="d9">Rendering instances publish custom performance metrics to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="8" target="7">
      <data key="d8">1</data>
      <data key="d9">CloudFront fetches missing video segments from S3 bucket origin.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="9" target="10">
      <data key="d8">3</data>
      <data key="d9">Step Functions triggers the scaling Lambda every 15 seconds.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="10" target="6">
      <data key="d8">3</data>
      <data key="d9">Instructs ASG to scale the spot instance fleet up or down.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="11" target="12">
      <data key="d8">2</data>
      <data key="d9">CloudWatch Events captures 2-minute Spot termination notice and triggers Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="12" target="5">
      <data key="d8">2</data>
      <data key="d9">Calls EC2 API to stop pulling new jobs and safely drain ongoing rendering tasks.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="12" target="6">
      <data key="d8">2</data>
      <data key="d9">Detaches the interrupted instance from the ASG.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">SundaySky: Create Personalized Videos in Real Time on GPU-based Spot Instances for Video Rendering</data>
    <data key="d1">https://www.youtube.com/watch?v=6CgqEzyWpeA</data>
    <data key="d2">Dynamic video rendering architecture using AWS EC2 Spot instances, auto-scaled with high availability mechanisms, custom Step Function schedules, and event-driven Spot interruption handlers.</data>
    <data key="d3">Media &amp; Entertainment, Computing, Serverless</data>
    <data key="d4">True</data>
  </graph>
