<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Devices</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Initiates personalized rendering requests and plays back video segments.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for client devices, configured with usage plans and API keys to manage API load.</data>
    </node>
    <node id="2">
      <data key="d5">Frontend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates requests, pushes tasks to SQS, and retrieves immediate responses to provide playlist links.</data>
    </node>
    <node id="3">
      <data key="d5">Request Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers the rendering tasks/instructions for the processing engines.</data>
    </node>
    <node id="4">
      <data key="d5">Response Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives quick start acknowledgments from processing engines to complete the playlist link handshake.</data>
    </node>
    <node id="5">
      <data key="d5">Rendering EC2 Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Diversified, multi-AZ spot instances that process rendering tasks and upload video chunks.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 Auto Scaling</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Dynamically scales diversified instance types across multiple AZs to ensure cost efficiency and high availability.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores rendered video segments uploaded by EC2 rendering engines.</data>
    </node>
    <node id="8">
      <data key="d5">CloudFront CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Caches and serves video segments globally to client players.</data>
    </node>
    <node id="9">
      <data key="d5">Step Functions Orchestrator</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers the custom scaling loop every 15 seconds to evaluate farm load.</data>
    </node>
    <node id="10">
      <data key="d5">Scaling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Calculates required rendering capacity based on CloudWatch metrics and triggers ASG scaling changes.</data>
    </node>
    <node id="11">
      <data key="d5">CloudWatch Events / Metrics</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Hosts instance metrics and publishes spot interruption event notices.</data>
    </node>
    <node id="12">
      <data key="d5">Interruption Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles spot terminations by telling the targeted EC2 instance to drain rendering tasks and detaching it from the ASG.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests a personalized video stream.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Device player requests segments via the CloudFront CDN endpoint.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes the API request to the Frontend Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Pushes video rendering instructions to the Request Queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Returns playlist link back to the user device player.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Spot EC2 instances pull rendering jobs when they have spare capacity.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda polls for fast response to get playlist details.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends immediate acknowledgement response to the queue once processing starts.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Uploads generated video segments to S3 storage.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront fetches missing or expired video segments from the S3 origin.</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers the scaling evaluator Lambda function every 15 seconds.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Queries custom engine metrics pushed from EC2 instances to CloudWatch.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Adjusts instance desired capacity on the Auto Scaling Group based on workload calculations.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">Sends 2-minute spot instance termination notice event to the Interruption Handler.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="12" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Triggers EC2 API to stop pulling new jobs and finish rendering current work before timeout.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="12" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Detaches the terminating spot instance from the Auto Scaling Group dynamically.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">SundaySky Rendering as a Service (RAS) Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6CgqEzyWpeA</data>
    <data key="d2">Architectural representation of SundaySky's personalized video rendering engine using EC2 Spot instances, SQS queues, Step Functions scaling orchestration, and a custom spot instance interruption draining mechanism.</data>
    <data key="d3">Media, Compute, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
