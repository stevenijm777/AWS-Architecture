<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Devices</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End-user mobile or web devices requesting personalized video playback and rendering.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for video rendering requests, applying usage plans and API keys for request throttling.</data>
    </node>
    <node id="2">
      <data key="d5">Frontend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates incoming rendering requests, places jobs on SQS, retrieves response playlist metadata, and responds to users.</data>
    </node>
    <node id="3">
      <data key="d5">Request SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue holding rendering job instructions for EC2 instances to pull.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 Auto Scaling</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Fleet of diversified Spot EC2 instances across multiple AZs that execute video rendering tasks.</data>
    </node>
    <node id="5">
      <data key="d5">Response SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue receiving immediate acknowledgment and playlist response data from EC2 rendering nodes.</data>
    </node>
    <node id="6">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores rendered video segments uploaded by EC2 rendering engines.</data>
    </node>
    <node id="7">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN caching and serving video segments from the S3 origin to end users.</data>
    </node>
    <node id="8">
      <data key="d5">CloudWatch Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Receives Spot interruption notices and instance metrics.</data>
    </node>
    <node id="9">
      <data key="d5">Interruption Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by CloudWatch Events upon Spot instance interruption notices to stop job intake and detach instances from ASG.</data>
    </node>
    <node id="10">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Executes state machine schedule triggering Scaling Lambda every 15 seconds.</data>
    </node>
    <node id="11">
      <data key="d5">Scaling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Calculates required rendering capacity based on metrics and updates EC2 Auto Scaling Group target capacity.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User device sends rendering request to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">User device streams video content segments via CloudFront.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes request to Frontend Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda pushes rendering job instructions to Request SQS Queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda returns playlist file link to User Devices.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 Auto Scaling rendering nodes pull jobs from Request SQS Queue when capacity allows.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 rendering engine sends response metadata to Response SQS Queue.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 rendering instances upload rendered video segments to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 instances push metrics and event statuses to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda pulls response metadata from Response SQS Queue.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront pulls video segments from S3 origin.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch Events triggers Interruption Lambda upon 2-minute Spot interruption notification.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Interruption Lambda calls EC2 API to stop taking jobs, drain existing rendering tasks, and detach instance from ASG.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Step Functions triggers Scaling Lambda every 15 seconds.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Scaling Lambda updates EC2 Auto Scaling group capacity based on traffic calculation.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">SundaySky Rendering as a Service Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6CgqEzyWpeA</data>
    <data key="d2">SundaySky presents its Rendering as a Service (RaaS) architecture using Spot EC2 instances, SQS queues, Lambda functions, Step Functions, CloudWatch Events, CloudFront, and S3 for personalized video generation.</data>
    <data key="d3">Video Rendering, AWS Architecture, Serverless &amp; Spot EC2 Auto Scaling</data>
    <data key="d4">True</data>
  </graph>
</graphml>
