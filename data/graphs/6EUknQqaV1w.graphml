<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis Data Streams (Collect)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingests real-time cloud security events and evaluates resource state from cloud providers.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Streams (Rules)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Buffers incoming events and resource changes for the security rule execution engine.</data>
    </node>
    <node id="2">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Primary schema-less graph database storing 50M+ interconnected cloud resources for topology exploration and rule queries.</data>
    </node>
    <node id="3">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Backing store powering search aggregations, reporting, analytics, and historical configuration tracking.</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors CPU, memory, and performance metrics from Neptune and Elasticsearch to inform the Sharder service.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Backing store persisting resource configurations and detected security violations.</data>
    </node>
    <node id="6">
      <data key="d5">Notifications</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External notification channels including Slack, email, and Splunk for real-time risk alerts.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Publishes collected resource states into Neptune graph database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Propagates collected security events to the rule evaluation pipeline stream.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Queries Neptune graph database to evaluate security rules against cloud resource topology.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Saves detected security violations into DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Replicates resource data to Elasticsearch for search aggregations and analytical reporting.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Persists resource state changes to DynamoDB backing store.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends capacity and load metrics to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Sharder service reads CloudWatch metrics to load balance write traffic across Neptune clusters.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Triggers real-time security alerts to external notification channels like Slack, email, and Splunk.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">CloudHealth SecureState Real-Time Security Monitoring Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6EUknQqaV1w</data>
    <data key="d2">Transcribed architecture diagram of CloudHealth SecureState by VMware showing event collection, graph ingestion in Neptune, secondary backing stores, dynamic write sharding, rule evaluation, and alerting.</data>
    <data key="d3">Security &amp; Compliance, Big Data &amp; Analytics, Event-Driven Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
