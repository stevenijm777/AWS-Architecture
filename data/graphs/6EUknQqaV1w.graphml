<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis Data Streams (Collect)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Ingests real-time security and compliance configuration event streams from multiple cloud providers.</data>
    </node>
    <node id="1">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Highly interconnected graph database storing schema-less cloud resource configurations of over 50M+ resources.</data>
    </node>
    <node id="2">
      <data key="d5">Elasticsearch</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Provides search, slicing and dicing, and aggregation capabilities over resource data.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Acts as secondary backup and stores history of configuration changes as well as detected violations.</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors CPU, memory, and performance metrics for Neptune and Elasticsearch clusters.</data>
    </node>
    <node id="5">
      <data key="d5">Shard Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Intelligent routing service that dynamically load-balances data writes across provisioned Neptune shards.</data>
    </node>
    <node id="6">
      <data key="d5">Kinesis Data Streams (Rules)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Rules engine data stream that triggers thousands of compliance checks based on incoming resource changes.</data>
    </node>
    <node id="7">
      <data key="d5">Email</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Alerting target for real-time compliance violation notifications via Email.</data>
    </node>
    <node id="8">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Alerting target for real-time compliance violation notifications via Slack.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingest processed resource configuration changes into Amazon Neptune.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Propagate resource changes downstream to the rules engine stream.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Index graph resource data into Elasticsearch for robust search and reporting.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Store configuration history and database backups in DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Send database resource utilization metrics to CloudWatch.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Send search cluster metrics to CloudWatch.</data>
      <data key="d10">4'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Shard Service reads CPU and memory metrics to evaluate Neptune and Elasticsearch cluster capacities.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Dynamically route/shard incoming data writes to Neptune based on capacity analysis.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Rules engine queries Neptune to perform graph-based security audits.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Persist detected security compliance violations.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Send real-time alerts via Email.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Send real-time alerts via Slack.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Cloud Health Secure State Real-Time Security and Compliance Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=6EUknQqaV1w</data>
    <data key="d2">Real-time security auditing pipeline managing 50M+ resources and handling billions of events daily using Amazon Neptune graph databases, sharding, and Elasticsearch search indexes.</data>
    <data key="d3">Security, Real-time Analytics, Databases</data>
    <data key="d4">True</data>
  </graph>
