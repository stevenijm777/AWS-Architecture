<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Cloud Provider Events</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Native event streams such as CloudWatch or activity logs from major cloud providers.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Streams (Collect)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Evaluates incoming events, determines the resource state, and ingests them.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Stores the interconnected cloud resource state. Chosen for its schema-less graph capabilities and read scale-out.</data>
    </node>
    <node id="3">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Used as a backing store to power reporting, search, and analytics capabilities.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Backing store to track resource configuration changes over time and to persist security violations.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Aggregates performance and utilization metrics from Neptune and Elasticsearch.</data>
    </node>
    <node id="6">
      <data key="d5">Sharder Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom load balancer that monitors Neptune capacity (CPU/memory) to scale writes out across clusters.</data>
    </node>
    <node id="7">
      <data key="d5">Kinesis Data Streams (Rules)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Fronts the rule execution pipeline, queuing resource state changes to be evaluated against policy rules.</data>
    </node>
    <node id="8">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Receives real-time security alerts and violation notifications.</data>
    </node>
    <node id="9">
      <data key="d5">Email</data>
      <data key="d6">SES</data>
      <data key="d7">Sends email notifications for critical security alerts.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Ingests native cloud provider event streams.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">Persists evaluated resource states into Neptune graph database.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="7">
      <data key="d8">2</data>
      <data key="d9">Propagates event changes to rules pipeline.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">Synchronizes graph data to Elasticsearch for analytics and search indexing.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="4">
      <data key="d8">0</data>
      <data key="d9">Synchronizes historical resource configuration configurations over time.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="5">
      <data key="d8">1</data>
      <data key="d9">Emits database cluster metrics (CPU/Memory).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="7">
      <data key="d8">2</data>
      <data key="d9">Resource changes flow from graph database for evaluation.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="5">
      <data key="d8">1</data>
      <data key="d9">Emits search cluster metrics.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="6">
      <data key="d8">1</data>
      <data key="d9">Metrics are ingested by Sharder Service to check shard capacity.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="2">
      <data key="d8">1</data>
      <data key="d9">Dynamically load balances writes based on cluster capacities.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="2">
      <data key="d8">2</data>
      <data key="d9">Queries Neptune to run security checks across thousands of rules.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="4">
      <data key="d8">2</data>
      <data key="d9">Stores detected security violations in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="8">
      <data key="d8">2</data>
      <data key="d9">Sends real-time notifications to Slack channels.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="9">
      <data key="d8">2</data>
      <data key="d9">Sends real-time email alerts.</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">CloudHealth by VMware: Secure State. Manages Over 50M Assets from Billions of Events on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=6EUknQqaV1w</data>
    <data key="d2">Handles billions of security events per day, monitoring over 50 million cloud resources.</data>
    <data key="d3">Security, Analytics, Real-Time Data Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
