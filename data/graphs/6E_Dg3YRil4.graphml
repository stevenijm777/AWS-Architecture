  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS Organizations</data>
      <data key="d6">Organizations</data>
      <data key="d7">AWS Organizations creates dedicated environments for OEM customers.</data>
    </node>
    <node id="1">
      <data key="d5">IoT Connect Admin</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">IoT Connect Admin monitors data plane deployments and operational health.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS stores SQL metadata and environment telemetry for administration.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon API Gateway (Control Plane)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Control plane API Gateway providing API access to administration metadata.</data>
    </node>
    <node id="4">
      <data key="d5">AWS CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">AWS CloudFormation deploys data plane environments for OEM customers.</data>
    </node>
    <node id="5">
      <data key="d5">IoT Thing</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">OEM IoT devices sending telemetry data to the platform.</data>
    </node>
    <node id="6">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">AWS IoT Core containing IoT rule endpoints and 12 preconfigured IoT actions.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Amazon Kinesis ingesting high-throughput streaming telemetry data.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 providing cold storage for long-term telemetry retention.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Amazon DynamoDB flexible NoSQL database storing heterogeneous device telemetry.</data>
    </node>
    <node id="10">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">12 preconfigured AWS Lambda functions handling dynamic rule processing and routing.</data>
    </node>
    <node id="11">
      <data key="d5">Amazon SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Amazon SNS available for notification delivery.</data>
    </node>
    <node id="12">
      <data key="d5">Amazon SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Amazon SQS available for message queuing.</data>
    </node>
    <node id="13">
      <data key="d5">Amazon API Gateway (Data Plane)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Data plane API Gateway entry point into the customer application layer.</data>
    </node>
    <node id="14">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Amazon SageMaker executing ML model inference compute in the cloud.</data>
