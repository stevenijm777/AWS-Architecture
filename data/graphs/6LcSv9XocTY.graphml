<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Main contact center service handling inbound calls and user telephony interactions.</data>
    </node>
    <node id="1">
      <data key="d5">AWS Lambda (Data Dip)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Performs real-time data dips to fetch customer context during calls.</data>
    </node>
    <node id="2">
      <data key="d5">Salesforce</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External CRM system providing customer profile data.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon S3 (Reporting Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores call center event metrics and logs for analytics.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries event data in S3 to power contact center operational dashboards.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon S3 (Call Recordings)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores completed audio call recordings.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts call audio recordings stored in S3 into text transcriptions.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Analyzes transcription text for sentiment analysis and post-call insights.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Lambda (Post-Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Used for post-call processing operations.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Connect triggers Lambda to execute a customer data dip.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Connect streams event and metric data into S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Completed call recordings are saved to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda queries Salesforce CRM for customer information.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Salesforce returns customer details to Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries event metrics in S3 for reporting.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 audio recording is sent to Amazon Transcribe for speech-to-text conversion.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Transcribed speech text is sent to Amazon Comprehend for sentiment analysis.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Intuit - Global Contact Center Architecture with Amazon Connect</data>
    <data key="d1">https://www.youtube.com/watch?v=6LcSv9XocTY</data>
    <data key="d2">Intuit leverages Amazon Connect alongside serverless AWS services (Lambda, S3, Athena, Transcribe, Comprehend) and Salesforce CRM to power their global contact centers and analyze customer interactions.</data>
    <data key="d3">Call Center, AI/ML, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
