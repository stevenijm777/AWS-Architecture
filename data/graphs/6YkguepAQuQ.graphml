<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Initiates pipeline by committing code modifications to the repository.</data>
    </node>
    <node id="1">
      <data key="d5">AWS CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Orchestrates the continuous integration and continuous deployment pipeline stages.</data>
    </node>
    <node id="2">
      <data key="d5">AWS CodeCommit</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">AWS Git repository hosting the application code and CloudFormation templates.</data>
    </node>
    <node id="3">
      <data key="d5">AWS CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Serverless build service that compiles code, runs tests, and packages container images.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Elastic Container Registry</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores versioned container images generated by the CodeBuild process.</data>
    </node>
    <node id="5">
      <data key="d5">AWS CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Applies changes across environments using parallel execution, operating with a Change Set -&gt; Approve -&gt; Execute flow.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Virtual Private Cloud</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Isolated network environment hosting the production and customer-specific resources.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Elastic Container Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Runs the core containerized application tasks within the VPC.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Identity and Access Management</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Defines application and runtime roles deployed and managed alongside the infrastructure.</data>
    </node>
    <node id="9">
      <data key="d5">Elastic Load Balancing</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Application Load Balancer (ALB) routing external traffic to ECS tasks.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer commits application and CloudFormation code modifications to CodeCommit.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CodePipeline detects commit changes in AWS CodeCommit and triggers execution.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">CodePipeline transitions to the deployment stage, initiating the AWS CloudFormation workflow.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Source files and code are sent to AWS CodeBuild.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CodeBuild builds the Docker image and pushes it to Amazon ECR registry.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFormation deploys and provisions parallel resources into target VPCs using tenant-specific templates.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Deploys or updates Amazon ECS services and task definitions using images from ECR.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Deploys/manages necessary IAM policies and service execution roles.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Configures and routes target groups on the Application Load Balancer.</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Multi-Tenant CI/CD Pipeline and Automated Infrastructure Deployment</data>
    <data key="d1">https://www.youtube.com/watch?v=6YkguepAQuQ</data>
    <data key="d2">Automates both application builds and core networking/IAM infrastructure deployments per tenant VPC using a 3-step CloudFormation governance workflow (Change Set, Approve, Execute) orchestrated by AWS CodePipeline.</data>
    <data key="d3">DevOps, Security, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
