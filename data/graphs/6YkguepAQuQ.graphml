<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">The developer initiating code commits and defining deployment infrastructure using CloudFormation templates.</data>
    </node>
    <node id="1">
      <data key="d5">CodeCommit</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">Secure, scalable private Git repository storing application code and CloudFormation files.</data>
    </node>
    <node id="2">
      <data key="d5">CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Build service that compiles source code, runs tests, and packages application containers on demand.</data>
    </node>
    <node id="3">
      <data key="d5">ECR Registry</data>
      <data key="d6">ECR</data>
      <data key="d7">Amazon Elastic Container Registry storing built application images ready for container tasks.</data>
    </node>
    <node id="4">
      <data key="d5">CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Orchestrator that automates the release pipeline stages from CodeCommit trigger to deployment.</data>
    </node>
    <node id="5">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Deploys consistent architectures across different environments using a three-stage gate: Change Set, Approve, and Execute.</data>
    </node>
    <node id="6">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">Isolated virtual network environment. Up to 100 customer VPCs can be deployed and managed in parallel.</data>
    </node>
    <node id="7">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Amazon Elastic Container Service running the containerized healthcare analytics workloads.</data>
    </node>
    <node id="8">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Governs precise execution roles and resource permissions deployed alongside the app.</data>
    </node>
    <node id="9">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing client traffic to individual ECS containers.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Developer commits application updates and CloudFormation infrastructure modifications.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="4">
      <data key="d8">0</data>
      <data key="d9">Code commit triggers CodePipeline execution.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">CodeBuild builds and pushes the updated Docker container image to the ECR Registry.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="7">
      <data key="d8">0</data>
      <data key="d9">ECS pulls the newly-pushed application image from Amazon ECR registry to launch tasks.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="2">
      <data key="d8">0</data>
      <data key="d9">CodePipeline triggers the build stage hosted in CodeBuild.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="5">
      <data key="d8">0</data>
      <data key="d9">CodePipeline initiates the CloudFormation deploy stage once the image is ready.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="6">
      <data key="d8">0</data>
      <data key="d9">CloudFormation deploys and updates resources across up to 100 client VPC environments in parallel.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="7">
      <data key="d8">0</data>
      <data key="d9">Deploys or updates ECS task definitions and container services.</data>
      <data key="d10">6'</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="8">
      <data key="d8">0</data>
      <data key="d9">Deploys or updates application-specific IAM roles and permissions.</data>
      <data key="d10">6''</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="9">
      <data key="d8">0</data>
      <data key="d9">Deploys or updates Application Load Balancer parameters.</data>
      <data key="d10">6'''</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Aetion: Deploy Applications  Provision Cloud Resources with AWS Developer Tools</data>
    <data key="d1">https://www.youtube.com/watch?v=6YkguepAQuQ</data>
    <data key="d2">An agile CI/CD architecture leveraging CloudFormation templates to provision multi-tenant, isolated customer VPCs in parallel. Governance is maintained through a three-stage deployment process (ChangeSet, Approve, Execute).</data>
    <data key="d3">DevOps, Container, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
