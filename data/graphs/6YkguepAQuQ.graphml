<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Dev</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developer committing application and infrastructure code changes into the repository.</data>
    </node>
    <node id="1">
      <data key="d5">CODEPIPELINE</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">AWS CodePipeline orchestrating the end-to-end continuous integration and deployment stages.</data>
    </node>
    <node id="2">
      <data key="d5">CODECOMMIT</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">AWS CodeCommit repository storing source code and CloudFormation templates.</data>
    </node>
    <node id="3">
      <data key="d5">CODEBUILD</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">AWS CodeBuild executing build steps, spinning up temporary build containers, and creating application container images.</data>
    </node>
    <node id="4">
      <data key="d5">CLOUDFORMATION</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">AWS CloudFormation managing resource provisioning through a 3-step change set, approval, and execution process.</data>
    </node>
    <node id="5">
      <data key="d5">REGISTRY</data>
      <data key="d6">ECR</data>
      <data key="d7">Amazon ECR storing container images ready for deployment.</data>
    </node>
    <node id="6">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">Target Virtual Private Cloud environment isolated for customer deployments.</data>
    </node>
    <node id="7">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Amazon ECS running application tasks within the target VPC.</data>
    </node>
    <node id="8">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">IAM roles and permissions configured for application security within the VPC.</data>
    </node>
    <node id="9">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer deployed alongside the application tasks inside the VPC.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer commits code updates into the CodeCommit repository.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CodeCommit triggers the CodeBuild stage to start container compilation.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CodeBuild pushes the compiled container image to Amazon ECR Registry.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation provisions and deploys application infrastructure components (ECS task definitions, IAM roles, and ALB) into the VPC.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Etion Continuous Integration and Automated VPC Deployment Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6YkguepAQuQ</data>
    <data key="d2">This architecture illustrates Etion's automated pipeline that streamlines code deployment and infrastructure provisioning using AWS CodePipeline, CodeCommit, CodeBuild, Amazon ECR, and AWS CloudFormation to consistently instantiate VPC environments with ECS, IAM roles, and Application Load Balancers.</data>
    <data key="d3">DevOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
