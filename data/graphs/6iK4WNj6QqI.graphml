<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Fans accessing the Ticketmaster checkout system to view events and purchase tickets.</data>
    </node>
    <node id="1">
      <data key="d5">CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN layer using latency and geo-routing to direct fans to the nearest active region and manage region health routing.</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs Next.js web application for server-side page rendering.</data>
    </node>
    <node id="3">
      <data key="d5">AppSync</data>
      <data key="d6">AppSync</data>
      <data key="d7">Central API layer exposing GraphQL queries, mutations, and WebSocket subscriptions.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes single-step operations, quick data retrieval, and data transformation.</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions Purchase</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates complex multi-step purchase processes including payment collection and order processing.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Provides data persistence and active-active multi-region data replication using DynamoDB Global Tables.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User accesses checkout web application via CDN.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CDN routes web page rendering requests to Next.js on EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">AppSync triggers Lambda for single-step queries and data retrieval.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">AppSync triggers Step Functions for multi-step purchase workflows.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">AppSync pushes real-time asynchronous updates back to CDN/client using WebSocket subscriptions.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda retrieves and stores session and event data in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">DynamoDB Global Tables perform bidirectional active-active data replication across regions.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ticketmaster Multi-Region Serverless Checkout Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6iK4WNj6QqI</data>
    <data key="d2">Ticketmaster checkout architecture utilizing Next.js on EKS, GraphQL and WebSockets on AWS AppSync, Lambda, Step Functions, and DynamoDB Global Tables across active-active AWS regions.</data>
    <data key="d3">Serverless, Multi-Region, E-Commerce</data>
    <data key="d4">True</data>
  </graph>
</graphml>
