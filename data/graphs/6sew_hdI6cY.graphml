  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Handles external domain resolution and internal FQDN service routing.</data>
    </node>
    <node id="1">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall providing anti-DDoS and anti-bot protection.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN edge caching service using behavior path rules to direct traffic.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Load Balancer</data>
      <data key="d6">EC2</data>
      <data key="d7">Proprietary Pass Secure load balancer running on EC2 instance pair.</data>
    </node>
    <node id="4">
      <data key="d5">EKS Cluster</data>
      <data key="d6">EKS</data>
      <data key="d7">Kubernetes cluster hosting Magento e-commerce application workloads.</data>
    </node>
    <node id="5">
      <data key="d5">ElasticSearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Search indexing engine integrated with EKS.</data>
    </node>
    <node id="6">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory caching layer for application cache and user sessions.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 NFS Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Dedicated EC2 instance providing NFS shared storage.</data>
    </node>
    <node id="8">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage bucket for static media assets and logs.</data>
    </node>
    <node id="9">
      <data key="d5">Aurora MySQL</data>
      <data key="d6">Aurora</data>
      <data key="d7">Primary relational database for store data, featuring geo-replication and point-in-time recovery.</data>
    </node>
    <node id="10">
      <data key="d5">VPC VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">IPsec VPN entry point for managing all AWS infrastructure services.</data>
    </node>
    <node id="11">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute used for system configuration, monitoring, and alerting.</data>
    </node>
    <node id="12">
      <data key="d5">RedShift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse service used for business intelligence (BI) analytics.</data>
    </node>
    <node id="13">
      <data key="d5">EC2 Mail Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Standalone EC2 instance running self-managed mail server software.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes incoming web traffic into WAF.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF passes inspected and filtered web requests to CloudFront.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront routes static asset requests directly to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront forwards dynamic requests to Pass Secure LB on EC2.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 load balancer directs backend application traffic to EKS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS queries ElasticSearch for product search indexing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS manages user sessions and cache through ElastiCache.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS mounts and accesses shared files on the custom EC2 NFS server.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS executes transactional queries on the Aurora MySQL database.</data>
      <data key="d10">0'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS reads and writes static media elements and log files to S3.</data>
      <data key="d10">0''''</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Triboo Magento E-Commerce Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6sew_hdI6cY</data>
    <data key="d2">Triboo manages over 100 online stores using a Magento stack deployed on AWS EKS and custom EC2 load balancers.</data>
    <data key="d3">E-Commerce Infrastructure, Kubernetes Containerization, Hybrid Storage &amp; Caching</data>
    <data key="d4">True</data>
