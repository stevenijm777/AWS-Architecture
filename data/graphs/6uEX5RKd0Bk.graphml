<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile user application initiating chat sessions and receiving real-time messages or push notifications.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon EKS REST and WebSocket</data>
      <data key="d6">EKS</data>
      <data key="d7">Frontend WebSocket and REST routing layer hosted on EKS managing active client connections (W1 and W2).</data>
    </node>
    <node id="2">
      <data key="d5">Amazon EKS Chat and Notifications</data>
      <data key="d6">EKS</data>
      <data key="d7">Core microservices brain handling authentication, validation, persistence bifurcation, and message delivery logic.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Pinpoint</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">Targeted push notification service used to notify offline users over telephony networks.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon ElastiCache for Redis</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory cache layer storing user inbox state to serve read-heavy inbox queries fast.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational PostgreSQL database for message metadata, message ordering, timestamps, and inbox state.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database providing scalable storage for application-level encrypted chat message bodies.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon MSK</data>
      <data key="d6">MSK</data>
      <data key="d7">Managed Streaming for Apache Kafka used as an event bus to stream chat metadata to downstream consumers like anti-spam.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User opens chat and sends message over WebSocket connection W1.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">WebSocket edge layer forwards request to internal chat microservices for low-level validation and processing.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">WebSocket layer pushes real-time chat message (W2) back to active recipient phone.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Chat microservice encrypts payload and persists message body into DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Chat microservice writes metadata, envelope headers, and inbox timestamps into Aurora Postgres.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Chat microservice emits metadata event to MSK Kafka topic for async processing.</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Chat service checks and updates user inbox state in ElastiCache Redis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Chat microservice triggers WebSocket layer if the recipient user is currently online.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">If recipient is offline, Chat service requests push notification via Pinpoint.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">Pinpoint sends mobile push notification to offline user device.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">On cache miss, inbox metadata is fetched from Aurora PostgreSQL to repopulate Redis cache.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Grindr Next-Gen Chat Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6uEX5RKd0Bk</data>
    <data key="d2">Grindr's chat platform processes over 120 billion messages annually using AWS EKS microservices, DynamoDB for encrypted message bodies, Aurora for metadata, ElastiCache Redis for fast inbox caching, Pinpoint for push notifications, and MSK for event streaming.</data>
    <data key="d3">Mobile, Messaging, Microservices, Caching, Event-Driven</data>
    <data key="d4">True</data>
  </graph>
</graphml>
