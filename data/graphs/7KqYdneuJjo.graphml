<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Healthcare job seekers searching for opportunities using natural language queries.</data>
    </node>
    <node id="1">
      <data key="d5">.Net Application Amazon ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Application controller running on Amazon ECS handling query requests.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Bedrock Claude 2 (Top)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Bedrock Claude 2 LLM used for prompt sanitization, prompt injection check, and geolocation parsing.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Bedrock Titan (Middle)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Bedrock Titan embedding model used to vectorize queries based on speed and cost efficiency.</data>
    </node>
    <node id="4">
      <data key="d5">MS SQL Amazon EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">MS SQL database running on EC2 to retrieve user search and chat history.</data>
    </node>
    <node id="5">
      <data key="d5">ElasticSearch Amazon EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">ElasticSearch Knowledge Base running on EC2 storing job description content.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Bedrock Claude 2 (Right)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Bedrock Claude 2 used to generate streaming natural language responses from top search results.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Document store holding job data collected every 6 hours from RSS feeds, APIs, and partner sites.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Bedrock Titan (Bottom)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Bedrock Titan model used to vectorize job content offline for indexing.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User submits natural language job query.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Application passes prompt to Claude 2 for prompt injection check, sanitization, and geolocation extraction.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Application passes enriched query to Titan for vector embedding.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Claude 2 returns enriched prompt with coordinates to .Net application.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Vectorized prompt queries MS SQL for user search/chat history.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Enriched query and search history pass to ElasticSearch knowledge base.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Top 6 matching job descriptions and chat history pass to Bedrock Claude 2.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Claude 2 streams generated AI response back to the User.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Job feeds stored in S3 pass every 6 hours to Bedrock Titan.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Vectorized content base is stored into ElasticSearch knowledge base.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Healthy Careers GenAI Job Search Engine Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=7KqYdneuJjo</data>
    <data key="d2">Architecture for Healthy Careers AI-enabled healthcare job search platform powered by AWS Bedrock, ECS, SQL, and ElasticSearch.</data>
    <data key="d3">GenAI, Healthcare, Search Engine</data>
    <data key="d4">True</data>
  </graph>
</graphml>
