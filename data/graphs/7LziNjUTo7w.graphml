  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Instructor</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Triggers CloudFormation templates to set up virtual training environments.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Provisions RDS, FSx, and uses a Custom Resource to trigger Lambda.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Custom resource handler executing within the 15-minute execution limit.</data>
    </node>
    <node id="3">
      <data key="d5">Systems Manager</data>
      <data key="d6">SystemsManager</data>
      <data key="d7">Runs commands remotely on the EC2 license server instance.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 License Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts application license server and configures AppStream image builder.</data>
    </node>
    <node id="5">
      <data key="d5">AppStream</data>
      <data key="d6">AppStream</data>
      <data key="d7">Delivers Kingdom petrotechnical desktop application via web browser.</data>
    </node>
    <node id="6">
      <data key="d5">AppStream Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Students accessing training sessions via a streaming URL.</data>
    </node>
    <node id="7">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">File system for Kingdom project storage mounted during AppStream sessions.</data>
    </node>
    <node id="8">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">SQL Express database engine for Kingdom project data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Instructor deploys CloudFormation template.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation provisions RDS database instance.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation provisions FSx file system.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation custom resource triggers Lambda function.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda invokes Systems Manager to execute remote script.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Systems Manager runs configuration command on EC2 instance.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 modifies AppStream image builder session script.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 sends completion signal back to CloudFormation wait condition.</data>
      <data key="d10">7</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">AppStream session mounts FSx storage for project files.</data>
      <data key="d10">1</data>
