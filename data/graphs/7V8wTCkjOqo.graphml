<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SERVICE TEAMS</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">NAB service teams executing build pipelines in non-production environments.</data>
    </node>
    <node id="1">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs Kong API gateway on Amazon ECS to expose endpoints for build events and promotion API calls.</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA x25</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes logic for capturing pipeline events, running compliance assessments, and invoking promotion flows.</data>
    </node>
    <node id="3">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores build event evidence and telemetry key-value pairs from pipeline builds.</data>
    </node>
    <node id="4">
      <data key="d5">RDS POSTGRESQL</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores relational compliance standards, control definitions, and team metadata.</data>
    </node>
    <node id="5">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes promotion notifications across accounts to trigger automated artifact copying and deployment into PROD.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Service teams send build events and API calls from non-prod pipelines to Kong API gateway on ECS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="1">
      <data key="d8">1</data>
      <data key="d9">Service team sends promotion request API call.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kong routes requests to AWS Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="1">
      <data key="d8">1</data>
      <data key="d9">Kong routes promotion API call to Lambda compliance assessment engine.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda stores build evidence and pipeline event data in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="1">
      <data key="d8">1</data>
      <data key="d9">Lambda reads build evidence for the workload from DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda compares build evidence against compliance rules and standards stored in RDS PostgreSQL.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Upon passing compliance assessment, Lambda publishes promotion event to SNS to trigger cross-account artifact copy to PROD.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">NAB Automated Compliance and Deployment Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=7V8wTCkjOqo</data>
    <data key="d2">Transcribed architecture of NAB's automated compliance validation and promotion platform using ECS (Kong), Lambda, DynamoDB, RDS PostgreSQL, and SNS.</data>
    <data key="d3">DevOps</data>
    <data key="d4">True</data>
  </graph>
