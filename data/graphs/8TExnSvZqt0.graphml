<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Used for container orchestration and running application stack services per client environment.</data>
    </node>
    <node id="1">
      <data key="d5">AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">CIS-hardened Amazon Machine Images built for automated environment deployments.</data>
    </node>
    <node id="2">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Provides end-to-end data encryption in transit and at rest.</data>
    </node>
    <node id="3">
      <data key="d5">SECURITY HUB</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Central security management service for monitoring compliance and security posture.</data>
    </node>
    <node id="4">
      <data key="d5">GUARDDUTY</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Intelligent threat detection service for continuous monitoring.</data>
    </node>
    <node id="5">
      <data key="d5">CONFIG</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">Tracks resource configurations and automates security response to incidents.</data>
    </node>
    <node id="6">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors performance and triggers automated security incident responses.</data>
    </node>
    <node id="7">
      <data key="d5">CLOUD TRAIL</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Audits user activity and API calls across environments.</data>
    </node>
    <node id="8">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Handles transactional OLTP database workloads within the application stack.</data>
    </node>
    <node id="9">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Handles OLAP analytical data processing for regulatory reporting using RA3 nodes.</data>
    </node>
    <node id="10">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Encrypted object storage used for warm/historical data and logs.</data>
    </node>
    <edge source="1" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Automated deployment of CIS-hardened AMI images into the client application stack.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch exports monitoring and audit log data to S3 for long-term retention.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Application stack interacts with security suite services including KMS for encryption.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">RedShift uses Spectrum to query warm historical data directly in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Axiom SL ControllerView Cloud Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=8TExnSvZqt0</data>
    <data key="d2">Axiom SL deploys automated single-tenant isolated application stacks per client environment using AMI and ECS for deployment, RDS for OLTP, RedShift for OLAP, Redshift Spectrum to query warm historical data in S3, and AWS native security/monitoring tools.</data>
    <data key="d3">Financial Services, Data Analytics &amp; Security</data>
    <data key="d4">True</data>
  </graph>
