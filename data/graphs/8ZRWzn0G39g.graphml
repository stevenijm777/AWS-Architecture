<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Enterprise Users</data>
      <data key="d6">UserCompanyWebsite</data>
      <data key="d7">Enterprise users requiring strict compliance and dedicated data isolation.</data>
    </node>
    <node id="1">
      <data key="d5">Standard Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Standard multi-tenant users accessing the shared application resources.</data>
    </node>
    <node id="2">
      <data key="d5">Customer KMS Key</data>
      <data key="d6">KMS</data>
      <data key="d7">AWS KMS CMK provisioned in the customer AWS account and shared via key policy.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Shared entry point for both standard and enterprise users.</data>
    </node>
    <node id="4">
      <data key="d5">Business Logic</data>
      <data key="d6">ECS</data>
      <data key="d7">Shared business logic compute layer combining EC2, ECS, and EKS.</data>
    </node>
    <node id="5">
      <data key="d5">Dedicated Aurora DB</data>
      <data key="d6">Aurora</data>
      <data key="d7">Dedicated Aurora database instance for enterprise user data encrypted using Customer KMS key.</data>
    </node>
    <node id="6">
      <data key="d5">Shared Aurora DB</data>
      <data key="d6">Aurora</data>
      <data key="d7">Shared multi-tenant Aurora database instance encrypted with Replicon platform KMS key.</data>
    </node>
    <node id="7">
      <data key="d5">Replicon Platform KMS Key</data>
      <data key="d6">KMS</data>
      <data key="d7">AWS KMS key owned by Replicon providing encryption at rest for the shared Aurora database.</data>
    </node>
    <node id="8">
      <data key="d5">I3 Fargate Service</data>
      <data key="d6">Fargate</data>
      <data key="d7">Inter-Infrastructure Intelligence (I3) API service on AWS Fargate that determines data routing for tenants.</data>
    </node>
    <node id="9">
      <data key="d5">I3 DynamoDB Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB database storing tenant lookup metadata for the I3 routing service.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Enterprise users send requests through the shared API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Standard users send requests through API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer KMS Key encrypts the Dedicated Aurora DB at rest.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway forwards requests to Business Logic compute.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="1">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes enterprise requests to Business Logic compute.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Business Logic queries I3 Fargate service to look up tenant data routing location.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="1">
      <data key="d8">1</data>
      <data key="d9">Business Logic queries I3 service to check destination database for enterprise customer.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Business Logic writes/reads multi-tenant data to Shared Aurora DB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Business Logic routes isolated enterprise data to Dedicated Aurora DB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Replicon Platform KMS key encrypts Shared Aurora DB at rest.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">I3 Fargate service reads tenant lookup data from DynamoDB store.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="1">
      <data key="d8">1</data>
      <data key="d9">I3 Fargate service retrieves dedicated enterprise metadata from DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Replicon Multi-Tenant and Dedicated Architecture with Customer-Managed Keys</data>
    <data key="d1">https://www.youtube.com/watch?v=8ZRWzn0G39g</data>
    <data key="d2">Replicon provides time tracking and project management solutions on AWS. Standard users are onboarded into a shared multi-tenant system backed by a Shared Aurora database encrypted with Replicon's platform KMS key. Enterprise customers requiring strict compliance bring their own AWS KMS CMK key from their AWS account via key policies to encrypt dedicated Aurora databases. Routing between standard and dedicated environments is controlled dynamically by an Inter-Infrastructure Intelligence (I3) microservice running on Fargate backed by DynamoDB.</data>
    <data key="d3">Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
