<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CLIENT 1</data>
      <data key="d6">S3</data>
      <data key="d7">Client data bucket generating S3 access logs.</data>
    </node>
    <node id="1">
      <data key="d5">CLIENT 2</data>
      <data key="d6">S3</data>
      <data key="d7">Client data bucket generating S3 access logs.</data>
    </node>
    <node id="2">
      <data key="d5">CLIENT N</data>
      <data key="d6">S3</data>
      <data key="d7">Client data bucket generating S3 access logs.</data>
    </node>
    <node id="3">
      <data key="d5">S3 ACCESS LOGS</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized bucket receiving 18-20 million S3 access log records monthly.</data>
    </node>
    <node id="4">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Parses log entries, uses GeoIP DB to extract country and numeric country ID, adds custom field CLIENT_NAME.</data>
    </node>
    <node id="5">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Stores log records and runs built-in Anomaly Detector configured per client name and country ID.</data>
    </node>
    <node id="6">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends email notifications to the service team upon detecting access anomalies.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Access logs delivered from CLIENT 1 to central S3 ACCESS LOGS bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Access logs delivered from CLIENT 2 to central S3 ACCESS LOGS bucket.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Access logs delivered from CLIENT N to central S3 ACCESS LOGS bucket.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Log file creation in S3 ACCESS LOGS triggers Lambda execution.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda inserts enriched log records with custom fields into Elasticsearch.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Elasticsearch anomaly detector triggers alert notifications via SNS upon suspicious activity.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Mobilewala Log Anomaly Detection Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=8s0wGRkiDrw</data>
    <data key="d2">Real-time S3 access log anomaly detection system processing 18-20 million log records per month using Lambda, Elasticsearch Anomaly Detector, and SNS.</data>
    <data key="d3">Security, Analytics, Serverless</data>
    <data key="d4">True</data>
