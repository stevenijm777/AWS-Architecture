<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">HEALTHCARE (Source)</data>
      <data key="d6">UserConsumerHospital</data>
      <data key="d7">Source healthcare facility originating HL7/TCP data.</data>
    </node>
    <node id="1">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Network Load Balancer handling Layer 4 TCP traffic.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 (HAProxy)</data>
      <data key="d6">EC2</data>
      <data key="d7">HAProxy ingress controller running in EKS cluster for IP whitelisting and routing.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 (m6g)</data>
      <data key="d6">EC2</data>
      <data key="d7">Arm-based Graviton m6g EC2 worker node hosting tenant-isolated pods in dedicated namespaces.</data>
    </node>
    <node id="4">
      <data key="d5">EBS (gp3)</data>
      <data key="d6">EBS</data>
      <data key="d7">Encrypted GP3 EBS volume attached to tenant container for persistent data isolation.</data>
    </node>
    <node id="5">
      <data key="d5">HEALTHCARE (Destination)</data>
      <data key="d6">UserConsumerHospital</data>
      <data key="d7">Destination healthcare provider receiving transformed data.</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS orchestrating multi-tenant containerized workloads.</data>
    </node>
    <node id="7">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Elastic Container Registry holding integration engine container images pushed by CI/CD.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Healthcare source sends Layer 4 TCP data traffic to NLB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB forwards TCP traffic to HAProxy ingress controller.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">HAProxy routes data securely to tenant container running on Graviton m6g EC2 worker node.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Tenant container stores and processes data using encrypted GP3 EBS volume.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformed healthcare data is delivered to destination healthcare facility.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Containerized integration solutions are deployed from ECR to EKS worker nodes.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Lineate Envoy Healthcare Data Integration Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=9-6hQdFeolc</data>
    <data key="d2">Lineate Envoy uses EKS, Graviton m6g EC2 instances, and GP3 EBS volumes to achieve multi-tenant isolation, compliance, and cost savings for healthcare data processing.</data>
    <data key="d3">Healthcare, Containers, Compute, Networking</data>
    <data key="d4">True</data>
  </graph>
