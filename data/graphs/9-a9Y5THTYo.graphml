<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal user requesting AWS account access through self-developed web portal.</data>
    </node>
    <node id="1">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives account configuration request payload from web portal.</data>
    </node>
    <node id="2">
      <data key="d5">STEP FUNCTIONS (AVM)</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Account Vending Machine orchestrator managing overall provisioning steps.</data>
    </node>
    <node id="3">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores target account configuration state, VPC CIDR ranges, and account IDs to guarantee idempotency.</data>
    </node>
    <node id="4">
      <data key="d5">CONTROL TOWER</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Provisions foundational AWS account structure via custom Service Catalog wrapper.</data>
    </node>
    <node id="5">
      <data key="d5">STEP FUNCTIONS (BLUE PRINT)</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates deployment of standardized blueprints (IAM, Security, Networking).</data>
    </node>
    <node id="6">
      <data key="d5">E-MAIL</data>
      <data key="d6">SES</data>
      <data key="d7">Sends email notification containing login details and owner responsibilities.</data>
    </node>
    <node id="7">
      <data key="d5">AWS ACCOUNT</data>
      <data key="d6">Organizations</data>
      <data key="d7">Target customer AWS account provisioned and configured according to corporate standards.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User submits account configuration request to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers AVM Step Functions execution.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">AVM Step Functions writes desired state and account metadata to DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">AVM Step Functions requests base account creation via Control Tower.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">AVM Step Functions invokes Blueprint Step Functions once account creation starts.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Blueprint Step Functions rolls out IAM, Security, and Networking configurations into the target AWS Account.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Blueprint Step Functions triggers email notification upon completion.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">SES delivers notification email with account access details to the User.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Vitesco Technologies Automated AWS Account Vending Machine</data>
    <data key="d1">https://www.youtube.com/watch?v=9-a9Y5THTYo</data>
    <data key="d2">Over 850 accounts created. Blueprint changes deploy into customer accounts in less than 3 hours via CodePipeline, rolled out by environment stages (dev, QA, prod).</data>
    <data key="d3">Automated Landing Zone, Account Vending Machine, Multi-Account Governance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
