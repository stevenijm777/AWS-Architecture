<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">K8S CA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Kubernetes Cluster Autoscaler monitoring pending pods and manipulating desired capacity on underlying ASGs.</data>
    </node>
    <node id="1">
      <data key="d5">ASG 1</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling Group spanning multiple Availability Zones for a specific Spot instance pool.</data>
    </node>
    <node id="2">
      <data key="d5">ASG 2</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Additional Auto Scaling Group spanning multiple Availability Zones providing instance type diversification.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Kubernetes Cluster Autoscaler adjusts desired capacity on ASG 1.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kubernetes Cluster Autoscaler adjusts desired capacity on ASG 2.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Skyscanner Kubernetes Cluster Autoscaling on 100% Spot Instances</data>
    <data key="d1">https://www.youtube.com/watch?v=99nNHsbwBpg</data>
    <data key="d2">Skyscanner operates Kubernetes clusters fully on Spot instances using multiple Auto Scaling Groups to diversify across instance types (C3, C4, C5, M4, R3) and AZs. The Kubernetes Cluster Autoscaler dynamically updates ASG desired counts to scale capacity.</data>
    <data key="d3">Compute, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
