  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">GIVING</data>
      <data key="d6">EC2</data>
      <data key="d7">Legacy .NET monolith running on Windows.</data>
    </node>
    <node id="1">
      <data key="d5">SQL SERVER</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Relational database supporting the Giving monolith.</data>
    </node>
    <node id="2">
      <data key="d5">APPS</data>
      <data key="d6">EC2</data>
      <data key="d7">Node.js application platform for client apps.</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Identity microservices running .NET Core on Alpine Linux containers exposing a GraphQL API.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database used as an event store for user sign-in and profile events.</data>
    </node>
    <node id="5">
      <data key="d5">KINESIS</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Data stream for distributing user events to downstream services and back to the monolith.</data>
    </node>
    <node id="6">
      <data key="d5">X-RAY</data>
      <data key="d6">XRay</data>
      <data key="d7">Provides distributed tracing across microservices requests.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Giving monolith interacts with SQL Server database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Giving monolith calls GraphQL API on ECS for user identity requests.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Apps platform calls GraphQL API on ECS for user identity requests.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS identity microservice stores event records in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS identity microservice publishes event payloads into Kinesis data stream.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS identity microservice sends tracing data to AWS X-Ray.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis streams events back to the Giving monolith for state synchronization.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Pushpay Monolith Decomposition with Amazon ECS and DynamoDB</data>
    <data key="d1">https://www.youtube.com/watch?v=9Cg81Xgg7LQ</data>
    <data key="d2">Architecture illustrating Pushpay strangling its .NET monolith into containerized identity microservices using ECS, DynamoDB event sourcing, Kinesis event streaming, and X-Ray tracing.</data>
    <data key="d3">Migration, Microservices, Event-Driven Architecture</data>
    <data key="d4">True</data>
