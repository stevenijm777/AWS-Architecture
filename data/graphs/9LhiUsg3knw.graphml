<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Clients / Users</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile app users providing feedback and consuming synchronized lyrics.</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Legacy platform running in Auto Scaling groups with Docker, handling user feedback.</data>
    </node>
    <node id="2">
      <data key="d5">Couchbase</data>
      <data key="d6">CouchBase</data>
      <data key="d7">NoSQL database storing user-generated data.</data>
    </node>
    <node id="3">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational database storing editorial data.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Central database storing editorial tasks assigned to users.</data>
    </node>
    <node id="5">
      <data key="d5">AppSync</data>
      <data key="d6">AppSync</data>
      <data key="d7">GraphQL service distributing tasks and enabling real-time client sync.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda (Left)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Function performing data/task updates into DynamoDB.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Right)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Orchestrates complex operations like concurrent DynamoDB writes and publishing.</data>
    </node>
    <node id="8">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Analytics platform calculating content rankings by country and language.</data>
    </node>
    <node id="9">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs batch jobs reading streaming service charts to prioritize internal tasks.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile users submit feedback on lyrics and sync quality to EC2.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 reads/writes user-generated data to Couchbase.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 reads/writes editorial data to Aurora.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 generates user tasks and writes them into DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">AppSync distributes tasks to users and provides real-time client synchronization.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">AppSync directly interacts with DynamoDB using VTL templates for standard task queries.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">AppSync triggers Lambda for complex operations like task submission and publishing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">5</data>
      <data key="d9">Lambda updates task status and data directly in DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda writes task completion results and updates into DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">4</data>
      <data key="d9">Redshift analytics platform feeds content ranking scores into DynamoDB task list.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Fargate batch jobs compute chart relevance and update task rankings in DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">MusiXmatch Serverless and Batch Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=9LhiUsg3knw</data>
    <data key="d2">MusiXmatch architecture processing user feedback, lyrics synchronization, task distribution via AppSync, and task ranking via Fargate batch jobs and Redshift analytics.</data>
    <data key="d3">Serverless, Mobile, Data Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
