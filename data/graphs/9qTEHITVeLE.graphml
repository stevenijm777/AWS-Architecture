      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka sends real-time events back to external data sources.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka streams ingested data into S3 Data Lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR reads raw data from S3 Data Lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Data Lake publishes structured datasets into RDS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR delivers processed data back to business applications.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR writes processed dataset results back to S3 Data Lake.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">EMR loads aggregated analytical datasets into Vertica.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Data from multiple operational databases streams into Kafka.</data>
      <data key="d10">0</data>
