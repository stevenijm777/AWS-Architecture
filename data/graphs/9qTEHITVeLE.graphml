  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS MetaManager</data>
      <data key="d6">EKS</data>
      <data key="d7">Microservices architecture running MetaManager to abstract operational complexity and govern data.</data>
    </node>
    <node id="1">
      <data key="d5">ElasticSearch / Neo4j</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">MetaStore combining document and graph databases to store schema, table, and API metadata.</data>
    </node>
    <node id="2">
      <data key="d5">Kafka</data>
      <data key="d6">MSK</data>
      <data key="d7">Enterprise streaming platform managing 600 topics, 250 GB throughput, and 7 days retention.</data>
    </node>
    <node id="3">
      <data key="d5">S3 DataLake</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized S3 data lake storing approximately 60 TB of enterprise data.</data>
    </node>
    <node id="4">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Big data processing framework managing ETL and batch analytics into and out of the data lake.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database used for publishing analytics payloads and OLTP access.</data>
    </node>
    <node id="6">
      <data key="d5">Vertica</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Analytical column-store database target for high-performance querying.</data>
    </node>
    <node id="7">
      <data key="d5">Multiple Data Sources</data>
      <data key="d6">RDS</data>
      <data key="d7">Heterogeneous operational databases across 14 countries and multiple business units.</data>
    </node>
    <node id="8">
      <data key="d5">Applications</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External systems and APIs producing and consuming operational events.</data>
    </node>
    <node id="9">
      <data key="d5">DA/DS</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Data Analysts and Data Scientists consuming analytics outputs for ML models and dashboards.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">MetaManager stores discovered metadata in ElasticSearch/Neo4j MetaStore.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
