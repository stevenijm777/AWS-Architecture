  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Collectors (Spot.io)</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs data collection services gathering 2 billion data points daily across regions and availability zones.</data>
    </node>
    <node id="1">
      <data key="d5">Aurora Database</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores infrastructure and spot capacity pool metrics.</data>
    </node>
    <node id="2">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Predicts spot instance interruptions 1 hour in advance with 85% accuracy.</data>
    </node>
    <node id="3">
      <data key="d5">EKS (Spot.io SaaS)</data>
      <data key="d6">EKS</data>
      <data key="d7">Manages Spot.io's internal containerized SaaS workload and cross-account management engine.</data>
    </node>
    <node id="4">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Deploys IAM policies and roles with external IDs in the customer account.</data>
    </node>
    <node id="5">
      <data key="d5">Cross-Account IAM Role</data>
      <data key="d6">IAM</data>
      <data key="d7">Secures access for Spot.io to describe and manage customer resources.</data>
    </node>
    <node id="6">
      <data key="d5">EKS (Client)</data>
      <data key="d6">EKS</data>
      <data key="d7">Client Kubernetes cluster hosting application workloads.</data>
    </node>
    <node id="7">
      <data key="d5">Spot Instance(s)</data>
      <data key="d6">EC2</data>
      <data key="d7">Client worker nodes automatically managed and proactively replaced upon predicted interruption.</data>
    </node>
    <edge source="0" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Spot.io data collectors leverage cross-account IAM role to describe client EC2, ASG, and container workloads.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Stores 2 billion daily data points into Aurora.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Feeds real-time monitoring metrics into SageMaker ML models for interruption prediction.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Spot.io engine communicates across accounts to trigger proactive instance replacement.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Deploys and configures infrastructure resources in the client account.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Provides access permissions to manage client EKS cluster.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Client EKS scales and replaces Spot worker nodes proactively before interruption.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Spot.io Autonomous Spot Instance Management Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=A4Lfk1Zz1dE</data>
    <data key="d2">Shows how Spot.io uses predictive ML models on AWS to automatically manage and proactively swap client Spot instances with zero downtime.</data>
    <data key="d3">Compute, Database, Machine Learning, Containers, Security</data>
    <data key="d4">True</data>
  </graph>
