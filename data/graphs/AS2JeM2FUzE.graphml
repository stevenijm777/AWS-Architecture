<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DATA SOURCES</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External crawled data sources, premium connectors, and custom carrier data feeds.</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer fanning out incoming data source payloads to Kubernetes microservices.</data>
    </node>
    <node id="2">
      <data key="d5">CONSUMERS</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Underwriters, agents, and policy clients accessing microservices via Kong API Gateway.</data>
    </node>
    <node id="3">
      <data key="d5">K8S</data>
      <data key="d6">EC2</data>
      <data key="d7">Kubernetes cluster on EC2 hosting ~200 microservices including Keycloak, Jupyter Notebooks, and Kong API Gateway.</data>
    </node>
    <node id="4">
      <data key="d5">MQ</data>
      <data key="d6">AmazonMQ</data>
      <data key="d7">Amazon MQ used to loosely couple microservices and handle pipeline latency during message spikes (1-2M messages).</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS Postgres database backing Kong API gateway and Keycloak authentication microservice.</data>
    </node>
    <node id="6">
      <data key="d5">REDIS</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">ElastiCache Redis used for session management and caching across microservices.</data>
    </node>
    <node id="7">
      <data key="d5">VPC PEERING</data>
      <data key="d6">VPCPeering</data>
      <data key="d7">VPC Peering connection enabling secure private routing from AWS VPC to MongoDB Atlas without public internet exposure.</data>
    </node>
    <node id="8">
      <data key="d5">MONGODB ATLAS</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Managed MongoDB Atlas document database hosting cleansed and aggregated fabric entity data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Data sources send crawled and connector data into ELB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB fans out incoming traffic to Kubernetes microservices cluster.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Consumers access Kubernetes microservices via Kong API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices push raw/unprocessed data into Amazon MQ.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Kubernetes microservices send cleansed data via VPC Peering.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Logical data storage connection from Kubernetes pipeline to MongoDB Atlas.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Kong and Keycloak microservices query and store auth and gateway configuration in Postgres RDS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Microservices perform user session management and cache retrieval using Redis.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ML pipeline microservices consume messages from Amazon MQ for data cleansing and sentiment analysis.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">VPC Peering routes private traffic directly into MongoDB Atlas.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Intellect Design Fabric Data Service Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=AS2JeM2FUzE</data>
    <data key="d2">Intellect Design's Fabric Data Service processes 1-2 million messages across 2,000 data sources. Kubernetes microservices ingest data via ELB, decouple processing with Amazon MQ, manage sessions via Redis, store auth metadata in Postgres RDS, and persist data to MongoDB Atlas via VPC Peering.</data>
    <data key="d3">Data Pipeline, Financial Services, Cloud Infrastructure</data>
    <data key="d4">True</data>
  </graph>
</graphml>
