<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Client's Lambda function being monitored for memory, timeouts, and errors.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis 1</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Receives filtered CloudWatch logs from the customer account.</data>
    </node>
    <node id="2">
      <data key="d5">Transform Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes raw log streams into structured invocation records.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores customer function configurations and tracks partial execution states.</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis 2</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Central stream holding transformed invocation records.</data>
    </node>
    <node id="5">
      <data key="d5">Storage Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Buffers writes to Aurora and manages connection concurrency.</data>
    </node>
    <node id="6">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Serverless Aurora database used for fast, single-item request ID queries.</data>
    </node>
    <node id="7">
      <data key="d5">Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Batches records and converts JSON to Parquet format.</data>
    </node>
    <node id="8">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Provides table schema for Firehose data conversion.</data>
    </node>
    <node id="9">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake storing Parquet invocation records.</data>
    </node>
    <node id="10">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Performs ad-hoc SQL queries on S3 for aggregated operational metrics.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch integration streams logs to Kinesis stream.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers Transform Lambda with log batches.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Queries metadata and updates partial execution tracking.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Writes constructed invocation records into Kinesis 2.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Returns function configuration metadata to Transform Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers Storage Lambda with stream records.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Streams invocation records into Kinesis Data Firehose.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes invocation records to Serverless Aurora.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Delivers formatted Parquet files into the S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Provides schema mapping for JSON to Parquet conversion.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Executes SQL queries against S3 data lake files.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Epsagon Lambda Metrics Monitoring Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=AzM_d7ZvzUE</data>
    <data key="d2">Epsagon architecture for generating metrics and aggregated analytics on customer Lambda executions using CloudWatch logs streaming through Kinesis, Lambda, DynamoDB, Serverless Aurora, Kinesis Firehose, AWS Glue, Amazon S3, and Amazon Athena.</data>
    <data key="d3">Monitoring, Serverless, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
