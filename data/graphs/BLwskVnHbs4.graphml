    <data key="d0">NextGen Healthcare Population Health Infrastructure Deployment Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=BLwskVnHbs4</data>
    <data key="d2">Decoupled CloudFormation deployment pipeline isolating Network, Database, Compute, and Edge tiers to minimize blast radius and deployment latency in a regulated healthcare environment.</data>
    <data key="d3">CI/CD &amp; Infrastructure Provisioning</data>
    <data key="d4">True</data>
  </graph>
