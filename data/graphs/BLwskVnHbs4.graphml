  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CodeCommit</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">Stores application code and CloudFormation templates committed by developers.</data>
    </node>
    <node id="1">
      <data key="d5">CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Automates the CI/CD pipeline triggered by commits to specific branches.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Deploys separate CloudFormation stacks per infrastructure tier to isolate blast radius.</data>
    </node>
    <node id="3">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Enforces governance policies and BAA compliance via specific deployment roles assigned to CloudFormation.</data>
    </node>
    <node id="4">
      <data key="d5">Network (VPC)</data>
      <data key="d6">VPC</data>
      <data key="d7">Provisioned networking tier stack.</data>
    </node>
    <node id="5">
      <data key="d5">Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Provisioned database tier stack.</data>
    </node>
    <node id="6">
      <data key="d5">Compute</data>
      <data key="d6">EC2</data>
      <data key="d7">Provisioned compute tier stack (e.g., Lambda/EC2).</data>
    </node>
    <node id="7">
      <data key="d5">Edge</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Provisioned edge tier stack (e.g., CloudFront distribution).</data>
    </node>
    <node id="8">
      <data key="d5">Config</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">Continuously monitors deployed components for configuration compliance.</data>
    </node>
    <node id="9">
      <data key="d5">GuardDuty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Continuously monitors deployed resources for threat detection and compliance.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Code commit triggers CodePipeline execution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CodePipeline pushes code and templates to CloudFormation.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation creates/updates Network stack.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation creates/updates Database stack.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation creates/updates Compute stack.</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation creates/updates Edge stack.</data>
      <data key="d10">2'''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">IAM role constrains CloudFormation permissions for governance and compliance.</data>
      <data key="d10">1'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Config monitors deployed environment components for compliance.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
