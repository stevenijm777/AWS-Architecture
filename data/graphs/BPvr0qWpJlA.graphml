<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Handles inbound chat and voice channels.</data>
    </node>
    <node id="1">
      <data key="d5">AWS Lambda (IVR)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes IVR logic based on contact flows and caller inputs.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs containerized microservices for external integration.</data>
    </node>
    <node id="3">
      <data key="d5">External CRMs</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party customer relationship management tools like Salesforce or Siebel.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon SES</data>
      <data key="d6">SES</data>
      <data key="d7">Processes inbound customer email communications.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Lambda (Email)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes email event payloads.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores email interaction states and data.</data>
    </node>
    <node id="7">
      <data key="d5">Agent Browser</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Web browser interface used by contact center agents authenticated via 2FA.</data>
    </node>
    <node id="8">
      <data key="d5">ContactSuite Platform</data>
      <data key="d6">EC2</data>
      <data key="d7">Core platform container hosted on ELB, EC2, and ASG including SenseIQ Knowledge Base.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database used for reporting and historical KPI persistence.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Connect invokes Lambda to execute IVR contact flow logic.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda triggers ECS microservices for downstream backend operations.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS microservices connect out to external CRMs like Salesforce or Siebel.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon SES forwards incoming email events to AWS Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda saves processed email information into Amazon DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Agent browser connects into the ContactSuite platform with 2FA.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">ContactSuite persists reporting and operational analytics to Amazon RDS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">ContactSuite Amazon Connect Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=BPvr0qWpJlA</data>
    <data key="d2">ContactSuite provides contact center scaling, integrating voice, chat, and email with Amazon Connect, AWS Lambda, ECS, SES, DynamoDB, and RDS.</data>
    <data key="d3">Contact Center &amp; Customer Service</data>
    <data key="d4">True</data>
  </graph>
</graphml>
