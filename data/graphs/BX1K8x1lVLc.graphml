<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-users accessing the Love Bonito omnichannel e-commerce platform.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">AWS CloudFront CDN delivering web content fast globally and forwarding dynamic requests to Varnish on EC2.</data>
    </node>
    <node id="2">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Amazon EC2 instance running Varnish cache to cache Magento content.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Elastic Kubernetes Service hosting Magento applications split into web, admin, and cron workloads.</data>
    </node>
    <node id="4">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Elastic Container Registry storing application Docker images pulled by EKS.</data>
    </node>
    <node id="5">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Amazon Aurora MySQL database holding business transactional data with multi-AZ replication.</data>
    </node>
    <node id="6">
      <data key="d5">ELASTICACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">ElastiCache Redis storing cached database queries to offload Aurora.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing media and assets, mounted into instances using S3Fuse.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users direct all web traffic to CloudFront CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront routes requests to Varnish running on EC2.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront directly serves static media assets stored in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Varnish forwards cache misses on EC2 to Magento workloads running on EKS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Magento applications on EKS query business data from Aurora MySQL.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS reads and writes database caches to ElastiCache Redis.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS mounts S3 bucket as a file system using S3Fuse to write asset content.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">EKS pulls Docker container images from Elastic Container Registry.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Love Bonito E-commerce Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=BX1K8x1lVLc</data>
    <data key="d2">Love Bonito transits its Magento e-commerce application onto AWS EKS with CloudFront, EC2 Varnish caching, Aurora MySQL, ElastiCache Redis, ECR, and S3Fuse file system integration.</data>
    <data key="d3">E-Commerce, Cloud Infrastructure, Containerization</data>
    <data key="d4">True</data>
  </graph>
</graphml>
