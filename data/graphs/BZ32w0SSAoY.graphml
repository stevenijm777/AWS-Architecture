<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Client browser used by customers to access the PixelStrings interface.</data>
    </node>
    <node id="1">
      <data key="d5">Web Server &amp; Job Manager</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance running the web front-end and orchestrating downstream transcoding/processing tasks.</data>
    </node>
    <node id="2">
      <data key="d5">RDS Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Database storing cached clip metadata and job tracking information.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless function that extracts metadata from clips using MediaInfo.</data>
    </node>
    <node id="4">
      <data key="d5">Customer S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">User-owned S3 bucket containing raw input media and processed outputs.</data>
    </node>
    <node id="5">
      <data key="d5">G3 GPU Instance Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">GPU instances performing video retiming, de-interlacing, and noise removal.</data>
    </node>
    <node id="6">
      <data key="d5">IMF Wrapping Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance wrapping processed media into Interoperable Master Format (IMF) packages.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User logs into PixelStrings platform and provides S3 bucket details.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="1">
      <data key="d8">1</data>
      <data key="d9">User configures processing workflow (e.g., Wormhole, Spacetime, Dark Energy) and submits the job.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="1" id="2">
      <data key="d8">2</data>
      <data key="d9">User submits job requesting an IMF-wrapped output.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Job manager invokes Lambda to analyze video files in the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Job manager saves and caches metadata in the RDS database.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Web server dynamically reads cached metadata from RDS and presents it to the user browser.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Job manager initiates tasks across parallel G3 GPU nodes.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Job manager coordinates IMF wrapping workflow.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda returns extracted metadata to the Job Manager.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda retrieves media metadata from the S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset manager copies the input video clip from S3 to G3 local disk.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">G3 finishes processing and writes output file back to customer's S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">G3 GPU instances send processed video files to the IMF wrapper instead of writing directly to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">IMF wrapping server writes the final packaged IMF format output back to the customer's S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">PixelStrings by Cinnafilm: A Flexible &amp; Scalable Platform for Video Audio Optimization &amp; Conversion</data>
    <data key="d1">https://www.youtube.com/watch?v=BZ32w0SSAoY</data>
    <data key="d2">A highly parallelized media processing architecture leveraging GPU-accelerated EC2 instances (G3), AWS Lambda for serverless metadata extraction, and RDS for metadata caching.</data>
    <data key="d3">Media Processing, GPU Computing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
