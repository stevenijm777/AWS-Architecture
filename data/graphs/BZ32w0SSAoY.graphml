<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Client web browser used to access PixelStrings interface, input S3 credentials, and configure video workflows.</data>
    </node>
    <node id="1">
      <data key="d5">Web Server / Job Manager</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance hosting the Web Server, Job Manager, and Asset Manager components.</data>
    </node>
    <node id="2">
      <data key="d5">Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Database caching clip metadata and job state information.</data>
    </node>
    <node id="3">
      <data key="d5">IMF</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance dedicated to Interoperable Master Format (IMF) wrapping.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">User-managed S3 bucket storing source media clips and processed video outputs.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless AWS Lambda function running mediainfo to extract video clip metadata.</data>
    </node>
    <node id="6">
      <data key="d5">G3</data>
      <data key="d6">EC2</data>
      <data key="d7">GPU-accelerated EC2 instance cluster executing Wormhole, Spacetime, and Dark Energy video processing.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User logs in, enters S3 bucket keys, and configures processing workflows via Web Browser.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Job Manager triggers Lambda function to extract clip metadata.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Job Manager saves metadata into Database.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Job Manager submits processing jobs to G3 GPU instance.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Web server reads metadata from Database to present to the user in Web Browser.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset Manager copies IMF wrapped video output clip back to S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset Manager copies input video clip from S3 to G3 local disk.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda function reads video clip metadata from S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda function returns extracted clip metadata to Job Manager.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Job Manager sends completed GPU output to IMF instance for wrapping if IMF format selected.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset Manager copies processed output clip directly back to S3 bucket for standard non-IMF workflows.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cinefilm PixelStrings Cloud Video Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=BZ32w0SSAoY</data>
    <data key="d2">PixelStrings architecture on AWS providing video retiming, de-interlacing, noise removal, and upscaling using GPU-accelerated EC2 instances.</data>
    <data key="d3">Media &amp; Entertainment, Video Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
