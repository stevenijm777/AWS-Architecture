<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user or developer interacting with cloud applications or public cloud portal.</data>
    </node>
    <node id="1">
      <data key="d5">NAT Gateway (Account A)</data>
      <data key="d6">NAT</data>
      <data key="d7">NAT Gateways in Account A public subnets for outbound internet communication.</data>
    </node>
    <node id="2">
      <data key="d5">EKS Cluster (Account A)</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS worker nodes in Account A private subnets with 24-hour automated node rotations from golden AMI.</data>
    </node>
    <node id="3">
      <data key="d5">AWS WAF (Account B)</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF sitting at Account B boundary inspecting inbound traffic.</data>
    </node>
    <node id="4">
      <data key="d5">ALB (Account B)</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer in Account B public subnet routing incoming requests.</data>
    </node>
    <node id="5">
      <data key="d5">EKS Cluster (Account B)</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS cluster hosting workloads in Account B private subnet.</data>
    </node>
    <node id="6">
      <data key="d5">On-Premises DC</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-Premises Data Center accessed via AWS Direct Connect.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">User traffic arrives at Account B AWS WAF.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Account A EKS pods route outbound internet connections through NAT Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Account A EKS pods communicate directly with on-premises services via Direct Connect.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF forwards validated traffic to Application Load Balancer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes requests to backend EKS cluster in Account B.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">GoDaddy Multi-Account Security Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=BgT_bDAejSQ</data>
    <data key="d2">Architecture illustrating zero-trust account boundaries between Account A and Account B with automated EKS node rotations and direct connect hybrid networking.</data>
    <data key="d3">Security &amp; Compliance, Multi-Account Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
