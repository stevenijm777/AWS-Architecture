<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Pre-provisioned Elastic Load Balancer distributing initial web traffic to the UI server instances.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 (ON DEMAND) - UI</data>
      <data key="d6">EC2</data>
      <data key="d7">Baseline UI web server layer running on On-Demand instances.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 (SPOT) - UI</data>
      <data key="d6">EC2</data>
      <data key="d7">Scalable UI web server layer running on Spot instances (protected via Spot Blocks for 1 hour).</data>
    </node>
    <node id="3">
      <data key="d5">AutoScaling - UI</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling managing UI layer EC2 instances.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Central database pre-provisioned for high read/write capacity during ticket sales events.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 (ON DEMAND) - API</data>
      <data key="d6">EC2</data>
      <data key="d7">Backend API processing tier using On-Demand instances.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 (SPOT) - API</data>
      <data key="d6">EC2</data>
      <data key="d7">Backend API processing tier using Spot instances.</data>
    </node>
    <node id="7">
      <data key="d5">AutoScaling - API</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling managing API layer EC2 instances.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB routes incoming web traffic to UI On-Demand EC2 instances.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB routes incoming web traffic to UI Spot EC2 instances.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">UI On-Demand instances forward user transaction requests to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">UI Spot instances forward user transaction requests to DynamoDB.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API On-Demand instances fetch pending transaction requests from DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API On-Demand instances write processed transaction results back to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Spot instances write processed transaction results back to DynamoDB.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">TXCraft Ticketing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Bi-1xjXvKgs</data>
    <data key="d2">System designed for extreme traffic spikes during online concert ticket sales in Taiwan.</data>
    <data key="d3">E-commerce, Serverless, Compute, High Concurrency</data>
    <data key="d4">True</data>
  </graph>
