<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart TV</data>
      <data key="d6">UserConsumerTV</data>
      <data key="d7">Millions of connected TVs generating logs, performance telemetry, and user usage data.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Streams</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Front door to the cloud running an 8-shard pipeline to handle raw data stream ingestion.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Pipes schema-less raw data streams directly to long-term storage and data warehouse.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Persistent long-term storage keeping all raw telemetry columns forever.</data>
    </node>
    <node id="4">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Columnar data warehouse optimized for aggregating billions of telemetry events.</data>
    </node>
    <node id="5">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualization platform utilizing custom SQL queries and the SPICE in-memory database for snappy reporting.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Smart TVs stream logs, performance, and user data to Kinesis Data Streams.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis streams feed directly into Kinesis Firehose.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Firehose dumps the complete, raw telemetry data into S3.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Firehose ingests structured subsets of data into Redshift.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Custom SQL queries pull aggregated data from Redshift into QuickSight SPICE datasets.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Vizio Telemetry and Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=BlCXEMp_lqY</data>
    <data key="d2">Vizio ingests telemetry from millions of connected smart TVs generating billions of events per month using Kinesis, Firehose, S3, Redshift, and QuickSight.</data>
    <data key="d3">Analytics, Big Data, Telemetry</data>
    <data key="d4">True</data>
  </graph>
</graphml>
