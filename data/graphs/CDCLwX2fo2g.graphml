  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing incoming frontend traffic based on request endpoint.</data>
    </node>
    <node id="1">
      <data key="d5">ECS (User-Item)</data>
      <data key="d6">ECS</data>
      <data key="d7">Containerized microservice on AWS Fargate serving user-based recommendation requests.</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB (User-Item)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Key-value database storing pre-computed recommendation results per user with auto-scaling enabled.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 (User-Item)</data>
      <data key="d6">EC2</data>
      <data key="d7">P2 EC2 instance executing daily batch model retraining and generating batch recommendation outputs.</data>
    </node>
    <node id="4">
      <data key="d5">ECS (Cart-Item)</data>
      <data key="d6">ECS</data>
      <data key="d7">Containerized microservice on Fargate running real-time cart-to-item inference.</data>
    </node>
    <node id="5">
      <data key="d5">S3 (Cart-Item)</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage storing trained ML model artifacts for cart-item recommendations.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 (Cart-Item)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 compute instance performing cart-item model retraining.</data>
    </node>
    <node id="7">
      <data key="d5">CloudWatch Schedule</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Scheduled rule triggering daily model retraining jobs.</data>
