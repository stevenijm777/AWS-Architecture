<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SENSORS</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Over 100k water meter IoT sensors in the field transmitting ~27 million events per day.</data>
    </node>
    <node id="1">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">AWS API Gateway acting as the public-facing ingestion endpoint for sensor telemetry.</data>
    </node>
    <node id="2">
      <data key="d5">TRANSFORMER</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda functions normalizing different protocol versions across 3 sensor generations and splitting telemetry into flow and alarm components.</data>
    </node>
    <node id="3">
      <data key="d5">FLOW</data>
      <data key="d6">SQS</data>
      <data key="d7">Amazon SQS FIFO queue holding water flow telemetry messages.</data>
    </node>
    <node id="4">
      <data key="d5">ALARM</data>
      <data key="d6">SQS</data>
      <data key="d7">Amazon SQS queue holding sensor alarm state messages.</data>
    </node>
    <node id="5">
      <data key="d5">PRE PROCESSOR</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda making real-time processing decisions to determine which telemetry data (~40%) requires full downstream processing.</data>
    </node>
    <node id="6">
      <data key="d5">ELASTIC CACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Amazon ElastiCache Redis in-memory database used by Pre Processor for real-time deduplication and state checks.</data>
    </node>
    <node id="7">
      <data key="d5">POST PROCESSOR</data>
      <data key="d6">EC2</data>
      <data key="d7">AWS EC2 instances running background compute jobs to aggregate and store the filtered telemetry.</data>
    </node>
    <node id="8">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Amazon DynamoDB storing event-level water utility data (e.g. tanker lorry dumps, borewell starts).</data>
    </node>
    <node id="9">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Amazon Aurora Serverless MySQL storing aggregated daily usage statistics.</data>
    </node>
    <node id="10">
      <data key="d5">Client App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Web portals and mobile application clients consuming utility reports and visualizations.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Sensors transmit 27M daily telemetry payloads to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Transformer Lambda functions.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformer Lambda routes flow rate data into FLOW SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformer Lambda routes alarm messages into ALARM SQS queue.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Pre Processor reads flow telemetry messages from SQS queue.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Pre Processor queries and updates in-memory cache state in ElastiCache.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Pre Processor passes the filtered 40% of actionable telemetry to Post Processor jobs.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Post Processor saves individual event records in DynamoDB.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Post Processor writes aggregated daily consumption statistics into Aurora Serverless.</data>
      <data key="d10">6'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Client Web and Mobile applications retrieve event data and daily usage reports.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Vigod Aqua IoT Water Management Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=CE03UMddoYU</data>
    <data key="d2">Vigod Aqua manages ~100,000 IoT water meter sensors in the field ingesting ~27 million data points daily. Architecture is broken into ingestion (API Gateway + Lambda Transformers), pre-processing (SQS + Lambda + ElastiCache Redis filtering down to ~40%), post-processing (EC2), and dual storage (DynamoDB for events, Aurora Serverless for daily aggregates).</data>
    <data key="d3">IoT, Serverless Data Pipeline, Real-Time Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
