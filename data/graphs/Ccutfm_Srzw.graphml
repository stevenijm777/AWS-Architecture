<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Device</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile app used by customers to navigate and search.</data>
    </node>
    <node id="1">
      <data key="d5">Clickstream Kinesis Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Ingests real-time clickstream events from mobile app users.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Data Analytics</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Executes real-time SQL queries to filter search keywords out of the main clickstream.</data>
    </node>
    <node id="3">
      <data key="d5">Filtered Kinesis Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Holds filtered search keyword events.</data>
    </node>
    <node id="4">
      <data key="d5">Transformer Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Enriches search keywords by querying Search API and stores records in DocumentDB.</data>
    </node>
    <node id="5">
      <data key="d5">Search API (Lookup)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External Search API used by Transformer Lambda to fetch related brands and product categories.</data>
    </node>
    <node id="6">
      <data key="d5">DocumentDB</data>
      <data key="d6">DocumentDB</data>
      <data key="d7">Stores ~650 million search keyword documents across 3 AZs with a 7-day TTL at &lt;1000 TPS.</data>
    </node>
    <node id="7">
      <data key="d5">Producer Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Scheduled Lambda that pulls search documents and verifies stock availability.</data>
    </node>
    <node id="8">
      <data key="d5">Inventory API</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External API queried to verify product availability before generating search suggestions.</data>
    </node>
    <node id="9">
      <data key="d5">Redis</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Caches verified search suggestions for low-latency retrieval.</data>
    </node>
    <node id="10">
      <data key="d5">Search API (Response)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Serves final search suggestions from Redis to mobile app clients.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile app streams user interaction events to Clickstream Kinesis Stream.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Clickstream Kinesis Stream feeds events into Kinesis Data Analytics.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Data Analytics outputs SQL-filtered search keywords to second Kinesis Stream.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Filtered Kinesis Stream triggers Transformer Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformer Lambda queries Search API for brand and category lookup.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformer Lambda writes enriched search keyword documents to DocumentDB.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Search API returns brand and product category details to Transformer Lambda.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Scheduled Producer Lambda pulls search keyword documents from DocumentDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Producer Lambda checks product inventory levels via Inventory API.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Producer Lambda writes validated search suggestions into ElastiCache Redis.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Inventory API returns product stock status to Producer Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Search API reads cached search suggestions from Redis.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Search API returns search suggestions to the mobile application.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Zulily Search Suggestion Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Ccutfm_Srzw</data>
    <data key="d2">Architecture for streaming clickstream data, filtering search terms, enriching via external APIs, storing in DocumentDB, and caching stock-validated suggestions in ElastiCache for Redis.</data>
    <data key="d3">Analytics &amp; Streaming, Compute &amp; Serverless, Databases</data>
    <data key="d4">True</data>
  </graph>
</graphml>
