  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IOS</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">iOS Snapchat mobile client sending a snap</data>
    </node>
    <node id="1">
      <data key="d5">ANDROID</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Android Snapchat recipient mobile client</data>
    </node>
    <node id="2">
      <data key="d5">GW</data>
      <data key="d6">EKS</data>
      <data key="d7">API Gateway running inside EKS cluster</data>
    </node>
    <node id="3">
      <data key="d5">MEDIA</data>
      <data key="d6">EKS</data>
      <data key="d7">Media delivery microservice in EKS handling media content routing</data>
    </node>
    <node id="4">
      <data key="d5">MCS</data>
      <data key="d6">EKS</data>
      <data key="d7">Messaging microservice handling real-time push routing and connection lookups</data>
    </node>
    <node id="5">
      <data key="d5">FRIEND GRAPH</data>
      <data key="d6">EKS</data>
      <data key="d7">Friend Graph microservice evaluating social graph connections</data>
    </node>
    <node id="6">
      <data key="d5">SNAP DB</data>
      <data key="d6">EKS</data>
      <data key="d7">Snap DB microservice/custom layer managing state sync, transactions, and ephemeral data</data>
    </node>
    <node id="7">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">AWS CloudFront CDN for edge delivery of snap media</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket for persistent media storage</data>
    </node>
    <node id="9">
      <data key="d5">ELASTICACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Amazon ElastiCache for low-latency server/connection ID lookups</data>
    </node>
    <node id="10">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Amazon DynamoDB storing over 400TB of metadata and supporting high-throughput scans</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
