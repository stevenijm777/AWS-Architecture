<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">iOS Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">iOS mobile app client representing the sender.</data>
    </node>
    <node id="1">
      <data key="d5">Android Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Android mobile app client representing the recipient.</data>
    </node>
    <node id="2">
      <data key="d5">Gateway</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS-based API gateway handling incoming requests from clients.</data>
    </node>
    <node id="3">
      <data key="d5">Media Service</data>
      <data key="d6">EKS</data>
      <data key="d7">Microservice managing media upload and delivery logistics.</data>
    </node>
    <node id="4">
      <data key="d5">Messaging Connection Service (MCS)</data>
      <data key="d6">EKS</data>
      <data key="d7">Microservice managing active, persistent connections to clients for messaging.</data>
    </node>
    <node id="5">
      <data key="d5">Friend Graph</data>
      <data key="d6">EKS</data>
      <data key="d7">Microservice resolving user relationships and friend suggestion metadata.</data>
    </node>
    <node id="6">
      <data key="d5">Snap DB Layer</data>
      <data key="d6">EKS</data>
      <data key="d7">Custom high-level middleware database layer running on EKS to manage transactions, TTL, and ephemeral caching.</data>
    </node>
    <node id="7">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Content Delivery Network to cache and deliver media content with ultra-low latency.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Persistent storage bucket holding image and video media content.</data>
    </node>
    <node id="9">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Redis-based in-memory cache used to index connection IDs and mapping to server IDs.</data>
    </node>
    <node id="10">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Primary persistent metadata store containing over 400TB of data with nightly scans processing 2 billion rows per minute.</data>
    </node>
    <edge source="0" target="2">
      <data key="d8">0</data>
      <data key="d9">iOS user uploads a snap; requests go to the API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="7">
      <data key="d8">1</data>
      <data key="d9">Android client fetches actual snap media via CloudFront and S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">Gateway routes the payload to the Media Service.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="4">
      <data key="d8">0</data>
      <data key="d9">Gateway routes message metadata to the Messaging Connection Service (MCS).</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="7">
      <data key="d8">0</data>
      <data key="d9">Media service forwards media payload via CloudFront.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="5">
      <data key="d8">0</data>
      <data key="d9">Media service queries Friend Graph to evaluate valid snap recipients.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="6">
      <data key="d8">0</data>
      <data key="d9">MCS writes persistent metadata through SnapDB.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="9">
      <data key="d8">1</data>
      <data key="d9">MCS queries ElastiCache to find the target client's connection ID and active server ID.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="1">
      <data key="d8">1</data>
      <data key="d9">MCS pushes message metadata over a persistent connection to the Android client.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="10">
      <data key="d8">0</data>
      <data key="d9">SnapDB optimizes, processes TTLs/ephemeral writes, and synchronizes state to DynamoDB.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="8">
      <data key="d8">0</data>
      <data key="d9">CloudFront caches and persists media content directly in S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Snap: Journey of a Snap on Snapchat Using AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=Cgv0kfp_6xQ</data>
    <data key="d2">Architectural overview of Snapchat's messaging backend on AWS, scale-optimized using 900+ EKS clusters (many 1000+ nodes, using Graviton), ElastiCache for connection lookups, and SnapDB as a transaction/TTL middleware layer in front of a 400TB DynamoDB database.</data>
    <data key="d3">Mobile, Messaging, Containers, Databases, Caching, Storage, CDN</data>
    <data key="d4">True</data>
  </graph>
</graphml>
