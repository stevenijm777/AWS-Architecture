<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">iOS App Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">iOS mobile client initiating snap uploads and requests.</data>
    </node>
    <node id="1">
      <data key="d5">Android App Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Android mobile client receiving real-time snap deliveries and pulling media content.</data>
    </node>
    <node id="2">
      <data key="d5">EKS Gateway</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">EKS-based API gateway acting as the entry point for incoming client requests.</data>
    </node>
    <node id="3">
      <data key="d5">Media Delivery Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Microservice running on EKS responsible for media uploads and validation.</data>
    </node>
    <node id="4">
      <data key="d5">Messaging Connection Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Microservice running on EKS that manages active, persistent websocket connections to global clients.</data>
    </node>
    <node id="5">
      <data key="d5">Friend Graph Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Microservice running on EKS managing user social graphs and relations.</data>
    </node>
    <node id="6">
      <data key="d5">SnapDB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">A custom database abstraction and caching layer built to handle transactions, TTLs, and ephemeral data.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN used for low-latency media delivery and uploads near the recipients.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon S3</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Object storage bucket for persistent snap media files.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Stores active connection mappings, server IDs, and metadata for rapid connection routing.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Persistent NoSQL store holding 400TB+ of snap metadata, supporting massive nightly parallel scans.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">iOS client initiates snap sending via the EKS Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Android client retrieves the corresponding snap media from CloudFront using the media ID.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Gateway routes the media request to the Media Delivery Service.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Media service uploads the content to CloudFront to locate it closer to recipients.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Media service verifies recipient associations and social graphs.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Messaging Connection Service looks up active server IDs and connections from ElastiCache.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">MCS synchronizes metadata states with SnapDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">MCS pushes instant messaging events to the Android recipient over a persistent connection.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">SnapDB reads and flushes persistent metadata transactions back to Amazon DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront persists and backs up the media files to Amazon S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Snapchat High-Scale Messaging Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Cgv0kfp_6xQ</data>
    <data key="d2">Handles over 300M+ daily active users and billions of snaps. Utilizes 900+ EKS clusters, many with over 1000+ instances running Graviton to reduce cost and latency. DynamoDB stores 400TB of metadata and runs nightly scans at 2 billion rows per minute.</data>
    <data key="d3">Media &amp; Entertainment, Mobile Application</data>
    <data key="d4">True</data>
  </graph>
</graphml>
