  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2 App</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance hosting the SAP application components.</data>
    </node>
    <node id="1">
      <data key="d5">SAP DB</data>
      <data key="d6">SAP</data>
      <data key="d7">SAP Database instance running inside the environment.</data>
    </node>
    <node id="2">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">CloudWatch monitoring service for infrastructure metrics.</data>
    </node>
    <node id="3">
      <data key="d5">CW Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">CloudWatch Events capturing infrastructure failure events.</data>
    </node>
    <node id="4">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">SNS topic for routing alert notifications and triggering automated actions.</data>
    </node>
    <node id="5">
      <data key="d5">Email / ITSM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External destination for email notifications or ITSM ticketing integration.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function executing application checks and orchestrating healing procedures.</data>
    </node>
    <node id="7">
      <data key="d5">SSM</data>
      <data key="d6">SystemsManager</data>
      <data key="d7">Systems Manager Run Command executing OS and SAP specific remediation commands.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 application sends infrastructure metrics to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Infrastructure failure events trigger CloudWatch Events.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch triggers Lambda for application health checks.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch Events forwards events to SNS topic.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS topic notifies team via Email or ITSM integration.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS topic invokes the healing Lambda function.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Healing Lambda executes commands using SSM Run Command.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">SSM executes OS/SAP remediation commands to restore the SAP database and system.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Linke SAP Automated Healing Framework on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=CsD5bmM6mpY</data>
    <data key="d2">Architecture for automated monitoring and healing of SAP workloads on AWS using serverless services.</data>
    <data key="d3">Automated Healing, Operations, SAP on AWS</data>
    <data key="d4">True</data>
