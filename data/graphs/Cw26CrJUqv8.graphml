<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SFDC</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Salesforce Cloud / Data Center entry point</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives connection setup/teardown requests from SFDC UI in Control Plane VPC</data>
    </node>
    <node id="2">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles automation for setting up PrivateLink and updating DynamoDB metadata</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores customer connection metadata</data>
    </node>
    <node id="4">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives notifications for PrivateLink state changes</data>
    </node>
    <node id="5">
      <data key="d5">Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Terminates encrypted VPN tunnel from Salesforce DC and routes traffic</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts multi-tenant connection forwarders running in containers to route traffic based on customer metadata</data>
    </node>
    <node id="7">
      <data key="d5">PrivateLink (Transit VPC)</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">PrivateLink endpoint inside Salesforce Transit VPC</data>
    </node>
    <node id="8">
      <data key="d5">PrivateLink (Customer VPC)</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">PrivateLink service endpoint in Customer AWS VPC</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Salesforce UI sends connection setup request to API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer data is sent over encrypted VPN tunnel to Transit Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Lambda function</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda stores customer connection metadata in DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda provisions PrivateLink connection in Transit VPC</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Transit Gateway forwards data to EKS connection forwarders</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS routes traffic to appropriate PrivateLink endpoint based on metadata</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">PrivateLink state changes trigger notifications to SNS</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">PrivateLink securely transfers traffic into Customer VPC</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Salesforce Private Connect Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Cw26CrJUqv8</data>
    <data key="d2">Salesforce Private Connect enables secure, PCI/HIPAA-compliant, private connections between Salesforce DC and customer AWS VPCs using PrivateLink and EKS connection forwarders.</data>
    <data key="d3">SaaS Integration, Serverless Control Plane, Cross-VPC Connectivity</data>
    <data key="d4">True</data>
  </graph>
</graphml>
