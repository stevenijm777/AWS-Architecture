  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Systems Manager</data>
      <data key="d6">SystemsManager</data>
      <data key="d7">Automates on-premises local encoders via SSM agents and Lambda execution scripts.</data>
    </node>
    <node id="1">
      <data key="d5">On-Prem Encoders / Camera</data>
      <data key="d6">UserCompanyElementalLiveDevice</data>
      <data key="d7">On-premises camera equipment and hardware video encoders at local TV stations.</data>
    </node>
    <node id="2">
      <data key="d5">Media Store</data>
      <data key="d6">MediaStore</data>
      <data key="d7">Receives the live contribution stream from on-prem encoders.</data>
    </node>
    <node id="3">
      <data key="d5">Media Live</data>
      <data key="d6">MediaLive</data>
      <data key="d7">Performs real-time broadcast distribution encoding.</data>
    </node>
    <node id="4">
      <data key="d5">Media Package</data>
      <data key="d6">MediaPackage</data>
      <data key="d7">Packages video streams into formats suitable for multiple device types (phones, HDTV, Web).</data>
    </node>
    <node id="5">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN for delivering media packages to end-user devices.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Permanent archive storage for all shot video content.</data>
    </node>
    <node id="7">
      <data key="d5">Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Performs facial recognition and scene tagging on archived video.</data>
    </node>
    <node id="8">
      <data key="d5">Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Generates automated captions directly for the video content.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Systems Manager automates equipment, ad breaks, and camera switching on local encoders.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">On-prem encoders push live contribution video stream to MediaStore.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">MediaStore streams video payload to MediaLive for distribution encoding.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">MediaStore writes video archives directly to S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">MediaLive sends encoded multi-bitrate video streams to MediaPackage.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">MediaPackage delivers formatted video streams to CloudFront CDN for global end-user streaming.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 archive video is read by Rekognition for visual tagging and face search.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 archive audio/video is read by Transcribe for automatic subtitle and caption generation.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Graham Media Group Live Video Processing and Media Archive Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=D6rG9eZ5Qus</data>
    <data key="d2">Architectural transcription for Graham Media Group's cloud video stream processing and AI archive pipeline.</data>
    <data key="d3">Media &amp; Entertainment, Machine Learning, Automation</data>
    <data key="d4">True</data>
