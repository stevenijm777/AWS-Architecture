  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User / Employee</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">GE Avio employees managing quarterly special expense tickets.</data>
    </node>
    <node id="1">
      <data key="d5">OPEN ID</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Corporate OpenID identity provider for employee authentication.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer routing authorization requests.</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs Docker containers for both the Single Page Application (SPA) and API Gateway.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda (Authorization)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function dedicated to user authorization validation against OpenID.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Business Logic)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Approximately 20 Lambda functions implementing core application features (ticket creation, editing, state shifts).</data>
    </node>
    <node id="6">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database used to store ticket metadata.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing financial document attachments, encrypted at rest with KMS.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User authenticates against corporate OpenID provider.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">User downloads Single Page Application (SPA) hosted on Docker in ECS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">OpenID forwards auth requests through ELB.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards request to ECS container.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS invokes Authorization Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">User SPA collaborates directly with API Gateway container running on ECS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway routes requests to business logic Lambdas.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Application uploads financial attachments to S3 (KMS encrypted).</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Authorization Lambda validates identity with OpenID system.</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Business logic Lambdas persist ticket metadata in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">GE Avio Expense Management Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=D77FSUkPJ3o</data>
    <data key="d2">Serverless application for GE Avio managing special expenses for employees, replacing a legacy system to handle quarterly traffic spikes.</data>
    <data key="d3">Web Application, Serverless, Authentication</data>
    <data key="d4">True</data>
  </graph>
