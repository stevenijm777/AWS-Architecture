<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AMPLIFY</data>
      <data key="d6">Amplify</data>
      <data key="d7">Hosts the status page front end exposed to internal stakeholders.</data>
    </node>
    <node id="1">
      <data key="d5">APPSYNC</data>
      <data key="d6">AppSync</data>
      <data key="d7">Provides GraphQL interface connecting status page front end to Lambda.</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Queries CloudWatch via AWS SDK to gather canary run statuses, HAR files, screenshots, and alert details.</data>
    </node>
    <node id="3">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Runs synthetic canaries every 1-5 minutes and manages alerting metrics.</data>
    </node>
    <node id="4">
      <data key="d5">TIME TRIGGER</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Triggers periodic or ad hoc canary runs.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores canary run artifacts including HAR files and screenshots.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Amplify status page sends GraphQL queries to AppSync.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">AppSync invokes Lambda backend function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda fetches canary status, historical run metrics, and alert states from CloudWatch.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch saves canary execution artifacts (HAR files, screenshots) into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Time trigger executes scheduled or ad hoc canary runs in CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">HBO Experience Operations Canary Monitoring and Status Page Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=D9qTotVJYss</data>
    <data key="d2">HBO operational visibility tool using CloudWatch Canaries for outside-in user experience monitoring and an Amplify/AppSync/Lambda status page for internal stakeholders.</data>
    <data key="d3">Frontend Web &amp; Mobile, Management &amp; Governance, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
