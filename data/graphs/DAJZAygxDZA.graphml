  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">MODEL REGISTRY</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker Model Registry in Data Science Account where trained ML models are stored and approved.</data>
    </node>
    <node id="1">
      <data key="d5">ENDPOINT (QA)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker Endpoint in QA Account used for load and accuracy testing.</data>
    </node>
    <node id="2">
      <data key="d5">ENDPOINT (PROD)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker Endpoint in Production Account serving inference requests to clients.</data>
    </node>
    <node id="3">
      <data key="d5">XAMD (DS)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">EXAMT serverless deployment application instance in Data Science Account.</data>
    </node>
    <node id="4">
      <data key="d5">XAMD (QA)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">EXAMT serverless deployment application instance in QA Account utilizing API Gateway and Step Functions.</data>
    </node>
    <node id="5">
      <data key="d5">XAMD (PROD)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">EXAMT serverless deployment application instance in Production Account.</data>
    </node>
    <node id="6">
      <data key="d5">DATA SCIENTIST</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Data Scientist who approves trained models in the registry.</data>
    </node>
    <node id="7">
      <data key="d5">ML ENGINEER</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">ML Engineer responsible for triggering cross-account model deployments.</data>
    </node>
    <node id="8">
      <data key="d5">MOBILE</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Xavio Scouting mobile application (6.5M+ users) making prediction requests.</data>
    </node>
    <edge source="0" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Model Registry triggers notification to ML Engineer upon approval.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Model artifact is deployed from Model Registry to QA SageMaker Endpoint.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Model artifact is promoted from QA Endpoint environment to Production Endpoint.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Production Endpoint serves disease and crop predictions to the Mobile app.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">XAMD interacts with Model Registry to fetch model artifacts.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">XAMD QA provisions and updates QA SageMaker Endpoint.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">XAMD PROD provisions and updates Production SageMaker Endpoint.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Scientist approves model in SageMaker Model Registry.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ML Engineer invokes XAMD deployment API in QA Account.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">ML Engineer invokes XAMD deployment API in Production Account after QA validation.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">BASF Digital Farming - Cross-Account Model Deployment (EXAMT)</data>
    <data key="d1">https://www.youtube.com/watch?v=DAJZAygxDZA</data>
    <data key="d2">Architecture for cross-account machine learning model deployment (EXAMT) across Data Science, QA, and Production accounts, supporting Xavio Scouting app with 6.5M+ users in over 100 countries.</data>
    <data key="d3">AI/ML, DevOps, Serverless</data>
    <data key="d4">True</data>
  </graph>
