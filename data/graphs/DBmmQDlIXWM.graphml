<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">PBC</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Packaged Business Capability / SaaS application on the left side (e.g., PIM system)</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway (PBC)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for incoming PBC messages</data>
    </node>
    <node id="2">
      <data key="d5">Lambda (PBC)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Glues API Gateway and SNS FIFO, enforcing authorization and routing rules</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Tenant register service storing dynamic routing rules</data>
    </node>
    <node id="4">
      <data key="d5">SNS FIFO</data>
      <data key="d6">SNS</data>
      <data key="d7">Central ordered message distribution topic</data>
    </node>
    <node id="5">
      <data key="d5">SQS FIFO (Tenant)</data>
      <data key="d6">SQS</data>
      <data key="d7">Tenant queue for asynchronous message processing</data>
    </node>
    <node id="6">
      <data key="d5">Tenant App</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom tenant application on the right side</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway (Tenant)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for incoming tenant application messages</data>
    </node>
    <node id="8">
      <data key="d5">Lambda (Tenant)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes tenant messages before forwarding to SNS FIFO</data>
    </node>
    <node id="9">
      <data key="d5">SQS FIFO (PBC)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue holding messages destined for PBC applications</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">PBC sends price update or data message to API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Lambda function</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda publishes message with applied rules to SNS FIFO</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda retrieves dynamic rules from DynamoDB tenant register</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS FIFO routes message to Tenant SQS FIFO queue based on dynamic rules</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS FIFO routes message to PBC SQS FIFO queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Tenant application sends message to API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway triggers Lambda (Tenant)</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda publishes tenant message to SNS FIFO topic</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">PBC consumes message from SQS FIFO queue</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Spryker Application Composition Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=DBmmQDlIXWM</data>
    <data key="d2">Spryker ACP connects Packaged Business Capabilities (PBCs) and Tenant Applications securely using FIFO messaging with dynamic routing rules stored in DynamoDB.</data>
    <data key="d3">Messaging, SaaS Integration, Multi-Tenant Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
