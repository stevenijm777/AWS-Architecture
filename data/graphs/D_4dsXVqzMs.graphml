  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Scheduled event starter triggering the warning check process.</data>
    </node>
    <node id="1">
      <data key="d5">STEP FUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the serverless workflow state machine.</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes content creation tasks like PDF generation, email formatting, and SMS composition.</data>
    </node>
    <node id="3">
      <data key="d5">API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes current severe weather warning status.</data>
    </node>
    <node id="4">
      <data key="d5">S3 (Warnings)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores active warning state as JSON objects.</data>
    </node>
    <node id="5">
      <data key="d5">S3 (Preferences)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores responder community notification channel preferences.</data>
    </node>
    <node id="6">
      <data key="d5">MESSAGING API</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External third-party API for delivering emails, SMS, and text messages.</data>
    </node>
    <node id="7">
      <data key="d5">ON PREMISE</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premise source system synchronizing responder contact preferences to S3.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch event triggers Step Functions execution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions queries API Gateway for active warning state.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions writes warning state JSON object to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions orchestrates Lambdas to build message artifacts.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions retrieves customer preferences from S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions dispatches synthesized warning notifications to third-party Messaging API.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">On-premise system syncs user contact preferences to S3 bucket.</data>
      <data key="d10">0</data>
