      <data key="d7">Amazon RDS MySQL database with auto-scaled Read Replicas</data>
    </node>
    <node id="8">
      <data key="d5">CLOUDWATCH EVENTS</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">CloudWatch Events timer firing scheduled task triggers every 1 minute</data>
    </node>
    <node id="9">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Amazon SQS queue storing broken-down scheduled tasks for decoupled processing</data>
    </node>
