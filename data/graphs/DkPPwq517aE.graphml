    <node id="4">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Amazon API Gateway serving as REST API endpoint manager</data>
    </node>
    <node id="5">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Amazon ECS cluster running microservices on AWS Fargate serverless infrastructure</data>
    </node>
    <node id="6">
      <data key="d5">FARGATE</data>
      <data key="d6">Fargate</data>
