  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user interacting with the Angular web frontend and REST API endpoints</data>
    </node>
    <node id="1">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF protecting CloudFront and S3 frontend from malicious traffic</data>
    </node>
    <node id="2">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Amazon CloudFront CDN caching static assets and improving user performance</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing Angular frontend web application files</data>
