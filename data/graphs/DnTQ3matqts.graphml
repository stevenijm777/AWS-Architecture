<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SENSOR</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Physical sensors attached to gym equipment tracking usage and telemetry.</data>
    </node>
    <node id="1">
      <data key="d5">GREENGRASS</data>
      <data key="d6">Greengrass</data>
      <data key="d7">AWS Greengrass edge gateway processing sensor data locally and buffering offline data.</data>
    </node>
    <node id="2">
      <data key="d5">APP</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Installer mobile application used for configuring equipment sensors and gateways.</data>
    </node>
    <node id="3">
      <data key="d5">API GATEWAY (top)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API Gateway handling requests from installer app and utilization data ingestion.</data>
    </node>
    <node id="4">
      <data key="d5">SQS (top)</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS queue buffer positioned above Utilization Lambda.</data>
    </node>
    <node id="5">
      <data key="d5">UTILIZATION</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless Lambda function calculating equipment utilization metrics.</data>
    </node>
    <node id="6">
      <data key="d5">IOT CORE</data>
      <data key="d6">IoTCore</data>
      <data key="d7">AWS IoT Core ingesting real-time sensor health telemetry and gateway heartbeats.</data>
    </node>
    <node id="7">
      <data key="d5">SQS (middle)</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS queue buffering sensor status messages from IoT Core.</data>
    </node>
    <node id="8">
      <data key="d5">SENSOR HEALTH</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function processing gateway heartbeat timeout logic.</data>
    </node>
    <node id="9">
      <data key="d5">TIMESERIES DB</data>
      <data key="d6">Timestream</data>
      <data key="d7">AWS Timestream database serving as central data lake for time-series utilization metrics.</data>
    </node>
    <node id="10">
      <data key="d5">COGNITO</data>
      <data key="d6">Cognito</data>
      <data key="d7">AWS Cognito managing authentication for system applications.</data>
    </node>
    <node id="11">
      <data key="d5">API GATEWAY (reporting)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API Gateway exposing reporting endpoints to portals and BI tools.</data>
    </node>
    <node id="12">
      <data key="d5">REPORTING</data>
      <data key="d6">Lambda</data>
      <data key="d7">Reporting Lambda querying utilization data to generate customer reports.</data>
    </node>
    <node id="13">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">SNS notification topic triggering alerts when sensors or gateways go offline.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Fitness equipment sensor transmits usage metrics to local Greengrass gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Greengrass lambda forwards utilization data to backend API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Greengrass sends real-time heartbeat and sensor status to AWS IoT Core.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Installer app connects directly to Greengrass gateway over local RESTful interface.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Installer app communicates with backend via API Gateway during equipment setup.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes Utilization Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Utilization Lambda stores processed usage metrics into Timestream DB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">IoT Core routes health messages into SQS queue for buffering.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS queue feeds Sensor Health Lambda to evaluate device availability.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="13" id="0">
      <data key="d8">2</data>
      <data key="d9">Sensor Health Lambda triggers SNS notification if gateway is offline.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="12" id="0">
      <data key="d8">3</data>
      <data key="d9">Reporting Lambda queries historical utilization data from Timestream DB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="12" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Reporting Lambda outputs generated reports through API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ecofit Automated Fitness Asset Tracking Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=DnTQ3matqts</data>
    <data key="d2">Serverless IoT tracking platform for gym equipment utilization and health monitoring using AWS Greengrass, AWS IoT Core, Timestream DB, Lambda, and API Gateway.</data>
    <data key="d3">IoT, Serverless, Analytics</data>
    <data key="d4">True</data>
  </graph>
