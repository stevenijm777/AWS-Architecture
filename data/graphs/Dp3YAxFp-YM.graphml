  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">STUDENTS</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">120k active students using the e-learning platform</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer routing student web/mobile traffic to the inferencing cluster</data>
    </node>
    <node id="2">
      <data key="d5">EKS (Inference)</data>
      <data key="d6">EKS</data>
      <data key="d7">Auto-scaling EKS cluster serving real-time model inferences for student recommendations (~65k events/day)</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage storing ~100M learning event data points</data>
    </node>
    <node id="4">
      <data key="d5">AUTHORS</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Authors publishing content on the platform (~65k data points)</data>
    </node>
    <node id="5">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Scalable data warehouse combining structured and unstructured data (&gt;3TB total stored data)</data>
    </node>
    <node id="6">
      <data key="d5">EKS (Training)</data>
      <data key="d6">EKS</data>
      <data key="d7">Training EKS cluster running Kubeflow for training ML models</data>
    </node>
    <node id="7">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Performs hyperparameter tuning optimizing F1 score and recall metrics</data>
    </node>
    <node id="8">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Elastic Container Registry storing trained Docker container images</data>
    </node>
    <node id="9">
      <data key="d5">CLOUD WATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors training logs and inference performance metrics to trigger model retrains</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Students access recommendation features via load balancer</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
