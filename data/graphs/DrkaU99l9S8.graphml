<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Runs edge compute functions on Greengrass and executes deployed predictive ML models.</data>
    </node>
    <node id="1">
      <data key="d5">Greengrass</data>
      <data key="d6">Greengrass</data>
      <data key="d7">Connects plant machinery and smart building equipment at the edge to AWS IoT Core.</data>
    </node>
    <node id="2">
      <data key="d5">BIQSens</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Edge component collecting sensor metrics from plant motors, pumps, and HVAC systems.</data>
    </node>
    <node id="3">
      <data key="d5">IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Central AWS IoT Hub that uses IoT Rules to filter and route telemetry data to analytics channels.</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Streams</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Streams real-time equipment data for streaming analytics and data lake persistence.</data>
    </node>
    <node id="5">
      <data key="d5">Kinesis Analytics</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Performs real-time analytics and condition-based monitoring to predict failures.</data>
    </node>
    <node id="6">
      <data key="d5">IoT Analytics</data>
      <data key="d6">IoTAnalytics</data>
      <data key="d7">Performs batch analysis and runs statistical process control (SPC) functions.</data>
    </node>
    <node id="7">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualizes batch analytics, trend metrics, and threshold breach reports.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake store holding audit logs, raw datasets, and historical telemetry for model training.</data>
    </node>
    <node id="9">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains machine learning models to continuously improve anomaly detection accuracy.</data>
    </node>
    <node id="10">
      <data key="d5">User</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">End user / operator receiving real-time failure alerts, monitoring dashboards, and batch analytics.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Edge Lambda sends processed equipment telemetry to IoT Core.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Greengrass connects plant machinery metrics directly to IoT Core.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">BIQSens edge system sends sensor data to AWS IoT Core.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Rules route real-time streaming data into Kinesis Streams.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Rules route data into IoT Analytics for batch analysis.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Streams writes dataset records and audit logs into S3 buckets.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Streams feeds real-time telemetry to Kinesis Analytics for anomaly detection.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Streams triggers real-time alerts to notify end users of threshold breaches.</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Analytics sends processed batch analytics to QuickSight for visual reporting.</data>
      <data key="d10">2'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Analytics delivers batch statistical insights and notifications to the end user.</data>
      <data key="d10">2''''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker uses S3 data lake datasets to train predictive maintenance models.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker deploys updated, highly accurate ML models back to Lambda at the edge.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">LT Technology Services Edge-to-Cloud Predictive Maintenance Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=DrkaU99l9S8</data>
    <data key="d2">End-to-end IoT architecture showing data ingestion from edge devices through AWS IoT Core, real-time analytics with Kinesis, batch analytics with IoT Analytics and QuickSight, and model retraining via S3 and SageMaker deployed back to edge Lambda functions.</data>
    <data key="d3">IoT Analytics Machine Learning</data>
    <data key="d4">True</data>
  </graph>
