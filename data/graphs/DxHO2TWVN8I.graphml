  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Receives user web interaction events (clicks, impressions).</data>
    </node>
    <node id="1">
      <data key="d5">Shield</data>
      <data key="d6">Shield</data>
      <data key="d7">Provides DDoS and cost protection against attack traffic spikes.</data>
    </node>
    <node id="2">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Docker cluster running Go receiver services.</data>
    </node>
    <node id="3">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Aggregates and streams raw events to storage.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw user interaction data and processed analytical datasets.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Runs scheduled aggregations every 5 minutes.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores aggregated metrics and key business outputs.</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Fronts backend requests for real-time analytics data.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront routes incoming user ad interaction events to ECS receivers.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">3</data>
      <data key="d9">CloudFront edge traffic is monitored and protected by AWS Shield.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Shield mitigates attack volume to safeguard backend storage cost models.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS Go receivers push event messages to Kinesis Firehose.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Firehose writes raw streaming interaction logs into S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda reads raw event data from S3 every 5 minutes.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda writes aggregated output analytics back into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda populates aggregated query results into DynamoDB tables.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway retrieves aggregated analytics metrics from DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway queries analytical data stored in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway connects back across CloudFront distribution network.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Equinix Serverless Ad Tech Ingestion and Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=DxHO2TWVN8I</data>
    <data key="d2">Serverless ad tech platform handling up to 15,000 events per second. Uses CloudFront, ECS container receivers in Go, Kinesis Firehose, S3, Lambda, DynamoDB, API Gateway, and AWS Shield for DDoS/cost protection.</data>
    <data key="d3">AdTech Analytics, Serverless Data Pipeline</data>
    <data key="d4">True</data>
