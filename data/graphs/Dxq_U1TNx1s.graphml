  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Satellite</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Open domain satellite imagery provided by ISRO and NASA</data>
    </node>
    <node id="1">
      <data key="d5">Mobile Device</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Field managers collecting GIS field-level data</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores satellite imagery data and processed output images</data>
    </node>
    <node id="3">
      <data key="d5">Registry of Open Data</data>
      <data key="d6">S3</data>
      <data key="d7">AWS Registry of Open Data storing spectral regions, reducing transfer size from 60TB to 20TB</data>
    </node>
    <node id="4">
      <data key="d5">PostgreSQL</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL database with GIS extension storing field boundaries and spatial statistics</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Actuates parallel processing jobs on SageMaker every 5-10 days</data>
    </node>
    <node id="6">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Executes 3,400 parallel processing jobs for spatial and temporal analysis</data>
    </node>
    <node id="7">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Graviton-based EC2 instances hosting the EKS cluster for cost-effective compute</data>
    </node>
    <node id="8">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Deploys UI applications and serves geospatial map layers</data>
    </node>
    <node id="9">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Caches map data layers to minimize transfer latency and data transfer cost</data>
    </node>
    <node id="10">
      <data key="d5">End User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Agriculture sector end users accessing UI applications</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
