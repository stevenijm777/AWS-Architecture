<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">AWS Key Management Service used to encrypt data in flight and at rest across planes and tenant environments.</data>
    </node>
    <node id="1">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS hosting microservices for management UI, billing, and internal data processing.</data>
    </node>
    <node id="2">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Elasticsearch service used for real-time analytics, indexing, and alerting on backup data.</data>
    </node>
    <node id="3">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Amazon Aurora database storing core customer backup metadata and telemetry.</data>
    </node>
    <node id="4">
      <data key="d5">PRIVATELINK</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">AWS PrivateLink providing private intra-region connectivity between control plane and data plane VPCs.</data>
    </node>
    <node id="5">
      <data key="d5">TRANSIT GATEWAY</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">AWS Transit Gateway enabling secure cross-region and cross-geo communication over AWS backbone.</data>
    </node>
    <node id="6">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Data plane compute instances provisioned for isolated tenant environments.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 object storage for long-term customer backup data in the data plane.</data>
    </node>
    <node id="8">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user interacting with the platform via the Web UI interface.</data>
    </node>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS integrates with KMS for encryption key management.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS microservices send log data and analytics queries to Elasticsearch.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS microservices connect to Aurora for metadata storage and state management.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Elasticsearch routes control traffic internally via PrivateLink.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Aurora connects through Transit Gateway for cross-region data transfer.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">PrivateLink connects Control Plane to EC2 instances in Data Plane within same region.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Transit Gateway routes backup data across regions to target S3 buckets.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User accesses the UI and management interface provided by EKS microservices.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Direct query path or reporting access to Aurora database records.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cohesity Data Management as a Service Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=E68ufJOduio</data>
    <data key="d2">Separates control plane (EKS, KMS, Elasticsearch, Aurora, PrivateLink, Transit Gateway) from data plane (EC2, S3) to achieve scalability and security.</data>
    <data key="d3">backup, data management, cloud security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
