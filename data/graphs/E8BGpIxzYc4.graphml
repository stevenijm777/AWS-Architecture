<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">MongoDB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Operational database with change streams enabled to track application updates.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers incoming streaming updates and saves them into the raw S3 bucket.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Raw Zone</data>
      <data key="d6">S3</data>
      <data key="d7">Raw storage zone bucket holding raw change stream and accounting JSON files.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Landing Zone</data>
      <data key="d6">S3</data>
      <data key="d7">Curated storage zone containing deduplicated and cataloged JSON data.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Crawls raw data for cataloging, executes deduplication jobs, and transforms curated JSON into star schema tables.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational database holding star schema facts and dimensions for benchmark and performance analytics.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query service used to run ad-hoc BI queries directly on Landing Zone S3 data via Glue Data Catalog.</data>
    </node>
    <node id="7">
      <data key="d5">Elastic Beanstalk</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Backend service handling HTTP requests from the frontend and querying Aurora.</data>
    </node>
    <node id="8">
      <data key="d5">CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CloudFront distribution hosting the Angular web application for community managers.</data>
    </node>
    <node id="9">
      <data key="d5">AIS Middleware</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External middleware interfacing with ~6 accounting systems to drop accounting data into the S3 Raw Zone.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">MongoDB change streams drop operational data into Kinesis Data Firehose.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Data Firehose buffers and writes raw JSON streams into S3 Raw Zone.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 Raw Zone triggers AWS Glue crawler to classify data and build catalog.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">AWS Glue reads curated data from S3 Landing Zone.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue deduplication job processes raw data and saves curated data into S3 Landing Zone.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Glue ETL job transforms landing data into star schema facts/dimensions and writes to Aurora.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">4</data>
      <data key="d9">Athena queries data directly from S3 Landing Zone using Glue catalog.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">5</data>
      <data key="d9">Elastic Beanstalk executes queries against Aurora star schema database.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">5</data>
      <data key="d9">Angular frontend via CloudFront sends HTTP query requests to Elastic Beanstalk backend.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">AIS middleware drops accounting data into S3 Raw Zone.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Town Square Data Processing and Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=E8BGpIxzYc4</data>
    <data key="d2">The architecture processes operational MongoDB change streams and accounting data through an S3 raw/landing zone pipeline using AWS Glue, Amazon Aurora star schema, Amazon Athena, and Elastic Beanstalk with CloudFront.</data>
    <data key="d3">Data Analytics &amp; Data Ingestion Pipeline</data>
    <data key="d4">True</data>
  </graph>
</graphml>
