<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SCANNER</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Handheld scanning device used by drivers in the field; captures around 50 million scans annually.</data>
    </node>
    <node id="1">
      <data key="d5">FARGATE (Ingestion)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Containerized API ingestion service scaling between 500 and 1,500 scans per minute.</data>
    </node>
    <node id="2">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Primary NoSQL database storing scan records and generating stream events via DynamoDB Streams.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless function reading events from DynamoDB Streams and publishing to SNS.</data>
    </node>
    <node id="4">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Notification topic implementing pub/sub fanout to multiple SQS queues.</data>
    </node>
    <node id="5">
      <data key="d5">SQS (Web Service)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue buffering tracking updates for the public website service.</data>
    </node>
    <node id="6">
      <data key="d5">FARGATE (Web Service)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Compute service processing tracking updates for customer display.</data>
    </node>
    <node id="7">
      <data key="d5">WEBSITE</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Public website displaying parcel status updates to users within five minutes of scanning.</data>
    </node>
    <node id="8">
      <data key="d5">SQS (Image Service)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue buffering scan tasks that require image processing.</data>
    </node>
    <node id="9">
      <data key="d5">FARGATE (Image Service)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Compute service specifically dedicated to processing package photos.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Scanners send scan payloads to the Fargate API ingestion endpoint.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate ingests and writes scan data to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB Streams triggers Lambda function on scan record insertion.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda publishes scan events to the SNS topic.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS fans out scan events to the web service SQS queue.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS fans out scan events parallelly to the image processing SQS queue.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Web service Fargate task polls and processes messages from SQS.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate updates tracking state published on the customer website.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Image processing Fargate service consumes scan image messages from SQS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Freightways Parcel Scanning and Tracking Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=E8wYXtvGy5k</data>
    <data key="d2">Handles over 50 million parcel scans annually, processing 500 average to 1,500 peak scans per minute with 99% website status updates within five minutes.</data>
    <data key="d3">Express Logistics, Event-Driven Architecture, Serverless Ingestion</data>
    <data key="d4">True</data>
  </graph>
</graphml>
