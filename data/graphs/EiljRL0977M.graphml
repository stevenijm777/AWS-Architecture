<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DATALAKE</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw MRI input data and accepts curated processing outputs.</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Provisioned in large clusters (hundreds to thousands of instances) by AWS Batch as the compute layer with mounted FSx storage.</data>
    </node>
    <node id="2">
      <data key="d5">BATCH</data>
      <data key="d6">Batch</data>
      <data key="d7">Orchestrates the execution of multi-day batch processing jobs and sends state change events.</data>
    </node>
    <node id="3">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">High-performance file storage mounted on EC2 instances for processing and output staging.</data>
    </node>
    <node id="4">
      <data key="d5">EVENTBRIDGE</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Receives job state change events from AWS Batch.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes EventBridge notifications and writes log/status data into Elasticsearch.</data>
    </node>
    <node id="6">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Indexes job status events and technical logs for data scientist monitoring and visualization dashboards.</data>
    </node>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Batch emits events on job status change to EventBridge.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Batch orchestrates processing jobs using FSx as mounted high-speed storage.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">FSx syncs curated output back into S3 Data Lake via Data Repository Task (DRT).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge triggers Lambda function with job events.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda indexes job events and logs into Elasticsearch for analysis and visualization.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Biopharma MRI Data Processing and Curation Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=EiljRL0977M</data>
    <data key="d2">Architecture for orchestrating, curating, and monitoring MRI data processing jobs at scale using AWS Batch, FSx, EventBridge, Lambda, and Elasticsearch.</data>
    <data key="d3">Analytics, Compute, Storage</data>
    <data key="d4">True</data>
  </graph>
