  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Coach</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Coach web interface for managing virtual classes and viewing member metrics</data>
    </node>
    <node id="1">
      <data key="d5">Member</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Member mobile application collecting heart rate and streaming video</data>
    </node>
    <node id="2">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Authenticates both coaches and members into virtual classes</data>
    </node>
    <node id="3">
      <data key="d5">Chime SDK</data>
      <data key="d6">Chime</data>
      <data key="d7">Handles real-time video/audio streaming and WebSocket heart rate communication</data>
    </node>
    <node id="4">
      <data key="d5">Api Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">REST API endpoint for class metadata and post-workout summary ingestion</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute processing class information requests and workout summary writes</data>
    </node>
    <node id="6">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational database holding class schedule and studio info</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database storing completed workout summaries for rapid app retrieval</data>
    </node>
    <node id="8">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Ingests continuous second-by-second member heart rate streaming telemetry</data>
    </node>
    <node id="9">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake bucket storing raw heart rate and class telemetry analytics</data>
    </node>
