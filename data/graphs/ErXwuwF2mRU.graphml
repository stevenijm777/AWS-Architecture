      <data key="d6">Cognito</data>
      <data key="d7">Amazon Cognito managing user authentication connected to corporate single sign-on</data>
    </node>
    <node id="9">
      <data key="d5">PINPOINT</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">Amazon Pinpoint capturing user activity and site analytics</data>
    </node>
