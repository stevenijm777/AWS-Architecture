  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">WEB / ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Dockerized web frontend application hosted on an Amazon ECS cluster</data>
    </node>
    <node id="1">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API Gateway managing and modularizing backend service requests</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless Lambda function orchestrating data science workflows, DB calls, and storage</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing incoming user images and data for continuous retraining</data>
    </node>
    <node id="4">
      <data key="d5">DEV Environment</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data science dev environment ingesting S3 data to retrain ML models</data>
    </node>
    <node id="5">
      <data key="d5">Database</data>
