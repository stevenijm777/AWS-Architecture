    <node id="6">
      <data key="d5">MODELING ENDPOINT / EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">GPU-optimized EC2 instance running a Flask container with live ML production models</data>
    </node>
    <node id="7">
      <data key="d5">AMPLIFY FRAMEWORK</data>
      <data key="d6">Amplify</data>
      <data key="d7">AWS Amplify Framework used to rapidly configure and provision application architecture</data>
