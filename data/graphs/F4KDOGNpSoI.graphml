<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End-user consumers scanning QR codes/NFC tags on bottles or clicking social media links.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Global CDN serving as entry point for short URL requests and producing access logs.</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA@EDGE</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Edge compute function that inspects requests and performs local DynamoDB lookups.</data>
    </node>
    <node id="3">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB Global Tables replicated across regions storing short-to-long URL mappings.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Logs Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket receiving raw CloudFront access logs.</data>
    </node>
    <node id="5">
      <data key="d5">Log Transformation Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms logs by converting IP to country/city and expanding User Agent metadata.</data>
    </node>
    <node id="6">
      <data key="d5">FIREHOSE</data>
      <data key="d6">Firehose</data>
      <data key="d7">Kinesis Data Firehose streaming enriched logs into the Data Lake.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Data Lake Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized S3 Data Lake storing processed logs for analytics.</data>
    </node>
    <node id="8">
      <data key="d5">ADMIN</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal admin/contributor users managing links and viewing analytics.</data>
    </node>
    <node id="9">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API Gateway serving backend routes for admin short URL creation and analytics queries.</data>
    </node>
    <node id="10">
      <data key="d5">Backend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Core backend function handling business logic, permissions, short link generation, and Athena queries.</data>
    </node>
    <node id="11">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS Aurora storing user permissions and access policies.</data>
    </node>
    <node id="12">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query engine executing SQL analytics queries against the S3 Data Lake.</data>
    </node>
    <node id="13">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">AWS Glue optimizing Data Lake file formats for fast and efficient Athena queries.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User request directed to CloudFront CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront triggers Lambda@Edge function on viewer request.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront writes standard access logs to S3 Logs Bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda@Edge queries local DynamoDB region table for long URL lookup.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda@Edge returns HTTP redirect response back to user.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 object creation triggers Log Transformation Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Transformed log records sent to Kinesis Data Firehose stream.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Firehose delivers aggregated log batches into S3 Data Lake.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="13" id="0">
      <data key="d8">2</data>
      <data key="d9">AWS Glue cataloging and compacting S3 Data Lake log data.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Admin sends API requests via API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">API Gateway routes request to Backend Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Backend Lambda verifies admin permissions in RDS Aurora.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Backend Lambda creates/updates short URL entries in DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="12" id="0">
      <data key="d8">3</data>
      <data key="d9">Backend Lambda triggers analytics queries in Athena.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="12" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Athena queries raw/optimized log data directly from S3 Data Lake.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Pernod Ricard Global URL Shortener Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=F4KDOGNpSoI</data>
    <data key="d2">Pernod Ricard URL shortener service built on AWS serverless technologies, replacing a legacy solution and reducing costs ~100x while serving global QR code and NFC link redirects.</data>
    <data key="d3">Serverless, Serverless Analytics, Global Edge Infrastructure</data>
    <data key="d4">True</data>
  </graph>
