<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">WEB/MOBILE CLIENT</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Client application used by end users for monitoring and device control.</data>
    </node>
    <node id="1">
      <data key="d5">COGNITO</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user login and registration inside the customer account.</data>
    </node>
    <node id="2">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">REST API endpoint managing client requests.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute querying DynamoDB and returning data to API Gateway.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Database storing persistent IoT telemetry and device data.</data>
    </node>
    <node id="5">
      <data key="d5">IOT CORE</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Central AWS IoT service handling MQTT telemetry and device shadows.</data>
    </node>
    <node id="6">
      <data key="d5">GREENGRASS</data>
      <data key="d6">Greengrass</data>
      <data key="d7">Edge software running on local gateways collecting ground-level equipment data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Web/Mobile Client authenticates user identity via Cognito.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Web/Mobile Client calls API Gateway endpoints after authentication.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Web/Mobile Client establishes MQTT connection with IoT Core for real-time visualization and shadow control.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway triggers Lambda function.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda fetches stored telemetry data from DynamoDB to display on client UI.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Core routes and saves telemetry data directly into DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Greengrass gateway collects local device data and sends it up to IoT Core.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">SoftChef - MIAP Serverless IoT Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=FHdtOtznWuA</data>
    <data key="d2">Architecture showing SoftChef's serverless IoT solution deployed into a customer's AWS account, connecting edge devices with web/mobile applications.</data>
    <data key="d3">IoT, Serverless</data>
    <data key="d4">True</data>
  </graph>
