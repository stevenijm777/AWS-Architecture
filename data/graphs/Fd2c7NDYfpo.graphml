  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Engineer submitting an account provisioning request through the portal.</data>
    </node>
    <node id="1">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives account provisioning requests from the user portal.</data>
    </node>
    <node id="2">
      <data key="d5">VALIDATE</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates request parameters such as email domain to confirm internal origin.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Decouples request validation from account creation.</data>
    </node>
    <node id="4">
      <data key="d5">CREATE</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes account creation, selects master account, configures OUs, and budget alerts.</data>
    </node>
    <node id="5">
      <data key="d5">ORGANIZATIONS</data>
      <data key="d6">Organizations</data>
      <data key="d7">Manages active and inactive OUs with Service Control Policies (SCPs) enforcing cost and security constraints.</data>
    </node>
    <node id="6">
      <data key="d5">CLOUDFORMATION</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Provisions account resources, blueprints, and budget alarms.</data>
    </node>
    <node id="7">
      <data key="d5">SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends request acknowledgment emails, account credentials, and budget usage notifications.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User submits account provisioning request.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway forwards request payload to Validate Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Validate Lambda triggers SES to send receipt confirmation email to user.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Validate Lambda sends validated request message to SQS queue.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Create Lambda processes queued provisioning message.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Create Lambda triggers CloudFormation templates to build out account infrastructure.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Create Lambda attaches child account to designated OU within AWS Organizations.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Create Lambda triggers SES to email credentials and completion details to user.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Automated AWS Account Generation Engine</data>
    <data key="d1">https://www.youtube.com/watch?v=Fd2c7NDYfpo</data>
    <data key="d2">Publicis Sapient's serverless platform for automated, governed AWS account creation and budget enforcement.</data>
    <data key="d3">Automation, Governance, Serverless</data>
    <data key="d4">True</data>
  </graph>
