<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEVELOPERS</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">1,600+ developers accessing the internal self-service platform portal without VPN.</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer providing secure external endpoint for developers.</data>
    </node>
    <node id="2">
      <data key="d5">EKS (Portal)</data>
      <data key="d6">EKS</data>
      <data key="d7">Frontend Kubernetes cluster hosting self-service forms and web UI.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue used to decouple portal request submissions from provisioning execution.</data>
    </node>
    <node id="4">
      <data key="d5">TERRAFORM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Terraform configuration templates containing Xero security and compliance standards.</data>
    </node>
    <node id="5">
      <data key="d5">EKS (Terraform Runner)</data>
      <data key="d6">EKS</data>
      <data key="d7">Worker Kubernetes cluster executing automated Terraform provisioning tasks.</data>
    </node>
    <node id="6">
      <data key="d5">SUBNET</data>
      <data key="d6">VPC</data>
      <data key="d7">Network subnets configured across 150 target AWS accounts.</data>
    </node>
    <node id="7">
      <data key="d5">RAM</data>
      <data key="d6">RAM</data>
      <data key="d7">Resource Access Manager used to share unified subnet configurations across accounts.</data>
    </node>
    <node id="8">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational Database Service instances provisioned in target subnets.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developers access the portal UI directly via ALB without VPN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards web traffic to the portal container on EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Portal pushes provisioning request jobs into SQS.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">SQS triggers execution of pending jobs on the Terraform runner EKS cluster.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Terraform configuration is loaded into the runner EKS pod.</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Terraform runner provisions RDS database instances in target accounts.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Terraform runner configures networking and subnets across 150 AWS accounts.</data>
      <data key="d10">4'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">RAM manages and shares single subnet configurations across all 150 accounts.</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Xero Developer Self-Service Infrastructure Provisioning Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=Felt-hOU6kU</data>
    <data key="d2">Architecture showing how Xero enables 1,600+ developers to securely and rapidly provision compliant AWS infrastructure (RDS, subnets) across 150 accounts using EKS, SQS, Terraform, and Resource Access Manager (RAM).</data>
    <data key="d3">DevOps, Infrastructure Automation, Multi-Account Management</data>
    <data key="d4">True</data>
  </graph>
</graphml>
