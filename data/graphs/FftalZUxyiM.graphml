<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Landing</data>
      <data key="d6">S3</data>
      <data key="d7">Receives incoming employee CSV data files from SAP and SuccessFactors.</data>
    </node>
    <node id="1">
      <data key="d5">Validation Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates file schema and structure upon arrival in S3 Landing.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Staging</data>
      <data key="d6">S3</data>
      <data key="d7">Stores validated employee data files.</data>
    </node>
    <node id="3">
      <data key="d5">Load Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Extracts staging data and converts it into structured records in DynamoDB.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Key-value database holding structured employee profile data.</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates node creation, relationship mapping, and loading into Neptune.</data>
    </node>
    <node id="6">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Graph database modeling relationships between employees, skills, and job categories.</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes backend endpoints for the Node/React web app used by employees and managers.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Arrival of files in S3 Landing triggers the Validation Lambda function.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Validation Lambda saves validated CSV files to S3 Staging.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Arrival of files in S3 Staging triggers the Load Lambda function.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Load Lambda writes structured profile data into DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB provides structured employee data to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions orchestrates node and relationship file generation and loads graph data into Neptune.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Neptune provides graph query and ranking results to API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cepsa Internal Talent Matching Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=FftalZUxyiM</data>
    <data key="d2">Architecture of Cepsa's internal candidate selection platform using S3 data lake layers, Lambda, DynamoDB, Step Functions, Neptune graph database, and API Gateway.</data>
    <data key="d3">Data Lake &amp; Graph Database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
