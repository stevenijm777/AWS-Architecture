<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SCHEDULER</data>
      <data key="d6">EC2</data>
      <data key="d7">Schedules synthetic test jobs on a configured time interval (e.g., every minute or hour).</data>
    </node>
    <node id="1">
      <data key="d5">JOB QUEUE</data>
      <data key="d6">SQS</data>
      <data key="d7">Stores scheduled synthetic test jobs until runtime monitors pick them up.</data>
    </node>
    <node id="2">
      <data key="d5">MONITOR API</data>
      <data key="d6">EC2</data>
      <data key="d7">Receives synthetic test execution results from public and private monitors.</data>
    </node>
    <node id="3">
      <data key="d5">RESULTS QUEUE</data>
      <data key="d6">SQS</data>
      <data key="d7">Stores test results for processing, dashboarding, and alerting.</data>
    </node>
    <node id="4">
      <data key="d5">PUBLIC MONITORS</data>
      <data key="d6">EC2</data>
      <data key="d7">Public runtime instances (minions) executing tests against public endpoints.</data>
    </node>
    <node id="5">
      <data key="d5">GLOBAL ACCELERATOR</data>
      <data key="d6">GlobalAccelerator</data>
      <data key="d7">Provides static IPs for secure, performant routing from private monitors back to the MONITOR API.</data>
    </node>
    <node id="6">
      <data key="d5">PRIVATE MONITORS</data>
      <data key="d6">EC2</data>
      <data key="d7">Containerized private monitors (minions) running inside customer private networks/VPCs.</data>
    </node>
    <node id="7">
      <data key="d5">PUBLIC</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Public website or API target tested by public monitors.</data>
    </node>
    <node id="8">
      <data key="d5">PRIVATE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Private website or API target tested by private monitors inside customer network.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SCHEDULER pushes scheduled jobs into JOB QUEUE.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Connects job processing pipeline towards MONITOR API.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">PUBLIC MONITORS pick up scheduled jobs from JOB QUEUE.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">MONITOR API sends test execution results into RESULTS QUEUE.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Feedback loop returning process cycle back to SCHEDULER.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">PUBLIC MONITORS execute tests against PUBLIC endpoint.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">GLOBAL ACCELERATOR routes traffic securely to MONITOR API.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">PRIVATE MONITORS execute tests against PRIVATE endpoint.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">PRIVATE MONITORS route results upward using static IPs provided by GLOBAL ACCELERATOR.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">New Relic Synthetics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=FmhL2334GIY</data>
    <data key="d2">Architecture illustrating New Relic's Synthetic testing pipeline handling public and private test execution and result collection using AWS SQS, EC2, and Global Accelerator.</data>
    <data key="d3">Monitoring &amp; Observability, Synthetic Testing, Global Acceleration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
