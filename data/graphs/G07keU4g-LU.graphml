<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">POS</data>
      <data key="d6">UserConsumerPOS</data>
      <data key="d7">Point of Sale machines across 1,200+ restaurants.</data>
    </node>
    <node id="1">
      <data key="d5">POS DB</data>
      <data key="d6">RDS</data>
      <data key="d7">Consolidation server / database for POS data on AWS cloud.</data>
    </node>
    <node id="2">
      <data key="d5">E-COMM</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">E-commerce digital assets including app, mobile, and desktop website.</data>
    </node>
    <node id="3">
      <data key="d5">DB</data>
      <data key="d6">RDS</data>
      <data key="d7">E-commerce database running MySQL.</data>
    </node>
    <node id="4">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">AWS Database Migration Service transferring MySQL data into S3 raw layer.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central S3 data lake holding raw and curated data layers.</data>
    </node>
    <node id="6">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Serverless query service used by data analysts for ad hoc SQL insights.</data>
    </node>
    <node id="7">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR processing jobs for data curation and loading hot data into Redshift.</data>
    </node>
    <node id="8">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse storing ~5-6 months of hot data.</data>
    </node>
    <node id="9">
      <data key="d5">RS Spectrum</data>
      <data key="d6">RedShift</data>
      <data key="d7">Redshift Spectrum allowing queries directly against S3 cold data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">POS machine data flows into consolidation POS DB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Custom ETL scripts transform and load POS DB data to S3 raw layer.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">E-commerce orders flow into POS machines for restaurant fulfillment.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">E-commerce transactions stored in MySQL DB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS reads transaction data from MySQL DB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS loads data into S3 raw layer.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR reads raw data from S3 for processing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 returns query result data back to Athena.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries historical data stored in S3 data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR writes back processed/curated data to S3 curated layer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR loads hot data (last 5-6 months) into Redshift.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Redshift Spectrum transparently queries warm/cold data in S3 data lake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Jubilant Foodworks Data Lake and Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=G07keU4g-LU</data>
    <data key="d2">Architecture handles ~200,000 orders/day across ~1,250 restaurants, hitting up to 1,500 orders per minute at peak.</data>
    <data key="d3">Data Analytics &amp; Data Lake</data>
    <data key="d4">True</data>
  </graph>
</graphml>
