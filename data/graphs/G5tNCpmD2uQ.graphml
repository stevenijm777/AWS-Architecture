<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer distributing incoming ad request traffic to the ECS compute cluster.</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Underlying EC2 instances configured in an Auto Scaling Group hosting the ECS tasks.</data>
    </node>
    <node id="2">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Elastic Container Service executing business filter logic, feature collection, and endpoint invocation.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database storing business filter rules and user features required for ML model input.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake S3 bucket storing raw analytics and user interaction logs.</data>
    </node>
    <node id="5">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Batch EMR cluster processing, joining, and aggregating raw data lake logs into ML datasets.</data>
    </node>
    <node id="6">
      <data key="d5">S3 Dataset</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket holding prepared training and testing datasets produced by EMR.</data>
    </node>
    <node id="7">
      <data key="d5">Notebook</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker Jupyter Notebook environment used by data scientists for model experimentation and offline predictions.</data>
    </node>
    <node id="8">
      <data key="d5">Model Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Deployed SageMaker real-time inference endpoint serving online ad install probability predictions.</data>
    </node>
    <node id="9">
      <data key="d5">Model Training</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker training component for building and retraining ad optimization models.</data>
    </node>
    <node id="10">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker service suite container enabling end-to-end data science autonomy.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB routes incoming game ad request traffic to the ECS application layer.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS fetches business filtering parameters and features from DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS invokes the SageMaker Model Endpoint to obtain conversion probability predictions for ad campaigns.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR batch jobs read raw data from the S3 Data Lake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR writes aggregated datasets to the S3 Dataset bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Data scientists read prepared datasets into SageMaker Notebooks for offline model validation.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Voodoo Mobile Game Cross-Promotion Machine Learning Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=G5tNCpmD2uQ</data>
    <data key="d2">Architecture handles ~100 million SageMaker model invocations and billions of predictions daily to optimize in-game cross-promotion ad serving for Voodoo mobile games.</data>
    <data key="d3">Analytics, Compute, Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
