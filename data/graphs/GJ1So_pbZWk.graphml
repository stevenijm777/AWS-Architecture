<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EFS</data>
      <data key="d6">EFS</data>
      <data key="d7">Data source for flat files and shared files.</data>
    </node>
    <node id="1">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database data source.</data>
    </node>
    <node id="2">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Structured columnar data warehouse data source.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Source</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket serving as an initial landing area for flat files.</data>
    </node>
    <node id="4">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Performs ETL transformations on data from various source databases and file stores.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Central</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake repository where transformed data and final model outputs (Next Best Offer) are stored.</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless function triggered by S3 data load events to orchestrate SageMaker processing.</data>
    </node>
    <node id="7">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs layered ML algorithms: K-Means clustering followed by Random Forest prediction models.</data>
    </node>
    <node id="8">
      <data key="d5">API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API interface for real-time consumption by call center agents, websites, and external applications.</data>
    </node>
    <node id="9">
      <data key="d5">BI</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Business intelligence dashboard for management visibility and historical insight analysis.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EFS data source ingested into Glue ETL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB data ingested into Glue ETL.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift data ingested into Glue ETL.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 source files ingested into Glue ETL.</data>
      <data key="d10">0'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Glue transforms data and writes output to S3 Central.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Data load event in S3 Central triggers Lambda execution (labeled CLUSTER).</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda invokes SageMaker model execution (labeled PREDICT).</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker writes the generated output (NEXT BEST OFFER) back into S3 Central.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">SageMaker serves predictions in real time via API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">SageMaker feeds feature weights and ML results to QuickSight BI dashboard.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">TASOLS Event-Driven Machine Learning Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=GJ1So_pbZWk</data>
    <data key="d2">Serverless event-driven architecture that chains machine learning models (clustering and prediction) using AWS Glue, Lambda, SageMaker, and S3, exposing results via API Gateway and QuickSight BI dashboards.</data>
    <data key="d3">Machine Learning, Serverless, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
