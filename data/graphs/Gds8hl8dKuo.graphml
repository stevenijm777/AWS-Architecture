<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User / External Client</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">External actor sending infrastructure requests into the conductor architecture.</data>
    </node>
    <node id="1">
      <data key="d5">SQS Input Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Ingresses incoming SQS messages from external users to trigger conductor workflows.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 (Conductor Engine)</data>
      <data key="d6">EC2</data>
      <data key="d7">Orchestration engine running inside an Auto Scaling Group (min 1, max 1) deploying and scanning infrastructure.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Policy Storage</data>
      <data key="d6">S3</data>
      <data key="d7">Stores compiled policy code (CIS, GDPR, HIPAA, NIST 800-53, PCI) and infrastructure declarations.</data>
    </node>
    <node id="4">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Provides encryption for all messages, data, and security standards.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Persistence layer storing infrastructure state and configurations.</data>
    </node>
    <node id="6">
      <data key="d5">SQS Top Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Handles internal conductor messaging and notifications.</data>
    </node>
    <node id="7">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Dispatches real-time drift alerts to admins when non-compliant modifications are detected.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Account 1</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Target customer account managed by Conductor via cross-account IAM role.</data>
    </node>
    <node id="9">
      <data key="d5">AWS Account 2</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Target customer account managed by Conductor via cross-account IAM role.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">External user sends SQS message requesting infrastructure action.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Conductor EC2 instance polls and processes incoming SQS request.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Conductor persists state and baseline data into DynamoDB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Conductor provisions, continuously scans (60s), and remediates drift in AWS Account 1 via cross-account IAM role.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Conductor provisions, continuously scans (60s), and remediates drift in AWS Account 2 via cross-account IAM role.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Conductor routes internal event notifications via SQS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Conductor triggers real-time drift alerts via SNS.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Conductor downloads compiled policy and declaration code from S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">KMS decrypts and authenticates message and security context.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Automated Drift Detection with Fugue Conductor</data>
    <data key="d1">https://www.youtube.com/watch?v=Gds8hl8dKuo</data>
    <data key="d2">Fugue Conductor runs as an EC2 instance within an Auto Scaling Group in the customer's AWS account. It ingests requests via SQS, loads compiled policies from S3, authenticates and decrypts with KMS/IAM/STS, stores state in DynamoDB, and continuously scans and remediates drift across multiple secondary AWS accounts every 60 seconds while emitting real-time notifications.</data>
    <data key="d3">Security, Compliance, Infrastructure as Code, Automation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
