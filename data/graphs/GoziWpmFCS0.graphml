<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 (JSON)</data>
      <data key="d6">S3</data>
      <data key="d7">Receives ~3 TB/day of raw JSON records from incoming data pipelines.</data>
    </node>
    <node id="1">
      <data key="d5">CRAWLER (JSON)</data>
      <data key="d6">Glue</data>
      <data key="d7">Crawls raw JSON data in S3 to automatically discover table schemas and data types.</data>
    </node>
    <node id="2">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Serverless Glue ETL job that processes raw JSON records into optimized Parquet columnar format.</data>
    </node>
    <node id="3">
      <data key="d5">DATA CATALOG</data>
      <data key="d6">Glue</data>
      <data key="d7">Central metadata store holding schema information, table names, and column types.</data>
    </node>
    <node id="4">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive serverless query engine used by data scientists to explore raw JSON and historical Parquet data.</data>
    </node>
    <node id="5">
      <data key="d5">CRAWLER (Parquet)</data>
      <data key="d6">Glue</data>
      <data key="d7">Crawls processed Parquet files in S3 and registers partition and schema updates in the Data Catalog.</data>
    </node>
    <node id="6">
      <data key="d5">S3 (Parquet)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores transformed Parquet columnar files for efficient full history querying.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Glue JSON Crawler inspects incoming raw JSON files in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue ETL job reads newly arrived JSON data from S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Glue JSON Crawler writes discovered JSON table metadata and schemas to the Data Catalog.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue ETL job transforms JSON data into Parquet format and writes it to the Parquet S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Athena retrieves table definitions and schemas from the Data Catalog.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Athena queries optimized Parquet datasets directly in S3 for fast, cost-effective historical analysis.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue Parquet Crawler stores updated Parquet schema and partition information in Data Catalog.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue Parquet Crawler scans newly created Parquet files in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">iRobot Serverless Data Lake Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=GoziWpmFCS0</data>
    <data key="d2">Serverless data lake architecture processing ~3 TB/day of incoming JSON records into Parquet format for cost-effective querying with Athena.</data>
    <data key="d3">Data Lake, Serverless, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
