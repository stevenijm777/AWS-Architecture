  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile app user issuing requests to the banking platform.</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer segregating administration and service traffic.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 (API Management)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances hosting the API management layer.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 (Kubernetes)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances hosting the Kubernetes cluster running microservices.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (MongoDB)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances running MongoDB document database.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS PostgreSQL relational database.</data>
    </node>
    <node id="6">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Amazon ElastiCache in-memory caching service.</data>
    </node>
    <node id="7">
      <data key="d5">Core Banking System</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises or client core banking system connected via secure mTLS.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User sends API request from mobile app to ELB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards traffic to API Management EC2 instances.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API Management forwards request to Kubernetes cluster on EC2.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Kubernetes microservices query or store document data in MongoDB on EC2.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Kubernetes microservices query or store relational data in RDS PostgreSQL.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Kubernetes microservices read/write cache in ElastiCache.</data>
      <data key="d10">3''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Kubernetes microservices consume Core Banking System APIs over mTLS.</data>
      <data key="d10">3'''</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Sopra Banking DXP Microservices Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=GxjMSvwcgvw</data>
    <data key="d2">Sopra Banking's DXP digital platform exposes core banking APIs through a microservices architecture hosted on Kubernetes (EC2), backed by MongoDB (EC2), RDS PostgreSQL, and ElastiCache, with secure mTLS integration to external Core Banking Systems.</data>
    <data key="d3">Banking, Microservices, Kubernetes</data>
    <data key="d4">True</data>
  </graph>
</graphml>
