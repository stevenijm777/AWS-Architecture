<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">INTERNET GW</data>
      <data key="d6">VPC</data>
      <data key="d7">Located in external accounts (EXT) to manage inbound/outbound internet traffic.</data>
    </node>
    <node id="1">
      <data key="d5">S3 / SQS / SNS</data>
      <data key="d6">S3</data>
      <data key="d7">AWS managed services enabling controlled, unidirectional data acquisition from internet-facing accounts to internal accounts.</data>
    </node>
    <node id="2">
      <data key="d5">VPC ENDPOINTS</data>
      <data key="d6">VPC</data>
      <data key="d7">Located in internal accounts (INT) to consume data securely from AWS managed services.</data>
    </node>
    <node id="3">
      <data key="d5">TRANSIT GW</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Central network hub interconnecting internal account VPCs and hybrid connections.</data>
    </node>
    <node id="4">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">Encrypted VPN connection linking Transit Gateway to the corporate data center.</data>
    </node>
    <node id="5">
      <data key="d5">ROUTER</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Corporate network router in the on-premises data center.</data>
    </node>
    <node id="6">
      <data key="d5">ORGANIZATIONS</data>
      <data key="d6">Organizations</data>
      <data key="d7">AWS Organizations managing multi-account hierarchy and central policy deployment.</data>
    </node>
    <node id="7">
      <data key="d5">SCPs</data>
      <data key="d6">Organizations</data>
      <data key="d7">Service Control Policies restricting regions, services, and security guardrails across accounts.</data>
    </node>
    <node id="8">
      <data key="d5">CONFIG</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">AWS Config rules deployed centrally across all accounts to enforce compliance (e.g., requiring Lambda inside VPC).</data>
    </node>
    <node id="9">
      <data key="d5">GUARDDUTY</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Threat detection service monitoring AWS account activity and network behavior.</data>
    </node>
    <node id="10">
      <data key="d5">SECURITY HUB</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Central security findings aggregator collecting compliance alerts and anomalies for response.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Internet traffic is received by external accounts and passed into managed services.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Unidirectional data transfer from S3/SQS/SNS into VPC Endpoints within internal accounts.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Internal VPC traffic routes through Transit Gateway.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Transit Gateway routes traffic through the IPsec VPN connection.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">VPN tunnel connects to the corporate router in the on-premises data center.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Organizations manages and applies SCP policies across organization units.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Organizations deploys AWS Config compliance rules across all member accounts.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Config forwards rule compliance assessments to Security Hub.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">GuardDuty forwards threat detections to Security Hub.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Banque Pictet AWS Multi-Account Network and Governance Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=H0uHctrx82Q</data>
    <data key="d2">Architecture features multi-account isolation (EXT vs INT), controlled unidirectional ingestion via S3/SQS/SNS, hybrid connectivity via Transit Gateway and VPN, centralized policy enforcement via SCPs and Config, and consolidated security monitoring via Security Hub.</data>
    <data key="d3">Security, Governance, Networking, Hybrid Cloud</data>
    <data key="d4">True</data>
  </graph>
</graphml>
