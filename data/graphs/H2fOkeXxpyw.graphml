<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CLI</data>
      <data key="d6">UserConsumerDeveloper</data>
      <data key="d7">Command-line interface used by developers to deploy JavaScript/TypeScript code.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 (Deployment Ingestion)</data>
      <data key="d6">EC2</data>
      <data key="d7">Ingestion web service hosted on EC2 behind an ALB to scale and ingest customer deployment requests.</data>
    </node>
    <node id="2">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database used to track deployment progress and status.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue used to buffer deployment requests and prevent Lambda control plane rate limits.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (Deployment Worker)</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker service on EC2 that polls SQS deployment jobs and provisions customer Lambda functions.</data>
    </node>
    <node id="5">
      <data key="d5">Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-user browser client making application requests and invoking custom code.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 (Internal Invocation Service)</data>
      <data key="d6">EC2</data>
      <data key="d7">Internal EC2 service handling security authentication, permission checks, parameter passing, and invoking Lambda.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Customer Lambda function running across account boundary using V8 isolates per request for tenant isolation.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CLI deploys customer code to the EC2 deployment ingestion web service.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Deployment ingestion service updates deployment status in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Deployment ingestion service puts deployment tasks on SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Deployment worker polls deployment requests from SQS.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Deployment worker creates/provisions Lambda function across account boundary line.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Browser invokes application action directed to internal invocation service.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Invocation service verifies permissions and triggers customer Lambda function across account boundary.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Atlassian Forge Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=H2fOkeXxpyw</data>
    <data key="d2">Atlassian Forge uses multi-tenant Lambda infrastructure separated by account boundaries and V8 isolates per request to ensure customer code security and isolate compute execution.</data>
    <data key="d3">Compute, Serverless, Application Integration, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
