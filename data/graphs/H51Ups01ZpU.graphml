  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">BUTTON</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">AT&amp;T LTE-M physical button device running Linux OS with built-in cellular module</data>
