    <node id="5">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Simple Notification Service for SMS/notifications</data>
    </node>
    <node id="6">
      <data key="d5">SES</data>
      <data key="d6">SES</data>
      <data key="d7">Simple Email Service for automated email dispatch</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Button press sends signal to AT&amp;T LTE-M network</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Transmits request securely via TLS and X.509 certificate authentication</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">1-Click triggers customer-specific Lambda function</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
