  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Security DevOps Team</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Initiates onboarding by pushing mapping configuration files and receives workflow completion notifications.</data>
    </node>
    <node id="1">
      <data key="d5">Git</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Version control repository hosting mapping JSON configuration and running deployment workflows.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Artifacts Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded mapping configuration artifacts to trigger onboarding state machine.</data>
    </node>
    <node id="3">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates tenant onboarding by configuring IAM roles, invoking Lambda, and triggering notifications.</data>
    </node>
    <node id="4">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes notification upon successful virtual tenant onboarding.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes logic to establish and configure the virtual tenant inside Thales KMS.</data>
    </node>
    <node id="6">
      <data key="d5">Thales On-Premises KMS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises HSM/KMS holding master keys (CMK) and running virtual tenant wrappers.</data>
    </node>
    <node id="7">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Role assumed by Thales to execute key management operations across target AWS accounts.</data>
    </node>
    <node id="8">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">AWS KMS holding virtual wrapper keys (master key and data key combined) for service encryption.</data>
    </node>
    <node id="9">
      <data key="d5">S3 Data Storage</data>
      <data key="d6">S3</data>
      <data key="d7">Stores application data encrypted using KMS Data Encryption Keys.</data>
    </node>
    <node id="10">
      <data key="d5">EBS</data>
      <data key="d6">EBS</data>
      <data key="d7">Stores block volumes encrypted using KMS Data Encryption Keys.</data>
    </node>
    <node id="11">
      <data key="d5">Product DevOps Team</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Generates 256-bit symmetric encryption keys on Thales and manages key lifecycle/revocation.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Security DevOps Team pushes mappings.json into Git repository.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Git Action uploads mapping artifact into S3 Artifacts Bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Artifact upload in S3 triggers Step Functions onboarding state machine.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions provisions IAM roles in target AWS accounts.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions triggers Lambda execution for tenant creation.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions triggers SNS notification upon successful onboarding completion.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS notifies Security DevOps Team that team is onboarded.</data>
      <data key="d10">7</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda creates virtual tenant wrapper in Thales On-Premises KMS.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Thales On-Premises KMS assumes IAM role to operate in AWS.</data>
      <data key="d10">8</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Thales KMS syncs/imports key into AWS KMS as customer managed key wrapper.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS KMS uses Data Encryption Key (DEK) to encrypt S3 Data Storage bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS KMS uses Data Encryption Key (DEK) to encrypt EBS storage volumes.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Product DevOps Team generates 256-bit symmetric master key on Thales KMS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">RBI On-Premises Thales KMS Integration with AWS KMS</data>
    <data key="d1">https://www.youtube.com/watch?v=H_S7CxtHgSM</data>
    <data key="d2">Hybrid key management architecture enabling on-premises control over encryption keys used across AWS services.</data>
    <data key="d3">Security, Governance, Storage</data>
    <data key="d4">True</data>
