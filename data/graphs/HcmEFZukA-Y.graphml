<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Device</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Customer mobile application used for wallet transactions and phone number verification.</data>
    </node>
    <node id="1">
      <data key="d5">POS</data>
      <data key="d6">UserConsumerPOS</data>
      <data key="d7">In-store Point of Sale terminal where cashiers scan barcodes and load balance.</data>
    </node>
    <node id="2">
      <data key="d5">Digital Ledger</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External legacy closed-loop gift card system digitized into the wallet backend.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for mobile app API calls and webhooks from external ledger.</data>
    </node>
    <node id="4">
      <data key="d5">Pinpoint</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">AWS service used to verify phone numbers for fraud prevention.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue buffering state changes and updates originating from the Digital Ledger.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Compute functions handling business logic, ledger sync, balance adjustments, and database updates.</data>
    </node>
    <node id="7">
      <data key="d5">Atlas MongoDB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Document database storing real-time customer wallet and profile state.</data>
    </node>
    <node id="8">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Event bus emitting customer interaction events to downstream loyalty ecosystem.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile app sends phone verification request to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="1">
      <data key="d8">3</data>
      <data key="d9">Mobile device initiates wallet operation (e.g. delivery order) via API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">POS sends load request directly to external Digital Ledger during barcode scan.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Digital Ledger sends state change notification to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway uses Pinpoint to verify phone number for fraud control.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway queues state change message in SQS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">API Gateway triggers Lambda function to execute transaction logic.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS triggers Lambda function to consume ledger updates.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda writes updated balance/state into MongoDB Atlas.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="1">
      <data key="d8">3</data>
      <data key="d9">Lambda updates customer wallet document in MongoDB Atlas.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls Digital Ledger API to add/deduct balances.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda publishes customer interaction events to EventBridge.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">7-Eleven Digital Wallet Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=HcmEFZukA-Y</data>
    <data key="d2">7-Eleven digital wallet architecture integrating physical POS, legacy closed-loop digital ledger, AWS serverless services, MongoDB Atlas, and EventBridge for customer notifications and loyalty.</data>
    <data key="d3">Retail Digital Wallet Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
