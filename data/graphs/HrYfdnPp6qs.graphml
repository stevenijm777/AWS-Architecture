<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Business Users</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Includes Product, Marketing, and Sales team members querying business and usage insights.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores around 3TB of daily incoming raw data from Salesforce, HubSpot, and product metrics.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Serves the static web frontend for ADA.</data>
    </node>
    <node id="3">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user authentication using enterprise identity without giving direct AWS console access.</data>
    </node>
    <node id="4">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Executes on-demand queries and transforms data for business users.</data>
    </node>
    <node id="5">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Cleans up, extracts, documents, and catalogs incoming data in the ingestion pipeline.</data>
    </node>
    <node id="6">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Strips out PII from data to ensure SOC 2 Type 2 compliance.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Business users access the web frontend via CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingests raw data into Glue for ETL and cataloging.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Routes user requests to Cognito for enterprise identity authentication.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Authenticated web requests trigger on-demand Athena queries.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Passes cataloged data to Comprehend for PII removal.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Stax AWS Automated Data Analytics (ADA) Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=HrYfdnPp6qs</data>
    <data key="d2">Data analytics solution built on the AWS Automated Data Analytics (ADA) implementation. Processes around 3TB of data daily from CRM, marketing, and product metrics.</data>
    <data key="d3">Analytics, Data Ingestion, Security &amp; Compliance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
