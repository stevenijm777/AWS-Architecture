<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer EC2 (Agent)</data>
      <data key="d6">EC2</data>
      <data key="d7">Customer EC2 instance with installed ThreatStack proprietary agent sending host security telemetry.</data>
    </node>
    <node id="1">
      <data key="d5">Customer CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">CloudTrail service in customer VPC streaming API events to ThreatStack.</data>
    </node>
    <node id="2">
      <data key="d5">Kafka</data>
      <data key="d6">MSK</data>
      <data key="d7">Apache Kafka ingestion broker receiving, validating, and normalizing normalized stream telemetry.</data>
    </node>
    <node id="3">
      <data key="d5">Apache Flink</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Apache Flink cluster doing near real-time stream routing and processing.</data>
    </node>
    <node id="4">
      <data key="d5">S3 (Near Real Time)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket receiving GZIP JSON formatted logs for fast lookup and customer syncing.</data>
    </node>
    <node id="5">
      <data key="d5">EMR (Ingestion)</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR cluster ingesting long-term data from Kafka for 30-day warehousing.</data>
    </node>
    <node id="6">
      <data key="d5">S3 (Parquet)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 data warehouse storing structured telemetry in Apache Parquet format.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 (Orchestration)</data>
      <data key="d6">EC2</data>
      <data key="d7">Orchestration service running on EC2 that spins up security-blessed EMR clusters and submits JAR/Spark jobs.</data>
    </node>
    <node id="8">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Amazon Athena querying Parquet data in S3 for SQL-based threat investigation.</data>
    </node>
    <node id="9">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Amazon SageMaker running machine learning models for anomaly detection and trend analysis on Parquet data.</data>
    </node>
    <node id="10">
      <data key="d5">EMR (Analytics)</data>
      <data key="d6">EMR</data>
      <data key="d7">Consumption-side EMR cluster performing MapReduce jobs and generating customer report analytics.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ThreatStack agent sends telemetry across customer VPC boundary to Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudTrail events streamed to Kafka via STS role access.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka feeds normalized event stream into Apache Flink cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Kafka streams long-term telemetry data directly to EMR Ingestion cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Flink streams GZIP JSON formatted logs into near real-time S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR Ingestion cluster writes processed data in Apache Parquet format to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Athena queries Parquet data stored in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">SageMaker accesses Parquet dataset in S3 for ML trend analysis and anomaly detection.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">EMR Analytics cluster reads Parquet data from S3 for report generation.</data>
      <data key="d10">1''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Orchestration EC2 instance provisions and configures EMR Ingestion cluster.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Orchestration EC2 instance submits JAR/Spark jobs to EMR Analytics cluster.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">ThreatStack Telemetry Ingestion and Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=INog0_9tCtY</data>
    <data key="d2">Architectural breakdown of ThreatStack processing 60 billion events per day using dual path processing (near real-time GZIP JSON via Flink and 30-day Parquet warehousing via EMR) consumed by Athena, SageMaker, and EMR.</data>
    <data key="d3">Data Pipeline, Analytics, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
