<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Uses weighted routing policy (100% active, 0% standby) for high-level traffic control and failover.</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Balances incoming web application traffic across ECS containers and EC2 instances.</data>
    </node>
    <node id="2">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs containerized auxiliary application microservices.</data>
    </node>
    <node id="3">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores container images and automatically replicates them to the secondary region.</data>
    </node>
    <node id="4">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts the core NASDAQ matching engine system.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database supporting core and auxiliary exchange operations.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Uses native Global Tables feature for automatic multi-region synchronization.</data>
    </node>
    <node id="7">
      <data key="d5">2nd Region</data>
      <data key="d6">VPC</data>
      <data key="d7">Secondary AWS region designated as standby disaster recovery environment.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Directs 100% of primary active production traffic to ALB.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes 0% traffic under normal operation; receives 100% upon failover.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Forwards application web requests to ECS container tasks.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Forwards core exchange requests to EC2 instances.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Pulls container images from ECR.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Reads and writes auxiliary application data to RDS.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Replicates ECR container image repositories across regions.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Replicates EC2 volume state to secondary region using AWS Data Lifecycle Manager snapshots.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Synchronizes database updates via RDS cross-region read replica.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Astana International Exchange Multi-Region Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=IP03SkGbP-U</data>
    <data key="d2">Fully cloud-operated stock exchange architecture featuring active-passive multi-region failover and cross-region state replication.</data>
    <data key="d3">Financial Services, High Availability, Disaster Recovery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
