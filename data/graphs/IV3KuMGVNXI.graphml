<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Agent</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Deep Instinct client agents running on user devices, issuing signed requests.</data>
    </node>
    <node id="1">
      <data key="d5">Viewer Request</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Lambda@Edge function triggered on incoming CloudFront viewer requests.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Amazon CloudFront distribution serving requests and running edge functions.</data>
    </node>
    <node id="3">
      <data key="d5">Origin Response</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Lambda@Edge function triggered on responses from origin to manipulate returned update files.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB (Top)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores real-time usage statistics.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB (Middle)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores agent request counts and tracking state for rolling rollouts.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Origin bucket hosting agent update files.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Agent sends GET requests with unique identifier headers to CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Viewer Request Lambda writes real-time statistics directly to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Viewer Request Lambda logs agent request count and state to DynamoDB.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront passes request to the S3 bucket origin.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Origin Response Lambda reads agent state from DynamoDB to determine whether to modify the update response.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 returns requested file payload to CloudFront.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Deep Instinct Real-time Analytics and Control with Lambda at Edge</data>
    <data key="d1">https://www.youtube.com/watch?v=IV3KuMGVNXI</data>
    <data key="d2">Architecture uses CloudFront and Lambda@Edge to handle millions of agent GET requests, logging statistics and managing rolling upgrades using DynamoDB.</data>
    <data key="d3">CDN, Security, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
