<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2 (NEO4J)</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts Neo4j containing the core domain knowledge graph/corpus.</data>
    </node>
    <node id="1">
      <data key="d5">DATALAKE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data lake containing streaming numbers, analytical metrics, and social metrics.</data>
    </node>
    <node id="2">
      <data key="d5">FARGATE (Top)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Hosts microservices dealing with entity changes (e.g., album name or release date modifications).</data>
    </node>
    <node id="3">
      <data key="d5">MSK</data>
      <data key="d6">MSK</data>
      <data key="d7">Central Amazon Managed Streaming for Apache Kafka cluster acting as the core message bus.</data>
    </node>
    <node id="4">
      <data key="d5">FARGATE (Sync)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs the open-source Elasticsearch sink connector that consumes origin topics from MSK and joins them on the fly.</data>
    </node>
    <node id="5">
      <data key="d5">OPENSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">OpenSearch cluster providing quick search, boosting, and relevance ranking based on social and consumption metrics.</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless function reading from MSK topics to notify stakeholders when entity changes occur.</data>
    </node>
    <node id="7">
      <data key="d5">HTTP SINK / CRM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External CRM updated via open-source HTTP Sink connector when release dates or album info change.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Streams plugin sends real-time database changes directly from Neo4j on EC2 into MSK topics.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 Kafka connector pushes streaming metrics and social data into MSK.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Microservices on Fargate push business entity change events (e.g. release date change) to MSK.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">MSK streams origin topics to the Elasticsearch sink connector on Fargate.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda reads from specific MSK topics to trigger stakeholder email notifications.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">HTTP Sink connector routes event updates from MSK to external marketing CRM.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Sink connector joins topics on the fly and indexes joined documents directly into OpenSearch.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Sony Music The Orchard Kafka Data Highway Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ItpY_KKR94k</data>
    <data key="d2">Central MSK (Kafka Data Highway) connects data sources (Neo4j, Data Lake, Fargate microservices) with target consumers (OpenSearch via Fargate connector, Lambda notifications, external CRM via HTTP sink connector).</data>
    <data key="d3">Real-time Streaming, Search &amp; Indexing, Event-Driven Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
