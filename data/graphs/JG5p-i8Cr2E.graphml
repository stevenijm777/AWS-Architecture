  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Data engineers, analysts, and data scientists interacting with the self-service portal.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 (Portal)</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts the web interface for selecting pipeline types and entering chargeback codes.</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Central Amazon EKS cluster running 100+ microservices, crawlers, and automation workers.</data>
    </node>
    <node id="3">
      <data key="d5">POSTGRESQL</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores request records, metadata, and status logs.</data>
    </node>
    <node id="4">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds infrastructure provisioning and data access workflow event messages.</data>
    </node>
    <node id="5">
      <data key="d5">SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends approval requests and status notifications to data owners and requesters.</data>
    </node>
    <node id="6">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Manages AWS identity policies integrated with Apache Ranger for fine-grained access control.</data>
    </node>
    <node id="7">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Provisioned EMR clusters for batch big data processing.</data>
    </node>
    <node id="8">
      <data key="d5">GLUE CATALOG</data>
      <data key="d6">Glue</data>
      <data key="d7">Stores metadata databases, schemas, and dataset access definitions.</data>
    </node>
    <node id="9">
      <data key="d5">EC2 (Provisioned)</data>
      <data key="d6">EC2</data>
      <data key="d7">Target compute provisioned with containerized Apache Airflow or NiFi for data pipelines.</data>
    </node>
    <node id="10">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Enterprise data lake storage buckets containing raw and processed datasets.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User submits infrastructure or data access request via web portal.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
