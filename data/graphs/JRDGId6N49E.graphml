<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Used to share standardized infrastructure templates and ML software packages across teams and partner entities like TRI Silicon Valley.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Automates the provisioning of secondary compute clusters in Region 2 when Region 1 capacity limits are reached.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 Placement Group</data>
      <data key="d6">EC2</data>
      <data key="d7">P3 instances utilizing NVIDIA V100 GPUs deployed in a low-latency placement group in Region 1 for deep learning training.</data>
    </node>
    <node id="3">
      <data key="d5">FSx for Lustre</data>
      <data key="d6">FSX</data>
      <data key="d7">High-performance POSIX file system linked directly to compute nodes to support high-throughput ML data ingestion.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Region 1</data>
      <data key="d6">S3</data>
      <data key="d7">Primary object storage bucket in Region 1 storing training datasets.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Region 2</data>
      <data key="d6">S3</data>
      <data key="d7">Secondary target S3 bucket in Region 2 synchronized via cross-region replication.</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFormation orchestrates and spins up additional compute clusters in Region 2 upon demand.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 placement group requests and streams datasets to/from FSx for Lustre.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">FSx for Lustre supplies high-speed file storage input directly to training nodes.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Cross-region S3 replication automatically copies training data from Region 1 to Region 2.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">TRI Machine Learning Training Cluster Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=JRDGId6N49E</data>
    <data key="d2">TRID utilizes EC2 P3 placement groups with NVIDIA V100 GPUs and FSx for Lustre for object recognition ML training, with S3 cross-region replication and CloudFormation for multi-region scalability.</data>
    <data key="d3">Machine Learning, Multi-Region Architecture, High Performance Computing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
