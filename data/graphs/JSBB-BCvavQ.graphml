  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ON-PREMISE</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Legacy on-premises data center infrastructure.</data>
    </node>
    <node id="1">
      <data key="d5">APPS</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises application workloads.</data>
    </node>
    <node id="2">
      <data key="d5">DB</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Proprietary on-premises relational database.</data>
    </node>
    <node id="3">
      <data key="d5">ROUTER</data>
      <data key="d6">Route53</data>
      <data key="d7">Router performing weighted traffic shifting between on-premises and AWS.</data>
    </node>
    <node id="4">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon Elastic Kubernetes Service for containerized microservices.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda for serverless function execution.</data>
    </node>
    <node id="6">
      <data key="d5">BEANSTALK</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">AWS Elastic Beanstalk for rapid re-platforming of complex applications.</data>
    </node>
    <node id="7">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">AWS Database Migration Service for database replication.</data>
    </node>
    <node id="8">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Amazon Aurora database target for infinite scalability and open source compatibility.</data>
    </node>
    <node id="9">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Self-hosted database on Amazon EC2 via lift-and-shift.</data>
    </node>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises application traffic routed to central router.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Re-architecting migration path from on-prem APPS to EKS.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">On-premises database replication to DMS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Lift-and-shift migration from on-prem DB to EC2.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Weighted traffic portion directed back to on-premises DC.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Weighted traffic shifted to Amazon EKS.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Weighted traffic shifted to AWS Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Elastic Beanstalk connected with routing mechanism.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Planned future migration path from Beanstalk to Lambda/EKS.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">DMS migrates data into Amazon Aurora.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 hosted database serving Elastic Beanstalk applications.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Talabat Cloud Migration and Application Modernization Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=JSBB-BCvavQ</data>
    <data key="d2">Talabat serves over 500,000 orders per day across the MENA region. The architecture demonstrates a dual-track migration path: re-architecting applications to Amazon EKS and AWS Lambda, alongside re-platforming to AWS Elastic Beanstalk with Amazon EC2 hosted databases for speed during peak periods like COVID-19.</data>
    <data key="d3">Migration, Modernization, Serverless, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
