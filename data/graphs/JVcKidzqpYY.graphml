<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Source DB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External/on-premises source databases containing raw shipment and address data.</data>
    </node>
    <node id="1">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Ingestion and ETL service moving data into Redshift, S3, and DynamoDB.</data>
    </node>
    <node id="2">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse storing 3 months of historical data for exploration, profiling, cleansing, and training.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized data lake storing large volumes of historical address datasets accessed via Redshift Spectrum.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores reference data for rapid lookup and model optimization tests.</data>
    </node>
    <node id="5">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Builds, trains, and deploys machine learning models for address geocoding and coordinate prediction.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute function invoking SageMaker endpoints.</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API management layer exposing serverless geocoding services to driver applications.</data>
    </node>
    <node id="8">
      <data key="d5">Mobile App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Driver mobile app and front-end operating systems sending geocoding lookup requests.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue ingests raw operational and address data from Source DB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue moves processed analytics data into Redshift.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue loads address datasets into the S3 data lake.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue populates reference datasets into DynamoDB.</data>
      <data key="d10">1''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker fetches historical data from Redshift to train and build models.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift Spectrum queries address datasets stored in S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Feedback/optimization loop between SageMaker and Redshift during model training.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda invokes SageMaker endpoint to return accurate X/Y coordinates.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway triggers Lambda serverless execution.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Mobile app calls API Gateway for address geocoding predictions.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Aramex Address Geocoding Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=JVcKidzqpYY</data>
    <data key="d2">Aramex utilizes AWS Glue, Redshift, S3, and SageMaker to build an ML-powered address geocoding solution that improves driver productivity and package delivery success rate by predicting accurate X/Y coordinates.</data>
    <data key="d3">AI/ML, Analytics &amp; Data Lakes, Logistics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
