<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon S3 (Raw Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded raw trade data files in CSV or Excel formats.</data>
    </node>
    <node id="1">
      <data key="d5">AWS Lambda (Validation)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by raw data uploads to validate contents and highlight discrepancies.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon S3 (Validated Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores validated copies of data in a dedicated S3 location.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda (Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by validated data to process payloads and ingest into OpenSearch.</data>
    </node>
    <node id="4">
      <data key="d5">AWS OpenSearch (Data Ingestion)</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Ingests processed data; utilizes Graviton2 instances, query templates, index mapping, and aggregated reporting layers.</data>
    </node>
    <node id="5">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End users accessing export-import trade data via web browser or mobile app.</data>
    </node>
    <node id="6">
      <data key="d5">Front-End Application</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Angular-based web front-end application running in the user's browser.</data>
    </node>
    <node id="7">
      <data key="d5">Back-End Application</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Python-based back-end application servicing business logic and data layer access.</data>
    </node>
    <node id="8">
      <data key="d5">AWS OpenSearch (Data Retrieval)</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">OpenSearch cluster running on Graviton2 instances providing 2-4 second response times across ~5B records.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database providing relational data querying capabilities to the back-end.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon S3 (Data Retrieval)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores large generated reports (over 10,000 records) accessible via pre-signed URLs.</data>
    </node>
    <node id="11">
      <data key="d5">Amazon SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends email intimations containing pre-signed URLs to users for downloading large reports.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw data upload triggers validation Lambda function.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Validation Lambda writes validated copy of data into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Validated data upload triggers processing Lambda function.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Processing Lambda ingests processed data into OpenSearch cluster.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">User sends web request to Angular front-end application.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Web browser forwards application request to Python back-end application.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="1">
      <data key="d8">2</data>
      <data key="d9">Mobile application sends direct requests to Python back-end application.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Front-end application returns response to user browser.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Back-end queries OpenSearch search indexes.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Back-end queries relational database layer in Amazon RDS.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Back-end uploads large reports (&gt;10,000 records) to S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Back-end application sends query results back to user.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">SES delivers email intimation with pre-signed URL for S3 report download.</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Trade Data Processing and Retrieval Architecture with AWS OpenSearch</data>
    <data key="d1">https://www.youtube.com/watch?v=JYeXbUdFOdw</data>
    <data key="d2">Data processing and retrieval architecture built for Cybex/Cybage to handle ~5 billion records. Features an event-driven ingestion pipeline (S3, Lambda, OpenSearch on Graviton2) and dual retrieval paths via web (Angular FE) and mobile/API (Python BE) querying OpenSearch, RDS, S3, and SES for report notifications.</data>
    <data key="d3">Data Processing, Search &amp; Analytics, Event-Driven Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
