<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">BIT BUCKET</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Version control repository containing infrastructure code and PRs.</data>
    </node>
    <node id="1">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives webhook triggers from Bitbucket repository changes.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Zips input artifacts required by CodeBuild.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores initial zipped source artifacts.</data>
    </node>
    <node id="4">
      <data key="d5">CODEBUILD</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Downloads S3 contents, calculates checksums to detect changes, and isolates changed files.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores only modified files to prevent unnecessary pipeline execution.</data>
    </node>
    <node id="6">
      <data key="d5">CODEPIPELINE</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Orchestrates deployment stages and optional manual review steps.</data>
    </node>
    <node id="7">
      <data key="d5">CLOUDFORMATION</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Applies change sets to update infrastructure stacks across environments.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Bitbucket sends webhook event to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Direct event trigger or code metadata transfer to Lambda.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Lambda execution.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda uploads zipped code artifact to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Object creation in S3 triggers CodeBuild.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CodeBuild uploads detected changed files to second S3 bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Updated files in S3 trigger CodePipeline.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">CodePipeline executes CloudFormation change sets on infrastructure stacks.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">CleverTap Automated Infrastructure Deployment Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=JcHSFIZMYHc</data>
    <data key="d2">Automated cross-region infrastructure deployment pipeline ensuring 100% read-only access to AWS console.</data>
    <data key="d3">DevOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
