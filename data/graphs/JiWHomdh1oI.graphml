<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Source</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External database (e.g., MySQL, Postgres, SaaS apps) located outside customer VPC.</data>
    </node>
    <node id="1">
      <data key="d5">Orchestration Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Central orchestration component that triggers data fetching schedules, responds to completion events, and coordinates data pipeline steps.</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Config and state store for orchestration, tracking batch progress, sync metrics, and schema changes.</data>
    </node>
    <node id="3">
      <data key="d5">Connector Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless connector fetching data from source in parallel batches, saving metrics to DynamoDB, and staging raw files to S3.</data>
    </node>
    <node id="4">
      <data key="d5">Redshift Loader Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Redshift service Lambda that executes DDL schema updates and COPY commands into Redshift.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Staging bucket for raw data extracted from data sources before loading into Redshift.</data>
    </node>
    <node id="6">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Target data warehouse for data analytics.</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestration Lambda uses DynamoDB as a config and state store.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestration Lambda triggers Connector Lambda every 5 minutes.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Orchestration Lambda triggers Redshift Loader Lambda for the next step.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Connector Lambda extracts raw data from external Data Source in parallel batches.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Connector Lambda updates progress state and sync metrics into DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Connector Lambda stages fetched raw data into S3 bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Connector Lambda notifies Orchestration Lambda upon successful sync.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift Loader Lambda checks and updates schema/state in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift Loader Lambda sends DDL schema modifications and COPY commands to Redshift.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift loads raw staged data directly from S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DataCoral Serverless Data Pipeline Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=JiWHomdh1oI</data>
    <data key="d2">Serverless data engineering platform architecture deployed within customer VPC to extract data from various sources into Redshift using AWS Lambda, S3, DynamoDB, and Redshift.</data>
    <data key="d3">Data Pipeline, Serverless, Data Warehouse</data>
    <data key="d4">True</data>
  </graph>
</graphml>
