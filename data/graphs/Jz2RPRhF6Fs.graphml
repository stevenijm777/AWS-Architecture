<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Web applications and mobile clients sending API requests.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN edge distribution routing client requests.</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA @EDGE</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Lambda@Edge performing dynamic traffic shifting between legacy gateway and AWS API Gateway.</data>
    </node>
    <node id="3">
      <data key="d5">API</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Legacy API Gateway relying on XML configuration.</data>
    </node>
    <node id="4">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Amazon API Gateway using OpenAPI standard.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Custom authorizer Lambda verifying JWT tokens and comparing scopes.</data>
    </node>
    <node id="6">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Externalized scope configuration store.</data>
    </node>
    <node id="7">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancing routing traffic to Nginx proxy.</data>
    </node>
    <node id="8">
      <data key="d5">NGINX</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Nginx reverse proxy executing mutual TLS termination and client certificate verification.</data>
    </node>
    <node id="9">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Private Application Load Balancer fronting backend container services to protect PHI data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Clients send API requests with authorization headers to CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront triggers Lambda@Edge function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda@Edge routes portion of traffic to legacy API gateway.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda@Edge routes portion of traffic to Amazon API Gateway.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes custom Lambda authorizer.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Authorized requests pass from API Gateway towards backend.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Custom authorizer checks scopes in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">ELB forwards traffic to Nginx proxy.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Nginx verifies client certificates (mTLS) and forwards to private ALB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Accolade Serverless API Gateway Migration Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Jz2RPRhF6Fs</data>
    <data key="d2">Architecture demonstrating traffic shifting between a legacy API gateway and Amazon API Gateway using CloudFront and Lambda@Edge, custom token authorization with DynamoDB scope externalization, and mTLS via Nginx to an internal ALB.</data>
    <data key="d3">Migration, Security, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
