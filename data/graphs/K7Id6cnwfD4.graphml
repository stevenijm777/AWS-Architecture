<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Pharmacy Management System</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Hosts embedded Hyphen Pharmacy Assistant app</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles authentication and authorization for embedded app</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Elastic Kubernetes Service (EKS)</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs microservices horizontally scaled across compute nodes</data>
    </node>
    <node id="3">
      <data key="d5">Amazon MemoryDB for Redis</data>
      <data key="d6">MemoryDB</data>
      <data key="d7">In-memory database providing sub-80-100ms latency data access</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Managed Streaming for Apache Kafka (MSK)</data>
      <data key="d6">MSK</data>
      <data key="d7">Central event bus for real-time data streaming and internal event emission</data>
    </node>
    <node id="5">
      <data key="d5">Payers</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Healthcare payers streaming real-time member data</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational analytical store persisting events for reporting</data>
    </node>
    <node id="7">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Powers real-time dashboards for healthcare payers</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Pharmacy app initiates authentication request</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="1">
      <data key="d8">0</data>
      <data key="d9">Sends ALERT request to check actionable patient events</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="2">
      <data key="d8">0</data>
      <data key="d9">Launches UI with patient data</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Authenticates user/system via Cognito</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">FETCH data from MemoryDB for sub-100ms UI response</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Services constantly emit internal events to MSK</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS consumer listens to MSK topics and hydrates data into Redis</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Stream analytical data events from MSK to Aurora</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Payers stream real-time healthcare data into MSK</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">QuickSight fetches Aurora data to render real-time dashboards for payers</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Hyphen Healthcare Collaboration Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=K7Id6cnwfD4</data>
    <data key="d2">Hyphen uses an event-driven architecture powered by MSK, EKS, and MemoryDB to provide real-time workflow integrations for pharmacists with 40-100ms latency.</data>
    <data key="d3">Healthcare Analytics &amp; Data Streaming</data>
    <data key="d4">True</data>
