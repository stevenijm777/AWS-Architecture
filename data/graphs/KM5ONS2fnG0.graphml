<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis Data Streams</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingests real-time streams generated by manufacturing machines.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams raw incoming data directly into S3 for archival and batch processing.</data>
    </node>
    <node id="2">
      <data key="d5">Processing Stage Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Daisy-chained processing stages: Parse, Enrich with reference data, Normalize data model.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores intermediate state between stages; DynamoDB Streams trigger subsequent stages and auxiliary Lambdas.</data>
    </node>
    <node id="4">
      <data key="d5">Auxiliary Lambdas</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by DynamoDB Streams to persist processed data to Aurora, Elasticsearch, and S3.</data>
    </node>
    <node id="5">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Aurora Serverless used for SQL users and reporting via Data API.</data>
    </node>
    <node id="6">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Provides real-time dashboards for tracking part positions across manufacturing lifecycle.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake store for bulk raw and processed data.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Scheduled bulk processing jobs running on 6-hourly to daily interval over S3 data.</data>
    </node>
    <node id="9">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Enables ad-hoc SQL queries on top of data stored in S3.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis streams real-time data to the processing unit Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis Firehose streams raw data straight to S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Processing Lambda saves parsed/enriched stage data to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB Streams trigger auxiliary Lambdas for persistence to downstream stores.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Auxiliary Lambdas write data into Aurora Serverless via Data API.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Auxiliary Lambdas persist data into Elasticsearch for real-time dashboards.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Auxiliary Lambdas persist processed data into S3 storage.</data>
      <data key="d10">3''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue scheduled batch ETL jobs process bulk data stored in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries data stored in S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">HP Real-Time Cartridge Manufacturing Data Pipeline Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=KM5ONS2fnG0</data>
    <data key="d2">Real-time streaming pipeline processing ink cartridge manufacturing data, using Kinesis Data Streams, multi-stage Lambda processing, DynamoDB streams, Aurora Serverless, Elasticsearch, S3, Glue, and Athena.</data>
    <data key="d3">Data Analytics &amp; Streaming Pipeline</data>
    <data key="d4">True</data>
  </graph>
</graphml>
