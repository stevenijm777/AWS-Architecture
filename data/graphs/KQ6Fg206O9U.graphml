  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End-user devices requesting ticket bookings.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Content delivery network serving as primary entry point.</data>
    </node>
    <node id="2">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF for protecting against common web exploits.</data>
    </node>
    <node id="3">
      <data key="d5">PATTERN MATCH</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda@Edge running custom business logic to identify bot patterns.</data>
    </node>
    <node id="4">
      <data key="d5">KINESIS</data>
      <data key="d6">Firehose</data>
      <data key="d7">Kinesis Data Firehose streaming logs to storage.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central S3 bucket used as a data lake for log storage.</data>
    </node>
    <node id="6">
      <data key="d5">INTERNET BOOKING SYSTEM</data>
      <data key="d6">EC2</data>
      <data key="d7">Backend booking system running on EC2 instances.</data>
    </node>
    <node id="7">
      <data key="d5">TRANSFORM</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function converting raw text logs into Parquet format.</data>
    </node>
    <node id="8">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query service analyzing Parquet logs in S3.</data>
    </node>
    <node id="9">
      <data key="d5">QUICKSIGHT</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Business intelligence dashboards to visualize traffic and bot patterns.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests arrive at CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront routes traffic through AWS WAF for web exploit checks.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront triggers Lambda@Edge pattern match function for custom bot validation.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF streams security logs to Kinesis Data Firehose.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Pattern match function streams log and bot match data to Kinesis Data Firehose.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Data Firehose delivers aggregated logs to S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 triggers Lambda transformation function when new log files land.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda function writes transformed Parquet files back to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries Parquet-formatted logs directly from S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena feeds query results to QuickSight dashboards.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Insights from QuickSight are manually fed back to update pattern matching logic in Lambda@Edge.</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Vietjet Bot Protection Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=KQ6Fg206O9U</data>
    <data key="d2">Architecture for bot mitigation and request analysis using CloudFront, AWS WAF, Lambda@Edge, Kinesis Firehose, S3 data lake, Athena, and QuickSight.</data>
    <data key="d3">Security, Analytics, Serverless</data>
    <data key="d4">True</data>
  </graph>
