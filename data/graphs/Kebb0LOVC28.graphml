<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Orchestrates build, QA deployment, manual approval, and production deployment.</data>
    </node>
    <node id="1">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives notification payload from CodePipeline approval step.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda (Notification)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes SNS payload and sends interactive message via webhook to Slack.</data>
    </node>
    <node id="3">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Displays interactive Yes/No message box for deployment approval.</data>
    </node>
    <node id="4">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes REST API endpoint triggered by user interactions in Slack.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Approval)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes approval logic and updates CodePipeline state to resume production deployment.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CodePipeline approval step sends notification event to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS topic invokes the notification Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Notification Lambda sends webhook message creating a Yes/No box in Slack.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Button action in Slack triggers API Gateway endpoint.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes approval Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Approval Lambda signals CodePipeline to proceed with production deployment.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">OpenFit ChatOps Continuous Deployment Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=Kebb0LOVC28</data>
    <data key="d2">Architecture showing automated deployment and Slack-integrated approval workflow using AWS CodePipeline, SNS, Lambda, API Gateway, and Slack.</data>
    <data key="d3">CI/CD, Serverless, ChatOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
