<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Focus Camera</data>
      <data key="d6">UserConsumerCamera</data>
      <data key="d7">Dedicated Hudl Focus hardware camera for automated video capture.</data>
    </node>
    <node id="1">
      <data key="d5">Mobile App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile app client used by coaches to upload video content.</data>
    </node>
    <node id="2">
      <data key="d5">Web Platform</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web interface client used to upload videos and trigger job queues.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw video uploads and transcoded playable video output within 2 minutes.</data>
    </node>
    <node id="4">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Multiple prioritized message queues handling up to 30,000 messages/minute based on user priority and job size.</data>
    </node>
    <node id="5">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects queue depth metrics used by Lambda for target tracking.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Evaluates SQS queue depth versus instance count and calculates target tracking ratio to trigger auto-scaling.</data>
    </node>
    <node id="7">
      <data key="d5">Spot Fleet</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Manages over 20 instance types across Spot Fleet, scaling up to 10,000+ instances during peak game nights.</data>
    </node>
    <node id="8">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker compute instances that process video transcoding tasks, reducing total compute costs by 28%.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Focus camera uploads raw video directly to S3.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile app uploads raw coaching video directly to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Web platform uploads raw coaching video directly to S3.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Initiates upload and sends transcoding job message to prioritized SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS queue depth is monitored to determine pending job count.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 worker instances pull queued transcoding messages from SQS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch metrics are queried by Lambda to calculate ratio of messages to instances.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda invokes Spot Fleet Auto Scaling Group to scale instances in or out based on load ratio.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Transcoded video is written back into S3 bucket in playable format.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Hudl Sports Video Transcoding Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=KgRib8AM0fs</data>
    <data key="d2">Hudl ingests coaching videos via mobile, web, and hardware camera apps into S3 while sending messages to prioritized SQS queues. A custom Lambda scaling function queries CloudWatch metrics to dynamically adjust a Spot Fleet Auto Scaling group. EC2 worker instances transcode jobs from SQS and save the output back to S3 within 2 minutes.</data>
    <data key="d3">Media Processing &amp; Auto Scaling</data>
    <data key="d4">True</data>
  </graph>
</graphml>
