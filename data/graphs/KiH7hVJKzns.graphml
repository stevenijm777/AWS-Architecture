<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Devices</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Mobile and desktop interfaces for employees, managers, and practitioners.</data>
    </node>
    <node id="1">
      <data key="d5">API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API gateway layer receiving incoming client requests.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer cluster distributing traffic into the application cluster.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Main application cluster running hundreds of microservices, including the real-time continuous payroll engine.</data>
    </node>
    <node id="4">
      <data key="d5">STREAMING FOR KAFKA</data>
      <data key="d6">MSK</data>
      <data key="d7">Managed Streaming for Apache Kafka handling high-speed event streaming (e.g. clock-out events).</data>
    </node>
    <node id="5">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Primary system of record using PostgreSQL with row-level security and at-rest/in-transit encryption.</data>
    </node>
    <node id="6">
      <data key="d5">ELASTICACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory cache for fast user entitlement checks and data retrieval upon login.</data>
    </node>
    <node id="7">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Search index used to query employee lists, payroll history, and other client record searches.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests enter through the API layer.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API forwards traffic to the load balancing cluster.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB balances traffic into the EKS microservice nodes.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS publishes events (e.g. employee clocking out) onto Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Calculated real-time payroll and liability state are persisted to Aurora.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Microservices check ElastiCache for cached user entitlement and profile data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka streams event to EKS continuous calc engine to trigger payroll recalculation.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Aurora syncs state changes to ElastiCache.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Aurora syncs record changes to OpenSearch for indexing.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">ADP Workforce Now Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=KiH7hVJKzns</data>
    <data key="d2">ADP Workforce Now handles HR, capital management, and real-time payroll for tens of millions of users across 70,000 clients. Features multi-AZ and multi-region deployment across US and Canada with full end-to-end encryption.</data>
    <data key="d3">Application Modernization, Event-Driven Architecture, Database &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
