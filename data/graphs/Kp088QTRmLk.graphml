<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">DNS service routing web page request traffic.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN distribution receiving requests from Route 53.</data>
    </node>
    <node id="2">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall inspecting traffic and dropping malicious requests.</data>
    </node>
    <node id="3">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API Gateway managing incoming requests and triggering authentication.</data>
    </node>
    <node id="4">
      <data key="d5">CUSTOM AUTHORISER</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function executing custom authorization logic.</data>
    </node>
    <node id="5">
      <data key="d5">AUTH SERVICE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External auth service providing user capabilities and scopes.</data>
    </node>
    <node id="6">
      <data key="d5">GraphQL</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function serving GraphQL queries from cache or backend stores.</data>
    </node>
    <node id="7">
      <data key="d5">DATASTORE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Backend data store comprising internal databases, Elasticsearch, or domain APIs.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes incoming requests to CloudFront distribution.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront sends traffic through WAF rules.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF forwards validated requests to API Gateway.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Custom Authorizer Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway forwards authorized request with context to GraphQL Lambda.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Custom Authorizer contacts external Auth Service.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Custom Authorizer passes authorization result back to API Gateway.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Auth Service returns scopes and capabilities to Custom Authorizer.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">GraphQL Lambda fetches required content from the Datastore.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">News UK Serverless Content API Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Kp088QTRmLk</data>
    <data key="d2">Architecture for rendering content pages for News UK publications using Route 53, CloudFront, WAF, API Gateway, custom authorization Lambda with an external auth service, GraphQL Lambda, and flexible datastores.</data>
    <data key="d3">Serverless, Security, Web Applications</data>
    <data key="d4">True</data>
  </graph>
</graphml>
