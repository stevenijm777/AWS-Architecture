<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Systems</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Houses legacy data warehouses and domain data marts.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 Ingestion Engines</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts Kafka, Talend, and Databricks to process and ingest data securely over Direct Connect.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Stores catalog and metadata about incoming dataset schemas.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon S3 Lakehouse</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake storing Source (SRC), Enterprise (ENT / DW), and Product (Prod / DM) data layers in Parquet and Delta formats.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores ingestion processing metrics and execution status.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Redshift + Spectrum</data>
      <data key="d6">RedShift</data>
      <data key="d7">Provides a read-optimized data mart layer and uses Spectrum to query S3 directly.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Enables serverless ad-hoc queries directly against S3 data.</data>
    </node>
    <node id="7">
      <data key="d5">Analysts / Data Scientists / Business Users</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">End-user persona consuming data via self-service analytics and querying.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Data is securely transferred from on-premises systems into EC2-hosted ingestion engines over Direct Connect.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion engines pump processed data into S3 storage layers (Source, Enterprise, Product).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion processes register dataset catalog and schema metadata into AWS Glue.</data>
      <data key="d10">1'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Processing metrics and job logs are written to Amazon RDS.</data>
      <data key="d10">1''</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift and Redshift Spectrum read data from S3 for data mart workloads and cross-domain joins.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries raw and processed S3 data on the fly.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift serves read-optimized data mart queries to analysts and business users.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena serves direct self-service queries to analysts, data scientists, and business users.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Toyota Cloud Lakehouse Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Kp51k6LY-2c</data>
    <data key="d2">Toyota's architecture converges on-premises data warehouses and domain data marts into a central lakehouse on AWS S3, utilizing EC2-hosted tools (Kafka, Talend, Databricks) for ingestion, Glue for metadata cataloging, RDS for processing metrics, and Redshift Spectrum and Athena for self-service querying.</data>
    <data key="d3">Data Lakehouse, Analytics, Data Ingestion</data>
    <data key="d4">True</data>
  </graph>
</graphml>
