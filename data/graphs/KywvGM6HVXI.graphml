<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users / Configurers</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Platform users defining custom tenant events and attributes.</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer entry point for API access.</data>
    </node>
    <node id="2">
      <data key="d5">K8S</data>
      <data key="d6">EC2</data>
      <data key="d7">Kubernetes cluster running event definition APIs.</data>
    </node>
    <node id="3">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores event metadata definitions and persistent processed event data.</data>
    </node>
    <node id="4">
      <data key="d5">Third-Party System</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External client systems registering webhooks and sending runtime events.</data>
    </node>
    <node id="5">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for webhook event ingest.</data>
    </node>
    <node id="6">
      <data key="d5">WEBHOOK</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates tenant/event metadata against DynamoDB and pushes to queue. Scales rapidly during traffic bursts.</data>
    </node>
    <node id="7">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers incoming webhook events for downstream processing.</data>
    </node>
    <node id="8">
      <data key="d5">PROCESSOR</data>
      <data key="d6">Lambda</data>
      <data key="d7">Consumes SQS messages, persists data, and pushes stream events to Kinesis.</data>
    </node>
    <node id="9">
      <data key="d5">KINESIS</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Streams processed events for async worker actions.</data>
    </node>
    <node id="10">
      <data key="d5">WORKERS</data>
      <data key="d6">EC2</data>
      <data key="d7">Workers running inside platform that perform actions like point allocation and notifications.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users define events via ALB.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards configuration calls to K8S cluster.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">K8S saves event definition metadata to DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Third-party systems send runtime webhook events.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway triggers Webhook Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Webhook Lambda reads event metadata and authentication details from DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Webhook Lambda pushes verified events into SQS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS triggers Processor Lambda consumer.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Processor Lambda persists raw event data into DynamoDB for analytics.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Processor Lambda streams actionable events to Kinesis.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Workers consume events from Kinesis to trigger backend business logic.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Capillary Multi-Tenant Event Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=KywvGM6HVXI</data>
    <data key="d2">Handles up to 10 million events a day with heavy burst volume support via serverless components.</data>
    <data key="d3">SaaS / Event Processing / Multi-Tenant</data>
    <data key="d4">True</data>
  </graph>
</graphml>
