<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SAP ERP</data>
      <data key="d6">SAP</data>
      <data key="d7">Enterprise Resource Planning system where purchase orders originate and integrate via API calls.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Managed Blockchain</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Central immutable ledger running Hyperledger Fabric 1.2 to maintain end-to-end transparency, privacy, and smart contract chaincode execution.</data>
    </node>
    <node id="2">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Collects real-time telemetry, location, and movement threshold data from physical supply chain assets.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SAP sends purchase order data into Amazon Managed Blockchain via API call.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Managed Blockchain updates SAP with reconciled single source of truth ledger state.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Managed Blockchain triggers notifications and state updates back via IoT Core when rule breaches occur.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS IoT Core sends asset location and telemetry threshold data to Amazon Managed Blockchain.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">PwC Blockchain Supply Chain Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=KzJKdUZ3Ba4</data>
    <data key="d2">PwC blockchain-powered supply chain solution leveraging Amazon Managed Blockchain, SAP ERP integration, and AWS IoT Core telemetry.</data>
    <data key="d3">architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
