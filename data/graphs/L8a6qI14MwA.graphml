<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IoT Device 1</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Remote IoT sensor communicating via LoRaWAN up to 15km line of sight.</data>
    </node>
    <node id="1">
      <data key="d5">IoT Device 2</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Low-power remote IoT sensor connected via LoRaWAN.</data>
    </node>
    <node id="2">
      <data key="d5">IoT Gateway</data>
      <data key="d6">IoTCore</data>
      <data key="d7">LoRaWAN gateway forwarding sensor telemetry over Spark 4G cellular network.</data>
    </node>
    <node id="3">
      <data key="d5">AWS IoT Core for LoRaWAN</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Managed service providing core network management and IoT rules engine.</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Data Firehose 1</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams raw telemetry data directly into long-term storage.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw IoT telemetry for auditing and long-term storage.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms IoT telemetry payloads and routes data to operational and customer channels.</data>
    </node>
    <node id="7">
      <data key="d5">Kinesis Data Firehose 2</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams operational metrics to internal monitoring applications.</data>
    </node>
    <node id="8">
      <data key="d5">Spark Dashboard</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Centralized operational dashboard for Spark support teams.</data>
    </node>
    <node id="9">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Provides managed API endpoints to deliver tailored IoT data to customer applications.</data>
    </node>
    <node id="10">
      <data key="d5">Customer Application</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">End-user customer application rendering personalized IoT insights.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Device 1 transmits telemetry over wireless LoRaWAN network.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Device 2 transmits telemetry over wireless LoRaWAN network.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Gateway transmits aggregated sensor data over 4G cellular to AWS IoT Core for LoRaWAN.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">IoT Rules Engine routes raw data stream into Kinesis Data Firehose.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">IoT Rules Engine invokes Lambda function for payload processing and transformation.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis Data Firehose persists raw payload into Amazon S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda pushes processed operational telemetry to secondary Kinesis Data Firehose stream.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda forwards customer-specific structured data to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Kinesis Data Firehose feeds operational metrics into Spark internal support dashboard.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">API Gateway delivers data payloads into individual customer applications.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Spark IoT LoRaWAN Management Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=L8a6qI14MwA</data>
    <data key="d2">Spark IoT built a managed private LoRaWAN solution using AWS IoT Core for LoRaWAN, reducing network setup time from days to hours.</data>
    <data key="d3">Internet of Things, Data Analytics, Serverless</data>
    <data key="d4">True</data>
  </graph>
