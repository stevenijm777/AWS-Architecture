<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">PDF Images</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Incoming workers' compensation claim PDF images submitted by doctors.</data>
    </node>
    <node id="1">
      <data key="d5">AWS Lambda Data Automation</data>
      <data key="d6">Lambda</data>
      <data key="d7">Automates initial document upload into Amazon S3.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded PDF claim images and weekly CSV exports for model retraining.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda Scan and Process</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 upload to coordinate text extraction with Textract and classification with Comprehend.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Textract</data>
      <data key="d6">Textract</data>
      <data key="d7">Extracts raw text from PDF claim images.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Custom classification model trained on 200,000+ injury descriptions to assign medical codes.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores extracted text, medical codes, and claim metadata.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Provides API endpoints for web application access to DynamoDB data.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon ECS React App (stateless)</data>
      <data key="d6">ECS</data>
      <data key="d7">Stateless React front-end application hosted on ECS for human exception review.</data>
    </node>
    <node id="9">
      <data key="d5">Exception Cases</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Team of ~20 reviewers who inspect edge cases side-by-side with claim images.</data>
    </node>
    <node id="10">
      <data key="d5">Application</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Legacy application receiving final claim data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">PDF claim images sent to Lambda Data Automation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda uploads claim PDF images into S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 object creation triggers Lambda Scan and Process.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda sends document image to Textract.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda sends doctor description to Comprehend.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes extracted text and codes into DynamoDB.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Textract returns extracted text to Lambda.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Comprehend returns medical classification codes to Lambda.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Weekly claim data exported from DynamoDB to S3 as CSV for Comprehend retraining.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway retrieves and updates claim data in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Stateless ECS React app serves web user interface to exception handling operators.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Exception handling operators make API calls through API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DXC Claims Automation Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=LD5ksgnu8r8</data>
    <data key="d2">Serverless solution reducing workers' compensation claim processing time from over 4.5 minutes to under 1.5 minutes per claim.</data>
    <data key="d3">Serverless, AI/ML, Document Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
