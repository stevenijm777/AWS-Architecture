<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CHANNELS</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">User channels where customers provide travel ratings, reviews, and feedback.</data>
    </node>
    <node id="1">
      <data key="d5">API</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute API endpoint handling incoming user feedback requests.</data>
    </node>
    <node id="2">
      <data key="d5">ARANGO DB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Graph data store managing relationships between users, reviews, and bus operators.</data>
    </node>
    <node id="3">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Machine learning environment hosting Managed Training, Automatic Model Tuning (HPO), BYOA (scikit-learn Random Forest), and Batch Transform.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users submit journey reviews via channel endpoints to the API.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API writes raw user reviews into Arango DB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Arango DB data is fed into SageMaker for training and batch processing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker Batch Transform outputs generated dynamic tags back to Arango DB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Redbus Dynamic Tagging Pipeline with Amazon SageMaker</data>
    <data key="d1">https://www.youtube.com/watch?v=LPZlrX2cNjo</data>
    <data key="d2">Redbus processes 30-35M reviews by storing unstructured user feedback in Arango DB and using SageMaker for training and batch inference to generate dynamic feedback tags.</data>
    <data key="d3">AI/ML, Graph Database, E-Commerce Feedback Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
