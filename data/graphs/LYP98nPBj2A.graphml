<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Internet Gateway (IGW)</data>
      <data key="d6">VPC</data>
      <data key="d7">Routes external traffic from mobile users and merchants into the landing zone.</data>
    </node>
    <node id="1">
      <data key="d5">Virtual Private Gateway (VGW)</data>
      <data key="d6">VPN</data>
      <data key="d7">Routes internal enterprise traffic for Singtel management and technical support.</data>
    </node>
    <node id="2">
      <data key="d5">Application Load Balancer (ALB)</data>
      <data key="d6">ALB</data>
      <data key="d7">Distributes incoming external and internal traffic with automatic failover across application instances.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Web Tier (AZ1)</data>
      <data key="d6">EC2</data>
      <data key="d7">Primary web front-end handling incoming requests, capable of catering up to 50 TPS.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 App Tier (AZ1)</data>
      <data key="d6">EC2</data>
      <data key="d7">Primary application tier executing EMTU transaction business logic.</data>
    </node>
    <node id="5">
      <data key="d5">Aurora DB Tier (AZ1)</data>
      <data key="d6">Aurora</data>
      <data key="d7">Primary Amazon Aurora relational database acting as the system of record.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 Web Tier (AZ2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Secondary web front-end instance in AZ2 providing high availability and failover support.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 App Tier (AZ2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Secondary application tier instance in AZ2 providing high availability.</data>
    </node>
    <node id="8">
      <data key="d5">Aurora DB Tier (AZ2)</data>
      <data key="d6">Aurora</data>
      <data key="d7">Secondary Amazon Aurora database replica instance in AZ2 for high availability.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">External web and mobile user traffic enters through IGW and routes to ALB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Internal enterprise management and support traffic enters through VGW and routes to ALB.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards incoming requests to the primary EC2 Web Tier in AZ1.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Web tier processes request and forwards calls to the EC2 App Tier in AZ1.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">App tier executes database reads and writes on the primary Aurora DB in AZ1.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Singtel Electronic Mobile Top-up Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=LYP98nPBj2A</data>
    <data key="d2">Singtel EMTU landing zone architecture featuring segregation of internal and external traffic for regulatory compliance and multi-AZ deployment for high availability.</data>
    <data key="d3">Networking &amp; Content Delivery, Compute, Databases</data>
    <data key="d4">True</data>
  </graph>
</graphml>
