  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web interface on the university website used by students to ask questions.</data>
    </node>
    <node id="1">
      <data key="d5">Mobile Device</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile text messaging interface for students on the move.</data>
    </node>
    <node id="2">
      <data key="d5">Alexa Device</data>
      <data key="d6">UserConsumerAlexaGoogleHome</data>
      <data key="d7">Alexa smart devices installed in student residence halls.</data>
    </node>
    <node id="3">
      <data key="d5">Lex</data>
      <data key="d6">Lex</data>
      <data key="d7">Core Amazon Lex service powering the Q&amp;A chatbot solution.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores building and library operational hours, including default schedules, holiday schedules, and break hours.</data>
    </node>
    <node id="5">
      <data key="d5">External Partner Databases</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External food vendor databases queried to retrieve up-to-date dining menus and schedules.</data>
    </node>
    <node id="6">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends notification emails to content owners when negative user feedback (thumbs down) is submitted.</data>
    </node>
    <node id="7">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Analyzes text to extract key subjects, nouns, and verbs while ignoring common linking words to improve accuracy.</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Provides real-time scoring on all questions entered to test response accuracy and mapping.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Web client submits question to Lex chatbot.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile text client submits question to Lex chatbot.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Alexa device sends voice query to Lex chatbot.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lex queries DynamoDB to retrieve specific building and library hours.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lex fetches real-time dining menu data from external partner databases.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lex triggers SNS email notification to content owners when negative user feedback is logged.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Lex integrates with Elasticsearch for real-time scoring and testing of question-answer pairs.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lex uses Comprehend to hone in on key nouns and verbs to optimize intent recognition.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Saint Louis University Q&amp;A Chatbot Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=LxeSC3-xMlk</data>
    <data key="d2">Saint Louis University utilizes an open-source Q&amp;A chatbot powered by Amazon Lex to serve over 12,000 students and 2,000 faculty across web, mobile text, and Alexa channels.</data>
    <data key="d3">AI/ML, Serverless, Education</data>
    <data key="d4">True</data>
  </graph>
