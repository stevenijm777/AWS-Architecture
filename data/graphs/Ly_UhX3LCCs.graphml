<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Publisher S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket in Publisher (PUB) account containing original media content.</data>
    </node>
    <node id="1">
      <data key="d5">Publisher Events</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Publisher event handling workflow in PUB account.</data>
    </node>
    <node id="2">
      <data key="d5">Exchange S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Central cross-account exchange bucket in MX account acting as secure transfer staging.</data>
    </node>
    <node id="3">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Serverless event bus routing S3 object creation events.</data>
    </node>
    <node id="4">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Notification service publishing transfer events to subscriber workflows.</data>
    </node>
    <node id="5">
      <data key="d5">Access Logs S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores S3 access logs for reporting and auditing object access.</data>
    </node>
    <node id="6">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Manages AES-256 encryption keys shared between publisher and subscriber.</data>
    </node>
    <node id="7">
      <data key="d5">Subscriber S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket in Subscriber (SUB) account receiving transferred assets.</data>
    </node>
    <node id="8">
      <data key="d5">Subscriber Events</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Subscriber event handling workflow in SUB account triggering processing like transcoding.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Publisher copies media files into the exchange S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Shared KMS encryption and decryption trust across PUB and SUB accounts.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Subscriber reads and downloads media files from the exchange S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Object creation in Exchange S3 Bucket triggers EventBridge.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">EventBridge sends object creation notifications to Publisher Events.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS notifies Subscriber Events workflow upon file availability.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Access logs provided for reporting and auditing object operations.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">AWS Multi-Account Media Exchange Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Ly_UhX3LCCs</data>
    <data key="d2">Architecture for secure, scalable cross-account file transfer using S3, EventBridge, SNS, and KMS.</data>
    <data key="d3">Media &amp; Entertainment, Security &amp; Cross-Account Data Transfer</data>
    <data key="d4">True</data>
  </graph>
</graphml>
