<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">HOSPITALS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">500 different geographical facilities feeding EHR data with disparate data models</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Distributed object storage holding raw extracted EHR data, cutting previous SDFS storage costs by over half</data>
    </node>
    <node id="2">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs data parsing, transformation, and massaging to normalize data into a unified canonical model</data>
    </node>
    <node id="3">
      <data key="d5">Neo4j</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Graph database correlation engine utilizing Levenshtein, weighted Levenshtein, and fuzzy matching algorithms for patient deduplication</data>
    </node>
    <node id="4">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Central OLAP data warehouse holding canonical processed medical records</data>
    </node>
    <node id="5">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Operational data store synced from Redshift to power care provider applications</data>
    </node>
    <node id="6">
      <data key="d5">Apps</data>
      <data key="d6">EC2</data>
      <data key="d7">Application layer serving care providers and triggering automated patient outreach workflows</data>
    </node>
    <node id="7">
      <data key="d5">CONNECT</data>
      <data key="d6">Connect</data>
      <data key="d7">Triggers automated contact flows calling patients when medical intervention is required</data>
    </node>
    <node id="8">
      <data key="d5">CARE PROVIDER</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Doctors, care providers, and health coaches receiving 360-degree patient views and insights</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Extracts EHR data from hospital systems and deposits into S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR jobs pull raw EHR data from S3 for transformation</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR writes processed canonical data into Redshift OLAP store</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR pushes patient record data into Neo4j correlation engine for indexing and deduplication</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Data is synced from Redshift into Aurora operational data store</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Aurora serves operational query data to application backend</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Apps trigger automated contact workflows in Amazon Connect when patient intervention is needed</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Apps deliver 360-degree patient medical insights and workflow tools to Care Providers</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Innovaccer Healthcare Data Activation Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=M_hqigB9C4I</data>
    <data key="d2">Innovaccer's data activation platform ingests patient records from 500+ hospital facilities into Amazon S3, processes 20 billion records via EMR into Redshift and Neo4j for patient deduplication, syncs data into Aurora to serve 10,000 care providers via applications, and automates patient outreach using Amazon Connect.</data>
    <data key="d3">Healthcare, Big Data &amp; Analytics, Patient Care Automation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
