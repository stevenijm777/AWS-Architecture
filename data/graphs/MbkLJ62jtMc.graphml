<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives alert payloads from upstream API Gateway and fans out to SQS queues.</data>
    </node>
    <node id="1">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues incoming notifications per delivery route before invoking Lambda.</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Contains business logic for processing and dispatching notifications to different targets.</data>
    </node>
    <node id="3">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores user information, HTML/SMS templates, and subscriber lists.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores persistent notification history.</data>
    </node>
    <node id="5">
      <data key="d5">SMS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Delivers real-time SMS notifications to field technicians.</data>
    </node>
    <node id="6">
      <data key="d5">SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends email notifications to customers.</data>
    </node>
    <node id="7">
      <data key="d5">UI</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Front-end application updated in real-time using Socket.IO WebSockets.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS publishes messages to SQS queues</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SQS triggers Lambda function execution</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes notification history to DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda triggers SMS sending</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda triggers email delivery via SES</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda updates UI in real-time via WebSockets</data>
      <data key="d10">2'''</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mueller Water Products Real-time Notification Engine</data>
    <data key="d1">https://www.youtube.com/watch?v=MbkLJ62jtMc</data>
    <data key="d2">100% serverless notification architecture serving over 1 million deployed IoT devices.</data>
    <data key="d3">IoT, Serverless, Messaging, Real-time Notifications</data>
    <data key="d4">True</data>
  </graph>
