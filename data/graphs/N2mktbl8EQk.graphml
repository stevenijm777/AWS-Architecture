<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEEPRACER</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">AWS DeepRacer console and agent interface.</data>
    </node>
    <node id="1">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Performs reinforcement learning training using Proximal Policy Optimization (PPO).</data>
    </node>
    <node id="2">
      <data key="d5">ROBOMAKER</data>
      <data key="d6">RoboMaker</data>
      <data key="d7">Runs the 3D physics simulation environment to generate driving experiences.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores model artifacts, hyperparameter presets, and environment configurations.</data>
    </node>
    <node id="4">
      <data key="d5">KINESIS VIDEO</data>
      <data key="d6">KinesisVideo</data>
      <data key="d7">Streams windshield camera video feed from the simulation environment.</data>
    </node>
    <node id="5">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects logs, evaluation metrics, and exploration/exploitation progress.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User interacts with SageMaker via DeepRacer console to initiate model training.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker sends updated model policy and evaluation feedback to DeepRacer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker stores and retrieves model presets and experiences from S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">RoboMaker streams real-time simulation video to Kinesis Video Streams.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">RoboMaker sends simulation metrics and performance logs to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">AWS DeepRacer Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=N2mktbl8EQk</data>
    <data key="d2">Architecture of AWS DeepRacer showing training, simulation, video streaming, and monitoring loops.</data>
    <data key="d3">Machine Learning, Robotics, Reinforcement Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
