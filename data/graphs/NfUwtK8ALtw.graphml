<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CMS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Content Management System where content team ingests videos</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Ingestion API handling incoming transcoding requests</data>
    </node>
    <node id="2">
      <data key="d5">PRE TRANSCODING</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Spot fleet of GPU/CPU instances doing basic video checks, audio, and subtitle transcoding</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds task messages for video processing (handles 100k+ video queues)</data>
    </node>
    <node id="4">
      <data key="d5">ELASTICACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory cache for tracking task state and completion</data>
    </node>
    <node id="5">
      <data key="d5">TRANSCODING</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Large Spot Fleet (up to 3,000 GPU/CPU instances) executing multi-codec video transcoding (H.266, H.265, AV1)</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage holding raw input video and transcoded output media</data>
    </node>
    <node id="7">
      <data key="d5">CLOUD FRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN serving cached media content to end users</data>
    </node>
    <node id="8">
      <data key="d5">USER</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End users requesting video playback</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Content team ingests video data via CMS to the EC2 transcoding API</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 API invokes pre-transcoding workers</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 API sends processing message to SQS queue</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Pre-transcoding worker creates task entry in ElastiCache</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Pre-transcoding worker pushes completed pre-processing task message to SQS</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Transcoding Spot Fleet polls task messages from SQS</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Transcoding workers mark task as done in ElastiCache</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Transcoding workers write finished transcoded media files to S3</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Transcoding workers fetch source videos from S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront fetches transcoded video files from S3 bucket origin</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">User requests video stream from CloudFront CDN</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">MX Player Video Transcoding and Streaming Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=NfUwtK8ALtw</data>
    <data key="d2">MX Player handles over 200k hours of video and 300M+ MAUs using AWS Auto Scaling Spot Fleets (scaling up to 3,000 instances) to process ~100k videos in SQS queue within an hour while utilizing H.266 compression to halve bandwidth requirements.</data>
    <data key="d3">Media &amp; Entertainment, Compute, Storage &amp; Content Delivery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
