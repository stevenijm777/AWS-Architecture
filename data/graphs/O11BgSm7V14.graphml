<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Partner</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External data partner providing endpoints with job listings (~3M records/day).</data>
    </node>
    <node id="1">
      <data key="d5">Ingestion Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered via cron/EventBridge, pulls raw payloads from partners and splits them into smaller chunks.</data>
    </node>
    <node id="2">
      <data key="d5">Chunk Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues smaller job data chunks to buffer spikes and control downstream load.</data>
    </node>
    <node id="3">
      <data key="d5">Processing &amp; Enrichment Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Consumes chunks from SQS, normalizes data schema, verifies quality, interacts with SageMaker for ML enrichment, and writes to DB/SNS.</data>
    </node>
    <node id="4">
      <data key="d5">Aurora DB</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores normalized and enriched job listing records.</data>
    </node>
    <node id="5">
      <data key="d5">ML Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Uses NLP and ML models to enrich and categorize sparse job data.</data>
    </node>
    <node id="6">
      <data key="d5">Notification Topic</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives notifications after data is processed and enriched, fanning out messages.</data>
    </node>
    <node id="7">
      <data key="d5">Fanout Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives fanout messages from SNS for consumption by downstream services.</data>
    </node>
    <node id="8">
      <data key="d5">Talent Platform Containers</data>
      <data key="d6">ECS</data>
      <data key="d7">Containerized application consuming SQS messages and serving web frontend search/filtering.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion Lambda pulls raw data payloads from Partner endpoints.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion Lambda pushes data chunks to the SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing Lambda consumes chunked messages from SQS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing Lambda sends sparse job text to ML Endpoint for classification and NLP enrichment.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing Lambda stores enriched job records in Aurora DB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Processing Lambda publishes notification event to SNS Topic upon successful processing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ML Endpoint returns enriched categorization data back to Processing Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">SNS Topic fans out notifications to SQS queues.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS containers consume messages from SQS to update Talent Platform database and frontend search index.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">HeyJobs Serverless Job Data Ingestion and Processing Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=O11BgSm7V14</data>
    <data key="d2">HeyJobs processes ~3 million job records daily using a serverless architecture, reducing costs by up to 30% while scaling dynamically.</data>
    <data key="d3">Serverless Data Ingestion ML Processing Event-Driven Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
