<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerPOS</data>
      <data key="d7">Monzo customer initiating a payment at a point-of-sale terminal</data>
    </node>
    <node id="1">
      <data key="d5">Payment schemes</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External payment scheme network and physical data centers</data>
    </node>
    <node id="2">
      <data key="d5">AWS Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Dedicated network link connecting physical data centers to AWS</data>
    </node>
    <node id="3">
      <data key="d5">Tokenization Microservice</data>
      <data key="d6">EKS</data>
      <data key="d7">Removes sensitive card details and replaces them with internal tokens</data>
    </node>
    <node id="4">
      <data key="d5">Cards Microservice</data>
      <data key="d6">EKS</data>
      <data key="d7">Validates card state and block/freeze flags</data>
    </node>
    <node id="5">
      <data key="d5">Cards Table</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Amazon Keyspaces table storing card state and metadata</data>
    </node>
    <node id="6">
      <data key="d5">Account Microservice</data>
      <data key="d6">EKS</data>
      <data key="d7">Verifies account status and card linkage</data>
    </node>
    <node id="7">
      <data key="d5">Account Table</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Amazon Keyspaces table storing customer account details</data>
    </node>
    <node id="8">
      <data key="d5">Ledger Microservice</data>
      <data key="d6">EKS</data>
      <data key="d7">Calculates ledger balances and handles double-entry bookkeeping</data>
    </node>
    <node id="9">
      <data key="d5">AWS WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall protecting external entry points</data>
    </node>
    <node id="10">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Balances incoming HTTP/HTTPS traffic to platform services</data>
    </node>
    <node id="11">
      <data key="d5">AWS Nitro Enclaves</data>
      <data key="d6">EC2</data>
      <data key="d7">Provides isolated compute environments for sensitive data processing</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Customer taps card at terminal, sending payment details through scheme</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Payment network routes transaction into Monzo's Direct Connect</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Direct Connect routes payload into Tokenization Microservice on EKS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Tokenized request passed to Cards Microservice for card validation</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Cards Microservice queries Cards Table in Keyspaces</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Request passes to Account Microservice</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Account Microservice reads account state from Keyspaces</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Request passes to Ledger Microservice for balance check</data>
      <data key="d10">7</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Synchronous authorization result returned back out through Direct Connect</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Monzo Core Banking Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=O3s3MWD-UUA</data>
    <data key="d2">Monzo processes millions of synchronous payment transactions using Amazon EKS microservices and Amazon Keyspaces for low-latency NoSQL state persistence.</data>
    <data key="d3">financial_services, compute, container, database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
