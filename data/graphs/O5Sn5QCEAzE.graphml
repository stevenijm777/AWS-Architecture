  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Browser Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-user web browser accessing the invoice portal.</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer routing web traffic to backend instances.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 FLEET</data>
      <data key="d6">EC2</data>
      <data key="d7">Multi-AZ EC2 fleet providing compute capacity for container workloads.</data>
    </node>
    <node id="3">
      <data key="d5">KUBERNETES</data>
      <data key="d6">EKS</data>
      <data key="d7">Kubernetes cluster managing domain microservices written in Scala.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing PDF and XML electronic invoice files.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Event-driven Lambda function parsing XML invoice data.</data>
    </node>
    <node id="6">
      <data key="d5">RDS MYSQL</data>
      <data key="d6">RDS</data>
      <data key="d7">Multi-AZ Amazon RDS MySQL storing invoice metadata with cross-region snapshots.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User accesses web application via browser.</data>
      <data key="d10">0</data>
