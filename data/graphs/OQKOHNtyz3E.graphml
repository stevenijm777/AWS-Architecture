<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CUSTOMER</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Handles over 1 million incoming phone calls and chats per month.</data>
    </node>
    <node id="1">
      <data key="d5">CONNECT</data>
      <data key="d6">Connect</data>
      <data key="d7">Core contact center service managing voice and chat channels via modular universal contact flows.</data>
    </node>
    <node id="2">
      <data key="d5">LEX</data>
      <data key="d6">Lex</data>
      <data key="d7">Conversational AI and intent matching simplified to around 200 intents.</data>
    </node>
    <node id="3">
      <data key="d5">SNOWFLAKE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Central data warehouse storing CTR attributes, Contact Lens sentiment analysis, and transcriptions.</data>
    </node>
    <node id="4">
      <data key="d5">DASHBOARD</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Visualization dashboard serving analytics to agents, team leads, and developers.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes logic to stitch modular contact flows dynamically.</data>
    </node>
    <node id="6">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores dynamic flow mappings and contact flow configurations.</data>
    </node>
    <node id="7">
      <data key="d5">TERRAFORM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Infrastructure as Code tool used to deploy Connect flows, Lex intents, Lambda, and DynamoDB.</data>
    </node>
    <node id="8">
      <data key="d5">DEV TOOLS</data>
      <data key="d6">DevTools</data>
      <data key="d7">AWS CI/CD pipeline tools automating testing and continuous delivery.</data>
    </node>
    <node id="9">
      <data key="d5">AGENTS</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">2,500 customer service agents across 3 geographic locations.</data>
    </node>
    <node id="10">
      <data key="d5">TEAM LEADS</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Supervisors monitoring contact center performance and operational metrics.</data>
    </node>
    <node id="11">
      <data key="d5">DEVELOPER</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Engineers iterating on infrastructure and flow updates using continuous feedback loops.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Customer initiates voice or chat contact into Amazon Connect.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Connect passes customer interactions to Lex for intent recognition.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Connect invokes Lambda functions to retrieve routing logic.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Connect streams Contact Lens data, CTRs, and transcripts to Snowflake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Lex routes resolved interactions or hands off calls/chats to customer agents.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Snowflake feeds consolidated customer and interaction metrics to Dashboard.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Dashboard displays real-time operational views to Agents.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Dashboard provides supervisory metrics to Team Leads.</data>
      <data key="d10">2'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Dashboard provides continuous information feedback to Developers.</data>
      <data key="d10">2''</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda reads dynamic flow mappings from DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">DevTools pipeline triggers Terraform to deploy updated AWS infrastructure and contact flows.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Developers push code and configuration through AWS DevTools.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Vodafone New Zealand Cloud Contact Center Migration</data>
    <data key="d1">https://www.youtube.com/watch?v=OQKOHNtyz3E</data>
    <data key="d2">Migrated from legacy on-premise contact center to AWS Amazon Connect, reducing interaction pathways from 81,000 to 200 Lex intents for 2,500 agents and over 1 million monthly calls.</data>
    <data key="d3">Contact Center, Analytics, DevOps</data>
    <data key="d4">True</data>
  </graph>
