<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Portal</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Client portal used by data scientists to initiate batch processing campaigns.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Managed Streaming for Apache Kafka</data>
      <data key="d6">MSK</data>
      <data key="d7">Central streaming message broker handling topics between orchestrator, processing units, and notifiers.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Fargate (Orchestrator)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Orchestration consumer running on Fargate that determines the campaign execution plan.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Fargate (Processing)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Operational processing consumer on Fargate executing modular tasks within parallel functional units.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon EMR Cluster</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR cluster used for pre-processing heterogeneous input data into standard formats.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker service handling model testing, training, and batch transform job executions.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Event bus collecting job status and state changes from EMR and SageMaker.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon OpenSearch Service</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Metadata store tracking real-time job execution state and history for API querying.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Fargate (Notifier)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Action and notifier consumer on Fargate triggered when a campaign completes execution.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Data scientist initiates batch campaign request from portal to MSK topic.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">MSK topic triggers Fargate Orchestrator consumer.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">MSK execution topic triggers operational processing Fargate consumer.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">MSK triggers Notifier Fargate consumer upon campaign phase or final completion.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestrator determines execution plan and writes plan messages back to MSK topic.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing Fargate triggers data pre-processing on EMR cluster.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing Fargate triggers batch transform / training job on SageMaker.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing Fargate writes execution status update to MSK for downstream consumers.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing Fargate writes job execution state into OpenSearch metadata store.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR emits job state change events to EventBridge.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker emits job state change events to EventBridge.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EventBridge routes event triggers to processing Fargate consumer to determine next task sequence.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">Portal APIs query OpenSearch metadata store to present real-time campaign status to users.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Notifier Fargate updates final campaign status in OpenSearch.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">Notifier Fargate pushes completion notification to Portal.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Experian MLOps Batch Transform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=OTPyxlTjWp0</data>
    <data key="d2">Architecture processes hundreds of batch campaigns, thousands of models, and tens of billions of consumer records monthly using an event-driven decoupled model execution pipeline.</data>
    <data key="d3">Machine Learning &amp; MLOps, Data Analytics, Event-Driven Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
