<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Clients Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Dedicated client EC2 server making database calls.</data>
    </node>
    <node id="1">
      <data key="d5">Clients Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless client Lambda function making database calls.</data>
    </node>
    <node id="2">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Network Load Balancer acting as the transparent database endpoint for clients.</data>
    </node>
    <node id="3">
      <data key="d5">Proxy Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Auto Scaling Group containing Heimdall Proxy instances with L1 caching capability.</data>
    </node>
    <node id="4">
      <data key="d5">Management Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Central management server managing cache rules, invalidations, and eviction policies on a decoupled control plane.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Backend relational database service.</data>
    </node>
    <node id="6">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">L2 synchronized distributed caching layer shared across all proxy instances.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Client EC2 sends database query calls to NLB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Client Lambda sends database query calls to NLB.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB distributes database connection traffic to Heimdall proxy instances.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Proxy queries and synchronizes shared L2 cache in ElastiCache.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Proxy fetches uncached query results from RDS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Proxy instances connect to central management server for control plane configuration.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Heimdall Data Proxy Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=OWLGK-eVrTw</data>
    <data key="d2">Heimdall proxy transparently caches database queries across an Auto Scaling group using ElastiCache as L2 cache and connects to RDS for cache misses. Central management server handles control plane config.</data>
    <data key="d3">Database Caching and Performance Optimization</data>
    <data key="d4">True</data>
  </graph>
</graphml>
