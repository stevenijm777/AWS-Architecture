<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Plato Robot</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-site waiter assistant robot carrying up to 30 days of local offline storage.</data>
    </node>
    <node id="1">
      <data key="d5">Remote Devices</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Tablet device used by restaurant staff to command table deliveries.</data>
    </node>
    <node id="2">
      <data key="d5">AWS IoT Greengrass</data>
      <data key="d6">Greengrass</data>
      <data key="d7">Runs locally on a router at the client site to secure local device communications offline.</data>
    </node>
    <node id="3">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Central message broker in AWS VPC for cloud sync and device deployments.</data>
    </node>
    <node id="4">
      <data key="d5">IoT Rule</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Evaluates incoming MQTT topics like event/mission data and routes to Kinesis.</data>
    </node>
    <node id="5">
      <data key="d5">IoT Shadow</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Maintains persistent state representation for devices.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Streams real-time event logs and mission telemetry.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon OpenSearch Service</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Provides near real-time operational visualization and monitoring.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores historical mission data and logs for long-term queries.</data>
    </node>
    <node id="9">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute function in AWS VPC.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Backend container cluster managing client site definitions and device registration.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Plato Robot sends telemetry, events, and status back to local IoT Greengrass.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Staff dispatches navigation command from tablet to IoT Greengrass.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">IoT Greengrass routes local navigation command to Plato Robot.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Syncs site telemetry to cloud when internet connection is established.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Pushes software deployments and updates from AWS IoT Core to site Greengrass.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Evaluates message topics against defined IoT Rules.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Triggers streaming ingestion into Amazon Kinesis.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Streams data to OpenSearch for near real-time operational dashboards.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Persists event logs and mission data into S3 for long-term analytics.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS backend defines client sites and associates devices into AWS IoT Core.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">AWS IoT Architecture for Plato Robot Edge and Cloud Analytics</data>
    <data key="d1">https://www.youtube.com/watch?v=OYHSkwt31Vc</data>
    <data key="d2">Architecture for Plato restaurant helper robot by United Robotics Group. On-site local operation is managed by AWS IoT Greengrass running on a dedicated local router without requiring external internet connectivity. Robots hold up to 30 days of data storage offline. When internet is available, telemetry events stream through IoT Core, Kinesis, OpenSearch, and S3.</data>
    <data key="d3">IoT, Analytics, Edge Computing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
