    <node id="5">
      <data key="d5">Fluentd</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">DaemonSet for container log collection and forwarding</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch exports collected AWS metrics and logs to SolarWinds centralized platforms</data>
