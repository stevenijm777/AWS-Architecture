<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2 Orchestrator</data>
      <data key="d6">EC2</data>
      <data key="d7">Orchestrates test configurations and connects to RDS database.</data>
    </node>
    <node id="1">
      <data key="d5">RDS Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores test configurations for 200-400 concurrent test executions.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Container orchestrator for running test tasks on Fargate.</data>
    </node>
    <node id="3">
      <data key="d5">Fargate Spot</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs Selenium testing tasks serverlessly using Spot instances, performing ~30,000 daily tests at ~70% cost savings.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Execution Storage</data>
      <data key="d6">S3</data>
      <data key="d7">Stores execution reports and test output artifacts.</data>
    </node>
    <node id="5">
      <data key="d5">Intranet</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Internal web application used by teams to visualize test quality and reports.</data>
    </node>
    <node id="6">
      <data key="d5">Enterprise Support</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">AWS Enterprise Support advising on architecture optimization such as Fargate Spot.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 orchestrator queries RDS for test configurations.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Configurations trigger automated test execution on Fargate Spot containers.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate Spot tasks output execution results to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Intranet web app retrieves test results from S3 for internal monitoring.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Telecoming Aquarius Automated Testing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=OrC9cLYMbas</data>
    <data key="d2">Telecoming's Aquarius platform automates web simulation testing using EC2, RDS, ECS Fargate Spot, S3, and an internal Intranet dashboard.</data>
    <data key="d3">Automated Testing, Containers, Database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
