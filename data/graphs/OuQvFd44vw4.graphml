<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Lambda (Training Trigger)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered daily via CloudWatch to initiate client-specific pre-processing.</data>
    </node>
    <node id="1">
      <data key="d5">Secrets Manager</data>
      <data key="d6">SecretsManager</data>
      <data key="d7">Stores client-specific credentials and configuration profiles.</data>
    </node>
    <node id="2">
      <data key="d5">Econda API</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External API delivering raw data to SageMaker for pre-processing.</data>
    </node>
    <node id="3">
      <data key="d5">SageMaker (Pre-processing)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs initial data retrieval and pre-processing tasks prior to model training.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker (Training)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Executes deep learning training algorithms on GPU-empowered instances.</data>
    </node>
    <node id="5">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores custom Docker container images and manages algorithm versioning via tags.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded trained model artifacts after training completion.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Deployment Trigger)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 model upload events to build or update ECS service deployments.</data>
    </node>
    <node id="8">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs cost-effective, 24/7 real-time model inference service integrated with ALB.</data>
    </node>
    <node id="9">
      <data key="d5">Personalization Service (ARP)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Econda Audience Relationship Platform requesting real-time personalization recommendations.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Fetches client credentials and profiles.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers the SageMaker pre-processing job.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Returns raw data for preparation.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Requests client data from Econda API.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers the GPU training job upon pre-processing completion.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Uploads trained model artifacts to S3 bucket.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Provides custom container image tagged with specific algorithm versions.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 event triggers deployment Lambda function.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Builds or updates the ECS inference service.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Returns personalized recommendations to the ARP platform.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Sends real-time inference/personalization requests to ECS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Econda Automated Model Training and Real-Time Inference Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=OuQvFd44vw4</data>
    <data key="d2">Automated workflow that runs daily per-client deep learning model training using SageMaker and serves real-time personalization recommendations via ECS.</data>
    <data key="d3">Machine Learning, Analytics, Real-Time Inference</data>
    <data key="d4">True</data>
  </graph>
</graphml>
