<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CFT</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">CloudFormation template installed on customer side to set up event triggers and IAM roles.</data>
    </node>
    <node id="1">
      <data key="d5">EBS / RDS / DynamoDB</data>
      <data key="d6">EBS</data>
      <data key="d7">Customer data sources containing volumes, databases, and tables requiring backup.</data>
    </node>
    <node id="2">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Captures configuration and environment state changes on the customer side.</data>
    </node>
    <node id="3">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Provides key management for customer data encryption prior to transfer.</data>
    </node>
    <node id="4">
      <data key="d5">IAM Role</data>
      <data key="d6">IAM</data>
      <data key="d7">Cross-account IAM role providing permissions for Clumio to perform post-processing.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Data Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores encrypted backup objects transferred directly from customer account.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda Post-processing</data>
      <data key="d6">Lambda</data>
      <data key="d7">Performs compression, data optimization, indexing, and data integrity checks on S3 objects.</data>
    </node>
    <node id="7">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers incoming metadata event messages from EventBridge.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda Metadata</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes metadata messages from SQS to analyze backup health and metrics.</data>
    </node>
    <node id="9">
      <data key="d5">Metadata Engine</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data engine storing analyzed metadata for creating customer reports and recommendations.</data>
    </node>
    <node id="10">
      <data key="d5">S3 Output Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores generated compliance, audit, and cost recommendation reports.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CFT provisions IAM roles in destination account during onboarding.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer data sources send encrypted backup data directly into Clumio S3 Data Bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">EventBridge sends environment change events to SQS queue.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda post-processing reads and operates on S3 backup objects.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda assumes IAM role to operate across customer and Clumio accounts.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda Metadata consumes metadata messages from SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda Metadata writes analyzed metadata to Metadata Engine.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda Metadata writes report and recommendation outputs to S3 Output Bucket.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Clumio Backup as a Service AWS Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Ozbv9qBsDG8</data>
    <data key="d2">Architecture showing how Clumio ingests encrypted customer backups directly into S3, processes metadata via EventBridge and SQS into a Metadata Engine, and performs post-processing on backups using cross-account IAM roles and Lambda.</data>
    <data key="d3">Backup &amp; Archive, Storage, Security &amp; Compliance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
