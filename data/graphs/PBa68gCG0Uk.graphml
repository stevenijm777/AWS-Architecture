<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2 Spot (Ingestion)</data>
      <data key="d6">EC2</data>
      <data key="d7">Crawls and ingests large volumes of fashion/beauty content including posts and comments.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Buffers ingestion stream data and preserves task state.</data>
    </node>
    <node id="2">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues ingestion task states to coordinate resilient processing across spot instance interruptions.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Spot (Enrichment)</data>
      <data key="d6">EC2</data>
      <data key="d7">Enriches ingested data using custom SageMaker AI models to identify brand, industry, sentiment, and language.</data>
    </node>
    <node id="4">
      <data key="d5">Aurora + OpenSearch</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores enriched data and meta-information for customer insight generation.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion nodes push stream content to Kinesis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion nodes publish task state to SQS.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Enrichment nodes read stream content from Kinesis.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Enrichment nodes consume task messages from SQS.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Enrichment nodes write enriched data to Aurora and OpenSearch.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Enrichment nodes read state or historical data from Aurora and OpenSearch.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Launchmetrics Data Ingestion and Enrichment Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=PBa68gCG0Uk</data>
    <data key="d2">Architecture processes ~8M posts and 70M comments per day. Spot instances reduce operational costs by ~75%, using Kinesis and SQS to statefully manage interruptions.</data>
    <data key="d3">Data Analytics, AI/ML, E-Commerce &amp; Retail</data>
    <data key="d4">True</data>
  </graph>
</graphml>
