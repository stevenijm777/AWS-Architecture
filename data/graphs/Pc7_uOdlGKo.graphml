<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 (Ingestion)</data>
      <data key="d6">S3</data>
      <data key="d7">Ingests public and private weather data, flight data, and internal Panasonic datasets.</data>
    </node>
    <node id="1">
      <data key="d5">Lake Formation</data>
      <data key="d6">LakeFormation</data>
      <data key="d7">Serves out raw data and catalogs transformed data.</data>
    </node>
    <node id="2">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Performs ETL transformation on landed datasets.</data>
    </node>
    <node id="3">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains machine learning models to predict weather connectivity impacts 24 to 48 hours in advance.</data>
    </node>
    <node id="4">
      <data key="d5">S3 (Predictions)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores predictive model output generated by SageMaker.</data>
    </node>
    <node id="5">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries predictive data stored in S3 for analytical queries.</data>
    </node>
    <node id="6">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Provides interactive dashboards and visual data insights.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Landed data in S3 is served out through Lake Formation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lake Formation passes data to Glue for ETL transformation.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Cataloged data is fed into SageMaker for model inference and training.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">ETL transformed data is served back and cataloged in Lake Formation.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker outputs weather impact prediction results to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries predictive output stored in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">QuickSight ingests predictive data from S3 for dashboard visualizations.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Panasonic Avionics Severe Weather Predictive Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Pc7_uOdlGKo</data>
    <data key="d2">Architecture deployed by Panasonic Avionics to proactively predict and inform airlines of severe weather patterns affecting in-flight internet connectivity 24 to 48 hours in advance.</data>
    <data key="d3">Data Lake &amp; Analytics, AI &amp; Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
