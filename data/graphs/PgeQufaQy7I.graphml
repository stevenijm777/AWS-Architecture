<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CLIENT</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">User accessing the sales readiness platform.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Global CDN receiving initial user requests.</data>
    </node>
    <node id="2">
      <data key="d5">@EDGE</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Lambda@Edge function deciding user regional routing based on location.</data>
    </node>
    <node id="3">
      <data key="d5">DNS FIREWALL</data>
      <data key="d6">Route53</data>
      <data key="d7">Route 53 DNS Firewall blocking unauthorized regional cross-tenant traffic.</data>
    </node>
    <node id="4">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer distributing requests inside the regional environment.</data>
    </node>
    <node id="5">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">AWS Elastic Kubernetes Service hosting microservices.</data>
    </node>
    <node id="6">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">AWS RDS database storing isolated regional data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User accesses platform via CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront redirects request to Lambda@Edge for geographic decision-making.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda@Edge routes request to Route 53 DNS Firewall in target region.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Allowed requests pass through Route 53 DNS Firewall to ALB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards traffic to microservices in EKS cluster.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS microservices query and update RDS database.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">MindTickle Multi-Region Automated Infrastructure Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=PgeQufaQy7I</data>
    <data key="d2">MindTickle's multi-region architecture featuring dynamic edge-based regional routing and isolated regional infrastructure deployment.</data>
    <data key="d3">Multi-Region, Edge Routing, Microservices</data>
    <data key="d4">True</data>
  </graph>
</graphml>
