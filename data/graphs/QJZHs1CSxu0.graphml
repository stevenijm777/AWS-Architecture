<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Ad Script</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Runs in the user's browser, calling prediction services and sending interaction metrics.</data>
    </node>
    <node id="1">
      <data key="d5">Decision Lambda Worker</data>
      <data key="d6">Lambda</data>
      <data key="d7">Performs ~100,000 predictions per minute by executing the head of the neural network.</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores pre-computed network embeddings and contextual dimension data.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues user ad interaction events.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Stores interaction logs and enriched dimension data for business analytics and neural network training.</data>
    </node>
    <node id="5">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Enriches context (page, placement, location) into data embeddings for fast downstream evaluation.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers decision worker for ad prediction.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Reads context embeddings and writes ad interaction state.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends ad interaction metrics to SQS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Transfers dimension data to S3 data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Persists interaction metrics into S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Writes enriched embedding data into DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Define Media Machine Learning Ad Decision Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=QJZHs1CSxu0</data>
    <data key="d2">Define Media processes ~100,000 click-through rate predictions per minute using split neural network inference across EKS and AWS Lambda.</data>
    <data key="d3">Ad Tech, Machine Learning, Analytics</data>
    <data key="d4">True</data>
  </graph>
