<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CLIENT DISPLAY</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Browser client executing code and decompressing seismic data via WebAssembly for HTML5 Canvas display.</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs IVAAP reverse proxy, Node.js backend for configuration, and custom microservice adapters using vector AVX instructions for data compression.</data>
    </node>
    <node id="2">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL database instance storing project configurations, data source mapping, and RBAC policies.</data>
    </node>
    <node id="3">
      <data key="d5">COGNITO</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user authentication and account management.</data>
    </node>
    <node id="4">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">OSDU consortium API endpoint backed by Elasticsearch for data search.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage housing massive seismic data files accessed via parallel byte-offset queries.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Client sends login request to IVAAP reverse proxy on EC2.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="1">
      <data key="d8">1</data>
      <data key="d9">Client issues dataset search/fetch query.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Reverse proxy routes user authentication request to Cognito.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Node.js instance queries RDS PostgreSQL for project settings and role-based access controls.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Adapter microservice queries OSDU search APIs via API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Adapter computes byte offsets and issues parallel range requests to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 returns compressed data to browser client for Wasm decompression.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 returns raw trace data to EC2 adapter microservice for AVX compression.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">INT IVAAP Architecture with AWS and OSDU Integration</data>
    <data key="d1">https://www.youtube.com/watch?v=QM96Fv_NAnw</data>
    <data key="d2">IVAAP is a client-server web application by INT providing high-performance visualization for massive geoscience and seismic data via microservice adapters and OSDU APIs.</data>
    <data key="d3">Geoscience Data Visualization</data>
    <data key="d4">True</data>
  </graph>
</graphml>
