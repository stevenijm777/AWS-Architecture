<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IOT</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Vehicle sensors capturing speed, g-force, GPS, and vehicle computer telematics data.</data>
    </node>
    <node id="1">
      <data key="d5">LAMBDA (Ingestion)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Ingests raw vehicle sensor telematics data.</data>
    </node>
    <node id="2">
      <data key="d5">S3 (Raw Data Lake)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw telematics data forming the initial data lake.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers and batches telematics data for scalable processing and durability.</data>
    </node>
    <node id="4">
      <data key="d5">S3 (OpenStreetMaps)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores pre-chunked OpenStreetMap map data provided via AWS Open Data Initiative.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA (Enrichment)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Enriches telematics batches with pre-chunked map data chunks.</data>
    </node>
    <node id="6">
      <data key="d5">KINESIS</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Runs sliding window queries to detect events like speeding.</data>
    </node>
    <node id="7">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Runs background queries to pre-chunk map data and query raw telematics data.</data>
    </node>
    <node id="8">
      <data key="d5">S3 (Enriched Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores enriched event data and telemetry results.</data>
    </node>
    <node id="9">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">ETL job that transfers enriched and summary data to destination systems.</data>
    </node>
    <node id="10">
      <data key="d5">On-Prem Data Center</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises destination powering reports, dashboards, and customer applications.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Vehicle IoT sensors send raw telematics data to Ingestion Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion Lambda stores raw telemetry into S3 data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw telemetry is batched and loaded into SQS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries raw telematics data in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS sends batched messages to Enrichment Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Enrichment Lambda pulls map chunks from OpenStreetMap S3 bucket.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Enrichment Lambda feeds data into Kinesis for real-time event detection.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Enrichment Lambda writes enriched telematics to enriched S3 bucket.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis outputs detected safety events into enriched S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena query results are passed to Glue.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue reads enriched event data from S3.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue pushes data to the on-premises data center.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">LeasePlan OneConnect Telematics Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=QOtCpD23118</data>
    <data key="d2">LeasePlan's OneConnect telematics platform ingests vehicle sensor data, enriches it with OpenStreetMap data, detects safety events using Kinesis sliding windows, and exports enriched data via Glue to on-premises data centers.</data>
    <data key="d3">IoT, Analytics, Migration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
