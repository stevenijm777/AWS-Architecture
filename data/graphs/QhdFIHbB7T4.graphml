<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">LoRa Gateway</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Receives wireless signals from UWB tags/anchors containing distance timing data and transmits encapsulated LoRa packets over the internet.</data>
    </node>
    <node id="1">
      <data key="d5">AWS IoT Core for LoRaWAN</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests encrypted wireless LoRa packets and outputs decrypted base64 payload data.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Converts base64 machine-readable distance data into human-readable format.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Elastic Compute Cloud (Amazon EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs location processing engine to compute spatial XYZ positioning coordinates from distance metrics.</data>
    </node>
    <node id="4">
      <data key="d5">IoT MQTT Protocol</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Receives published XYZ location coordinates with timestamps on specific MQTT topics for subscribing consumers.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores real-time aggregated location data (up to 1 time per second) for historical tracking and operational analysis.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">LoRa Gateway transmits encapsulated LoRa packets over the internet to AWS IoT Core for LoRaWAN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS IoT Core for LoRaWAN passes decrypted Base64 payload data to AWS Lambda for conversion.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Lambda sends converted human-readable distance data to EC2 location processing engine.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon EC2 publishes calculated XYZ coordinates with timestamps to the IoT MQTT broker.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Aggregated location metrics are streamed from MQTT subscribers and stored in Amazon Aurora.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Drop Wireless Indoor Positioning Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=QhdFIHbB7T4</data>
    <data key="d2">Drop Wireless indoor positioning system combining Ultra Wideband (UWB) and LoRaWAN to track high-value items in manufacturing facilities.</data>
    <data key="d3">IoT, Compute, Databases</data>
    <data key="d4">True</data>
  </graph>
</graphml>
