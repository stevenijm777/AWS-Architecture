  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amplify</data>
      <data key="d6">Amplify</data>
      <data key="d7">Provides the UI framework for web and mobile users.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles entry requests and routes authentication/upload requests.</data>
    </node>
    <node id="2">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Authenticates wholesalers and retailers.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Raw storage bucket for uploaded images and videos.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 upload events to orchestrate AI services.</data>
    </node>
    <node id="5">
      <data key="d5">Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Trained on 100k+ luxury goods images to extract visual features and brands.</data>
    </node>
    <node id="6">
      <data key="d5">Textract</data>
      <data key="d6">Textract</data>
      <data key="d7">Extracts text and text geolocation within images to correlate with visual features.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores extracted metadata and features in an extensible JSON format.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests from web/mobile app sent to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway authenticates users against Cognito.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Uploaded inventory images/videos stored in S3 raw bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 data event triggers Lambda function execution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda invokes Rekognition to analyze visual features.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Rekognition feature analysis passes images to Textract for text extraction.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Extracted text and metadata saved to DynamoDB in JSON format.</data>
      <data key="d10">3</data>
