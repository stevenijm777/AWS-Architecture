<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Deployed in local reused CIDR block.</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Deployed in local reused CIDR block.</data>
    </node>
    <node id="2">
      <data key="d5">NGW</data>
      <data key="d6">NAT</data>
      <data key="d7">Deployed in routed CIDR block to perform NAT between private IPs.</data>
    </node>
    <node id="3">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Deployed in routed CIDR block for inbound/routed traffic.</data>
    </node>
    <node id="4">
      <data key="d5">TRANSIT GW</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Regional routing hub interconnecting VPCs, Direct Connect, and VPNs.</data>
    </node>
    <node id="5">
      <data key="d5">DIRECT CONNECT</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Provides dedicated hybrid connectivity to Transit Gateway.</data>
    </node>
    <node id="6">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">Provides IPsec VPN connectivity to Transit Gateway.</data>
    </node>
    <node id="7">
      <data key="d5">VPC PRIVATE LINK</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">Exposes shared service provider endpoints in the Shared Services VPC.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS cluster sends egress traffic to NAT Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">NAT Gateway forwards NATed traffic to Transit Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Transit Gateway routes traffic to PrivateLink in the Shared Services VPC.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Direct Connect delivers on-prem traffic to Transit Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">VPN delivers remote traffic to Transit Gateway.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Adobe Multi-VPC Architecture with AWS Transit Gateway</data>
    <data key="d1">https://www.youtube.com/watch?v=QnmmTIYZxNI</data>
    <data key="d2">Adobe uses AWS Transit Gateway as a regional routing hub connecting thousands of product team VPCs, on-premise infrastructure via Direct Connect and VPN, and Shared Services using VPC PrivateLink.</data>
    <data key="d3">Networking &amp; Content Delivery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
