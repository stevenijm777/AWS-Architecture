<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Voters accessing via mobile apps, web, connected TVs, or SMS</data>
    </node>
    <node id="1">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Validates user location to restrict voting to allowed regions (Italy)</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Distributes incoming web traffic to containerized application frontends</data>
    </node>
    <node id="3">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs separate frontend and private backend container services; handles authentication and business checks</data>
    </node>
    <node id="4">
      <data key="d5">MemoryDB Redis</data>
      <data key="d6">MemoryDB</data>
      <data key="d7">Stores active session state and contestant counters; processes vote logic using single-threaded Lua scripts (&lt;10ms target)</data>
    </node>
    <node id="5">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">Secure tunnel connecting broadcast studio to private backend services in AWS</data>
    </node>
    <node id="6">
      <data key="d5">On-Premises</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Editorial control systems used to manage voting sessions and view real-time results</data>
    </node>
    <node id="7">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Aggregates application and infrastructure logs for real-time operational dashboards</data>
    </node>
    <node id="8">
      <data key="d5">Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams log data continuously from CloudWatch to long-term storage</data>
    </node>
    <node id="9">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores audit and certification log data for long-term retention</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User submits vote request</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">WAF passes geo-verified traffic to load balancer</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB routes voting request to frontend Fargate container service</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">ALB sends access logs to CloudWatch</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Backend service initializes session state and contestant list in MemoryDB</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="1">
      <data key="d8">1</data>
      <data key="d9">Fargate executes Lua script on MemoryDB to process vote, update counters, and check limits</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Fargate containers emit application logs to CloudWatch</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">MemoryDB returns voting outcome and remaining quota back to Fargate</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">VPN routes session management commands to private Fargate backend service</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Editorial team sends session open/close commands</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch streams logs into Kinesis Data Firehose</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Firehose writes log stream to S3 bucket for long-term storage</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Mediaset Amici Voting Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=QnwfcDZkwh8</data>
    <data key="d2">Architecture designed by Mediaset for handling spiky live TV show voting loads with latency under 10ms processing millions of votes.</data>
    <data key="d3">Media &amp; Entertainment, High-Throughput Voting System, Serverless</data>
    <data key="d4">True</data>
  </graph>
