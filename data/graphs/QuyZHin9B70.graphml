<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises BCS</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises Business Critical Services (e.g., SAP/Oracle) running with 100 TB raw capacity (reduced to 30 TB active data).</data>
    </node>
    <node id="1">
      <data key="d5">AWS Outposts</data>
      <data key="d6">Outpost</data>
      <data key="d7">Enables hybrid cloud on-premises deployment for regulatory compliance or low-latency requirements.</data>
    </node>
    <node id="2">
      <data key="d5">InfoScale</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Veritas InfoScale global clustered file system providing abstraction, migration, automated storage tiering, and cross-region replication.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Instance (Region 1)</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute layer running application workloads in Region 1.</data>
    </node>
    <node id="4">
      <data key="d5">EBS Volume (Region 1)</data>
      <data key="d6">EBS</data>
      <data key="d7">Used for high-performance and standard persistent block storage tiers.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Bucket (Region 1)</data>
      <data key="d6">S3</data>
      <data key="d7">Used as object storage tier for lower-frequency/archival data managed by InfoScale policy.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 Instance (Region 2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute layer for secondary failover/DR site in Region 2.</data>
    </node>
    <node id="7">
      <data key="d5">EBS Volume (Region 2)</data>
      <data key="d6">EBS</data>
      <data key="d7">Block storage for high-performance/standard persistent storage in Region 2.</data>
    </node>
    <node id="8">
      <data key="d5">S3 Bucket (Region 2)</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage tier for archival/cold storage in Region 2.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises data is replicated into the InfoScale global file system.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">InfoScale exposes the clustered file system to EC2 instances in Region 1.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">InfoScale replicates storage state to Region 2 EC2 instance layer for disaster recovery.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 writes performant and standard data blocks to EBS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">InfoScale policies automatically tier cold data from EC2 to S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Region 2 EC2 instance persists high-performance data to local EBS volumes.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Region 2 EC2 instance tiers cold storage to local S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Veritas InfoScale Migration and Cross-Region Disaster Recovery Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=QuyZHin9B70</data>
    <data key="d2">Veritas InfoScale provides clustered global file system management across on-premises, AWS Outposts, and multi-region AWS environments (Region 1 and Region 2), automating storage tiering between EBS and S3.</data>
    <data key="d3">Migration, Storage, Disaster Recovery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
