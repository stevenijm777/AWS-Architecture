    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Step Functions publishes job status events to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="13" id="0">
      <data key="d8">3</data>
      <data key="d9">Fargate container reads/writes data to Data Warehouse.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="14" id="0">
      <data key="d8">3</data>
      <data key="d9">Fargate container reads/writes data to S3.</data>
      <data key="d10">0'</data>
