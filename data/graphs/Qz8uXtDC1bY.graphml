  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developers, ML engineers, and analysts defining data jobs.</data>
    </node>
    <node id="1">
      <data key="d5">GitHub</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Code repository triggering Jenkins build process.</data>
    </node>
    <node id="2">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">User interface for slash commands and job status notifications.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives HTTP requests from Slack slash commands.</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Schedules CRON expressions for automated job runs.</data>
    </node>
    <node id="5">
      <data key="d5">Mgr Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Manager Lambda function picking job configs and starting Step Functions.</data>
    </node>
    <node id="6">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates container task execution and status tracking.</data>
    </node>
    <node id="7">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Serverless compute executing Docker containers for data jobs.</data>
    </node>
    <node id="8">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores container images generated by the CI/CD pipeline.</data>
    </node>
    <node id="9">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes job execution status updates for fan-out processing.</data>
    </node>
    <node id="10">
      <data key="d5">Audit Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Audits job execution results.</data>
    </node>
    <node id="11">
      <data key="d5">Slack Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Sends execution notifications and status back to Slack channels.</data>
    </node>
    <node id="12">
      <data key="d5">Dep Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Evaluates job dependencies and triggers downstream tasks.</data>
    </node>
    <node id="13">
      <data key="d5">WH</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data Warehouse storage engine accessed by data jobs.</data>
    </node>
    <node id="14">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage bucket for data processing inputs/outputs.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users commit code and configuration files into GitHub.</data>
