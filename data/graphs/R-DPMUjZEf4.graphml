<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Provides fixed public IP addresses per public subnet for client egress firewall whitelisting.</data>
    </node>
    <node id="1">
      <data key="d5">HAProxy EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Auto Scaling cluster running HAProxy to handle SSL termination for 10,000+ certificates.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer operating in TCP mode to pass through encrypted traffic to the application tier.</data>
    </node>
    <node id="3">
      <data key="d5">App EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Application layer running inside an EC2 Auto Scaling compute tier.</data>
    </node>
    <node id="4">
      <data key="d5">RDS Primary</data>
      <data key="d6">RDS</data>
      <data key="d7">Primary database instance (master) serving core application reads and writes.</data>
    </node>
    <node id="5">
      <data key="d5">RDS Secondary</data>
      <data key="d6">RDS</data>
      <data key="d7">Secondary database instance (slave) used for master-slave replication and reporting workloads.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB routes incoming external requests down to the HAProxy EC2 cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">HAProxy terminates SSL and forwards requests to the internal ELB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB passes TCP traffic to the App EC2 cluster.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">App instances query and write data to the Primary RDS database instance.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Replicating data from RDS Primary to RDS Secondary for high availability and reporting.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Logicworks HIPAA-Compliant Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=R-DPMUjZEf4</data>
    <data key="d2">A HIPAA-compliant architecture designed for heavily regulated environments, handling fixed IP whitelist requirements using NLB, 10,000+ SSL cert terminations using HAProxy on EC2, TCP-mode ELB pass-through, and RDS master-slave setup.</data>
    <data key="d3">Security &amp; Compliance, Healthcare, Web Applications</data>
    <data key="d4">True</data>
  </graph>
</graphml>
