<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores container images for the microservices running the ENN Service.</data>
    </node>
    <node id="1">
      <data key="d5">ENN SERVICE</data>
      <data key="d6">EC2</data>
      <data key="d7">Evolved Neural Networks service running microservices auto-scaled via Kubernetes (cops on AWS).</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores internal representations of candidate neural network architectures across evolutionary generations.</data>
    </node>
    <node id="3">
      <data key="d5">EXP HOST</data>
      <data key="d6">EC2</data>
      <data key="d7">Customer experiment host that orchestrates evaluations, provides domain/config code, and aggregates results.</data>
    </node>
    <node id="4">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue holding evaluation tasks for candidate network architectures.</data>
    </node>
    <node id="5">
      <data key="d5">STUDIO ML WORKERS</data>
      <data key="d6">EC2</data>
      <data key="d7">Cluster of worker nodes evaluating candidate neural network architectures.</data>
    </node>
    <node id="6">
      <data key="d5">DOMAIN DATA</data>
      <data key="d6">S3</data>
      <data key="d7">Customer training and domain data used by Studio ML Workers during candidate evaluation.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">ECR supplies microservice container images to ENN Service.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ENN Service persists internal representations of neural network architectures to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ENN Service returns generated candidate network graph specifications to Experiment Host.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Experiment Host requests new candidate network architectures from ENN Service.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Experiment Host pushes evaluation jobs into SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Studio ML workers pull evaluation tasks from SQS queue.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Studio ML workers fetch customer domain training data from S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cognizant Evolutionary AI Framework Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=RCWl0rf8lpE</data>
    <data key="d2">Architecture illustrating Cognizant's Evolved Neural Networks (ENN) platform running microservices on Kubernetes via AWS cops, interacting with a customer's AWS environment containing an experiment host, job queue, and ML worker cluster.</data>
    <data key="d3">AI/ML, Microservices, Batch Processing</data>
    <data key="d4">True</data>
  </graph>
