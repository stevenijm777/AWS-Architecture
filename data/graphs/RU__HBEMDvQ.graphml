  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SOURCES</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Includes transaction data, CRM data, clickstream data, and product data from various systems.</data>
    </node>
    <node id="1">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs auto-scaling transient clusters using spot instances to fetch, transform, and load data.</data>
    </node>
    <node id="2">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Serverless cataloging service for managing data lake metadata.</data>
