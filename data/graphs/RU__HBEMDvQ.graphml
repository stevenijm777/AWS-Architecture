    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake storing raw and processed data.</data>
    </node>
    <node id="4">
      <data key="d5">STEP FUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates EMR processing jobs.</data>
    </node>
    <node id="5">
      <data key="d5">QUICKSIGHT</data>
      <data key="d6">QuickSight</data>
      <data key="d7">BI tool used by business, product, and marketing teams for reporting and visualization.</data>
    </node>
    <node id="6">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse storing structured data for ad-hoc queries and reporting.</data>
    </node>
    <node id="7">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs ML models for user personalization and audience segmentation.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR fetches raw data from various transactional and product sources.</data>
      <data key="d10">0</data>
