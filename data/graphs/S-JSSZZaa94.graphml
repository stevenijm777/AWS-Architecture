<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Serves as the main entry point connecting external requests securely to internal VPC resources via VPC Link.</data>
    </node>
    <node id="1">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Network Load Balancer that routes incoming traffic to multiple application ports on EKS using target groups.</data>
    </node>
    <node id="2">
      <data key="d5">EKS (Top)</data>
      <data key="d6">EKS</data>
      <data key="d7">Managed Kubernetes cluster running microservice pods exposed via NodePort service definitions.</data>
    </node>
    <node id="3">
      <data key="d5">EKS (Bottom)</data>
      <data key="d6">EKS</data>
      <data key="d7">Managed Kubernetes cluster running microservice pods exposed via NodePort service definitions.</data>
    </node>
    <node id="4">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Receives log data streamed from CloudWatch for central log monitoring and Kibana visualization.</data>
    </node>
    <node id="5">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects infrastructure and service metrics, and ingests container logs pushed by Fluentd daemonsets.</data>
    </node>
    <node id="6">
      <data key="d5">AWS X-Ray</data>
      <data key="d6">XRay</data>
      <data key="d7">Used for application performance management and distributed microservice tracing.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes incoming client traffic to NLB via VPC Link.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB forwards requests to the top EKS cluster node ports.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB forwards requests to the bottom EKS cluster node ports.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Fluentd daemonset on top EKS cluster sends application logs to CloudWatch Logs.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Microservices in top EKS cluster send trace metadata to AWS X-Ray.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Fluentd daemonset on bottom EKS cluster sends application logs to CloudWatch Logs.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Microservices in bottom EKS cluster send trace metadata to AWS X-Ray.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch streams log data into Elasticsearch for indexing and search.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Samsung Health Microservices Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=S-JSSZZaa94</data>
    <data key="d2">Samsung Health handles over 35,000 requests per second using EKS microservices, NLB port forwarding via NodePorts, CloudWatch, Elasticsearch, and AWS X-Ray.</data>
    <data key="d3">Compute, Networking, Operations</data>
    <data key="d4">True</data>
  </graph>
</graphml>
