  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client Applications</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External client applications and chatbot interfaces.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API gatekeeper serving front-end queries and requests.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda Processing</data>
      <data key="d6">Lambda</data>
      <data key="d7">Orchestrates request processing, semantic search, context retrieval, and LLM prompting.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores chat state and user session data.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon OpenSearch Service</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Vector store database for indexing and semantic context retrieval.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Bedrock</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Generative AI service hosting Foundation Models / LLMs.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data ingestion landing bucket supporting flexible raw formats.</data>
    </node>
    <node id="7">
      <data key="d5">AWS Lambda ETL</data>
      <data key="d6">Lambda</data>
      <data key="d7">ETL process for extracting and transforming ingested data into embeddings.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Client applications issue API calls to Amazon API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway triggers Lambda Processing.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda Processing reads/writes session chat state in DynamoDB.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda Processing queries OpenSearch for vector context retrieval.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda Processing passes retrieved context and query to Amazon Bedrock LLM.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingested data is read from S3 by Lambda ETL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda ETL stores calculated vector embeddings in Amazon OpenSearch Service.</data>
      <data key="d10">1</data>
