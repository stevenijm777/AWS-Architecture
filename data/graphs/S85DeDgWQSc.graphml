<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Drone</data>
      <data key="d6">UserCompanyDrone</data>
      <data key="d7">Captures field imagery of utility assets from multiple angles.</data>
    </node>
    <node id="1">
      <data key="d5">Mobile Phone</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mounted in fleet vehicles, capturing images from consistent angles.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Cost-effective image repository holding ~4 million images, ingesting data daily including cross-account replication from vendor drones.</data>
    </node>
    <node id="3">
      <data key="d5">Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Used for detecting large assets like utility poles and cross arms.</data>
    </node>
    <node id="4">
      <data key="d5">Lookout For Vision</data>
      <data key="d6">LookoutForVision</data>
      <data key="d7">Identifies small assets (arresters, bushings) and detects damages.</data>
    </node>
    <node id="5">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries raw inference results in S3 and combines them with business logic.</data>
    </node>
    <node id="6">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">PostgreSQL database serving as the main data store for application predictions.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes application logic to fetch database records for presentation.</data>
    </node>
    <node id="8">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Provides REST API endpoints for downstream user applications.</data>
    </node>
    <node id="9">
      <data key="d5">End Users</data>
      <data key="d6">UserCompanyDomainExpert</data>
      <data key="d7">Knowledgeable users who identify false positives/negatives for feedback into model training.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Drone imagery uploaded into S3 via cross-account replication.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Fleet mobile phone imagery uploaded directly to S3.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Images sent to Rekognition for large asset detection.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Images passed to Lookout for Vision for small asset detection.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Large asset detection inference results made queryable via Athena.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Small asset and damage detection results queried via Athena.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Athena writes refined inference predictions into Aurora.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda reads prediction data from Aurora PostgreSQL.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda sends data payloads to API Gateway.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway presents inference predictions to End Users.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">SDG&amp;E Intelligent Image Processing (IIP)</data>
    <data key="d1">https://www.youtube.com/watch?v=S85DeDgWQSc</data>
    <data key="d2">Architecture for SDG&amp;E's Intelligent Image Processing solution, utilizing machine learning models to identify utility assets and damage from drone and fleet mobile phone imagery.</data>
    <data key="d3">AI/ML, Utilities, Data Processing</data>
    <data key="d4">True</data>
  </graph>
