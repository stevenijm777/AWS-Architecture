<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">E-Scooter</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Cellular IoT device reporting coordinates and battery level.</data>
    </node>
    <node id="1">
      <data key="d5">MNO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Visited Mobile Network Operator (540+ operators in 180+ countries).</data>
    </node>
    <node id="2">
      <data key="d5">IPX</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">IP Exchange global private network for cellular roaming.</data>
    </node>
    <node id="3">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">UDP Network Load Balancer receiving GTP CreateSession requests.</data>
    </node>
    <node id="4">
      <data key="d5">ECS Control Plane</data>
      <data key="d6">ECS</data>
      <data key="d7">Control plane application managing GTP session creation and policy lookups.</data>
    </node>
    <node id="5">
      <data key="d5">Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Connects IPX carriers to AWS VPC for secure roaming traffic.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 User Plane</data>
      <data key="d6">EC2</data>
      <data key="d7">Packet gateway cluster performing accounting, firewall, and high-speed packet processing.</data>
    </node>
    <node id="7">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores SIM configurations and security policies.</data>
    </node>
    <node id="8">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">REST API for device configuration, provisioning, and portal access.</data>
    </node>
    <node id="9">
      <data key="d5">Customer Backend</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Customer application server hosted on AWS or on-premises.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">E-Scooter requests cellular network connection via visited MNO.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="1">
      <data key="d8">2</data>
      <data key="d9">E-Scooter transmits status and location telemetry data.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">MNO forwards GTP CreateSession request to NLB.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">MNO routes user packet tunnel over IPX network.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">IPX forwards user data into AWS Direct Connect.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB balances GTP session request to ECS Control Plane.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CreateSession response containing assigned IP address sent back to MNO.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Control Plane reads SIM configuration and security rules from Aurora.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Control Plane pushes user plane IP routing details to EC2 packet gateways.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Direct Connect delivers packet traffic to EC2 User Plane.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 User Plane processes firewall/accounting and forwards data to Customer Backend.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway updates SIM profiles in Aurora DB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer Backend provisions devices and defines security policies via API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">EMnify Cellular IoT Cloud Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=SC6n6J8Bi58</data>
    <data key="d2">Architecture showing how EMnify connects global cellular IoT devices to customer backends using AWS control and user plane infrastructure.</data>
    <data key="d3">telecom</data>
    <data key="d4">True</data>
  </graph>
</graphml>
