<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2 Gateway</data>
      <data key="d6">EC2</data>
      <data key="d7">Public gateway EC2 instance running Apache Guacamole for secure user login.</data>
    </node>
    <node id="1">
      <data key="d5">AD</data>
      <data key="d6">DirectoryService</data>
      <data key="d7">Directory Service / Active Directory used to authenticate users and pass user role information.</data>
    </node>
    <node id="2">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Amazon EMR running analytics processing jobs and providing compute, secured via Apache Ranger.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores converted Parquet datasets, encrypted at rest and in transit.</data>
    </node>
    <node id="4">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">AWS KMS providing key management for data encryption across S3 and RDS.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS instance storing metadata and relational data encrypted via KMS.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 Sandbox</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 compute nodes in the secure sandbox environment running tools like RStudio, JupyterHub, and Hue.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 Gateway authenticates incoming user sessions using Directory Service (AD).</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR reads and processes Parquet data from S3 storage.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 interacts with KMS for dataset encryption and decryption key operations.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">KMS provides encryption keys to secure data residing in RDS.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 Sandbox instances read data from S3 for localized analytics tools.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">NHS Digital Data Access Environment</data>
    <data key="d1">https://www.youtube.com/watch?v=SSWwnNVYi_Q</data>
    <data key="d2">NHS Digital built a secure data access environment on AWS to migrate from legacy systems. Internal teams log into a gateway EC2 running Apache Guacamole and authenticate via Active Directory. Once inside the secure sandbox, users analyze datasets stored in Parquet format on S3 using EMR and sandbox EC2 nodes with tools like RStudio, JupyterHub, and Hue, with Apache Ranger providing fine-grained access control and KMS encrypting all data.</data>
    <data key="d3">Analytics &amp; Big Data, Security &amp; Governance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
