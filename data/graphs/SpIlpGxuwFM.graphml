<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Dev</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developer persona who commits code to the NWM CDK repository to kick off the build and deployment pipeline.</data>
    </node>
    <node id="1">
      <data key="d5">AWS CDK</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">NWM CDK framework extending AWS CDK to automate validation, security checks, and deployment of infrastructure patterns.</data>
    </node>
    <node id="2">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Front-end entry point for the deployed API-driven architecture pattern.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes application business logic, interacts with DynamoDB, and sends logs/metrics to CloudWatch.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database storing application data requested by the Lambda function.</data>
    </node>
    <node id="5">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects logs and metric errors from Lambda, triggers SNS alarms, and streams logs via subscriptions.</data>
    </node>
    <node id="6">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes alert notifications from CloudWatch to target destinations such as email or Slack hooks.</data>
    </node>
    <node id="7">
      <data key="d5">KINESIS DATA STREAMS</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Receives CloudWatch log subscription streams to feed log data into an ELK stack for developer analysis.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer commits infrastructure definition to NWM CDK repo, initiating GitLab CI build pipeline.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CDK deploy step builds and provisions the API-driven template pattern in AWS.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway receives client HTTP requests and forwards them to Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda queries or persists data in DynamoDB to process request payloads.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda automatically emits execution logs and error metrics down to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch alarm triggers SNS notification on function error or alert thresholds.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch log subscription feeds application logs into Kinesis Data Streams for ELK ingestion.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Northwestern Mutual Serverless CDK Pipeline and API Pattern</data>
    <data key="d1">https://www.youtube.com/watch?v=SpIlpGxuwFM</data>
    <data key="d2">Architecture showing Northwestern Mutual's custom CDK deployment pipeline and standard API pattern with built-in logging and alerting.</data>
    <data key="d3">Serverless, DevOps, Logging &amp; Monitoring</data>
    <data key="d4">True</data>
  </graph>
</graphml>
