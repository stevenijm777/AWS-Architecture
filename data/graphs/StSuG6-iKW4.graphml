<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Vehicle Device</data>
      <data key="d6">UserCompanyEdge</data>
      <data key="d7">Retrofit telematics device installed in connected vehicles, capturing real-time driving and collision data.</data>
    </node>
    <node id="1">
      <data key="d5">IOT</data>
      <data key="d6">IoTCore</data>
      <data key="d7">AWS IoT Core ingesting billions of daily telemetry points; utilizes IoT Rules Engine, IoT Defender, and Certificate Manager.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda Process</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes immediate collision events to determine accident severity and trigger response workflows.</data>
    </node>
    <node id="3">
      <data key="d5">Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Amazon Connect acts as a voice router contacting drivers via in-car device or mobile phone.</data>
    </node>
    <node id="4">
      <data key="d5">AGENT</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Human call center agent receiving escalations when driver/passengers require live assistance or emergency support.</data>
    </node>
    <node id="5">
      <data key="d5">Customer</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Individual vehicle driver/customer contacted on mobile device during or after an incident.</data>
    </node>
    <node id="6">
      <data key="d5">STEP FUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates multi-step accident management workflows based on collision type and customer responses.</data>
    </node>
    <node id="7">
      <data key="d5">LEX</data>
      <data key="d6">Lex</data>
      <data key="d7">Amazon Lex bot capturing driver statements via voice interactions to select the appropriate Step Functions pathway.</data>
    </node>
    <node id="8">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores comprehensive accident reports, telemetry reconstructions, sensor graphs, and call transcripts.</data>
    </node>
    <node id="9">
      <data key="d5">Lambda Utility</data>
      <data key="d6">Lambda</data>
      <data key="d7">Backend processing lambda handling post-incident reporting and data storage operations.</data>
    </node>
    <node id="10">
      <data key="d5">REKOGNITION</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Analyzes incident video clip feeds (12 seconds before/after) for license plate recognition, fraud detection, and content filtering.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Vehicle retrofit device sends telematics data and collision metrics to AWS IoT Core.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Rules Engine evaluates incoming data and triggers Lambda function upon detecting accident.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda invokes Amazon Connect to initiate outreach call.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda triggers Step Functions orchestration workflow simultaneously.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Connect places call directly into vehicle's retrofit audio hardware.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Connect dials customer's mobile phone if driver has exited vehicle.</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Connect hands off driver call to human agent if injury or high severity is detected.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lex interprets caller responses and invokes corresponding Step Function branch.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Thingco Next-Gen Telematics and Accident Response Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=StSuG6-iKW4</data>
    <data key="d2">System processes billions of daily data points from connected vehicle retrofit devices to detect accidents in real time, automate voice-based response via Amazon Lex/Connect, orchestrate workflows with Step Functions, and analyze incident footage with Rekognition.</data>
    <data key="d3">Automotive, IoT, Serverless, AI/ML</data>
    <data key="d4">True</data>
  </graph>
</graphml>
