  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Device</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile client accessing Sisense analytics dashboard</data>
    </node>
    <node id="1">
      <data key="d5">Dashboard</data>
      <data key="d6">UserCompanyWebsite</data>
      <data key="d7">Sisense BI dashboard UI displaying graphs and filters</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer routing client query traffic to EKS cluster</data>
    </node>
    <node id="3">
      <data key="d5">EKS Cluster</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS managing containerized query and ingestion microservices</data>
    </node>
    <node id="4">
      <data key="d5">EC2 Worker Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker nodes running container workloads with pod and node auto-scaling</data>
    </node>
    <node id="5">
      <data key="d5">On-Prem Database</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Customer on-premises source database</data>
    </node>
    <node id="6">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Amazon Athena querying raw data stored in S3 source buckets</data>
    </node>
    <node id="7">
      <data key="d5">Redshift (Source)</data>
      <data key="d6">RedShift</data>
      <data key="d7">Source Redshift database inside customer VPC</data>
    </node>
    <node id="8">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">AWS Glue cataloging and preparing data sources</data>
    </node>
    <node id="9">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS database source</data>
    </node>
    <node id="10">
      <data key="d5">S3 Bucket (Source)</data>
      <data key="d6">S3</data>
      <data key="d7">Source data S3 bucket queried via Athena</data>
    </node>
    <node id="11">
      <data key="d5">FSx for Lustre</data>
      <data key="d6">FSX</data>
      <data key="d7">High-throughput shared storage for hot data and ElastiCube in-memory database files</data>
    </node>
    <node id="12">
      <data key="d5">S3 Bucket (Backup)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket for FSx for Lustre persistence, replication, and disaster recovery</data>
    </node>
    <node id="13">
      <data key="d5">Redshift (Data Warehouse)</data>
      <data key="d6">RedShift</data>
      <data key="d7">Target Redshift cluster storing massive warm data (terabytes) for direct query</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Dashboard sends query requests to ELB</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
