    <edge source="4" target="13" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 workers directly query massive warm data stored in target Redshift DW</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Data ingested directly from customer on-premises database to EC2 compute</data>
      <data key="d10">1'</data>
