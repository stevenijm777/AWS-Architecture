      <data key="d11">data</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">FSx for Lustre automatically backs up and syncs data to backup S3 bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
