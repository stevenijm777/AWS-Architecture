      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS schedules containerized pod workloads onto EC2 instances</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="11" id="0">
      <data key="d8">2</data>
