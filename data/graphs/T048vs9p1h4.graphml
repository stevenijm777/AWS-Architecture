<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Primary API endpoint receiving job submission requests from trading platforms (e.g., Murex).</data>
    </node>
    <node id="1">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Pub/Sub topic fanning out job execution tasks to priority queues.</data>
    </node>
    <node id="2">
      <data key="d5">SQS (HIGH)</data>
      <data key="d6">SQS</data>
      <data key="d7">High priority message queue reserved for trader job submissions.</data>
    </node>
    <node id="3">
      <data key="d5">SQS (MED)</data>
      <data key="d6">SQS</data>
      <data key="d7">Medium priority message queue reserved for back-office user submissions.</data>
    </node>
    <node id="4">
      <data key="d5">SQS (LOW)</data>
      <data key="d6">SQS</data>
      <data key="d7">Low priority message queue reserved for batch calculation jobs.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA (300)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function execution layer allocated with a provisioned concurrency of 300 for high priority tasks.</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA (200)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function execution layer allocated with a provisioned concurrency of 200 for medium priority tasks.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA (100)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function execution layer allocated with a provisioned concurrency of 100 for low priority tasks.</data>
    </node>
    <node id="8">
      <data key="d5">S3 (INPUT)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores non-sensitive input computation data.</data>
    </node>
    <node id="9">
      <data key="d5">EFS (BINARY)</data>
      <data key="d6">EFS</data>
      <data key="d7">Shared file storage mounted on Lambda instances to store heavy financial model binaries, avoiding cold starts.</data>
    </node>
    <node id="10">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">High-throughput NoSQL database storing calculation results and tracking Lambda execution status.</data>
    </node>
    <node id="11">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Centralized search and analytics store for aggregating Lambda logs for end-to-end monitoring.</data>
    </node>
    <edge source="0" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway writes non-sensitive job input data to S3 (INPUT).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers job distribution via SNS.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS routes high priority trader requests to SQS (HIGH).</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS routes medium priority back-office requests to SQS (MED).</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS routes low priority batch requests to SQS (LOW).</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS (HIGH) triggers Lambda instances configured with provisioned concurrency 300.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS (MED) triggers Lambda instances configured with provisioned concurrency 200.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS (LOW) triggers Lambda instances configured with provisioned concurrency 100.</data>
      <data key="d10">0''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">LAMBDA (300) writes trade calculation output and execution status to DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">LAMBDA (300) sends log telemetry to Elasticsearch for monitoring.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">LAMBDA (200) writes trade calculation output and execution status to DynamoDB.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">LAMBDA (200) sends log telemetry to Elasticsearch for monitoring.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">LAMBDA (100) writes trade calculation output and execution status to DynamoDB.</data>
      <data key="d10">2''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">LAMBDA (100) sends log telemetry to Elasticsearch for monitoring.</data>
      <data key="d10">0''</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EFS (BINARY) file system mounted directly to Lambda functions to provide model binaries.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DBS Bank Serverless Compute Grid Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=T048vs9p1h4</data>
    <data key="d2">Serverless compute grid architecture used by DBS Bank to process pricing for exotic option trades.</data>
    <data key="d3">Serverless, Compute Grid, Financial Services</data>
