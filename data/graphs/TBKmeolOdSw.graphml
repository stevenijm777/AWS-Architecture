  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End users consuming the React single page application and REST APIs.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN distribution providing secure worldwide access to the React web app.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing the static React single page application assets.</data>
    </node>
    <node id="3">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer exposing REST APIs to end users.</data>
    </node>
    <node id="4">
      <data key="d5">FARGATE</data>
      <data key="d6">Fargate</data>
      <data key="d7">AWS ECS Fargate running containerized microservices.</data>
    </node>
    <node id="5">
      <data key="d5">EFS</data>
      <data key="d6">EFS</data>
      <data key="d7">Elastic File System providing managed persistent storage for stateful containers.</data>
    </node>
    <node id="6">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Amazon Aurora Postgres database running on Graviton CPUs.</data>
    </node>
    <node id="7">
      <data key="d5">IOT SENSOR</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises/field temperature monitoring sensors streaming data via 3G/4G.</data>
    </node>
    <node id="8">
      <data key="d5">S2S VPN</data>
      <data key="d6">S2SVPN</data>
      <data key="d7">Site-to-Site VPN connection from 3G/4G connectivity providers.</data>
    </node>
    <node id="9">
      <data key="d5">TRANSIT GW</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Central networking hub routing traffic across accounts and connectivity channels.</data>
    </node>
    <node id="10">
      <data key="d5">CLIENT VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">AWS Client VPN for secure remote administration.</data>
    </node>
    <node id="11">
      <data key="d5">User</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Admin users accessing system resources remotely.</data>
    </node>
