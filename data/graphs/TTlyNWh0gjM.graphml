<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-user browsers running web applications where the beacon script is executed.</data>
    </node>
    <node id="1">
      <data key="d5">CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Content Delivery Network serving the beacon data collection script to user browsers.</data>
    </node>
    <node id="2">
      <data key="d5">R53</data>
      <data key="d6">Route53</data>
      <data key="d7">DNS service routing traffic to CDN and regional ALBs.</data>
    </node>
    <node id="3">
      <data key="d5">ALB (Collectors)</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer distributing incoming telemetry metric requests to collector instances.</data>
    </node>
    <node id="4">
      <data key="d5">COLLECTORS</data>
      <data key="d6">EC2</data>
      <data key="d7">Auto-scaled EC2 instances that receive incoming metrics from users and push them to SQS.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Message queue decoupling data collection from asynchronous processing.</data>
    </node>
    <node id="6">
      <data key="d5">DASHBOARD</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Monitoring UI/dashboard used by operators to view real-time performance and application health.</data>
    </node>
    <node id="7">
      <data key="d5">ALB (Processors)</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer receiving dashboard API requests and routing them to processors.</data>
    </node>
    <node id="8">
      <data key="d5">PROCESSORS</data>
      <data key="d6">EC2</data>
      <data key="d7">Auto-scaled EC2 instances responsible for metric calculations, caching with Redis, and writing/reading from Cassandra.</data>
    </node>
    <node id="9">
      <data key="d5">REDIS</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory cache layer used by processors during real-time metric computations.</data>
    </node>
    <node id="10">
      <data key="d5">CASSANDRA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Multi-AZ Cassandra database cluster storing processed telemetry and user monitoring metrics.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User browser requests and downloads the Beacon monitoring script via CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Beacon script sends collected browser/device performance data to collector ALB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards telemetry requests to collector EC2 instances.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Collectors buffer and enqueue collected metrics into SQS queue.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Processor EC2 instances pull raw metrics from SQS queue.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Dashboard queries real-time analytics data via processor ALB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">ALB routes dashboard queries to processor nodes to query Cassandra.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Processors read/write intermediate state in Redis cache.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Processors persist computed metrics to Cassandra database.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Zoho Site247 Real User Monitoring Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=TTlyNWh0gjM</data>
    <data key="d2">Site247 processes 25M to 50M requests per day (up to 50k requests/min at peak) using auto-scaled EC2 collectors and processors with SQS, Redis caching, and multi-AZ Cassandra storage.</data>
    <data key="d3">Monitoring, Real User Monitoring, Auto Scaling, Web Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
