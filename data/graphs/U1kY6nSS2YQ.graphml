  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Provisions MS360 infrastructure and backing service components.</data>
    </node>
    <node id="1">
      <data key="d5">Jenkins</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Handles continuous deployment and provisions application software into EKS and EC2.</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs containerized microservices implementing core business logic.</data>
    </node>
    <node id="3">
      <data key="d5">Prometheus</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Open-source monitoring tool aggregating workload metrics within the MS360 environment.</data>
    </node>
    <node id="4">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs monolithic or less modular application workloads.</data>
    </node>
    <node id="5">
      <data key="d5">CouchBase</data>
      <data key="d6">CouchBase</data>
      <data key="d7">NoSQL persistent database backing service.</data>
    </node>
    <node id="6">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational SQL database backing service.</data>
    </node>
    <node id="7">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Event streaming and messaging platform backing service.</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Log indexing and search platform backing service.</data>
    </node>
    <node id="9">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Provides centralized visualization and monitoring metrics view.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation provisions the container infrastructure for EKS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
