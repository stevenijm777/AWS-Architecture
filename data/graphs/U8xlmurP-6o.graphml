<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudHSM (Company A)</data>
      <data key="d6">CloudHSM</data>
      <data key="d7">Manages private keys securely in a separate VPC exposed via PrivateLink.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 (Company A)</data>
      <data key="d6">EC2</data>
      <data key="d7">Company A server initiating withdrawal requests.</data>
    </node>
    <node id="2">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Per-currency service entry point for withdrawal requests.</data>
    </node>
    <node id="3">
      <data key="d5">Withdrawal Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes withdrawal logic for the target cryptocurrency.</data>
    </node>
    <node id="4">
      <data key="d5">Docker Container</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Blockchain node container participating in the cryptocurrency network.</data>
    </node>
    <node id="5">
      <data key="d5">EBS Volume</data>
      <data key="d6">EBS</data>
      <data key="d7">Persists blockchain block data with regular snapshots to enable fast node catch-up.</data>
    </node>
    <node id="6">
      <data key="d5">Deposit Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes incoming transaction/block data from the Docker blockchain node.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores transaction and block data, streaming updates upon changes.</data>
    </node>
    <node id="8">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes block notifications to company services.</data>
    </node>
    <node id="9">
      <data key="d5">Company B Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Consumer service endpoint receiving deposit block notifications.</data>
    </node>
    <node id="10">
      <data key="d5">CloudHSM (Company B)</data>
      <data key="d6">CloudHSM</data>
      <data key="d7">Private key management for Company B.</data>
    </node>
    <node id="11">
      <data key="d5">EC2 (Company B)</data>
      <data key="d6">EC2</data>
      <data key="d7">Company B application server instance.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudHSM secures private key operations for Company A.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Company A sends a withdrawal request to the currency API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Withdrawal Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Withdrawal Lambda submits transfer request to Docker node.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Docker container passes block and transaction data to Deposit Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">EBS Volume provides persistent block data storage for Docker container.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Deposit Lambda writes transaction/block data to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB stream triggers SNS block notifications.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS notifies Company B service Lambda of new deposit blocks.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudHSM manages private keys for Company B EC2 instance.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Simplex Cryptocurrency Wallet System Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=U8xlmurP-6o</data>
    <data key="d2">Multi-tenant, multi-currency cryptocurrency wallet architecture using serverless and AWS CloudHSM for secure private key management.</data>
    <data key="d3">Financial Services</data>
    <data key="d4">True</data>
  </graph>
