  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon S3 (Input)</data>
      <data key="d6">S3</data>
      <data key="d7">Ingests raw documentary files and splits them into speaker-specific JSON chunks.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Translates speaker transcript files across target languages.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Bedrock (Idiom)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Detects and translates idioms and slang (English-to-English adaptation).</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Bedrock (Sentence Shortening)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Shortens localized text to fit strict video timing and dubbing windows.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Bedrock (Cultural)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Checks script for regional grammar nuances and cultural sensitivities.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Polly</data>
      <data key="d6">Polly</data>
      <data key="d7">Converts localized text scripts into speech audio files.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Augmented AI</data>
      <data key="d6">SageMakerGroundTruth</data>
      <data key="d7">Provides human translators a platform for spot-checking and quality assurance.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3 (Output)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores final localized output files including video, audio, and captions.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates data movement and execution steps across all pipeline services.</data>
    </node>
    <node id="9">
      <data key="d5">AWS CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Deploys CDK infrastructure stacks to spin up parallel processing nodes.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Speaker JSON files sent from input S3 bucket to Amazon Translate.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Translated text sent to Amazon Bedrock for idiom detection.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Idiom-adapted text sent to Amazon Bedrock for sentence shortening.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Shortened text passed to Amazon Bedrock for cultural sensitivity review.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Final localized script passed to Amazon Polly for text-to-speech generation.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Generated speech audio files passed to Amazon Augmented AI for human quality check.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Approved video, audio, and caption files written to destination S3 bucket.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Step Functions triggers and orchestrates execution sequence across pipeline.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFormation provisions batch computing nodes for Step Functions orchestration.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">MagellanTV Content Localization Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=UPV6ggX4eSE</data>
    <data key="d2">Automates video content localization from $20/min down to ~$1/min using generative AI (Bedrock), translation, speech synthesis (Polly), and human review (A2I).</data>
    <data key="d3">Data &amp; Analytics, Machine Learning &amp; AI, Media &amp; Localization</data>
    <data key="d4">True</data>
  </graph>
