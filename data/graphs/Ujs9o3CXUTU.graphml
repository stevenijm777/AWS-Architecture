  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing incoming traffic to backend containers.</data>
    </node>
    <node id="1">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Amazon ECS running containerized Node.js backend application tasks.</data>
    </node>
    <node id="2">
      <data key="d5">DocumentDB</data>
      <data key="d6">DocumentDB</data>
      <data key="d7">Amazon DocumentDB storing JSON metadata, hyperparameter settings, dataset stats, and user accounts.</data>
    </node>
    <node id="3">
      <data key="d5">ElastiCache for Redis</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Amazon ElastiCache for Redis used for pub/sub queues and Socket.io coordination between containers.</data>
    </node>
    <node id="4">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">AWS Glue performing managed data transformation and dataset profiling.</data>
    </node>
    <node id="5">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Amazon EMR running legacy big data processing tasks.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 storing raw and transformed customer datasets encrypted at rest.</data>
    </node>
    <node id="7">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">AWS Service Catalog provisioning isolated AWS accounts per customer.</data>
    </node>
    <node id="8">
      <data key="d5">Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">AWS Control Tower enforcing security guardrails across customer accounts.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes incoming requests directly to ECS containers.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS writes and queries metadata, statistics, and hyperparameters in DocumentDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS connects to ElastiCache for Redis to coordinate tasks via pub/sub queues.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Data transformation workloads are transitioned from EMR to AWS Glue.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions customer accounts governed by Control Tower guardrails.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Telef#323nica Tech AI Suite Architecture</data>
