<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Datastore 1</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External IT system sending file uploads to S3.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3 Data storage</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake bucket receiving file uploads and emitting S3 events to trigger data loading.</data>
    </node>
    <node id="2">
      <data key="d5">Datastore 2</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External application exposing REST APIs polled by Lambda.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda Pull Data</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function that polls Datastore 2 REST APIs and inserts pulled data into Redshift.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Central columnar database composed of 11 clusters spread across 3 global regions for customer data isolation.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">EventBridge Scheduler running batch jobs to extract data from Redshift and drive outbound processes.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends email reports triggered by batch jobs.</data>
    </node>
    <node id="7">
      <data key="d5">AWS Transfer</data>
      <data key="d6">TransferFamily</data>
      <data key="d7">AWS Transfer Family SFTP instance used to publish data files to internal/external destinations.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Backend API Lambda querying Redshift on behalf of the customer web application.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN distribution hosting the Angular web application, integrated with Keycloak authentication and WAF.</data>
    </node>
    <node id="10">
      <data key="d5">Customers</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-user customers accessing the web application to view metrics and generate reports.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Datastore 1 sends data files directly into S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 events trigger Lambda to load ingested file data into Redshift.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda polls REST API endpoint on Datastore 2.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda inserts pulled REST API data into Redshift.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">EventBridge scheduler runs batch queries against Redshift.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">EventBridge triggers report distribution via SES email.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">EventBridge batch job publishes exported data to AWS Transfer SFTP instance.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Backend Lambda executes queries against Amazon Redshift to retrieve reporting data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Angular web frontend forwards requests to backend AWS Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Customers navigate to Angular web app hosted on CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Xylem Data Lake Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=UpVF8jMB4yY</data>
    <data key="d2">Serverless event-driven IoT data lake architecture for Xylem smart metering networks.</data>
    <data key="d3">Analytics, Data Lake, Serverless, IoT</data>
    <data key="d4">True</data>
  </graph>
</graphml>
