<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Production House</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External third-party metadata producer.</data>
    </node>
    <node id="1">
      <data key="d5">CBS Upstream Systems</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Internal CBS source systems providing metadata.</data>
    </node>
    <node id="2">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Front-end entry endpoint for the Unique ID generation service.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless function that processes metadata and generates unique identifiers.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Key-value database storing generated unique IDs and metadata records.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue holding messaging notifications for generated unique IDs.</data>
    </node>
    <node id="6">
      <data key="d5">Content Orchestration</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom system creating asset shells, running quality checks, and ingesting video assets.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central media asset store with lifecycle policies to Glacier and Deep Archive.</data>
    </node>
    <node id="8">
      <data key="d5">EC2 ASG</data>
      <data key="d6">EC2</data>
      <data key="d7">Message bus running on EC2 Auto Scaling Group behind an Application Load Balancer for multi-protocol translation.</data>
    </node>
    <node id="9">
      <data key="d5">Playout</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Downstream playout service retrieving content from S3.</data>
    </node>
    <node id="10">
      <data key="d5">Scheduling</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Downstream scheduling platform receiving distribution messaging.</data>
    </node>
    <node id="11">
      <data key="d5">SAT</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Satellite distribution system for global linear delivery.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Production House sends metadata to Unique ID service API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CBS Upstream Systems send metadata to Unique ID service API Gateway.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Lambda function for ID processing.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes unique ID details into DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda pushes unique ID generation message to SQS.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS delivers unique ID event to Content Orchestration to construct asset shell.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Content Orchestration scans, quality checks, and writes finished content to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 message bus notifies Playout system of available assets.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 message bus notifies Scheduling system of available assets.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Playout streams content out to Satellite.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">CBS Cloud-Based Media Supply Chain</data>
    <data key="d1">https://www.youtube.com/watch?v=UsngU-HjH_Q</data>
    <data key="d2">CBS media supply chain architecture featuring automated Unique ID generation via API Gateway, Lambda, and DynamoDB, decoupled via SQS to Content Orchestration and S3, with a message bus built on EC2 ASG routing to Playout and Satellite.</data>
    <data key="d3">Media &amp; Entertainment, Serverless, Messaging</data>
    <data key="d4">True</data>
  </graph>
</graphml>
