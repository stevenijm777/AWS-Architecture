<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End-user customers accessing e-commerce website or digital care channels.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Acts as entry point and manages traffic stickiness to specific stack regions.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts self-managed Kubernetes cluster running application microservices.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Caches dynamic customer context data retrieved from internal domains.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database persisting active customer cart transactions within the local stack.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon OpenSearch Service</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Indexes non-transactional catalog, product, and promotional search data.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Real-time data stream capturing cart changes asynchronously.</data>
    </node>
    <node id="7">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes stream events from Kinesis and updates cross-region datastores.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Global table storing replicated cart state across regions for rehydration.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User interacts with the e-commerce web platform via API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes request with stickiness to self-managed Kubernetes application on EC2.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Application populates and retrieves customer context data in ElastiCache.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Application stores full active transaction and cart state into RDS.</data>
      <data key="d10">2''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Application asynchronously streams cart changes to Kinesis without blocking request.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis triggers Lambda function in real-time.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda writes cart state to DynamoDB Global Table for cross-region hydration.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">T-Mobile Digital Commerce Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=V6rYfjJG3BE</data>
    <data key="d2">Multi-region active-passive architecture using API Gateway sticky routing, self-managed K8s on EC2, ElastiCache, RDS, and DynamoDB Global Tables with Kinesis and Lambda for asynchronous real-time cart state sync across US East and US West regions.</data>
    <data key="d3">Multi-Region Resilient E-Commerce Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
