<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Devices</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Tablets, desktops, and mobile phones used by students and parents.</data>
    </node>
    <node id="1">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives JSON formatted behavioral event data from student devices.</data>
    </node>
    <node id="2">
      <data key="d5">FIREHOSE</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers streaming data and invokes transformation Lambda at set intervals.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA (Data Transformation)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms streaming data using enrichment records from DynamoDB and Aurora.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores app installation info for fast key-value lookups.</data>
    </node>
    <node id="5">
      <data key="d5">AURORA (Top)</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores learning content and quiz metadata for indexed queries.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores transformed raw data and classified objects organized by type and date.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA (Classification)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 object creation to classify objects based on context attributes.</data>
    </node>
    <node id="8">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Crawls S3 metadata and executes PySpark ETL scripts on schedule.</data>
    </node>
    <node id="9">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse used for learning evaluation and usage analytics.</data>
    </node>
    <node id="10">
      <data key="d5">STEP FUNCTION</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates analysis Lambda functions in sequence.</data>
    </node>
    <node id="11">
      <data key="d5">LAMBDA (Analysis)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes analytics workflows reading from Redshift and writing results to Aurora.</data>
    </node>
    <node id="12">
      <data key="d5">AURORA (Service DB)</data>
      <data key="d6">Aurora</data>
      <data key="d7">Dedicated service database serving AI learning record results to user devices.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User devices send student behavioral event data in JSON format to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway streams data payloads directly to Kinesis Data Firehose.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose invokes Lambda at batch intervals for inline data transformation.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose delivers transformed data objects into S3 storage.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformation Lambda queries installed app information from DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformation Lambda queries learning contents and quiz metadata from Aurora.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">New S3 object creation triggers the Classification Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">AWS Glue crawls and reads classified data partitions from S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Classification Lambda uploads classified data objects back to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue PySpark ETL job loads processed data into Amazon Redshift.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Step Functions workflow reads analytics data from Redshift.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Step Functions orchestrates execution of multiple analysis Lambda functions.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">3</data>
      <data key="d9">Analysis Lambda functions write analyzed learning records into Aurora Service DB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="12" target="0" id="0">
      <data key="d8">3</data>
      <data key="d9">Aurora Service DB serves AI learning record results to student tablets, parent mobile apps, and web.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">i-Scream EDU AI Learning Record Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=VJZsgsY_sXY</data>
    <data key="d2">Architecture processes behavioral data from student learning tablets via Kinesis Firehose, S3, Glue, Redshift, and Step Functions to power the AI Learning Record service.</data>
    <data key="d3">Data Lake, Real-time Streaming, Serverless ETL, AI Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
