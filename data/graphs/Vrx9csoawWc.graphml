<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Analyst in market regulation issuing queries against FINRA data.</data>
    </node>
    <node id="1">
      <data key="d5">DATA MGMT ETL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data management and ETL processing pipeline.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Multi-petabyte S3 bucket holding analytics copy of gold source data.</data>
    </node>
    <node id="3">
      <data key="d5">HIVE EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR cluster running Hive to pair down lake data into data marts.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Data Mart</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing materialized data mart subsets for analytical querying.</data>
    </node>
    <node id="5">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">ECS container service orchestrating query processing, data mart jobs, and engine selection.</data>
    </node>
    <node id="6">
      <data key="d5">PRESTO EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR cluster running Presto engine for interactive, low-complexity queries.</data>
    </node>
    <node id="7">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Redshift cluster used for high-complexity, large row-count queries with multi-dataset joins.</data>
    </node>
    <edge source="0" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">User submits analytical query request to ECS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DATA MGMT ETL copies ingested data into S3 Data Lake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Hive EMR reads source data from S3 Data Lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Hive EMR creates and writes materialized Data Mart subset to S3 Data Mart.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS kicks off Hive job on EMR cluster (labeled 1).</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS inspects Data Mart complexity (row counts, columns, file sizes) (labeled 2).</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS signals Presto EMR for low-complexity query execution (labeled 2).</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS signals Redshift for high-complexity query execution (labeled 2).</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Presto EMR pulls data directly from S3 Data Mart.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Redshift pulls data directly from S3 Data Mart.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">FINRA Analytics Data Lake Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Vrx9csoawWc</data>
    <data key="d2">FINRA processes up to 135 billion daily market events using AWS analytics tools, dynamically selecting Presto EMR or Redshift based on query complexity.</data>
    <data key="d3">Analytics, Data Lake</data>
    <data key="d4">True</data>
  </graph>
</graphml>
