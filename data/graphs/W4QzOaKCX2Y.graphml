<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Edge Network</data>
      <data key="d6">UserCompanyEdge</data>
      <data key="d7">Global DNS resolvers generating 530B daily transactions and ~400k compressed files (~20TB).</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3 (Ingest)</data>
      <data key="d6">S3</data>
      <data key="d7">Ingest bucket for raw compressed DNS exhaust log files uploaded from edge locations.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon SNS (Ingest)</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives object creation notifications from S3 Ingest bucket.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon SQS (Transformer)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues file processing notifications for the transformer worker instances.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon EC2 Auto Scaling (Transformer)</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Extracts, enhances, and converts compressed raw files into optimized Parquet format.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon S3 (Warehouse)</data>
      <data key="d6">S3</data>
      <data key="d7">Warehouse storage containing partitioned Parquet tables for raw and aggregated data with lifecycle policies.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon SNS (Warehouse)</data>
      <data key="d6">SNS</data>
      <data key="d7">Triggers notifications when raw transformed Parquet data arrives in the warehouse.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon SQS (Aggregator)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues raw Parquet warehouse arrival notifications for aggregator workers.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon EC2 (Aggregator)</data>
      <data key="d6">EC2</data>
      <data key="d7">Aggregates microsecond-level data into minute, hour, and day table granularities.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon RDS (Tracking)</data>
      <data key="d6">RDS</data>
      <data key="d7">Database tracking state and metadata for ingestion/processing operations.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Serverless query engine reading S3 warehouse data with query execution isolation.</data>
    </node>
    <node id="11">
      <data key="d5">Consumers</data>
      <data key="d6">UserConsumerAPI</data>
      <data key="d7">Internal reporting users and external API customers executing queries against Athena.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Edge network uploads compressed DNS exhaust log files to S3 Ingest bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 triggers event notification to SNS upon file upload.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS forwards notification to SQS Transformer queue.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Auto Scaling EC2 Transformer workers pull processing jobs from SQS.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformers output processed Parquet files to S3 Warehouse.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 Warehouse sends event notification to SNS on raw Parquet arrival.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS forwards notification to SQS Aggregator queue.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Aggregator instances consume tasks from SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries data stored in S3 Warehouse tables.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Consumers issue queries through Amazon Athena.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Verkara Global DNS Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=W4QzOaKCX2Y</data>
    <data key="d2">Architecture ingests DNS exhaust logs (~530B daily transactions, ~20TB compressed) from global edge locations into S3, transforms compressed data into Parquet using EC2 Auto Scaling, aggregates microsecond-level records into minute/hour/day tables, and provides Athena query isolation for consumers.</data>
    <data key="d3">Data Analytics, Compute, Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
