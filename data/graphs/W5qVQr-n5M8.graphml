<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Bucket (Uploads)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket where customer transaction files are uploaded.</data>
    </node>
    <node id="1">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Job queue holding file upload notifications.</data>
    </node>
    <node id="2">
      <data key="d5">CloudWatch Event</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Scheduled rule triggering Lambda queue checker every 5 minutes.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda (Queue Checker)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Inspects SQS queue and triggers Step Functions workflow.</data>
    </node>
    <node id="4">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Manages execution, waiting, retries, and task orchestration.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Intermediate)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Intermediate function invoked by Step Functions to launch EC2.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">Windows Server 2016 instance running batch processing.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Bucket (Config)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores software dependencies and configuration data for instance initialization.</data>
    </node>
    <node id="8">
      <data key="d5">SQL Server</data>
      <data key="d6">RDS</data>
      <data key="d7">Database storing batch processing results for reporting and case management.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 bucket sends file upload event notification to SQS queue.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch event periodically invokes Queue Checker Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda polls SQS queue for unprocessed upload jobs.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda initiates Step Functions workflow execution.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Step Functions triggers Intermediate Lambda to launch processing instance.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda provisions and launches on-demand Windows EC2 instance.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 communicates task status and execution back to Step Functions.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 writes batch job output to SQL Server database.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 downloads dependencies and configuration from S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">FICO Serverless &amp; On-Demand Batch Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=W5qVQr-n5M8</data>
    <data key="d2">FICO's batch workflow uses S3, SQS, CloudWatch, Lambda, Step Functions, EC2 (Windows), and SQL Server (RDS) to perform compliance checks on customer uploaded transaction files.</data>
    <data key="d3">Batch Processing, Event-Driven Architecture, Compliance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
