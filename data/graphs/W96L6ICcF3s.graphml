<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Handles incoming domain DNS routing for the portal.</data>
    </node>
    <node id="1">
      <data key="d5">GIT</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Version control system repository.</data>
    </node>
    <node id="2">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Amazon Elastic Container Registry holding task container images.</data>
    </node>
    <node id="3">
      <data key="d5">Frontend ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Frontend Elastic Load Balancer distributing user traffic.</data>
    </node>
    <node id="4">
      <data key="d5">Frontend ECS/Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Frontend container tasks running on serverless AWS Fargate compute.</data>
    </node>
    <node id="5">
      <data key="d5">Backend ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Backend Elastic Load Balancer facilitating communications to backend tasks.</data>
    </node>
    <node id="6">
      <data key="d5">Backend ECS/Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Backend container tasks managing Samsung Developer Portal microservices.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Route 53 routes incoming client requests to Frontend ELB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Pushes container images from GIT repository to ECR.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Frontend requests are communicated down to Backend ELB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Samsung Developer Portal Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=W96L6ICcF3s</data>
    <data key="d2">Samsung Developer Portal manages over 15 microservices on AWS Fargate and Amazon ECS, achieving a 44.5% cost reduction compared to EC2 clusters.</data>
    <data key="d3">Microservices, Serverless Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
