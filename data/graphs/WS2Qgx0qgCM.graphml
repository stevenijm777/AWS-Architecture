<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Control Plane</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Kubernetes control plane running on a separate EC2 host that injects cryptographically signed service account tokens into pods.</data>
    </node>
    <node id="1">
      <data key="d5">Kubernetes EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker node host instances running multi-tenant Kubernetes pods.</data>
    </node>
    <node id="2">
      <data key="d5">Pods</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Kubernetes pods isolated in specific namespaces (e.g., foo namespace) requesting fine-grained IAM permissions.</data>
    </node>
    <node id="3">
      <data key="d5">STS</data>
      <data key="d6">STS</data>
      <data key="d7">AWS Security Token Service that validates signed pod tokens and issues temporary credentials.</data>
    </node>
    <node id="4">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">AWS IAM storing role definitions and trust policies that restrict role assumption to specific pod namespaces.</data>
    </node>
    <node id="5">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">AWS CloudTrail collecting audit events for token creation and role assumption.</data>
    </node>
    <node id="6">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Elasticsearch log analytics cluster used by engineers for access visibility, troubleshooting, and automated alerting.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Control plane injects cryptographically signed service account tokens into pods.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Pod sends signed service account token to STS for verification.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Pod specifies designated IAM role (e.g., foo) to assume based on namespace identity.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">STS verifies token validity and checks IAM policy rules against pod namespace and name.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">STS returns temporary IAM credentials back to the pod upon successful validation.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">STS emits token creation and role assumption events to CloudTrail.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudTrail streams event logs into Elasticsearch for central auditing and automated error alerting.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Airbnb Fine-Grained Pod IAM Authentication Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=WS2Qgx0qgCM</data>
    <data key="d2">Architecture detailing fine-grained IAM role access for multi-tenant Kubernetes pods on EC2 using custom signed token injection, STS validation, and CloudTrail/Elasticsearch auditing.</data>
    <data key="d3">Security, Compute, Logging</data>
    <data key="d4">True</data>
  </graph>
</graphml>
