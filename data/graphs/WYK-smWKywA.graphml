  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Retail investors accessing the SGX investor portal web application.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">AWS CloudFront CDN serving static frontend artifacts.</data>
    </node>
    <node id="2">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF protecting CloudFront with security rules and IP filtering.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA@EDGE</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Lambda@Edge for edge compute, custom routing, and security headers.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 storing static web assets, encrypted with KMS.</data>
    </node>
    <node id="5">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Amazon API Gateway serving as the backend entry point with mutual TLS / client certs.</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda authorizer executing step zero authentication checks.</data>
    </node>
    <node id="7">
      <data key="d5">ELASTICACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Amazon ElastiCache for storing and validating active session state.</data>
    </node>
    <node id="8">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancing distributing authenticated API requests to backend EC2 services.</data>
    </node>
    <node id="9">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Amazon EC2 hosting microservices that manage user sessions and business logic.</data>
    </node>
    <node id="10">
      <data key="d5">DX</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">AWS Direct Connect providing dedicated connectivity between AWS VPC and on-premises DC.</data>
    </node>
    <node id="11">
      <data key="d5">DC</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises Data Center hosting legacy exchange core backends and databases.</data>
    </node>
    <edge source="0" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">User browser sends session and API requests to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront serves static single page application assets back to the user's web browser.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront triggers Lambda@Edge for edge routing and inserting security headers.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront retrieves web artifacts from S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF filters and protects traffic entering CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes Lambda authorizer as step zero authentication.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway forwards authenticated requests to ELB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda authorizer checks session state in ElastiCache.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">ELB routes API requests to backend microservices on EC2.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 microservices read and write session data in ElastiCache.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Direct Connect links AWS backend services to the on-premises Data Center.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Singapore Exchange Investor Portal Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=WYK-smWKywA</data>
    <data key="d2">Architecture for SGX's investor portal using AWS CloudFront, Lambda@Edge, API Gateway, Lambda authorizer, ElastiCache, EC2, and Direct Connect for hybrid integration with the on-premises data center.</data>
    <data key="d3">Fintech / Capital Markets</data>
    <data key="d4">True</data>
  </graph>
