<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web applications generating tracking and supply chain user events.</data>
    </node>
    <node id="1">
      <data key="d5">Mobile Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile applications used at facilities, doorsteps, and by end-customers.</data>
    </node>
    <node id="2">
      <data key="d5">SERVICES</data>
      <data key="d6">ECS</data>
      <data key="d7">Fleet of microservices built on containers and serverless stack handling client traffic. Integrates KPL thrift-based client with &lt;15ms response time.</data>
    </node>
    <node id="3">
      <data key="d5">KINESIS</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Receives streaming events directly from services using KPL micro-batching and protocol buffers.</data>
    </node>
    <node id="4">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Scales up automatically to process incoming Kinesis streams and fan out distribution.</data>
    </node>
    <node id="5">
      <data key="d5">ES</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Elasticsearch cluster receiving processed real-time events for search and analytics.</data>
    </node>
    <node id="6">
      <data key="d5">MONGODB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Core transactional event store recording all package, facility, and shipment state changes.</data>
    </node>
    <node id="7">
      <data key="d5">KAFKA</data>
      <data key="d6">MSK</data>
      <data key="d7">Event streaming platform receiving transactions from MongoDB.</data>
    </node>
    <node id="8">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes event notifications to client SMS services and downstream microservice subscribers.</data>
    </node>
    <node id="9">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake storing all historical supply chain events.</data>
    </node>
    <node id="10">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Public entry point serving external requests such as shipment updates, cancellations, and tracking.</data>
    </node>
    <node id="11">
      <data key="d5">ORDER MGMT</data>
      <data key="d6">ECS</data>
      <data key="d7">Order Management service processing CRUD logic on order transactions.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Web apps send traffic and event data directly to services.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile apps send traffic and event data directly to services.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Services push application events to Kinesis via KPL.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Services write transactional package events into MongoDB event store.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis stream invokes Lambda functions for processing.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda functions deliver transformed event data to Elasticsearch.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">MongoDB transaction updates stream into Kafka.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka consumers fan out processed events to SNS for client notifications and downstream subscribers.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS consumers push raw event stream from Kafka into S3 data lake.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway routes external order tracking and update calls to Order Management.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Order Management performs CRUD database operations on MongoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Delhivery Logistics Event Processing and Data Lake Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=WZ4YL4Z177Q</data>
    <data key="d2">Delhivery processes over 100 million events daily across 3,000+ facilities. The system combines real-time event streaming for analytics, transactional event storage in MongoDB fanning out via Kafka to an S3 data lake and SNS notifications, and external API entry via API Gateway.</data>
    <data key="d3">Analytics, Serverless, Data Lake</data>
    <data key="d4">True</data>
  </graph>
</graphml>
