<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Scheduled Lambda Functions</data>
      <data key="d6">Lambda</data>
      <data key="d7">Scheduled Lambda functions that trigger and spin up EC2 instances to process incoming application binaries at scale.</data>
    </node>
    <node id="1">
      <data key="d5">AWS KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Provides customer-unique encryption keys to secure application binaries stored at rest in S3.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores customer application binaries securely at rest with KMS key encryption.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Analysis Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Spun up in dynamic compute sizes to perform static analysis and build software vulnerability graphs within seconds or minutes.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores analysis state, process metadata, and historical result data (over 10.5 trillion lines of code scanned).</data>
    </node>
    <node id="5">
      <data key="d5">AWS Batch</data>
      <data key="d6">Batch</data>
      <data key="d7">Scours public internet repositories continuously 24/7 to pull commit and defect ticket data for open source vulnerability assessment.</data>
    </node>
    <node id="6">
      <data key="d5">Docker Containers</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Executes deep learning machine learning containers/pipelines to evaluate true positive vulnerabilities in open source components.</data>
    </node>
    <node id="7">
      <data key="d5">Internet Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External repositories and issue tracking platforms including GitHub, GitLab, and Jira.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Scheduled Lambda function spins up EC2 instances based on incoming analysis workload.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 leverages AWS KMS customer-specific keys to encrypt binaries at rest.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 instance stores received binaries into the S3 bucket for analysis.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 writes state information and scan results into DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Batch pulls commit and issue data from public internet sources.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Batch triggers deep learning ML pipelines running in Docker containers.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Veracode Static Analysis and Open Source Vulnerability Scanning Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Wk9mCHyjtBU</data>
    <data key="d2">Architecture powering Veracode static code analysis and open source vulnerability detection using AWS compute and machine learning.</data>
    <data key="d3">Security, Compute, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
