  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Webex Services/Applications</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Internal Webex client applications making LLM requests.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon EKS Cloud (LLM Proxy)</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts the central LLM Proxy application, providing authentication, request normalization, and logging.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Internal hosted machine learning models on SageMaker endpoints.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Bedrock</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Managed AI service for foundational models.</data>
    </node>
    <node id="4">
      <data key="d5">External LLM Providers</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party external LLM APIs outside AWS.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Managed Streaming for Apache Kafka (Amazon MSK)</data>
      <data key="d6">MSK</data>
      <data key="d7">Ingests real-time telemetry, operational metrics, and logs from LLM Proxy.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Simple Storage Service (Amazon S3)</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake storage for raw and processed operational metrics.</data>
    </node>
    <node id="7">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">ETL and metadata cataloging for the data lake.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query engine for cost optimization and operational analytics.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Webex applications send API requests with standardized auth and consent flags to the LLM Proxy.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Proxy routes requests to Amazon SageMaker endpoints.</data>
      <data key="d10">1a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Proxy routes requests to Amazon Bedrock models.</data>
      <data key="d10">1b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Proxy routes requests to external LLM providers.</data>
      <data key="d10">1c</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Proxy streams usage metrics, latency, and operational telemetry to MSK.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">MSK delivers streamed log data to S3 data lake storage.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue catalogs data stored in S3.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries Glue catalog metadata and S3 object data for operational insights.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Cisco Webex LLM Proxy Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=WojdRyYDvDM</data>
    <data key="d2">Architectural transcription of Cisco's LLM Proxy handling request routing to multiple LLM providers and streaming metrics/logs into an AWS Data Lake.</data>
    <data key="d3">Machine Learning, Analytics, Cloud Infrastructure</data>
    <data key="d4">True</data>
  </graph>
