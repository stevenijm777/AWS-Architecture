<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">User interacts with the Alexa app on mobile while travelling.</data>
    </node>
    <node id="1">
      <data key="d5">Alexa for Business</data>
      <data key="d6">AlexaForBusiness</data>
      <data key="d7">Enterprise Alexa service managing user authentication and routing voice commands.</data>
    </node>
    <node id="2">
      <data key="d5">PM Skill Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function processing voice skill requests, querying databases, and returning synthesized responses.</data>
    </node>
    <node id="3">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Aurora MySQL database storing program status metrics and risk performance models.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Key-value database mapping program acronyms to phonetic strings for clear Alexa reading.</data>
    </node>
    <node id="5">
      <data key="d5">Data Ingestion Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function triggered by S3 uploads to format and insert program status data into RDS.</data>
    </node>
    <node id="6">
      <data key="d5">PM Data S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket receiving Excel extracts for program management status data.</data>
    </node>
    <node id="7">
      <data key="d5">Abbreviations S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket receiving Excel extracts for program acronyms and abbreviations.</data>
    </node>
    <node id="8">
      <data key="d5">Abbreviations Ingestion Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function triggered by S3 uploads to convert acronym spreadsheet data into DynamoDB key-value pairs.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile app sends user voice requests to Alexa for Business.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Alexa for Business triggers the PM Skill Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">PM Skill Lambda queries program status data from RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">PM Skill Lambda checks DynamoDB for acronym pronunciation formatting.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS returns program status records to PM Skill Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Data Ingestion Lambda parses Excel data into columnar format and inserts it into RDS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 upload event triggers the Data Ingestion Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 upload event triggers the Abbreviations Ingestion Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Abbreviations Ingestion Lambda creates key-value pairs and writes them to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Lockheed Martin Program Management Voice Assistant</data>
    <data key="d1">https://www.youtube.com/watch?v=Wur1GWB03hk</data>
    <data key="d2">Voice-enabled application architecture allowing Lockheed Martin executives to check program statuses on mobile devices using Alexa for Business, Lambda, Aurora RDS, DynamoDB, and S3.</data>
    <data key="d3">Voice Assistant, Serverless, Data Ingestion</data>
    <data key="d4">True</data>
  </graph>
</graphml>
