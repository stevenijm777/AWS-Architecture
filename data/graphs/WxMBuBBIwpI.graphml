<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">WEB REQUESTS</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">External web traffic sending over 150 billion requests per day.</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer receiving 150 billion web requests daily and balancing across Spot Fleet instances in multiple AZs and regions.</data>
    </node>
    <node id="2">
      <data key="d5">SPOT FLEET</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Spot Fleet deployed across multiple Availability Zones and regions to handle web requests efficiently.</data>
    </node>
    <node id="3">
      <data key="d5">EBS</data>
      <data key="d6">EBS</data>
      <data key="d7">Local EBS volumes where spot instances record ~600TB of uncompressed log data daily.</data>
    </node>
    <node id="4">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs the containerized 'Spot Savior' service that mounts orphaned EBS drives after spot instance retirement to complete log processing.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Target object storage receiving over 17 million processed log files daily.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Web traffic sends 150B requests per day to ELB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB distributes web requests across Spot Fleet instances.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Spot Fleet instances log processed request data to local EBS volumes.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Orphaned EBS drives from terminated spot instances are mounted by ECS containers ('Spot Savior').</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS processes remaining log data and uploads over 17M files daily to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Nextroll Spot Savior Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=WxMBuBBIwpI</data>
    <data key="d2">Nextroll processes over 150B web requests daily using a Spot Fleet behind ELB. Logs (600TB uncompressed daily) are written to local EBS drives. When Spot instances terminate unexpectedly, an ECS container service ('Spot Savior') mounts orphaned EBS volumes, processes data according to manifest files, and uploads over 17 million files daily to S3.</data>
    <data key="d3">Compute, Storage, Networking</data>
    <data key="d4">True</data>
  </graph>
</graphml>
