  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DATA SOURCES</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Fetches paid datasets, public APIs, and manual data entries (~7TB/day).</data>
    </node>
    <node id="1">
      <data key="d5">FETCHER ASG</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling Group containing microservices responsible for fetching raw data.</data>
    </node>
    <node id="2">
      <data key="d5">DATA STORES</data>
      <data key="d6">RDS</data>
      <data key="d7">Data stores hosting Kafka and Elasticsearch on EC2.</data>
    </node>
    <node id="3">
      <data key="d5">PIPELINE ASG</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling Group running pipeline APIs for deduplication using NLP and ML.</data>
    </node>
    <node id="4">
      <data key="d5">CUSTOMER ASG</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling Group hosting customer-facing APIs serving ~25k requests per minute.</data>
    </node>
    <node id="5">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB table storing ~90 million cached records with TTL expiration.</data>
    </node>
    <node id="6">
      <data key="d5">CACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Redis / ElastiCache cluster used for aggressive data caching.</data>
    </node>
    <node id="7">
      <data key="d5">DATA EXCHANGE</data>
      <data key="d6">DataExchange</data>
      <data key="d7">AWS Data Exchange used to share processed demand intelligence data.</data>
    </node>
    <node id="8">
      <data key="d5">SNOWFLAKE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Snowflake data platform for sharing demand data with enterprise customers.</data>
    </node>
    <node id="9">
      <data key="d5">CONTROL CENTER</data>
      <data key="d6">UserCompanyWebsite</data>
      <data key="d7">Web application UI allowing customers to visualize and manipulate data.</data>
    </node>
    <node id="10">
      <data key="d5">DEVELOPERS</data>
      <data key="d6">UserConsumerDeveloper</data>
      <data key="d7">Developers consuming raw APIs directly.</data>
    </node>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Fetcher ASG fetches raw data (~7TB/day) from external data sources.</data>
