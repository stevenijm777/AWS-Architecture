<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User (Initiator)</data>
      <data key="d6">UserConsumerAPI</data>
      <data key="d7">Client application initiating prediction request with callback URL.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives initial API request to select service and callback setup.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda (Request Processor)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Generates prediction ID, writes DynamoDB record, and generates pre-signed S3 URL.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores transaction tracking records and callback metadata.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores input vehicle photos and final generated estimate outputs.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates parallel and sequential execution of AI ensemble model steps.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs asynchronous prediction endpoints for AI models.</data>
    </node>
    <node id="7">
      <data key="d5">AWS Lambda (Callback / Token Return)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles completion notifications, returns task tokens to Step Functions, and triggers user callbacks.</data>
    </node>
    <node id="8">
      <data key="d5">User (Receiver)</data>
      <data key="d6">UserConsumerAPI</data>
      <data key="d7">Client application receiving callback and downloading final estimates.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Step 1: User sends request with desired service and callback URL.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Step 2: User uploads vehicle claim photos directly to S3 using pre-signed URL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes initiation request to Request Processor Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda creates tracking record with prediction ID in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Returns pre-signed S3 upload URL back via API Gateway to bypass payload limits.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda looks up DynamoDB step configuration and invokes Step Functions execution.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 bucket event listener triggers Lambda on photo upload completion.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Step 9: User downloads final line-level estimate output directly from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Steps 3-7: Step Functions invokes SageMaker asynchronous endpoints for AI models.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">SageMaker notifies Callback Lambda upon prediction completion.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda returns task token to Step Functions to proceed to the next step in the ensemble.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Callback Lambda queries DynamoDB to retrieve original callback URL upon ensemble completion.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Step 8: Lambda calls original user callback URL with pre-signed S3 download URL.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">CCC Estimate STP Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=XCnul-AjrNU</data>
    <data key="d2">Handles ~4.1 million transactions per week using asynchronous SageMaker model endpoints orchestrated by Step Functions.</data>
    <data key="d3">AI/ML, Serverless Data Pipeline, Claim Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
