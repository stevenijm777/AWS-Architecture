<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerDeveloper</data>
      <data key="d7">Customers, partners, or third-party fintech developers requesting a banking sandbox.</data>
    </node>
    <node id="1">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Amazon Elastic Container Registry containing Docker images for microservices.</data>
    </node>
    <node id="2">
      <data key="d5">AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">Pre-baked Amazon Machine Images used to build the sandbox EC2 infrastructure.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Central management plane that automates infrastructure provisioning and orchestrates sandbox deployment.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket containing static configuration files and infrastructure resources.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 (Top Sandbox)</data>
      <data key="d6">EC2</data>
      <data key="d7">Provisioned customer sandbox EC2 instance running OpenShift cluster and Oracle Database.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 (Bottom Sandbox)</data>
      <data key="d6">EC2</data>
      <data key="d7">Additional provisioned customer sandbox EC2 instance.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests a new sandbox account environment.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS pulls Docker images from ECR.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS references AMIs to instantiate compute nodes.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS provisions and builds the primary customer EC2 sandbox.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS provisions additional customer EC2 sandboxes as needed.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS fetches static configuration resources from S3.</data>
      <data key="d10">1''</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Avaloq Bank in a Box Automated Sandbox Provisioning Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=XG6mHvi4eNU</data>
    <data key="d2">Automated sandbox environment provisioning system using EKS to spin up isolated customer bank sandboxes on EC2.</data>
    <data key="d3">Compute, Containers, Automation</data>
    <data key="d4">True</data>
  </graph>
