  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Car</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Collects autonomous driving data on-road or on test tracks and uploads it to S3 via local staging.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw drive data collected from vehicles.</data>
    </node>
    <node id="2">
      <data key="d5">FSx for Lustre</data>
      <data key="d6">FSX</data>
      <data key="d7">High-performance parallel file system automatically synchronized with S3 bucket data.</data>
    </node>
    <node id="3">
      <data key="d5">Python Script</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Executed by data scientists to initiate catalog provisioning with parameter constraints.</data>
    </node>
    <node id="4">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Validates permissions and constraints to present pre-approved ML cluster products.</data>
    </node>
    <node id="5">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Deploys requested GPU cluster infrastructure automatically.</data>
    </node>
    <node id="6">
      <data key="d5">GPU Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Ephemeral P3/P3dn EC2 cluster running PyTorch in Auto Scaling Groups.</data>
    </node>
    <node id="7">
      <data key="d5">ML Model</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Output trained model artifact used for autonomous driving capabilities.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Drive data uploaded from vehicle into S3.</data>
