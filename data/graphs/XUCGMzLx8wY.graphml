<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2 (Airflow)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance running Apache Airflow, acting as a workflow manager to trigger daily model training.</data>
    </node>
    <node id="1">
      <data key="d5">KAFKA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Kafka cluster providing streaming data for model training and real-time user reaction data.</data>
    </node>
    <node id="2">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Amazon SageMaker used for training ML recommendation models daily.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function acting as a reverse proxy to dynamically allocate prediction traffic.</data>
    </node>
    <node id="4">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Amazon ECS cluster hosting recommender model containers (m1, m2, m3) and the Multi-Armed Bandit (MAB) container.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing trained model artifacts exported from SageMaker.</data>
    </node>
    <node id="6">
      <data key="d5">AMAZON ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Amazon ECR storing model API container images used by ECS.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Airflow on EC2 triggers the daily model training workflow in SageMaker.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kafka streams user interaction and training data into SageMaker.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka streams real-time user reaction data to the Multi-Armed Bandit (MAB) container in ECS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker stores completed model outputs in S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda proxy allocates incoming prediction requests across model containers (m1, m2, m3) in ECS based on assigned weights.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The MAB container periodically recalculates dynamic weights and updates the Lambda reverse proxy.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 delivers model artifacts to assemble model API containers in ECS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon ECR provides API container images to the ECS cluster.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">MyTona ML Offer Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=XUCGMzLx8wY</data>
    <data key="d2">MyTona ML Offer is an in-game purchase recommendation architecture. It uses SageMaker triggered by Airflow on EC2 for model training, S3 and ECR for model/image delivery, ECS for model API and Multi-Armed Bandit hosting, Kafka for streaming reaction data, and Lambda as a reverse proxy for dynamic traffic allocation.</data>
    <data key="d3">Mobile Gaming, Machine Learning, Traffic Allocation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
