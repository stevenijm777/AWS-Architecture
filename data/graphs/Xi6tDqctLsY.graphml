<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts static frontend web application assets.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Content Delivery Network serving web application assets to user browsers.</data>
    </node>
    <node id="2">
      <data key="d5">SALARY OVERFLOW</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Client web application interface rendering salary data in browser.</data>
    </node>
    <node id="3">
      <data key="d5">PINPOINT</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">Tracks application metrics, user sessions, and authentication events.</data>
    </node>
    <node id="4">
      <data key="d5">APPSYNC</data>
      <data key="d6">AppSync</data>
      <data key="d7">GraphQL API endpoint allowing flexible queries and mutations.</data>
    </node>
    <node id="5">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Amazon Aurora MySQL relational database storing user and salary data.</data>
    </node>
    <node id="6">
      <data key="d5">COGNITO</data>
      <data key="d6">Cognito</data>
      <data key="d7">Cognito User Pools providing user authentication.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by Cognito on first login to create new user records in Aurora.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 bucket provides web assets to CloudFront CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront serves the frontend web application to the client browser.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Web app sends user credentials to Cognito for authentication.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Web client sends GraphQL queries and mutations to AppSync.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Web app sends session metrics and usage analytics to Pinpoint.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">AppSync queries and updates relational data stored in Aurora database.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Cognito triggers Lambda function upon new user signup.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda function inserts new user record into Aurora MySQL database.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Salary Overflow Serverless Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Xi6tDqctLsY</data>
    <data key="d2">Salary Overflow is a platform built with AWS Amplify to bring transparency to tech salaries and combat gender pay gaps. It uses S3, CloudFront, Cognito, Lambda, Aurora MySQL, AppSync, and Pinpoint.</data>
    <data key="d3">Web Application, Serverless, Authentication, Data Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
