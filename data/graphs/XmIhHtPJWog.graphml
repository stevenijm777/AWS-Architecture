  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS CONFIG</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">Monitors AWS resource configurations continuously for compliance.</data>
    </node>
    <node id="1">
      <data key="d5">GUARDDUTY</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Intelligent threat detection service continuously monitoring account behavior.</data>
    </node>
    <node id="2">
      <data key="d5">ACCESS ANALYZER</data>
      <data key="d6">AccessAnalyzer</data>
      <data key="d7">IAM Access Analyzer checking permission scopes and access policies.</data>
    </node>
    <node id="3">
      <data key="d5">FARGATE (PROWLER)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs scheduled Prowler containers to perform ISO 27001 compliance scans.</data>
    </node>
    <node id="4">
      <data key="d5">PLATFORM ENGINEER</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Inspects findings in Security Hub and triggers remediation actions.</data>
    </node>
    <node id="5">
      <data key="d5">SECURITY HUB</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Central single-pane-of-glass repository for all security findings and compliance posture.</data>
    </node>
    <node id="6">
      <data key="d5">EVENTBRIDGE</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Routes finding events to trigger targeted remediation workflows.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">50+ automated remediation functions resolving security findings.</data>
    </node>
    <node id="8">
      <data key="d5">SEC OPS ENGINEER</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Security Operations Engineer managing incidents in ServiceNow.</data>
    </node>
    <node id="9">
      <data key="d5">SERVICE NOW</data>
      <data key="d6">ServiceNow</data>
      <data key="d7">Central Incident Management platform integrated bi-directionally with AWS Security Hub.</data>
    </node>
    <edge source="0" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Config ingests resource configuration findings into Security Hub.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">GuardDuty ingests threat detection findings into Security Hub.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">IAM Access Analyzer ingests policy evaluation findings into Security Hub.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Prowler running on Fargate sends ISO 27001 compliance findings to Security Hub.</data>
      <data key="d10">0'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Platform Engineer reviews finding exposure in Security Hub and triggers custom remediation.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Security Hub publishes finding event to EventBridge.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Security Hub exports cloud security findings to ServiceNow.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EventBridge rule triggers Lambda remediation function based on finding type.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">SecOps Engineer creates and manages incidents in ServiceNow.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">ServiceNow pushes updates and incident resolution status back into Security Hub.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">HDI Continuous Compliance and Automated Remediation Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=XmIhHtPJWog</data>
    <data key="d2">HDI architecture for continuous scanning, compliance monitoring (ISO 27001), automated remediation using Lambda, and ServiceNow incident management integration across 20+ AWS accounts.</data>
    <data key="d3">Security &amp; Compliance, Continuous Remediation, Multi-Account Governance</data>
    <data key="d4">True</data>
  </graph>
