  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DATA SOURCE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">20+ real-time external and operational data sources producing ~40TB daily.</data>
    </node>
    <node id="1">
      <data key="d5">DATABASE</data>
      <data key="d6">RDS</data>
      <data key="d7">Operational transactional database environment.</data>
    </node>
    <node id="2">
      <data key="d5">CLOUDFORMATION</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Triggers and deploys acquisition and ingestion pipelines based on triggers, events, or time.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Used for messaging, exception handling, and logging during pipeline execution.</data>
    </node>
    <node id="4">
      <data key="d5">REDSHIFT (Ingestion)</data>
      <data key="d6">RedShift</data>
      <data key="d7">Ingestion warehouse instance kicked off by CloudFormation.</data>
    </node>
    <node id="5">
      <data key="d5">ANALYSIS</data>
      <data key="d6">S3</data>
      <data key="d7">S3 abstraction layer for R&amp;D and preliminary analysis.</data>
    </node>
    <node id="6">
      <data key="d5">REDSHIFT (Serving)</data>
      <data key="d6">RedShift</data>
      <data key="d7">Serving data warehouse layer for downstream consumers.</data>
    </node>
    <node id="7">
      <data key="d5">STEP FUNCTION</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates complex business logic, rules, and branching workflows.</data>
    </node>
    <node id="8">
      <data key="d5">CORE</data>
      <data key="d6">S3</data>
      <data key="d7">S3 abstraction layer for core strategic enterprise data.</data>
    </node>
    <node id="9">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Used for data ingestion, transformation, loading, and Glue Data Catalog.</data>
    </node>
    <node id="10">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless execution for lightweight real-time event processing.</data>
    </node>
    <node id="11">
      <data key="d5">INSIGHTS</data>
      <data key="d6">S3</data>
      <data key="d7">S3 abstraction layer for data science and advanced analytics.</data>
    </node>
    <node id="12">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker and SageMaker Notebooks used for scoring data and machine learning.</data>
    </node>
    <node id="13">
      <data key="d5">User</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Business analysts and end consumers consuming operational insights.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Operational data feeds into operational database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Database syncs updates back to operational systems.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFormation triggers/deploys the Redshift ingestion pipeline.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFormation triggers Step Functions orchestration.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFormation triggers Lambda execution.</data>
      <data key="d10">0''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS logs exception messages and manages pipeline execution states.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Ingestion Redshift outputs data to the ANALYSIS S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Data from ANALYSIS S3 is loaded into serving Redshift.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="13" id="0">
      <data key="d8">2</data>
      <data key="d9">Serving Redshift delivers queries and reports to analyst users.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Step Functions orchestrate transformations into CORE S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">AWS Glue catalogs and processes data from CORE S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Glue writes transformed data back to CORE S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">4</data>
      <data key="d9">Lambda processes events into INSIGHTS S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">4</data>
      <data key="d9">INSIGHTS S3 feeds data into SageMaker for model scoring.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">HealthFirst Serverless Data and Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=XpFNznmRoQ0</data>
    <data key="d2">Data platform processing 20+ data sources and ~40TB daily using serverless abstraction layers (Analysis, Core, Insights).</data>
    <data key="d3">Analytics, Serverless, AI/ML</data>
    <data key="d4">True</data>
