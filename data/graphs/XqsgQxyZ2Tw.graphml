<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ECS (Ingestion)</data>
      <data key="d6">ECS</data>
      <data key="d7">Cleans, processes, and prepares incoming website user events for stream and batch storage.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores historical event data files used for long-term retention and EMR batch jobs.</data>
    </node>
    <node id="2">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Central streaming backbone connecting ingestion, aggregation, profiling, and serving components.</data>
    </node>
    <node id="3">
      <data key="d5">EMR (AGG+ML)</data>
      <data key="d6">EMR</data>
      <data key="d7">Dynamically spawned EMR clusters running ML and batch aggregation on S3 data.</data>
    </node>
    <node id="4">
      <data key="d5">ECS (AGG+ML)</data>
      <data key="d6">ECS</data>
      <data key="d7">Computes user attributes from event data streams in real time.</data>
    </node>
    <node id="5">
      <data key="d5">Couchbase (AGG+ML)</data>
      <data key="d6">CouchBase</data>
      <data key="d7">Database storing aggregated user attributes and features.</data>
    </node>
    <node id="6">
      <data key="d5">ECS (Profile)</data>
      <data key="d6">ECS</data>
      <data key="d7">Combines user attributes from aggregation components to create profiles and audience groups.</data>
    </node>
    <node id="7">
      <data key="d5">Couchbase / Elasticsearch (Profile)</data>
      <data key="d6">CouchBase</data>
      <data key="d7">Storage for combined user profiles and audience criteria representations.</data>
    </node>
    <node id="8">
      <data key="d5">ECS (Serving)</data>
      <data key="d6">ECS</data>
      <data key="d7">Handles audience query execution and low-latency API access for end users.</data>
    </node>
    <node id="9">
      <data key="d5">Couchbase (Serving)</data>
      <data key="d6">CouchBase</data>
      <data key="d7">Stores indexed audience membership state for fast querying.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion service writes cleaned event data into S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion service pushes streaming events into Kafka.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR batch jobs load historical files from S3.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Aggregation service streams incoming events from Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Profile service consumes calculated attributes from Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Serving service reads audience membership updates from Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Aggregation service writes dynamic attributes to Couchbase DB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Outputs calculated user attributes back to Kafka.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Profile service stores merged profiles into Couchbase/Elasticsearch.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Profile service pushes audience membership data back into Kafka.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Serving service indexes audience membership state into Couchbase serving database.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">OnePlus X Data Management Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=XqsgQxyZ2Tw</data>
    <data key="d2">Architecture for OnePlus X streaming data management platform processing event data to user profiles using ECS, Kafka, EMR, S3, and Couchbase.</data>
    <data key="d3">Data Processing &amp; Streaming</data>
    <data key="d4">True</data>
  </graph>
