<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Located in Development Environment Singapore; holds keys for secret and package distribution across regions.</data>
    </node>
    <node id="1">
      <data key="d5">CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Located in Development Environment Singapore; triggers package distribution and CloudFormation deployments.</data>
    </node>
    <node id="2">
      <data key="d5">APP Servers (Dev)</data>
      <data key="d6">EC2</data>
      <data key="d7">Development application servers located in Singapore.</data>
    </node>
    <node id="3">
      <data key="d5">ECR (Singapore)</data>
      <data key="d6">ECR</data>
      <data key="d7">Container registry for Staging / Production Singapore.</data>
    </node>
    <node id="4">
      <data key="d5">CloudFormation (Singapore)</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Automates resource deployment in Staging / Production Singapore.</data>
    </node>
    <node id="5">
      <data key="d5">APP Servers (Singapore)</data>
      <data key="d6">EC2</data>
      <data key="d7">Application servers running in Staging / Production Singapore.</data>
    </node>
    <node id="6">
      <data key="d5">RDS (Singapore)</data>
      <data key="d6">RDS</data>
      <data key="d7">Production database hosting Southeast Asia customer data.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized datalake storage located in Tokyo.</data>
    </node>
    <node id="8">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">ETL service in Tokyo that extracts data from Singapore and Beijing RDS instances.</data>
    </node>
    <node id="9">
      <data key="d5">ECR (Beijing)</data>
      <data key="d6">ECR</data>
      <data key="d7">Container registry for Staging / Production Beijing.</data>
    </node>
    <node id="10">
      <data key="d5">CloudFormation (Beijing)</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Automates resource deployment in Staging / Production Beijing with modified partitions and suffixes.</data>
    </node>
    <node id="11">
      <data key="d5">APP Servers (Beijing)</data>
      <data key="d6">EC2</data>
      <data key="d7">Application servers serving China region customers for reduced latency.</data>
    </node>
    <node id="12">
      <data key="d5">RDS (Beijing)</data>
      <data key="d6">RDS</data>
      <data key="d7">Production database hosting China customer data.</data>
    </node>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">CodeBuild accesses KMS to get encryption keys for multi-environment package distribution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CodeBuild triggers CloudFormation in Singapore to deploy/update environments.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">CodeBuild triggers CloudFormation in Beijing to deploy/update environments in China.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue extracts data from Singapore RDS into the central datalake in Tokyo.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="12" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue extracts data from Beijing RDS over the internet into the central datalake in Tokyo.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ampos Multi-Region Architecture and Data Lake</data>
    <data key="d1">https://www.youtube.com/watch?v=YT21s0_ZJVQ</data>
    <data key="d2">Ampos uses a multi-region setup with Development and Staging/Production environments in Singapore, Staging/Production in Beijing, and a centralized Datalake in Tokyo. CodeBuild manages deployment to both global and China regions using KMS for secret management and CloudFormation for automated deployments. Glue aggregates data from RDS databases in Singapore and Beijing into S3 in Tokyo.</data>
    <data key="d3">Cross-Region CI/CD and Multi-Region Data Aggregation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
