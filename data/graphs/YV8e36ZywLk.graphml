<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SAP</data>
      <data key="d6">SAP</data>
      <data key="d7">Hosts the Syntax ABAP SDK and SLT on the application layer across S/4HANA or ECC environments.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores high-volume extracted SAP data (up to 700k records/min across multiple sources).</data>
    </node>
    <node id="2">
      <data key="d5">KINESIS DATA STREAMS</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingests real-time high-throughput data streams directly from SAP.</data>
    </node>
    <node id="3">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Handles native publish/subscribe notifications and event messaging triggered from SAP.</data>
    </node>
    <node id="4">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes data transformations (e.g., converting S3 data into Parquet) and custom logic invoked natively from SAP.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SAP extracts data directly to S3 via SLT and ABAP SDK.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SAP streams real-time data directly into Kinesis Data Streams.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">SAP dispatches native event notifications to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">SAP directly calls Lambda functions to perform downstream tasks or transformations.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Syntax Native SAP to AWS Direct Integration Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=YV8e36ZywLk</data>
    <data key="d2">Shows native integration between the SAP application layer (using an ABAP SDK add-on and SLT) and AWS services without requiring intermediate middleware.</data>
    <data key="d3">Analytics, Enterprise Integration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
