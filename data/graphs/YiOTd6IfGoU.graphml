<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Internal Apps</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Generates around 20 million Avro events per day</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Single Firehose stream receiving all application events</data>
    </node>
    <node id="2">
      <data key="d5">S3 Raw</data>
      <data key="d6">S3</data>
      <data key="d7">Stores aggregated raw event data objects</data>
    </node>
    <node id="3">
      <data key="d5">CloudWatch Events</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Triggered by S3 Raw object creation</data>
    </node>
    <node id="4">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates event processing lifecycle</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Splits data by type, updates partitions, and routes data to S3 and Elasticsearch</data>
    </node>
    <node id="6">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Central storage for partitioned event data (~80 event types)</data>
    </node>
    <node id="7">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Performs interactive queries directly on S3 Data Lake</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Indexes data for rapid search and operational debugging</data>
    </node>
    <node id="9">
      <data key="d5">Airflow</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Runs hourly/daily ETL pipelines from S3 to Redshift</data>
    </node>
    <node id="10">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Serves business intelligence dashboards</data>
    </node>
    <node id="11">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for aggregated reporting data</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Internal Apps send event data to Kinesis Firehose.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Firehose aggregates raw events and writes them to S3 Raw.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Object creation in S3 Raw triggers CloudWatch Events.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch Events triggers execution of Step Functions.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions invokes Lambda functions.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda splits data by type and writes it to S3 Data Lake.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda updates event indexes in Elasticsearch.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries structured data stored in S3 Data Lake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Airflow extracts data from S3 Data Lake for ETL jobs.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Airflow loads transformed data into Redshift.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">QuickSight queries aggregated data from Redshift.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Go Global Data Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=YiOTd6IfGoU</data>
    <data key="d2">Go Global processes ~20M daily events formatted in Avro. Data streams through Kinesis Firehose to raw S3, orchestrated via Step Functions and Lambda into an S3 Data Lake, Elasticsearch, and Redshift via Airflow ETL for QuickSight dashboards and Athena queries.</data>
    <data key="d3">Data Analytics, Event-Driven Architecture, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
