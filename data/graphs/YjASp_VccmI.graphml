  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Creators and clients accessing single-page React app.</data>
    </node>
    <node id="1">
      <data key="d5">Public ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Entry point balancing external traffic to public ECS.</data>
    </node>
    <node id="2">
      <data key="d5">Public ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Docker container cluster orchestrating public Go APIs.</data>
    </node>
    <node id="3">
      <data key="d5">Private ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Internal load balancer using host and path-based routing within VPC.</data>
    </node>
    <node id="4">
      <data key="d5">Private ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Cluster hosting internal services like Payments and Data APIs.</data>
    </node>
    <node id="5">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Private DNS zone supporting internal ALB routing.</data>
    </node>
    <node id="6">
      <data key="d5">Elastic Transcoder</data>
      <data key="d6">ElasticTranscoder</data>
      <data key="d7">Handles video transcoding into multiple bitrates and thumbnails.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage for uploaded creator assets up to 4K resolution.</data>
    </node>
    <node id="8">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database storing platform core domain data.</data>
    </node>
    <node id="9">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database for payments data accelerated with DAX.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User interacts with portal SPA sending requests to Public ALB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Public ALB routes traffic to public Go APIs in Public ECS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Public APIs invoke private internal APIs via Private ALB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Public API facilitates direct asset uploads and path creation to S3.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Private ALB routes internal requests to Private ECS containers.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Private services read and write relational data in RDS.</data>
