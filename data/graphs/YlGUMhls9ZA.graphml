    <node id="0">
      <data key="d5">CloudWatch Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Triggers execution of Lambda functions daily at 7:30 AM.</data>
    </node>
    <node id="1">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores metadata and active Lambda function configurations per monitored AWS account.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 UNUSED</data>
      <data key="d6">Lambda</data>
      <data key="d7">Identifies unused EC2 instances across monitored accounts.</data>
    </node>
    <node id="3">
      <data key="d5">EBS UNUSED</data>
      <data key="d6">Lambda</data>
      <data key="d7">Scans and deletes unused EBS volumes unless tagged with 'preserve'.</data>
    </node>
    <node id="4">
      <data key="d5">RDS UNUSED</data>
      <data key="d6">Lambda</data>
      <data key="d7">Checks RDS instances without active connections in the last 7 days.</data>
    </node>
    <node id="5">
      <data key="d5">ELB UNUSED</data>
      <data key="d6">Lambda</data>
      <data key="d7">Scans unused Classic, Application, and Network Load Balancers.</data>
    </node>
    <node id="6">
      <data key="d5">S3 METRICS</data>
      <data key="d6">Lambda</data>
      <data key="d7">Collects S3 bucket sizes, historical trends, and lifecycle policy usage using a custom Boto3 layer.</data>
    </node>
    <node id="7">
      <data key="d5">IAM Role</data>
      <data key="d6">IAM</data>
      <data key="d7">Provides cross-account STS AssumeRole permissions for scanning operations.</data>
