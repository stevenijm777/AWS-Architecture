<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Oracle on EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Source database running Oracle on EC2 containing operational reservation, ticketing, and flight data.</data>
    </node>
    <node id="1">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">AWS Database Migration Service used for continuous change data capture (CDC) replication.</data>
    </node>
    <node id="2">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Target database running PostgreSQL on Amazon RDS, converted using AWS Schema Conversion Tool (SCT).</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores database change history at low cost, serving as the core repository for the data lake.</data>
    </node>
    <node id="4">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Executes ETL processing jobs to transform and load data from RDS and S3 into Redshift.</data>
    </node>
    <node id="5">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Enterprise data warehouse hosting fact and dimension tables for BI reporting and executive dashboards.</data>
    </node>
    <node id="6">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Serverless interactive query service used to analyze data directly in Amazon S3.</data>
    </node>
    <node id="7">
      <data key="d5">CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Orchestrates end-to-end automation for Glue code management and environment deployments.</data>
    </node>
    <node id="8">
      <data key="d5">CodeCommit</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">Version control repository for Glue ETL scripts and configuration files.</data>
    </node>
    <node id="9">
      <data key="d5">CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Builds and tests Glue ETL script updates and deployment packages.</data>
    </node>
    <node id="10">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Deploys infrastructure and code artifacts automatically across DEV and PRD accounts.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS performs real-time CDC extraction from the operational Oracle DB on EC2.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS replicates operational changes to PostgreSQL on RDS within seconds to 3 minutes.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS writes historical change tracking logs into S3.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue extracts structured relational data from RDS for ETL transformation.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries raw historical data directly from S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue extracts data history from S3 for ETL transformation.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue loads transformed dimension and fact datasets into Amazon Redshift.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">CodePipeline monitors and triggers on source changes in CodeCommit.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">CodeCommit triggers CodeBuild to process script validation and build.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">CodeBuild passes build outputs to CloudFormation for multi-account deployment.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Korean Air Data Warehouse Modernization Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=YosezjoL4MU</data>
    <data key="d2">Korean Air modernized its enterprise data warehouse by migrating legacy operational database workloads to AWS using DMS, RDS, S3, Glue, Redshift, and Athena, supported by a dedicated CI/CD pipeline.</data>
    <data key="d3">Analytics, Data Warehouse, CI/CD</data>
    <data key="d4">True</data>
  </graph>
</graphml>
