<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">GUARD DUTY</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Analyzes AWS logs to detect suspicious activity.</data>
    </node>
    <node id="1">
      <data key="d5">INSPECTOR</data>
      <data key="d6">Inspector</data>
      <data key="d7">Performs vulnerability scanning and reports CVE severity events.</data>
    </node>
    <node id="2">
      <data key="d5">ANTIVIRUS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party antivirus solution sending threat events.</data>
    </node>
    <node id="3">
      <data key="d5">HIDS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Host-based Intrusion Detection System analyzing OS logs on EC2 instances.</data>
    </node>
    <node id="4">
      <data key="d5">SECURITY HUB</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Aggregates and centralizes all security events in a single standardized format.</data>
    </node>
    <node id="5">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Captures Security Hub events as CloudWatch Events to act as an event bus.</data>
    </node>
    <node id="6">
      <data key="d5">STEP FUNCTION</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates automated remediation workflows using Lambda libraries.</data>
    </node>
    <node id="7">
      <data key="d5">SLACK</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sends notifications to a dedicated Slack channel for key security events.</data>
    </node>
    <node id="8">
      <data key="d5">ITSM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Creates and manages ITSM tickets, automatically closing them if resolved.</data>
    </node>
    <node id="9">
      <data key="d5">PAGER DUTY</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Triggers alerts to call on-duty security analysts for High/Critical incidents.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends suspicious activity alerts to Security Hub.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Pushes vulnerability and CVE severity findings to Security Hub.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends antivirus detection events to Security Hub.</data>
      <data key="d10">0''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Forwards OS log analysis and intrusion alerts to Security Hub.</data>
      <data key="d10">0'''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Generates CloudWatch Events from aggregated security findings.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers Step Functions orchestration workflow.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Posts notification to the dedicated Slack security channel.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Creates/closes ITSM tickets based on remediation status.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Escalates high/critical severity incidents via PagerDuty to a security analyst.</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Thales Automated Security Event Remediation Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=YrEc8oMIxDs</data>
    <data key="d2">Centralized security event aggregation and automated incident remediation system presented by Thales DIS.</data>
    <data key="d3">Security, Automation, Incident Response</data>
    <data key="d4">True</data>
  </graph>
</graphml>
