<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Dome 9</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External security compliance monitoring service that asserts configurations.</data>
    </node>
    <node id="1">
      <data key="d5">Guard Duty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">AWS threat detection service identifying security anomalies.</data>
    </node>
    <node id="2">
      <data key="d5">SNS Input</data>
      <data key="d6">SNS</data>
      <data key="d7">Input SNS topic aggregating compliance alerts and findings.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Central Lambda function running Python CloudBot remediation logic.</data>
    </node>
    <node id="4">
      <data key="d5">SNS Output</data>
      <data key="d6">SNS</data>
      <data key="d7">Output SNS topic broadcasting remediation logs and results.</data>
    </node>
    <node id="5">
      <data key="d5">Account 1</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Target cloud account where remediation actions are executed.</data>
    </node>
    <node id="6">
      <data key="d5">Account 2</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Secondary target cloud account where cross-account roles are assumed for remediation.</data>
    </node>
    <node id="7">
      <data key="d5">email, slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Notification destinations receiving output logs and status updates.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Dome 9 sends non-compliance alerts to the input SNS topic.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">GuardDuty sends threat findings to the input SNS topic.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Input SNS topic triggers the CloudBot Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda assumes role and applies remediation in Account 1.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda assumes role and applies remediation in Account 2.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda outputs execution status and logs to the output SNS topic.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Output SNS topic delivers remediation notifications to Email and Slack.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Dome9 CloudBots Automated Compliance Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ZA_0RMeeWpY</data>
    <data key="d2">Automated compliance remediation setup using Dome9, AWS GuardDuty, Lambda, and SNS to remediate non-compliant configurations across multiple AWS accounts.</data>
    <data key="d3">Security, Automation, Governance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
