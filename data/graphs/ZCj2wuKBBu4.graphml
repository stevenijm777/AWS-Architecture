<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">NIKE APP</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile application where users onboard and select interest preferences (e.g., sports like basketball or tennis).</data>
    </node>
    <node id="1">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point intake funnel for receiving user preference data from the Nike App.</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Siphons incoming preference data from API Gateway without complex business logic.</data>
    </node>
    <node id="3">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer ensuring high availability and global resiliency for inbound traffic.</data>
    </node>
    <node id="4">
      <data key="d5">AUTO SCALING</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto-scaled EC2 instances executing core application business logic, graph writes, and event publishing.</data>
    </node>
    <node id="5">
      <data key="d5">NEPTUNE</data>
      <data key="d6">Neptune</data>
      <data key="d7">Amazon Neptune graph database cluster (1 writer node, 2 reader nodes) storing A-R-B entity relationships.</data>
    </node>
    <node id="6">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Amazon SNS topic used to broadcast user preference updates to multiple internal subscribers asynchronously.</data>
    </node>
    <node id="7">
      <data key="d5">CDS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Nike internal notification system acting upon user preference signals to deliver personalized content.</data>
    </node>
    <node id="8">
      <data key="d5">DATA LAKE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data lake repository consuming user interest events for analytics and personalization modeling.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User interest selection payload sent from Nike App to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes request to Lambda siphon function.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda forwards preference payload to ELB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB load balances traffic across Auto Scaling EC2 instances.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Auto Scaling EC2 instances execute synchronous/asynchronous writes to the Neptune cluster.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Auto Scaling instances trigger an event message to SNS upon user graph updates.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS notifies CDS internal notification system.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS notifies Data Lake for downstream analytics processing.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Nike Social Graph Architecture with Amazon Neptune</data>
    <data key="d1">https://www.youtube.com/watch?v=ZCj2wuKBBu4</data>
    <data key="d2">Nike powers its social graph across mobile apps (Nike, NRC, NTC) using Amazon Neptune for personalization, managing 125 million user relationships for roughly 25 million users globally.</data>
    <data key="d3">Mobile, Database, Serverless, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
