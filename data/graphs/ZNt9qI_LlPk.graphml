<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Data Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores incoming raw data (1-13 TB/day) and final batch parquet output files.</data>
    </node>
    <node id="1">
      <data key="d5">Notification Topic</data>
      <data key="d6">SNS</data>
      <data key="d7">Handles event notifications for incoming files and routes error notifications.</data>
    </node>
    <node id="2">
      <data key="d5">Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Cleanses and enriches incoming data with built-in internal retry logic.</data>
    </node>
    <node id="3">
      <data key="d5">Metadata Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores processed metadata with high throughput and low latency.</data>
    </node>
    <node id="4">
      <data key="d5">Batch Processing ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Async RESTful Web API service that batches JSON outputs into Parquet format.</data>
    </node>
    <node id="5">
      <data key="d5">Error Handling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered on processing failures to isolate erroneous files back in S3.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 triggers event notification to SNS upon receiving raw data.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS triggers invocation of data processing Lambdas.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS triggers Error Handling Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Internal retry mechanism within Processing Lambda on transient failure.</data>
      <data key="d10">1'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Processing Lambda writes extracted metadata into DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing Lambda publishes failure event to SNS after retries are exhausted.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS reads metadata from DynamoDB to execute batch processing.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS writes final batch Parquet formatted files back to S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Error Handling Lambda copies erroneous file back to S3 for investigation.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Autodesk Serverless Big Data Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=ZNt9qI_LlPk</data>
    <data key="d2">Data pipeline processing between 1 TB and 13 TB of daily incoming data using S3, SNS, Lambda, DynamoDB, and ECS for batch Parquet conversion.</data>
    <data key="d3">Big Data, Serverless, Data Pipeline</data>
    <data key="d4">True</data>
  </graph>
</graphml>
