<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores input video files and generated A/B watermarked VOD variants</data>
    </node>
    <node id="1">
      <data key="d5">MediaConvert</data>
      <data key="d6">MediaConvert</data>
      <data key="d7">Processes VOD files into A and B watermarked variants</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Delivers personalized A/B chunk sequences to end-user players</data>
    </node>
    <node id="3">
      <data key="d5">Lambda@Edge</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Executes request-level session parsing and A/B sequence selection at edge</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB Table</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores blacklisted session tokens for real-time blocking</data>
    </node>
    <node id="5">
      <data key="d5">MediaPackage</data>
      <data key="d6">MediaPackage</data>
      <data key="d7">Packages live video streams as origin for CloudFront</data>
    </node>
    <node id="6">
      <data key="d5">MediaLive</data>
      <data key="d6">MediaLive</data>
      <data key="d7">Encodes live video streams into distinct A and B watermarked channels</data>
    </node>
    <node id="7">
      <data key="d5">MediaConnect</data>
      <data key="d6">MediaConnect</data>
      <data key="d7">Ingests incoming live video stream feed</data>
    </node>
    <node id="8">
      <data key="d5">Player 1</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Client player device receiving unique sequence (e.g., ABAB)</data>
    </node>
    <node id="9">
      <data key="d5">Player 2</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Client player device receiving unique sequence (e.g., ABBA)</data>
    </node>
    <node id="10">
      <data key="d5">Detection Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Nagra forensic watermark detection service identifying illicit stream sessions</data>
    </node>
    <node id="11">
      <data key="d5">Camera Feed</data>
      <data key="d6">UserConsumerCamera</data>
      <data key="d7">Live camera video feed source</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 supplies input video file to MediaConvert</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 serves as origin to CloudFront for VOD content</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">MediaConvert uploads generated A/B watermarked variants back to S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront triggers Lambda@Edge during request handling</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront delivers personalized A/B video sequence to Player 1</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront delivers distinct A/B video sequence to Player 2</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda@Edge queries DynamoDB to check session blacklisting status</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">MediaPackage serves live video stream origin to CloudFront</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">MediaLive sends A/B watermarked live streams to MediaPackage</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">MediaConnect routes live feed to dual MediaLive encoding channels</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Detection Service populates identified illicit session info into DynamoDB blacklist</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Live video stream input feeds into MediaConnect</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Nagra NexGuard Forensic Watermarking Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ZPsBzAwJzoI</data>
    <data key="d2">Architecture for session-based forensic watermarking on live and VOD streaming media with active session blacklisting capability.</data>
    <data key="d3">Media &amp; Entertainment, Security, Serverless</data>
    <data key="d4">True</data>
