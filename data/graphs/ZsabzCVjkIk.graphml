  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Provides full-text search capability for the application.</data>
    </node>
    <node id="1">
      <data key="d5">ELASTICACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Provides internal application caching to boost performance.</data>
    </node>
    <node id="2">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database used for persistent data storage.</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs containerized microservice or monolithic web applications and asynchronous batch processing tasks.</data>
    </node>
    <node id="4">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Global CDN distribution offering DDoS protection and static asset caching.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores static content and assets served via CloudFront.</data>
    </node>
    <node id="6">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer distributing incoming web traffic to ECS tasks.</data>
    </node>
    <node id="7">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Elastic Container Registry holding Docker images generated by CodeBuild.</data>
    </node>
    <node id="8">
      <data key="d5">CODEPIPELINE</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Orchestrates CI/CD pipeline triggered by repository pushes.</data>
    </node>
    <node id="9">
      <data key="d5">CLOUDFORMATION</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Manages infrastructure templates and executes automated deployments to ECS.</data>
    </node>
