<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Device</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Customer smartphone or web device used to view utility usage and present checkout barcodes.</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer entry point for utility web portals.</data>
    </node>
    <node id="2">
      <data key="d5">Retailer (R)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Participating retail store (e.g. Walgreens, CVS) where customers pay using printed or mobile barcodes.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 App Server</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 app tier evaluating payment rules, customer validation, and routing payment data.</data>
    </node>
    <node id="4">
      <data key="d5">Utility Company (UTIL)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Utility system that receives payment confirmation and sends signals to customer meters.</data>
    </node>
    <node id="5">
      <data key="d5">Meter (M)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Physical utility meter on customer home, turning on within ~25 seconds of payment received.</data>
    </node>
    <node id="6">
      <data key="d5">Database</data>
      <data key="d6">RDS</data>
      <data key="d7">SQL Server database running on Windows OS within EC2.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 DB Host</data>
      <data key="d6">EC2</data>
      <data key="d7">Host compute instance running SQL Server in a multi-AZ HA architecture.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing database backups, replicated across regions for disaster recovery.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Customer accesses utility website via smartphone</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer presents barcode on mobile device at participating retailer</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB routes web traffic to EC2 application server</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Retailer scans barcode and sends transaction to EC2 app server for business rule checks</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 app server transmits payment details to utility company</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Utility company communicates with customer home meter to restore power</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">SQL Server database runs hosted on Windows EC2 host instance</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 database host backs up data to S3 for cross-region replication</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">PAYGO Prepaid Utility Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=_EPfIJnBCoM</data>
    <data key="d2">PAYGO architecture on AWS enabling real-time utility usage tracking, payment processing via web or retail checkout, and high availability/disaster recovery using EC2 multi-AZ stacks and S3 cross-region replication.</data>
    <data key="d3">Prepaid Utilities, Payment Processing, Disaster Recovery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
