  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Authentication System</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External payment authentication system initiating payment transaction requests.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Global CDN entry point delivering low-latency request routing across the region.</data>
    </node>
    <node id="2">
      <data key="d5">AWS WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall protecting CloudFront against common vulnerabilities.</data>
    </node>
    <node id="3">
      <data key="d5">Elastic Load Balancing</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer handling incoming scalability and routing traffic to container tasks.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Serverless container compute inside the ECS cluster running microservices on Graviton instances.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Container registry storing microservice images built through the CI/CD pipeline.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Graph database managing interconnected transaction, user, and device data as well as historic velocity metrics.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database storing traditional organizational and user CMS data.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon DocumentDB</data>
      <data key="d6">DocumentDB</data>
      <data key="d7">Document database storing rules and over 290 fraud detection policies.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon MemoryDB for Redis</data>
      <data key="d6">MemoryDB</data>
      <data key="d7">In-memory database providing microsecond latency for microservice authentication token lookup.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Authentication System sends payment transaction request to CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront passes request through AWS WAF for security inspection.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront routes validated traffic to Elastic Load Balancing.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Elastic Load Balancing distributes requests to AWS Fargate instances in the ECS Cluster.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Fargate pulls container microservice images from Amazon ECR.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Fargate queries Neptune graph database for transaction velocity and historical relationship insights.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Fargate accesses Amazon RDS for organizational and user CMS interface information.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Fargate reads and flattens fraud rules/policies stored in Amazon DocumentDB.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Fargate checks and caches authentication session state in Amazon MemoryDB for Redis at microsecond speed.</data>
      <data key="d10">0'''</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Infinitium Online Payments Fraud Detection System</data>
    <data key="d1">https://www.youtube.com/watch?v=_cca2eNePC4</data>
    <data key="d2">Infinitium's FDS 2.0 uses AWS Fargate microservices backed by specialized data stores (Neptune, RDS, DocumentDB, MemoryDB for Redis) to process payment authentication and perform fraud detection for over 180 million card users.</data>
    <data key="d3">Payments, Fraud Detection, Serverless Containers, Multimodel Databases</data>
    <data key="d4">True</data>
  </graph>
