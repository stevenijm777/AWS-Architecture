<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEEPLENS</data>
      <data key="d6">DeepLens</data>
      <data key="d7">Captures photo when an employee approaches the self-service hub.</data>
    </node>
    <node id="1">
      <data key="d5">IDENTITY</data>
      <data key="d6">Lambda</data>
      <data key="d7">Receives photo from DeepLens, coordinates with Rekognition, stores image in S3, and caches presence in DynamoDB.</data>
    </node>
    <node id="2">
      <data key="d5">REKOGNITION</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Performs facial recognition logic to identify pre-registered employees within target 2-second SLA.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores employee face images.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Provides low-latency key-value cache of who is currently at a specific location.</data>
    </node>
    <node id="5">
      <data key="d5">ALEXA</data>
      <data key="d6">AlexaForBusiness</data>
      <data key="d7">Voice interface for users interacting with the self-service hub.</data>
    </node>
    <node id="6">
      <data key="d5">WKSP HELPER</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes WorkSpaces Helper skill logic, looks up nearby identity in DynamoDB, and personalized voice prompt.</data>
    </node>
    <node id="7">
      <data key="d5">STEP FUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates approval workflow (user/manager confirmation) and provisioning steps.</data>
    </node>
    <node id="8">
      <data key="d5">WORKSPACES</data>
      <data key="d6">WorkSpaces</data>
      <data key="d7">Amazon WorkSpaces desktop provisioned automatically upon workflow approval.</data>
    </node>
    <node id="9">
      <data key="d5">SUMERIAN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Planned future replacement/enhancement for the Alexa voice interaction interface.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">DeepLens triggers Identity Lambda with captured photo.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Identity Lambda sends photo to Rekognition for identity match.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Identity Lambda stores original image in S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Identity Lambda caches user identity and location timestamp in DynamoDB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Rekognition returns identity match result to Identity Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB returns recent identity record.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">User invokes Alexa skill, passing request to WKSP Helper Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">WKSP Helper Lambda queries DynamoDB to find who is at the location.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">WKSP Helper sends personalized prompt response back to Alexa.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">WKSP Helper invokes Step Functions to start approval and provisioning workflow.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions triggers automated provisioning of Amazon WorkSpace.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Olikka WorkSpaces Automated Self-Service Provisioning Hub</data>
    <data key="d1">https://www.youtube.com/watch?v=_pXybA6832o</data>
    <data key="d2">An automated serverless kiosk system combining facial recognition (DeepLens, Rekognition) and voice control (Alexa) to verify user identity and orchestrate Amazon WorkSpaces provisioning within two seconds.</data>
    <data key="d3">Serverless, Automation, Workspace Provisioning, Computer Vision</data>
    <data key="d4">True</data>
  </graph>
</graphml>
