<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Edge Appliance (US East)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises/edge appliance accessing global file lock service from US East region</data>
    </node>
    <node id="1">
      <data key="d5">Edge Appliance (US West)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises/edge appliance accessing global file lock service from US West region</data>
    </node>
    <node id="2">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Global DNS service providing active-passive regional routing and failover</data>
    </node>
    <node id="3">
      <data key="d5">ELB (US East)</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer receiving file lock traffic in US East region</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (US East)</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute layer processing file lock business logic in US East</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB (US East)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB table storing global file locks in US East</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Orchestrator controlling ELB request rejection and managing cross-region consistency during failover</data>
    </node>
    <node id="7">
      <data key="d5">ELB (US West)</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer receiving file lock traffic in US West region</data>
    </node>
    <node id="8">
      <data key="d5">EC2 (US West)</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute layer processing file lock business logic in US West</data>
    </node>
    <node id="9">
      <data key="d5">DynamoDB (US West)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB table storing global file locks in US West</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Edge Appliance queries Route 53 to resolve health and regional lock endpoint</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Edge Appliance sends file lock requests to US East ELB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB routes request to EC2 instances running lock service</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 checks and updates file lock records in DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Cross-region asynchronous replication between DynamoDB Global Tables</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda instructs US East ELB to stop taking requests (return 503) during failover</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda monitors replication status of DynamoDB US East table</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda monitors replication status of DynamoDB US West table</data>
      <data key="d10">1'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda signals US West ELB to resume/accept traffic once failover consistency is confirmed</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Nasuni Global File Locking Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=_vjB_vF4Uec</data>
    <data key="d2">Global file locking solution achieving ultra-low latency (&lt;50ms) across regions using AWS DynamoDB Global Tables, Route 53 active-passive DNS failover, and Lambda orchestration.</data>
    <data key="d3">Global Infrastructure &amp; Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
