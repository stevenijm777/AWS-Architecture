<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Security Hub (Members)</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Deployed across &gt;100 member accounts with &gt;100 active security controls per account.</data>
    </node>
    <node id="1">
      <data key="d5">GuardDuty (Members)</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Monitors threat findings in member accounts.</data>
    </node>
    <node id="2">
      <data key="d5">Security Hub (Management)</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Central Security Hub account aggregating findings across all member accounts.</data>
    </node>
    <node id="3">
      <data key="d5">GuardDuty (Management)</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Central GuardDuty account aggregating threat findings across all member accounts.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Policy Repository</data>
      <data key="d6">S3</data>
      <data key="d7">Central Policy-as-Code repository storing JSON security policy rules.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Config)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Reads policies from S3 to automate configuration and baselining of Security Hub across member accounts.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda (Filtering &amp; Enrichment)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Evaluates findings against S3 policies to ignore non-relevant events and enrich relevant ones with UUIDs and account tags.</data>
    </node>
    <node id="7">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Executes automated remediation workflows for relevant security findings.</data>
    </node>
    <node id="8">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams enriched security findings downstream to external Splunk SIEM.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Member Security Hub findings sent to Central Security Hub.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Member GuardDuty findings sent to Central GuardDuty.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Central Security Hub forwards aggregated findings to Filtering Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Central GuardDuty forwards aggregated findings to Filtering Lambda.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Configuration Lambda reads JSON policies from S3 repository.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Filtering Lambda queries S3 repository for filtering rules and tag metadata.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Configuration Lambda configures Security Hub settings on member accounts.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Enriched findings sent to Step Functions for automated remediation.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Enriched findings delivered to Kinesis Firehose for SIEM ingestion.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Swiss Post Multi-Account AWS Security Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=a1sEfGVDpEQ</data>
    <data key="d2">Centralized security management and automated policy-driven event handling across more than 100 member AWS accounts.</data>
    <data key="d3">Security &amp; Compliance, Automation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
