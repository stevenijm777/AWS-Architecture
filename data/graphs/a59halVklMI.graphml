<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">Secure channel through which data from third-party Kafka stream enters AWS.</data>
    </node>
    <node id="1">
      <data key="d5">LIVE</data>
      <data key="d6">EMR</data>
      <data key="d7">Live EMR cluster running Spark and HBase calculating 18 KPIs in real time.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing raw real-time streaming data (~350 GB/day, retained for 120 days).</data>
    </node>
    <node id="3">
      <data key="d5">BATCH</data>
      <data key="d6">EMR</data>
      <data key="d7">Batch EMR cluster running hourly Spark streams to calculate 99 KPIs and compress data.</data>
    </node>
    <node id="4">
      <data key="d5">PARQUET</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing compressed historical data in Parquet format.</data>
    </node>
    <node id="5">
      <data key="d5">KPI</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing calculated aggregated KPI metrics.</data>
    </node>
    <node id="6">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Amazon SageMaker used by data science team to train models for real-time fuel pilferage detection.</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational Database storing customer, vehicle metadata, and geospatial data.</data>
    </node>
    <node id="8">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Amazon Athena used by data analysts to perform ad-hoc SQL queries over Parquet data.</data>
    </node>
    <node id="9">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Amazon Redshift data warehouse storing structured aggregated analytics for enterprise reports.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Incoming stream from VPC is ingested into the LIVE EMR cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">LIVE EMR cluster writes real-time processed stream data into raw S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">BATCH EMR cluster pulls raw data from S3 every 1 hour.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">BATCH EMR converts raw data into compressed Parquet format and writes to PARQUET S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">BATCH EMR calculates 99 KPIs and writes to KPI S3 bucket.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">SageMaker pulls compressed Parquet data to train machine learning models.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Athena queries Parquet data stored in S3 directly for ad-hoc analytical reporting.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Aggregated KPI data is loaded from KPI bucket into Redshift data warehouse.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ashok Leyland iAnalytics Connected Vehicle Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=a59halVklMI</data>
    <data key="d2">iAnalytics platform processing 350 GB/day (~1 billion records/day) from 150,000 vehicles reporting at 6-second frequency.</data>
    <data key="d3">Data Analytics and Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
