<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Handles ~300k requests per minute across web and mobile platforms.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Content delivery network acting as the primary entry point.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores images and heavy static content.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda@Edge functions that inspect request headers for region and device routing.</data>
    </node>
    <node id="4">
      <data key="d5">LOAD BALANCER</data>
      <data key="d6">ELB</data>
      <data key="d7">Around 60 load balancers distributing traffic between legacy monoliths and microservices.</data>
    </node>
    <node id="5">
      <data key="d5">LEGACY</data>
      <data key="d6">EC2</data>
      <data key="d7">Monolithic backend applications running on traditional EC2 instances.</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Kubernetes cluster hosting ~250 microservices across 1400 pods.</data>
    </node>
    <node id="7">
      <data key="d5">MONGO/KAFKA</data>
      <data key="d6">EC2</data>
      <data key="d7">Self-managed MongoDB for NoSQL storage and Kafka for event-driven messaging on EC2.</data>
    </node>
    <node id="8">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Managed relational database for transactional SQL workloads.</data>
    </node>
    <node id="9">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs internal observability and logging tools (Prometheus, ELK).</data>
    </node>
    <node id="10">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors pod health and ties into alerting mechanisms.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User traffic routes into CloudFront CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront routes request traffic to backend load balancers.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Infrastructure metrics and traffic data connected to EC2 monitoring tools.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Static content served from S3 through CloudFront.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda@Edge provides routing intelligence based on client region/device.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Load balancers forward non-migrated requests to legacy monolith systems on EC2.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Load balancers forward microservices traffic to EKS clusters.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Legacy EC2 services interact with Mongo/Kafka cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">EKS microservices connect to MongoDB and produce/consume Kafka events.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">EKS microservices connect to RDS for transactional SQL operations.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Internal monitoring tools aggregate pod health and send logs to CloudWatch.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Seera Group Microservices Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=a6kqyqTNJM4</data>
    <data key="d2">Architectural transcription of Seera Group's migration from legacy monolithic EC2 workloads to microservices hosted on AWS EKS with edge routing via CloudFront/Lambda@Edge.</data>
    <data key="d3">Web Architecture, Microservices, Event-Driven</data>
    <data key="d4">True</data>
  </graph>
</graphml>
