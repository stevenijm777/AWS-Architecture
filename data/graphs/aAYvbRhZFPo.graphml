<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Bank</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">120+ external banks submitting statement files via SFTP or DNS endpoints</data>
    </node>
    <node id="1">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Global DNS service with health checks and 4 DNS entries across regions</data>
    </node>
    <node id="2">
      <data key="d5">ELB Region 1</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer in Region 1 (N. Virginia)</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Region 1</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute instances processing statement files in Region 1</data>
    </node>
    <node id="4">
      <data key="d5">S3 Region 1</data>
      <data key="d6">S3</data>
      <data key="d7">Storage bucket for Region 1</data>
    </node>
    <node id="5">
      <data key="d5">ELB Region 2</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer in Region 2 (Oregon)</data>
    </node>
    <node id="6">
      <data key="d5">EC2 Region 2</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute instances processing statement files in Region 2</data>
    </node>
    <node id="7">
      <data key="d5">S3 Region 2</data>
      <data key="d6">S3</data>
      <data key="d7">Storage bucket for Region 2</data>
    </node>
    <node id="8">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Notification system for feed events</data>
    </node>
    <node id="9">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Message queuing for processing jobs</data>
    </node>
    <node id="10">
      <data key="d5">EC2 Batch</data>
      <data key="d6">EC2</data>
      <data key="d7">Batch processing engine</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Banks deliver statement files through DNS round-robin routing</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes request to Region 1 ELB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes request to Region 2 ELB</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards traffic to Region 1 EC2 instances</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards traffic to Region 2 EC2 instances</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Xero Bank Feeds Multi-Region Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=aAYvbRhZFPo</data>
    <data key="d2">Xero processes 1.5 million transaction statements daily from 120+ banks globally across North Virginia and Oregon regions using Route 53 health-checked DNS routing.</data>
    <data key="d3">Multi-Region, High Availability, Batch Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
