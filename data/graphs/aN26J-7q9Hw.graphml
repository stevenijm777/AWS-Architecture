<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Qonto mobile application used by customers to manage physical and virtual credit cards.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives web service calls from the mobile application.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">PCI-DSS certified serverless compute executing business logic and card processing.</data>
    </node>
    <node id="3">
      <data key="d5">Systems Manager</data>
      <data key="d6">SystemsManager</data>
      <data key="d7">Stores secrets and electronic certificates required by Lambda at startup.</data>
    </node>
    <node id="4">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Encrypts and decrypts secrets stored in Systems Manager.</data>
    </node>
    <node id="5">
      <data key="d5">Mastercard</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External payment network for authorizing card actions.</data>
    </node>
    <node id="6">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancing tier for internal egress proxy services.</data>
    </node>
    <node id="7">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs proxy solution with whitelist capabilities to filter internet traffic.</data>
    </node>
    <node id="8">
      <data key="d5">NAT</data>
      <data key="d6">NAT</data>
      <data key="d7">NAT Gateway managing outbound network connections.</data>
    </node>
    <node id="9">
      <data key="d5">Sentry</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External SaaS platform used for application logging and monitoring.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User triggers card management operation from Mobile App to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Lambda execution.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway returns final response to Mobile App.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes outbound proxy traffic via Load Balancer.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda fetches secrets and electronic certificates from Systems Manager at startup.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda sends authenticated card requests to Mastercard network.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda returns verified and signed response to API Gateway.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda routes outbound logging traffic through EC2 proxy.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Systems Manager uses KMS to decrypt stored parameters.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Mastercard returns card processing response to Lambda.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">NAT Gateway routes whitelisted egress log data to Sentry SaaS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Qonto PCI DSS Compliant Architecture for Card Management</data>
    <data key="d1">https://www.youtube.com/watch?v=aN26J-7q9Hw</data>
    <data key="d2">Qonto handles card management functions within PCI-DSS certified AWS services (Lambda, API Gateway) and routes egress SaaS logging traffic through a whitelisted proxy cluster on EC2/NAT Gateway to Sentry.</data>
    <data key="d3">Fintech, Serverless, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
