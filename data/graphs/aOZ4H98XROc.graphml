<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client</data>
      <data key="d6">UserConsumerDeveloper</data>
      <data key="d7">Client device running AppGate SDP client software.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 APPGATE</data>
      <data key="d6">EC2</data>
      <data key="d7">AppGate Controller running on EC2 that processes SPA packets and issues entitlement tokens.</data>
    </node>
    <node id="2">
      <data key="d5">SSO</data>
      <data key="d6">IAM</data>
      <data key="d7">Identity provider (SSO) used by AppGate Controller for user authentication.</data>
    </node>
    <node id="3">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">AWS IAM used for authorization and policy evaluation.</data>
    </node>
    <node id="4">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">AWS Route 53 DNS service used for resolving hostnames to IP addresses.</data>
    </node>
    <node id="5">
      <data key="d5">APPGATE GATEWAY</data>
      <data key="d6">EC2</data>
      <data key="d7">AppGate Gateway running on EC2 that enforces access control and routes client traffic to internal VPC systems.</data>
    </node>
    <node id="6">
      <data key="d5">AUTOSCALING</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling group component to scale AppGate Gateway instances based on load.</data>
    </node>
    <node id="7">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">Target VPC containing protected cloud resources and services.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Client sends SPA (Single Packet Authorization) request to the AppGate Controller.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Client performs DNS host resolution via Route 53.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Client connects via secure parallel encrypted tunnel to AppGate Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">AppGate Controller authenticates user identity via SSO identity provider.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">AppGate Controller evaluates permissions and roles via AWS IAM.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">AppGate Controller returns entitlement token and routing configuration back to Client.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">AppGate Gateway routes authorized traffic to target host resources inside the VPC.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">6Thera AppGate SDP Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=aOZ4H98XROc</data>
    <data key="d2">AppGate SDP (Software Defined Perimeter) architecture on AWS, using Single Packet Authorization (SPA), identity integration (SSO/IAM), and dynamic AppGate Gateways for zero trust client access to VPC resources.</data>
    <data key="d3">Security, Networking, Zero Trust</data>
    <data key="d4">True</data>
  </graph>
</graphml>
