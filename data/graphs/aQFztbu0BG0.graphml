  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ON-PREMISES</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises data sources and data ingestion pipeline sending internal and external data.</data>
    </node>
    <node id="1">
      <data key="d5">SFTP</data>
      <data key="d6">TransferFamily</data>
      <data key="d7">AWS Transfer Family endpoint for ingesting external SFTP data.</data>
    </node>
    <node id="2">
      <data key="d5">PRIVATELINK</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">AWS PrivateLink connection connecting on-premises data ingestion pipeline directly to AWS.</data>
    </node>
    <node id="3">
      <data key="d5">S3 (PCI Landing)</data>
      <data key="d6">S3</data>
      <data key="d7">Landing S3 bucket in the PCI account receiving raw PCI data. Employs lifecycle policies and archive storage.</data>
    </node>
    <node id="4">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Amazon SNS topic triggered by new file arrival events in the S3 landing bucket.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 (Tokenization)</data>
      <data key="d6">EC2</data>
      <data key="d7">Security processing services on EC2 in the PCI account performing tokenization, format conversion, and curation.</data>
    </node>
    <node id="6">
      <data key="d5">S3 (Prod)</data>
      <data key="d6">S3</data>
      <data key="d7">Production account S3 bucket storing tokenized, curated data.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 (Prod)</data>
      <data key="d6">EC2</data>
      <data key="d7">Analytics and machine learning processing workloads running on EC2 in the Production account.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">External data sent via SFTP from on-premises.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises data pipeline sends data over AWS PrivateLink.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">SFTP transfers data into the PCI S3 landing bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">PrivateLink routes data directly into the PCI S3 landing bucket.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 bucket trigger publishes notifications to SNS on new object creation.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS notifies security and tokenization services running on EC2.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Tokenized, curated data is written across account boundary to Prod S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Analytics and ML models on Prod EC2 consume curated data from Prod S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Discover Financial Services - Multi-Account Data Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=aQFztbu0BG0</data>
    <data key="d2">Architecture segregates PCI compliance scope into a dedicated PCI account and sends tokenized, curated data to a Production account for analytics and machine learning workloads.</data>
    <data key="d3">Data &amp; Analytics, Security &amp; Compliance</data>
    <data key="d4">True</data>
  </graph>
