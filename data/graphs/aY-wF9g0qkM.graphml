  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Camera</data>
      <data key="d6">UserConsumerCamera</data>
      <data key="d7">Uploads ~86,000 images per day from construction sites worldwide</data>
    </node>
    <node id="1">
      <data key="d5">SFTP</data>
      <data key="d6">TransferFamily</data>
      <data key="d7">AWS Transfer Family SFTP endpoint receiving camera image uploads</data>
    </node>
    <node id="2">
      <data key="d5">Ingestion S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Initial ingestion storage bucket for raw construction site images</data>
    </node>
    <node id="3">
      <data key="d5">Instant Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggers immediately upon image upload for real-time processing</data>
    </node>
    <node id="4">
      <data key="d5">Instant Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Detects coordinates of persons and license plates to blur them immediately</data>
    </node>
    <node id="5">
      <data key="d5">Batch Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Runs nightly batch jobs for specialized worker image processing</data>
    </node>
    <node id="6">
      <data key="d5">Rekognition Custom Labels</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Custom ML model trained to accurately detect construction workers wearing helmets and hi-vis vests</data>
    </node>
    <node id="7">
      <data key="d5">Platform S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores processed/blurred images and serves tenant platform frontend</data>
    </node>
    <node id="8">
      <data key="d5">Web Application</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Tenant website platform for viewing construction progress, time lapse, and historical archive</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Camera uploads site photos to SFTP endpoint</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SFTP transfers received images into the ingestion S3 bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 image creation event triggers Instant Lambda function</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Batch Lambda reads images from ingestion S3 bucket on a nightly schedule</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Instant Lambda invokes Rekognition to locate faces and license plates</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Real-time blurred images stored into platform S3 bucket</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Batch Lambda passes images to Rekognition Custom Labels model</data>
