<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts historical user data in a data warehouse running on Hive.</data>
    </node>
    <node id="1">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs PySpark ETL pipeline to extract, transform, and load historical data into Neptune.</data>
    </node>
    <node id="2">
      <data key="d5">NEPTUNE</data>
      <data key="d6">Neptune</data>
      <data key="d7">Fully managed graph database holding historical snapshot and real-time network of user identities.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues real-time application events generated by Pi Event Processor.</data>
    </node>
    <node id="4">
      <data key="d5">ELASTIC BEANSTALK</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Core engine executing transformation, graph querying, and simple rule-based fraud classification (achieving ~90% precision).</data>
    </node>
    <node id="5">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End users accessing identity and graph context via CrazyWall API.</data>
    </node>
    <node id="6">
      <data key="d5">UI</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Internal UI application allowing teams across Careem to visualize user nodes and edges.</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores fraud classification decisions for all evaluated actions.</data>
    </node>
    <node id="8">
      <data key="d5">TICKETING SYSTEM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Manual review ticketing queue for high-value customers flagged for potential blocking.</data>
    </node>
    <node id="9">
      <data key="d5">NEPTUNE ML</data>
      <data key="d6">Neptune</data>
      <data key="d7">Integrated graph convolutional network ML subsystem for automated deep learning fraud predictions.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Historical data extracted from Hive on S3 into EMR cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR PySpark ETL loads transformed user identity graph into Neptune.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Elastic Beanstalk queries user identity and graph neighbors for rule evaluation.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Real-time app events streamed from SQS into Elastic Beanstalk.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Elastic Beanstalk updates graph database with real-time transformed event.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Fraud classification decision saved to RDS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">High-value suspicious accounts routed via Blocking API to Ticketing System for manual review.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Exposes graph queries to users via CrazyWall API.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Exposes graph visualization data to UI via CrazyWall API.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">4</data>
      <data key="d9">Integrates with Neptune ML to execute deep learning model predictions.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Careem CrazyWall Fraud Detection Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=acm-HWJhEOA</data>
    <data key="d2">Careem's CrazyWall system combines historical graph ETL on S3/EMR and real-time processing via SQS, Elastic Beanstalk, and Amazon Neptune to detect fraud across services with 90% precision, blocking over 35,000 fraud actors and incorporating Neptune ML for advanced graph deep learning.</data>
    <data key="d3">Security, Analytics &amp; Data Lakes, Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
