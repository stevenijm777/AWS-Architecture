  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN component of the standardized web application stack.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage component for hosting static website content.</data>
    </node>
    <node id="2">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API management component for exposing backend logic.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute component for application business logic.</data>
    </node>
    <node id="4">
      <data key="d5">CERTIFICATE MANAGER</data>
      <data key="d6">ACM</data>
      <data key="d7">Manages SSL/TLS certificates for the application stack.</data>
    </node>
    <node id="5">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">DNS domain routing component.</data>
    </node>
    <node id="6">
      <data key="d5">PRODUCT A</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Standardized atomic product encapsulating specific application stack patterns.</data>
    </node>
    <node id="7">
      <data key="d5">PRODUCT B</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Standardized atomic product versioned and maintained by product teams.</data>
    </node>
    <node id="8">
      <data key="d5">PRODUCT C</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Standardized atomic product available for composition.</data>
    </node>
    <node id="9">
      <data key="d5">CLOUDFORMATION</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Assembles multiple Service Catalog products into project infrastructure templates.</data>
    </node>
    <node id="10">
      <data key="d5">CODEPIPELINE</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">CI/CD deployment pipeline deploying templates to Dev, Test, and Prod environments.</data>
    </node>
