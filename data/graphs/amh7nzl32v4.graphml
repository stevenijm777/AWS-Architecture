  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">MELCO CLUB MOBILE APP</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">iOS/Android app targeted at international customers.</data>
    </node>
    <node id="1">
      <data key="d5">WECHAT MOBILE APP</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">WeChat mini-app targeted at mainland China market.</data>
    </node>
    <node id="2">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry endpoint receiving HTTPS requests from both mobile apps.</data>
    </node>
    <node id="3">
      <data key="d5">AUTHORIZER</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda authorizer function that decodes and validates tokens.</data>
    </node>
    <node id="4">
      <data key="d5">SERVICES</data>
      <data key="d6">Lambda</data>
      <data key="d7">Separate microservice Lambda functions handling business capabilities like hotel and dining reservations.</data>
    </node>
    <node id="5">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Fully managed NoSQL database with individual table scaling.</data>
    </node>
    <node id="6">
      <data key="d5">SECRETS MANAGER</data>
      <data key="d6">SecretsManager</data>
      <data key="d7">Manages credential lifecycle for third-party integrations.</data>
    </node>
    <node id="7">
      <data key="d5">THIRD PARTIES</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External third-party SOAP/REST APIs.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Melco Club Mobile App sends requests to API Gateway.</data>
