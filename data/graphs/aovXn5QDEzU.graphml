<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Device / Digital Human Interface</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Web-capable client interface (mobile phone or laptop) where users interact with the digital human avatar.</data>
    </node>
    <node id="1">
      <data key="d5">LAMBDA BOT</data>
      <data key="d6">Lambda</data>
      <data key="d7">Central orchestration bot powered by AWS Lambda handling incoming user requests and interaction state.</data>
    </node>
    <node id="2">
      <data key="d5">UNEEQ</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party digital human service delivering the animated avatar presentation.</data>
    </node>
    <node id="3">
      <data key="d5">LEX</data>
      <data key="d6">Lex</data>
      <data key="d7">Amazon Lex handling natural speech-to-text processing and user intent recognition.</data>
    </node>
    <node id="4">
      <data key="d5">POLLY</data>
      <data key="d6">Polly</data>
      <data key="d7">Amazon Polly synthesizing text-to-speech audio streams for the digital human avatar.</data>
    </node>
    <node id="5">
      <data key="d5">OPENSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Amazon OpenSearch cluster providing sub-second search responses for standard user queries.</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Secondary Lambda function triggered by Lex to interface with deep knowledge retrieval services.</data>
    </node>
    <node id="7">
      <data key="d5">KENDRA</data>
      <data key="d6">Kendra</data>
      <data key="d7">Amazon Kendra intelligent search service indexing existing customer FAQ knowledge base articles.</data>
    </node>
    <node id="8">
      <data key="d5">CONNECT</data>
      <data key="d6">Connect</data>
      <data key="d7">Amazon Connect contact center platform managing agent call-backs for 5-10% fallback queries.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User transmits interaction input via client device to Lambda Bot.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda Bot forwards speech/text input to Amazon Lex for recognition.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda Bot synchronizes session state and avatar animation controls with UNEEQ.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda Bot routes unresolvable interactions (remaining 5-10%) to Amazon Connect contact center agents.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lex passes parsed intent and speech state back to UNEEQ avatar interface.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lex queries OpenSearch for sub-second rapid answer retrieval (handles 90-95% of queries).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Lex invokes Lambda for complex or detailed knowledge lookups.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Polly delivers synthesized audio streams to UNEEQ for speech rendering.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda queries Amazon Kendra to extract answers from indexed FAQ knowledge base documents.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Digital Human Customer Service Architecture with UNEEQ, Lex, OpenSearch, Kendra, and Connect</data>
    <data key="d1">https://www.youtube.com/watch?v=aovXn5QDEzU</data>
    <data key="d2">Consigna's Anteso digital human architecture utilizes UNEEQ for animated avatar generation, Amazon Lex/Polly for natural speech processing, OpenSearch for sub-second rapid responses (90-95% query resolution), Kendra for deep knowledge base searching, and Amazon Connect for seamless agent escalation.</data>
    <data key="d3">AI/ML, Serverless, Contact Center</data>
    <data key="d4">True</data>
  </graph>
</graphml>
