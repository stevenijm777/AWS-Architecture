<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Periodically triggers the state machine workflow to refresh the model.</data>
    </node>
    <node id="1">
      <data key="d5">State Machine</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the 3-step pipeline: data preparation, model training, and model serving deployment.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda (Data Prep)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invoked during data prep stage to query Athena, filter clickstream data, and remove outliers.</data>
    </node>
    <node id="3">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries customer clickstream/browsing data from the data lake.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores preprocessed browsing data and model outputs.</data>
    </node>
    <node id="5">
      <data key="d5">SageMaker (Training)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains Word2Vec model using SageMaker's built-in BlazingText container.</data>
    </node>
    <node id="6">
      <data key="d5">SageMaker (Deployment)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Deploys trained recommendation model as a production endpoint.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Serving)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invoked by API Gateway to request recommendations from SageMaker endpoint.</data>
    </node>
    <node id="8">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles request authentication and routing from client browser to serving Lambda.</data>
    </node>
    <node id="9">
      <data key="d5">Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">User client browsing product pages on the platform.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge periodically triggers State Machine.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">State Machine initiates data prep Lambda step.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Data prep Lambda queries Athena for customer browsing data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Completion of data prep triggers SageMaker training job.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Athena saves processed dataset into S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker training job reads training dataset from S3.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Training completion triggers SageMaker deployment job.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker endpoint returns vector-based recommendations.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Serving Lambda requests item recommendations from SageMaker endpoint.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Serving Lambda forwards recommendations back to API Gateway.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway authenticates and invokes serving Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway returns recommended items to front-end browser.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">User views product page, triggering API Gateway request.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ounass Item-Based Recommender System</data>
    <data key="d1">https://www.youtube.com/watch?v=asZIXK7V-U4</data>
    <data key="d2">Architecture for an item-based recommender system using clickstream browsing data, AWS Step Functions, SageMaker BlazingText Word2Vec model, and serverless serving via API Gateway and Lambda.</data>
    <data key="d3">E-commerce, Machine Learning, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
