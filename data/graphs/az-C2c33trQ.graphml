  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Kafka cluster receiving mobile app user activity event streams (~30,000 events/s).</data>
    </node>
    <node id="1">
      <data key="d5">EKS (Kafka Streams)</data>
      <data key="d6">EKS</data>
      <data key="d7">Managed Kubernetes cluster running Kafka Streams applications for real-time aggregation and S3 raw ingestion.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 Data Lake storing raw user activity data (~400 GB added daily, managing ~120 TB total).</data>
    </node>
    <node id="3">
      <data key="d5">EKS (Spark)</data>
      <data key="d6">EKS</data>
      <data key="d7">Managed Kubernetes cluster spawning hundreds of isolated Spark clusters on EC2 Spot instances for customer ML jobs.</data>
    </node>
    <node id="4">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database optimized for fast access to real-time aggregations and forecasting metrics.</data>
    </node>
    <node id="5">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse storing raw per-user prediction outputs for flexible querying.</data>
    </node>
    <node id="6">
      <data key="d5">EKS (API)</data>
      <data key="d6">EKS</data>
      <data key="d7">Managed Kubernetes cluster running backend API endpoints written in Go.</data>
    </node>
    <node id="7">
      <data key="d5">Client Dashboard</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">React Web Application dashboard displaying revenue per user forecasts to customers.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Kafka Streams application consumes streaming events from Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kafka Streams writes raw event logs to S3 Data Lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Kafka Streams writes real-time aggregation metrics directly into RDS.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Spark clusters pull raw data from S3 to execute ML algorithms.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Spark jobs output raw per-user predictions to Redshift.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Spark jobs output aggregated forecasting metrics to RDS.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Go API fetches fast aggregated metrics from RDS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Go API fetches flexible raw user prediction data from Redshift.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">React Client Dashboard queries the Go API service.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Addictive Predictive Analytics and ML Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=az-C2c33trQ</data>
    <data key="d2">System processes ~30k events/sec, adding 400 GB daily to a 120 TB S3 data lake. Uses EKS with Spot instances running hundreds of isolated Spark clusters for resilient, cost-effective ML model processing.</data>
    <data key="d3">AdTech Data Analytics &amp; Machine Learning</data>
    <data key="d4">True</data>
