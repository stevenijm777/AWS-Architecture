<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Console</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">User interface for data ingestion module and triggering cataloging processes.</data>
    </node>
    <node id="1">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Authenticates user logins to the web console.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized data lake storing raw and Parquet-formatted converted data.</data>
    </node>
    <node id="3">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">First line of defense to crawl data sources and store metadata catalogs.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invokes Glue crawler and manages fallback logic to custom crawlers.</data>
    </node>
    <node id="5">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs custom crawlers for specialized file formats (e.g., SPSS) and hosts Jupyter/RStudio notebook endpoints.</data>
    </node>
    <node id="6">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Performs data transformations, conversions to Parquet, and ad-hoc querying.</data>
    </node>
    <node id="7">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse fed by S3 to expose data to analytics dashboards.</data>
    </node>
    <node id="8">
      <data key="d5">Analytics</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Analytics platforms and BI dashboards powered by Redshift data.</data>
    </node>
    <node id="9">
      <data key="d5">Machine Learning</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Machine learning platforms and data science workflows.</data>
    </node>
    <node id="10">
      <data key="d5">Data Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External data sources including RDS, S3, FTP, and APIs.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Web Console authenticates users against Cognito.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Web Console initiates raw data ingestion into S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Web Console triggers Lambda function to start crawling process.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 data is queried and transformed into Parquet using Athena.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Cleaned data moves from S3 into Redshift data warehouse.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue crawls data in S3 and saves catalog metadata.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda invokes out-of-the-box Glue crawler.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda triggers custom crawlers on Fargate if Glue cannot parse custom file types.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Fargate exposes notebook endpoints for analytics users.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Redshift data warehouse feeds machine learning models.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Data connectors ingest data from RDS, S3, FTP, and APIs into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">JD Power AI Cloud Data Lake Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=b93-zn-DtBw</data>
    <data key="d2">Data ingestion and cataloging architecture using AWS Glue, Fargate, Athena, and Redshift.</data>
    <data key="d3">Data Lake, Analytics, Machine Learning, Ingestion</data>
    <data key="d4">True</data>
  </graph>
