<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart Garden Device</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Connected device running FreeRTOS with sensors monitoring water level, relative humidity, and temperature.</data>
    </node>
    <node id="1">
      <data key="d5">Mobile Application</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Receives push notifications from Pinpoint and sends user action updates back to API Gateway.</data>
    </node>
    <node id="2">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Manages MQTT topics, Device Shadow state, and topic rules for triggering backend processes.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes state change events, combines plant/user metadata from the database, and updates Pinpoint endpoint attributes.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Pinpoint</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">Manages segments, campaigns, and user notification journeys based on endpoint attributes.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives user feedback and action updates from the mobile app.</data>
    </node>
    <node id="6">
      <data key="d5">Metadata Database</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores plant metadata (e.g., date planted, plant type) and user action feedback.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends sensor telemetry (water level, relative humidity, temperature) via MQTT.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends user interaction and action feedback.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Maintains Device Shadow state sync and OTA updates.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Topic Rule triggers Lambda on Device Shadow state update.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Fetches additional plant and user metadata from the database.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Updates Pinpoint endpoint attributes for journey/campaign filtering.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends push notifications to the user's mobile app.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Persists action metadata into the database.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Eden Smart Garden Notification Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=bQqJpjv-FXs</data>
    <data key="d2">Architecture for an IoT smart garden that sends sensor data to AWS IoT Core, triggers Lambda to enrich data with plant metadata and populate Pinpoint endpoint attributes for push notifications, and receives action updates via API Gateway.</data>
    <data key="d3">IoT, Mobile</data>
    <data key="d4">True</data>
  </graph>
</graphml>
