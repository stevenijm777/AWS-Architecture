<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SNOW</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">ServiceNow portal where application owners submit help requests to restore backups.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Executes template triggered by ServiceNow to provision temporary IAM access roles.</data>
    </node>
    <node id="2">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Generates IAM roles; creation triggers audit events and provides time-bound JIT backup vault access.</data>
    </node>
    <node id="3">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Captures IAM role creation events within the child account and sends events to central EventBridge.</data>
    </node>
    <node id="4">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Central event bus receiving events across child accounts and triggering orchestration workflows.</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates automation via Lambda functions to establish backup vaults and replication policies.</data>
    </node>
    <node id="6">
      <data key="d5">Backup</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">AWS Backup vaults residing in child accounts storing application backup copies.</data>
    </node>
    <node id="7">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Centralized reporting and operational visibility dashboards analyzing backup status and failures.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">ServiceNow request triggers CloudFormation execution for restore access.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFormation creates a Just-In-Time IAM role with temporary permissions.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">IAM role creation triggers a CloudTrail event in the child account.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">IAM role grants temporary time-bound access to the target backup vault.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudTrail event is forwarded across account boundaries to the central EventBridge.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge triggers the central Step Functions state machine.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions configure backup vaults and replication policies in AWS Backup.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">United Airlines Centralized AWS Backup Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=bikXzsVihF4</data>
    <data key="d2">Architecture for automated backup creation and secure just-in-time restore access across 175+ child AWS accounts protecting over 2 PB of data.</data>
    <data key="d3">Backup &amp; Restore, Multi-Account, Governance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
