<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores encrypted simulation input data and final output results.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Kubernetes cluster orchestrating and spinning up dynamically right-sized HPC nodes.</data>
    </node>
    <node id="2">
      <data key="d5">HPC Node</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute node executing high-performance engineering simulations.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Ingests streaming logs from HPC nodes and fires pattern-matching alerts.</data>
    </node>
    <node id="4">
      <data key="d5">Status Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by CloudWatch alerts; updates status records and publishes to SNS.</data>
    </node>
    <node id="5">
      <data key="d5">Task Execution Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by SNS to perform secondary asynchronous processing tasks.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Pub/Sub messaging service queuing downstream notifications and actions.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores simulation start/end metadata and execution metrics by UUID.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 job submission schedules container provisioning in EKS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS provisions right-sized HPC compute node.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">HPC node writes encrypted simulation result outputs back to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">HPC node streams execution logs into CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch alert pattern triggers Lambda function for processing.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda records job start/end timestamps and status in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda publishes event notification to SNS topic.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS notification triggers upper Lambda function for further downstream handling.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">OnScale Cloud HPC Orchestration Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=bxvZBfbyhiA</data>
    <data key="d2">An AWS architecture for scaling parametric engineering simulations using Kubernetes (EKS) for dynamic HPC node creation and Serverless (Lambda, SNS, DynamoDB) driven by CloudWatch telemetry for spiky workload handling.</data>
    <data key="d3">Compute, HPC, Serverless, Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
