<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Tenant / Customer</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End users and tenants accessing web and mobile experiences.</data>
    </node>
    <node id="1">
      <data key="d5">Third-Party Reseller</data>
      <data key="d6">UserConsumerAPI</data>
      <data key="d7">OTAs such as Expedia, Viator, and GetYourGuide making reseller requests.</data>
    </node>
    <node id="2">
      <data key="d5">CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Global entry point routing traffic to static assets or API layer.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts static website assets, images, and event descriptions.</data>
    </node>
    <node id="4">
      <data key="d5">APPSYNC</data>
      <data key="d6">AppSync</data>
      <data key="d7">GraphQL gateway for dynamic content and data manipulation.</data>
    </node>
    <node id="5">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">REST API gateway exposing endpoints for third-party reseller OTAs.</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute running subroutines for ticketing, check-ins, and fan-out tasks.</data>
    </node>
    <node id="7">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Multi-tenant database partitioned by tenant keys.</data>
    </node>
    <node id="8">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for async task processing, notifications, and post-experience follow-ups.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Tenant/Customer initiates onboarding or dynamic requests via CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Third-party reseller calls REST API endpoint via CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CDN forwards GraphQL requests to AppSync.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">CDN forwards reseller API traffic to API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">CDN requests static web assets from S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 returns static assets back to CDN to serve clients.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">AppSync triggers Lambda resolvers to fan out subroutines.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">AppSync directly queries DynamoDB using pipeline resolvers.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes requests into AppSync GraphQL pipeline.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda places messages into SQS for async processing.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda interacts with DynamoDB to complete tenant configuration or booking.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">SQS triggers Lambda for asynchronous reprocessing.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Anchor Multi-Tenant Ticketing Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=c-1GXhOOOww</data>
    <data key="d2">Anchor's serverless multi-tenant platform handles ticketing and event check-ins across multiple channels including mobile, web, and third-party OTAs.</data>
    <data key="d3">Serverless, Multi-Tenancy, E-Commerce</data>
    <data key="d4">True</data>
  </graph>
</graphml>
