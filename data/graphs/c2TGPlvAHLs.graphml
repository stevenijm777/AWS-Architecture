<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">REST API entry point for customer web, mobile, and server traffic.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes the rules engine microservices returning responses within 200 ms.</data>
    </node>
    <node id="2">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse containing aggregated transactional and behavioral data.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores exported training datasets from Redshift.</data>
    </node>
    <node id="4">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates machine learning workflows based on dataset paths.</data>
    </node>
    <node id="5">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Handles model training, hyperparameter tuning, batch transform, and real-time endpoint hosting.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Incoming API requests are routed into the Lambda rules engine.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda invokes SageMaker real-time endpoints for fraud risk scoring.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Data scientists export historical dataset from Redshift into S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 upload events trigger Step Functions via SNS notifications.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions triggers SageMaker training, tuning, or transform jobs.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">NuData Security Real-Time Machine Learning Fraud Detection Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=c2TGPlvAHLs</data>
    <data key="d2">Architecture shows NuDetect real-time scoring via API Gateway, Lambda, and SageMaker alongside an automated model training flow using Redshift, S3, Step Functions, and SageMaker.</data>
    <data key="d3">Machine Learning &amp; AI, Security &amp; Compliance</data>
    <data key="d4">True</data>
  </graph>
