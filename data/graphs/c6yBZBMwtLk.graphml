<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Live Video Feed</data>
      <data key="d6">UserConsumerCamera</data>
      <data key="d7">SDI live video camera feed from TV and web channels.</data>
    </node>
    <node id="1">
      <data key="d5">Elemental Live 1</data>
      <data key="d6">ElementalLive</data>
      <data key="d7">Primary on-premises Elemental Live hardware appliance for live encoding.</data>
    </node>
    <node id="2">
      <data key="d5">Elemental Live 2</data>
      <data key="d6">ElementalLive</data>
      <data key="d7">Secondary redundant on-premises Elemental Live appliance for high availability.</data>
    </node>
    <node id="3">
      <data key="d5">MAM (Backend &amp; Client)</data>
      <data key="d6">MAM</data>
      <data key="d7">On-premises Multimedia Asset Manager for metadata management and editor client UI.</data>
    </node>
    <node id="4">
      <data key="d5">AWS MediaPackage</data>
      <data key="d6">MediaPackage</data>
      <data key="d7">Receives live video streams and ingests them into S3 storage.</data>
    </node>
    <node id="5">
      <data key="d5">S3 (Live Storage)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores rolling 14-day chunk playlists of live video streams.</data>
    </node>
    <node id="6">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for clip editing events dispatched from the MAM.</data>
    </node>
    <node id="7">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates payload validation, edit timecode extraction, overlay positioning, and MediaConvert jobs.</data>
    </node>
    <node id="8">
      <data key="d5">AWS MediaConvert</data>
      <data key="d6">MediaConvert</data>
      <data key="d7">Transcodes cut video segments into HD, SD, MD variants and generates poster images.</data>
    </node>
    <node id="9">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores platform event metadata, workflow status, and debugging logs.</data>
    </node>
    <node id="10">
      <data key="d5">S3 (Origin Server)</data>
      <data key="d6">S3</data>
      <data key="d7">Origin bucket serving transcoded video clips and poster images to web/mobile players.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends live SDI video stream to primary Elemental Live encoder.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends live SDI video stream to redundant Elemental Live encoder.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Streams primary live encoded video feed across boundary to AWS MediaPackage.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Streams secondary live encoded video feed across boundary to AWS MediaPackage.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">MAM client sends clip editing event payload to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Records and chunks video streams into 14-day rolling playlist files in S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions reads source video chunk metadata from live storage S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway triggers Step Functions state machine with clip metadata.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway logs initial event entry into DynamoDB.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions submits transcoding job request to MediaConvert.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions updates workflow execution state in DynamoDB for real-time monitoring.</data>
      <data key="d10">3'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">MediaConvert exports rendered clip variants and poster images to origin S3 bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">RSI Live Video Ingestion and Dynamic Clipping Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=c6yBZBMwtLk</data>
    <data key="d2">Hybrid architecture combining on-premises live video acquisition with AWS serverless video editing, transcoding, and publishing.</data>
    <data key="d3">Media &amp; Entertainment, Hybrid Cloud, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
