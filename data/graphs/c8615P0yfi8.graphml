<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EVENT BRIDGE</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Periodically triggers the state machine workflow based on a scheduled rule.</data>
    </node>
    <node id="1">
      <data key="d5">STATE MACHINE</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the multi-stage machine learning workflow (data fetching, training, endpoint deployment).</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA (Data Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">First step in state machine workflow; invokes Athena to perform data lake querying.</data>
    </node>
    <node id="3">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries user browsing history datasets stored in the data lake.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores processed training datasets exported from Athena and trained model artifacts.</data>
    </node>
    <node id="5">
      <data key="d5">SAGEMAKER (Training)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs BlazingText (word2vec) training job to convert browsing history into product vector representations.</data>
    </node>
    <node id="6">
      <data key="d5">SAGEMAKER (Endpoint)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Hosts the real-time SageMaker model endpoint for serving item recommendations.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA (Serving)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invoked by API Gateway to call the SageMaker endpoint with product IDs and fetch recommendations.</data>
    </node>
    <node id="8">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes recommendation API endpoints and routes requests from frontend web clients.</data>
    </node>
    <node id="9">
      <data key="d5">Web Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Ounass e-commerce web platform where users browse products and view recommendations.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge rule triggers the State Machine workflow on a periodic schedule.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">State Machine invokes the Data Processing Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">State Machine triggers SageMaker model training job upon data preparation completion.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">State Machine triggers deployment/update of SageMaker real-time endpoint.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Processing Lambda executes query against Athena.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Athena writes query results (browsing history dataset) into S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker reads training dataset from and writes trained model vectors to S3.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker training outputs update configuration for the SageMaker endpoint.</data>
      <data key="d10">7</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Serving Lambda queries SageMaker real-time endpoint with product ID to get similar product recommendations.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes recommendation request to the serving Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Web Client sends request with product ID to API Gateway when user views a product.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ounass Machine Learning Recommendation System Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=c8615P0yfi8</data>
    <data key="d2">Architecture powers real-time product recommendations for the Ounass luxury e-commerce platform using SageMaker BlazingText (word2vec) trained on browsing history, orchestrated periodically by Step Functions and EventBridge, yielding a 0.6% conversion rate increase.</data>
    <data key="d3">Machine Learning &amp; Personalization</data>
    <data key="d4">True</data>
  </graph>
</graphml>
