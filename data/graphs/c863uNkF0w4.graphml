<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Ingests real-time streaming messages from IoT devices.</data>
    </node>
    <node id="1">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw streaming data for machine learning and business intelligence.</data>
    </node>
    <node id="2">
      <data key="d5">ECS Microservices</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs around 30 microservices that process real-time messages and generate notifications.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes APIs for front-end web applications and dashboards.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 Auto Scaling</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Manages scaling and scheduling of container host instances across availability zones.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Spot Instances (Fleet)</data>
      <data key="d6">EC2</data>
      <data key="d7">Provides cost-effective compute capacity using Spot instance fleets, yielding ~90% cost savings.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis writes incoming IoT stream data directly to S3 Data Lake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis streams messages in parallel to ECS microservices for real-time processing.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS container workload runs on instances managed by EC2 Auto Scaling.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes client requests to backend ECS microservices.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Auto Scaling group provisions and manages EC2 Spot Instance Fleets.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Engie Digital Smart O&amp;M Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=c863uNkF0w4</data>
    <data key="d2">Engie Digital's Smart O&amp;M platform ingests 15M daily IoT messages via Kinesis into an S3 Data Lake while microservices on ECS process messages in real time. Backend compute scales using EC2 Auto Scaling and EC2 Spot Fleets, saving up to 90% compared to On-Demand pricing. API Gateway exposes the data to front-end dashboards and web apps.</data>
    <data key="d3">IoT, Streaming Data, Serverless Compute, Data Lake</data>
    <data key="d4">True</data>
  </graph>
</graphml>
