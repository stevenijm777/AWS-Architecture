<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">PUSH SERVER</data>
      <data key="d6">EC2</data>
      <data key="d7">Sends push notifications to millions of users when artists create new content, while simultaneously calling API Gateway.</data>
    </node>
    <node id="1">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives API calls from the Push Server during unexpected traffic events and triggers the AWS Lambda scale-out process.</data>
    </node>
    <node id="2">
      <data key="d5">AWS LAMBDA (Unexpected)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles unexpected event spikes by adjusting Auto Scaling Group capacity and handles scale-in logic when triggered by CloudWatch.</data>
    </node>
    <node id="3">
      <data key="d5">AWS LAMBDA (Scheduled)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles scheduled events based on pre-planned events in the Calendar component to pre-provision Auto Scaling capacity.</data>
    </node>
    <node id="4">
      <data key="d5">CALENDAR</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Represents scheduled calendar triggers for pre-planned artist events.</data>
    </node>
    <node id="5">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors API traffic patterns and triggers AWS Lambda to initiate scale-in when traffic returns to baseline levels.</data>
    </node>
    <node id="6">
      <data key="d5">AUTOSCALING GROUP</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Manages compute instances, utilizing 70% Spot Instances to eliminate cold start latency and reduce costs by up to 50%.</data>
    </node>
    <node id="7">
      <data key="d5">goployer</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Open-source deployment tool developed by BNX to automate Auto Scaling Group deployments using manifest files (Deployment as Code).</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Push Server calls API Gateway endpoint upon post creation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway triggers Lambda function to handle unexpected spike.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Unexpected Lambda modifies Auto Scaling Group instance count to meet demand.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Scheduled Lambda checks scheduled calendar events.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Scheduled Lambda adjusts Auto Scaling Group target capacity prior to planned event.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch rule triggers Lambda to check traffic levels and scale in when activity returns to normal.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Goployer provisions and automates Auto Scaling Group deployment process based on manifest configuration.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">BNX Event-Driven Auto Scaling Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=cIqVilu7KUM</data>
    <data key="d2">Architecture uses AWS Lambda and AutoScaling with Spot Instances (70% spot, saving ~50% EC2 cost) to handle traffic spikes up to 9M TPM.</data>
    <data key="d3">Compute, Auto Scaling, Serverless, DevOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
