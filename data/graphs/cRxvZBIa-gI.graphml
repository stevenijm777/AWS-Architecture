<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web / Mobile</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Consumers managing credit via web or mobile devices.</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing incoming traffic to the EKS cluster.</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Elastic Kubernetes Service managing containerized microservices and pods.</data>
    </node>
    <node id="3">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 On-Demand instances providing ~40% baseline compute capacity.</data>
    </node>
    <node id="4">
      <data key="d5">SPOT INSTANCE(S)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 Spot instances providing ~60% cost-optimized compute capacity.</data>
    </node>
    <node id="5">
      <data key="d5">AURORA GLOBAL</data>
      <data key="d6">Aurora</data>
      <data key="d7">Multi-region replication PostgreSQL database handling ACID compliant transactional queries.</data>
    </node>
    <node id="6">
      <data key="d5">DOCUMENT STORAGE</data>
      <data key="d6">DocumentDB</data>
      <data key="d7">NoSQL document storage handling credit report documents and unstructured data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Consumer web and mobile traffic enters through ALB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards HTTP/HTTPS traffic to application services running on compute instances.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Application services execute ACID transactional SQL operations on Aurora Global.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Application services query and write NoSQL data to Document Storage.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Equifax myequifax.com Cloud Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=cRxvZBIa-gI</data>
    <data key="d2">Architecture features a 60/40 blend of Spot and On-Demand instances running on Amazon EKS, backed by Aurora Global (PostgreSQL) and Document Storage.</data>
    <data key="d3">Web Architecture / Containerized Compute / Multi-Region Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
