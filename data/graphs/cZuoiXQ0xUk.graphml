<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ENGINEERS</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Road inspection engineers who upload video clips and review/validate detected defects.</data>
    </node>
    <node id="1">
      <data key="d5">UI</data>
      <data key="d6">UserCompanyWebsite</data>
      <data key="d7">Web application deployed on AWS for uploading inspection video and displaying results.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing raw inspection video files uploaded from UI.</data>
    </node>
    <node id="3">
      <data key="d5">ELEMENTAL MEDIACONVERT</data>
      <data key="d6">MediaConvert</data>
      <data key="d7">AWS Elemental MediaConvert used to split uploaded video files into individual frames.</data>
    </node>
    <node id="4">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Amazon SageMaker used to train ML model on annotated images with road defects.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA (Inference)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Containerized Lambda functions running in parallel to perform ML inference on video frames using TensorFlow model.</data>
    </node>
    <node id="6">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB table storing frame metadata, defect records, and deduplication logic data.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA (Training Pipeline)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function triggering automated retraining pipeline based on rejected/validated feedback from engineers in DynamoDB.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Engineers upload video recordings to the web UI.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Web UI stores raw video files in S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Web UI triggers Elemental MediaConvert job to split video into frames.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Elemental MediaConvert feeds video frames to inference Lambda functions.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker model is packaged and deployed into Lambda container image.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Inference Lambda functions store metadata and detected defects into DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">DynamoDB provides defect feedback data to automated training pipeline Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Automated training pipeline Lambda updates metadata and state back to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">AWS Automated Road Defect Inspection Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=cZuoiXQ0xUk</data>
    <data key="d2">Serverless pipeline processes tens of thousands of video frames in parallel using Elemental MediaConvert, Lambda containers with SageMaker ML models, and DynamoDB.</data>
    <data key="d3">Machine Learning, Serverless, Media Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
