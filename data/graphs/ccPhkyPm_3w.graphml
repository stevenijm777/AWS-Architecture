  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DDOS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">DDoS mitigation capabilities generating attack event and metric data.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUD WAF</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Cloud WAF network protecting applications and generating incident logs.</data>
    </node>
    <node id="2">
      <data key="d5">BOT PROTECTION</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Bot protection solution identifying and blocking malicious automated attacks.</data>
    </node>
    <node id="3">
      <data key="d5">RUNTIME AGENTS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Runtime security agents running on-premises or in cloud environments.</data>
    </node>
    <node id="4">
      <data key="d5">STREAMING FOR KAFKA</data>
      <data key="d6">MSK</data>
      <data key="d7">Amazon MSK ingestion hub handling event and metric topics globally.</data>
    </node>
    <node id="5">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Customer analytics and SIEM destination receiving security events in &lt;3 minutes.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central research data lake storing ingested attack data for threat intelligence.</data>
    </node>
    <node id="7">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Used by threat researchers to process large-scale attack data in S3.</data>
    </node>
    <node id="8">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts subscriber workloads, event processors, and time-series databases for metric dashboards.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends DDoS attack events and metrics to MSK.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
