  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS IAM Identity Center</data>
      <data key="d6">IAM</data>
      <data key="d7">System entry point hosting the published Q App where users authenticate.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Q</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Central generative AI application hub indexing data sources and executing plugins.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon S3 Documentation</data>
      <data key="d6">S3</data>
      <data key="d7">Stores documentation and PDFs indexed by Amazon Q.</data>
    </node>
    <node id="3">
      <data key="d5">Internet Web Crawler</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data source used to crawl external web domains up to specified link depths.</data>
    </node>
    <node id="4">
      <data key="d5">Confluence</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Knowledge base containing articles and documentation indexed by Amazon Q.</data>
    </node>
    <node id="5">
      <data key="d5">ServiceNow</data>
      <data key="d6">ServiceNow</data>
      <data key="d7">CMDB platform queried by Amazon Q for configuration management details.</data>
    </node>
    <node id="6">
      <data key="d5">AWS Config</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">Takes state snapshots of AWS resources and synchronizes data to ServiceNow via connector.</data>
    </node>
    <node id="7">
      <data key="d5">Jira</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External plugin integration target for automatic issue and ticket creation.</data>
    </node>
    <node id="8">
      <data key="d5">Zendesk</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External plugin integration target for support ticket creation.</data>
    </node>
    <node id="9">
      <data key="d5">Salesforce</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External plugin integration target for CRM case and data management.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Authenticated user accesses the Q App to send natural language prompts.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Q reads and indexes documentation from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Q queries web crawler data source for external web content.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Q reads knowledge base articles from Confluence.</data>
      <data key="d10">1''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Q queries CMDB inventory data in ServiceNow.</data>
      <data key="d10">1'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Q executes action plugin to open a ticket in Jira.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Q executes action plugin to create a case in Zendesk.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Q executes action plugin to interact with Salesforce.</data>
      <data key="d10">0''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Config syncs AWS resource state snapshots into ServiceNow CMDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">First Orion Amazon Q Cloud Operations Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=cczJb4heExQ</data>
    <data key="d2">First Orion uses Amazon Q published via AWS IAM Identity Center to provide a central web application for cloud operations troubleshooting. It indexes documentation from S3, web crawlers, Confluence, and CMDB data from ServiceNow (fed by AWS Config), while allowing natural language action plugin execution in Jira, Zendesk, and Salesforce.</data>
    <data key="d3">generative_ai, cloud_operations, ITSM</data>
    <data key="d4">True</data>
  </graph>
