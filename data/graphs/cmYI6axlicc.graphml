<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">FACTORY</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">15+ global factories with 6 source systems each generating 4,000 real-time data streams.</data>
    </node>
    <node id="1">
      <data key="d5">KAFKA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Real-time Kafka streaming cluster for initial cloud data ingestion.</data>
    </node>
    <node id="2">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Two-layer EMR architecture: Flink real-time consumers and UDI batch transformation jobs.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized data lake storing around 30 TB of structured and unstructured data.</data>
    </node>
    <node id="4">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse layer querying S3 directly via Redshift Spectrum.</data>
    </node>
    <node id="5">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational database providing real-time data access for operational apps.</data>
    </node>
    <node id="6">
      <data key="d5">BI REPORTS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Business intelligence reports used by data analysts.</data>
    </node>
    <node id="7">
      <data key="d5">REAL-TIME APPS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Operational applications built by factory developers querying Aurora.</data>
    </node>
    <node id="8">
      <data key="d5">EXTERNAL SYSTEMS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External systems consuming central platform data via APIs.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Factories stream real-time production data to Kafka clusters.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Flink consumers on EMR consume Kafka data streams in real time.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR Flink layer streams processed data directly into S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR Flink layer writes real-time outputs directly to Aurora.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Secondary EMR UDI batch transformation jobs process data recursively.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift Spectrum queries data stored directly in S3.</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift serves data to BI reports.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">BI Reports and ML models read directly from S3 based on specific analytics workloads.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Real-time factory applications query Aurora for operational data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">External systems consume platform data via APIs connected to Aurora.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Pirelli Global Manufacturing Data Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=cmYI6axlicc</data>
    <data key="d2">Pirelli ingests ~4,000 data streams across 15+ global factories (~30 TB total volume) into Kafka and EMR, writing to S3, Aurora, and Redshift to serve over 500 downstream BI, AI, and operational applications.</data>
    <data key="d3">Data Lake, Analytics, Streaming, Operational Database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
