<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Software-defined contact center routing calls and managing contact flows across multiple countries.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Encrypted data lake storing audio call recordings and converted text transcripts.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda (Transcribe Trigger)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 audio uploads to invoke the Amazon Transcribe job.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts recorded audio calls into searchable text transcripts.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Lambda (Greeting Lookup)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Fetches country-specific greetings and operational parameters during contact flows.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores country-specific localized greetings, disclaimers, and business logic data.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Lex</data>
      <data key="d6">Lex</data>
      <data key="d7">Provides natural language understanding and conversational AI capabilities.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Dynamically translates disclaimers and localized text into 21 languages.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Polly</data>
      <data key="d6">Polly</data>
      <data key="d7">Converts translated text into natural-sounding spoken audio in multiple languages.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Connect triggers Lambda to query localized greeting data.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Connect routes customer voice input to Lex for natural language processing.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Connect passes localized text and disclaimers to Translate.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Connect writes encrypted call audio recordings to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 upload triggers Lambda function for transcription process.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda triggers Amazon Transcribe processing on the recorded audio.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Transcribe outputs finished text transcriptions back into S3 data lake.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda reads country-specific greetings and parameters from DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Translate passes translated text to Polly for voice synthesis.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DXC Technology Munich Re Serverless Contact Center Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=cmlhEbm1kPk</data>
    <data key="d2">Multilingual global contact center built with Amazon Connect, AWS Lambda, DynamoDB, Amazon Lex, Translate, Polly, Transcribe, and S3.</data>
    <data key="d3">Contact Center, Machine Learning, Serverless Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
