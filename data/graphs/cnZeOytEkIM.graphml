<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user accessing the PropertyFinder website (PF.AE).</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing incoming traffic into EKS ingress controller.</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS cluster hosting ~20 microservice container instances and ~2,000 containers daily.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 SPOT 1</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 Spot instance running in Availability Zone 1.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 SPOT 2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 Spot instance running in Availability Zone 2.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 SPOT 3</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 Spot instance running in Availability Zone 3.</data>
    </node>
    <node id="6">
      <data key="d5">EVENT BRIDGE</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Listens for EC2 Spot Instance Interruption Warning events.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Function invoked upon spot interruption to trigger auto-scaling and node draining.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User sends web requests (PF.AE) to ALB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes website traffic to pod running on EC2 Spot instance in EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Workload failover/rescheduling to EC2 Spot instance 1 in another AZ.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Workload failover/rescheduling to EC2 Spot instance 3 in another AZ.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EventBridge receives 2-minute spot interruption notice and invokes Lambda function.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda triggers node draining and Auto Scaling Group scale-up for terminating instance.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">PropertyFinder EKS Spot Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=cnZeOytEkIM</data>
    <data key="d2">PropertyFinder runs 100% of its microservices production workloads on EC2 Spot instances inside Amazon EKS. EventBridge and Lambda handle spot interruption events to automatically drain terminating nodes and scale up replacements, saving up to 50% on infrastructure costs.</data>
    <data key="d3">compute,containers,serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
