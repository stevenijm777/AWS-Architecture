<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer</data>
      <data key="d6">UserConsumerDeveloper</data>
      <data key="d7">Submits GeoTIFF development applications to the system.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Serves as the entry point for developer upload requests.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores original GeoTIFF files and incoming LandXML converted files.</data>
    </node>
    <node id="3">
      <data key="d5">Third-Party Provider</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Converts GeoTIFF files into LandXML format containing geospatial information.</data>
    </node>
    <node id="4">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates parallel validation workflows triggered by S3 folder events.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda Validation</data>
      <data key="d6">Lambda</data>
      <data key="d7">Checks if the file is valid XML and conforms to current LandXML schema.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda Render</data>
      <data key="d6">Lambda</data>
      <data key="d7">Forms polygons using lightweight Python geospatial libraries in memory.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores validation results and multi-version document lifecycle state.</data>
    </node>
    <node id="8">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends alerts and notifications regarding processing status or errors.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer submits GeoTIFF upload request.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway writes GeoTIFF file to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 triggers/sends GeoTIFF to Third-Party Provider for conversion.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 file upload triggers Step Functions execution upon arrival.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Third-Party Provider returns converted LandXML file back to S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes Lambda Validation function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes Lambda Render function.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda Render writes validation and polygon results to DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB triggers SNS notifications based on state changes or errors.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">AC3 Serverless Geospatial Data Lake Validation Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=co4_t2gN1T8</data>
    <data key="d2">Automates conversion of GeoTIFF files into LandXML and validates geospatial polygons using a serverless architecture.</data>
    <data key="d3">Serverless, Data Lake, Geospatial Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
