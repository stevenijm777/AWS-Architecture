  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Front-end CDN mitigating DDoS at edge.</data>
    </node>
    <node id="1">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS Web Application Firewall creating filters for layer 7 attacks.</data>
    </node>
    <node id="2">
      <data key="d5">Shield Advanced</data>
      <data key="d6">ShieldAdvanced</data>
      <data key="d7">Mitigates layer 3/4 DDoS attacks (SYN/ACK floods) and basic layer 7 floods.</data>
    </node>
    <node id="3">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Hosted zones routing traffic based on sensitivity.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores CloudFront access logs.</data>
    </node>
    <node id="5">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Handles non-sensitive application traffic inside main VPC.</data>
    </node>
    <node id="6">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts F5 Big-IP WAF for extra inspection of sensitive traffic inside main VPC.</data>
    </node>
    <node id="7">
      <data key="d5">DX</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">AWS Direct Connect providing low-latency link to on-premises data center.</data>
    </node>
    <node id="8">
      <data key="d5">VPC Peering</data>
      <data key="d6">VPCPeering</data>
      <data key="d7">Connects main VPC to application channel VPCs.</data>
    </node>
    <node id="9">
      <data key="d5">ON-PREM</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Hosts legacy application servers and threat analytics engines.</data>
    </node>
    <node id="10">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">Target channel account VPCs hosting application backends.</data>
    </node>
    <node id="11">
      <data key="d5">Dynamo DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores malicious IP addresses with expiration TTL.</data>
    </node>
    <node id="12">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Inspects DynamoDB for new/expired IPs and updates WAF rules.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront evaluates incoming traffic against WAF rules.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront forwards validated traffic to Route 53.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront sends traffic access logs to S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes non-sensitive traffic to ELB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes sensitive traffic to EC2 (F5 Big-IP).</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">On-premises analysis servers ingest logs from S3 for threat detection.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards traffic towards Direct Connect for on-premises backend.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards traffic via VPC Peering to channel VPCs.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 (F5 Big-IP) forwards inspected traffic towards Direct Connect.</data>
      <data key="d10">3''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 (F5 Big-IP) forwards inspected traffic via VPC Peering to channel VPCs.</data>
      <data key="d10">3'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Direct Connect routes backend requests to on-premises application servers.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">VPC Peering delivers backend requests to application channel VPCs.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">On-premises analytics writes identified malicious IPs to DynamoDB with expiration TTL.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB table updates trigger Lambda function.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="12" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda updates WAF block rules with new or expired IP addresses.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">William Hill Multi-Layer DDoS Mitigation and Routing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=d0EE1HuZSEU</data>
    <data key="d2">Architecture showcases edge protection using CloudFront, AWS WAF, and Shield Advanced, coupled with on-premises log analysis and dynamic DynamoDB/Lambda WAF rule updates.</data>
    <data key="d3">DDoS Mitigation, Hybrid Cloud, Dynamic Threat Protection</data>
    <data key="d4">True</data>
