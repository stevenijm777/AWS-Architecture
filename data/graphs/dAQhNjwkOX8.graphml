<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point receiving conversation requests from external channels like Twitter.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda Proxy</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles language translation orchestration and conversation routing.</data>
    </node>
    <node id="2">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Translates non-English conversations back into the English base language.</data>
    </node>
    <node id="3">
      <data key="d5">Lex</data>
      <data key="d6">Lex</data>
      <data key="d7">Provides automated first-line conversational responses.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Provides contextually aware fallback answers for escalated queries.</data>
    </node>
    <node id="5">
      <data key="d5">TL</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Team lead performing corrections and approvals on AI responses.</data>
    </node>
    <node id="6">
      <data key="d5">Training</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Builds and retrains conversational models based on feedback data.</data>
    </node>
    <node id="7">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Asynchronously broadcasts conversation datasets downstream.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda Data Processor</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes conversation data and stores it into persistent databases and search indices.</data>
    </node>
    <node id="9">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores historical conversation data for analytics and retraining.</data>
    </node>
    <node id="10">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Stores search indices used for AI interaction monitoring.</data>
    </node>
    <node id="11">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Generates analytics dashboards and KPIs from RDS and Elasticsearch data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes incoming request payload to Lambda Proxy.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda Proxy sends query text to Comprehend for language translation.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda Proxy forwards translated conversation text to Lex for standard answers.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda Proxy asynchronously streams conversation data to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lex escalates unsatisfied queries to SageMaker for contextual answers.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Unresolved interactions escalate from SageMaker to a human Team Lead.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Team Lead submits response corrections to SageMaker Training.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Retrained model is deployed back into SageMaker.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Updated model updates Lex conversational intents.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">SNS triggers Lambda Data Processor.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda Data Processor stores conversation records in RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda Data Processor indexes conversation data into Elasticsearch.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">QuickSight queries RDS for conversation history and KPIs.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">QuickSight reads search performance data from Elasticsearch.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ketchum Consulting Conversational AI Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=dAQhNjwkOX8</data>
    <data key="d2">Serverless conversational AI platform built on AWS handling hundreds of thousands of conversations per month across multiple channels and languages.</data>
    <data key="d3">AI/ML, Serverless, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
