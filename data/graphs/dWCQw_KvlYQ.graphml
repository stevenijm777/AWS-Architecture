<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Serves Electronic Program Guide (EPG) event topics informing about upcoming sports events.</data>
    </node>
    <node id="1">
      <data key="d5">STEP FUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Extracts video stream manifests (DASH, Smooth, HLS) and orchestrates container tasks.</data>
    </node>
    <node id="2">
      <data key="d5">FARGATE</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs containers (one per stream) to extract keyframes from video streams.</data>
    </node>
    <node id="3">
      <data key="d5">REKOGNITION</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Analyzes video keyframes using text detection to extract match time information.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Houses the Stream Offset Service and Key Moment Service to process video deltas and match events.</data>
    </node>
    <node id="5">
      <data key="d5">KINESIS ANALYTICS</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Ingests real-time data feeds from the pitch and filters key match events.</data>
    </node>
    <node id="6">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores key moments data for retrieval, especially for Video on Demand (VOD) playback.</data>
    </node>
    <node id="7">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Multi-region service containers fetching key moments from Redis cache and DynamoDB.</data>
    </node>
    <node id="8">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives user API requests and routes traffic via Route 53 latency-based routing.</data>
    </node>
    <node id="9">
      <data key="d5">CLIENTS</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">User client applications across smartphones, laptops, and smart TVs.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS publishes event start notifications to Step Functions.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions instantiates Fargate containers for each video stream.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate passes extracted keyframes to Rekognition for text extraction.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate sends stream timing data to the Lambda Stream Offset Service.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis Analytics forwards filtered pitch event data to Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS fetches key moment markers from DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway routes client requests to ECS container tasks.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Clients connect to API Gateway to retrieve overlay key moments.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DAZN Key Moments Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=dWCQw_KvlYQ</data>
    <data key="d2">DAZN architecture for overlaid Key Moments synchronization during live and VOD sports streaming.</data>
    <data key="d3">Media &amp; Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
