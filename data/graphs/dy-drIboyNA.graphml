<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API Gateway (Write)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for write APIs.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda (Write)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Microservices running Node.js to execute write logic.</data>
    </node>
    <node id="2">
      <data key="d5">S3 (Raw Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw file drops such as Medicare practitioner data files.</data>
    </node>
    <node id="3">
      <data key="d5">Kinesis (Write Buffer)</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Buffers write requests and maintains ordering of event payloads.</data>
    </node>
    <node id="4">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs persistent hot Apache Spark applications/state machines for data staging, QA, and validation.</data>
    </node>
    <node id="5">
      <data key="d5">S3 (Data Lake)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores longitudinal Parquet append-log datasets retention-compliant up to 25+ years.</data>
    </node>
    <node id="6">
      <data key="d5">Kinesis (Read Buffer)</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Output buffer stream for validated data ready to be pushed to read stores.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">High-availability domain-driven read database.</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Used for semantic, spatial, and condition-based search indexing.</data>
    </node>
    <node id="9">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Main query engine for data lake reporting and structured queries against S3/DynamoDB.</data>
    </node>
    <node id="10">
      <data key="d5">API Gateway (Read)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for consumer read APIs and embedded search widgets.</data>
    </node>
    <node id="11">
      <data key="d5">Lambda (Read)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes consumer read microservices.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers write Lambda function.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda publishes write payload event to Kinesis write buffer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR processes raw input files dropped into raw S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR Spark cluster reads incoming payloads from Kinesis write buffer.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR writes structured gold Parquet files to S3 data lake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">EMR publishes QA-checked output records to read Kinesis stream.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Buffered output updates DynamoDB domain tables.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">DynamoDB Streams replicate domain updates to Elasticsearch.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries append-log data lake stored in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena references structured domain representation in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">4</data>
      <data key="d9">Consumer read API Gateway invokes read Lambda microservice.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Read Lambda queries DynamoDB for domain lookups.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Health Direct Australia Read/Write Segregated Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=dy-drIboyNA</data>
    <data key="d2">National directory architecture processing ~90 million hits per month. Architecture clearly segregates write-intensive quality assurance processing from high-velocity read-intensive domain API queries.</data>
    <data key="d3">Healthcare Data Lake &amp; High-Availability Directory Service</data>
    <data key="d4">True</data>
  </graph>
</graphml>
