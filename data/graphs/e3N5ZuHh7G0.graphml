<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Entry point receiving incoming public user traffic.</data>
    </node>
    <node id="1">
      <data key="d5">HAProxy</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Self-managed proxy layer that regularly queries Route 53 to determine active/canary targets.</data>
    </node>
    <node id="2">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">DNS service queried by HAProxy to dynamically resolve target CNAME records.</data>
    </node>
    <node id="3">
      <data key="d5">Blue Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Live production cluster running current application version on EC2.</data>
    </node>
    <node id="4">
      <data key="d5">Green Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">New deployment cluster on EC2 receiving canary or cutover traffic.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB forwards incoming client requests to HAProxy.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">HAProxy periodically queries Route 53 to resolve active CNAME targets.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">HAProxy routes production traffic to the active Blue cluster.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">HAProxy routes canary (e.g. 10%) or cutover traffic to the Green cluster.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">WAG Labs Canary Deployment Architecture with HAProxy and Route 53</data>
    <data key="d1">https://www.youtube.com/watch?v=e3N5ZuHh7G0</data>
    <data key="d2">Architecture showcases canary deployments managed by an HAProxy cluster querying internal Route 53 CNAME records to shift traffic between Blue and Green EC2 clusters.</data>
    <data key="d3">Deployment Strategy, Dynamic Routing, Blue-Green Deployment</data>
    <data key="d4">True</data>
  </graph>
</graphml>
