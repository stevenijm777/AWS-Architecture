<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CW EVENT</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Scheduled event trigger for periodic fetching of legacy listing data.</data>
    </node>
    <node id="1">
      <data key="d5">Monolith DB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Legacy system database storing original property listings.</data>
    </node>
    <node id="2">
      <data key="d5">Dispatcher Fetcher Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Pulls data from the legacy Monolith DB and writes it to Dispatcher DynamoDB.</data>
    </node>
    <node id="3">
      <data key="d5">Dispatcher DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Data store for synchronized legacy property listings with DynamoDB Streams enabled.</data>
    </node>
    <node id="4">
      <data key="d5">Dispatcher Stream Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes DynamoDB Stream events to evaluate and push relevant listing changes.</data>
    </node>
    <node id="5">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Central publishing API endpoint for HomeGate.</data>
    </node>
    <node id="6">
      <data key="d5">Importer Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Entry point for the importer microservice; persists incoming listing data and triggers processing.</data>
    </node>
    <node id="7">
      <data key="d5">Importer DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Internal data store for imported property listings.</data>
    </node>
    <node id="8">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates multi-step listing ingestion workflow (geo-tagging, call tracking, image optimization, quality grading).</data>
    </node>
    <node id="9">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes property listing publication events to downstream microservices such as search alerts.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch Event triggers the fetcher Lambda on schedule.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Fetcher Lambda pulls property data from the legacy Monolith DB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Fetcher Lambda writes data into Dispatcher DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB Stream triggers Dispatcher Stream Lambda on change.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Stream Lambda sends relevant property updates to API Gateway.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway invokes Importer Lambda.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Importer Lambda saves the listing into Importer DynamoDB.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Importer Lambda starts execution of Step Functions workflow.</data>
      <data key="d10">7</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions publishes completion event message to SNS topic.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Homegate Property Listing Ingestion Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=eEfWd4EgH_s</data>
    <data key="d2">HomeGate property listing ingestion system handling legacy synchronization and serverless microservice processing.</data>
    <data key="d3">Serverless, Data Ingestion, Legacy Migration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
