  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Camera</data>
      <data key="d6">UserConsumerCamera</data>
      <data key="d7">Camera in stadium capturing live video feed</data>
    </node>
    <node id="1">
      <data key="d5">Encoder 1</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Primary on-premises hardware encoder to reduce bandwidth usage</data>
    </node>
    <node id="2">
      <data key="d5">Encoder 2</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Secondary redundant on-premises hardware encoder</data>
    </node>
    <node id="3">
      <data key="d5">Direct Connect 1</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Primary Direct Connect interface into AWS region</data>
    </node>
    <node id="4">
      <data key="d5">Direct Connect 2</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Redundant Direct Connect interface into AWS region</data>
    </node>
    <node id="5">
      <data key="d5">MediaConnect 1</data>
      <data key="d6">MediaConnect</data>
      <data key="d7">Primary AWS Elemental MediaConnect flow aggregator using ST 2022-7 protocol</data>
    </node>
    <node id="6">
      <data key="d5">MediaConnect 2</data>
      <data key="d6">MediaConnect</data>
      <data key="d7">Redundant AWS Elemental MediaConnect flow aggregator</data>
    </node>
    <node id="7">
      <data key="d5">Client MediaConnect</data>
      <data key="d6">MediaConnect</data>
      <data key="d7">Client-owned MediaConnect instance receiving high-quality bitrate stream in the same region</data>
    </node>
    <node id="8">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 compute instances performing video transcoding into mezzanine formats</data>
    </node>
    <node id="9">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 storage for mezzanine video formats, supporting VOD and replay</data>
    </node>
    <node id="10">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN for global B2B2C video content distribution</data>
    </node>
    <node id="11">
      <data key="d5">Audience</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Global end-user viewing audience</data>
    </node>
    <edge source="0" target="1" id="0">
