<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Devices</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Runs the GrabDefence SDK to collect device signals such as Wi-Fi, IP address, and emulation/spoofing checks.</data>
    </node>
    <node id="1">
      <data key="d5">GrabDefence Client Services</data>
      <data key="d6">UserConsumerAPI</data>
      <data key="d7">External B2B client backend services submitting transaction events for real-time fraud prediction.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Managed Streaming for Apache Kafka</data>
      <data key="d6">MSK</data>
      <data key="d7">Ingests high-frequency signal events (hundreds per second) and streams them to downstream feature bank and graph processing.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes entry point APIs for client services to request fraud predictions.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Elastic Kubernetes Service (Amazon EKS)</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts the central feature bank, ML model building, and real-time prediction engines. Can dynamically scale 10x within minutes.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Graph database capturing hidden fraud networks and shared entity attributes (e.g., shared Wi-Fi, IP, or credit cards).</data>
    </node>
    <node id="6">
      <data key="d5">Amazon ElastiCache (Redis)</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory caching layer storing pre-computed features for ultra-fast prediction retrieval.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores key-value user profile data with fast attribute lookup in dedicated per-tenant tables.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Relational Database Service (Amazon RDS)</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores multi-event user histories for performing analytical joins over recent time windows in dedicated per-tenant instances.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Streams collected SDK device signals to Kafka at high frequency.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Client service submits transaction prediction request via API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingests stream data into Neptune graph database to build network relationships.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Streams event signals to EKS for central feature bank computation.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes request payload to prediction engine on EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway returns final non-biased fraud decision response to client service.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS queries graph patterns and network signals from Neptune.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS reads and updates cached feature computations in Redis.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS fetches user profile attributes from DynamoDB.</data>
      <data key="d10">2''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS queries historical multi-event joins from RDS.</data>
      <data key="d10">2'''</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">GrabDefence Real-Time Fraud Detection Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ebngmAqbe-k</data>
    <data key="d2">Architecture for GrabDefence, a B2B fraud prediction platform processing high-frequency signals, building feature banks on EKS, storing graph relationships in Neptune, and returning real-time fraud predictions to external clients via API Gateway.</data>
    <data key="d3">AWS</data>
    <data key="d4">True</data>
  </graph>
</graphml>
