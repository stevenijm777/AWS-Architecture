<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">MySQL Aurora database serving as a primary operational data source.</data>
    </node>
    <node id="1">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">Database Migration Service reading binlogs from Aurora for continuous ingestion.</data>
    </node>
    <node id="2">
      <data key="d5">Internet</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External internet data sources.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered serverless ingestion functions that write data to S3.</data>
    </node>
    <node id="4">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Creates metadata catalog and executes Glue Workflows/ETL processes.</data>
    </node>
    <node id="5">
      <data key="d5">LAKE FORMATION</data>
      <data key="d6">LakeFormation</data>
      <data key="d7">Provides fine-grained permission control and security tag management over Glue catalog.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central Data Lake storage holding ~15TB of data, separated by security categories.</data>
    </node>
    <node id="7">
      <data key="d5">STEPFUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates complex data workflows and integration steps.</data>
    </node>
    <node id="8">
      <data key="d5">TF</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Terraform used to provision infrastructure and consistent dataset descriptors.</data>
    </node>
    <node id="9">
      <data key="d5">Data MP</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Internal Data Marketplace for analysts and data scientists to explore compliant data products.</data>
    </node>
    <node id="10">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Integrates internal platform services with data lake capabilities.</data>
    </node>
    <edge source="1" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">DMS connects to Aurora to read binlogs.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">DMS continuously writes migration files into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Internet events trigger Lambda ingestion.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes ingested data into S3 buckets.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue accesses data in S3 for cataloging and ETL processing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Lake Formation enforces fine-grained access policies on Glue catalog.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">4</data>
      <data key="d9">Terraform provisions data lake S3 resources and dataset descriptors.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Data Marketplace queries metadata and access policies via Lake Formation.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">API Gateway routes requests to Step Functions.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">TIS Cloud Data Lake Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ec6j-MaOSUc</data>
    <data key="d2">Data lake architecture managing over 15TB of data growing at ~500GB/month. Implements multi-account setup with data isolation, fine-grained access control via Lake Formation, and IaC data product management with Terraform.</data>
    <data key="d3">Data Lake &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
