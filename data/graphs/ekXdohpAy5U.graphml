<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Documents</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Raw documents from client systems, including extraction reports, process logs, and internal communications.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Central orchestrator routing documents across ML models, structure analysis, graph database, and search cluster.</data>
    </node>
    <node id="2">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Custom models trained specifically for oil and gas domain tasks like document classification and key fact extraction.</data>
    </node>
    <node id="3">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">AWS NLP service performing sentence-level analysis, named entity recognition, and part-of-speech tagging.</data>
    </node>
    <node id="4">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Graph database storing dynamic and evolving knowledge representations and relationships.</data>
    </node>
    <node id="5">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Full-text search engine indexing raw unstructured text for free-text search fallback.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw incoming documents are passed into the Lambda ingestion function.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda passes raw document content to custom SageMaker models for domain feature extraction.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda passes extracted text to Amazon Comprehend for sentence structure analysis.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda persists structured graph data into the Amazon Neptune knowledge graph database.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda forwards raw unstructured information to Elasticsearch for full-text indexing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker returns extracted key facts and document classifications back to Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Accenture Oil and Gas Knowledge Management Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ekXdohpAy5U</data>
    <data key="d2">Architecture processes unstructured documents from oil and gas operations to extract structured facts into Amazon Neptune while indexing raw text in Amazon OpenSearch.</data>
    <data key="d3">AI/ML, Databases, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
