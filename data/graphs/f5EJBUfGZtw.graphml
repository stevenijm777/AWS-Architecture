<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Expedia Group</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Source applications (on-prem and cloud) providing booking and partner data in diverse formats (Parquet, CSV, JSON).</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data ingestion layer / data lake bucket receiving daily batch data from Expedia Group applications.</data>
    </node>
    <node id="2">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Handles custom processing and transformations (e.g., Parquet file bookmarking) where Glue had limitations.</data>
    </node>
    <node id="3">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Serverless ETL service used to transform heterogeneous source data into a unified structure.</data>
    </node>
    <node id="4">
      <data key="d5">S3 (CSV)</data>
      <data key="d6">S3</data>
      <data key="d7">Output bucket storing transformed CSV files suitable for Salesforce Einstein Analytics.</data>
    </node>
    <node id="5">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs Kafka consumer tasks processing 5 to 10 million real-time events per day.</data>
    </node>
    <node id="6">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">MySQL-compatible database engine used for aggregating and sorting real-time streaming data.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes data processing functions and prepares queueable messages.</data>
    </node>
    <node id="8">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Message queue holding event payloads before final ingestion into Salesforce.</data>
    </node>
    <node id="9">
      <data key="d5">Salesforce</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Salesforce Einstein Analytics reporting engine destination providing business insights.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Expedia applications ingest heterogeneous batch data daily into S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 data routed to EC2 for Parquet and custom transformations.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 data routed to AWS Glue for standard ETL transformations.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 outputs converted CSV data into destination S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Glue writes transformed CSV data into destination S3 bucket.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS Kafka consumer processes streaming events and writes to Aurora.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Aggregated data from Aurora is processed by Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda queues formatted messages into SQS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Messages from SQS are pushed into Salesforce Einstein Analytics.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Expedia Group Integration with Salesforce Einstein Analytics</data>
    <data key="d1">https://www.youtube.com/watch?v=f5EJBUfGZtw</data>
    <data key="d2">Architecture processes 500 to 800 million rows per day via batch processing (top layer) and 5 to 10 million events per day via real-time streaming (bottom layer) to populate Salesforce Einstein Analytics.</data>
    <data key="d3">Batch Processing, Real-Time Streaming, Data Lake &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
