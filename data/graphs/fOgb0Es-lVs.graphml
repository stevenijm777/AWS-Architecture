<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Content Supplier</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Studios providing mezzanine source media assets (~250GB+).</data>
    </node>
    <node id="1">
      <data key="d5">Ingest</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket for initial asset ingestion.</data>
    </node>
    <node id="2">
      <data key="d5">Archive</data>
      <data key="d6">S3</data>
      <data key="d7">S3 Glacier bucket for long-term media asset archiving.</data>
    </node>
    <node id="3">
      <data key="d5">Distribution</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing final transcoded assets ready for distribution.</data>
    </node>
    <node id="4">
      <data key="d5">Events</data>
      <data key="d6">Lambda</data>
      <data key="d7">Event handler publishing events to an AMQ-backed pub/sub event bus.</data>
    </node>
    <node id="5">
      <data key="d5">Processing</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker fleet running ~1,800 Docker containers across AZs performing microservice transcoding/conformance.</data>
    </node>
    <node id="6">
      <data key="d5">Security</data>
      <data key="d6">Organizations</data>
      <data key="d7">Security account abstraction tier enforcing account isolation, KMS rotating key protection, and Virtual File System (VFS) access.</data>
    </node>
    <node id="7">
      <data key="d5">Consumer TV</data>
      <data key="d6">UserConsumerTV</data>
      <data key="d7">End distribution targets such as Amazon Prime Video, iTunes, and OTT TV endpoints.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Content Supplier uploads mezzanine video files into the Ingest S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingested assets are moved into Glacier Archive.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingest operations trigger pipeline events.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Assets are retrieved from Glacier Archive into Processing compute fleet upon distribution order.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Distribution bucket delivers processed media to OTT Consumer TV platforms.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Event bus routes pipeline instructions to the Processing worker fleet.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Transcoded and processed media files are stored in the Distribution S3 bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Deluxe One Media Processing and Distribution Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=fOgb0Es-lVs</data>
    <data key="d2">Deluxe One media workflow handles mezzanine files (~250GB+) ingested from content suppliers, archived to Glacier, processed by containerized microservices fleets (~1,800 containers across AZs), and distributed to OTT endpoints.</data>
    <data key="d3">Media &amp; Entertainment, Content Distribution, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
