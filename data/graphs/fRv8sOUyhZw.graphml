<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IBM DB2</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises legacy source database.</data>
    </node>
    <node id="1">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">AWS Database Migration Service used for batch data extraction and CDC streaming.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket holding initial full dataset export.</data>
    </node>
    <node id="3">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Ephemeral EMR cluster running Spark ETL job for data cleansing and validation.</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Kinesis data stream receiving commit log event changes from DMS.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda 1</data>
      <data key="d6">Lambda</data>
      <data key="d7">Node.js Lambda function consuming CDC events from Kinesis stream.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Primary target key-value database serving microservices.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda 2</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function triggered by DynamoDB Streams to update search indexes.</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Search database powering low-latency search queries.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS extracts full batch data from IBM DB2 database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Commit log change events from IBM DB2 are streamed into Kinesis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS writes raw initial batch files into Amazon S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Ephemeral EMR cluster reads full load batch data from S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Spark job cleanses data and writes initial dataset into DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Spark job writes cleansed search data directly into Elasticsearch.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda 1 subscribes to and processes real-time change events from Kinesis stream.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda 1 transforms and applies real-time data updates into DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB Streams triggers Lambda 2 upon updates in DynamoDB table.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda 2 synchronizes real-time updates to Elasticsearch indexes.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Euler Hermes Database Migration and Real-Time Sync Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=fRv8sOUyhZw</data>
    <data key="d2">Architecture designed for transforming a legacy monolith on IBM DB2 into AWS microservices. Uses AWS DMS for initial batch full dump to S3 and EMR Spark ETL into DynamoDB and Elasticsearch. Real-time updates are streamed via Kinesis and Lambda, and synced to Elasticsearch via DynamoDB Streams.</data>
    <data key="d3">Database Migration, Data Analytics, Serverless Real-Time Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
