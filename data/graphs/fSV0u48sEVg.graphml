<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Generates an average of 60,000 requests per minute (varying between 10,000 and 120,000 req/min).</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Entry point handling HTTP requests and forwarding them to the ECS Fargate application cluster.</data>
    </node>
    <node id="2">
      <data key="d5">ECS Fargate</data>
      <data key="d6">ECS</data>
      <data key="d7">Core containerized application logic running serverless on AWS Fargate, responsible for game logic and user interaction.</data>
    </node>
    <node id="3">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">RDS Postgres database cluster storing persistent user and game data.</data>
    </node>
    <node id="4">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory Redis cache used to reduce database load.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless functions executing infrequent or scheduled maintenance tasks.</data>
    </node>
    <node id="6">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Centralized logging and metrics monitoring service across all backend components.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile client sends incoming game request traffic to the ALB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes user requests to ECS Fargate containers.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS Fargate reads and writes persistent user and game data to RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS Fargate retrieves and caches dynamic data in ElastiCache for Redis.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS Fargate triggers or integrates with Lambda functions for maintenance tasks.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS Fargate pushes container metrics and application logs to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Bi-directional relationship for database caching and cache updates.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda function execution logs and metrics are forwarded to CloudWatch.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Social Quantum Serverless Game Backend Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=fSV0u48sEVg</data>
    <data key="d2">Architecture for Social Quantum's mobile games processing an average of 60,000 requests per minute using AWS serverless services.</data>
    <data key="d3">Game Development, Serverless, Containers, Caching, Relational Database</data>
    <data key="d4">True</data>
  </graph>
