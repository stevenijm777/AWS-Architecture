  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CUSTOMERS</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Customers accessing insurance offerings via homepage or partner websites.</data>
    </node>
    <node id="1">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS running the policy administration backend application.</data>
    </node>
    <node id="2">
      <data key="d5">KINESIS FIREHOSE</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams clickstream data directly from backend into raw storage.</data>
    </node>
    <node id="3">
      <data key="d5">RAW S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing raw un-optimized JSON clickstream data.</data>
    </node>
    <node id="4">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">AWS Glue running incremental serverless ETL jobs to filter and aggregate clicks.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing transformed and optimized data.</data>
    </node>
    <node id="6">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Amazon Athena querying processed data made available via Glue Crawlers.</data>
    </node>
    <node id="7">
      <data key="d5">PROCESS AUTOMATION</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Process Automation engine consuming Athena data to automate insurance workflows and machine learning pricing models.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Customers visit website and generate policy requests on backend EKS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS pushes clickstream data stream into Kinesis Firehose.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Firehose writes raw JSON objects directly into Raw S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue reads raw JSON data from Raw S3 for ETL processing.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue outputs processed/transformed dataset into downstream S3 bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Athena crawlers expose processed data stored in S3 for querying.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Process Automation queries and consumes structured data directly from Athena.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Simpego Clickstream and Data Automation Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=fTxvwVj02P0</data>
    <data key="d2">Simpego's data architecture ingests customer clickstream data from EKS into Kinesis Firehose, stores raw JSON in S3, transforms it via Glue ETL into a secondary S3 bucket, queries it using Athena, and powers process automation and machine learning.</data>
    <data key="d3">Analytics, Data Pipeline, Serverless</data>
    <data key="d4">True</data>
  </graph>
