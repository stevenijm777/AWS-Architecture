<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Sensor</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Physical sensor attached to production machines that detects bolts falling through light grids.</data>
    </node>
    <node id="1">
      <data key="d5">Greengrass</data>
      <data key="d6">Greengrass</data>
      <data key="d7">Edge gateway running local counting engine to transform varying sensor messages.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda Ingestion</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered via AWS IoT Core rules to derive machine states from incoming count messages.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores current real-time machine state data.</data>
    </node>
    <node id="4">
      <data key="d5">Amplify</data>
      <data key="d6">Amplify</data>
      <data key="d7">Hosts and powers smartphone and tablet application for shop floor operators.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Provides API endpoints for the shop floor application.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda API</data>
      <data key="d6">Lambda</data>
      <data key="d7">Queries DynamoDB state for the user application and processes reported batch/container completion events.</data>
    </node>
    <node id="7">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues reported container events before sending batch updates to the external ERP system.</data>
    </node>
    <node id="8">
      <data key="d5">ERP</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External ERP system receiving batch production reports.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Sensor sends pulses to AWS Greengrass edge gateway upon bolt detection.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Greengrass sends local count messages via AWS IoT Core rules to trigger Lambda Ingestion.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda Ingestion writes updated machine state into DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Amplify mobile app calls API Gateway endpoints to fetch state and submit reports.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway forwards application requests to Lambda API.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda API reads state data from DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda API sends completed container events to SQS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS delivers queued report updates to external ERP system.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Maxinear Real-time Piece Counting Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=fbzeoxxyzIw</data>
    <data key="d2">Architecture for real-time piece counting on manufacturing shop floor using AWS IoT Greengrass, Lambda, DynamoDB, Amplify, API Gateway, SQS, and ERP integration.</data>
    <data key="d3">IoT, Manufacturing, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
