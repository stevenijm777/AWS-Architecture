<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developer commits code and application manifest file into Git/CI-CD version control.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores persisted manifest files for auditing and record keeping.</data>
    </node>
    <node id="2">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives manifest upload event and fans out notifications across all target deployment regions.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Regional Lambda functions transform S3 manifest into dynamic CloudFormation templates and enqueue tasks.</data>
    </node>
    <node id="4">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Dynamically provisions required roles, permissions, and regional infrastructure resources.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers deployment tasks to provide fault tolerance and retry capabilities.</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs the deployed application workloads inside Kubernetes clusters across regions.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer commits manifest file into S3 via CI/CD pipeline.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 object creation triggers SNS notification.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS fans out event to regional Lambda subscriber functions.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda transforms manifest into dynamic CloudFormation templates to provision regional resources.</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda queues downstream deployment activities into SQS.</data>
      <data key="d10">3''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">SQS queues deployment actions into target EKS cluster.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Instructure Global Multi-Region Application Deployment Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=fppIOuRMI2g</data>
    <data key="d2">Architecture illustrating Instructure's automated global deployment pipeline using AWS services for multi-region consistency, retryability, and dynamic provisioning.</data>
    <data key="d3">DevOps / Deployment</data>
    <data key="d4">True</data>
  </graph>
