  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CI/CD Pipeline</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Automated pipeline triggered by developer code commits.</data>
    </node>
    <node id="1">
      <data key="d5">AWS Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Provides a secure abstraction fronting CloudFormation to provision platform infrastructure.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores application Docker container images built by the CI/CD pipeline.</data>
    </node>
    <node id="3">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Routes inbound HTTPS traffic to the application tasks.</data>
    </node>
    <node id="4">
      <data key="d5">ECS Task</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs containerized application code alongside sidecars for reverse proxy SSL termination and authentication.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Certificate Manager</data>
      <data key="d6">ACM</data>
      <data key="d7">Manages SSL/TLS certificates for encrypted communications.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CI/CD pipeline builds and pushes container images to ECR.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CI/CD invokes Service Catalog to deploy the application stack.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Service Catalog creates ACM SSL certificates.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Service Catalog creates listener rules on the ALB.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Service Catalog launches task definitions and services on ECS.</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">AQR AWS PaaS Container Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=ftIdBG-UgFY</data>
    <data key="d2">The architecture abstracts CloudFormation stack management behind AWS Service Catalog to secure deployment permissions for CI/CD systems.</data>
    <data key="d3">Container Infrastructure, Automated Deployment, Application Security</data>
    <data key="d4">True</data>
  </graph>
