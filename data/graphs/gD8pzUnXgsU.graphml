<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Old Systems</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Legacy on-premises SAP ECC and BPC systems being replaced.</data>
    </node>
    <node id="1">
      <data key="d5">Source / ETL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises policy, claim, and reinsurance source systems feeding data via ETL.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Primary</data>
      <data key="d6">S3</data>
      <data key="d7">Primary Amazon S3 staging bucket for ingested scheduled data.</data>
    </node>
    <node id="3">
      <data key="d5">S3 DR</data>
      <data key="d6">S3</data>
      <data key="d7">Secondary S3 bucket in DR region receiving cross-region replication of snapshots and backups.</data>
    </node>
    <node id="4">
      <data key="d5">App Servers Primary</data>
      <data key="d6">EC2</data>
      <data key="d7">Primary SAP application server running on EC2.</data>
    </node>
    <node id="5">
      <data key="d5">HANA Primary</data>
      <data key="d6">SAP</data>
      <data key="d7">Primary S/4 HANA database running on EC2 X1.32xlarge instance, reducing currency translation runtime from 10 hours to under 1 hour.</data>
    </node>
    <node id="6">
      <data key="d5">App Servers Secondary</data>
      <data key="d6">EC2</data>
      <data key="d7">Secondary SAP application server for high availability failover.</data>
    </node>
    <node id="7">
      <data key="d5">HANA Secondary</data>
      <data key="d6">SAP</data>
      <data key="d7">Secondary S/4 HANA database server participating in HANA system replication.</data>
    </node>
    <node id="8">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Automates SAP landscape infrastructure deployment in under an hour via Bamboo pipeline.</data>
    </node>
    <node id="9">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors infrastructure and defines operational event thresholds.</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Source systems ingest policy, claim, and reinsurance data via ETL into S3 Primary.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Staged data loaded from S3 Primary into the primary SAP application server landscape.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Cross-region replication of S3 backups and snapshots from primary to DR S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">HANA system replication between primary and secondary database servers for high availability.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Liberty Mutual Insurance - SAP on AWS for Real-Time Closing</data>
    <data key="d1">https://www.youtube.com/watch?v=gD8pzUnXgsU</data>
    <data key="d2">Architecture showing Liberty Mutual's SAP S/4 HANA migration to AWS using EC2 X1.32xlarge instances, cross-region S3 replication for DR, and HANA system replication for high availability.</data>
    <data key="d3">Migration, Financial Systems, High Availability, Disaster Recovery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
