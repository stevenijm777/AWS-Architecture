<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">F1 Car</data>
      <data key="d6">UserCompanyEdge</data>
      <data key="d7">Collects telemetry and timing transponder data directly from the race car on track.</data>
    </node>
    <node id="1">
      <data key="d5">Biggin Hill Data Center</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">F1 data center located in Biggin Hill receiving incoming track telemetry.</data>
    </node>
    <node id="2">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Extracts and routes incoming telemetry data into the AWS cloud machine learning pipeline.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes and synchronizes timing transponder timestamps with car telemetry.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores synchronized real-time timing data.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores application data used for ML training and model evaluation.</data>
    </node>
    <node id="6">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains and deploys ML models (on-track and pit lane models) for real-time pit strategy predictions.</data>
    </node>
    <node id="7">
      <data key="d5">Broadcast Center</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Receives ML insight graphics and race strategy predictions at the track.</data>
    </node>
    <node id="8">
      <data key="d5">F1 Broadcast Feed</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Pushes race insight graphics onto the live TV broadcast feed.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Car telemetry and timing transponder data sent to Biggin Hill.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Data extracted from Biggin Hill into AWS API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Lambda execution.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes synchronized timing data into DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda stores processed application data into S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Real-time synchronized timing data supplied from DynamoDB to SageMaker.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Application data from S3 fed into SageMaker for model inference and training.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker sends real-time strategy predictions to the Broadcast Center.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Broadcast Center pushes insights onto the live F1 Broadcast Feed.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Formula 1 Pit Strategy Battle Insights Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=gYXqv1UxW3Y</data>
    <data key="d2">Formula 1 processes telemetry and timing data on AWS using Lambda, DynamoDB, S3, and SageMaker machine learning models to generate real-time race strategy insights for live broadcast feeds.</data>
    <data key="d3">AWS, Machine Learning, Sports Broadcast</data>
    <data key="d4">True</data>
  </graph>
</graphml>
