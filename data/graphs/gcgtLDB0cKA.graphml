<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Port Sensors</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">External sensors collecting environmental data such as wind, wave, and tide.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Managed Streaming for Apache Kafka</data>
      <data key="d6">MSK</data>
      <data key="d7">Ingests environmental sensor messages streaming from port sensors.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda function (Ingestion)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes sensor data from MSK via event source mapping.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB Table</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Hot storage location with a 3-month Time-To-Live (TTL).</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB Stream</data>
      <data key="d6">DynamoDBStream</data>
      <data key="d7">Captures change events from the DynamoDB table.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Converts change events to Parquet format and delivers to historical S3 storage.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon S3 Bucket (Historical)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores historical sensor data long term in Parquet format.</data>
    </node>
    <node id="7">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">External users and platforms requesting data.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for query requests from users and platforms.</data>
    </node>
    <node id="9">
      <data key="d5">AWS Lambda function (Query)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Routes query requests dynamically based on requested data age and volume.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Executes SQL queries against historical data stored in the S3 bucket.</data>
    </node>
    <node id="11">
      <data key="d5">Amazon Elastic Container Service (Amazon ECS)</data>
      <data key="d6">ECS</data>
      <data key="d7">Containerized prediction service forecasting up to two weeks of data.</data>
    </node>
    <node id="12">
      <data key="d5">Amazon S3 Bucket (Predictions)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores predictions generated by the ECS prediction service.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Port sensors stream environmental readings into Amazon MSK.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">MSK triggers ingestion Lambda function via event source mapping.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion Lambda function writes processed messages into DynamoDB hot storage.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB streams table changes to DynamoDB Stream.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB Stream forwards change log events to Kinesis Data Firehose.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose transforms and writes historical data into S3 in Parquet format.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Users send requests to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes query Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Query Lambda fetches recent/hot data from DynamoDB.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Query Lambda invokes Athena for historical data queries.</data>
      <data key="d10">2''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Athena queries historical files in S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS prediction service writes forecasted data to S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">OMC International DUKC Platform Serverless Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=gcgtLDB0cKA</data>
    <data key="d2">Achieved 30x increase in processing speed/scale and 10-15% cost savings using serverless architecture with DynamoDB TTL (3 months) and S3 Parquet historical archiving.</data>
    <data key="d3">Serverless, Streaming, Analytics, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
