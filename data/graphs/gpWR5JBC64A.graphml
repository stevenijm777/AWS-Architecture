<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">RESTAURANT</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">EPOS machine situated at restaurant locations used to process and sync orders across kitchen workstations.</data>
    </node>
    <node id="1">
      <data key="d5">AMPLIFY</data>
      <data key="d6">Amplify</data>
      <data key="d7">Amplify SDK built into EPOS devices for handling order synchronization.</data>
    </node>
    <node id="2">
      <data key="d5">APPSYNC</data>
      <data key="d6">AppSync</data>
      <data key="d7">AWS AppSync manages real-time data synchronization across all restaurant EPOS devices.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda resolvers execute logic for order syncing, notifications, and dashboarding.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Fully managed NoSQL database storing order state and accommodating rapid weekend traffic spikes.</data>
    </node>
    <node id="5">
      <data key="d5">KINESIS</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Receives change data captured via DynamoDB Streams for real-time analytics streaming.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake storing order records for ETL processing and historical analysis.</data>
    </node>
    <node id="7">
      <data key="d5">QUICKSIGHT</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Business intelligence dashboarding tool for restaurant owners and back-office teams.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Restaurant EPOS machines use embedded Amplify SDK to send order data.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Amplify SDK communicates order sync requests to AWS AppSync.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">AppSync triggers Lambda resolvers to handle business logic.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes order state into DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB Streams outputs order events into Kinesis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis streams data directly into S3 data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">QuickSight queries S3 data lake to generate real-time analytics dashboards.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Foodhub Real-time Order Processing and Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=gpWR5JBC64A</data>
    <data key="d2">Foodhub processes millions of restaurant orders using a serverless backend with AppSync and Lambda, streaming DynamoDB updates via Kinesis to S3 and QuickSight for real-time operational insights.</data>
    <data key="d3">Data Processing, Serverless, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
