<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS transactional database storing raw application and operational data.</data>
    </node>
    <node id="1">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">AWS Glue running PySpark jobs to anonymize, synthesize, and transform raw data from RDS, BigQuery, and Kinesis streams.</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function invoked during processing jobs to fetch custom container images with pre-installed libraries from ECR.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 data lake housing domain-specific data marts, kept ACID compliant using Apache Hudi.</data>
    </node>
    <node id="4">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">AWS IAM enforcing workspace isolation through separate execution roles for different data science user groups (DS1, DS2).</data>
    </node>
    <node id="5">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Amazon SageMaker Studio and Processing Jobs running within a controlled private VPC to execute notebook workloads on demand.</data>
    </node>
    <node id="6">
      <data key="d5">DS</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Data Scientist preparing Jupyter notebooks (IPYNB) and specifying job parameters for processing.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS data is funneled into AWS Glue PySpark jobs for ETL transformation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Glue writes transformed, anonymized data into S3 domain-specific data marts.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker processing job triggers Lambda function to fetch custom execution container image.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker uses specific IAM execution roles (DS1, DS2) to enforce data access governance and workspace isolation.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Outputs and generated scores from SageMaker processing jobs are dumped into S3 data lake.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Data Scientist logs into SageMaker Studio and submits Jupyter notebooks (IPYNB) for processing jobs.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">FPL Technologies Serverless ML Workbench Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=gu54VVeDD10</data>
    <data key="d2">FPL Technologies built an on-demand, serverless ML workbench on AWS using SageMaker Studio, Lambda, Glue, and S3. IAM roles enforce user group workspace isolation while Glue PySpark jobs hydrate an S3 data lake kept ACID compliant via Apache Hudi.</data>
    <data key="d3">Machine Learning, Serverless, Data Lake, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
