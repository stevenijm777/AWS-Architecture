<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SOURCE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises legacy data sources including AS400, flat files, and enterprise databases.</data>
    </node>
    <node id="1">
      <data key="d5">DX</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">AWS Direct Connect provides a private, dedicated network link from on-premises to AWS.</data>
    </node>
    <node id="2">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">AWS Database Migration Service ingests real-time data feeds from legacy systems into AWS.</data>
    </node>
    <node id="3">
      <data key="d5">DDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Primary real-time staging store organized into Raw, L1 (user persona), and L2 (behavioral) data layers.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Around 550 Lambda functions process and transform data between Raw, L1, and L2 layers triggered by DynamoDB Streams.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing raw layer data and serving as the data repository for recovery operations.</data>
    </node>
    <node id="6">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Amazon Athena executes serverless queries to rebuild data layers in S3 during error recovery.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises source data sent across Direct Connect to AWS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Direct Connect delivers data feeds into AWS DMS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS streams incoming data into DynamoDB Raw layer.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS streams raw feed concurrently into Amazon S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB Streams triggers Lambda functions on new record inserts/updates.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Error recovery request initiated to rebuild corrupted or changed layers via Athena.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda functions write enriched L1 and L2 layer data back into DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Rebuilt layer data from S3 is re-ingested back into DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries raw data and rebuilds layer data inside S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">HDFC Life Real-Time Event-Driven Data Lake Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=h0HE3bOEiMk</data>
    <data key="d2">HDFC Life migrated from a delayed batch-based data lake to a real-time event-driven data lake leveraging DynamoDB streams, Lambda, S3, and Athena for lower cost and serverless error recovery.</data>
    <data key="d3">Data Lake, Event-Driven, Real-Time Ingestion</data>
    <data key="d4">True</data>
  </graph>
</graphml>
