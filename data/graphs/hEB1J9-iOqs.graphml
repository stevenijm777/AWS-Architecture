<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point receiving deployment descriptor JSON requests via curl or web interface.</data>
    </node>
    <node id="1">
      <data key="d5">Factory Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Parses the deployment descriptor JSON and constructs the dynamic CodePipeline on the fly.</data>
    </node>
    <node id="2">
      <data key="d5">Master CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Master orchestration pipeline generated by the factory lambda to run deployment steps.</data>
    </node>
    <node id="3">
      <data key="d5">ServiceNow</data>
      <data key="d6">ServiceNow</data>
      <data key="d7">Integrates change management approval verification for production environments.</data>
    </node>
    <node id="4">
      <data key="d5">Notification Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes pipeline completion or failure status and prepares notification messages.</data>
    </node>
    <node id="5">
      <data key="d5">Email Notification</data>
      <data key="d6">SES</data>
      <data key="d7">Sends email updates with deployment outcomes or error details to developers.</data>
    </node>
    <node id="6">
      <data key="d5">Sub CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Sub-pipeline invoked for team-customized build/test actions.</data>
    </node>
    <node id="7">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Executes infrastructure-as-code template deployment tasks.</data>
    </node>
    <node id="8">
      <data key="d5">CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Compiles and packages application code pay-as-you-go.</data>
    </node>
    <node id="9">
      <data key="d5">CodeDeploy</data>
      <data key="d6">CodeDeploy</data>
      <data key="d7">Deploys application artifacts to target instances, Beanstalk, or on-premise servers.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Submits deployment descriptor JSON payload to the Factory Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Factory Lambda dynamically provisions and configures Master CodePipeline.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Master CodePipeline checks approval ticket status in ServiceNow.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers Notification Lambda upon pipeline state change or completion.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Master CodePipeline invokes custom Sub CodePipeline task.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Master CodePipeline triggers CloudFormation provisioning task.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Master CodePipeline triggers CodeBuild compilation/package task.</data>
      <data key="d10">0''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Master CodePipeline triggers CodeDeploy deployment task.</data>
      <data key="d10">0'''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Notification Lambda triggers email delivery via SES.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Bristol Myers Squibb AutoPTP DevOps Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=hEB1J9-iOqs</data>
    <data key="d2">AutoPTP dynamic CodePipeline factory model for automated deployment management at scale.</data>
    <data key="d3">DevOps, Automation, CI/CD</data>
    <data key="d4">True</data>
  </graph>
</graphml>
