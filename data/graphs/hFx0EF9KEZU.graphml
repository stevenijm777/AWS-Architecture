  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Devices</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Incoming traffic from mobile SDKs, web browsers, and server-to-server integrations</data>
    </node>
    <node id="1">
      <data key="d5">Input EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Microservices cluster running backend APIs that emit activity logs</data>
    </node>
    <node id="2">
      <data key="d5">Fluentd</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Fluent Bit/Fluentd log collector daemon forwarding container logs</data>
    </node>
    <node id="3">
      <data key="d5">Input DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores user attribute data</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Data Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Captures user attribute updates via DynamoDB Streams and streams them via Firehose to S3</data>
    </node>
    <node id="5">
      <data key="d5">Filter Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Batch processes raw log files to filter out unwanted request logs, reducing CPU load on log forwarders</data>
    </node>
    <node id="6">
      <data key="d5">Raw S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw unfiltered logs and user attribute updates</data>
    </node>
    <node id="7">
      <data key="d5">ETL Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Enriches raw logs with internal ID mapping metadata</data>
    </node>
    <node id="8">
      <data key="d5">Gold S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores curated, enriched gold user dataset ready for segmentation queries</data>
    </node>
    <node id="9">
      <data key="d5">Admin</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Admin system where advertisers define targeting conditions and segment rules</data>
    </node>
    <node id="10">
      <data key="d5">Ad Server</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Serves ad recommendations requiring low-latency (100-200ms) segment targeting lookups</data>
    </node>
    <node id="11">
      <data key="d5">Segment RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores segment metadata, conditions, and catalog rules</data>
    </node>
    <node id="12">
      <data key="d5">Evaluation EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs periodic evaluation jobs that construct and submit Athena segment queries</data>
    </node>
    <node id="13">
      <data key="d5">Segment DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores evaluated user segment membership data for fast ad server lookup</data>
    </node>
    <node id="14">
      <data key="d5">Query Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Executes segment evaluation queries against the Gold S3 dataset</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User events and requests sent to microservices on EKS</data>
