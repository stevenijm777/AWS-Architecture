  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">TWD / CNN Center</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises Techwood / CNN Center facility in Atlanta where master files are QC'd and local switching/compression occurs.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">AWS S3 bucket storing master files for all brands.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 Top</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance running Evertz ORT software in AZ 1 handling 10 channels.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Middle</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance running Evertz ORT software in AZ 2 handling 10 channels.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 Bottom</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance running Evertz ORT software in AZ 3 handling 10 channels.</data>
    </node>
    <node id="5">
      <data key="d5">Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">AWS Direct Connect transporting unicast playout signals back to on-premises facilities via Evertz CloudBridge.</data>
    </node>
    <node id="6">
      <data key="d5">NYC</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises Hudson Yards / NYC satellite dish uplink facility for BCP solution.</data>
    </node>
    <node id="7">
      <data key="d5">ATL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises Atlanta satellite dish uplink facility for distribution to affiliates.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Master files QC'd in Atlanta are transferred via Aspera up to S3 for storage.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Techwood / CNN Center compresses and sends playout signal to Atlanta satellite dish uplink for affiliate distribution.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Master files are transferred from S3 to EC2 running Evertz ORT software in AZ 1.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Master files are transferred from S3 to EC2 running Evertz ORT software in AZ 2.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Master files are transferred from S3 to EC2 running Evertz ORT software in AZ 3.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Unicast playout signal sent from EC2 in AZ 1 via Evertz CloudBridge to Direct Connect.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Unicast playout signal sent from EC2 in AZ 2 via Evertz CloudBridge to Direct Connect.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Unicast playout signal sent from EC2 in AZ 3 via Evertz CloudBridge to Direct Connect.</data>
      <data key="d10">1''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Direct Connect feeds BCP unicast playout signal directly to NYC satellite dish uplink.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Direct Connect sends X-chain unicast playout signal to Techwood / CNN Center.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">WarnerMedia HBO Cloud Linear Playout Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=hMK2NJ-q9nc</data>
    <data key="d2">Architecture showing WarnerMedia HBO's cloud linear playout system supporting 30 channels across three Availability Zones in AWS US East 1, feeding back to on-premises satellite uplinks via AWS Direct Connect.</data>
    <data key="d3">Media &amp; Entertainment, Hybrid Cloud, Migration</data>
    <data key="d4">True</data>
  </graph>
