<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CI/CD / Laptop</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Developer workstation or CI/CD runner executing tests using Jest and Puppeteer libraries.</data>
    </node>
    <node id="1">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Authenticates developer identity using Google sign-in integration.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores compressed execution bundle files identified by unique IDs (e.g., 'xyz').</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes ~700 parallel headless browser tests per build using custom Chromium and Jest layers.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores reporting and execution history for performance optimization.</data>
    </node>
    <node id="5">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors test infrastructure health, uptime, and runtime logs.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Authenticates developer session prior to triggering tests.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Uploads execution bundle (xyz) containing test code and dependencies.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers ~700 parallel Lambda instances passing the bundle ID.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda downloads the test bundle (xyz) from S3.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda returns test outcome JSON payload back to local runner/CI.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Reports test summary and infrastructure execution metrics.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Sends performance logs and system health metrics to CloudWatch.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Wix SLED Parallel End-to-End Testing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=hbz63Ve-eIY</data>
    <data key="d2">SLED is Wix's end-to-end testing framework executing around 1.2 million browser-based test runs per week using Lambda, S3, Cognito, DynamoDB, and CloudWatch.</data>
    <data key="d3">Testing Framework, Serverless Compute, Continuous Integration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
