<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amplify</data>
      <data key="d6">Amplify</data>
      <data key="d7">Deploys the Restaurant Control Center (RCC) React web application used to update store hours.</data>
    </node>
    <node id="1">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Powers 'Diablo' (Data Integration and Automation Batch Lambda Orchestration) using reusable Python step types to load product master, pricing, and tax data.</data>
    </node>
    <node id="2">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Aurora MySQL database serving as the central middleware store containing restaurant hours, product data, and 100+ million pricing/tax combinations.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda (Exporter)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Generates 40,000 custom JSON menus totaling 100GB of data for delivery aggregator platforms.</data>
    </node>
    <node id="4">
      <data key="d5">DELIVERY AGGREGATOR</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External delivery partner platforms receiving generated menus and returning completion status webhooks.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives completion webhooks from external delivery aggregator platforms.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda (Webhook)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes completion webhooks to log execution status into Aurora audit tables.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Amplify app writes updated store hours into Aurora database tables.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions orchestrates batch loading of product, pricing, and tax data into Aurora.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Menu Exporter Lambda reads restaurant hours, products, and pricing data from Aurora.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Exporter Lambda pushes generated JSON menu files to Delivery Aggregators.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Delivery Aggregators send processing status webhooks to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">API Gateway triggers the Webhook Lambda to process incoming delivery notifications.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">3</data>
      <data key="d9">Webhook Lambda records processing status and audit logs in Aurora.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Taco Bell Menu Middleware and Data Integration Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=hf9nMAG9XoU</data>
    <data key="d2">Architecture for Taco Bell's menu middleware, serving over 7,000 restaurants and generating roughly 40,000 menus (100GB of JSON menu payload) sent to delivery aggregators.</data>
    <data key="d3">Application Integration, Databases, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
