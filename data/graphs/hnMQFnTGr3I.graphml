<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CAMERA</data>
      <data key="d6">UserConsumerCamera</data>
      <data key="d7">Smart baby monitor camera generating video segments and live video streams.</data>
    </node>
    <node id="1">
      <data key="d5">MOBILE</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile app used by parents to view insights and watch live or playback video streams.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores short video segments uploaded directly from cameras via pre-signed URLs.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 object upload notifications to push S3 keys to SQS FIFO.</data>
    </node>
    <node id="4">
      <data key="d5">SQS FIFO</data>
      <data key="d6">SQS</data>
      <data key="d7">FIFO queue buffering video segment keys for analysis.</data>
    </node>
    <node id="5">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Queried by cameras to obtain public node IP addresses for EKS cluster streaming.</data>
    </node>
    <node id="6">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing camera and mobile traffic to control plane.</data>
    </node>
    <node id="7">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Container cluster hosting Video Analysis, Video Streaming, and Control Plane services.</data>
    </node>
    <node id="8">
      <data key="d5">VIDEO ANALYSIS</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS microservice running computer vision algorithms on GPU nodes to produce sleep insights.</data>
    </node>
    <node id="9">
      <data key="d5">VIDEO STREAMING</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS microservice processing incoming live streams relayed from cameras.</data>
    </node>
    <node id="10">
      <data key="d5">CONTROL PLANE</data>
      <data key="d6">EKS</data>
      <data key="d7">Control plane service managing camera registration, S3 presigned URLs, and mobile requests.</data>
    </node>
    <node id="11">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">RDS database cluster storing camera state and generated sleep insights.</data>
    </node>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Camera registers with system through Application Load Balancer.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Camera uploads recorded video segment directly to S3 using presigned URL.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Camera queries Route 53 to resolve public IP address for streaming node in EKS.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="0" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Camera streams live video directly to Video Streaming microservice in EKS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Camera streams live video directly to Mobile app when on the same Wi-Fi network.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Mobile app sends request via ALB to Control Plane to view insights or pull live stream.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 object creation notification triggers Lambda function.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda function enqueues video object key into SQS FIFO queue.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Video Analysis microservice receives event messages from SQS FIFO and downloads video.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards registration request to Control Plane service inside EKS.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="11" id="0">
      <data key="d8">0</data>
      <data key="d9">Video Analysis microservice saves computed sleep insights into RDS database.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">0</data>
      <data key="d9">Control Plane saves camera state in RDS database cluster.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Nanit Video Ingestion and Live Streaming Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=hnMQFnTGr3I</data>
    <data key="d2">Nanit architecture for smart baby video streaming and GPU-accelerated sleep insight video analysis.</data>
    <data key="d3">Video Streaming, IoT, Microservices, AI/ML</data>
    <data key="d4">True</data>
  </graph>
</graphml>
