<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Client web browser initiating 3D streaming session.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">REST API Gateway entry point receiving project and session details.</data>
    </node>
    <node id="2">
      <data key="d5">Routing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Evaluates user latency, region, system load, and project specifications.</data>
    </node>
    <node id="3">
      <data key="d5">Virtual Connection Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles websocket connection details with regional Fargate clusters.</data>
    </node>
    <node id="4">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Regional brain/control plane orchestrating workload launches.</data>
    </node>
    <node id="5">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory registry storing active/available EC2 instance capacity.</data>
    </node>
    <node id="6">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts Service Manager, Game engine process, and WebRTC Streaming Agent.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores 3D game binaries, models, and launch assets.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User sends launch request to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway invokes Routing Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Routing Lambda forwards regional decision to Virtual Connection Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Virtual Connection Lambda communicates launch request to Fargate via WebSockets.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate checks ElastiCache to find available EC2 capacity.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate dispatches launch instructions to selected EC2 instance.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Service Manager registers host availability in ElastiCache on startup.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Service Manager fetches game binaries from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">Streaming Agent establishes direct WebRTC connection with User Browser.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">PureWeb Interactive 3D Streaming Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=hrhBOOrR5v0</data>
    <data key="d2">Architecture demonstrates regional control planes routing users to EC2-based streaming agents via WebRTC.</data>
    <data key="d3">Compute, Networking, Gaming, WebRTC</data>
    <data key="d4">True</data>
  </graph>
</graphml>
