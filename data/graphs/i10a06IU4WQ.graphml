<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal user or service account authenticating to big data clusters.</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances hosting data engineering services like Hadoop, Spark, and Presto with custom credential provider.</data>
    </node>
    <node id="2">
      <data key="d5">TOKEN VENDING</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Pinterest Token Vending Service that bridges internal LDAP groups with AWS IAM session policies.</data>
    </node>
    <node id="3">
      <data key="d5">STS</data>
      <data key="d6">STS</data>
      <data key="d7">AWS Security Token Service used to generate scoped temporary access credentials via AssumeRole.</data>
    </node>
    <node id="4">
      <data key="d5">MP1</data>
      <data key="d6">IAM</data>
      <data key="d7">Managed Policy 1 defining session permissions for the first dataset.</data>
    </node>
    <node id="5">
      <data key="d5">MP2</data>
      <data key="d6">IAM</data>
      <data key="d7">Managed Policy 2 defining session permissions for the second dataset.</data>
    </node>
    <node id="6">
      <data key="d5">S3 (Top)</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing dataset 1.</data>
    </node>
    <node id="7">
      <data key="d5">S3 (Bottom)</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing dataset 2.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User authenticates to EC2 Hadoop cluster using Kerberos.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 credentials provider requests scoped tokens from Token Vending Service.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 uses STS temporary credentials constrained by Managed Policy 2.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Token Vending calls AssumeRole on STS passing base IAM role and managed policies.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Token Vending maps user LDAP groups to Managed Policy 1.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Token Vending maps user LDAP groups to Managed Policy 2.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Base IAM role permissions intersect with Managed Policy 1.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Managed Policy 1 permits access to the top S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Managed Policy 2 permits access to the bottom S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Pinterest Dynamic S3 Data Access via STS Token Vending</data>
    <data key="d1">https://www.youtube.com/watch?v=i10a06IU4WQ</data>
    <data key="d2">Pinterest architecture using a custom Token Vending Service on EC2 with AWS STS and IAM Managed Policies to dynamically control access to S3 buckets based on internal LDAP groups.</data>
    <data key="d3">Security, Big Data, Access Control</data>
    <data key="d4">True</data>
  </graph>
</graphml>
