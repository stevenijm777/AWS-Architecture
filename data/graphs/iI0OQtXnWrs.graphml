<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Students and instructors uploading academic papers directly or via integrations.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Simple Notification Service (Amazon SNS)</data>
      <data key="d6">SNS</data>
      <data key="d7">SNS topic triggered when a paper is uploaded and ready for processing.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Simple Queue Service (Amazon SQS)</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS queue buffering up to 2 million incoming paper messages per day.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda (Orchestrator)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Java-based orchestrator and rules engine determining paper processing eligibility.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Lambda (Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Python-based processing Lambda breaking down prose text into sentence sliding windows.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker endpoint running on EC2 for high-concurrency generative AI inference.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores document and sentence-level AI evaluation scores.</data>
    </node>
    <node id="7">
      <data key="d5">MFE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Micro Front End web component embedded into existing user-facing applications.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User uploads paper to platform, triggering an SNS notification topic.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS pushes paper upload event to the SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestrator Lambda polls SQS queue and applies filtering rules.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestrator Lambda invokes Processing Lambda for sentence segmentation.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestrator Lambda persists sentence and paper score records into DynamoDB.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Processing Lambda sends sentence sliding windows in parallel to SageMaker endpoint.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Processing Lambda returns aggregated document and sentence scores to Orchestrator Lambda.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker returns AI sentence inference results back to Processing Lambda.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB returns paper analysis records to Orchestrator Lambda to display in MFE.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Micro Front End component queries Orchestrator Lambda to retrieve paper score details.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Turnitin Generative AI Academic Integrity Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=iI0OQtXnWrs</data>
    <data key="d2">Turnitin processes up to 2 million papers per day using an event-driven architecture with AWS Lambda, SageMaker on EC2, and DynamoDB across three AWS regions (US, Europe, Asia Pacific).</data>
    <data key="d3">Generative AI, Event-Driven</data>
    <data key="d4">True</data>
  </graph>
</graphml>
