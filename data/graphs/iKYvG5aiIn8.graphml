<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SQL Server</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises/external transactional SQL Server databases generating inserts, updates, and deletes.</data>
    </node>
    <node id="1">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">AWS Database Migration Service capturing CDC changes from SQL Server.</data>
    </node>
    <node id="2">
      <data key="d5">S3 (LANDING)</data>
      <data key="d6">S3</data>
      <data key="d7">Landing S3 bucket storing raw transactional change data in Parquet format.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Amazon SQS queues capturing S3 event notifications categorized by target processing latency.</data>
    </node>
    <node id="4">
      <data key="d5">EVENTBRIDGE</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Amazon EventBridge scheduled rules (10-min, 60-min, 3-hour) triggering orchestration.</data>
    </node>
    <node id="5">
      <data key="d5">STEP FUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">AWS Step Functions orchestrating the execution workflow of Glue ETL jobs.</data>
    </node>
    <node id="6">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Serverless AWS Glue ETL jobs reading event messages from SQS and executing updates.</data>
    </node>
    <node id="7">
      <data key="d5">S3 (DELTA LAKE)</data>
      <data key="d6">S3</data>
      <data key="d7">Delta Lake storage on S3 organized in bronze, silver, and gold tiers for querying and ML feature store.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS replicates transactional database changes from SQL Server.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS writes inserts, updates, and deletes as Parquet files into the landing S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Landing S3 bucket triggers event notifications sent to SQS queues.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue extractor job reads landing S3 location paths from SQS queue messages.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EventBridge scheduled rules trigger Step Functions state machine execution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions orchestrates Glue ETL workflow jobs.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue performs upserts to keep Delta Lake tables updated in S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">TrueBlue Near-Real-Time Delta Lakehouse Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=iKYvG5aiIn8</data>
    <data key="d2">Architecture demonstrating continuous CDC database migration from SQL Server to an S3 Delta Lake using AWS DMS, SQS, EventBridge, Step Functions, and AWS Glue.</data>
    <data key="d3">Data Lakehouse ETL</data>
    <data key="d4">True</data>
  </graph>
</graphml>
