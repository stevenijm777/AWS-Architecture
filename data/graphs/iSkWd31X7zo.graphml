<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Sports Equipment</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Smart sports balls equipped with embedded sensors, accelerometers, and magnetometers.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingests real-time geometry and movement telemetry data from sports equipment.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams data to S3 for persistent storage and batch analysis.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake repository used for historical data mining and future ML model training.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda Model Infer</data>
      <data key="d6">Lambda</data>
      <data key="d7">Runs embedded ML inference model to segment telemetry data and calculate metrics such as ball speed and strike force.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Low-latency storage for processed inference results.</data>
    </node>
    <node id="6">
      <data key="d5">AppSync</data>
      <data key="d6">AppSync</data>
      <data key="d7">Managed GraphQL API serving real-time event updates over WebSockets/MQTT.</data>
    </node>
    <node id="7">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Provides user registration and authentication for fans and players.</data>
    </node>
    <node id="8">
      <data key="d5">Fan / Broadcaster</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End-user companion apps and broadcaster systems subscribing to real-time game telemetry.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Streams raw telemetry data from embedded ball sensors to Kinesis Stream.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes stream data to Kinesis Firehose for archiving.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Forwards real-time stream data to Lambda for model inference.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Persists streaming telemetry into the S3 data lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes processed ML inference insights to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">AppSync reads calculated telemetry metrics from DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Pushes real-time GraphQL subscriptions and notifications to fan and broadcaster client apps.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">TechConnect - Real-Time Sports Telemetry &amp; Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=iSkWd31X7zo</data>
    <data key="d2">Architecture streams real-time sensor telemetry from smart sports equipment (cricket/rugby balls) for real-time model inference and companion app analytics.</data>
    <data key="d3">IoT, Analytics, ML</data>
    <data key="d4">True</data>
  </graph>
</graphml>
