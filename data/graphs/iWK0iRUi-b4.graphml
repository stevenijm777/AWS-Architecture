<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CodePipeline (Customer)</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Customer's CodePipeline instance where developers define build pipelines.</data>
    </node>
    <node id="1">
      <data key="d5">S3 Objects</data>
      <data key="d6">S3</data>
      <data key="d7">Stores source code manifest and package dependency artifacts for scanning.</data>
    </node>
    <node id="2">
      <data key="d5">CodePipeline (AWS)</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">AWS CodePipeline service executing build runs and Snyk action integrations.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Snyk API Gateway endpoint for customer setup and authentication.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores customer account metadata and pipeline association configuration.</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates scanning workflow logic across package manifests.</data>
    </node>
    <node id="6">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Captures event state during pipeline build execution.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Snyk entrypoint function invoked during pipeline execution.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer pipeline execution initiates AWS CodePipeline run.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Pipeline creates a copy of source code artifacts in the customer S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CodePipeline directs setup requests to Snyk API Gateway endpoint.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Pipeline execution directly triggers Snyk entrypoint Lambda function.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway processes metadata and persists customer configuration into DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions return vulnerability assessment report to CodePipeline.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EventBridge triggers Step Functions workflow to process security checks.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda function writes pipeline state information into EventBridge.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Snyk Security Integration for AWS CodePipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=iWK0iRUi-b4</data>
    <data key="d2">Architecture illustrating Snyk security scanning integration into AWS CodePipeline.</data>
    <data key="d3">Security, CI/CD, DevSecOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
