<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developer or automated CI/CD pipeline triggering SmartStack actions</data>
    </node>
    <node id="1">
      <data key="d5">ALB (SmartStack)</data>
      <data key="d6">ALB</data>
      <data key="d7">Entry point exposing REST APIs and single page UI application for control plane</data>
    </node>
    <node id="2">
      <data key="d5">S3 (SmartStack)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores customer-uploaded build artifacts and code for CI/CD updates</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Stateless microservices executing control plane logic and dynamically building Terraform profiles</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Persistence store for SmartStack state and configuration data</data>
    </node>
    <node id="5">
      <data key="d5">CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Executes dynamically generated Terraform code to create multi-layered USC environments</data>
    </node>
    <node id="6">
      <data key="d5">S3 (USC)</data>
      <data key="d6">S3</data>
      <data key="d7">Storage layer for USC commerce platform</data>
    </node>
    <node id="7">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Database tier for the USC commerce platform</data>
    </node>
    <node id="8">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Container registry storing built application images</data>
    </node>
    <node id="9">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs application container workloads for the USC platform</data>
    </node>
    <node id="10">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer handling client traffic to USC platform</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User accesses SmartStack API or UI via ALB</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">User uploads custom code or application updates into S3 bucket</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards API requests to Lambda microservices</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda reads and writes persistence state to DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda generates dynamic Terraform configurations and triggers CodeBuild execution</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda polls S3 bucket for new application code versions</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda triggers build of container images into ECR</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">CodeBuild provisions and deploys the USC infrastructure and services</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Container images from ECR are deployed onto ECS</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">UltraServe SmartStack Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ihB2dRYLOOI</data>
    <data key="d2">SmartStack orchestrates the deployment and CI/CD operations for the UltraServe Commerce (USC) platform on AWS.</data>
    <data key="d3">commerce, serverless, container, orchestration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
