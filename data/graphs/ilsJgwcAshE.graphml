<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Venue / Camera</data>
      <data key="d6">UserConsumerCamera</data>
      <data key="d7">Live event venue capturing camera feeds (e.g. sporting events, news, shows)</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDPORT LIVE</data>
      <data key="d6">EKS</data>
      <data key="d7">Kubernetes cluster on AWS receiving live feeds via Zixi, SRT, or Direct Connect</data>
    </node>
    <node id="2">
      <data key="d5">AUTOMATION</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 cluster running channel scheduling and automation management</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 storing graphics, VOD files, and closed captioning assets</data>
    </node>
    <node id="4">
      <data key="d5">ASSET PROCESSING</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 engine rendering graphic overlays, tickers, and lower-thirds</data>
    </node>
    <node id="5">
      <data key="d5">PLAYOUT</data>
      <data key="d6">EC2</data>
      <data key="d7">CPU-only EC2 compute running the main cloud playout engine</data>
    </node>
    <node id="6">
      <data key="d5">HITLESS SWITCHER</data>
      <data key="d6">EC2</data>
      <data key="d7">Primary Hitless Switcher handling seamless stream switching</data>
    </node>
    <node id="7">
      <data key="d5">HITLESS (Secondary AZ)</data>
      <data key="d6">EC2</data>
      <data key="d7">Redundant Hitless Switcher deployed in a separate Availability Zone for high availability</data>
    </node>
    <node id="8">
      <data key="d5">DIRECT CONNECT</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">AWS Direct Connect dedicated connection to deliver linear feeds</data>
    </node>
    <node id="9">
      <data key="d5">Head End</data>
      <data key="d6">UserCompanyHeadEnd</data>
      <data key="d7">Broadcast satellite/cable head end receiving linear stream</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Camera sends live stream feed via Zixi/SRT/Direct Connect into CloudPort Live</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudPort Live streams live event video feed to Playout</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Automation service triggers playout schedule for broadcast</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset processing fetches graphics, captions, and VOD files from S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset Processing applies graphics and overlays to the active playout stream</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Playout streams output to primary Hitless Switcher</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Playout streams output concurrently to redundant Hitless Switcher in secondary AZ</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Primary stream routed into Direct Connect link</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Secondary AZ stream routed into Direct Connect for zero-frame loss redundancy</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Direct Connect delivers linear broadcast feed directly to Head End</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Amagi Cloud Playout Architecture for Linear Broadcast</data>
    <data key="d1">https://www.youtube.com/watch?v=ilsJgwcAshE</data>
    <data key="d2">Amagi leverages AWS compute, storage, and networking to power over 400 linear broadcast TV channels with active-active hitless redundancy across availability zones.</data>
    <data key="d3">Media &amp; Entertainment</data>
    <data key="d4">True</data>
  </graph>
</graphml>
