  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Transactional database storing application data.</data>
    </node>
    <node id="1">
      <data key="d5">External Data Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External data sources providing property and market data.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon AppFlow</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Ingests data from external sources via pre-built API endpoints.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon S3 (Raw)</data>
      <data key="d6">S3</data>
      <data key="d7">Landing bucket for raw ingested data from RDS and AppFlow.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">ETL service executing transformations and business logic.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon S3 (Processed)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores transformed near real-time data ready for querying.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive SQL query engine accessing processed data.</data>
    </node>
    <node id="7">
      <data key="d5">Dashboard</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Visualization dashboard reading directly from Athena.</data>
    </node>
    <node id="8">
      <data key="d5">Users</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Business analysts and data scientists performing ad-hoc SQL queries.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS exports transactional data to the raw S3 bucket.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">External data sources send data into Amazon AppFlow.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">AppFlow transfers external data directly into raw S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue pulls raw data from S3 for processing.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue outputs transformed data into the processed S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Athena queries data stored in the processed S3 bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena serves query results to the dashboard UI.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Analysts and data scientists query Athena directly.</data>
      <data key="d10">0'</data>
