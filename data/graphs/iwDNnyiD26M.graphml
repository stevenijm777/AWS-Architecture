  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Angular Frontend</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Single Page Application (SPA) frontend interface for web users.</data>
    </node>
    <node id="1">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user authentication, issues JWT tokens, and enforces authorization rules in AppSync.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Static asset storage for the web application.</data>
    </node>
    <node id="3">
      <data key="d5">AppSync</data>
      <data key="d6">AppSync</data>
      <data key="d7">Managed GraphQL API layer consolidating microservice resolvers and managing client subscriptions/queries.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda (Microservice)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Core business logic microservice serving AppSync GraphQL resolvers.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (USGS Weather)</data>
      <data key="d6">Lambda</data>
      <data key="d7">External microservice fetching river flow rate and flooding data from USGS.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Single-table NoSQL database using adjacency list pattern for optimized relational modeling.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Ingestion)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Ingestion Lambda processing change data capture messages into DynamoDB format.</data>
    </node>
    <node id="8">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Pub/sub messaging service receiving sync events from DMS.</data>
    </node>
    <node id="9">
      <data key="d5">Legacy Oracle DB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises legacy Oracle database synchronized to AWS via DMS.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Angular frontend sends user login request to Cognito.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Frontend sends GraphQL queries and mutations to AppSync.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Cognito issues authentication token to the frontend.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Cognito token context evaluates user permissions and directive access in AppSync.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">AppSync invokes core microservice Lambda function as a GraphQL resolver.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">AppSync invokes USGS weather Lambda microservice.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">AppSync consolidates and returns unified GraphQL payload to Angular application.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Microservice Lambda queries single-table DynamoDB for application data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">USGS weather Lambda returns river flow and flood data to AppSync.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion Lambda formats and writes synchronized relational data into DynamoDB using adjacency list patterns.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS triggers the ingestion Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS pushes database change updates to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
