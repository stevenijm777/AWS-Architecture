<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Game clients connecting across 20+ shards worldwide.</data>
    </node>
    <node id="1">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs API receiving player experience telemetry from game clients.</data>
    </node>
    <node id="2">
      <data key="d5">OnPremDC</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premise game servers buffering data in local Kafka before replication.</data>
    </node>
    <node id="3">
      <data key="d5">MSK</data>
      <data key="d6">MSK</data>
      <data key="d7">Regional managed Kafka streaming buffer handling up to 500,000 events per second.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake storing ~8 TB per day in Delta Lake format via Spark streaming.</data>
    </node>
    <node id="5">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Data catalog/metastore and permission/access management layer for analysts and engineers.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Game client sends API requests and telemetry to EKS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Players connect to regional game servers.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS forwards collected data to MSK regional buffer.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Local Kafka buffers data and uses MirrorMaker to replicate into regional MSK clusters.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Spark streaming job writes data from MSK to Delta Lake on S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Riot Games Data Ingestion Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=iwZLadQ3XpY</data>
    <data key="d2">Architecture for global telemetry and player data ingestion for League of Legends, reducing data availability latency from 6-24 hours down to 5 minutes.</data>
    <data key="d3">Analytics, Gaming, Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
