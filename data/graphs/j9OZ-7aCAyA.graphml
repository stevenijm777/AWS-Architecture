  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS queue receiving completion events from upstream serverless data pipelines.</data>
    </node>
    <node id="1">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Job initiator Lambda function triggered natively by SQS.</data>
    </node>
    <node id="2">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB database storing pipeline configurations and execution exit statuses.</data>
    </node>
    <node id="3">
      <data key="d5">STEP FUNCTION</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Step Functions state machine coordinating data loading and cluster scaling.</data>
    </node>
    <node id="4">
      <data key="d5">NEPTUNE</data>
      <data key="d6">Neptune</data>
      <data key="d7">Amazon Neptune graph database storing vertices and edges representing customer journeys.</data>
    </node>
    <node id="5">
      <data key="d5">GREMLIN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Gremlin query engine running graph traversals on Neptune.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing exported query data.</data>
    </node>
    <node id="7">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">AWS Glue cataloging exported data in S3 for broad-based access.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SQS queue natively triggers execution of the job initiator Lambda function.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda function reads pipeline definitions and status records from DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Pipeline state and configuration from DynamoDB feed parameters into Step Functions execution.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions scales up Neptune cluster instances via Boto3 and loads vertices and edges.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Gremlin queries traverse the graph model and export results directly to S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue catalogs exported dataset files stored in S3.</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">HomeSite Insurance Graph Database and Data Pipeline Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=j9OZ-7aCAyA</data>
    <data key="d2">Architecture demonstrating serverless ingestion into Amazon Neptune graph database, managed with AWS Step Functions, DynamoDB, SQS, and exported to S3 for Glue cataloging.</data>
    <data key="d3">Serverless, Analytics, Databases</data>
