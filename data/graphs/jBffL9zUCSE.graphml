  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEV</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Engineering teams building applications and triggering deployment pipelines.</data>
    </node>
    <node id="1">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Elastic Container Registry storing container images built via CI/CD pipelines.</data>
    </node>
    <node id="2">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational Database Service provisioned in developer accounts for backend storage.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Simple Storage Service bucket hosted within developer accounts.</data>
    </node>
    <node id="4">
      <data key="d5">Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Manages account vending, multi-account governance, and automated security guardrails.</data>
    </node>
    <node id="5">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Centralized Elastic Kubernetes Service cluster hosting runtime application workloads.</data>
    </node>
    <node id="6">
      <data key="d5">Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Centralized networking hub routing inter-account communication between runtime workloads and account resources.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer pushes container images to ECR via CI/CD pipeline.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CI/CD deploys container image from ECR to EKS runtime cluster.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Control Tower vends developer accounts and applies security policies across resources.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS workloads send outbound requests through Transit Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Transit Gateway routes traffic to S3 and other services inside individual developer accounts.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">The New York Times Multi-Account Governance and Centralized Kubernetes Runtime Environment</data>
    <data key="d1">https://www.youtube.com/watch?v=jBffL9zUCSE</data>
    <data key="d2">Architecture showcases multi-account governance using Control Tower, container deployments from ECR to centralized EKS runtime, and cross-account service communication through Transit Gateway.</data>
    <data key="d3">DevOps, Containers, Networking, Governance</data>
    <data key="d4">True</data>
  </graph>
