<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ONPREM</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises database storing invoice-level sales data.</data>
    </node>
    <node id="1">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">AWS VPN connection securing data transit from on-premises environment.</data>
    </node>
    <node id="2">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">AWS Database Migration Service using CDC to extract ongoing sales data.</data>
    </node>
    <node id="3">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Amazon Redshift cluster holding invoice sales data and final transformed demand data for querying.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Drop Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket receiving flat order files from the ERP system.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Amazon SQS queue handling file arrival messaging triggers.</data>
    </node>
    <node id="6">
      <data key="d5">Initiator Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function triggered by SQS to process incoming files and route them using metadata.</data>
    </node>
    <node id="7">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Amazon DynamoDB storing file metadata and pipeline parameters.</data>
    </node>
    <node id="8">
      <data key="d5">DATA LAKE</data>
      <data key="d6">S3</data>
      <data key="d7">S3 Data Lake with raw and refined storage buckets.</data>
    </node>
    <node id="9">
      <data key="d5">Complex Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function performing dataset merging, business rule application, and statistical demand forecasting.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises database pipes invoice sales data across the VPN tunnel.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">VPN forwards traffic to DMS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS uses CDC to populate extracted sales data into Redshift.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift makes data available and reads back into the S3 Data Lake.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Landing of flat files in S3 drop bucket kicks off SQS message triggers.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS triggers the Initiator Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Initiator Lambda queries DynamoDB for file metadata.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Initiator Lambda populates data into raw and refined Data Lake S3 buckets.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB returns metadata parameters back to Initiator Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 event trigger on Data Lake launches the Complex Lambda function.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Complex Lambda loads merged and forecasted demand data into Redshift.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Veritiv Invoice and Demand Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=jg85DzUZ9Ac</data>
    <data key="d2">Serverless and CDC-driven analytics architecture that processes invoice sales and demand forecasting using S3, Lambda, DynamoDB, Redshift, and DMS.</data>
    <data key="d3">Data Lake, Analytics, Serverless ETL</data>
    <data key="d4">True</data>
  </graph>
</graphml>
