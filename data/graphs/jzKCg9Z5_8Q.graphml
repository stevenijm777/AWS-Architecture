<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Orchestrates landing zone setup and automates multi-account provisioning.</data>
    </node>
    <node id="1">
      <data key="d5">Organizations</data>
      <data key="d6">Organizations</data>
      <data key="d7">Structures AWS accounts into Organizational Units (OUs) aligned with development lifecycles.</data>
    </node>
    <node id="2">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Automates account creation and provisioning of baseline service configurations within accounts.</data>
    </node>
    <node id="3">
      <data key="d5">Single Sign-On</data>
      <data key="d6">IAM</data>
      <data key="d7">Provides centralized identity management integrated with Okta for federated account access.</data>
    </node>
    <node id="4">
      <data key="d5">Config</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">Runs config recorders and compliance rules to monitor drift across accounts.</data>
    </node>
    <node id="5">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Aggregates operational logs centrally into a single account for unified monitoring.</data>
    </node>
    <node id="6">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Manages role-based access control tied directly to single SSO identities.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Control Tower manages account structure and organizational units via AWS Organizations.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Control Tower uses Service Catalog to automate account creation and baseline service provisioning.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Service Catalog provisions AWS Single Sign-On configuration in new accounts.</data>
      <data key="d10">2'a</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Service Catalog provisions AWS Config rules and recorders in new accounts.</data>
      <data key="d10">2'b</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Service Catalog provisions AWS CloudTrail log settings in new accounts.</data>
      <data key="d10">2'c</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Service Catalog provisions baseline IAM roles in new accounts.</data>
      <data key="d10">2'd</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Blackboard Multi-Account Governance with AWS Control Tower</data>
    <data key="d1">https://www.youtube.com/watch?v=jzKCg9Z5_8Q</data>
    <data key="d2">Blackboard uses AWS Control Tower, AWS Organizations, and AWS Service Catalog to automate landing zone setup and baseline configuration across 120+ AWS accounts, deploying SSO, Config, CloudTrail, and IAM roles centrally.</data>
    <data key="d3">Management &amp; Governance, Security &amp; Compliance</data>
    <data key="d4">True</data>
  </graph>
