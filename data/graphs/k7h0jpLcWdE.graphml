<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user accessing the web application.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts the web application static content.</data>
    </node>
    <node id="2">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles incoming API requests and decouples clients from backend microservices.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute running TypeScript microservices developed with Serverless Framework.</data>
    </node>
    <node id="4">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Containerized microservices running Kotlin and Vert.x toolkit on Docker.</data>
    </node>
    <node id="5">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives fanout messages from backend services.</data>
    </node>
    <node id="6">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues messages for specific service types to ensure idempotent single-instance processing.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB database component present on the architecture diagram.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">User sends API requests to API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 delivers the web application to the user browser.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes relevant API calls directly to Lambda functions.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes requests to microservices hosted on ECS.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS services send messages to SNS topics for fanout distribution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS fans out published messages to target SQS queues.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS queues trigger Lambda functions for async message processing.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS service instances pull messages from SQS queues for single-processing fan-in.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Carano Cloud Microservices Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=k7h0jpLcWdE</data>
    <data key="d2">Carano transitioned from an on-premise JMS architecture to a cloud-native architecture using S3, API Gateway, ECS, Lambda, SNS, and SQS to achieve decoupling, technology flexibility, and reliable message handling.</data>
    <data key="d3">Serverless, Containers, Event-Driven</data>
    <data key="d4">True</data>
  </graph>
</graphml>
