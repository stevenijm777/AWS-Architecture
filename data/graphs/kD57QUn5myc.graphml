  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CUSTOMER</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">External caller calling into contact center.</data>
    </node>
    <node id="1">
      <data key="d5">AGENT</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Call center agent accessing Connect console and real-time transcriptions/analytics.</data>
    </node>
    <node id="2">
      <data key="d5">CONNECT</data>
      <data key="d6">Connect</data>
      <data key="d7">Amazon Connect managed contact center platform.</data>
    </node>
    <node id="3">
      <data key="d5">KINESIS VIDEO STREAM</data>
      <data key="d6">KinesisVideo</data>
      <data key="d7">Ingests live streaming audio from Connect.</data>
    </node>
    <node id="4">
      <data key="d5">TRANSCRIBE</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts streaming call audio into text transcripts.</data>
    </node>
    <node id="5">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores transcript text key-value data indexed by call identifier.</data>
    </node>
    <node id="6">
      <data key="d5">TRANSLATE</data>
      <data key="d6">Translate</data>
      <data key="d7">Translates transcribed text in real-time.</data>
    </node>
    <node id="7">
      <data key="d5">COMPREHEND</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Performs real-time sentiment analysis and keyphrase extraction on transcripts.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Durable object storage for completed transcripts and AI analysis results.</data>
    </node>
    <node id="9">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless backend processing logic.</data>
    </node>
    <edge source="0" target="2" id="0">
