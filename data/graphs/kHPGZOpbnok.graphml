<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Ingests ~4,000 reports/sec with 24-hour retention for decoupled async processing.</data>
    </node>
    <node id="1">
      <data key="d5">Report Enrichment</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Enriches measurement data by matching reports with fact table dimensions.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Batches and compresses enriched JSON data before sending to S3.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Stores over 5 PB of uncompressed newline-separated JSON data.</data>
    </node>
    <node id="4">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Runs ad-hoc SQL queries directly on the S3 Data Lake for data exploration.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Normalizes JSON data to CSV format and can be triggered in batch or retroactively.</data>
    </node>
    <node id="6">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse performing long-term aggregation and analytics.</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores dimension fact tables and receives aggregated insights to expose via Speedtest Intelligence.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis streams reports to the Report Enrichment service.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Report Enrichment writes enriched JSON reports to Kinesis Firehose.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Firehose compresses and dumps newline-separated JSON into S3 Data Lake.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">New objects landing in S3 trigger Lambda execution.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="1">
      <data key="d8">1</data>
      <data key="d9">Lambda can be triggered retroactively on historical data in S3 Data Lake.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries raw JSON fields directly in the S3 Data Lake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda transforms data into CSV and loads it into Redshift.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift writes aggregated insights and analysis back to RDS.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Report Enrichment reads fact table dimensions (carrier, device, geographic place) from RDS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ookla Speedtest Data Ingestion and Analytics Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=kHPGZOpbnok</data>
    <data key="d2">Ookla ingests ~4,000 Speedtest reports per second into AWS Kinesis. The architecture processes, enriches, and stores over 5 PB of data in an S3 Data Lake, using Lambda, Redshift, Athena, and RDS for near real-time analytics and customer insights.</data>
    <data key="d3">Analytics, Data Lake, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
