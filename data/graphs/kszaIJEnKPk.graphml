<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Patient engagement application (MyAir) supporting 30 countries and 20 languages.</data>
    </node>
    <node id="1">
      <data key="d5">AppSync</data>
      <data key="d6">AppSync</data>
      <data key="d7">Managed GraphQL server providing synchronization infrastructure out of the box.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes business logic with ~60 million daily invocations and peak concurrency of 4,000 instances.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Centralized database storing patient engagement data and real-time IoT telemetry.</data>
    </node>
    <node id="4">
      <data key="d5">ResMed Device</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Medical IoT device capturing sleep apnea therapy data.</data>
    </node>
    <node id="5">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Real-time streaming ingestion pipeline for IoT medical device data.</data>
    </node>
    <node id="6">
      <data key="d5">Stream Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by DynamoDB Streams to analyze sleep performance data and detect anomalies.</data>
    </node>
    <node id="7">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes push notifications and emails for sleep analysis alerts.</data>
    </node>
    <node id="8">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN serving static application content, utilizing edge routing logic to reduce assets by 10x.</data>
    </node>
    <node id="9">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores static content including videos, images, and localized assets.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile App communicates over GraphQL to AppSync.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Mobile App requests static content (videos, images, localized assets) from CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">AppSync routes requests to Lambda via VTL (Velocity Translation Language).</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">AppSync synchronizes and returns GraphQL response to Mobile App.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda executes business logic and performs reads/writes on DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB Streams triggers Lambda when new data arrives.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">ResMed IoT device publishes real-time therapy data to Kinesis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis streams transformed data into DynamoDB via Lambda polling and statistical analysis.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Stream Processing Lambda interrogates sleep data and sends notification payload to SNS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">SNS sends push notifications/emails to user's mobile app.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">CloudFront retrieves requested static assets from S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">ResMed MyAir Serverless Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=kszaIJEnKPk</data>
    <data key="d2">Serverless architecture for ResMed's MyAir patient engagement platform, handling IoT sleep therapy data from medical devices and mobile application users.</data>
    <data key="d3">Healthcare, IoT, Serverless, Mobile Backend</data>
    <data key="d4">True</data>
  </graph>
</graphml>
