<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Fires scheduled events every 1 minute to initiate health and capacity monitoring.</data>
    </node>
    <node id="1">
      <data key="d5">Monitoring Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Checks instance health and evaluates capacity requirements (over/under provisioning).</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores UI interaction states and triggers downstream allocation via DynamoDB Streams.</data>
    </node>
    <node id="3">
      <data key="d5">Allocation/De-allocation Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Orchestrates EC2 hot spare assignment and EC2 provisioning/de-allocation requests.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (Upper)</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute instance running custom video processing logic for live streams.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 (Lower)</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute instance running custom video processing logic for live streams.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch triggers Monitoring Lambda every minute.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Monitoring Lambda invokes Allocation/De-allocation Lambda if scaling adjustments are required.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB Streams triggers Allocation/De-allocation Lambda upon object updates from user interactions.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Allocation/De-allocation Lambda configures or provisions upper EC2 instance.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Allocation/De-allocation Lambda configures or provisions lower EC2 instance.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Grabyo Serverless Hot Pool Orchestration and Video Encoding Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ktonI7J3kLY</data>
    <data key="d2">Grabyo uses a serverless orchestration layer featuring CloudWatch, Lambda, and DynamoDB Streams to manage a hot pool of EC2 instances running custom video processing and encoding logic.</data>
    <data key="d3">Media &amp; Entertainment, Compute, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
