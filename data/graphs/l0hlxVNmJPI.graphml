  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Device</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Smart device (e.g., smart desk lamp) deployed at client site</data>
    </node>
    <node id="1">
      <data key="d5">Gateway</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Local network gateway forwarding device traffic</data>
    </node>
    <node id="2">
      <data key="d5">App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile client application embedded with Amazon Cognito SDK</data>
    </node>
    <node id="3">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Primary ingestion point supporting MQTT protocol and rules engine</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user registration, authentication, and authorization</data>
    </node>
    <node id="5">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute triggered by IoT rules engine for downstream processing</data>
    </node>
    <node id="6">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database storing device telemetry inside customer account</data>
    </node>
    <node id="7">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitoring and logging service</data>
    </node>
    <node id="8">
      <data key="d5">Amazon SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Notification service for alerts</data>
    </node>
    <node id="9">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage located within customer account</data>
    </node>
    <node id="10">
      <data key="d5">AWS IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Cross-account access and deployment permissions manager</data>
    </node>
    <node id="11">
      <data key="d5">IoT Portal EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Eclorvalle management platform portal running in vendor VPC</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Device sends data to local gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Gateway forwards messages to AWS IoT Core using MQTT</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">App authenticates user via Cognito SDK</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">IoT Rules Engine writes incoming telemetry data directly to DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">IoT Rules Engine triggers Lambda function for event handling</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda triggers notification via SNS</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda sends metrics/logs to CloudWatch</data>
      <data key="d10">3'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda stores processed outputs in S3</data>
      <data key="d10">3''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">IAM permissions allow IoT Portal to provision resources in customer account</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">IoT Portal accesses IAM role granted by customer</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Eclorvalle AWS IoT SaaS Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=l0hlxVNmJPI</data>
    <data key="d2">Eclorvalle provides a SaaS IoT platform that operates directly within the client's AWS account. User authentication is handled via Amazon Cognito SDK. Devices connect via MQTT through gateways to AWS IoT Core. IoT Rules Engine routes data to DynamoDB for storage and triggers Lambda functions for notifications (SNS), monitoring (CloudWatch), and storage (S3). All customer data remains within the customer's own AWS account, with deployment orchestrated via IAM.</data>
    <data key="d3">IoT, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
