<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Mitigates malicious traffic, bot, and DDoS attacks for incoming web requests.</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Distributes incoming external web traffic to backend microservices.</data>
    </node>
    <node id="2">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles throttling and routing for internal and external APIs across microservices.</data>
    </node>
    <node id="3">
      <data key="d5">K8S</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts 70+ microservices running on Kubernetes containers for high-availability retail commerce.</data>
    </node>
    <node id="4">
      <data key="d5">CACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory caching layer used for processing and enriching non-transactional data.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores multi-terabyte transactional commerce and inventory data using MySQL.</data>
    </node>
    <node id="6">
      <data key="d5">QUEUE</data>
      <data key="d6">SQS</data>
      <data key="d7">Handles asynchronous push/pull message queueing between microservices and storage.</data>
    </node>
    <node id="7">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Elastic Container Registry storing container images for production deployment.</data>
    </node>
    <node id="8">
      <data key="d5">CI/CD</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">CI/CD toolchain using Bitbucket, Fabricator, and Jenkins to build and package software.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF filters external traffic and sends clean traffic to ALB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards load-balanced traffic to Kubernetes microservices.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes throttled API requests to Kubernetes microservices.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes API caching requests to ElastiCache.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Microservices push asynchronous messages to SQS queue.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">4</data>
      <data key="d9">Enriched cached data is persisted to RDS database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Microservices pull asynchronous task messages from SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Asynchronous queued data is written into RDS database.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Images from ECR are pulled and deployed onto Kubernetes containers.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Jenkins builds and pushes docker images to ECR.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Arvind Internet Omni Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=l3f29v3IJGA</data>
    <data key="d2">Architecture supports 35+ global brands, 6,000+ offline stores, and 3-5 million active sessions during peak season using 70+ microservices on Kubernetes.</data>
    <data key="d3">E-commerce &amp; Retail B2B SaaS Platform</data>
    <data key="d4">True</data>
  </graph>
</graphml>
