<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End user consuming video content on a mobile, TV, or web device.</data>
    </node>
    <node id="1">
      <data key="d5">Operator</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Operator portal, website, or application where the user selects and downloads video content.</data>
    </node>
    <node id="2">
      <data key="d5">Irdeto Control</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Irdeto Control multi-DRM front-end managing license acquisition requests.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Node 1</data>
      <data key="d6">EC2</data>
      <data key="d7">Kubernetes worker node running DRM adaptation module and Core service pods.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 Node 2</data>
      <data key="d6">EC2</data>
      <data key="d7">Kubernetes worker node hosting the Rules engine pod for checking user entitlements.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Node 3</data>
      <data key="d6">EC2</data>
      <data key="d7">Kubernetes worker node running additional DRM pods for scaling across availability zones.</data>
    </node>
    <node id="6">
      <data key="d5">RDS (Control DB)</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS instance storing stateful information, policies, bundles, and entitlement rules.</data>
    </node>
    <node id="7">
      <data key="d5">RDS (Data Warehouse)</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS instance acting as a data warehouse for streaming event logging and analytics reporting.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User selects and downloads encrypted video content from Operator portal.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">User device requests decryption license from Irdeto Control.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Irdeto Control routes license request to DRM adaptation pod in EC2 Node 1.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Irdeto Control delivers DRM license and decryption key to User device.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">DRM adaptation pod queries Rules engine pod in EC2 Node 2 to verify entitlement rules.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DRM adaptation pod returns encrypted DRM key and license to Irdeto Control.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Core pod reads and writes entitlement state, rules, and policy configurations to RDS Control DB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 cluster streams operational event metrics to RDS Data Warehouse for reporting.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Rules engine pod returns entitlement validation and usage rules back to DRM adaptation pod.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Rules engine reads entitlement rules and policies stored in RDS Control DB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Irdeto Multi-DRM Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=lA0lAgN0hTI</data>
    <data key="d2">Irdeto Multi-DRM solution running on a Kubernetes cluster hosted across AWS EC2 instances and multi-AZ deployments, utilizing RDS for control state and data warehousing.</data>
    <data key="d3">Media &amp; Entertainment</data>
    <data key="d4">True</data>
  </graph>
</graphml>
