  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Ingests 15 million ad request events per second.</data>
    </node>
    <node id="1">
      <data key="d5">Spark Streaming</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Reads real-time data from Kafka and writes Parquet to S3.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Raw Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw event data in Parquet format.</data>
    </node>
    <node id="3">
      <data key="d5">Spark EKS Spotinst</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs Spark jobs on Kubernetes with Spotinst spot instance auto-scaling.</data>
    </node>
    <node id="4">
      <data key="d5">Airflow</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Orchestrates and triggers Spark on EKS and EMR workflows.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Aggregated Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores aggregated event data.</data>
    </node>
    <node id="6">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Reads aggregated data from S3 and populates Druid.</data>
    </node>
    <node id="7">
      <data key="d5">Druid</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Powers 50+ dimensional ad performance analysis.</data>
    </node>
    <node id="8">
      <data key="d5">Cassandra</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores high-speed historical aggregated metrics, returning queries in milliseconds.</data>
    </node>
    <node id="9">
      <data key="d5">Presto</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Database query engine executing fast snapshot queries on S3.</data>
    </node>
    <node id="10">
      <data key="d5">Dashboard UI</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Analytics interface displaying visualizations powered by Cassandra, Presto, and Druid.</data>
    </node>
    <edge source="0" target="1" id="0">
