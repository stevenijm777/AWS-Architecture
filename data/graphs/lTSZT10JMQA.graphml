<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Video Input</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">High-definition video feed ingest (50 Mbps, ~50 GB for a 2-hour sports match).</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw input videos, extracted PNG frame images, and detection metadata.</data>
    </node>
    <node id="2">
      <data key="d5">STEP FUNCTION</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the sequential 4-step video analysis and compilation pipeline.</data>
    </node>
    <node id="3">
      <data key="d5">Frame Extraction Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Extracts thousands of video frames into PNG format and stores them in S3.</data>
    </node>
    <node id="4">
      <data key="d5">Batch Dispatcher Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lists extracted frames and dispatches batch processing jobs (50-200 frames per batch).</data>
    </node>
    <node id="5">
      <data key="d5">Parallel Inference Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes parallel computer vision inference using TensorFlow models across up to 1,000 concurrent Lambda functions.</data>
    </node>
    <node id="6">
      <data key="d5">Decision Engine Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Analyzes detected features (e.g., ball position, goal events) to determine highlight edit points.</data>
    </node>
    <node id="7">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Orchestrates long-running FFmpeg video transcoding and editing container tasks.</data>
    </node>
    <node id="8">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Provides underlying compute host capacity for the ECS cluster tasks.</data>
    </node>
    <node id="9">
      <data key="d5">STREAMING PLATFORM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External streaming platforms that deliver compiled highlight videos to end users.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">High-bitrate video stream uploaded to S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Video arrival automatically triggers Step Functions execution workflow.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes Frame Extraction Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes Batch Dispatcher Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes Decision Engine Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions triggers ECS video editing execution.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Batch Dispatcher launches parallel inference Lambda tasks for frame batches.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS runs container workload on EC2 instances.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Edited video highlights pushed to destination streaming platforms.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">CLAP Automated Sports Video Editing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=lTSZT10JMQA</data>
    <data key="d2">Automated video processing pipeline built on AWS by CLAP to ingest high-definition sports streams, extract frames, execute parallel AI inference for feature detection, assemble clip edits, and deliver finalized highlights to streaming platforms.</data>
    <data key="d3">Media &amp; Entertainment</data>
    <data key="d4">True</data>
  </graph>
</graphml>
