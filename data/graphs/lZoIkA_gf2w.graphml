<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Serves as the front door access point, integrating with Cognito for token validation and developer portal capabilities.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Provides customer identity and access management (CIAM), meeting global banking security and regulatory requirements.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes custom extensions during token generation for step-up security and fraud system integration.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Elastic Kubernetes Service (Amazon EKS)</data>
      <data key="d6">EKS</data>
      <data key="d7">Core compute engine running containerized banking microservices that elastically scales and emits state changes.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Managed Streaming for Apache Kafka (Amazon MSK)</data>
      <data key="d6">MSK</data>
      <data key="d7">Managed event streaming backbone capturing all cluster mutation events and supporting real-time subscriptions.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Receives real-time streaming data from Amazon MSK to feed the downstream data lake and analytics platform.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon API Gateway performs token validation via integration with Amazon Cognito.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Cognito triggers AWS Lambda during token generation for custom step-up security and fraud management.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">State mutations in Amazon EKS emit events directly to Amazon MSK.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS microservices subscribe back to Amazon MSK streams in real time for event-driven updates.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon MSK streams event payloads to Amazon Redshift to populate the downstream data lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Deloitte Converge Banking Cloud Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=lZoIkA_gf2w</data>
    <data key="d2">Converge Banking by Deloitte is a cloud platform for banking and financial services. It utilizes Amazon EKS for running microservices, Amazon MSK for streaming mutation events, Amazon Redshift for downstream analytics, Amazon API Gateway as the front door, and Amazon Cognito combined with AWS Lambda for compliant customer identity and step-up security.</data>
    <data key="d3">Financial Services, Compute, Analytics &amp; Data Lakes, Security &amp; Identity</data>
    <data key="d4">True</data>
  </graph>
</graphml>
