<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerAPI</data>
      <data key="d7">Triggers transcoding jobs via Bitmovin SDK or API requests.</data>
    </node>
    <node id="1">
      <data key="d5">SCHEDULER</data>
      <data key="d6">EC2</data>
      <data key="d7">Receives API job requests and configurations.</data>
    </node>
    <node id="2">
      <data key="d5">INPUT</data>
      <data key="d6">S3</data>
      <data key="d7">Stores input video assets.</data>
    </node>
    <node id="3">
      <data key="d5">MASTER</data>
      <data key="d6">EC2</data>
      <data key="d7">Pulls video source, analyzes and splices it, dispatches jobs to workers, and stitches output segments.</data>
    </node>
    <node id="4">
      <data key="d5">WORKERS</data>
      <data key="d6">EC2</data>
      <data key="d7">Kubernetes cluster on EC2 Spot Instances encoding small chunked video segments.</data>
    </node>
    <node id="5">
      <data key="d5">OUTPUT</data>
      <data key="d6">S3</data>
      <data key="d7">Stores final stitched transcoded video files.</data>
    </node>
    <node id="6">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Content Delivery Network (CDN) serving transcoded videos to end consumers.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User sends API request with job config to Scheduler.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Scheduler passes job configuration and source location to Master node.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Master pulls source video file from S3 Input bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Master dispatches spliced video segment jobs to Kubernetes Spot Workers.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Master stitches processed chunks together and writes output to S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Workers send encoded segment chunks back to Master.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront CDN fetches and distributes final video files to end-user devices.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Bitmovin Distributed Video Transcoding Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=lcLw-Le_tXQ</data>
    <data key="d2">Bitmovin utilizes a chunk-based video transcoding architecture built on AWS EC2 spot instances with Kubernetes, allowing fast parallel processing and resiliency against spot instance terminations.</data>
    <data key="d3">Media &amp; Entertainment, Compute, Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
