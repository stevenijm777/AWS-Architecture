<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives incoming transaction JSON payloads.</data>
    </node>
    <node id="1">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms JSON events into blockchain transactions.</data>
    </node>
    <node id="2">
      <data key="d5">PRIVATELINK</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">Provides private network connectivity from customer VPC to Kaleido network.</data>
    </node>
    <node id="3">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Holds master decryption keys to secure blockchain transaction signing.</data>
    </node>
    <node id="4">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Receives node logs from Kaleido for centralized operational monitoring.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores full node backups and off-chain application data.</data>
    </node>
    <node id="6">
      <data key="d5">ETHCONNECT</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Kaleido REST API interface for submitting transactions to Ethereum.</data>
    </node>
    <node id="7">
      <data key="d5">KAFKA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Kafka streaming engine to order transactions by nonces.</data>
    </node>
    <node id="8">
      <data key="d5">REGISTRY</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-chain identity registry mapping PKI identities to blockchain keys.</data>
    </node>
    <node id="9">
      <data key="d5">IPFS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Peer-to-peer file storage for off-chain data referenced by on-chain hashes.</data>
    </node>
    <node id="10">
      <data key="d5">PRIVACY EXTENSIONS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Privacy mechanisms including HD wallets and zero-knowledge tools.</data>
    </node>
    <node id="11">
      <data key="d5">BLOCKCHAIN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Underlying permissioned private Ethereum blockchain network.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SQS passes JSON payloads to Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda forwards JSON transactions over PrivateLink.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">PrivateLink connects directly to ETHConnect REST interface.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">ETHConnect streams transactions into Kafka partitions based on nonces.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">ETHConnect verifies identities against on-chain Registry.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="11" id="0">
      <data key="d8">0</data>
      <data key="d9">Kafka delivers ordered transactions onto the Blockchain.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">IPFS stores off-chain files and writes cryptographic hashes to Blockchain.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">AWS Integration with Kaleido Enterprise Blockchain Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=lecbHMBD8KQ</data>
    <data key="d2">Shows interaction between customer AWS services (SQS, Lambda, PrivateLink, KMS, CloudWatch, S3) and Kaleido blockchain components (ETHConnect, Kafka, Registry, IPFS, Privacy Extensions, Blockchain).</data>
    <data key="d3">Blockchain, AWS Integration, Enterprise Applications</data>
    <data key="d4">True</data>
  </graph>
</graphml>
