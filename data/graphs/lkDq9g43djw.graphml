<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Handles ~10 million requests per day; routes away from failed Availability Zones.</data>
    </node>
    <node id="1">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Used to route Layer 4 network traffic specifically.</data>
    </node>
    <node id="2">
      <data key="d5">EKS (AZ 1)</data>
      <data key="d6">EKS</data>
      <data key="d7">Stripes workloads across instances and AZs; uses Carpenter for autoscaling.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 (AZ 1)</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker nodes running on ARM/Spot instances to optimize costs.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (AZ 2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker nodes in second Availability Zone for high availability.</data>
    </node>
    <node id="5">
      <data key="d5">EKS (AZ 2)</data>
      <data key="d6">EKS</data>
      <data key="d7">Container orchestration in second Availability Zone.</data>
    </node>
    <node id="6">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Receives ~3000 requests/second; replicates across AZs and regions; runs on ARM.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes 10M daily requests to Network Load Balancer</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB distributes Layer 4 traffic to compute resources in Availability Zone 1</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB distributes Layer 4 traffic to compute resources in Availability Zone 2</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Compute layer sends 3000 requests per second to Aurora database</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">FinBorn Chaos Engineering &amp; Resilient Data Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=lkDq9g43djw</data>
    <data key="d2">FinBorn uses chaos engineering (terminating apps every 17 minutes, EC2 instances every 6 hours, and failing an AZ twice weekly) across a multi-AZ deployment on AWS to handle 10 million requests/day.</data>
    <data key="d3">Compute, Databases, Networking</data>
    <data key="d4">True</data>
  </graph>
</graphml>
