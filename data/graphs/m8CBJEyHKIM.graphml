<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">LB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load Balancer distributing incoming microservice traffic to backend compute instances.</data>
    </node>
    <node id="1">
      <data key="d5">AutoScaling</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling Group configured with Mixed Instances Policy and multi-AZ instance diversification.</data>
    </node>
    <node id="2">
      <data key="d5">SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 Spot instances configured via Mixed Instances Policy to handle ~90% of compute workload at reduced cost.</data>
    </node>
    <node id="3">
      <data key="d5">ON-DEMAND</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 On-Demand instances providing ~10% baseline compute capacity within the Auto Scaling Group.</data>
    </node>
    <node id="4">
      <data key="d5">CW</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">CloudWatch service triggering scheduled or event-driven leaderboard batch calculation workflows.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function calculating real-time compute capacity requirements for leaderboard ranking Spark batch processes.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Load Balancer routes incoming user requests to the AutoScaling managed compute fleet.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Auto Scaling provisions and distributes traffic across Spot instances (~90% allocation).</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Auto Scaling provisions and distributes traffic across On-Demand instances (~10% allocation).</data>
      <data key="d10">1''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch triggers Lambda function for leaderboard rank calculation.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda dynamically calculates required compute capacity and updates Auto Scaling group desired capacity.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Dream11 Cost-Optimized Microservices and Batch Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=m8CBJEyHKIM</data>
    <data key="d2">Architecture showing Dream11's dual-pipeline approach: a microservices traffic pipeline leveraging Auto Scaling Mixed Instances Policies (90% Spot, 10% On-Demand) and a batch processing pipeline where CloudWatch and Lambda dynamically scale Spark batch worker nodes.</data>
    <data key="d3">Compute, Auto Scaling, Batch Processing, Cost Optimization</data>
    <data key="d4">True</data>
  </graph>
</graphml>
