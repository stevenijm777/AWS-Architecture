<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2 Application Host</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs web/application workloads and pushes application and OS logs via the CloudWatch agent.</data>
    </node>
    <node id="1">
      <data key="d5">CloudWatch Logs</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects application and system logs from EC2 instances.</data>
    </node>
    <node id="2">
      <data key="d5">AWS CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Captures management and API activity logs across the individual account.</data>
    </node>
    <node id="3">
      <data key="d5">VPC Flow Logs</data>
      <data key="d6">VPC</data>
      <data key="d7">Captures network traffic flow logs for network visibility.</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams and batches log data from CloudWatch, CloudTrail, and VPC Flow Logs.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Log Transformer)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Converts legacy log formats into a single unified format and filters out unnecessary non-critical data.</data>
    </node>
    <node id="6">
      <data key="d5">Centralized S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores cross-account unified logs with encryption, lifecycle policies, and scalable storage.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Log Ingester)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 upload events to ingest and format data for Elasticsearch.</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Indexes and stores unified log data for rapid keyword searching and troubleshooting.</data>
    </node>
    <node id="9">
      <data key="d5">Kibana</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Visualization platform used to generate dashboards and perform log analytics.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 instance sends logs to CloudWatch using CloudWatch Agent.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch streams log events into Kinesis Firehose.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudTrail streams API audit logs to Kinesis Firehose.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">VPC Flow Logs stream network data to Kinesis Firehose.</data>
      <data key="d10">1''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Firehose sends log batches to Lambda for transformation and filtering.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes normalized logs to the centralized S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 object creation triggers the central ingestion Lambda function.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda ingests log records into Elasticsearch.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Biogen Centralized Logging Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=m8xtR3-ZQs8</data>
    <data key="d2">Demonstrates serverless cross-account log collection across hundreds of AWS accounts using Firehose, S3, Lambda, and Elasticsearch/Kibana.</data>
    <data key="d3">Logging, Analytics, Serverless, Multi-Account</data>
    <data key="d4">True</data>
  </graph>
</graphml>
