<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Parking</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External parking sensors sending occupancy data</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Ingests real-time streaming data from parking systems</data>
    </node>
    <node id="2">
      <data key="d5">Lambda (Ingestion)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggers every minute to clean data, write to DynamoDB, and export to S3</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores historical parquet data for model training</data>
    </node>
    <node id="4">
      <data key="d5">Dynamo DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores real-time occupancy data with a 1-week TTL</data>
    </node>
    <node id="5">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains ML models and hosts endpoints for long-term parking occupancy predictions</data>
    </node>
    <node id="6">
      <data key="d5">Step Function</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates ML pipeline steps including data prep, model training, and endpoint deployment</data>
    </node>
    <node id="7">
      <data key="d5">Code Commit</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">Stores IaC CloudFormation templates, Lambda code, and SageMaker algorithms</data>
    </node>
    <node id="8">
      <data key="d5">Lambda (API)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes API requests from API Gateway by querying SageMaker endpoints or DynamoDB</data>
    </node>
    <node id="9">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for public end users requesting occupancy predictions or real-time state</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Parking systems send occupancy data to Kinesis Firehose</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Firehose triggers ingestion Lambda every minute</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion Lambda exports historical parquet data to S3</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion Lambda writes real-time occupancy state to DynamoDB</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker consumes historical data from S3 for training ML models</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions triggers model training and endpoint deployment in SageMaker</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions triggers data cleaning and preparation Lambda functions</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">CodeCommit deploys updated code and infrastructure updates to ingestion Lambda</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">CodeCommit deploys updated code and infrastructure updates to API Lambda</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">API Lambda queries SageMaker endpoint for forecasting predictions</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">API Lambda retrieves real-time occupancy data from DynamoDB</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">API Gateway routes user requests to API Lambda</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Meriad Parking Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=mKZw29_UtoU</data>
    <data key="d2">Architecture designed for IEM Mobilità to process real-time parking data, store historical records, train SageMaker forecasting models, and serve API requests.</data>
    <data key="d3">AI/ML, Serverless, Big Data</data>
    <data key="d4">True</data>
  </graph>
</graphml>
