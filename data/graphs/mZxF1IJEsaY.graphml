<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Provides DNS resolution and routing for both front-end and back-end services.</data>
    </node>
    <node id="1">
      <data key="d5">ALB Front End</data>
      <data key="d6">ALB</data>
      <data key="d7">Load balances incoming traffic to the front-end container instances.</data>
    </node>
    <node id="2">
      <data key="d5">ECS Front End</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs Docker containers for front-end service, configured to auto-scale.</data>
    </node>
    <node id="3">
      <data key="d5">ALB Back End</data>
      <data key="d6">ALB</data>
      <data key="d7">Load balances traffic from front-end services to back-end container tasks.</data>
    </node>
    <node id="4">
      <data key="d5">ECS Back End</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs back-end business logic in Docker containers on ECS.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon MQ</data>
      <data key="d6">AmazonMQ</data>
      <data key="d7">Managed message broker replacing legacy ActiveMQ deployment.</data>
    </node>
    <node id="6">
      <data key="d5">Aurora MySQL</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational database using custom indexes and read replicas for high performance.</data>
    </node>
    <node id="7">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">Database Migration Service used for initial data transfer and testing during Oracle-to-MySQL migration.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes incoming traffic to Front End ALB.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes back-end requests to Back End ALB.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Front End ALB routes HTTP requests to Front End ECS tasks.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Front End ECS calls Back End service via Route 53 DNS.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Back End ALB forwards requests to Back End ECS tasks.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Back End ECS reads/writes to Aurora MySQL database.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Back End ECS produces and consumes messages with Amazon MQ.</data>
      <data key="d10">5'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">DMS performs data migration dump/sync into Aurora MySQL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Zappos Back Office Migration Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=mZxF1IJEsaY</data>
    <data key="d2">Architecture uses ECS for containerized services, Route 53 and ALBs for front-end and back-end routing, Aurora MySQL for relational storage, Amazon MQ for messaging, and DMS for migration.</data>
    <data key="d3">Migration, Microservices, Web Application</data>
    <data key="d4">True</data>
  </graph>
</graphml>
