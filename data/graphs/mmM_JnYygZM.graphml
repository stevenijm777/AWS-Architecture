  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">MongoDB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Internal database storing core e-commerce platform data</data>
    </node>
    <node id="1">
      <data key="d5">ECS PROXY</data>
      <data key="d6">ECS</data>
      <data key="d7">Proxy worker microservice on ECS facilitating sync with Kafka</data>
    </node>
    <node id="2">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Streaming broker bridging external Couchbase and internal ECS Proxy worker</data>
    </node>
    <node id="3">
      <data key="d5">Couchbase</data>
      <data key="d6">CouchBase</data>
      <data key="d7">Database storing POS system transactional and client data</data>
    </node>
    <node id="4">
      <data key="d5">ECS SSO</data>
      <data key="d6">ECS</data>
      <data key="d7">SSO gateway microservice running on ECS supporting OpenID Connect</data>
    </node>
    <node id="5">
      <data key="d5">API GW OPEN API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Fully managed API Gateway exposing Open API with token-based auth</data>
    </node>
    <node id="6">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF providing web application security for API Gateway</data>
    </node>
    <node id="7">
      <data key="d5">SHIELD</data>
      <data key="d6">Shield</data>
      <data key="d7">AWS Shield providing DDoS protection for API Gateway</data>
    </node>
    <node id="8">
      <data key="d5">POS CLIENT</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">POS Mobile Application used in physical retail stores</data>
    </node>
    <node id="9">
      <data key="d5">POS ADMIN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">POS Admin web application accessing Open API endpoints</data>
    </node>
    <node id="10">
      <data key="d5">CW</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">CloudWatch service logging platform and POS activity data</data>
    </node>
    <node id="11">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 data lake storing user behavior and POS transaction data</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS Proxy worker pushes platform changes back to Kafka</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Kafka streams updates to ECS Proxy worker</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Kafka synchronizes platform updates into Couchbase</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Couchbase sends synchronization updates to Kafka streaming service</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS SSO Gateway returns authentication tokens to POS Client</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">AWS WAF filters web traffic protecting API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
