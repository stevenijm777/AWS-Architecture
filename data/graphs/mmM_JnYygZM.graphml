    <edge source="7" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">AWS Shield provides DDoS protection for API Gateway</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">POS Client authenticates against ECS SSO Gateway via OpenID protocol</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
