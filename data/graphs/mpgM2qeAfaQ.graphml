  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">WEBCAM FEED</data>
      <data key="d6">UserConsumerCamera</data>
      <data key="d7">Video stream input directly from a standard webcam.</data>
    </node>
    <node id="1">
      <data key="d5">VIDEO WEB APP</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web-based application streaming video into the AWS Cloud.</data>
    </node>
    <node id="2">
      <data key="d5">IOT DEVICES</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">IoT edge devices such as AWS DeepLens streaming video.</data>
    </node>
    <node id="3">
      <data key="d5">MOBILE APPS</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile application streaming video using AWS Kinesis Video Streams SDK.</data>
    </node>
    <node id="4">
      <data key="d5">KINESIS VIDEO</data>
      <data key="d6">KinesisVideo</data>
      <data key="d7">Securely and scalably ingests incoming real-time video streams.</data>
    </node>
    <node id="5">
      <data key="d5">REKOGNITION VIDEO</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Integrated directly with Kinesis Video Streams to detect and track positions, geometries, and locations of faces in near real time.</data>
    </node>
    <node id="6">
      <data key="d5">KINESIS (Raw Stream)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Receives raw data of labeled faces and positions from Rekognition Video.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes custom post-processing algorithms (e.g. calculating rotational/translational velocities and anomaly alerts).</data>
    </node>
    <node id="8">
      <data key="d5">KINESIS (Processed Stream)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Serves as a conduit for the analyzed and post-processed data.</data>
    </node>
    <node id="9">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API endpoint fronting the processed Kinesis data stream for client consumption.</data>
    </node>
    <node id="10">
      <data key="d5">VISUALIZATION DASHBOARD</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Frontend web client pulling from API Gateway to show real-time chart visualizations.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Webcam stream sent to Kinesis Video Streams.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Video Web App stream sent to Kinesis Video Streams.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT device stream sent to Kinesis Video Streams.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile app stream sent to Kinesis Video Streams.</data>
      <data key="d10">0'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Direct integration streams video into Rekognition Video for real-time face detection.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Rekognition outputs raw labeled face data into raw Kinesis Data Stream.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda reads raw metadata stream to perform custom analytical calculations.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda outputs processed metrics into processed Kinesis Data Stream.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway fronts processed Kinesis Data Stream.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Visualization dashboard pulls processed metrics via API Gateway for near real-time visualization.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Brainpower Real-time Video Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=mpgM2qeAfaQ</data>
    <data key="d2">Architecture for streaming video from various devices to perform real-time body language and facial analysis using Kinesis Video Streams, Rekognition, Lambda post-processing, and API Gateway.</data>
    <data key="d3">Media Processing, Real-Time Analytics, AI/ML</data>
    <data key="d4">True</data>
  </graph>
