<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Triggers RPA bots manually via email or interface.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores incoming files and audio inputs that trigger automation workflows.</data>
    </node>
    <node id="2">
      <data key="d5">BOTS</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances hosting RPA bot engines (e.g., Automation Anywhere) and control room orchestration.</data>
    </node>
    <node id="3">
      <data key="d5">RULES</data>
      <data key="d6">RDS</data>
      <data key="d7">RDS database storing execution rules, business logic, user access privileges, and security controls.</data>
    </node>
    <node id="4">
      <data key="d5">TRANSCRIBE</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts input audio files into text transcripts.</data>
    </node>
    <node id="5">
      <data key="d5">COMPREHEND</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Extracts entities, key phrases, and insights from transcribed text.</data>
    </node>
    <node id="6">
      <data key="d5">POLLY</data>
      <data key="d6">Polly</data>
      <data key="d7">Synthesizes processed text back into audio.</data>
    </node>
    <node id="7">
      <data key="d5">PEERING</data>
      <data key="d6">VPCPeering</data>
      <data key="d7">Secure VPC Peering / VPN tunnel connecting to client enterprise applications.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">User manually triggers RPA bot execution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">File updates in S3 automatically trigger RPA bot tasks.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Audio files stored in S3 are sent to Amazon Transcribe.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">RPA bots query RDS database for rules and security access privileges.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Execution rules authorize and route requests through VPC Peering to external client applications.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Transcribed text output is passed to Amazon Comprehend.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Transcription results are fed directly into the BOTS for processing.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Extracted text from Comprehend is passed to Amazon Polly.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Extracted key phrases and structured metadata update business rules in RDS.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Synthesized speech results feed back into execution rules in RDS.</data>
      <data key="d10">3''</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">ZS Associates Intelligent Process Automation Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=mq3XuoN0rUM</data>
    <data key="d2">Combines RPA on EC2 with AWS Cognitive services (Transcribe, Comprehend, Polly), storing business rules and permissions in RDS, with VPC Peering for secure client app connections.</data>
    <data key="d3">Cognitive Automation &amp; RPA</data>
    <data key="d4">True</data>
  </graph>
