<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Central entry point routing incoming requests to either transaction write paths or query read paths.</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Balances transactional write traffic to backend container images in Fargate.</data>
    </node>
    <node id="2">
      <data key="d5">FARGATE</data>
      <data key="d6">Fargate</data>
      <data key="d7">Hosts core transaction processing logic containers with automated elastic scaling.</data>
    </node>
    <node id="3">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database performing OLTP operations for transactional persistence.</data>
    </node>
    <node id="4">
      <data key="d5">KINESIS</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Streaming data service receiving business and data events emitted by Fargate.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Event Processor)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes Kinesis event streams to build and update the query-optimized read model.</data>
    </node>
    <node id="6">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database storing query-optimized read models to offload query load from RDS.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Query)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes rapid read queries directly against the optimized model in DynamoDB.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes write/transaction requests to the Elastic Load Balancer.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway routes query workload requests directly to Query Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards request traffic to container tasks running on Fargate.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate container logic persists transactional data directly into RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Fargate emits business/data events onto the Kinesis event stream.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis stream triggers the Event Processor Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Event Processor Lambda writes the query-optimized view into DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Query Lambda interrogates DynamoDB for high-speed query responses.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Temenos Serverless &amp; Container Banking Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=mtZvA7ARepM</data>
    <data key="d2">Architecture processes up to 50,000 transactions/second split between OLTP updates in RDS and CQRS read offloading in DynamoDB.</data>
    <data key="d3">Banking Software, CQRS, Serverless, Microservices</data>
    <data key="d4">True</data>
  </graph>
</graphml>
