  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Input</data>
      <data key="d6">S3</data>
      <data key="d7">Receives incoming web, customer, and purchase data files.</data>
    </node>
    <node id="1">
      <data key="d5">SQS High Priority</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds high-priority task messages requiring low-latency responses (e.g., user screen operations).</data>
    </node>
    <node id="2">
      <data key="d5">SQS Low Priority</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds lower-priority batch processing task messages.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Worker Nodes</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker instances polling SQS queues and dispatching work to EMR endpoints.</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors EMR cluster status and resource metrics.</data>
    </node>
    <node id="5">
      <data key="d5">Resource Manager EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Core controller managing dynamic EMR cluster allocation, spot recovery, and API endpoints.</data>
    </node>
    <node id="6">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores task-to-cluster mapping and cluster state metadata.</data>
    </node>
    <node id="7">
      <data key="d5">EMR Cluster 1</data>
      <data key="d6">EMR</data>
      <data key="d7">Spot instance based EMR cluster executing distributed big data analytics jobs.</data>
    </node>
    <node id="8">
      <data key="d5">EMR Cluster 2</data>
      <data key="d6">EMR</data>
      <data key="d7">Spot instance based EMR cluster executing distributed big data analytics jobs.</data>
    </node>
    <node id="9">
      <data key="d5">EMR Cluster 3</data>
      <data key="d6">EMR</data>
      <data key="d7">Spot instance based EMR cluster executing distributed big data analytics jobs.</data>
    </node>
    <node id="10">
      <data key="d5">S3 (EMRFS)</data>
      <data key="d6">S3</data>
      <data key="d7">Output S3 bucket storing processed analytics results via EMRFS.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 object creation events publish high-priority job notifications to SQS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 object creation events publish low-priority batch job notifications to SQS.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 workers consume high-priority task messages.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 workers consume low-priority task messages.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Workers call Resource Manager API to request available EMR cluster endpoints.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Worker submits processing job to assigned EMR Cluster 1.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Worker submits processing job to assigned EMR Cluster 2.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Worker submits processing job to assigned EMR Cluster 3.</data>
      <data key="d10">0''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Resource Manager queries RDS for cluster mapping and availability.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Resource Manager returns target EMR cluster endpoint to the worker.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Resource Manager integrates with CloudWatch for state monitoring.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Resource Manager monitors EMR health and automatically recovers terminated spot clusters.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR Cluster 1 writes output data to destination S3 bucket via EMRFS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR Cluster 2 writes output data to destination S3 bucket via EMRFS.</data>
