  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">BATCH</data>
      <data key="d6">Batch</data>
      <data key="d7">Executes batch segmentation algorithms.</data>
    </node>
    <node id="1">
      <data key="d5">LAMBDA_1</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes segmentation algorithm outputs and uploads segment files to S3.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores generated user segment files.</data>
    </node>
    <node id="3">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives S3 PutObject event notifications and forwards them to Lambda.</data>
    </node>
    <node id="4">
      <data key="d5">LAMBDA_2</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by SNS to invoke the Step Functions workflow.</data>
    </node>
    <node id="5">
      <data key="d5">STEP FUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates campaign import and execution state machine.</data>
    </node>
    <node id="6">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores Amazon Pinpoint project configuration metadata.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA_3</data>
      <data key="d6">Lambda</data>
      <data key="d7">Retrieves project metadata from DynamoDB, calls Pinpoint import/campaign APIs, and polls job status.</data>
    </node>
    <node id="8">
      <data key="d5">PINPOINT</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">Central targeting engine that imports segment data and delivers messages.</data>
    </node>
    <node id="9">
      <data key="d5">LAMBDA_4</data>
      <data key="d6">Lambda</data>
      <data key="d7">Functions as a Pinpoint custom channel handler for sending LINE messages.</data>
    </node>
    <node id="10">
      <data key="d5">Email Recipients</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End users receiving personalized email communications.</data>
    </node>
    <node id="11">
      <data key="d5">LINE Recipients</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End users receiving personalized notifications via LINE messenger.</data>
    </node>
