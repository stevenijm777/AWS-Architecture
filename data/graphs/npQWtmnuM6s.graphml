  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Engineers</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Engineers creating code changes and pull requests</data>
    </node>
    <node id="1">
      <data key="d5">GitHub</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Source code repository and PR trigger source</data>
    </node>
    <node id="2">
      <data key="d5">Amazon EKS (CI/CD)</data>
      <data key="d6">EKS</data>
      <data key="d7">CI/CD EKS cluster running Tekton pipelines for automated testing and builds</data>
    </node>
    <node id="3">
      <data key="d5">Amazon ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Container registry storing signed container images</data>
    </node>
    <node id="4">
      <data key="d5">IAM Role</data>
      <data key="d6">IAM</data>
      <data key="d7">IAM Role used to perform secure cross-account deployments</data>
    </node>
    <node id="5">
      <data key="d5">AWS Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Automates multi-account structure management across 14+ accounts</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Security Lake</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Centralized log and security management aggregator for GuardDuty and VPC Flow Logs</data>
    </node>
    <node id="7">
      <data key="d5">Amazon EKS (Playground 1)</data>
      <data key="d6">EKS</data>
      <data key="d7">Playground EKS cluster running scheduled (weekly/monthly) environment workloads</data>
    </node>
    <node id="8">
      <data key="d5">Amazon EKS (Playground 2)</data>
      <data key="d6">EKS</data>
      <data key="d7">Playground EKS cluster hosting ephemeral feature-branch testing environments</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Engineers push code and create pull requests in GitHub</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">GitHub PR kicks off pipeline run in Amazon EKS CI/CD cluster</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS builds and pushes signed container image into ECR registry</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS assumes IAM Role for cross-account deployment permissions</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">IAM Role connects and validates account access managed by Control Tower</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">IAM Role deploys/promotes image to target Playground EKS cluster</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">SwiftX Multi-Account CI/CD and Security Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=npQWtmnuM6s</data>
    <data key="d2">SwiftX manages multi-account governance across 14+ AWS accounts using AWS Control Tower. Tekton pipelines running on Amazon EKS build, test, and push images to Amazon ECR, using IAM roles to safely promote artifacts across Playground, Development, and Production environments while centralizing security logs via Amazon Security Lake.</data>
    <data key="d3">DevOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
