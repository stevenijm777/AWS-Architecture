  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Global users accessing the NewsGrid application on desktop and mobile devices.</data>
    </node>
    <node id="1">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Handles DNS routing and disaster recovery region determination (Virginia vs. Oregon).</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer routing incoming HTTP requests.</data>
    </node>
    <node id="3">
      <data key="d5">COGNITO</data>
      <data key="d6">Cognito</data>
      <data key="d7">Enforces user authentication using Cognito and Okta as an identity provider.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (Left)</data>
      <data key="d6">EC2</data>
      <data key="d7">Application server running in Availability Zone 1.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 (Right)</data>
      <data key="d6">EC2</data>
      <data key="d7">Redundant application server running in Availability Zone 2.</data>
    </node>
    <node id="6">
      <data key="d5">APPSYNC</data>
      <data key="d6">AppSync</data>
      <data key="d7">Core GraphQL API handling queries, mutations, and real-time MQTT subscriptions.</data>
    </node>
    <node id="7">
      <data key="d5">ELASTIC SEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Elasticsearch cluster used for search, sorting, and advanced filtering.</data>
    </node>
    <node id="8">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes background jobs and syncs DynamoDB Stream updates into Elasticsearch.</data>
    </node>
    <node id="9">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Primary persistent data store replicated across regions via Global Tables.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users query Route 53 to resolve active regional target.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Users connect directly to Elastic Load Balancer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB validates user session with Cognito/Okta.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB routes authenticated traffic to EC2 instance in AZ 1.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB routes authenticated traffic to EC2 instance in AZ 2.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 proxies queries and mutations to AppSync API.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 proxies queries and mutations to AppSync API.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">AppSync writes and reads primary data from DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">AppSync queries Elasticsearch for search and filtering functionality.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="0" id="0">
      <data key="d8">3</data>
      <data key="d9">AppSync pushes real-time article updates to users via MQTT protocol.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda indexes updated records into Elasticsearch.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB Streams trigger Lambda function on database mutations.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Dow Jones NewsGrid AWS Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=nt4lQx6tAI8</data>
    <data key="d2">Dow Jones powers its NewsGrid editorial platform using AWS AppSync, EC2, DynamoDB, Lambda, and Elasticsearch, achieving high availability and disaster recovery across AWS regions.</data>
    <data key="d3">Media &amp; Content Handling, Serverless &amp; Web Applications</data>
    <data key="d4">True</data>
  </graph>
