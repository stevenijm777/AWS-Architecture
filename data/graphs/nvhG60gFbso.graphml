<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ON PREMISES</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Customer on-premises data center running workloads needing secure access to JFrog Artifactory.</data>
    </node>
    <node id="1">
      <data key="d5">DIRECT CONNECT</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">AWS Direct Connect providing dedicated network connection from on-premises to AWS.</data>
    </node>
    <node id="2">
      <data key="d5">TRANSIT GATEWAY</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">AWS Transit Gateway interconnecting VPCs and on-premises network via Direct Connect.</data>
    </node>
    <node id="3">
      <data key="d5">PROD</data>
      <data key="d6">EC2</data>
      <data key="d7">Customer AWS production workload running on EC2.</data>
    </node>
    <node id="4">
      <data key="d5">VPC ENDPOINT</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">VPC Endpoint configured in customer VPC for private access.</data>
    </node>
    <node id="5">
      <data key="d5">VPC PRIVATELINK</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">AWS PrivateLink endpoint on the JFrog SaaS VPC side.</data>
    </node>
    <node id="6">
      <data key="d5">PUBLIC NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Public Network Load Balancer handling public internet requests to *.jfrog.io.</data>
    </node>
    <node id="7">
      <data key="d5">PRIVATE NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Private Network Load Balancer receiving traffic from PrivateLink.</data>
    </node>
    <node id="8">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS cluster hosting customer isolated namespaces running JFrog Artifactory.</data>
    </node>
    <node id="9">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS database storing artifact metadata.</data>
    </node>
    <node id="10">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 storing artifact binary layers (e.g., Docker layers).</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">On-premises traffic routed via Direct Connect.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Direct Connect routes traffic to Transit Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Direct Connect routes traffic to AWS production VPC workload.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Transit Gateway routes on-premises traffic to VPC Endpoint.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Production EC2 instances route traffic to VPC Endpoint.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">VPC Endpoint forwards requests across AWS PrivateLink to SaaS side.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">PrivateLink delivers requests into Private NLB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Public domain requests routed from Public NLB into EKS cluster namespace.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Private NLB routes traffic into EKS cluster customer namespace.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS retrieves artifact metadata from RDS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS fetches binary artifact layers from S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS metadata references binary objects stored in S3.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">JFrog SaaS Architecture with AWS PrivateLink</data>
    <data key="d1">https://www.youtube.com/watch?v=nvhG60gFbso</data>
    <data key="d2">Demonstrates public and private connectivity options to JFrog SaaS on AWS using PrivateLink, Direct Connect, and Transit Gateway for secure artifact management.</data>
    <data key="d3">DevOps, Security, Hybrid Cloud</data>
    <data key="d4">True</data>
  </graph>
</graphml>
