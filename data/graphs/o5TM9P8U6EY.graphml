<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Collection section: Captures domain query logs.</data>
    </node>
    <node id="1">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Collection section: Captures AWS API call logs.</data>
    </node>
    <node id="2">
      <data key="d5">VPC Flow Logs</data>
      <data key="d6">VPC</data>
      <data key="d7">Collection section: Captures network traffic logs.</data>
    </node>
    <node id="3">
      <data key="d5">GuardDuty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Detection section: Analyzes logs from Route 53, CloudTrail, and VPC for security anomalies.</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch (Detection)</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Detection section: Receives threat detection findings from GuardDuty.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Detection)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Detection section: Enriches security events using third-party IP lookups and formats alerts.</data>
    </node>
    <node id="6">
      <data key="d5">CloudWatch (Investigation)</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Investigation section: Collects CloudTrail logs for detailed post-event analysis.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Investigation)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Investigation section: Filters and decorates logs prior to indexing.</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Investigation section: Stores logs for querying and visualization via Kibana.</data>
    </node>
    <node id="9">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party chat platform used to send alerts directly to security engineers.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 domain query logs are streamed into GuardDuty.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudTrail API logs are streamed into GuardDuty.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudTrail logs are forwarded to CloudWatch Logs for investigation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">VPC flow logs are streamed into GuardDuty.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">GuardDuty generates findings and sends events to CloudWatch.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch triggers Lambda to process and enrich finding events.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda formats actionable alerts and posts them into Slack.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch Logs triggers Lambda to filter and decorate logs.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda streams decorated logs into Elasticsearch for analysis.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Bowtie Automated Security Detection and Investigation Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=o5TM9P8U6EY</data>
    <data key="d2">Automated security alerting and investigation system used by Bowtie on AWS. Collects logs across Route 53, CloudTrail, and VPC, evaluates them via GuardDuty, sends enriched alerts to Slack, and feeds investigation logs into Elasticsearch.</data>
    <data key="d3">Security Automation, Threat Detection, Log Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
