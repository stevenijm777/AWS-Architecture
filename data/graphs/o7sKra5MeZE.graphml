<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Verana</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Uploads QData modules specific to diseases or indicators to Amazon S3.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded QData modules.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Managed Workflows for Apache Airflow (Amazon MWAA)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Orchestrates data pipeline tasks from ingestion to staging and validation.</data>
    </node>
    <node id="3">
      <data key="d5">Staging</data>
      <data key="d6">RedShift</data>
      <data key="d7">Staging environment inside Redshift where raw datasets are initially loaded.</data>
    </node>
    <node id="4">
      <data key="d5">Validation</data>
      <data key="d6">RedShift</data>
      <data key="d7">Runs schema, primary/foreign key, and column data type validations taking up to 2-3 hours.</data>
    </node>
    <node id="5">
      <data key="d5">Production</data>
      <data key="d6">RedShift</data>
      <data key="d7">Production table holding validated QData ready for client sharing.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Serverless Amazon Redshift cluster hosting staging, validation, and production environments.</data>
    </node>
    <node id="7">
      <data key="d5">AWS Data Exchange</data>
      <data key="d6">DataExchange</data>
      <data key="d7">Single pane of glass for customer subscriptions to datasets updated bi-weekly.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Redshift Data Share</data>
      <data key="d6">RedShift</data>
      <data key="d7">Shares production table copies directly into customer Redshift instances.</data>
    </node>
    <node id="9">
      <data key="d5">Customer</data>
      <data key="d6">UserConsumerDeveloper</data>
      <data key="d7">Subscribes to and consumes datasets directly or via Redshift Data Share.</data>
    </node>
    <node id="10">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Receives alert notifications if validation subtasks fail.</data>
    </node>
    <node id="11">
      <data key="d5">de</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Data Engineering team notified via Slack alerts to fix dataset issues and trigger pipeline reruns.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Verana uploads QData modules into S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">MWAA triggers data reading from S3.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">MWAA loads datasets from S3 into Redshift Staging.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">MWAA triggers validation subtasks on Redshift.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Staged data is evaluated by validation workflows.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Successfully validated datasets are promoted to Production.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Validation failure triggers Slack alert.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Production datasets are registered on AWS Data Exchange with manual documentation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Amazon Redshift shares tables directly via Redshift Data Share.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Customers query/consume data from Redshift Data Share.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Slack alert notifies the Data Engineering team.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">DE team fixes data issues and reruns MWAA pipeline.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Verana Health AWS Data Ingestion and Sharing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=o7sKra5MeZE</data>
    <data key="d2">Faithful transcription of Verana Health's architectural whiteboard presentation.</data>
    <data key="d3">Data Engineering &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
