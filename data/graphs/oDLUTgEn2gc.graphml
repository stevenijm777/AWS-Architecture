<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End consumer accessing website content via Edge CDN.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Global CDN distribution serving single-tenant content at the edge.</data>
    </node>
    <node id="2">
      <data key="d5">ORIGIN REQUEST</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda@Edge function performing access security checks and SEO URL rewrites.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Single-tenant S3 bucket storing published website content.</data>
    </node>
    <node id="4">
      <data key="d5">ORIGIN RESPONSE</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda@Edge function formatting response headers and cache control headers.</data>
    </node>
    <node id="5">
      <data key="d5">crownpeak SaaS MULTI-TENANT</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Crownpeak multi-tenant SaaS content management platform.</data>
    </node>
    <node id="6">
      <data key="d5">COMPREHEND</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Amazon Comprehend used for entity extraction and sentiment analysis on text content.</data>
    </node>
    <node id="7">
      <data key="d5">REKOGNITION</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Amazon Rekognition used for visual media analysis, alt tag creation, and accessibility metadata enrichment.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests web content from CloudFront CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront invokes Origin Request Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Origin Request Lambda routes request to S3 origin bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 origin returns content payload to Origin Response Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Origin Response Lambda delivers processed response to CloudFront.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Crownpeak multi-tenant CMS directly publishes static web content into single-tenant S3 origin bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">CMS invokes Rekognition to generate image metadata and alt text.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">CMS invokes Comprehend for text sentiment analysis and taxonomy tag extraction.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Crownpeak Serverless CMS Content Delivery and Management Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=oDLUTgEn2gc</data>
    <data key="d2">Crownpeak decouples content management from content delivery. The multi-tenant CMS uses AI services like Comprehend and Rekognition for asset metadata enrichment, and directly publishes static web content into single-tenant AWS delivery environments composed of CloudFront, Lambda functions for origin request/response processing, and S3 origin storage.</data>
    <data key="d3">CMS, Serverless, Media &amp; Content Delivery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
