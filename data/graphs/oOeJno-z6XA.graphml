<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Transfer for SFTP</data>
      <data key="d6">TransferFamily</data>
      <data key="d7">SFTP endpoint used by content providers to upload raw media files.</data>
    </node>
    <node id="1">
      <data key="d5">S3 (Input)</data>
      <data key="d6">S3</data>
      <data key="d7">Input bucket storing raw ingested media and edited clips triggering the transcoding workflow.</data>
    </node>
    <node id="2">
      <data key="d5">Step Function</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the transcoding workflow, managing notification and transcoding tasks.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda (Notification)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Sends workflow updates and alerts to Slack.</data>
    </node>
    <node id="4">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party messaging channel for team alerts and monitoring.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives video timecode information for automated black-screen editing requests.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda (Clip Editor)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invoked by API Gateway to trigger MediaConvert for clip editing.</data>
    </node>
    <node id="7">
      <data key="d5">MediaConvert</data>
      <data key="d6">MediaConvert</data>
      <data key="d7">Performs accelerated 4K video transcoding with QPBR and automated clip editing.</data>
    </node>
    <node id="8">
      <data key="d5">S3 (Output)</data>
      <data key="d6">S3</data>
      <data key="d7">Output bucket storing transcoded media files ready for distribution.</data>
    </node>
    <node id="9">
      <data key="d5">Encoder</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises live hardware encoder streaming HLS content.</data>
    </node>
    <node id="10">
      <data key="d5">MediaStore</data>
      <data key="d6">MediaStore</data>
      <data key="d7">AWS Elemental MediaStore serving as high-performance origin for live streams.</data>
    </node>
    <node id="11">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN delivering both VOD content and live streams to end viewers.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SFTP server stores uploaded content into S3 Input bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 event triggers the Step Functions transcoding workflow.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions triggers notification Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions triggers MediaConvert transcoding job.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda posts status notifications to Slack channel.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway triggers Clip Editor Lambda with editing timecodes.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda instructs MediaConvert to perform automated clip editing.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">MediaConvert writes transcoded output files to S3 Output bucket.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">MediaConvert places edited video clip back into S3 Input bucket to restart transcoding pipeline.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="11" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 Output bucket serves transcoded VOD content via CloudFront CDN.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Hardware encoder streams live HLS content directly to MediaStore.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">MediaStore serves live video content to CloudFront CDN.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">PTS AWS Automated Media Transcoding and Live Streaming Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=oOeJno-z6XA</data>
    <data key="d2">Automated VOD transcoding pipeline using AWS Transfer Family, Step Functions, MediaConvert, and CloudFront, along with API Gateway-driven clip editing and MediaStore live streaming.</data>
    <data key="d3">Media &amp; Entertainment, Video Transcoding, Live Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
