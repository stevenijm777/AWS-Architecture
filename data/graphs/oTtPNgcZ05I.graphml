<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Data scientists and analysts requesting environment creation and data access.</data>
    </node>
    <node id="1">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Provides standard, automated environment templates triggered by ticket requests.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Automates template-driven deployment of isolated processing environments ('Bubbles').</data>
    </node>
    <node id="3">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Machine learning workspace running inside the isolated processing bubble.</data>
    </node>
    <node id="4">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query service provisioned within the processing bubble.</data>
    </node>
    <node id="5">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Kubernetes container service deployed in the processing environment for data workloads.</data>
    </node>
    <node id="6">
      <data key="d5">DataHub GUI</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom web application GUI for dataset discovery and requesting data access.</data>
    </node>
    <node id="7">
      <data key="d5">RedShift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehousing service in the persistent Data Hub layer.</data>
    </node>
    <node id="8">
      <data key="d5">Lake Formation</data>
      <data key="d6">LakeFormation</data>
      <data key="d7">Automates permissions, metadata management, and cross-account data sharing.</data>
    </node>
    <node id="9">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central object storage for immutable persistent datasets in the Data Hub.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User submits an environment request via ServiceNow which triggers AWS Service Catalog.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">User uses DataHub GUI to search the catalog and submit a data access request.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Service Catalog invokes CloudFormation template creation steps.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation provisions SageMaker into the new isolated bubble environment.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation provisions Athena into the new isolated bubble environment.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation provisions EKS cluster into the new isolated bubble environment.</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Approved requests trigger Lake Formation to configure cross-account dataset access.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 buckets are shared in read-only mode directly to the user's processing bubble.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Roche AWS Processing Bubble and Data Hub Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=oTtPNgcZ05I</data>
    <data key="d2">Roche's architecture pattern decouples permanent, compliant storage (Data Hub with S3, Redshift, Lake Formation) from temporary data science compute environments ('Bubbles' with SageMaker, Athena, EKS). Environments are provisioned automatically via ServiceNow, Service Catalog, and CloudFormation, followed by read-only data cross-sharing.</data>
    <data key="d3">Healthcare &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
