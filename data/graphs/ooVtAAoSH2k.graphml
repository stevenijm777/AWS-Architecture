<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2 (Customer)</data>
      <data key="d6">EC2</data>
      <data key="d7">Customer EC2 instance running the CrowdStrike sensor for endpoint security telemetry.</data>
    </node>
    <node id="1">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">AWS CloudTrail logging management events and API calls across regions.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing CloudTrail log files.</data>
    </node>
    <node id="3">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">SNS topic triggered when a new CloudTrail log file is written to the S3 bucket.</data>
    </node>
    <node id="4">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS queue storing log availability notifications for processing.</data>
    </node>
    <node id="5">
      <data key="d5">Cloud Connector (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">CrowdStrike metadata enrichment service running on EC2.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 lifecycle and activity events are logged by CloudTrail.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 bucket notification fires to SNS whenever new log files are delivered.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS publishes notifications to the SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Cloud Connector retrieves notification messages from SQS.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Cloud Connector directly fetches CloudTrail logs from customer S3 bucket for metadata enrichment.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">CrowdStrike AWS Cloud Connector Integration</data>
    <data key="d1">https://www.youtube.com/watch?v=ooVtAAoSH2k</data>
    <data key="d2">Architecture showing CrowdStrike's Cloud Connector ingesting and analyzing AWS CloudTrail logs from a customer account using S3, SNS, and SQS event notifications.</data>
    <data key="d3">Security &amp; Compliance, Log Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
