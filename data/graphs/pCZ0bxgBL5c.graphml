<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web interface where users upload resources and access 3D applications.</data>
    </node>
    <node id="1">
      <data key="d5">Mobile Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile device interface for accessing applications and uploading resources.</data>
    </node>
    <node id="2">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for APIs that routes incoming resource requests to appropriate Lambda functions.</data>
    </node>
    <node id="3">
      <data key="d5">Image Processing Lambdas</data>
      <data key="d6">Lambda</data>
      <data key="d7">A set of Lambda functions executing multi-step image optimization pipelines using Node.js, Python, or PHP.</data>
    </node>
    <node id="4">
      <data key="d5">3D Model Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function applying specific algorithms to optimize 3D models for interactive rendering.</data>
    </node>
    <node id="5">
      <data key="d5">RDS Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database used to store resource metadata. Migration to Aurora is planned for cloud-native scaling.</data>
    </node>
    <node id="6">
      <data key="d5">S3 Buckets</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage where processed image resources and 3D models are stored.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Web client sends API request for image resource processing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile client sends API request for image resource processing.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway dispatches request to image optimization Lambda functions.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway dispatches request to 3D model optimization Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Image processing Lambdas save metadata to RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Image processing Lambdas store optimized images in S3 bucket.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">3D model processing Lambda stores metadata in RDS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">3D model processing Lambda stores optimized 3D assets in S3.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">SceneSoftware Show in 3D Interactive Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=pCZ0bxgBL5c</data>
    <data key="d2">SceneSoftware platform enables users to create complex interactive 3D applications code-free, optimized for web, mobile, and desktop.</data>
    <data key="d3">Media &amp; Entertainment, Serverless, Data Processing</data>
    <data key="d4">True</data>
  </graph>
