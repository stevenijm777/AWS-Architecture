<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Lambda 1</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles messaging and processing requests coming from the front-end application via API Gateway.</data>
    </node>
    <node id="1">
      <data key="d5">Chime</data>
      <data key="d6">Chime</data>
      <data key="d7">Handles real-time audio/video meetings, TURN services, and WebRTC media streams via Chime SDK.</data>
    </node>
    <node id="2">
      <data key="d5">SQS 1</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives real-time event notifications from Chime (joins, leaves, mic toggles, etc.).</data>
    </node>
    <node id="3">
      <data key="d5">S3 1</data>
      <data key="d6">S3</data>
      <data key="d7">Stores archived event logs for post-event attendee interaction analytics.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB 1</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Serves as a real-time session store to manage active meeting state.</data>
    </node>
    <node id="5">
      <data key="d5">SQS 2</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues recording trigger messages initiated when hosts start recording.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda 2</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by SQS 2 to spawn container task instances on AWS Fargate.</data>
    </node>
    <node id="7">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs ECS containers with a virtual browser and FFmpeg encoding to record and process meeting video.</data>
    </node>
    <node id="8">
      <data key="d5">DynamoDB 2</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Tracks and manages container state lifecycle (spawn, running, teardown).</data>
    </node>
    <node id="9">
      <data key="d5">S3 2</data>
      <data key="d6">S3</data>
      <data key="d7">Stores completed recorded video files for video-on-demand playback.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda invokes Chime SDK to create meeting sessions and add attendees.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Chime reads and updates active meeting session state stored in DynamoDB 1.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Chime emits event notifications to SQS 1.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Chime triggers SQS 2 when a host requests to record the meeting.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Event messages from SQS 1 are stored in S3 1 for analytics.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS 2 triggers Lambda 2 to process the recording workflow.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda 2 spawns ECS container tasks in Fargate.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Fargate updates and tracks container state in DynamoDB 2.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Fargate exports finalized MP4/video files to S3 2 for playback.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Aventry Virtual Events Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=pZ7Lr94noLo</data>
    <data key="d2">Architecture for Aventry virtual events using AWS Chime SDK for real-time meetings and Fargate container instances for video recording rendering.</data>
    <data key="d3">Media &amp; Entertainment, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
