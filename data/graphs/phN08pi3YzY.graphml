<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Fully managed Application Load Balancer handling incoming web and payment requests</data>
    </node>
    <node id="1">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs serverless containerized payment applications without requiring EC2 instance management</data>
    </node>
    <node id="2">
      <data key="d5">SSM Parameter Store</data>
      <data key="d6">SystemsManager</data>
      <data key="d7">Stores configuration data, API endpoints, and sensitive credentials</data>
    </node>
    <node id="3">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Provides encryption and decryption keys for parameters stored in SSM</data>
    </node>
    <node id="4">
      <data key="d5">GuardDuty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Provides intelligent threat detection and security monitoring for PCI compliance</data>
    </node>
    <node id="5">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Captures operational API activity and audit logs for PCI DSS compliance</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes payment requests to Fargate application containers</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Fargate requests configuration and secret parameters from SSM Parameter Store</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">API calls and administrative activity are recorded in CloudTrail</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Container activity and network security events are monitored by GuardDuty</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">SSM Parameter Store uses KMS keys to decrypt sensitive secrets for Fargate</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Fiverr PCI DSS Compliant Payment Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=phN08pi3YzY</data>
    <data key="d2">Fiverr simplified its PCI DSS Level 1 architecture by replacing self-managed servers and security tooling with serverless compute (Fargate), managed load balancing (ALB), parameter encryption (SSM and KMS), and automated threat monitoring (GuardDuty and CloudTrail).</data>
    <data key="d3">Security, Compute, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
