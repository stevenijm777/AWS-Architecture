    <node id="5">
      <data key="d5">FluentBit</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">FluentBit sidecar container in ECS task definition for processing Fargate logs</data>
    </node>
    <node id="6">
      <data key="d5">OpenSearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Centralized search and indexing solution for all application logs</data>
    </node>
    <node id="7">
      <data key="d5">Okta</data>
      <data key="d6">ThirdParty</data>
