<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ELB (Region 1)</data>
      <data key="d6">ELB</data>
      <data key="d7">Edge Load Balancer in Region 1 receiving initial user request.</data>
    </node>
    <node id="1">
      <data key="d5">ECS (Region 1)</data>
      <data key="d6">ECS</data>
      <data key="d7">Edge container service running web application and certificate consumer worker.</data>
    </node>
    <node id="2">
      <data key="d5">ElastiCache (Region 1)</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory cache storing downloaded SSL certificates for edge SSL handshakes.</data>
    </node>
    <node id="3">
      <data key="d5">SQS (Region 1)</data>
      <data key="d6">SQS</data>
      <data key="d7">Subscribed to central SNS topic to receive new certificate notifications.</data>
    </node>
    <node id="4">
      <data key="d5">ELB (Region 2)</data>
      <data key="d6">ELB</data>
      <data key="d7">Edge Load Balancer in Region 2.</data>
    </node>
    <node id="5">
      <data key="d5">ECS (Region 2)</data>
      <data key="d6">ECS</data>
      <data key="d7">Edge container service running in Region 2.</data>
    </node>
    <node id="6">
      <data key="d5">ElastiCache (Region 2)</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory cache storing downloaded SSL certificates in Region 2.</data>
    </node>
    <node id="7">
      <data key="d5">SQS (Region 2)</data>
      <data key="d6">SQS</data>
      <data key="d7">Subscribed to central SNS topic in Region 2 for plug-and-play fanout.</data>
    </node>
    <node id="8">
      <data key="d5">ELB (Main Region)</data>
      <data key="d6">ELB</data>
      <data key="d7">Main Region Load Balancer routing cross-region verification requests.</data>
    </node>
    <node id="9">
      <data key="d5">EC2 (Main Region)</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts Certificate Manager which orchestrates domain validation and issuance.</data>
    </node>
    <node id="10">
      <data key="d5">SNS (Main Region)</data>
      <data key="d6">SNS</data>
      <data key="d7">Central topic publishing certificate updates globally across edge regions.</data>
    </node>
    <node id="11">
      <data key="d5">RDS (Main Region)</data>
      <data key="d6">RDS</data>
      <data key="d7">Central database storing domain and certificate metadata.</data>
    </node>
    <edge source="0" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Proxies domain verification request from Region 1 ELB to Main Region ELB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Region 1 SQS passes consumed certificate message to ECS consumer instance.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Main Region ELB forwards verification proxy request to Certificate Manager on EC2.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Certificate Manager publishes new certificate data to central SNS topic.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS fans out certificate message to SQS queue in Region 1.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS fans out certificate message to SQS queue in Region 2.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Strikingly - Multi-Region Custom Domain SSL Certificate Management and Distribution</data>
    <data key="d1">https://www.youtube.com/watch?v=plce6pRdx6o</data>
    <data key="d2">Strikingly's global multi-region architecture for managing and dynamically distributing SSL certificates for tens of thousands of custom user domains using AWS SNS, SQS, ECS, and EC2 Certificate Manager.</data>
    <data key="d3">Compute, Networking, Security, Messaging</data>
    <data key="d4">True</data>
  </graph>
</graphml>
