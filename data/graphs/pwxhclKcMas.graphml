<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Ingestion stream receiving all system events (creates, updates, deletes) from Depop services.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">In-house fan-out Lambda function optimized to handle hundreds of thousands of peak invocations.</data>
    </node>
    <node id="2">
      <data key="d5">Multiple Kinesis Streams</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Topic-separated streams used to categorize event data for downstream Glue processing.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores both raw JSON event data and processed Parquet data in S3 buckets under distinct key spaces.</data>
    </node>
    <node id="4">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Runs ETL jobs to perform data normalization, resolve type mismatches, and convert JSON to Parquet format.</data>
    </node>
    <node id="5">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Executes SQL queries on Parquet data in S3 to prepare datasets for the recommendation engine.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda (Scheduler)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Schedules and orchestrates the recommendation pipeline every 4 to 5 hours.</data>
    </node>
    <node id="7">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Spins up EMR cluster post-query completion to calculate product/user rankings and scores.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Services send user actions and system events into the primary Kinesis stream.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Fan-out Lambda fans out incoming events into distinct topic-based Kinesis streams.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Topic streams write raw JSON data to S3 under specific key paths.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue ETL jobs read raw JSON, normalize schema, and write Athena-optimized Parquet data back to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries normalized Parquet datasets stored in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena query completion triggers the spin-up of an EMR cluster to perform scoring algorithms.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda scheduler triggers Athena SQL query execution on a schedule.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Depop Data Architecture and Recommendation Engine</data>
    <data key="d1">https://www.youtube.com/watch?v=pwxhclKcMas</data>
    <data key="d2">Architecture diagram detailing Depop's event-driven data ingestion pipeline and product recommendation engine leveraging AWS Kinesis, Lambda, Glue, S3, Athena, and EMR.</data>
    <data key="d3">analytics, data_pipeline, serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
