  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Batch user accessing the Web UI to upload claim files for FWA analysis.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Delivers the Web UI frontend for file upload and dashboard analysis.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded batch claim files and notifies Step Functions.</data>
    </node>
    <node id="3">
      <data key="d5">AWS WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Web application firewall protecting the Web UI component.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates batch processing workflows upon file upload.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs containerized ML models on-demand for batch claims FWA processing.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends completion notifications to users once batch processing finishes.</data>
    </node>
    <node id="7">
      <data key="d5">Integration Systems</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External client systems sending real-time API requests using API keys.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes REST API endpoints with usage plans for real-time claims analysis.</data>
    </node>
    <node id="9">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes the containerized ML model for real-time claims evaluation within 15-minute execution limits.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Multi-tenant database storing claims results isolated by dedicated per-client schemas.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User logs into Web UI and uploads batch claim files.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Web UI stores uploaded file into Amazon S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 upload event triggers AWS Step Functions orchestration.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions invokes AWS Fargate task running containerized ML model.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate writes processed batch claim FWA results into RDS client schema.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate triggers completion notification via Amazon SES upon task completion.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SES sends completion notification update back to Web UI dashboard.</data>
      <data key="d10">6</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Integration systems send real-time claim JSON payloads via REST API using API keys.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway forwards REST request to AWS Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway returns evaluation results back to client integration system.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda runs containerized ML model and stores claim analysis in client RDS schema.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda returns real-time FWA evaluation response back through API Gateway.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">IDA Technologies - Fraud Waste Abuse (FWA) as a Service Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=q7nwPQ7XLJI</data>
    <data key="d2">SaaS architecture for Fraud Waste Abuse (FWA) detection using AWS Fargate for batch container execution, AWS Lambda for real-time claim evaluation, and Amazon RDS with tenant schema isolation.</data>
    <data key="d3">Machine Learning, Serverless, Batch Processing, Real-Time API</data>
    <data key="d4">True</data>
  </graph>
