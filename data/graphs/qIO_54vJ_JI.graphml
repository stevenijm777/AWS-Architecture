<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users (Agents &amp; Clients)</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Insurance loss adjusters (agents) and clients connecting via mobile/web apps.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 (OpenVideo Hosting)</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts the OpenVideo platform running WebRTC server and recording upload scripts.</data>
    </node>
    <node id="2">
      <data key="d5">S3 (Raw Storage)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded raw video recordings.</data>
    </node>
    <node id="3">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers S3 upload event notifications for downstream container processing.</data>
    </node>
    <node id="4">
      <data key="d5">ECS Fargate Processing Tasks</data>
      <data key="d6">Fargate</data>
      <data key="d7">Auto-scaling Fargate containers running FFMPEG to process video files into HLS format.</data>
    </node>
    <node id="5">
      <data key="d5">S3 (Processed Storage)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores encoded HLS video files for dynamic playback review.</data>
    </node>
    <node id="6">
      <data key="d5">S3 Glacier</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term cost-effective archive storage for raw video recordings.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Agents and clients establish WebRTC video streams to OpenVideo on EC2.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Script on EC2 uploads raw video recording files to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 raw video upload triggers event notification message to SQS.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Fargate tasks poll SQS queue based on auto-scaling queue depth metrics.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Fargate uploads processed HLS encoded video files into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lifecycle policy transitions long-term archival recordings to S3 Glacier.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Lancome Technology Insurance Video Conferencing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=qIO_54vJ_JI</data>
    <data key="d2">Architecture for streaming, recording, processing, and archiving video calls between loss adjusters and insurance clients.</data>
    <data key="d3">Media &amp; Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
