<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Uses latency-based routing policies across multiple AWS regions to minimize latency.</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing room creation and API requests to backend API servers.</data>
    </node>
    <node id="2">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Content Delivery Network delivering live audio streams to listeners.</data>
    </node>
    <node id="3">
      <data key="d5">Chatting Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Manages live chat rooms and handles messaging via ElastiCache Pub/Sub.</data>
    </node>
    <node id="4">
      <data key="d5">API Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Handles API requests for room creation, user interactions, and feeds.</data>
    </node>
    <node id="5">
      <data key="d5">Streaming Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Deployed across multiple regions to handle real-time live audio streaming.</data>
    </node>
    <node id="6">
      <data key="d5">NGINX Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Proxies live audio streams from CloudFront based on dynamic routing metadata.</data>
    </node>
    <node id="7">
      <data key="d5">ELASTICACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">ElastiCache Redis used for real-time ranking data, chat Pub/Sub, and dynamic streaming routing metadata.</data>
    </node>
    <node id="8">
      <data key="d5">RDS AURORA</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores primary user interaction and room metadata for personalized recommendations.</data>
    </node>
    <node id="9">
      <data key="d5">DOCUMENT DB</data>
      <data key="d6">DocumentDB</data>
      <data key="d7">Stores user activity behavior data used alongside Aurora to build personalized feeds.</data>
    </node>
    <node id="10">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded user content including background images.</data>
    </node>
    <node id="11">
      <data key="d5">AWS LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered on S3 image uploads to invoke content moderation analysis.</data>
    </node>
    <node id="12">
      <data key="d5">REKOGNITION CONTENT MODERATION</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Analyzes uploaded background images to detect and filter inappropriate content.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes incoming requests to ALB using latency-based routing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards room creation requests to API Server.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront routes live streaming requests to backend NGINX Server.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Chatting Server processes real-time messaging using ElastiCache Redis Pub/Sub.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Chatting Server stores background images uploaded by DJs into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API Server requests Chatting Server to create a chat room.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">API Server requests allocation of a Streaming Server.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">API Server stores room metadata in RDS Aurora.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">API Server logs user behavior data in DocumentDB.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">API Server updates real-time ranking data in ElastiCache Redis.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Streaming Server queries and syncs dynamic routing info with ElastiCache Redis.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">NGINX Server queries ElastiCache Redis for dynamic routing metadata.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">NGINX Server proxies stream traffic to assigned Streaming Server.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 triggers AWS Lambda upon image upload.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">AWS Lambda invokes Rekognition Content Moderation to inspect images.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Spoon Radio Real-Time Audio Streaming Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=qL3hDtrTeLs</data>
    <data key="d2">Spoon Radio utilizes Route 53 for latency-based multi-region routing, ALB/CloudFront for entry points, EC2 clusters for API, Chatting, Streaming, and NGINX servers, ElastiCache Redis for ranking/pub-sub/dynamic routing metadata, RDS Aurora and DocumentDB for personalized recommendations, and S3 + Lambda + Rekognition for automated content moderation.</data>
    <data key="d3">Audio Streaming, Dynamic Routing, Content Moderation, Global Infrastructure</data>
    <data key="d4">True</data>
  </graph>
</graphml>
