  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Sends syslog messages from instances to Kinesis Data Firehose.</data>
    </node>
    <node id="1">
      <data key="d5">Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams syslog messages directly into Amazon S3.</data>
    </node>
    <node id="2">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Delivers AWS API and management audit logs directly into Amazon S3.</data>
    </node>
    <node id="3">
      <data key="d5">3rd Party Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External third-party services generating log events.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda Collection</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms third-party log data before storing it in S3.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central log retention store with S3 Lifecycle policies for cost optimization (~330M logs / 270 GB).</data>
    </node>
    <node id="6">
      <data key="d5">Lambda Analysis Top</data>
      <data key="d6">Lambda</data>
      <data key="d7">Performs near real-time analysis and sends alerts (e.g., Slack notifications).</data>
    </node>
    <node id="7">
      <data key="d5">Lambda Analysis Middle</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes S3 logs for ingestion into search and visualization tools.</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Indexes log data for search capabilities via Graylog / Elasticsearch.</data>
    </node>
    <node id="9">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Performs direct ad-hoc SQL queries on long-term log data stored in S3.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 sends syslogs to Firehose.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose writes log stream to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudTrail delivers audit logs directly to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Third-party service triggers Lambda function for log ingestion.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda Collection writes transformed third-party logs to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">New log object in S3 triggers Lambda for real-time alert processing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">New log object in S3 triggers Lambda for indexing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">5</data>
      <data key="d9">Athena queries raw log data stored in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">4</data>
      <data key="d9">Lambda forwards log data to Elasticsearch/OpenSearch.</data>
