  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">PRODUCTION</data>
      <data key="d6">UserCompanyEdge</data>
      <data key="d7">Field control systems and edge devices in oil and gas production.</data>
    </node>
    <node id="1">
      <data key="d5">MSK</data>
      <data key="d6">MSK</data>
      <data key="d7">Managed Streaming for Apache Kafka, managing inbound raw sensor streams and outbound parsed topics.</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Scheduled Lambda function triggering EMR Spark processing jobs every minute.</data>
    </node>
    <node id="3">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR cluster running Spark parser and OpenTSDB on HBase for time-series processing.</data>
    </node>
    <node id="4">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances running ML model execution engines, rule evaluation engine (50k+ rules/min), and web application.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket serving as persistent underlying storage for OpenTSDB time-series database.</data>
    </node>
    <node id="6">
      <data key="d5">DATABASE</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL database containing equipment contextual metadata and digital twin configurations.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Edge devices stream raw sensor data via MQTT to MSK Kafka topic.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">MSK event state triggers Lambda function execution.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Spark job on EMR consumes raw message streams from MSK topic.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda invokes Spark parsing job on the EMR cluster.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR parser writes cleaned and validated data back to a separate MSK Kafka topic.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR writes structured time-series data to S3 via OpenTSDB.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 instances read historical data from EMR/S3 for model evaluation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Closed-loop feedback writes set point predictions back to production control systems.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 fetches equipment digital twin and contextual metadata from PostgreSQL database.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Flutura Industrial IoT and ML Predictive Maintenance Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=q_5U7z_vNug</data>
    <data key="d2">Architecture ingests ~1 billion records per day from oil and gas production field control systems, evaluating over 50,000 rules per minute for anomaly prediction and closed-loop control.</data>
    <data key="d3">IoT, Machine Learning, Big Data Analytics</data>
    <data key="d4">True</data>
  </graph>
