<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">User accessing Hancom Space services.</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer routing incoming client traffic.</data>
    </node>
    <node id="2">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Main application server handling file processing, thumbnail creation, and business logic.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage for user files and generated thumbnail previews.</data>
    </node>
    <node id="4">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Managed relational database storing metadata with 6-copy replication across 3 Availability Zones.</data>
    </node>
    <node id="5">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Managed cache storing user session data to offload database traffic.</data>
    </node>
    <node id="6">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Centralized log management for aggregated monitoring across instances.</data>
    </node>
    <node id="7">
      <data key="d5">Auto Scaling</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Automatically scales application EC2 compute capacity.</data>
    </node>
    <node id="8">
      <data key="d5">EC2 Spot</data>
      <data key="d6">EC2</data>
      <data key="d7">Spot compute instances used for cost minimization.</data>
    </node>
    <node id="9">
      <data key="d5">EC2 (Right Top)</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute worker instance.</data>
    </node>
    <node id="10">
      <data key="d5">EC2 (Right Bottom)</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute worker instance.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">User interacts with the service and uploads files.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Main EC2 stores uploaded files and thumbnails in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Main EC2 writes metadata information to Aurora database.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Main EC2 reads and writes session state from ElastiCache.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Instance logs are pushed to Elasticsearch for centralized troubleshooting.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Hancom Space Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=qgW8LQ8iBuA</data>
    <data key="d2">Hancom Space uses AWS managed services including S3, Aurora DB, ElastiCache, and Elasticsearch to safely store user files, metadata, and session data while maintaining high availability and centralized log monitoring.</data>
    <data key="d3">Storage &amp; Content Delivery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
