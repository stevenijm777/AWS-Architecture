<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Application</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile client streaming workflow analytics and user tracking data from on-ground field forces.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Kinesis</data>
      <data key="d6">Firehose</data>
      <data key="d7">Ingests high-volume streaming data from mobile applications, backs up raw streams to S3, and routes payloads to ingestion Lambda and S3 Data Lake.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon S3 (Backup)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw data stream backups natively pushed from Amazon Kinesis.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda (Ingestion)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Parses aggregated data payloads from Kinesis and feeds them to the Step Functions state machine.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates state machine logic for modular workflow rules configured on the web application.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Simple Notification Service (Amazon SNS)</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends alerts (email, SMS, app prompts) to users when business metric thresholds are breached.</data>
    </node>
    <node id="6">
      <data key="d5">AWS Lambda (Workflow Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes workflow tasks triggered by Step Functions and persists outcome data in Amazon RDS.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3 (Data Lake)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores aggregated, compressed Apache Parquet format data (up to 90% compression) for analytics.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Crawls, classifies, and catalogs Parquet datasets stored in the S3 Data Lake.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Executes serverless, on-demand SQL queries against the Glue catalog and S3 Data Lake.</data>
    </node>
    <node id="10">
      <data key="d5">Web Application For Dashboards and Reporting</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web interface used by administrators to configure workflows, journey plans, and view analytical reports.</data>
    </node>
    <node id="11">
      <data key="d5">Amazon Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">DNS service handling domain routing for the web application.</data>
    </node>
    <node id="12">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry API layer fronting web client communications to backend microservices.</data>
    </node>
    <node id="13">
      <data key="d5">AWS Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Executes complex, long-running backend jobs like image processing and data validations.</data>
    </node>
    <node id="14">
      <data key="d5">AWS Lambda (Backend Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles short-running transactional API requests (add, update, delete operations).</data>
    </node>
    <node id="15">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database storing core transactional application data.</data>
    </node>
    <node id="16">
      <data key="d5">Amazon ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory caching layer for fast session management and user permissions, handling up to 1M concurrent users at peak load.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile application streams live telemetry and tracking data to Kinesis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis natively backs up raw incoming streaming data into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis aggregates data batches and triggers ingestion Lambda.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis consolidates and streams data in Parquet format to the S3 Data Lake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion Lambda parses aggregated payloads into Step Functions state machine.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions triggers SNS alerts when metric threshold breaches are detected.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions invokes downstream workflow processing Lambda.</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="15" id="0">
      <data key="d8">0</data>
      <data key="d9">Workflow Lambda persists processed relational data to Amazon RDS.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue crawls and catalogs metadata from S3 Data Lake files.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue catalog metadata is exposed to Amazon Athena for querying.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Web application queries Athena on-demand to populate reporting dashboards.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Web app requests resolve through Route 53 DNS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">Route 53 routes web application traffic to API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="12" target="13" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway routes long-running tasks to AWS Fargate.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="12" target="14" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway routes short-running transactional requests to backend Lambda.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="14" target="15" id="0">
      <data key="d8">2</data>
      <data key="d9">Backend Lambda reads and writes operational transactional data to Amazon RDS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="14" target="16" id="0">
      <data key="d8">2</data>
      <data key="d9">Backend Lambda uses ElastiCache to manage high-concurrency sessions and permissions.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Sales Flow Engage Serverless Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=qi017F1UwvM</data>
    <data key="d2">Sales Flow Engage utilizes a serverless AWS architecture to manage on-ground operations, workflow customization, real-time alerts, dynamic data lake analytics, and web platform management.</data>
    <data key="d3">Serverless, Data Lake, Operations Management</data>
    <data key="d4">True</data>
  </graph>
