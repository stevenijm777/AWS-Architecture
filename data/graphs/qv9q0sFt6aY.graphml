<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">TRAFFIC DB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises or external database storing traffic logs in Avro format.</data>
    </node>
    <node id="1">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">AWS DynamoDB storing nested operational data.</data>
    </node>
    <node id="2">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">AWS Relational Database Service used as a transactional data source.</data>
    </node>
    <node id="3">
      <data key="d5">REDSHIFT (Source)</data>
      <data key="d6">RedShift</data>
      <data key="d7">Source Redshift cluster providing source analytics data.</data>
    </node>
    <node id="4">
      <data key="d5">ELASTIC SEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Elasticsearch cluster storing search logs and unstructured data.</data>
    </node>
    <node id="5">
      <data key="d5">DW ON-PREM</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises enterprise data warehouse ingested directly into Glue.</data>
    </node>
    <node id="6">
      <data key="d5">DATALAKE</data>
      <data key="d6">S3</data>
      <data key="d7">Central S3 Data Lake storing raw, intermediate Avro, and converted Parquet files.</data>
    </node>
    <node id="7">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">AWS Glue utilizing Spark and Python shell jobs for ETL transformations.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Auxiliary S3 storage bucket supporting Glue ETL pipelines.</data>
    </node>
    <node id="9">
      <data key="d5">REDSHIFT (Target)</data>
      <data key="d6">RedShift</data>
      <data key="d7">Target Redshift warehouse using Redshift Spectrum and stored procedures.</data>
    </node>
    <node id="10">
      <data key="d5">BI EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance hosting BI reporting tool providing insights to web/mobile users.</data>
    </node>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Traffic DB streams data to DATALAKE.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB operational data ingested into DATALAKE.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS data ingested into DATALAKE.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Source Redshift data ingested into DATALAKE.</data>
      <data key="d10">0'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Elasticsearch data ingested into DATALAKE.</data>
      <data key="d10">0''''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">On-prem DW data directly ingested by Glue.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue reads raw data from DATALAKE.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue writes processed Parquet files back to DATALAKE.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue pushes transformed data into target Redshift warehouse.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue accesses auxiliary S3 storage resources.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift interacts bi-directionally with Glue metastore/ETL.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Target Redshift serves processed data to BI EC2 instance.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Lotte ON BI Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=qv9q0sFt6aY</data>
    <data key="d2">Architecture of Lotte ON BI platform collecting structured and unstructured data across multiple sources, processing via AWS Glue and Redshift Spectrum, and serving analytical insights via BI EC2.</data>
    <data key="d3">Data Analytics, Business Intelligence</data>
    <data key="d4">True</data>
  </graph>
</graphml>
