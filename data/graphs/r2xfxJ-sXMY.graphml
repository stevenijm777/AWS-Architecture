  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile app entrypoint generating conversation metadata.</data>
    </node>
    <node id="1">
      <data key="d5">Web</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web browser interface generating conversation metadata.</data>
    </node>
    <node id="2">
      <data key="d5">Messaging Platforms</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Messaging channels including WhatsApp, Facebook, and Twitter.</data>
    </node>
    <node id="3">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Central streaming data store ingesting conversation metadata across all channels.</data>
    </node>
    <node id="4">
      <data key="d5">Logstash</data>
      <data key="d6">EC2</data>
      <data key="d7">Self-managed Logstash compute layer pulling stream data, transforming payloads, and indexing to Elasticsearch.</data>
    </node>
    <node id="5">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Multi-AZ Elasticsearch cluster for real-time indexing and search.</data>
    </node>
    <node id="6">
      <data key="d5">Dashboard</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom in-house real-time analytics dashboard accessible to internal teams and clients.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by Kinesis events to process conversation batch records for archival.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake storage for multi-year historical chatbot data.</data>
    </node>
    <node id="9">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Extracts schema and updates data catalog for S3 historical storage.</data>
    </node>
    <node id="10">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL query engine using Glue catalog schema to analyze historical data in S3.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile client sends conversation metadata to Kinesis stream.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Web client sends conversation metadata to Kinesis stream.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Messaging platform channels send conversation metadata to Kinesis stream.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Logstash pulls real-time conversation data stream from Kinesis.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis triggers Lambda function upon event arrival for historical pipeline processing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Logstash transforms and indexes data into Elasticsearch.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Custom dashboard queries real-time metrics and conversation trends from Elasticsearch.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda processes batch data and stores it long term in S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue crawls S3 storage to define catalog schema.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue catalog provides schema definition to Amazon Athena for querying S3.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Haptik Conversational AI Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=r2xfxJ-sXMY</data>
    <data key="d2">Haptik processes over 40-50 million chat and voice messages monthly across channels (Web, Mobile, WhatsApp, Facebook, Twitter). Metadata streams into Kinesis and splits into real-time analytics (Logstash, Elasticsearch, Custom Dashboard) and historical batch archival (Lambda, S3, Glue, Athena).</data>
    <data key="d3">Analytics, Streaming, Data Archival</data>
    <data key="d4">True</data>
  </graph>
