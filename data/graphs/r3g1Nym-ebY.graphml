<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS Organizations</data>
      <data key="d6">Organizations</data>
      <data key="d7">Central governance service used to manage baseline stack sets across 1,400+ AWS accounts.</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Represents production, dev, and staging workloads running across workload accounts.</data>
    </node>
    <node id="2">
      <data key="d5">AWS IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Handles user governance, SAML login, and access recertification.</data>
    </node>
    <node id="3">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs Red Hat SSO (Bifrost) on ECS/Fargate container cluster.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Config</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">Tracks resource changes across all 1,400+ accounts for compliance reporting.</data>
    </node>
    <node id="5">
      <data key="d5">Inspector</data>
      <data key="d6">Inspector</data>
      <data key="d7">Scans EC2 instances and containers across accounts for vulnerabilities (e.g. Log4j).</data>
    </node>
    <node id="6">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Centralizes audit logging from all accounts into the dedicated auditing account.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Organizations manages baseline configurations in Workload accounts.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Organizations manages governance policies for identity and access in SSO Bifrost.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Organizations applies compliance baselines and Config rules centrally.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Organizations routes audit logging from all accounts into CloudTrail.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">SAML federation authentication allowing developers to log into workload accounts.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Volkswagen Financial Services Multi-Account Landing Zone Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=r3g1Nym-ebY</data>
    <data key="d2">Shows a centralized landing zone structure managing 1,400+ AWS accounts, with dedicated accounts for Workloads, SSO, Compliance, and Auditing.</data>
    <data key="d3">Governance &amp; Compliance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
