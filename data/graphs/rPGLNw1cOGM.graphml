  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Material Scientists User</data>
      <data key="d6">UserCompanyDomainExpert</data>
      <data key="d7">Over 8,000 scientists in labs across 50 countries requesting material property data via web browser.</data>
    </node>
    <node id="1">
      <data key="d5">Business Analysts User</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Business analysts requiring programmatic API access to material information.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Amazon CloudFront content delivery network providing global entry point for web and API requests.</data>
    </node>
    <node id="3">
      <data key="d5">Auth Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Central authorization Lambda function that validates incoming JWT tokens and performs access checks.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB AUTHZ</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB table storing material UUIDs, user IDs, and fine-grained access level bitmasks.</data>
    </node>
    <node id="5">
      <data key="d5">Remix Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Monolithic Node.js application running Remix SSR for rendering scientist UI.</data>
    </node>
    <node id="6">
      <data key="d5">GraphQL Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function running GraphQL engine to handle programmatic queries from business analysts.</data>
    </node>
    <node id="7">
      <data key="d5">Aurora Database</data>
      <data key="d6">Aurora</data>
      <data key="d7">Amazon Aurora PostgreSQL database storing all 3M material data.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Material Scientists send web browser requests with JWT tokens via CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Business Analysts send programmatic API requests via CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront routes user request to central Auth Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="1">
      <data key="d8">1</data>
      <data key="d9">CloudFront forwards API request to Auth Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Auth Lambda queries DynamoDB AUTHZ to check user permissions and material UUID bitmask.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="1">
      <data key="d8">1</data>
      <data key="d9">Auth Lambda queries DynamoDB AUTHZ for access permissions.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Auth Lambda forwards authorized web request to Remix Lambda UI handler.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Auth Lambda forwards authorized programmatic request to GraphQL Lambda.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB AUTHZ returns authorization decision to Auth Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="1">
      <data key="d8">1</data>
      <data key="d9">DynamoDB AUTHZ returns bitmask authorization metadata.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Remix Lambda queries Aurora database for requested material attributes.</data>
      <data key="d10">5</data>
