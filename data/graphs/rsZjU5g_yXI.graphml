<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Generates Syslog messages collected by Fluentd agent.</data>
    </node>
    <node id="1">
      <data key="d5">FIREHOSE</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers and streams Syslog data into S3.</data>
    </node>
    <node id="2">
      <data key="d5">CLOUDTRAIL</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Directly delivers AWS audit logs into S3.</data>
    </node>
    <node id="3">
      <data key="d5">3RD PARTY SERVICE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External service providing security logs.</data>
    </node>
    <node id="4">
      <data key="d5">LAMBDA (Collection)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Ingests logs from 3rd party service and saves them to S3.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central log repository. Stores ~330M logs (~270 GB) daily without schema constraints. Retention managed via S3 Lifecycle policies.</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA (Alerts)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Scans logs for short-term alerting and sends notifications to Slack.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA (Search)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Forwards processed logs to Graylog for medium/long-term search capabilities.</data>
    </node>
    <node id="8">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Amazon Elasticsearch Service serving as the backend engine for Graylog.</data>
    </node>
    <node id="9">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries raw historical log data stored in S3 for long-term auditing.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 sends Syslog messages to Kinesis Data Firehose using Fluentd.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose delivers aggregated logs to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudTrail directly writes audit logs to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Third-party service delivers log data to Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda saves third-party log data into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">S3 feeds or triggers Lambda for real-time alert processing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">S3 delivers log data to Lambda for search indexing preparation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">5</data>
      <data key="d9">Athena queries raw historical logs stored directly in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">4</data>
      <data key="d9">Lambda forwards log data to Graylog / Elasticsearch backend.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cookpad Security Log Monitoring Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=rsZjU5g_yXI</data>
    <data key="d2">Processes ~330M logs/day (~270 GB) at a Lambda cost of ~$2/day. Eliminates strict log schema requirements upon collection by storing raw logs directly in S3.</data>
    <data key="d3">Security, Log Analytics, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
