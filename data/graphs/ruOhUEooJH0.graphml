  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">External Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">External portal clients accessing Cloud Admin Portal features.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN entry point serving static frontend view assets.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Distributes API traffic to backend components.</data>
    </node>
    <node id="3">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Serverless container compute host for microservices (auth, portal, billing).</data>
    </node>
    <node id="4">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Redis cluster storing session and shared role/permission data across Fargate containers.</data>
    </node>
    <node id="5">
      <data key="d5">RDS Aurora</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational MySQL-compatible database for CAP persistent storage.</data>
    </node>
    <node id="6">
      <data key="d5">Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Dedicated hybrid network connection to on-premises datacenters.</data>
    </node>
    <node id="7">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs built-in PCA and RCF algorithms along with custom algorithms for AI analytics.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake object store holding telemetry and analytics data.</data>
    </node>
    <node id="9">
      <data key="d5">External Data Source</data>
      <data key="d6">RDS</data>
      <data key="d7">External BSS and OSS telemetry data sources feeding the Cloud Biz Platform.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">External users request portal views via CDN.</data>
