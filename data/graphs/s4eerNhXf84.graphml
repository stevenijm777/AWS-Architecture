<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Aqua SaaS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Aqua's central SaaS platform providing runtime security management, compliance reporting, and policy configuration.</data>
    </node>
    <node id="1">
      <data key="d5">Network Load Balancer</data>
      <data key="d6">NLB</data>
      <data key="d7">VPC entry point receiving connections from Aqua SaaS and forwarding monitoring/control traffic to EKS cluster nodes.</data>
    </node>
    <node id="2">
      <data key="d5">EKS Node (AZ 1)</data>
      <data key="d6">EKS</data>
      <data key="d7">Worker node in Availability Zone 1 private subnet, running user workloads alongside the Aqua daemonset agent.</data>
    </node>
    <node id="3">
      <data key="d5">EKS Node (AZ 2)</data>
      <data key="d6">EKS</data>
      <data key="d7">Worker node in Availability Zone 2 private subnet, running user workloads alongside the Aqua daemonset agent.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Aqua SaaS establishes dynamic control and monitoring connectivity with the customer Network Load Balancer.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry, event metrics, and security logs sent back to Aqua SaaS from the cluster.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Network Load Balancer routes agent control traffic to the EKS worker node in Availability Zone 1.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Network Load Balancer routes agent control traffic to the EKS worker node in Availability Zone 2.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Aqua Security CNAPP Integration on AWS EKS</data>
    <data key="d1">https://www.youtube.com/watch?v=s4eerNhXf84</data>
    <data key="d2">Shows how Aqua SaaS connects to customer EKS clusters via Network Load Balancer to secure workloads using a daemonset agent across multiple Availability Zones.</data>
    <data key="d3">Security, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
