  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEFT.COM.AU</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Client web browser or mobile application accessing DEFT payment platform.</data>
    </node>
    <node id="1">
      <data key="d5">Shield</data>
      <data key="d6">Shield</data>
      <data key="d7">Provides DDoS protection at the AWS Edge.</data>
    </node>
    <node id="2">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Applies application-specific security controls to filter malicious traffic.</data>
    </node>
    <node id="3">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Content delivery network caching S3 application content at edge locations.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda@Edge</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Performs security header injection (HSTS, X-Frame-Options) and JWT token validation.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores single-page application (SPA) static assets in the AWS Region.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Client sends HTTP/HTTPS request to DEFT application via Shield.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DDoS-protected traffic passed to AWS WAF.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Filtered web traffic passed to CloudFront edge distribution.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront triggers Lambda@Edge for security and authorization checks.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront returns secure, cached static assets back to DEFT client.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda@Edge and CloudFront request origin assets from S3 in the AWS Region.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Macquarie Bank Deft Serverless Payment Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=sKksbPPDznM</data>
    <data key="d2">Serverless edge architecture replacing 60 EC2 instances to secure payment web applications with PCI DSS Level 1 compliance.</data>
    <data key="d3">Security, Serverless, Storage</data>
    <data key="d4">True</data>
  </graph>
