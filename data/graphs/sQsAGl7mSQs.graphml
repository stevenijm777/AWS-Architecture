<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Data and Code</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw data from supply-side partners as well as Airflow DAGs, PySpark scripts, and SageMaker notebooks.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 Airflow</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs Apache Airflow to orchestrate data processing and inference pipelines for both training and batch workloads.</data>
    </node>
    <node id="2">
      <data key="d5">Glue Pre-processing (Training)</data>
      <data key="d6">Glue</data>
      <data key="d7">Executes PySpark scripts for feature selection and pre-processing on training data.</data>
    </node>
    <node id="3">
      <data key="d5">SageMaker Training</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Performs model training and hyperparameter tuning across hundreds of training jobs.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker Batch Inference (Eval)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs batch evaluation on held-out datasets to assess model performance.</data>
    </node>
    <node id="5">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects operational and performance metrics from training and inference pipelines.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 Metrics Viz</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts an internal metrics visualization tool on EC2 to analyze performance metrics and select models.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Selected Models</data>
      <data key="d6">S3</data>
      <data key="d7">Stores selected trained models approved for production deployment.</data>
    </node>
    <node id="8">
      <data key="d5">Glue Pre-processing (Inference)</data>
      <data key="d6">Glue</data>
      <data key="d7">Handles pre-processing for unlabeled production datasets.</data>
    </node>
    <node id="9">
      <data key="d5">SageMaker Batch Inference (Prod)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Executes batch inference on production unlabeled datasets using selected models from S3.</data>
    </node>
    <node id="10">
      <data key="d5">S3 Generated Labels</data>
      <data key="d6">S3</data>
      <data key="d7">Stores output generated labels for downstream distribution.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw data and PySpark scripts from S3 are fed into Glue for feature selection and pre-processing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Airflow orchestrates and triggers the model training pre-processing job in Glue.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Airflow triggers the production batch inference pipeline starting with Glue pre-processing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Pre-processed feature data flows into SageMaker for model training and tuning.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue pushes pre-processing operational metrics to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Trained model artifacts pass to SageMaker batch evaluation on held-out datasets.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker pushes training and tuning performance metrics to CloudWatch.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch streams metrics to the internal visualization tool hosted on EC2.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Optimal models selected via the visualization dashboard are saved to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Selected production model artifacts are retrieved from S3 by SageMaker batch inference.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Inference pre-processing operational metrics are pushed to CloudWatch.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Pre-processed unlabeled production data is passed to SageMaker batch inference.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Generated labels output by SageMaker batch inference are stored in S3 for downstream distribution.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Eyeota Machine Learning Model Lifecycle and Production Inference Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=sQsAGl7mSQs</data>
    <data key="d2">The diagram details Eyeota's ML pipeline on AWS for audience data marketplace processing, utilizing Apache Airflow on EC2 to orchestrate AWS Glue, SageMaker, S3, and CloudWatch.</data>
    <data key="d3">Machine Learning, Analytics, Orchestration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
