<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End users interacting with HMH e-commerce web applications.</data>
    </node>
    <node id="1">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Imperva WAF with application delivery capability routing traffic to e-commerce backends or iframe CDN.</data>
    </node>
    <node id="2">
      <data key="d5">Payment Processor (PP)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External third-party payment processor processing credit card transactions and returning tokens.</data>
    </node>
    <node id="3">
      <data key="d5">E-Commerce Application 1</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">E-commerce backend application 1.</data>
    </node>
    <node id="4">
      <data key="d5">E-Commerce Application 2</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">E-commerce backend application 2.</data>
    </node>
    <node id="5">
      <data key="d5">E-Commerce Application 3</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">E-commerce backend application 3.</data>
    </node>
    <node id="6">
      <data key="d5">CloudFront Primary</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Primary CloudFront CDN fronting JS and CSS static assets for iframes.</data>
    </node>
    <node id="7">
      <data key="d5">CloudFront Secondary</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Secondary CloudFront CDN providing redundancy for iframe asset delivery.</data>
    </node>
    <node id="8">
      <data key="d5">S3 Primary</data>
      <data key="d6">S3</data>
      <data key="d7">Primary S3 bucket storing JavaScript and style sheet files loaded into the payment iframe.</data>
    </node>
    <node id="9">
      <data key="d5">S3 Secondary</data>
      <data key="d6">S3</data>
      <data key="d7">Secondary S3 bucket holding redundant static iframe assets.</data>
    </node>
    <node id="10">
      <data key="d5">S3 Access Logs Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized S3 bucket collecting access logs from primary and secondary S3 buckets.</data>
    </node>
    <node id="11">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">SNS topic sending alerts if any changes occur in the S3 bucket or JS files.</data>
    </node>
    <node id="12">
      <data key="d5">AWS Config</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">AWS Config tracking and auditing configuration compliance of S3 buckets.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User sends web requests to the WAF.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF routes payment transaction requests to external Payment Processor.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF forwards traffic to E-Commerce Application 1.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF forwards traffic to E-Commerce Application 2.</data>
      <data key="d10">1''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF forwards traffic to E-Commerce Application 3.</data>
      <data key="d10">1'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF routes iframe static content requests to CloudFront Primary.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront Primary fetches iframe JS and CSS assets from S3 Primary.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront Secondary fetches iframe JS and CSS assets from S3 Secondary.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Primary S3 bucket delivers access logs to central logging bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Secondary S3 bucket delivers access logs to central logging bucket.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Central logging S3 bucket publishes change notifications to SNS.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">AWS Config monitors and audits configurations of the S3 buckets.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">HMH Lightweight PCI Compliance Infrastructure</data>
    <data key="d1">https://www.youtube.com/watch?v=sSa4ikC8-Jc</data>
    <data key="d2">HMH decoupled PCI compliance requirements from core applications by using isolated S3 buckets and CloudFront to serve iframe JavaScript/CSS, with centralized logging and change notification via S3, SNS, and AWS Config.</data>
    <data key="d3">PCI Compliance, Static Asset Hosting, Security and Governance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
