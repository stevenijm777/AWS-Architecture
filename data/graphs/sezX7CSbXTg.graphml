<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Delivery Aggregator</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External third-party delivery aggregator platform that receives customer orders and routes events to Taco Bell.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">AWS HTTP API Gateway configured with direct integration to EventBridge without intermediate Lambdas.</data>
    </node>
    <node id="2">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Central event bus for routing inbound order events and driver proximity updates.</data>
    </node>
    <node id="3">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">State machine orchestrating the order lifecycle, utilizing callback task tokens while awaiting driver arrival.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless functions executing store validation, order creation, driver callback responses, and kitchen release triggers.</data>
    </node>
    <node id="5">
      <data key="d5">Taco Bell POS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">In-store POS and kitchen technology system that receives cooked order commands.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Delivery Aggregator sends new order event webhook to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway uses direct integration to forward order event to EventBridge.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge triggers Step Functions state machine workflow.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge routes event to execute Lambda for order processing.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda verifies product availability and pushes order into Taco Bell store POS.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda notifies Delivery Aggregator that order has been accepted.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Taco Bell Order Middleware Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=sezX7CSbXTg</data>
    <data key="d2">Taco Bell's serverless Order Middleware handles order ingestion from delivery aggregators to restaurant POS systems, handling peak throughputs of 300,000 orders per hour across 7,000 stores.</data>
    <data key="d3">Serverless, Integration, Event-Driven Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
