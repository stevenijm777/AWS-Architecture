  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Code repository</data>
      <data key="d6">DevTools</data>
      <data key="d7">External git code repository containing model training and service code.</data>
    </node>
    <node id="1">
      <data key="d5">Zensie API</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External API source providing supplementary environmental or crop data.</data>
    </node>
    <node id="2">
      <data key="d5">Greengrass</data>
      <data key="d6">Greengrass</data>
      <data key="d7">AWS Greengrass deployed on edge hardware in grower greenhouses for local data collection and offline buffering.</data>
    </node>
    <node id="3">
      <data key="d5">AWS CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Orchestrates CI/CD build and deployment stages.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Codebuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Builds docker containers for model training and preprocessing.</data>
    </node>
    <node id="5">
      <data key="d5">Elastic container registry</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores container images used by SageMaker for training.</data>
    </node>
    <node id="6">
      <data key="d5">Start training</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function triggering SageMaker pre-processing and training jobs.</data>
    </node>
    <node id="7">
      <data key="d5">Get status</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function checking the progress and status of active SageMaker jobs.</data>
    </node>
    <node id="8">
      <data key="d5">Evaluate model</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function validating model metrics and performance post-training.</data>
    </node>
    <node id="9">
      <data key="d5">Training data loading</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function preparing and populating training datasets.</data>
    </node>
    <node id="10">
      <data key="d5">S3 Bucket training data</data>
      <data key="d6">S3</data>
      <data key="d7">S3 storage bucket containing curated training datasets.</data>
    </node>
    <node id="11">
      <data key="d5">Sagemaker pre-processing &amp; training job</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Amazon SageMaker executing containerized pre-processing and model training.</data>
    </node>
    <node id="12">
      <data key="d5">S3 Bucket model artifacts</data>
      <data key="d6">S3</data>
      <data key="d7">S3 storage bucket containing trained model artifacts and weights.</data>
    </node>
    <node id="13">
      <data key="d5">IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests telemetry streams from Greengrass edge devices.</data>
    </node>
    <node id="14">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Decouples and buffers IoT messages before ingestion into search index.</data>
    </node>
    <node id="15">
      <data key="d5">Amazon Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Indexes and searches incoming sensor telemetry.</data>
    </node>
    <node id="16">
      <data key="d5">Live inference Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes real-time inference on incoming greenhouse telemetry.</data>
    </node>
    <node id="17">
      <data key="d5">Model serving Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Loads active model artifacts to serve predictions to external consumers.</data>
    </node>
    <node id="18">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Persists model metadata, evaluation scores, and serving parameters.</data>
    </node>
    <node id="19">
      <data key="d5">Testing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes synthetic/integration tests against model serving endpoint.</data>
    </node>
    <node id="20">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes HTTP API endpoints for real-time model inference.</data>
    </node>
