<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile / Web Clients</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Mobile and web clients generating hundreds of millions of requests per month for vehicle auctions.</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer distributing incoming user requests to EKS microservices.</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS cluster hosting over 50 microservices managed by a dozen domain teams, utilizing heterogeneous node groups (compute, GPU for ML, etc.).</data>
    </node>
    <node id="3">
      <data key="d5">KAFKA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Apache Kafka clusters serving as a central message bus (Data Hub) for microservice event publishing/subscribing and analytics streaming.</data>
    </node>
    <node id="4">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">RDS instances assigned to individual domain teams to persist microservice-specific data.</data>
    </node>
    <node id="5">
      <data key="d5">Analytics / Dashboards</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Analytics applications and dashboards consuming real-time events for business metrics like sell-through rates.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile and web clients send traffic to load balancers.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB spreads incoming requests down to microservices running on EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS microservices persist and retrieve state in domain RDS databases.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Microservices publish events (e.g., bid placed) to Kafka via sidecar Data Hub containers.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Microservices consume relevant events from Kafka to take actions (e.g., write bid record).</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Kafka feeds live event stream to analytics consumers for reporting and dashboards.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">ACV Auctions Microservices and Event-Driven Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=tBavPTWewvI</data>
    <data key="d2">ACV Auctions processes hundreds of millions of requests per month across 50+ microservices hosted on EKS with Kafka event streaming and RDS persistence.</data>
    <data key="d3">eCommerce / Microservices / Real-time Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
