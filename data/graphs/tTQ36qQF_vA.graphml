<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Global Content Delivery Network configured with Origin Failover to seamlessly route users from primary to secondary S3 origins.</data>
    </node>
    <node id="1">
      <data key="d5">S3 Website (Region 1)</data>
      <data key="d6">S3</data>
      <data key="d7">Primary S3 bucket hosting the application static web content in Region 1.</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB (Region 1)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Primary DynamoDB global table in Region 1 serving key-value store operations.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Objects (Region 1)</data>
      <data key="d6">S3</data>
      <data key="d7">Primary S3 bucket in Region 1 storing application data objects.</data>
    </node>
    <node id="4">
      <data key="d5">Cognito (Region 1)</data>
      <data key="d6">Cognito</data>
      <data key="d7">Primary Cognito user pool managing user identification in Region 1.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Website (Region 2)</data>
      <data key="d6">S3</data>
      <data key="d7">Secondary S3 bucket hosting static website content for origin failover in Region 2.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB (Region 2)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Secondary DynamoDB global table replica in Region 2.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Objects (Region 2)</data>
      <data key="d6">S3</data>
      <data key="d7">Secondary S3 bucket in Region 2 receiving cross-region replicated objects.</data>
    </node>
    <node id="8">
      <data key="d5">Cognito (Region 2)</data>
      <data key="d6">Cognito</data>
      <data key="d7">Secondary Cognito user pool synchronized via automated AWS solution in Region 2.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront fetches static web content from primary S3 bucket in Region 1.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront performs automated origin failover to secondary S3 bucket in Region 2 if Region 1 is unavailable.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB Global Table automatically replicates data updates from Region 1 to Region 2.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 Cross-Region Replication asynchronously replicates application objects from Region 1 to Region 2.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">AWS Solutions custom replication mechanism automatically synchronizes Cognito user pools from Region 1 to Region 2.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">AWS Multi-Region Active-Passive Serverless Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=tTQ36qQF_vA</data>
    <data key="d2">This architecture illustrates an active-passive multi-region setup built with serverless components including CloudFront origin failover, S3 cross-region replication, DynamoDB Global Tables, and automated Cognito user pool replication.</data>
    <data key="d3">Disaster Recovery &amp; Multi-Region Solutions</data>
    <data key="d4">True</data>
  </graph>
</graphml>
