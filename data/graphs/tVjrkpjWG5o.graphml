<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DATAMART USER</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Contractors and operators responsible for drilling oil and gas wells, accessing Presto via JDBC/ODBC drivers.</data>
    </node>
    <node id="1">
      <data key="d5">PRESTO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Apache Presto interface running on EMR providing a unified query view across sensor data and metadata.</data>
    </node>
    <node id="2">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute instances running microservices including authentication plugins and the Datamart ETL orchestration service.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores high-volume raw sensor data (500 channels at 1-second frequency across over 700,000 wells).</data>
    </node>
    <node id="4">
      <data key="d5">HIVE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data processing component commanded by ETL microservices to create tables around raw S3 files and perform transformations.</data>
    </node>
    <node id="5">
      <data key="d5">EMR FS</data>
      <data key="d6">EMR</data>
      <data key="d7">Consistent S3 view layer storing high-volume sensor data loaded by Hive for querying via Presto.</data>
    </node>
    <node id="6">
      <data key="d5">RDS MYSQL</data>
      <data key="d6">RDS</data>
      <data key="d7">MySQL database storing frequently changing well metadata across 700,000 database instances in a star schema.</data>
    </node>
    <node id="7">
      <data key="d5">EMR HDFS</data>
      <data key="d6">EMR</data>
      <data key="d7">Hadoop Distributed File System component within the EMR cluster environment.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Datamart users query the unified dataset via Presto using JDBC/ODBC.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Presto invokes custom authentication and authorization microservices running on EC2.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Presto queries high-volume sensor data residing in EMRFS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Presto queries frequently changing well metadata stored in RDS MySQL.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Datamart ETL microservice on EC2 accesses raw sensor files stored in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 orchestrator commands Hive to transform data and create a Hive table around S3 files.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Hive loads transformed sensor data into EMRFS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Payson Drilling Data Mart Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=tVjrkpjWG5o</data>
    <data key="d2">Architecture illustrating Payson's unified drilling data mart platform leveraging Presto on EMR, Hive ETL workflows, RDS MySQL metadata storage, and EMRFS for queryable sensor data in S3.</data>
    <data key="d3">Analytics &amp; Data Lakes, Energy &amp; Utilities</data>
    <data key="d4">True</data>
  </graph>
</graphml>
