<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 (Ingestion)</data>
      <data key="d6">S3</data>
      <data key="d7">Dedicated ingestion bucket for raw telephonic conversation audio data.</data>
    </node>
    <node id="1">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the audio analysis pipeline sequentially.</data>
    </node>
    <node id="2">
      <data key="d5">Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Performs speech-to-text conversion with PII reduction enabled.</data>
    </node>
    <node id="3">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Extracts call sentiment and customer utterance metrics.</data>
    </node>
    <node id="4">
      <data key="d5">S3 (Data Lake)</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake bucket storing transcripts, sentiment analysis, and enriched call metadata.</data>
    </node>
    <node id="5">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Elasticsearch cluster providing auto-scaling search capabilities across phone conversations for internal business units.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Audio file landing in S3 triggers Step Functions execution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions invokes AWS Transcribe for speech-to-text processing.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Transcripts are sent to Amazon Comprehend for sentiment analysis.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Analyzed NLP results and enriched call data are pushed to the S3 Data Lake.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Data lake contents are loaded into Elasticsearch for fast full-text searching.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Zillow Speech Analytics Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=twsGnp2X-aQ</data>
    <data key="d2">Architecture for ingesting, transcribing, analyzing, storing, and indexing call conversation data for Zillow's internal business units.</data>
    <data key="d3">AI/ML, Speech Analytics, Data Lake</data>
    <data key="d4">True</data>
  </graph>
</graphml>
