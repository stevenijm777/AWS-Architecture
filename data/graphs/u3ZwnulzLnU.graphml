<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEVELOPERS</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developers who push code to GitHub and review code quality metrics via UI/API.</data>
    </node>
    <node id="1">
      <data key="d5">GITHUB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External source code repository hosting platform.</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Receives GitHub webhook events, performs triage, and creates analysis requests.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Amazon SQS queue leveling load and triggering auto-scaling for scanner Fargate tasks.</data>
    </node>
    <node id="4">
      <data key="d5">ECS FARGATE (Scanner)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Fargate cluster that polls SQS, clones repositories from GitHub into ephemeral storage, runs code analysis, and posts reports.</data>
    </node>
    <node id="5">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances hosting the API to ingest raw reports and serving UI/API requests for users.</data>
    </node>
    <node id="6">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Amazon Aurora database storing raw/processed analysis reports and acting as a task buffer.</data>
    </node>
    <node id="7">
      <data key="d5">ECS FARGATE (Compute Engine)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Compute Engine on ECS Fargate polling Aurora, computing code quality metrics, and updating database.</data>
    </node>
    <node id="8">
      <data key="d5">ES</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Elasticsearch cluster storing shared data formatted for fast search and optimization.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developers push code commits to the GitHub repository.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Developers query completed code quality results via EC2 UI or API.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">GitHub repository sends a webhook event to AWS Lambda on code push.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda triages the event and puts an analysis request into the SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS Fargate scanner service polls SQS for incoming analysis tasks.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS Fargate task clones the code directly from GitHub into ephemeral storage.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate scanner sends the completed raw analysis report to EC2 via API.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 API writes the incoming raw report into the Aurora database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Aurora delivers report payload to Compute Engine for analysis.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Compute Engine Fargate tasks poll Aurora database to extract raw reports.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="6" id="1">
      <data key="d8">1</data>
      <data key="d9">Compute Engine writes computed code quality metrics back to Aurora.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Compute Engine pushes optimized search data to Elasticsearch.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">SonarSource - SonarCloud AutoScan Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=u3ZwnulzLnU</data>
    <data key="d2">Architecture for SonarCloud AutoScan at SonarSource, processing up to 150k analyses per week using AWS Lambda, SQS, ECS Fargate, Aurora, and Elasticsearch.</data>
    <data key="d3">DevOps &amp; CI/CD, Serverless Compute, Database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
