<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Source / ETL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Extracts and pre-processes adverse event reporting data from multiple clinical trial systems and call centers.</data>
    </node>
    <node id="1">
      <data key="d5">Refined Store</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing standardized, schema-transformed case data that triggers downstream pipeline execution.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates complex multi-stage serverless pipeline logic in parallel across scaling Lambda executions.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda Functions</data>
      <data key="d6">Lambda</data>
      <data key="d7">Multiple serverless functions (written in Node.js and Python) executing transformation and ML enrichment steps within Step Functions.</data>
    </node>
    <node id="4">
      <data key="d5">Machine Learning</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Custom ML models built from historical labeled datasets for NLP text extraction and assessing case event seriousness.</data>
    </node>
    <node id="5">
      <data key="d5">Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Translates non-English medical narrative descriptions (e.g. from Japan or China) into English for NLP analysis.</data>
    </node>
    <node id="6">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">AWS Comprehend Medical used for medical NLP entity extraction and linkage (e.g., dosage associated with drugs).</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database storing final curated pharmacovigilance cases for human case manager verification via internal web apps.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Source ETL functions standardize raw adverse event data and write files to the Refined Store S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 object creation triggers the AWS Step Functions workflow to start case processing.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions coordinates and executes up to 20 Lambda functions during workflow execution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Pipeline passes case text to custom Machine Learning models for seriousness assessment and extraction.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Pipeline routes non-English case text to AWS Translate.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Pipeline routes unstructured narrative text to Comprehend Medical for entity and linkage extraction.</data>
      <data key="d10">1''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Completed and augmented case records are persisted into the RDS database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">PwC Pharmacovigilance Serverless Data Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=u9DZRkJxvWo</data>
    <data key="d2">Serverless pipeline built by PwC to process pharmacovigilance adverse event data for pharmaceutical companies, achieving a 50-70% reduction in case processing time.</data>
    <data key="d3">Serverless, Data Pipeline, Healthcare / Life Sciences, Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
