  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEPLOYMENT ENGINEER</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Deployment Engineer triggering the initial stack deployment in the Hub account.</data>
    </node>
    <node id="1">
      <data key="d5">APP DEV</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Application Developer updating product templates using a GitOps workflow.</data>
    </node>
    <node id="2">
      <data key="d5">CLOUDFORMATION</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Provisions Service Catalog portfolio, CodePipeline, and calls Lambda as a custom resource.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Custom resource Lambda that configures account parameters, shares portfolios cross-account, and sets launch constraints.</data>
    </node>
    <node id="4">
      <data key="d5">SERVICE CATALOG (HUB)</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Central Service Catalog portfolio storing approved architectural products.</data>
    </node>
    <node id="5">
      <data key="d5">CODECOMMIT</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">Git repository serving as the source for CodePipeline updates.</data>
    </node>
    <node id="6">
      <data key="d5">CODEPIPELINE</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Executes syntax validation, security analysis, and deploys product updates to Service Catalog.</data>
    </node>
    <node id="7">
      <data key="d5">SERVICE CATALOG (SPOKE)</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Imported and local copy of Service Catalog portfolio in the remote Spoke account.</data>
    </node>
    <node id="8">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Individual EC2 compute instances provisioned from Spoke Service Catalog.</data>
    </node>
    <node id="9">
      <data key="d5">TECH STACK</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Complete multi-resource application tech stacks provisioned from Spoke Service Catalog.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Deployment Engineer deploys CloudFormation template in Hub account.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">App Dev commits updated product template to CodeCommit.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation triggers Lambda as a custom resource.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation creates Service Catalog portfolio in Hub account.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation creates CodePipeline.</data>
      <data key="d10">1''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda configures parameters on Hub Service Catalog portfolio.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda creates portfolio share and configures launch constraints on Spoke account.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Hub Service Catalog portfolio shared into Spoke account.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CodeCommit change triggers CodePipeline execution.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CodePipeline deploys updated product to Hub Service Catalog after security checks.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Spoke Service Catalog provisions EC2 instance.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Spoke Service Catalog provisions complete application tech stack.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Western Union Multi-Account Cross-Region Architecture Deployment via Service Catalog</data>
    <data key="d1">https://www.youtube.com/watch?v=uBiaWJbTRsE</data>
    <data key="d2">Centralized governance architecture allowing Western Union to provision standardized products across multiple AWS accounts and regions from a single Hub account.</data>
    <data key="d3">Management and Governance, Developer Tools</data>
    <data key="d4">True</data>
