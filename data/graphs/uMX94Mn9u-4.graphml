  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall detecting web attacks.</data>
    </node>
    <node id="1">
      <data key="d5">GUARD DUTY</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Threat detection service analyzing account and resource activity.</data>
    </node>
    <node id="2">
      <data key="d5">CLOUD WATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Captures events and filters specific patterns using CloudWatch Event Rules.</data>
    </node>
    <node id="3">
      <data key="d5">KINESIS</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Streams filtered security event logs for downstream processing and analytics.</data>
    </node>
    <node id="4">
      <data key="d5">SECURITY HUB</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Centralized security management hub for prioritizing events and triggering automated remediation.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA (Aggregation)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function used for notification sending and event aggregation processing.</data>
    </node>
    <node id="6">
      <data key="d5">DETECTIVE</data>
      <data key="d6">Detective</data>
      <data key="d7">Analyzes and investigates the root cause of security findings.</data>
    </node>
    <node id="7">
      <data key="d5">ELASTIC SEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Search and visualization engine for security logs and events.</data>
    </node>
    <node id="8">
      <data key="d5">SYSTEM MANAGER</data>
      <data key="d6">SystemsManager</data>
      <data key="d7">Executes automated remediation workflows on AWS infrastructure.</data>
    </node>
    <node id="9">
      <data key="d5">LAMBDA (Auto Remediation)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function executing programmatic remediation tasks.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">WAF sends event logs to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">WAF security findings are consolidated in Security Hub.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">GuardDuty sends threat findings to CloudWatch.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">GuardDuty findings are consolidated in Security Hub.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch event rules forward pattern-matched event streams to Kinesis.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis streams event data to ElasticSearch (OpenSearch) for visualization and querying.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Security Hub integrates with Detective for root cause investigation.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Security Hub triggers aggregation/notification Lambda for prioritized alerts.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Security Hub triggers Systems Manager Automation for automated remediation.</data>
      <data key="d10">2</data>
