<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Sources (Structured)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Structured transactional databases including loan origination system, loan management, and collections.</data>
    </node>
    <node id="1">
      <data key="d5">Data Sources (Semi-Structured)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Semi-structured data sources from external systems like credit bureaus.</data>
    </node>
    <node id="2">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">AWS Database Migration Service configured to ingest data from both structured and semi-structured sources.</data>
    </node>
    <node id="3">
      <data key="d5">RAW</data>
      <data key="d6">S3</data>
      <data key="d7">Staging layer and data lake storing raw ingested data encrypted with KMS.</data>
    </node>
    <node id="4">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">AWS Key Management Service used to encrypt customer sensitive data such as names, phone numbers, and addresses.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Used for orchestration of workflow execution.</data>
    </node>
    <node id="6">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Serverless ETL using PySpark for complex business rules, data quality checks, error handling, and auditing.</data>
    </node>
    <node id="7">
      <data key="d5">PROCESSED</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing transformed data in target format.</data>
    </node>
    <node id="8">
      <data key="d5">AURORA PG</data>
      <data key="d6">Aurora</data>
      <data key="d7">Data mart on Aurora PostgreSQL chosen for high query concurrency without licensing costs.</data>
    </node>
    <node id="9">
      <data key="d5">TABLEAU</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">BI presentation tool connected to summarized data in Aurora PostgreSQL for dashboards and reports.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS pulls structured data from relational databases.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS pulls semi-structured data from bureau sources.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS loads extracted data into the S3 RAW staging bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue reads raw staging data from S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue writes transformed target-format data into S3 PROCESSED.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue loads transformed data into Aurora PostgreSQL data mart.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Tableau queries Aurora PostgreSQL presentation tables for reporting and analytics.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Bajaj Housing Finance Serverless Data Pipeline and Data Mart Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=uNAmsoLed1E</data>
    <data key="d2">Serverless data pipeline and data mart architecture built by Bajaj Housing Finance Limited (BHFL) to ingest, transform, encrypt, and serve analytical data for financial reporting.</data>
    <data key="d3">Analytics, Migration, Database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
