<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CLOUDTRAIL</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Captures real-time infrastructure event changes.</data>
    </node>
    <node id="1">
      <data key="d5">GUARDDUTY</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Analyzes DNS, VPC flow, and CloudTrail logs using machine learning to identify anomalies.</data>
    </node>
    <node id="2">
      <data key="d5">INSPECTOR</data>
      <data key="d6">Inspector</data>
      <data key="d7">Performs vulnerability assessments on AWS resources.</data>
    </node>
    <node id="3">
      <data key="d5">AWS CONFIG</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">Evaluates complex compliance and configuration rules over time.</data>
    </node>
    <node id="4">
      <data key="d5">SECURITY HUB</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Aggregates security findings from Inspector and AWS Config and tracks remediation status.</data>
    </node>
    <node id="5">
      <data key="d5">EVENTBRIDGE</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Central event bus connecting detection findings to remediation targets.</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes automated remediation code to resolve cloud misconfigurations.</data>
    </node>
    <node id="7">
      <data key="d5">CLOUD CUSTODIAN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Open-source engine using YAML rules to deploy security Lambdas across accounts and regions.</data>
    </node>
    <node id="8">
      <data key="d5">SLACK</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Notification channel where Lambda sends remediation activity alerts.</data>
    </node>
    <edge source="0" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudTrail funnels real-time infrastructure events into EventBridge.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">GuardDuty triggers EventBridge events upon detecting malicious activity or anomalies.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Inspector routes vulnerability findings directly into Security Hub.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">AWS Config security rule evaluations feed into Security Hub.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Security Hub routes aggregated detection events into EventBridge for automated remediation.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge triggers Lambda functions to remediate misconfigurations.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda posts remediation activity messages into Slack.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda updates Security Hub with remediation timestamp and resolution status.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Cloud Custodian YAML policies generate and deploy remediation Lambdas.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">HBO Max Automated Security Detection and Remediation Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=uOSpWdAyrZo</data>
    <data key="d2">Automated cloud security detection and remediation platform using EventBridge and Lambda.</data>
    <data key="d3">Security, Compliance, Automation</data>
    <data key="d4">True</data>
  </graph>
