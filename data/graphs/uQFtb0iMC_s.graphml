  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded media files (video, audio, images).</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 object creation event to start Step Functions workflow.</data>
    </node>
    <node id="2">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates parallel analysis workflows across AI/ML services.</data>
    </node>
    <node id="3">
      <data key="d5">Custom ML Model</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Extensible branch for running custom trained ML models.</data>
    </node>
    <node id="4">
      <data key="d5">Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Extracts computer vision metadata (objects, scenes, people) from images/videos.</data>
    </node>
    <node id="5">
      <data key="d5">Media Convert</data>
      <data key="d6">MediaConvert</data>
      <data key="d7">Extracts audio from video files to comply with Transcribe payload limits.</data>
    </node>
    <node id="6">
      <data key="d5">Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts extracted audio into text transcriptions via automatic speech recognition.</data>
    </node>
    <node id="7">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Analyzes transcribed text for entities, key phrases, and sentiment.</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Central persistence layer storing structured metadata JSON for search capabilities.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
