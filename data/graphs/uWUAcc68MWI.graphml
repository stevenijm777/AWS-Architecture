<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IoT Devices</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Sensors publishing temperature data via MQTT.</data>
    </node>
    <node id="1">
      <data key="d5">IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Entry point for device message ingestion.</data>
    </node>
    <node id="2">
      <data key="d5">IoT Rule</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Defines actions to route incoming MQTT messages.</data>
    </node>
    <node id="3">
      <data key="d5">Firehose (Raw)</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams raw payloads to S3 and Kinesis Data Analytics.</data>
    </node>
    <node id="4">
      <data key="d5">RAW S3</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term storage bucket for unmodified raw events.</data>
    </node>
    <node id="5">
      <data key="d5">Kinesis Data Analytics</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Executes real-time SQL queries on streaming data in flight.</data>
    </node>
    <node id="6">
      <data key="d5">Firehose (Processed)</data>
      <data key="d6">Firehose</data>
      <data key="d7">Delivers processed/transformed events to S3.</data>
    </node>
    <node id="7">
      <data key="d5">PROCESSED S3</data>
      <data key="d6">S3</data>
      <data key="d7">Storage bucket for aggregated JSON data.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes analytics results and writes to DynamoDB.</data>
    </node>
    <node id="9">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database holding real-time visualization metrics.</data>
    </node>
    <node id="10">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Hosts static web application content and provides HTTPS endpoint.</data>
    </node>
    <node id="11">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">User pools for authenticating web app users.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT devices send MQTT messages to IoT Core.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Core evaluates rules on received MQTT messages.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Rule routes raw messages into Firehose.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose delivers raw messages to RAW S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose streams raw data into Kinesis Data Analytics.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Data Analytics sends processed stream to second Firehose.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Data Analytics invokes Lambda function with analyzed events.</data>
      <data key="d10">4'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose persists JSON processed events to PROCESSED S3 bucket.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda function writes metrics into DynamoDB table.</data>
      <data key="d10">5'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront web application polls DynamoDB every 10 seconds for real-time visualization data.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">AWS IoT Monitoring and Visualization Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=uWUAcc68MWI</data>
    <data key="d2">Real-time IoT ingestion and analytics system. Raw data from IoT Core is delivered via Kinesis Data Firehose to S3 and Kinesis Data Analytics. Analytics results feed into processed S3 storage via Firehose and to DynamoDB via Lambda. CloudFront serves a static web application that polls DynamoDB every 10 seconds, with Cognito securing user access.</data>
    <data key="d3">IoT, Analytics, Web Applications</data>
    <data key="d4">True</data>
  </graph>
</graphml>
