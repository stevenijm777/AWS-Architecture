<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Client application sending analytics and user event tracking data.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Serves the JavaScript snippet to track events in the client application.</data>
    </node>
    <node id="2">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Routes client requests to the nearest geographical API Gateway endpoint.</data>
    </node>
    <node id="3">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry endpoint for incoming event tracking calls.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda Validation</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates incoming events and ensures privacy compliance.</data>
    </node>
    <node id="5">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers raw logs for up to 5 minutes or 100 MB in gzip format.</data>
    </node>
    <node id="6">
      <data key="d5">S3 Raw Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores compressed raw event log files.</data>
    </node>
    <node id="7">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Message broker configured to receive S3 object creation event notifications.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda ETL</data>
      <data key="d6">Lambda</data>
      <data key="d7">Normalizes logs to internal format and enriches them with product info.</data>
    </node>
    <node id="9">
      <data key="d5">S3 Processed Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores persistent enriched event data ready for downstream Spark/EMR processing.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile app downloads JavaScript tracking snippet via CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Mobile app sends event tracking calls via Route 53.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Route 53 routes requests to the geographically nearest API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway forwards event data to Validation Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Validation Lambda sends event logs to Kinesis Firehose.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis Firehose dumps buffered gzip files into S3 Raw Bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 Raw Bucket triggers object creation event notification to SNS.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS notifies ETL Lambda subscriber to process new raw files.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">ETL Lambda outputs transformed and enriched data to S3 Processed Bucket.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Tuso AI Analytics Data Acquisition Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=uda9s3U7vFw</data>
    <data key="d2">Serverless data acquisition architecture for e-commerce search analytics.</data>
    <data key="d3">Analytics Data Pipeline Serverless Event Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
