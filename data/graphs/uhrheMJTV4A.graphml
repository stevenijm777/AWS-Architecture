  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">TB/d</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Manufacturing sites producing terabytes of compliance-regulated data per day.</data>
    </node>
    <node id="1">
      <data key="d5">IOT</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Manages software agents on manufacturing sites globally and ingests data into AWS.</data>
    </node>
    <node id="2">
      <data key="d5">KINESIS</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Ingests high-throughput streaming data from IoT Core.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates, removes rogue records, and enriches payloads with compliance envelopes.</data>
    </node>
    <node id="4">
      <data key="d5">ES</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Stores enriched data for real-time or near real-time visualization.</data>
    </node>
    <node id="5">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Provides operational metadata and state persistence.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake storing raw readable JSON files and converted Parquet files.</data>
    </node>
    <node id="7">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Executes cyclic ETL jobs converting raw JSON into Parquet format.</data>
    </node>
    <node id="8">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries batch analytical information directly from S3 Parquet datasets.</data>
    </node>
    <node id="9">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes query endpoints to web applications and dashboards.</data>
    </node>
    <node id="10">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user consuming interactive dashboards and analytical insights.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Software agents on site transmit local manufacturing data to IoT Core.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
