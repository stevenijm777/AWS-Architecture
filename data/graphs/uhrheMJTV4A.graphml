      <data key="d9">IoT Core forwards ingested data stream to Kinesis.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis streams high-volume data to Lambda for processing.</data>
      <data key="d10">2</data>
