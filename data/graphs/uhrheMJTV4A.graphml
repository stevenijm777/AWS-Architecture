    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes persistent record state into DynamoDB.</data>
      <data key="d10">3''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda saves raw incoming JSON files to S3.</data>
      <data key="d10">3'''</data>
