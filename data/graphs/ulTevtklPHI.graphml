    <node id="2">
      <data key="d5">Amazon S3 Data Store</data>
      <data key="d6">S3</data>
      <data key="d7">Stores ingested raw comments and intermediate clean CSV files.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon SageMaker Notebook (Clean PreProcess)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Cleans special characters, transforms markdown to plain text, and pre-processes CSV data.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Bedrock Titan</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Analyzes complex language to identify expert designation in comments.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon SageMaker Hugging Face Flan UL2</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Lightweight open-source generative model for sentiment analysis (&gt;99% accuracy).</data>
    </node>
    <node id="6">
      <data key="d5">Amazon SageMaker Notebook (ML Processing)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Uses Scikit-learn for clustering form letters and evaluating grade level.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3 BI Data Store</data>
      <data key="d6">S3</data>
      <data key="d7">Final staging location for ML model output CSV files.</data>
