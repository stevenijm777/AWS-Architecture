<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">AWS Control Tower defining and managing the AWS landing zone environment.</data>
    </node>
    <node id="1">
      <data key="d5">CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Runs deployment pipelines for account vending and workload provisioning.</data>
    </node>
    <node id="2">
      <data key="d5">Systems Manager</data>
      <data key="d6">SystemsManager</data>
      <data key="d7">Manages operational and patching events across the landing zone.</data>
    </node>
    <node id="3">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Receives raw operational events from CloudWatch event subscriptions.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms raw event payloads to extract key metadata such as triggered resource and timestamp.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores raw event data for historical retention and auditing.</data>
    </node>
    <node id="6">
      <data key="d5">Timestream</data>
      <data key="d6">Timestream</data>
      <data key="d7">Time-series database storing aggregated operational metrics.</data>
    </node>
    <node id="7">
      <data key="d5">Grafana</data>
      <data key="d6">Grafana</data>
      <data key="d7">Renders real-time dashboards and visualization metrics using SQL queries against Timestream.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Control Tower events (e.g. CodePipeline / Systems Manager execution) publish raw events to EventBridge.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge triggers Lambda function to process incoming raw event payload.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes enriched raw event data into DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes formatted time-series metrics into Timestream.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Grafana queries Timestream to display performance metrics on dashboards.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Contino Flight Controller Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=unFVfqj9cQ8</data>
    <data key="d2">Flight Controller visualizes performance metrics and health checks of AWS Control Tower landing zones in under 20 seconds using a serverless event-driven architecture.</data>
    <data key="d3">Management &amp; Governance, Serverless, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
