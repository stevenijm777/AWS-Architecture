<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AssemblyAI Users</data>
      <data key="d6">UserConsumerAPI</data>
      <data key="d7">External clients submitting binary audio data or S3 audio references via API.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon ECS (API Manager)</data>
      <data key="d6">ECS</data>
      <data key="d7">Validates API requests and handles initial audio uploading and transcoding.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon ECS (Orchestrator)</data>
      <data key="d6">ECS</data>
      <data key="d7">Decides which ML models to invoke and in what order based on requested audio features.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon CloudWatch Metrics</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors system metrics and queue depth to drive predictive autoscaling loop.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes job completion notifications to subscribed services.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Webhook Lambda function that asynchronously calls user webhooks upon transcription completion.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores transcoded audio binary files with strict lifecycle retention policies.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers inference tasks and drives autoscaling for model containers.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon ECS (Inference)</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs dozens of specialized ML models (Conformer 2, speaker labeling, sentiment analysis) on GPU instances.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users send API request with audio data or S3 reference.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Manager passes validated request to Orchestrator.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestrator stores transcoded audio data in S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestrator dispatches inference job messages into SQS.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Orchestrator records execution telemetry in CloudWatch Metrics.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Orchestrator sends completion notification to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch queue depth signals trigger custom autoscaling loop for inference queue.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">SNS topic triggers the Webhook Lambda handler.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">3</data>
      <data key="d9">Webhook Lambda sends asynchronous callback notification to users.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Inference containers read audio data directly from S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Inference containers pull tasks from the SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">AssemblyAI Asynchronous Speech Recognition Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=vQgUkn3rAMY</data>
    <data key="d2">Handles scalable, multi-model AI transcription workflows with predictive autoscaling based on CloudWatch metrics and SQS queue depth.</data>
    <data key="d3">Machine Learning, Speech-to-Text, Async Pipeline, Microservices</data>
    <data key="d4">True</data>
  </graph>
