<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Entry point for front-end client requests.</data>
    </node>
    <node id="1">
      <data key="d5">BEANSTALK</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Elastic Beanstalk hosting web front-end application on EC2.</data>
    </node>
    <node id="2">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API Gateway routing API requests to serverless Lambda microservices.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda Top</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function fetching or scraping invoices from provider customer portals using custom PHP runtime.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda Middle</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function processing invoice data, reading/writing temporary state in ElastiCache.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda Bottom</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function performing asynchronous background calculations and database operations.</data>
    </node>
    <node id="6">
      <data key="d5">PDF</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Invoice PDF document storage/generation layer.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing downloaded invoice PDFs.</data>
    </node>
    <node id="8">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS queue decoupling S3 event notifications and triggering processing Lambdas.</data>
    </node>
    <node id="9">
      <data key="d5">ELASTICACHE</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory cache for temporary state storage.</data>
    </node>
    <node id="10">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database holding main application and consumption data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards client web traffic to Elastic Beanstalk.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Elastic Beanstalk reads and writes directly to RDS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Elastic Beanstalk issues requests to API Gateway.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes Top Lambda for fetching bills.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes Middle Lambda for calculations.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes Bottom Lambda for background jobs.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Top Lambda retrieves or generates PDF invoices.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Middle Lambda caches temporary computational data in ElastiCache.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Middle Lambda stores processed metrics into RDS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Bottom Lambda updates records in RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">PDF invoices are saved to S3 Bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 upload triggers SQS message queue.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS triggers Middle Lambda to process uploaded invoices.</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS triggers Bottom Lambda for asynchronous handling.</data>
      <data key="d10">3''</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Enoptea Serverless Backend Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=vb-o1DvvHxk</data>
    <data key="d2">Enoptea processes energy consumption and billing data for thousands of sites using AWS Elastic Beanstalk for the front-end and a serverless PHP backend with AWS Lambda, SQS, S3, ElastiCache, and RDS.</data>
    <data key="d3">SaaS, Serverless, Data Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
