<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Regional Mobile Apps</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Generates ~30M log events per day across multiple regions worldwide.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Geo-distributed CDN ingestion point for incoming global application logs.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda@Edge</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Executes logic at edge locations to forward events to a single centralized Firehose collector.</data>
    </node>
    <node id="3">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Central collector stream serving as a unified controlled ingest stream for real-time analytics and S3 backup.</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Data Analytics</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Processes near real-time analytics; categorizes stream events into business critical, low priority, or discarded.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Backup Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores full backup of raw incoming log data for disaster recovery and stream replay.</data>
    </node>
    <node id="6">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Runs ETL jobs on S3 backup data and maintains the data catalog.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Enables internal departments to run ad-hoc SQL queries on cataloged raw data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Regional mobile traffic routes log events to CloudFront endpoints.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront invokes Lambda@Edge upon log event ingestion.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda@Edge forwards events into Kinesis Data Firehose.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Data Firehose streams events into Kinesis Data Analytics for near real-time processing.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis Data Firehose writes backup copies of raw data into an S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue reads S3 data for ETL processing and schema cataloging.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue exposes data catalog metadata to Amazon Athena for internal reporting.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">ShopFully Global Real-Time Analytics and Log Ingestion Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=vdujJAab1LM</data>
    <data key="d2">Handles ~3 million daily unique users producing ~30 million events (~50 GB) per day in a fully serverless, geo-distributed architecture.</data>
    <data key="d3">Analytics, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
