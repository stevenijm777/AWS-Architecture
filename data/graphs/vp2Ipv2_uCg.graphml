<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ALEXA</data>
      <data key="d6">AlexaForBusiness</data>
      <data key="d7">Alexa voice interface channel for user interactions.</data>
    </node>
    <node id="1">
      <data key="d5">LEX</data>
      <data key="d6">Lex</data>
      <data key="d7">Conversational AI service managing bot dialog and intent recognition.</data>
    </node>
    <node id="2">
      <data key="d5">WEB PAGE / BOT</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Split web UI interface embedding the chatbot frame with web content.</data>
    </node>
    <node id="3">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API management layer routing requests between Lex and backend search services.</data>
    </node>
    <node id="4">
      <data key="d5">POLLY</data>
      <data key="d6">Polly</data>
      <data key="d7">Text-to-speech service converting text responses into spoken audio.</data>
    </node>
    <node id="5">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Full-text search engine providing Q&amp;A and web content indexing.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage backing the Q&amp;A bot administrative interface and data lake storage.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute executing backend business logic and capturing analytics events.</data>
    </node>
    <node id="8">
      <data key="d5">KINESIS</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Streaming data pipeline ingesting user interaction and search analytics.</data>
    </node>
    <node id="9">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query service used to analyze chat and search analytics data.</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lex updates and interacts with the web page and bot frame UI.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lex sends search queries to API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes search queries to Elasticsearch.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Elasticsearch interaction records pass to Lambda for processing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda forwards analytics event streams to Kinesis.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis feeds analytics data for querying via Athena.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">American Heart Association Omnichannel Search and Q&amp;A Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=vp2Ipv2_uCg</data>
    <data key="d2">Architecture describing the omnichannel Q&amp;A bot and analytics pipeline used by the American Heart Association.</data>
    <data key="d3">ai_ml</data>
    <data key="d4">True</data>
  </graph>
