  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores unstructured vendor catalogs.</data>
    </node>
    <node id="1">
      <data key="d5">STEP FUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates machine learning pipelines for catalog structuring.</data>
    </node>
    <node id="2">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs custom Named Entity Recognition (NER) models to extract product attributes.</data>
    </node>
    <node id="3">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Acts as the search engine for free-text queries on the portal.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Primary database storing structured product attribute data.</data>
    </node>
    <node id="5">
      <data key="d5">NEPTUNE</data>
      <data key="d6">Neptune</data>
      <data key="d7">Graph database storing triplets for product recommendations.</data>
    </node>
    <node id="6">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API gateway interfacing the custom frontend shopping portal with backend Lambda functions.</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes backend logic for search, product lookup, recommendations, and stream processing.</data>
    </node>
    <node id="8">
      <data key="d5">KINESIS</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Captures real-time anonymized user clickstream and navigation interaction data.</data>
    </node>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions reads unstructured vendor catalogs stored in S3.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions writes converted structured product attribute data into DynamoDB via Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker processes vendor catalogs stored in S3 using custom NER pipelines.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker pipeline status and output events managed via Step Functions and Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB Streams triggers Lambda to sync structured product updates into Elasticsearch.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB Streams triggers Lambda to create/update product triplets in Neptune.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway receives frontend user interactions and invokes Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda queries Elasticsearch for user free-text searches.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda fetches product attribute details from DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda fetches product recommendations and complementary items from Neptune.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Kinesis streams anonymized user navigation events into Lambda to continuously update recommendations.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
