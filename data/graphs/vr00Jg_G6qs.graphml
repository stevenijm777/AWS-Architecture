<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DFD Website</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Digital Front Door patient web portal providing 24/7 access to health information and services.</data>
    </node>
    <node id="1">
      <data key="d5">CMS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Content Management System storing website content for DFD Website.</data>
    </node>
    <node id="2">
      <data key="d5">Search UI</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Web search component embedded in the DFD Website.</data>
    </node>
    <node id="3">
      <data key="d5">Advisor Portal</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Clinician web portal for managing patient records and pre-filtering care.</data>
    </node>
    <node id="4">
      <data key="d5">Health Information Platform</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Backend platform containing clinician patient records.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes Amazon Kendra search index APIs to the Search UI.</data>
    </node>
    <node id="6">
      <data key="d5">Kendra</data>
      <data key="d6">Kendra</data>
      <data key="d7">Amazon Kendra intelligent search index scaling across 1M+ healthcare documents with natural language processing.</data>
    </node>
    <node id="7">
      <data key="d5">Static Resource</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Static web resources directly crawled by Kendra's built-in web crawler.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing dynamic crawled documents for Kendra ingestion.</data>
    </node>
    <node id="9">
      <data key="d5">Dynamic Resource</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Dynamic healthcare websites and resources crawled by custom Lambda worker.</data>
    </node>
    <node id="10">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Custom serverless crawler fetching dynamic web resources and populating S3.</data>
    </node>
    <node id="11">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB database acting as a state store and queue for the Lambda crawler.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">DFD Website pulls content from CMS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">DFD Website embeds Search UI component.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Advisor Portal pulls patient records from Health Information Platform.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway feeds Kendra search results to Search UI.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Kendra search index provides query capabilities via API Gateway (1M+ documents).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Kendra built-in web crawler directly crawls static resources.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Kendra seamlessly pulls crawled dynamic documents from S3 into search index.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Custom Lambda crawler fetches data from dynamic web resources.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda custom crawler uses DynamoDB as a queue and state manager.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda stores extracted dynamic documents into S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Orion Health Digital Front Door Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=vr00Jg_G6qs</data>
    <data key="d2">Orion Health's Digital Front Door (DFD) architecture uses Amazon Kendra for NLP-powered searching across millions of healthcare documents, combining built-in static crawling and custom Lambda dynamic web crawling via S3.</data>
    <data key="d3">Healthcare, Intelligent Search, Web Applications</data>
    <data key="d4">True</data>
  </graph>
