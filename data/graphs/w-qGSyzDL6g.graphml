<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts phone call speech to text using the Redaction API to remove PII such as names, emails, and phone numbers.</data>
    </node>
    <node id="1">
      <data key="d5">Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers transcript streams for 1 minute before writing chunked files to S3.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores 1-minute transcript text files emitted by Kinesis Data Firehose.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 bucket events to retrieve container info from ECR and submit jobs to AWS Batch.</data>
    </node>
    <node id="4">
      <data key="d5">Batch</data>
      <data key="d6">Batch</data>
      <data key="d7">Orchestrates ML inference job queues and container runs for transformer-based deep learning models.</data>
    </node>
    <node id="5">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Compute cluster auto-scaled up during high traffic and down to zero at night by AWS Batch.</data>
    </node>
    <node id="6">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Delivers near real-time predictions to downstream subscriber teams within 5 minutes of call ending.</data>
    </node>
    <node id="7">
      <data key="d5">GitLab</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">CI/CD pipeline combining Python code and S3 model weights to build image containers.</data>
    </node>
    <node id="8">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores container images tagged to specific GitLab commits and model weight versions.</data>
    </node>
    <node id="9">
      <data key="d5">FH</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers model prediction streams before writing to long-term storage.</data>
    </node>
    <node id="10">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Persistent data lake for data scientists to run analytics using Spark and Presto.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Transcribe sends redacted conversation text to Kinesis Data Firehose.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Firehose outputs 1-minute transcript files into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 file upload triggers Lambda function execution.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda submits inference job to AWS Batch job queue.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Batch dynamically scales ECS compute cluster up/down and schedules tasks.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Batch outputs prediction data into Firehose.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Inference predictions from ECS tasks are published to SNS topic.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">GitLab pipeline builds container images and pushes them to ECR.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Batch pulls model container image definitions from ECR.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Firehose writes prediction streams into S3 Data Lake.</data>
      <data key="d10">5'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Zillow Real-Time ML Inference Architecture from Call Transcripts</data>
    <data key="d1">https://www.youtube.com/watch?v=w-qGSyzDL6g</data>
    <data key="d2">Zillow uses AWS Transcribe, Kinesis Data Firehose, S3, Lambda, AWS Batch, ECS, and SNS to perform near real-time ML inference on phone call transcripts, achieving up to 75% compute cost savings by auto-scaling compute from zero to peak traffic.</data>
    <data key="d3">AI/ML, Serverless, Data Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
