<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API Gateway fronting incoming traffic from handheld devices, external systems, and facility scanners.</data>
    </node>
    <node id="1">
      <data key="d5">SQS Ingest</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS queue buffering incoming package creation intent messages.</data>
    </node>
    <node id="2">
      <data key="d5">SQS Event</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS queue buffering status and tracking lifecycle events (pickup, facility scans, delivery status).</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing images captured during redimensioning and reweighing scans.</data>
    </node>
    <node id="4">
      <data key="d5">INGEST</data>
      <data key="d6">Lambda</data>
      <data key="d7">Ingestion Lambda processing package creation declarations.</data>
    </node>
    <node id="5">
      <data key="d5">EVENT PROC</data>
      <data key="d6">Lambda</data>
      <data key="d7">Event Processing Lambda executing tailored business logic for varied package lifecycle events.</data>
    </node>
    <node id="6">
      <data key="d5">IMAGE PROC</data>
      <data key="d6">Lambda</data>
      <data key="d7">Image Processing Lambda handling image metadata and creating image links in RDS.</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS database acting as the single source of truth for package status and history.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Gateway routes initial package intent metadata JSON into the SQS Ingest queue.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Gateway receives lifecycle event updates from driver handhelds and forwards them to SQS Event queue.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Gateway uploads captured package scan images to S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SQS Ingest queue triggers INGEST Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS Event queue triggers EVENT PROC Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 image creation triggers IMAGE PROC Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">INGEST Lambda writes initial relational package records into RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EVENT PROC Lambda updates package event states in RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">IMAGE PROC Lambda writes a reference link to the S3 image into RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Purolator Package Ingestion and Event Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=wE3TmHxyRdA</data>
    <data key="d2">Architectural overview of Purolator's serverless package handling pipeline capable of processing 5 million package events daily, decoupling ingestion, lifecycle event processing, and package dimension image metadata into RDS.</data>
    <data key="d3">E-commerce &amp; Logistics, Serverless, Event-Driven Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
