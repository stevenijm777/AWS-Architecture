<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Electric Vehicle</data>
      <data key="d6">UserConsumerEdge</data>
      <data key="d7">3-wheelers and 4-wheelers pushing telemetry data via MQTT / TCP IP.</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Entry load balancer handling incoming vehicle connection traffic.</data>
    </node>
    <node id="2">
      <data key="d5">Broker</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance running an MQTT/TCP broker.</data>
    </node>
    <node id="3">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Data stream retaining telemetry payloads for up to 3 days.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes Kinesis events; splits immediate alerts from long-term storage.</data>
    </node>
    <node id="5">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Notification service delivering critical vehicle alerts.</data>
    </node>
    <node id="6">
      <data key="d5">Fleet OP</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Fleet operators monitoring real-time notifications and fleet insights.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Single source of truth data lake holding terabytes of telemetry data.</data>
    </node>
    <node id="8">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Scans, curates, and transforms raw data (e.g. driver rating algorithms).</data>
    </node>
    <node id="9">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query engine driving operational dashboards.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry sent over MQTT or TCP/IP</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes incoming load to broker</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Pushes message payload to Kinesis stream</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers Lambda for processing incoming events</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends geofencing and vehicle alert events to SNS</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Stores telemetry data into S3 data lake bucket</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Delivers real-time notifications to Fleet Operator</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue scans raw telemetry data from S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries structured and curated telemetry data in S3</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue writes curated data (e.g. driver rating reports) back to S3</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Presents query results and dashboard insights to Fleet Operator</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mahindra Electric Connected Vehicle Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=wbh51O3QrE4</data>
    <data key="d2">Architecture processes millions of e-kilometers of vehicle data for real-time alerting and long-term fleet analytics.</data>
    <data key="d3">IoT / Telemetry Data Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
