<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Initiates email support request for customer service or technical support.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Simple Email Service (SES)</data>
      <data key="d6">SES</data>
      <data key="d7">Receives inbound customer emails and triggers storage and workflow events.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Simple Storage Service (S3)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores original email contents, subject, text, and attachments.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Maintains contact state across back-and-forth email turns and stores Bedrock model configurations.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Omnichannel contact center platform routing tasks/emails to available agents.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Bedrock</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Generative AI service generating response recommendations for agents based on prompts and fine-tuning configs.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Translates incoming emails between customer and agent natural languages.</data>
    </node>
    <node id="7">
      <data key="d5">Agent</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Customer support representative reviewing emails and choosing generated responses.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Customer sends email to customer service email address.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SES stores raw email content and attachments into S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">SES creates/updates email turn state and metadata record in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SES triggers contact task creation in Amazon Connect to route email.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Agent views email content and attachments loaded from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Agent views email metadata and historical turn state loaded from DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Bedrock references model configuration and prompt settings stored in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">3</data>
      <data key="d9">Bedrock accesses context content stored in S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Bedrock returns suggested email response options to agent.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Translate returns translated email text back to agent interface.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Agent signals availability in Connect interface to accept incoming tasks.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Agent requests translation of email into agent's natural language.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Agent requests response recommendations from Amazon Bedrock.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cloud Adhesive Connect Path Email &amp; AI Orchestration Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=weT3nKnOFDg</data>
    <data key="d2">This architecture extends Amazon Connect with email handling, automated state tracking, translation via Amazon Translate, and LLM-assisted agent recommendations via Amazon Bedrock.</data>
    <data key="d3">AI/ML, Contact Center, Serverless Integration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
