<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Independent Insurance Agents</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Access the insurance platform from external browsers/devices.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Delivers the SPA and routes API gateway requests to the backend.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Web Assets Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the static files (HTML, CSS, JavaScript) for the Single Page Application.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Main API entrypoint handling traffic routing and authorizing requests via custom authorizer.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda Authorizer</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates user access tokens for securing APIs.</data>
    </node>
    <node id="5">
      <data key="d5">Core Backend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless Python Lambda performing business logic and managing legacy fallbacks.</data>
    </node>
    <node id="6">
      <data key="d5">Legacy Tomcat Server</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances running Tomcat with Java application for unmigrated functionality.</data>
    </node>
    <node id="7">
      <data key="d5">Session Cache DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Regional DynamoDB table used to cache agent session data across multiple Availability Zones.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Agents access the website URL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="1">
      <data key="d8">1</data>
      <data key="d9">SPA sends API request payload.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront retrieves static SPA assets from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront serves the SPA to the agent's browser.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="1">
      <data key="d8">2</data>
      <data key="d9">CloudFront delivers backend response to the agent.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront forwards API calls to API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 returns web assets to CloudFront.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway triggers Lambda Authorizer for authorization token validation.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes authorized payload to core backend Python Lambda.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway forwards the response to CloudFront.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Authorizer returns IAM policy to authorize the call.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Backend Lambda reads or writes session data in DynamoDB cache.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">For unmigrated services, Lambda routes requests to legacy Tomcat Java app on EC2.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Backend Lambda returns final payload response to API Gateway.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Tomcat app returns legacy response back to Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Main Street America Insurance: The Independent Agent Portal, Breaking up the Monolith</data>
    <data key="d1">https://www.youtube.com/watch?v=wjtSHyENv0I</data>
    <data key="d2">Legacy Tomcat application on EC2 is being slowly strangled (migrated) to serverless Python Lambdas. Shut down 25 on-prem servers, increased user satisfaction by 25%, and saw 10% user growth.</data>
    <data key="d3">Migration, Serverless, Web Application</data>
    <data key="d4">True</data>
  </graph>
</graphml>
