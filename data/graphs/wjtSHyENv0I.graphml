<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Independent Agents</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Agents accessing the modernized Main Street America insurance application.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Caches and serves the single-page application (SPA) globally, routing API traffic to API Gateway.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Web Assets Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the static frontend SPA assets.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Serves as the single API entry point for all backend services.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda Authorizer</data>
      <data key="d6">Lambda</data>
      <data key="d7">Custom Lambda authorizer used to validate user credentials and authorize access requests.</data>
    </node>
    <node id="5">
      <data key="d5">Business Logic Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Modernized Python serverless backend running core business workflows.</data>
    </node>
    <node id="6">
      <data key="d5">Tomcat App Servers (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Legacy Tomcat application hosting unmigrated functionality such as legacy user management.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB Session Cache</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Regional DynamoDB database caching user session data across multiple Availability Zones.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests single-page application web assets.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="1">
      <data key="d8">1</data>
      <data key="d9">User sends dynamic API traffic to CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront retrieves static SPA assets from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront routes backend API calls to API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway triggers Lambda authorizer to authenticate user.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway forwards authorized dynamic requests to the python microservice Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda reads and writes cached user session info.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Python Lambda delegates unmigrated calls to legacy Tomcat application.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Legacy Tomcat application returns payload back to modern serverless backend.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">American Family Group - Main Street America Agent Portal Modernization</data>
    <data key="d1">https://www.youtube.com/watch?v=wjtSHyENv0I</data>
    <data key="d2">Modernization architecture showing the migration from on-premises Tomcat servers to a serverless AWS backend with S3, CloudFront, API Gateway, Lambda, and DynamoDB.</data>
    <data key="d3">Migration, Serverless, Web Application</data>
    <data key="d4">True</data>
  </graph>
</graphml>
