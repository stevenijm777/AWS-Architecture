  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Agents</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Independent insurance agents accessing the web application.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Amazon CloudFront CDN delivering SPA static content and routing API traffic.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket hosting static Single Page Application (SPA) files.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Amazon API Gateway handling backend REST API requests.</data>
    </node>
    <node id="4">
      <data key="d5">Authorizer</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function serving as API Gateway Authorizer to validate user access.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless Python AWS Lambda function executing core application business logic.</data>
    </node>
    <node id="6">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Amazon EC2 instance hosting legacy Tomcat Java application for un-migrated functionality.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Regional Amazon DynamoDB database caching user session information.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Agents request single page application from CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront fetches static web assets from S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront serves SPA assets back to agents.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront forwards API calls to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway calls Lambda Authorizer to validate agent access.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes authorized API requests to backend Lambda function.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda caches and retrieves user session data from DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda calls legacy Tomcat application on EC2 for un-migrated functionality.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Legacy application on EC2 responds back to Lambda.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">American Family Group Main Street America Modernization Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=wjtSHyENv0I</data>
    <data key="d2">Modernization architecture replacing legacy on-premise Apache/Tomcat setup with AWS S3, CloudFront, API Gateway, Lambda, and DynamoDB while iteratively strangling the legacy application on EC2.</data>
    <data key="d3">Migration &amp; Modernization, Serverless, Web Application</data>
    <data key="d4">True</data>
  </graph>
