<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Clinic</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Houses dialysis devices generating patient telemetry every 10 seconds.</data>
    </node>
    <node id="1">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Kafka topics staging real-time dialysis machine payloads.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Data Streams</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingests data from Kafka via Kinesis Kafka Connector.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda 1</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes Kinesis data streams and routes payloads to analytics and data lake.</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers dynamic stream payloads for ingestion into S3 big data lake.</data>
    </node>
    <node id="5">
      <data key="d5">Data Center</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Hosts enterprise data warehouse containing static clinical datasets.</data>
    </node>
    <node id="6">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Extracts clinical datasets from EDW, builds static features, and loads to S3.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Big data lake storage for analytics, machine learning, and static clinical features.</data>
    </node>
    <node id="8">
      <data key="d5">Kinesis Data Analytics</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Combines dynamic machine data and static clinical data to build full ML features in near real time.</data>
    </node>
    <node id="9">
      <data key="d5">Lambda 2</data>
      <data key="d6">Lambda</data>
      <data key="d7">Receives compiled feature lists, invokes SageMaker for inference, and writes prediction results to Elasticsearch.</data>
    </node>
    <node id="10">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Hosts predictive ML model for intradialytic hypotension risk scoring.</data>
    </node>
    <node id="11">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Stores inference results and powers Kibana dashboards.</data>
    </node>
    <node id="12">
      <data key="d5">Clinical User</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Monitors patient risk probabilities near real time via Kibana.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Transmits dialysis machine payloads to Kafka topics every 10 seconds.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Consumes machine payloads via Kinesis Kafka Connector.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Streams messages to Lambda for processing.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Forwards stream payloads to Kinesis Data Analytics.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Routes machine streams to Kinesis Data Firehose for data lake ingestion.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes stream data into S3 data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Extracts clinical datasets from enterprise data warehouse.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Builds static features and loads them into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Provides static clinical feature datasets to Kinesis Data Analytics.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends complete list of features to Lambda 2.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Invokes SageMaker endpoint with patient feature vector.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="11" id="0">
      <data key="d8">0</data>
      <data key="d9">Writes prediction and feature results to Elasticsearch.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Returns intradialytic hypotension probability inference results.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">0</data>
      <data key="d9">Visualizes patient risk probabilities in Kibana for clinical user groups.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Fresenius Medical Care Intradialytic Hypotension Prediction Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=wtl7CrSQnHA</data>
    <data key="d2">This architecture processes real-time telemetry from dialysis machines alongside static clinical data from an enterprise data warehouse to predict intradialytic hypotension incidents using SageMaker and visualize risk scores in Elasticsearch/Kibana.</data>
    <data key="d3">Healthcare Near-Real-Time Analytics Predictive Modeling</data>
    <data key="d4">True</data>
  </graph>
