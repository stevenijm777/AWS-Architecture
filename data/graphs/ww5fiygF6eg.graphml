<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">3rd Party Drone Software</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores images captured by drone pilots and provides an API for image retrieval.</data>
    </node>
    <node id="1">
      <data key="d5">CloudWatch Event</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Runs on a scheduled basis to trigger the image retrieval process.</data>
    </node>
    <node id="2">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates three separate Lambda functions for workflow management.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda Functions</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes API queries to check for new images, downloads imagery to S3, and creates raster proxies.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores full resolution drone imagery and raster proxy files.</data>
    </node>
    <node id="5">
      <data key="d5">Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">Allows on-premises mapping software to read directly from S3 bucket without software modification.</data>
    </node>
    <node id="6">
      <data key="d5">On-Prem Mapping Server</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Runs local mapping software accessed by internal end users.</data>
    </node>
    <node id="7">
      <data key="d5">On-Prem Database</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Stores raster proxies containing URL information for images.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">New drone images are downloaded into the S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch Event periodically triggers the Step Functions workflow.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions orchestrates execution of Lambda functions.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda polls third-party software API to check for new flights/images.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda processes images and writes raster proxies to S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda stores raster proxy references in the on-premises database.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Storage Gateway reads requested image files directly from S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Mapping server queries database to read raster proxy URLs.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Mapping server uses raster proxy paths to request images via Storage Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Marathon Oil Serverless Drone Imagery Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ww5fiygF6eg</data>
    <data key="d2">Architecture processes drone imagery from third-party pilots, stores high-res images in AWS S3, generates raster proxies via AWS Lambda, and serves images back to legacy on-premise mapping software using AWS Storage Gateway.</data>
    <data key="d3">Serverless, Data Ingestion, Hybrid Cloud Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
