  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End users accessing enterprise applications</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">AWS Application Load Balancer distributing incoming traffic across Availability Zones</data>
    </node>
    <node id="2">
      <data key="d5">ZSCALER</data>
      <data key="d6">EC2</data>
      <data key="d7">Zscaler cloud security broker running on EC2, enforcing user-to-application granular access control integrated with Azure AD MFA</data>
    </node>
    <node id="3">
      <data key="d5">FIREWALL</data>
      <data key="d6">EC2</data>
      <data key="d7">Firewall EC2 instance processing B2B traffic from modern trade partners and customers</data>
    </node>
    <node id="4">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF inspecting web application traffic routed from the firewall</data>
    </node>
    <node id="5">
      <data key="d5">ON-PREM</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Legacy on-premises data center host</data>
    </node>
    <node id="6">
      <data key="d5">DX</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">AWS Direct Connect providing dedicated connection between on-premises and AWS cloud workloads</data>
    </node>
    <node id="7">
      <data key="d5">GUARDDUTY</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">AWS GuardDuty continuously monitoring VPC infrastructure and transaction logs</data>
    </node>
    <node id="8">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function filtering critical GuardDuty security alerts</data>
    </node>
    <node id="9">
      <data key="d5">Mobile Alert App</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party mobile chat application receiving real-time group security alerts</data>
    </node>
    <node id="10">
      <data key="d5">ENT. APPS SAP</data>
      <data key="d6">EC2</data>
      <data key="d7">Enterprise application workloads, including SAP, running on standardized EC2 instances</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">End users send application requests to ALB</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes internal user requests to Zscaler</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes B2B partner and customer requests to Firewall</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Zscaler forwards authenticated and authorized user traffic directly to enterprise applications</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Firewall passes incoming B2B web traffic to AWS WAF for inspection</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Inspected B2B traffic is delivered to Enterprise Applications</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">On-premises data center sends network traffic over AWS Direct Connect</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Direct Connect routes traffic securely to cloud applications via Zscaler layer</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">GuardDuty triggers Lambda upon detecting security threats</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda filters critical alerts and sends instant notifications to mobile chat app</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Tata Global Beverages AWS Enterprise Application Migration &amp; Security Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=wzGYJ6BB0iY</data>
    <data key="d2">Architecture showing Tata Global Beverages' migration of enterprise workloads to AWS, featuring dual ingress paths (Zscaler for internal users, Firewall+WAF for B2B/partners), Direct Connect hybrid link, and automated security alerting via GuardDuty, Lambda, and mobile chat app.</data>
    <data key="d3">Migration, Security, Hybrid Cloud</data>
    <data key="d4">True</data>
  </graph>
