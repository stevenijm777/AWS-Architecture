<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">METACLUSTER</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2-based meta cluster running the control plane management for multiple Kubernetes clusters.</data>
    </node>
    <node id="1">
      <data key="d5">K8S Cluster 1</data>
      <data key="d6">EC2</data>
      <data key="d7">Control plane for the first Kubernetes cluster instance.</data>
    </node>
    <node id="2">
      <data key="d5">K8S Cluster 2</data>
      <data key="d6">EC2</data>
      <data key="d7">Control plane for the second Kubernetes cluster instance.</data>
    </node>
    <node id="3">
      <data key="d5">ELB 1</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer routing incoming traffic across node group instances for cluster 1.</data>
    </node>
    <node id="4">
      <data key="d5">ELB 2</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer routing traffic to node group instances for cluster 2.</data>
    </node>
    <node id="5">
      <data key="d5">App 1 EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker node EC2 instance in cluster 1 running Application 1.</data>
    </node>
    <node id="6">
      <data key="d5">App 2 EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker node EC2 instance in cluster 1 running Application 2.</data>
    </node>
    <node id="7">
      <data key="d5">Node Group EC2 Right</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker node EC2 instance belonging to cluster 2 node group.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">METACLUSTER provisions and manages K8S Cluster 1 control plane.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">METACLUSTER provisions and manages K8S Cluster 2 control plane.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">ELB 1 routes network traffic to App 1 EC2 instance.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">ELB 1 routes network traffic to App 2 EC2 instance.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Datadog Kubernetes Scaling Architecture with Meta Cluster</data>
    <data key="d1">https://www.youtube.com/watch?v=wzj2VQutJws</data>
    <data key="d2">Datadog uses a custom 'Meta Cluster' on EC2 to deploy and manage control planes for multiple individual Kubernetes clusters. Each Kubernetes cluster manages node groups backed by Auto Scaling Groups on EC2, load balanced via ELBs.</data>
    <data key="d3">Compute, Networking, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
