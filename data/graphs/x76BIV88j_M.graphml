<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile application used by riders and drivers to request and manage real-time rides.</data>
    </node>
    <node id="1">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">AWS Route 53 used for DNS resolution and IP geolocation routing across multiple countries.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancing layer distributing client traffic to backend compute clusters.</data>
    </node>
    <node id="3">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 cluster running Nomad container scheduler hosting over 700 microservices.</data>
    </node>
    <node id="4">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS managed Kubernetes cluster used as the target platform for migrating workloads from Nomad.</data>
    </node>
    <node id="5">
      <data key="d5">SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">Spot Instances used to optimize costs by 50% and build resilient microservices tolerant to node interruption.</data>
    </node>
    <node id="6">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS (MySQL) hosting per-service databases for real-time transactional persistence.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 object storage used for long-term archiving of cold ride data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile app resolves domain name via Route 53 using IP geolocation routing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile app sends API traffic to Elastic Load Balancing.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ELB routes incoming traffic to microservices running on the Nomad/EC2 cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ELB routes incoming traffic to microservices running on the EKS cluster.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration vector representing transition of microservices from Nomad to EKS.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Microservices on Nomad cluster write transactional data to dedicated RDS MySQL instances.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Microservices on EKS cluster write transactional data to dedicated RDS MySQL instances.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cabify Mobile Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=x76BIV88j_M</data>
    <data key="d2">Architecture layout for Cabify's real-time ride platform servicing riders and drivers, detailing IP geolocation DNS routing, load balancing, container cluster migration from Nomad to EKS, Spot instance usage for cost/fault testing, and multi-tier persistence across RDS and S3.</data>
    <data key="d3">Mobile Architecture, Cloud Migration, Microservices, Container Orchestration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
