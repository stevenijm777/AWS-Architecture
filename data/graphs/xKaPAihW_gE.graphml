<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile application used by fans to vote on plays and interact with live games.</data>
    </node>
    <node id="1">
      <data key="d5">ALB (REST API)</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer handling REST API traffic.</data>
    </node>
    <node id="2">
      <data key="d5">ALB (Voting)</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer handling fan voting traffic.</data>
    </node>
    <node id="3">
      <data key="d5">EKS Cluster</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs microservices managing game operations, REST APIs, voting, and scoring.</data>
    </node>
    <node id="4">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues fan votes and API events for asynchronous worker processing.</data>
    </node>
    <node id="5">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Caches user session data to relieve pressure on the database.</data>
    </node>
    <node id="6">
      <data key="d5">Aurora Database</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores persistent game data, user accounts, and scores.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends REST API requests from mobile application.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends play votes from mobile application.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes REST API traffic to EKS Kubernetes pods.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Routes vote traffic to voting microservices in EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Voting and REST services publish events to SQS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Microservices store and retrieve user session state in ElastiCache.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">4</data>
      <data key="d9">Microservices persist long-term game state and data in Aurora.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Scoring and gaming microservices pull messages from SQS.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Your Call Football Real-Time Gaming Backend</data>
    <data key="d1">https://www.youtube.com/watch?v=xKaPAihW_gE</data>
    <data key="d2">Interactive live football game architecture using EKS microservices, dual ALBs, SQS messaging, ElastiCache session caching, and Aurora persistent storage.</data>
    <data key="d3">Containers, Mobile Backend</data>
    <data key="d4">True</data>
  </graph>
</graphml>
