<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Receives clickstream HTTP requests from web users.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda (Ingest)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes request handling forwarded from ALB.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis FH</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers and streams clickstream records into S3 Data Lake.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central raw and transformed data lake.</data>
    </node>
    <node id="4">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Maintains schema catalog by crawling S3 tables.</data>
    </node>
    <node id="5">
      <data key="d5">Airflow</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Scheduler for Athena CTAS data transformation jobs.</data>
    </node>
    <node id="6">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Executes CTAS queries for data cleansing and transformation.</data>
    </node>
    <node id="7">
      <data key="d5">Console</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">User interface for business/data analysts to query Athena directly.</data>
    </node>
    <node id="8">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse storing transformed and aggregated data for BI dashboards.</data>
    </node>
    <node id="9">
      <data key="d5">BI Tools</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Dashboards and reporting tools for business users.</data>
    </node>
    <node id="10">
      <data key="d5">Lambda (BI Refresh)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Scheduled headless browser Lambda function simulating manual dashboard refreshes.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards clickstream requests to Ingest Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingest Lambda writes clickstream records to Kinesis Firehose.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Firehose delivers batched clickstream data into S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Aggregated datasets in S3 are loaded/queried into Redshift.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue crawler scans S3 data to update table schemas in the Data Catalog.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Airflow orchestrates and schedules CTAS transformation jobs in Athena.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena reads raw S3 data and writes transformed/cleansed datasets back to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Data analysts run ad-hoc queries on Athena through the Console.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Redshift serves aggregated datasets to BI Tools for visualization.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Scheduled Lambda triggers automated headless browser refresh on BI Tool dashboards.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">HK01 Serverless Data Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=yPJf85tjv6M</data>
    <data key="d2">HK01's serverless data analytics architecture processes clickstream ingestion via ALB, Lambda, Kinesis Firehose to S3, uses Glue for data cataloging, Airflow + Athena for transformations, Redshift for data warehousing, and automated Lambda headless browser for BI Tool refreshes.</data>
    <data key="d3">Serverless Data Analytics &amp; Data Lake</data>
    <data key="d4">True</data>
  </graph>
</graphml>
