<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Device</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Genomics IoT device communicating via MQTT over TLS.</data>
    </node>
    <node id="1">
      <data key="d5">IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests device data and uses rules engine to route messages.</data>
    </node>
    <node id="2">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Stores telemetry and commercial/BI data for querying and visualization.</data>
    </node>
    <node id="3">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors platform logs and sets alarms.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Worker process that performs computations and returns feedback to IoT Core.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues messages to decouple IoT device communication from backend processing.</data>
    </node>
    <node id="6">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Backend container compute processing queued messages and serving API.</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database used for long-term data storage.</data>
    </node>
    <node id="8">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory caching layer for quick access to short-term data.</data>
    </node>
    <node id="9">
      <data key="d5">Scientists</data>
      <data key="d6">UserCompanyDomainExpert</data>
      <data key="d7">End-user scientists interacting with web application and API.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">TLS/MQTT connection from IoT device to AWS IoT Core.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">IoT Core Rules Engine routes telemetry data to Elasticsearch for visualization and BI.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">IoT Core Rules Engine sends logs and operational metrics to CloudWatch for logging and alarms.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">IoT Core invokes Lambda to perform processing as a worker.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">IoT Core routes user interaction messages to SQS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda returns processed response back to IoT Core/device.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">ECS polls/consumes messages from SQS to process device data decoupled from ingestion.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">ECS persists long-term genomics and API data in RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">ECS caches short-term/fast access data in ElastiCache.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Scientists access API and web application backed by ECS compute.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Miraculous Genomics IoT Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=yPV-3vjHshk</data>
    <data key="d2">Architecture for ingesting genomics IoT device data into AWS IoT Core, processing worker workflows via Lambda and ECS, routing metrics/logs to Elasticsearch and CloudWatch, storing long/short term data in RDS and ElastiCache, and serving scientists.</data>
    <data key="d3">IoT, Biotech, Data Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
