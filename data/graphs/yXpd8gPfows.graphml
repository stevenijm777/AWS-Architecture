<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Email Inbox</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External email source where insurance policy documents and attachments are received.</data>
    </node>
    <node id="1">
      <data key="d5">Pre-processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Pulls emails and attachments from the inbox and kicks off the processing flow.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central storage bucket for raw input files, intermediate processing outputs, and final extraction payloads.</data>
    </node>
    <node id="3">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Performs classification and named entity recognition (e.g., dates, names, organizations).</data>
    </node>
    <node id="4">
      <data key="d5">Textract</data>
      <data key="d6">Textract</data>
      <data key="d7">Extracts text and table structures from standard policy documents page by page.</data>
    </node>
    <node id="5">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs custom trained ML models for extracting data from highly specialized or complex form formats.</data>
    </node>
    <node id="6">
      <data key="d5">Post-processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Stitches multi-page table extractions together and normalizes field synonyms.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores synonym lookup tables and structured output data.</data>
    </node>
    <node id="8">
      <data key="d5">SageMaker Ground Truth</data>
      <data key="d6">SageMakerGroundTruth</data>
      <data key="d7">Routes low-confidence document extractions to domain experts for manual labeling and model retraining.</data>
    </node>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Pre-processing Lambda retrieves emails and attachments from the inbox.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Pre-processing Lambda stores original document files (PDF, Word, Excel) into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Pre-processing Lambda triggers the downstream AI/ML extraction stage.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Textract reads input document files from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker custom model reads document inputs from S3 for custom format processing.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Comprehend reads extracted text from S3 to perform classification and entity recognition.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Comprehend stores classification and entity recognition results into S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Triggers Post-processing Lambda once processing stages are complete.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Textract outputs page-level extraction results back to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker custom model saves extraction results back to S3.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Post-processing Lambda queries DynamoDB for synonym mappings and writes finalized data.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Low-accuracy extraction results are sent to SageMaker Ground Truth for SME review and model retraining.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB returns synonym dictionary data to Post-processing Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">InnoWisdom - Intelligent Document Processing Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=yXpd8gPfows</data>
    <data key="d2">An Intelligent Document Processing (IDP) platform built on AWS serverless and AI/ML services for extracting and standardizing insurance policy data.</data>
    <data key="d3">AI/ML, Document Processing, Serverless Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
