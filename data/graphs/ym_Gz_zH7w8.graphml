<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Peloton member client devices (bikes, treadmills, mobile, TV platforms).</data>
    </node>
    <node id="1">
      <data key="d5">Amazon EKS Hydration Service</data>
      <data key="d6">EKS</data>
      <data key="d7">Backend service used to hydrate recommendation payloads before returning to client.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon EKS Recommendation Service</data>
      <data key="d6">EKS</data>
      <data key="d7">Orchestrator service fetching candidates, features, and model artifacts to generate recommendations.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon EKS Inference Service</data>
      <data key="d6">EKS</data>
      <data key="d7">Scores candidate workouts using the ML model.</data>
    </node>
    <node id="4">
      <data key="d5">Graph Database</data>
      <data key="d6">Neptune</data>
      <data key="d7">Stores member-class interaction graph data to generate candidate lists.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon DynamoDB Feature Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores precomputed member features, instructor preferences, and discipline preferences.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon MSK Event Logging</data>
      <data key="d6">MSK</data>
      <data key="d7">Captures event logs from recommendation interactions for training feedback loops.</data>
    </node>
    <node id="7">
      <data key="d5">Model Registry</data>
      <data key="d6">ModelRegistry</data>
      <data key="d7">Stores trained ML model artifacts.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon S3 Historical Data</data>
      <data key="d6">S3</data>
      <data key="d7">Stores historical workout and interaction data for offline batch training.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon EMR Data Preprocessing</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs Spark jobs to preprocess historical data and populate low-latency feature/graph stores.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon EKS Model Training</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts GPU instances running daily offline model training tasks.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Client sends request to Hydration Service when member starts workout screen.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Hydration service forwards request to Recommendation Service orchestrator.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Hydration Service returns fully populated recommendations to Client.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Recommendation Service fetches candidate workout classes from Graph Database.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Recommendation Service fetches member feature vectors from DynamoDB Feature Store.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Recommendation Service retrieves latest model artifacts from Model Registry.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Recommendation Service sends candidates and features to Inference Service for scoring.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Recommendation Service returns ranked recommendations to Hydration Service.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Recommendation Service logs member interaction events asynchronously to MSK.</data>
      <data key="d10">9</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Inference Service returns scored list of classes back to Recommendation Service.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Logged interaction events persisted from MSK to S3 historical storage feedback loop.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Historical workout data ingested by EMR Spark jobs for preprocessing.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR Spark jobs update and populate Graph Database with member-class edge relations.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR Spark jobs populate feature store in DynamoDB with preprocessed user features.</data>
      <data key="d10">2''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Preprocessed data passed to GPU-enabled EKS cluster for model training.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Trained model artifacts pushed to Model Registry.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Peloton Personalization and Real-Time Recommendation Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ym_Gz_zH7w8</data>
    <data key="d2">Peloton's real-time recommendation system processes over 1 billion workout events across 6.5+ million members. Models are trained daily via offline batch jobs and served in real-time.</data>
    <data key="d3">Machine Learning, Real-Time Recommendation, Analytics</data>
