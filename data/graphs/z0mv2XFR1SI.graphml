  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Game Users</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Samsung Galaxy smartphone users utilizing Game Launcher</data>
    </node>
    <node id="1">
      <data key="d5">Content API</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">API gateway/microservice handling client recommendation queries</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Fast NoSQL database storing filtered video recommendations above threshold score</data>
    </node>
    <node id="3">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Elastic MapReduce cluster filtering and processing video scores from RDS Aurora</data>
    </node>
    <node id="4">
      <data key="d5">RDS Aurora</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database storing video metadata and analyzed game matching scores</data>
    </node>
    <node id="5">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Periodically triggers the Video Analyzer microservice</data>
    </node>
    <node id="6">
      <data key="d5">Video Analyzer</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Extracts text/titles from collected videos and queries Comprehend for classification</data>
    </node>
    <node id="7">
      <data key="d5">Crawler (Content Analysis)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Crawls video content from video source platforms</data>
    </node>
    <node id="8">
      <data key="d5">VIDEO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External video source platforms</data>
    </node>
    <node id="9">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Amazon Comprehend providing Custom Classification model training and inference</data>
    </node>
    <node id="10">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores text dataset used as input for Comprehend model creation</data>
    </node>
    <node id="11">
      <data key="d5">Crawler (Model Creation)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Crawls game-related text from the web and triggers Comprehend model creation</data>
    </node>
    <node id="12">
      <data key="d5">WEB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External web data sources</data>
    </node>
