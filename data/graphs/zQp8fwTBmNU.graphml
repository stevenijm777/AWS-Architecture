<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">7 million users / 2 million SMBs connecting via Browser or Thick Client with NICE DCV.</data>
    </node>
    <node id="1">
      <data key="d5">LOGIN API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API Gateway endpoint in the Admin account receiving authentication requests.</data>
    </node>
    <node id="2">
      <data key="d5">AUTH</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function handling dual authentication logic in the Admin account.</data>
    </node>
    <node id="3">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">AWS Key Management Service managing Customer Master Keys (CMK) for token signing.</data>
    </node>
    <node id="4">
      <data key="d5">TALLY.NET</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Tally.net backend server performing second-level user authentication.</data>
    </node>
    <node id="5">
      <data key="d5">CLOUD FRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CloudFront distribution handling incoming session traffic in the Pod account.</data>
    </node>
    <node id="6">
      <data key="d5">L@E</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Lambda@Edge function routing traffic to the correct ALB across pod accounts.</data>
    </node>
    <node id="7">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer directing session traffic to ECS container targets.</data>
    </node>
    <node id="8">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">ECS cluster managing container workloads running on Linux EC2 instances.</data>
    </node>
    <node id="9">
      <data key="d5">CONTAINER + WINE</data>
      <data key="d6">EC2</data>
      <data key="d7">Linux EC2 instance running Docker container with Wine layer for Tally Prime desktop app.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User initiates authentication request to Login API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">User connects via NICE DCV through CloudFront using authentication token.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Login API Gateway invokes Auth Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Login API returns session authentication token to User.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Auth Lambda verifies credentials with Tally.net backend.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Auth Lambda requests key signing operations from KMS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Auth Lambda returns generated session token to Login API.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">KMS returns cryptographic token materials to Auth Lambda.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront triggers Lambda@Edge for routing dynamic pod selection.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda@Edge routes request to appropriate ALB.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB routes session connection to target Container running Tally Prime with Wine.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS cluster orchestrates and manages container lifecycle on Linux EC2.</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Container re-authenticates active session back with Auth Lambda in Admin account.</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Tally Prime on AWS Multi-Account Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=zQp8fwTBmNU</data>
    <data key="d2">Tally Prime on AWS serves over 7 million users across 2 million SMBs using horizontal scaling with multi-account Pod structures and dual authentication.</data>
    <data key="d3">Compute, Security, Networking &amp; Content Delivery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
