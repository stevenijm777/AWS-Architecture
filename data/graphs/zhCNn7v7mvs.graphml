<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">APP</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">SaaS application where customers create campaigns, define recipient lists, and trigger email sends.</data>
    </node>
    <node id="1">
      <data key="d5">Aurora Postgres</data>
      <data key="d6">Aurora</data>
      <data key="d7">Primary database storing email templates, recipient metadata, and reporting/delivery status.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores generated customer/campaign-specific CSV recipient files.</data>
    </node>
    <node id="3">
      <data key="d5">ElastiCache Redis</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory store hosting a custom job queue system deployed in the remote region.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (Merge)</data>
      <data key="d6">EC2</data>
      <data key="d7">Auto Scaling fleet of EC2 instances that process queued jobs, retrieve CSVs/templates, and perform mail merges.</data>
    </node>
    <node id="5">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Network Load Balancer distributing merged mail payloads to the sending MTA fleet.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 (MTA)</data>
      <data key="d6">EC2</data>
      <data key="d7">Mail Transfer Agent fleet running on reserved EC2 instances with BYOIP for sending IP reputation maintenance.</data>
    </node>
    <node id="7">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams delivery and bounce logs from Kinesis Agent on MTAs back to the main account.</data>
    </node>
    <node id="8">
      <data key="d5">Internet / Recipient</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External email servers and recipient mailboxes on the internet.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">APP queues campaign job into ElastiCache Redis in the sending region.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Extracts recipient metadata from Aurora Postgres and generates CSV file in S3.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Merge EC2 fetches email template from Aurora Postgres.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Merge EC2 fetches recipient CSV file from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Merge EC2 instances pull processing jobs from ElastiCache Redis queue.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Merge EC2 sends merged email payloads through NLB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">NLB routes merged email streams to MTA EC2 fleet.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">MTA instances transmit email messages to internet recipients using BYOIP.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Kinesis Agent on MTA instances pushes delivery/bounce logs to Kinesis Firehose.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Kinesis Firehose delivers processed status logs back to Aurora Postgres in the main account.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">CM Group Email Delivery Subsystem Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=zhCNn7v7mvs</data>
    <data key="d2">Architecture for CM Group's email delivery subsystem capable of sending billions of emails annually and up to 8-10 million messages per hour at peak. Uses multi-region deployment cells with BYOIP for reputation management.</data>
    <data key="d3">Compute, Messaging, Databases &amp; Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
