<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS Manager</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom tool wrapping CloudFormation and GitOps framework for EKS cluster provisioning, infrastructure management, and daemonset governance.</data>
    </node>
    <node id="1">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS cluster hosting Fidelity containerized application workloads across isolated namespaces.</data>
    </node>
    <node id="2">
      <data key="d5">Bootstrapper</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Namespace Bootstrapper CRD extending namespace creation, security integration, secrets management (Vault), and ALB Ingress setup.</data>
    </node>
    <node id="3">
      <data key="d5">EKS Connect</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Go-based wrapper around kubectl ensuring authentication, user validation, and target namespace determination.</data>
    </node>
    <node id="4">
      <data key="d5">RBAC</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Kubernetes Role-Based Access Control enforcing fine-grained user and group permissions within namespaces.</data>
    </node>
    <node id="5">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">AWS IAM service bridging Kubernetes RBAC permissions with AWS identity.</data>
    </node>
    <node id="6">
      <data key="d5">AD</data>
      <data key="d6">DirectoryService</data>
      <data key="d7">Enterprise Active Directory backend handling federated identity and user authentication.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS Manager provisions EKS cluster and manages compute, network, storage, and daemonset resources.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Kubernetes RBAC connects to AWS IAM for role mapping.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS IAM returns authorization details to Kubernetes RBAC.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS IAM integrates with Active Directory for enterprise user authentication.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Active Directory authenticates identity to AWS IAM.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Fidelity Investments - Enterprise Kubernetes on AWS EKS</data>
    <data key="d1">https://www.youtube.com/watch?v=zmJ7rL1iQBY</data>
    <data key="d2">Fidelity Investments built custom abstractions around AWS EKS (Fed EKS) including EKS Manager, Namespace Bootstrapper, and EKS Connect to govern security, identity, and automated cluster provisioning at scale.</data>
    <data key="d3">Containers, Security &amp; Compliance, DevOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
