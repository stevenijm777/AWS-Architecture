<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes REST APIs for management console, uploading, transcoding, scheduling, analysis, and stats.</data>
    </node>
    <node id="1">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes backend API logic and request processing.</data>
    </node>
    <node id="2">
      <data key="d5">STEP FUNCTION</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates VOD workflows and pipelines.</data>
    </node>
    <node id="3">
      <data key="d5">Step Functions Lambdas</data>
      <data key="d6">Lambda</data>
      <data key="d7">Grouped Lambda functions executing tasks like media metadata retrieval, transcode preparation, and composition.</data>
    </node>
    <node id="4">
      <data key="d5">MEDIA CONVERT</data>
      <data key="d6">MediaConvert</data>
      <data key="d7">Performs VOD media transcoding.</data>
    </node>
    <node id="5">
      <data key="d5">FARGATE</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs containerized service that updates channel input schedules for scheduled live broadcasts.</data>
    </node>
    <node id="6">
      <data key="d5">MEDIA LIVE</data>
      <data key="d6">MediaLive</data>
      <data key="d7">Processes real-time RTMP inputs and scheduled VOD live broadcasts.</data>
    </node>
    <node id="7">
      <data key="d5">MEDIA PACKAGE</data>
      <data key="d6">MediaPackage</data>
      <data key="d7">Packages live streams for delivery to consumers.</data>
    </node>
    <node id="8">
      <data key="d5">TRANSCRIBE</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts audio/speech from video content into text.</data>
    </node>
    <node id="9">
      <data key="d5">TRANSLATE</data>
      <data key="d6">Translate</data>
      <data key="d7">Translates transcribed text into multiple languages for subtitles.</data>
    </node>
    <node id="10">
      <data key="d5">REKOGNITION</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Detects labels, explicit content, and specific persons in video frames for auto metadata creation.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers backend Lambda functions upon REST API calls.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions orchestrates execution across multiple functional Lambda tasks.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions workflow invokes MediaConvert for video transcoding.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Fargate application updates input schedule of MediaLive channels.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">MediaLive outputs encoded live streams to MediaPackage.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Transcribed text output is passed to Translate for multi-language subtitle generation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Megazone Cloud - Cloud Flex Media Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=zqiNLMmEeSo</data>
    <data key="d2">Cloud Flex Media is an end-to-end media platform providing REST APIs via API Gateway, VOD transcoding pipelines via Step Functions and MediaConvert, scheduled and real-time live broadcasting via Fargate and MediaLive/MediaPackage, and AI features using Transcribe, Translate, and Rekognition.</data>
    <data key="d3">Media &amp; Entertainment, Serverless, AI/ML</data>
    <data key="d4">True</data>
  </graph>
</graphml>
