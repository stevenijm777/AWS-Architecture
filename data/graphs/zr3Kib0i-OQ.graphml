<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Time-based trigger running every 10 minutes across 4,000 client accounts.</data>
    </node>
    <node id="1">
      <data key="d5">COLLECTOR</data>
      <data key="d6">Fargate</data>
      <data key="d7">Fargate container executing account-based inventory discovery.</data>
    </node>
    <node id="2">
      <data key="d5">S3 (Collector Output)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores output from the collector containers.</data>
    </node>
    <node id="3">
      <data key="d5">DIFF</data>
      <data key="d6">Fargate</data>
      <data key="d7">Fargate engine comparing current account state against previous run.</data>
    </node>
    <node id="4">
      <data key="d5">S3 (Diff Output)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores detected difference output.</data>
    </node>
    <node id="5">
      <data key="d5">PUBLISHER</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function triggered by S3 event to push changes.</data>
    </node>
    <node id="6">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Central Elasticsearch repository holding all cloud resource inventory.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Legacy Collector)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Previous architecture serverless collector function, now replaced by Fargate.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda (Legacy Diff)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Previous architecture serverless diff function, now replaced by Fargate.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch time-based schedule launches the COLLECTOR task.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">COLLECTOR writes output files into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 object creation triggers the DIFF process.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">DIFF process writes detected changes to second S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 event triggers the PUBLISHER Lambda function.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">PUBLISHER pushes change records to Elasticsearch repository.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Accenture Cloud Platform Inventory Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=zr3Kib0i-OQ</data>
    <data key="d2">System processes cloud resource discovery for 4,000 accounts every 10 minutes, using Fargate for collection and diff operations before updating an OpenSearch inventory search repository.</data>
    <data key="d3">Analytics, Compute, Storage, Management and Governance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
