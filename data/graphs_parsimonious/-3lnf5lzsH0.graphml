<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS Log Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Represents various AWS services (e.g., S3, SNS, SQS, CloudTrail, GuardDuty) generating telemetry events which are pulled into the SOC system. Treated as an external log source for this architecture.</data>
    </node>
    <node id="1">
      <data key="d5">On-Premise Data Center</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Represents on-premise log sources integrated via standard syslog or Kafka into the SOC system.</data>
    </node>
    <node id="2">
      <data key="d5">Apache Metron</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">The heart of the next-gen SOC, responsible for data ingest, parsing, enrichment (adding contextual intelligence like geolocation, AS numbers), and profiling telemetry events in real-time. It also generates alerts.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Used to pick up persistent data from Apache Metron's HDFS backbone and transform it for storage in Amazon S3 as part of the Security Data Lake.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">The primary storage for the serverless Security Data Lake, housing telemetry events indexed over a long period (months to years). Enables large-scale, horizontally scalable storage for security forensics and analytics.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Leveraged to build SQL queries and perform analytics, log mining, and forensics on the telemetry data stored in Amazon S3.</data>
    </node>
    <node id="6">
      <data key="d5">SOAR Platform</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">A Security Orchestration, Automation, and Response platform (internally called 'Blitz'). It receives alerts from Apache Metron, enriches them with further contextual information, presents them to SOC analysts, and orchestrates automated or semi-automated responses.</data>
    </node>
    <node id="7">
      <data key="d5">SOC Analysts/Alerts</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Represents the human SOC analysts who receive alerts from the SOAR platform (e.g., via mobile or Jira integration) and interact with the system to investigate and respond to incidents. This node also encapsulates the alerting mechanism itself.</data>
    </node>
    <node id="8">
      <data key="d5">AWS WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">A target for mitigation actions from the SOAR platform, allowing analysts to block malicious sources or implement other security controls at the edge.</data>
    </node>
    <edge source="0" target="2">
      <data key="d8">0</data>
      <data key="d9">Telemetry events and logs from various AWS services (S3, SNS, SQS, CloudTrail, GuardDuty) are ingested into Apache Metron.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">Syslog or Kafka integrated telemetry events from on-premise data centers are ingested into Apache Metron.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">1</data>
      <data key="d9">Persistent data from Apache Metron's HDFS backbone is picked up by an EMR job for further processing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="6">
      <data key="d8">4</data>
      <data key="d9">Alerts generated by Apache Metron (after parsing, enrichment, and profiling) are fed into the SOAR platform for incident response.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="4">
      <data key="d8">1</data>
      <data key="d9">EMR transforms and stores the processed telemetry data into Amazon S3, forming the Security Data Lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="5">
      <data key="d8">2</data>
      <data key="d9">Amazon Athena leverages data in S3 to build SQL queries, perform analytics, log mining, and forensics.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="2">
      <data key="d8">3</data>
      <data key="d9">Feedback loop: Security Data Lake (S3) provides long-term telemetry information to Apache Metron for generating more accurate profiles and models, enhancing real-time enrichment.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="7">
      <data key="d8">4</data>
      <data key="d9">The SOAR platform presents enriched alerts and incident details to SOC analysts (e.g., via mobile or Jira integration) for investigation and triage.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="8">
      <data key="d8">4</data>
      <data key="d9">The SOAR platform triggers automated or semi-automated mitigation actions (e.g., blocking source IPs) on AWS WAF in response to detected threats.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">MakeMyTrip: Building Next Generation SOC</data>
    <data key="d1">https://www.youtube.com/watch?v=xxxxxxxx</data>
    <data key="d2">Architecture for MakeMyTrip's next-generation Security Operations Center (SOC) system, built to detect and respond to advanced attacks using abnormal behavior detection. It integrates hybrid data sources, leverages Apache Metron for real-time processing, a serverless security data lake for long-term storage and analytics, and a SOAR platform for automated incident response.</data>
    <data key="d3">Security, Data Lake, Observability</data>
    <data key="d4">True</data>
  </graph>
</graphml>
