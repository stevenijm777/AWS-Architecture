  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Data Sources</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Syslog and Kafka log streams from on-prem infrastructure.</data>
    </node>
    <node id="1">
      <data key="d5">AWS CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">AWS API telemetry source decomposed from AWS container.</data>
    </node>
    <node id="2">
      <data key="d5">AWS GuardDuty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">AWS threat detection log source decomposed from AWS container.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">AWS queue telemetry source decomposed from AWS container.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">AWS notification telemetry source decomposed from AWS container.</data>
    </node>
    <node id="5">
      <data key="d5">Apache Metron</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Central stream processing engine for log parsing, enrichment, and profiling.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Picks up persistent data and transforms it for storage in S3.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Houses long-term security telemetry data in the Security Data Lake.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Executes SQL queries for log mining, analytics, and forensics.</data>
    </node>
    <node id="9">
      <data key="d5">SOAR (Blitz)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Security Orchestration, Automation, and Response platform.</data>
    </node>
    <node id="10">
      <data key="d5">SOC Analyst / Alerts</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Presents enriched alert details to analysts via single pane of glass / mobile / Jira.</data>
    </node>
    <node id="11">
      <data key="d5">AWS WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Enables push-button response actions like IP blocking.</data>
    </node>
    <edge source="0" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Streams on-prem logs to Apache Metron</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
