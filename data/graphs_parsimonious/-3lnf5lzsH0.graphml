    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Passes persistent telemetry to EMR transformation jobs</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends real-time security alerts to SOAR</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
