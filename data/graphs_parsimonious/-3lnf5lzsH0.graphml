    <edge source="7" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Feedback loop feeds long-term behavioral models back into Apache Metron</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Presents triage alerts to SOC analysts</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
