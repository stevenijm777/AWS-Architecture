<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs multi-tenant SaaS application with isolated pods per tenant.</data>
    </node>
    <node id="1">
      <data key="d5">Postgres Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores tenant application data using separate schemas.</data>
    </node>
    <node id="2">
      <data key="d5">Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Routes traffic from tenant QuickSight accounts to the central database.</data>
    </node>
    <node id="3">
      <data key="d5">Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Automates provisioning of isolated tenant accounts via Account Factory.</data>
    </node>
    <node id="4">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Enables tenant data visualization in isolated single-tenant environments.</data>
    </node>
    <node id="5">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">Establish connection from QuickSight to customer on-premises data sources.</data>
    </node>
    <node id="6">
      <data key="d5">Customer On-Prem Data</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises database containing additional community bank data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS pods write data to tenant database schemas.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Transit Gateway routes queries to Aurora.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">QuickSight initiates queries through Transit Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">QuickSight requests access to local data.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">VPN tunnel routes queries to customer on-prem database.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Summit Technology Group Loan Origination System</data>
    <data key="d1">https://www.youtube.com/watch?v=-ahWdCysMYw</data>
    <data key="d2">A multi-tenant loan origination system leveraging EKS and Aurora, which provisions single-tenant AWS accounts via Control Tower for secure, isolated QuickSight data visualization combined with on-premises customer data.</data>
    <data key="d3">compute_intensive, interactive</data>
    <data key="d4">True</data>
  </graph>
</graphml>
