<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer On-Prem Data</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises database of community banks.</data>
    </node>
    <node id="1">
      <data key="d5">AWS VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">Connects customer on-prem network to AWS account.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualizes combined SaaS and on-prem data per tenant.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Provisions tenant accounts with QuickSight and VPN.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Routes traffic between QuickSight VPC and Aurora database.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Aurora PostgreSQL</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores tenant data in separate database schemas.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs multi-tenant LOS application pods.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">On-prem data transferred over VPN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">VPN forwards on-prem data to QuickSight.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">QuickSight queries Aurora data source via Transit Gateway.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Transit Gateway routes query to Aurora PostgreSQL.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS pods persist tenant loan data to Aurora.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Summit Technology Group - Multi-Tenant Loan Origination Architecture</data>
    <data key="d1" />
    <data key="d2">Single-tenant data consumption model using Control Tower, QuickSight, Transit Gateway, and Aurora.</data>
    <data key="d3">Analytics, Compute, Database, Networking</data>
    <data key="d4">True</data>
  </graph>
</graphml>
