  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Security Engineers</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Security persona monitoring findings</data>
    </node>
    <node id="1">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Dashboard visualization for data owners</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL-based query tool for findings metadata</data>
    </node>
    <node id="3">
      <data key="d5">MySQL Data Lake</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational data store for aggregated findings</data>
    </node>
    <node id="4">
      <data key="d5">Central Amazon S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores central findings metadata</data>
    </node>
    <node id="5">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">ETL process for loading and aggregating data</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Macie (Central)</data>
      <data key="d6">Macie</data>
      <data key="d7">Scans S3 buckets for sensitive data and sends findings</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Macie (Member Account 1)</data>
      <data key="d6">Macie</data>
      <data key="d7">Macie instance in member production account</data>
    </node>
    <node id="8">
      <data key="d5">Amazon S3 (Member Account 1)</data>
      <data key="d6">S3</data>
      <data key="d7">Production storage scanned by Macie</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Macie (Member Account 2)</data>
      <data key="d6">Macie</data>
      <data key="d7">Macie instance in second member account</data>
    </node>
    <node id="10">
      <data key="d5">Amazon S3 (Member Account 2)</data>
      <data key="d6">S3</data>
      <data key="d7">Production storage scanned by Macie</data>
    </node>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">QuickSight reads queried dataset directly via S3/Athena</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries metadata stored in central S3 bucket</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Aggregated data synced back to S3 bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Findings data exported to MySQL Data Lake</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie outputs findings metadata to central S3 bucket</data>
