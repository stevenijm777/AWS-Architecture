<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Security Engineers</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Opportune's security team responsible for analyzing findings and remediating sensitive data issues.</data>
    </node>
    <node id="1">
      <data key="d5">Source Data Buckets</data>
      <data key="d6">S3</data>
      <data key="d7">Multiple S3 buckets across various AWS accounts that store sensitive member data (e.g., SSNs, ITINs, government IDs). These are the targets for Macie scans.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Macie</data>
      <data key="d6">Macie</data>
      <data key="d7">Data discovery and sensitive data classification service. Configured to scan source S3 buckets across multiple accounts for sensitive information and generate findings.</data>
    </node>
    <node id="3">
      <data key="d5">Findings Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">A central S3 bucket where Amazon Macie stores its findings (metadata, not actual sensitive data) after scanning the source data buckets.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">A serverless interactive query service that uses standard SQL to analyze data directly in Amazon S3. Used to query the Macie findings stored in the findings bucket.</data>
    </node>
    <node id="5">
      <data key="d5">MySQL Data Lake</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">A MySQL-based data lake used to store aggregated findings data for further analysis and reporting. This could be an RDS instance or self-managed on EC2.</data>
    </node>
    <node id="6">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">A serverless data integration service used for ETL (extract, transform, and load) operations. Used for automations to process, load, and aggregate findings data into the MySQL data lake.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">A scalable, serverless, ML-powered business intelligence (BI) service. Used to create interactive dashboards from findings data, enabling security engineers to visualize risky buckets and track remediation efforts.</data>
    </node>
    <edge source="0" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Security Engineers access Amazon QuickSight dashboards to review sensitive data findings and inform remediation actions.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Macie scans the source S3 buckets for sensitive data.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Macie stores generated sensitive data findings (metadata) into a dedicated findings S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Athena queries the Macie findings stored in the S3 findings bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Query results from Athena are dropped into the MySQL data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena provides data for QuickSight dashboards to visualize findings.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue automations process, load, and aggregate findings data into the MySQL data lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Opportune's Sensitive Data Discovery and Remediation</data>
    <data key="d1">https://www.youtube.com/watch?v=YOUR_VIDEO_ID_HERE</data>
    <data key="d2">Architecture for discovering, monitoring, and remediating sensitive data (e.g., PII, SSNs, ITINs) stored in S3 buckets across multiple AWS accounts, using Amazon Macie for discovery, Athena and Glue for processing, and QuickSight for visualization and reporting to security engineers.</data>
    <data key="d3">Security, Data Governance, Data Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
