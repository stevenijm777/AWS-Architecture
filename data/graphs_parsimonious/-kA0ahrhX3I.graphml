<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Security Engineers</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal company staff (Security Engineers) who interact with the data analysis and visualization tools.</data>
    </node>
    <node id="1">
      <data key="d5">S3_DataAccounts</data>
      <data key="d6">S3</data>
      <data key="d7">Represents S3 buckets in various AWS accounts containing sensitive data to be scanned by Macie. Deduplicated from multiple S3 icons in the data accounts.</data>
    </node>
    <node id="2">
      <data key="d5">Macie_DataAccounts</data>
      <data key="d6">Macie</data>
      <data key="d7">Represents Amazon Macie instances deployed in multiple AWS accounts to scan S3 buckets for sensitive data. Deduplicated from multiple Macie icons in the data accounts.</data>
    </node>
    <node id="3">
      <data key="d5">S3_Findings</data>
      <data key="d6">S3</data>
      <data key="d7">A central S3 bucket where findings from Macie scans are aggregated and stored.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Macie_Central</data>
      <data key="d6">Macie</data>
      <data key="d7">A central Amazon Macie instance, possibly for managing findings or providing a dashboard, consuming data from the S3 Findings bucket.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Used by Security Engineers to query the Macie findings stored in S3.</data>
    </node>
    <node id="6">
      <data key="d5">MySQL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">A MySQL data lake where processed findings data is stored.</data>
    </node>
    <node id="7">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Used for data processing, loading, and aggregation, working in conjunction with Athena.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Used for visualizing the processed findings and presenting them as dashboards to Security Engineers.</data>
    </node>
    <edge source="0" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Security Engineers interact with Amazon Athena to initiate queries for findings.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Security Engineers access dashboards and reports via Amazon QuickSight.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie in data accounts scans S3 buckets and sends sensitive data findings to the central S3_Findings bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">The central Amazon Macie instance consumes findings data from the S3_Findings bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Athena retrieves data from the S3_Findings bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Athena queries the S3_Findings bucket to retrieve Macie findings.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Athena coordinates with AWS Glue for automated data processing.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Athena can directly output query results into the MySQL data lake.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue reads and writes processed data from/to the S3_Findings bucket.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Glue loads aggregated findings data into the MySQL data lake.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Amazon QuickSight queries Amazon Athena to retrieve data for visualizations.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Opportune Data Security Posture Management with Macie</data>
    <data key="d1" />
    <data key="d2">This architecture focuses on using Amazon Macie across multiple AWS accounts to discover sensitive data in S3 buckets. Findings are aggregated into a central S3 bucket and processed using Amazon Athena, AWS Glue, and a MySQL data lake. Amazon QuickSight provides visualization for Security Engineers.</data>
    <data key="d3">Security,Analytics,Data Governance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
