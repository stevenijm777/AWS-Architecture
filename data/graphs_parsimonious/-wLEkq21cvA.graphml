<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Migration Team</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Operators managing and triggering migrations</data>
    </node>
    <node id="1">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Chat interface used to issue migration commands</data>
    </node>
    <node id="2">
      <data key="d5">On-Prem</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises servers being migrated</data>
    </node>
    <node id="3">
      <data key="d5">App Discovery Service</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Gathers TCP connections and performance metrics</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores operational metadata like tags, IPs, and target accounts</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Migration Factory</data>
      <data key="d6">EC2</data>
      <data key="d7">Orchestrates the entire automated migration process</data>
    </node>
    <node id="6">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Manages block-by-block live volume replication</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Hot Replica</data>
      <data key="d6">EC2</data>
      <data key="d7">Staging server holding hot replicated data</data>
    </node>
    <node id="8">
      <data key="d5">Bake AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">AMI created from hot replica data</data>
    </node>
    <node id="9">
      <data key="d5">Shared AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">Encrypted AMI shared across accounts to target account</data>
    </node>
    <node id="10">
      <data key="d5">Target EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Final migrated instance launched in target AWS account</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration team triggers workflow via Slack</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration team populates metadata into DynamoDB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Slack calls API on Migration Factory EC2 instance</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Agent sends network/performance metadata to App Discovery Service</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Block replication from on-premises to EC2 Hot Replica</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration factory retrieves network discovery data via API</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration factory signals CloudEndure via API</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration factory creates/bakes AMI from Hot Replica</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration factory shares AMI across account boundary</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration factory provisions target EC2 instance with tags and config</data>
      <data key="d10">10</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudEndure stops replication on the Hot Replica instance</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Automated Server Migration Architecture with Versent Migration Factory</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Shows live server migration automation from on-premises to AWS target account.</data>
    <data key="d3">Migration and Automation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
