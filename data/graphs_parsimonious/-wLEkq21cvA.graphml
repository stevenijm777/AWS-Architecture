<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Servers</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Source infrastructure being migrated</data>
    </node>
    <node id="1">
      <data key="d5">Migration Team</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Operators initiating and configuring migration</data>
    </node>
    <node id="2">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Interface for triggering migration automation</data>
    </node>
    <node id="3">
      <data key="d5">App Discovery Service</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Gathers inbound/outbound TCP connections and utilization metadata</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores operational metadata, tags, RTO/RPO, and target details</data>
    </node>
    <node id="5">
      <data key="d5">Migration Factory EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Orchestrates migration steps via API calls</data>
    </node>
    <node id="6">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Handles continuous block-level volume replication</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Hot Replica</data>
      <data key="d6">EC2</data>
      <data key="d7">Target replica receiving continuous block replication</data>
    </node>
    <node id="8">
      <data key="d5">Bake AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">Baked AMI generated from replicated state</data>
    </node>
    <node id="9">
      <data key="d5">Shared AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">Encrypted AMI shared to target AWS account</data>
    </node>
    <node id="10">
      <data key="d5">Target EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Final deployed EC2 instance in target account</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends network metadata and utilization statistics</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Replicates block data continuously</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Issues migration execution command</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Populates target metadata and tags</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Triggers migration process on Migration Factory</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Queries server network and dependency metadata</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Commands CloudEndure to stop replication</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Triggers AMI creation from replica</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Shares encrypted AMI across target account boundary</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Launches configured EC2 instance in target account</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Finalizes replication state on hot replica</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Versent AWS Migration Factory Architecture</data>
    <data key="d1" />
    <data key="d2">Automated AWS migration architecture using EC2, App Discovery Service, CloudEndure, DynamoDB, and Slack.</data>
    <data key="d3">Migration &amp; Automation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
