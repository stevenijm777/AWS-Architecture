  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Migration Team</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">External actor triggering migration commands</data>
    </node>
    <node id="1">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Chatops platform for issuing migration commands</data>
    </node>
    <node id="2">
      <data key="d5">On-Prem</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises servers being migrated</data>
    </node>
    <node id="3">
      <data key="d5">App Discovery Service</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Gathers TCP inbound/outbound connections and utilization metadata</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores migration metadata, operational info, and instance tags</data>
    </node>
    <node id="5">
      <data key="d5">EC2 (Migration Factory)</data>
      <data key="d6">EC2</data>
      <data key="d7">Migration factory EC2 instance orchestrating the workflow</data>
    </node>
    <node id="6">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Live replication agent software</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Hot Replica</data>
      <data key="d6">EC2</data>
      <data key="d7">Continuously replicated block data from on-premise</data>
    </node>
    <node id="8">
      <data key="d5">Bake AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">Baked image of the hot replica</data>
    </node>
    <node id="9">
      <data key="d5">Shared AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">AMI shared across accounts to target account</data>
    </node>
    <node id="10">
      <data key="d5">EC2 (Target Account)</data>
      <data key="d6">EC2</data>
      <data key="d7">Final target EC2 instance launched in target AWS account</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration Team issues command via Slack</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Slack integration triggers DynamoDB metadata lookup/updates</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Slack calls API on EC2 Migration Factory instance</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">App Discovery agent sends metadata from on-prem to App Discovery Service</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Block-level continuous replication to EC2 Hot Replica</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 Migration Factory queries App Discovery Service API</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 Migration Factory calls CloudEndure API to stop replication</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 Migration Factory bakes AMI from hot replica</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 Migration Factory shares AMI with target account</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 Migration Factory triggers launch of target EC2 instance</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudEndure controls EC2 Hot Replica state</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Target EC2 instance launched from Shared AMI</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Automated Server Migration to AWS using CloudEndure and Migration Factory</data>
    <data key="d1" />
    <data key="d2">Architecture shows automated server migration from on-premise to target AWS account.</data>
    <data key="d3">Migration and Transfer</data>
    <data key="d4">True</data>
