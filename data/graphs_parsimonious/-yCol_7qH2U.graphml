<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">User</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="ui_portal">
      <data key="d0">ThirdParty</data>
      <data key="d1">UI Portal</data>
      <data key="d2">third_party</data>
    </node>
    <node id="fargate_ingest">
      <data key="d0">Fargate</data>
      <data key="d1">AWS Fargate</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">Amazon S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="msk">
      <data key="d0">MSK</data>
      <data key="d1">Amazon Managed Streaming for Apache Kafka</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2">
      <data key="d0">EC2</data>
      <data key="d1">Amazon EC2</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ecr">
      <data key="d0">ECR</data>
      <data key="d1">Amazon ECR</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sagemaker">
      <data key="d0">SageMaker</data>
      <data key="d1">Amazon SageMaker</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="eventbridge">
      <data key="d0">EventBridge</data>
      <data key="d1">Amazon EventBridge</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="fargate_consumer">
      <data key="d0">Fargate</data>
      <data key="d1">AWS Fargate</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="opensearch">
      <data key="d0">OpenSearch</data>
      <data key="d1">Amazon OpenSearch Service</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="user" target="ui_portal" id="0">
      <data key="d3">requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ui_portal" target="fargate_ingest" id="0">
      <data key="d3">sends data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate_ingest" target="s3" id="0">
      <data key="d3">stores data</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="fargate_ingest" target="msk" id="0">
      <data key="d3">publishes events</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate_ingest" target="opensearch" id="0">
      <data key="d3">indexes data</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="msk" target="ec2" id="0">
      <data key="d3">streams data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="msk" target="fargate_consumer" id="0">
      <data key="d3">consumes events</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2" target="s3" id="0">
      <data key="d3">reads/writes data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2" target="ecr" id="0">
      <data key="d3">pulls images</data>
      <data key="d4">reads_from</data>
    </edge>
    <edge source="ec2" target="sagemaker" id="0">
      <data key="d3">invokes inference</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="sagemaker" target="eventbridge" id="0">
      <data key="d3">emits events</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="eventbridge" target="lambda" id="0">
      <data key="d3">triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda" target="msk" id="0">
      <data key="d3">publishes results</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate_consumer" target="opensearch" id="0">
      <data key="d3">indexes data</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="fargate_consumer" target="ui_portal" id="0">
      <data key="d3">updates UI</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
