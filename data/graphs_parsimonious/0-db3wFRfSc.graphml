<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">User</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="cloudfront">
      <data key="d0">CloudFront</data>
      <data key="d1">CloudFront</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="api">
      <data key="d0">EC2</data>
      <data key="d1">API</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="mysql">
      <data key="d0">RDS</data>
      <data key="d1">MySQL</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="state_manager">
      <data key="d0">EC2</data>
      <data key="d1">State Manager</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sqs_main">
      <data key="d0">SQS</data>
      <data key="d1">SQS (Main)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sqs_middle">
      <data key="d0">SQS</data>
      <data key="d1">SQS (State)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="gpu_main">
      <data key="d0">EC2</data>
      <data key="d1">GPU</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sqs_secondary">
      <data key="d0">SQS</data>
      <data key="d1">SQS (Secondary)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="gpu_secondary">
      <data key="d0">EC2</data>
      <data key="d1">GPU (Secondary)</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="user" target="cloudfront" id="0">
      <data key="d3">requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="user" target="api" id="0">
      <data key="d3">API calls</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="user" target="s3" id="0">
      <data key="d3">direct uploads</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudfront" target="s3" id="0">
      <data key="d3">fetches static content</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="api" target="mysql" id="0">
      <data key="d3">reads/writes</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="api" target="sqs_main" id="0">
      <data key="d3">queues tasks</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="api" target="state_manager" id="0">
      <data key="d3">updates state</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="state_manager" target="mysql" id="0">
      <data key="d3">persists state</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="state_manager" target="sqs_middle" id="0">
      <data key="d3">sends events</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="sqs_main" target="gpu_main" id="0">
      <data key="d3">processes jobs</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="sqs_main" target="sqs_secondary" id="0">
      <data key="d3">cross-region fanout</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="gpu_main" target="s3" id="0">
      <data key="d3">stores output</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="sqs_secondary" target="gpu_secondary" id="0">
      <data key="d3">processes jobs</data>
      <data key="d4">triggers</data>
    </edge>
  </graph>
</graphml>
