<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Public Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-users requesting HTML web pages.</data>
    </node>
    <node id="1">
      <data key="d5">Developer &amp; Newsroom Users</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Manage web page templates and deploy JavaScript rendering code.</data>
    </node>
    <node id="2">
      <data key="d5">Origin Proxy ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Routes incoming public requests based on resource type.</data>
    </node>
    <node id="3">
      <data key="d5">Static Resources S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores CSS and JavaScript assets.</data>
    </node>
    <node id="4">
      <data key="d5">Pre-Rendered Content S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores pre-rendered HTML content for faster load times.</data>
    </node>
    <node id="5">
      <data key="d5">Rendering Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Dynamically renders web pages on cache misses.</data>
    </node>
    <node id="6">
      <data key="d5">Content Proxy ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Proxies content queries to external CMS and APIs.</data>
    </node>
    <node id="7">
      <data key="d5">Page Builder DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores web page templates constructed by newsroom users.</data>
    </node>
    <node id="8">
      <data key="d5">Content Cache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Caches raw JSON objects from CMS with a TTL.</data>
    </node>
    <node id="9">
      <data key="d5">External CMS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External CMS services hosting stories, images, and video feeds.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Requests web content.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Deploys site rendering code.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Configures page templates.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Fetches static web assets.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Retrieves pre-rendered pages.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Invokes Lambda for dynamic rendering.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Loads active templates to structure the page.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Queries raw content payload.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Caches raw JSON data.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Retrieves story/media data from external CMS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Washington Post Arc Publishing Web Rendering Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=0JxJpNjI9Y0</data>
    <data key="d2">A web rendering system leveraging layered caching and serverless rendering to deliver news content dynamically with high availability.</data>
    <data key="d3">interactive, compute_intensive</data>
    <data key="d4">True</data>
  </graph>
</graphml>
