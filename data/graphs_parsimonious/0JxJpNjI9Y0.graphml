  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Public Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Public web viewers accessing Washington Post content</data>
    </node>
    <node id="1">
      <data key="d5">Developer / Newsroom</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Newsroom staff and developers managing page templates and code deployments</data>
    </node>
    <node id="2">
      <data key="d5">Origin ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Handles incoming web traffic routing</data>
    </node>
    <node id="3">
      <data key="d5">Static Resources</data>
      <data key="d6">S3</data>
      <data key="d7">Stores JavaScript, CSS, and static assets</data>
    </node>
    <node id="4">
      <data key="d5">Pre-Render Content</data>
      <data key="d6">S3</data>
      <data key="d7">Stores cached pre-rendered HTML content</data>
    </node>
    <node id="5">
      <data key="d5">Site Rendering Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes site rendering code dynamically</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores web page templates and configuration</data>
    </node>
    <node id="7">
      <data key="d5">Proxy ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Content access proxy cluster</data>
    </node>
    <node id="8">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Caches raw JSON content payloads with TTL</data>
    </node>
    <node id="9">
      <data key="d5">CMS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External/internal content management system APIs</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Public request hits origin ECS cluster</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Developer deploys rendering code updates to Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Newsroom user creates and publishes page templates to DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Fetches static resources</data>
      <data key="d10">2a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Fetches pre-rendered content from cache</data>
      <data key="d10">2b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers dynamic web page rendering on cache miss</data>
      <data key="d10">2c</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Stores rendered HTML content into S3</data>
