  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IMAGE</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">External input source uploading images via web, SDK, or API</data>
    </node>
    <node id="1">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives incoming API requests</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing to appropriate ECS cluster</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Processes metadata and decides image category</data>
    </node>
    <node id="4">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues images for CPU/GPU worker processing</data>
    </node>
    <node id="5">
      <data key="d5">PROCESSING</data>
      <data key="d6">EC2</data>
      <data key="d7">Pre, Infer, and Post compute layer using CPU and GPU (G5) instances</data>
    </node>
    <node id="6">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Handles model training using spot instances</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores input training data and output model weights</data>
    </node>
    <node id="8">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by SageMaker to sync model weights to processing layer</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Image uploaded to API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Requests routed to ALB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB forwards to ECS cluster</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS pushes image jobs to SQS queues</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing instances consume jobs from SQS queues</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">SageMaker writes model weights back to S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">SageMaker triggers Lambda when training completes</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">SageMaker fetches training data from S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda synchronizes model weights to processing nodes</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Spine.ai Computer Vision Image Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=0wnNlOg42dc</data>
    <data key="d2">Architectural overview showing Spine.ai's image processing and training pipelines using AWS ECS, SageMaker, EC2 processing nodes, Lambda, and S3.</data>
    <data key="d3">AI/ML, Image Processing</data>
    <data key="d4">True</data>
  </graph>
