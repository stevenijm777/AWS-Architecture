  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Data Centers (TX / WA)</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Corporate data centers in Texas and Washington State</data>
    </node>
    <node id="1">
      <data key="d5">AWS Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Connects multi-account VPCs to on-premises data centers</data>
