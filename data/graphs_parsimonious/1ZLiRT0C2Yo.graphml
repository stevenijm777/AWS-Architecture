    <node id="3">
      <data key="d5">Amazon EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs Kubernetes node clusters and application containers</data>
    </node>
    <node id="4">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database service for application data</data>
    </node>
    <node id="5">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage for application persistent assets</data>
    </node>
    <node id="6">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Observability and metrics monitoring platform</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Data center connectivity via Transit Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Traffic routed from Transit Gateway to Application Load Balancer</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Load balancer forwards traffic to EC2 cluster nodes</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 workloads query RDS database</data>
