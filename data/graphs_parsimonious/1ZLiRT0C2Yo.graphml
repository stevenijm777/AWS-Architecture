<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">End User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Accesses applications deployed on the Kubernetes platform, experiencing low latency via local zones.</data>
    </node>
    <node id="1">
      <data key="d5">Elastic Load Balancing</data>
      <data key="d6">ELB</data>
      <data key="d7">Distributes incoming application traffic across Kubernetes compute clusters.</data>
    </node>
    <node id="2">
      <data key="d5">Kubernetes Clusters (EKS/EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Immutable Kubernetes clusters hosting hundreds of T-Mobile applications.</data>
    </node>
    <node id="3">
      <data key="d5">Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Interconnects VPCs and handles routing to on-premises environments.</data>
    </node>
    <node id="4">
      <data key="d5">On-Premises Data Centers</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Legacy backend systems located in Texas and Washington.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational databases consumed by the application teams.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Ingests metrics and logs from Prometheus and the infrastructure for observability.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Used for configuration storage and object persistence.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users send HTTPS requests to the application endpoints.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards traffic to the Kubernetes containers running on EC2.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Applications run queries and store persistent state in RDS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Clusters route cross-account or cross-VPC traffic.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Prometheus forwards telemetry, metrics, and alerts to CloudWatch.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Transit Gateway bridges AWS infrastructure to Texas/Washington data centers.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">T-Mobile Standardized Kubernetes Platform with Local Zones</data>
    <data key="d1">https://www.youtube.com/watch?v=1ZLiRT0C2Yo</data>
    <data key="d2">T-Mobile builds a standardized, GitOps-managed Kubernetes infrastructure across multiple regions and Local Zones, connected to on-premises data centers via Transit Gateway.</data>
    <data key="d3">compute_intensive,control</data>
    <data key="d4">True</data>
  </graph>
</graphml>
