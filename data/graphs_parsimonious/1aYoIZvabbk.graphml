<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">End-user interacting with the Orion portal.</data>
    </node>
    <node id="1">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Used for DNS resolution for the Orion portal.</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer, routes incoming traffic to the EKS cluster.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon Elastic Kubernetes Service, orchestrates the application pods. Manages workload and interacts with messaging services for job handling.</data>
    </node>
    <node id="4">
      <data key="d5">Spot Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Underlying compute resources for EKS, utilizing 100% EC2 Spot Instances for cost efficiency.</data>
    </node>
    <node id="5">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Amazon Simple Notification Service, receives events when microservice provisioning jobs are triggered.</data>
    </node>
    <node id="6">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Amazon Simple Queue Service, stores messages for unfinished jobs, allowing new pods to pick up tasks after spot terminations.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">User accesses Orion portal, triggering DNS resolution.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">Route 53 resolves DNS to the Application Load Balancer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">ALB forwards requests to the Kubernetes pods managed by EKS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="4">
      <data key="d8">0</data>
      <data key="d9">EKS orchestrates and deploys application pods onto EC2 Spot Instances.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="5">
      <data key="d8">1</data>
      <data key="d9">Application (within EKS/EC2 context) sends an event to SNS when a microservice provisioning job is triggered.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="6">
      <data key="d8">1</data>
      <data key="d9">SNS publishes the job event message to SQS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="3">
      <data key="d8">1</data>
      <data key="d9">New or replaced EKS pods (application) consume messages from SQS to resume or finish pending jobs.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">OLX Autos: Building Developer Platform for Rapid Global Expansion</data>
    <data key="d1">https://www.youtube.com/watch?v=EXAMPLE_VIDEO_ID</data>
    <data key="d2">This architecture describes the OLX Autos' internal developer platform, 'Orion portal'. It leverages AWS EKS running on 100% EC2 Spot Instances for cost optimization, with SNS and SQS for resilient job orchestration and handling of spot terminations. The specific video ID for 'This is My Architecture' is not provided, hence 'EXAMPLE_VIDEO_ID' is used as a placeholder in the link.</data>
    <data key="d3">Developer Tools, Containerization, Cost Optimization, Messaging</data>
    <data key="d4">True</data>
  </graph>
</graphml>
