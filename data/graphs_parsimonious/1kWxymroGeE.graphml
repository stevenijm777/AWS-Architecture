  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Monolith Data</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Legacy data monolith containing binary, relational, key/value, and encrypted data.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores binary and unstructured blob data.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Aurora Serverless for core relational application data per tenant.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores key-value pair and configuration data offloaded from relational DB.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Secrets Manager</data>
      <data key="d6">SecretsManager</data>
      <data key="d7">Stores sensitive and encrypted configuration/credentials directly.</data>
    </node>
    <node id="5">
      <data key="d5">AWS KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Manages per-tenant encryption keys across all services.</data>
    </node>
    <node id="6">
      <data key="d5">Service A</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Decoupled microservice accessing binary blob data in S3.</data>
    </node>
    <node id="7">
      <data key="d5">Service B</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Decoupled microservice accessing S3 and relational data in Aurora.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Offloading binary data from monolith to S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Migrating relational core data to Aurora Serverless</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Offloading key/value configuration data to DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Offloading sensitive encrypted data to Secrets Manager</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">4</data>
      <data key="d9">Per-tenant encryption keys applied to S3</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">4</data>
      <data key="d9">Per-tenant encryption keys applied to Aurora</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">4</data>
      <data key="d9">Per-tenant encryption keys applied to DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">4</data>
      <data key="d9">Encryption keys applied to Secrets Manager</data>
