    <edge source="5" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Encrypts S3 storage using KMS keys.</data>
      <data key="d10">2a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Encrypts Aurora relational instances.</data>
      <data key="d10">2b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
