<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">OutSystems Monolith Data Layer</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Contains Binary, Relational, Key-Value/Doc, and Encrypted data types</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores binary unstructured blob and key-value document data</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Aurora Serverless</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores core relational data per tenant</data>
    </node>
    <node id="3">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores configuration and key-value pairs</data>
    </node>
    <node id="4">
      <data key="d5">AWS Secrets Manager</data>
      <data key="d6">SecretsManager</data>
      <data key="d7">Securely stores sensitive encrypted data</data>
    </node>
    <node id="5">
      <data key="d5">AWS Key Management Service</data>
      <data key="d6">KMS</data>
      <data key="d7">Generates per-tenant KMS keys for multi-tenant encryption</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Binary data routed to S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Relational data routed to Aurora Serverless</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Key-value data routed to DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Encrypted secrets/data routed to Secrets Manager</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">KMS encryption key applied to S3 buckets</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">KMS encryption key applied to Aurora DB instances</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">KMS encryption key applied to DynamoDB tables</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">KMS encryption key applied to Secrets Manager entries</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">OutSystems Multi-Tenant Data Architecture on AWS</data>
    <data key="d1" />
    <data key="d2">Decomposition of monolith data layer into purpose-built storage services with centralized KMS encryption.</data>
    <data key="d3">Database &amp; Storage Multi-Tenancy Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
