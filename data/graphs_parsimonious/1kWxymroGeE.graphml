  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">OutSystems Platform</data>
      <data key="d6">EC2</data>
      <data key="d7">Application layer categorizing and routing different types of data.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores unstructured binary data and blob assets.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Aurora Serverless</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores tenant-specific relational core application data.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores configuration metadata and key-value pairs.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Secrets Manager</data>
      <data key="d6">SecretsManager</data>
      <data key="d7">Securely stores tenant configurations and sensitive credentials.</data>
    </node>
    <node id="5">
      <data key="d5">AWS KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Provides central key management and integration for default encryption.</data>
    </node>
    <node id="6">
      <data key="d5">Tenant A Key</data>
      <data key="d6">KMS</data>
      <data key="d7">Tenant-specific BYOK encryption key for Amazon S3.</data>
    </node>
    <node id="7">
      <data key="d5">Tenant B Key</data>
      <data key="d6">KMS</data>
      <data key="d7">Tenant-specific BYOK encryption key for Amazon S3.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes binary and unstructured blob data.</data>
      <data key="d10">1a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes relational data.</data>
      <data key="d10">1b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes key-value configuration data.</data>
      <data key="d10">1c</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes encrypted configurations and sensitive secrets.</data>
      <data key="d10">1d</data>
      <data key="d11">data</data>
