<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Alias / Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Incoming client connection</data>
    </node>
    <node id="1">
      <data key="d5">Network Load Balancer</data>
      <data key="d6">NLB</data>
      <data key="d7">Entry point balancing across AZs</data>
    </node>
    <node id="2">
      <data key="d5">Route Table</data>
      <data key="d6">VPC</data>
      <data key="d7">Contains Overlay IP entries pointing to active nodes</data>
    </node>
    <node id="3">
      <data key="d5">SAP Application Instances (ASCS / PAS / ERS / AAS)</data>
      <data key="d6">EC2</data>
      <data key="d7">Application tier instances across two AZs managed by clustering</data>
    </node>
    <node id="4">
      <data key="d5">SAP HANA Database</data>
      <data key="d6">EC2</data>
      <data key="d7">Primary and secondary database nodes with system replication</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User connects via alias to NLB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">NLB routes via Overlay IP route table entries</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Route table directs traffic to active application instance</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Application instances connect to SAP HANA database</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">HANA system replication between primary and secondary database nodes</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Whirlpool SAP High Availability Architecture on AWS</data>
    <data key="d1" />
    <data key="d2">SAP Extended Warehouse Management deployed across two AZs using NLB, VPC Overlay IPs, and HANA System Replication.</data>
    <data key="d3">Migration &amp; High Availability</data>
    <data key="d4">True</data>
  </graph>
</graphml>
