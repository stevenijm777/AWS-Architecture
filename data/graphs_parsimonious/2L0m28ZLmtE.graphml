<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Scientists</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">End-users (data scientists at Sanofi) accessing the data analytics portal to perform analyses and provision environments.</data>
    </node>
    <node id="1">
      <data key="d5">Sanofi SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sanofi's corporate Single Sign-On system, used for federating user identities with AWS Cognito for authentication.</data>
    </node>
    <node id="2">
      <data key="d5">CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Amazon CloudFront serves as the Content Delivery Network, distributing the static web portal content and routing requests to backend services.</data>
    </node>
    <node id="3">
      <data key="d5">User Pool</data>
      <data key="d6">Cognito</data>
      <data key="d7">Amazon Cognito manages user identities, handling authentication and federation with Sanofi's SSO.</data>
    </node>
    <node id="4">
      <data key="d5">Portal &amp; Home Buckets</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket used for hosting the static assets of the web portal and also serving as individual 'home user' buckets for personal data within the platform.</data>
    </node>
    <node id="5">
      <data key="d5">REST API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Amazon API Gateway provides the RESTful interface for dynamic functionalities of the portal, enabling interactions with backend services and traceability mechanisms.</data>
    </node>
    <node id="6">
      <data key="d5">Traceability DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Amazon DynamoDB stores user metadata and logs all actions performed on the Data Analytics portal, ensuring strong traceability and audit capabilities.</data>
    </node>
    <node id="7">
      <data key="d5">Product Portfolio</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">AWS Service Catalog enables the definition and provisioning of a portfolio of pre-approved products, such as RStudio and SageMaker environments, to data scientists.</data>
    </node>
    <node id="8">
      <data key="d5">Backend Logic</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda functions execute serverless backend logic, driving dynamic portal features and invoking AWS Machine Learning services via SDKs.</data>
    </node>
    <node id="9">
      <data key="d5">RStudio Environment</data>
      <data key="d6">EC2</data>
      <data key="d7">Amazon EC2 instances, provisioned via Service Catalog, hosting RStudio environments for statistical computing and data analysis. These are encrypted and dedicated per user.</data>
    </node>
    <node id="10">
      <data key="d5">SageMaker Notebooks</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Amazon SageMaker Notebooks environments, provisioned via Service Catalog, offering a managed service for machine learning development. These are encrypted and dedicated per user.</data>
    </node>
    <node id="11">
      <data key="d5">Translation Service</data>
      <data key="d6">Translate</data>
      <data key="d7">Amazon Translate is utilized for mass translation of raw data files. Language detection is automatically performed using Amazon Comprehend.</data>
    </node>
    <node id="12">
      <data key="d5">Medical NLP</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Amazon Comprehend Medical is employed for identifying and extracting medical information and entities from raw text files.</data>
    </node>
    <node id="13">
      <data key="d5">Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">A central Amazon S3-based Data Lake securely stores highly sensitive Real World Evidence (RWE) data, with emphasis on segregation, encryption, control, and audit.</data>
    </node>
    <edge source="0" target="2">
      <data key="d8">0</data>
      <data key="d9">Data scientists access the web portal through CloudFront for initial interaction.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="3">
      <data key="d8">0</data>
      <data key="d9">Sanofi SSO returns authentication responses and identity information to Cognito.</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="4">
      <data key="d8">0</data>
      <data key="d9">CloudFront serves static content for the portal, hosted in an S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">CloudFront redirects user authentication requests to Cognito.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="5">
      <data key="d8">1</data>
      <data key="d9">CloudFront routes requests for dynamic portal features to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="1">
      <data key="d8">0</data>
      <data key="d9">Cognito federates user identities by communicating with Sanofi's external SSO system.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="5">
      <data key="d8">1</data>
      <data key="d9">Data is retrieved from user S3 home buckets for display or processing by the dynamic portal through API Gateway.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="6">
      <data key="d8">1</data>
      <data key="d9">API Gateway interacts with DynamoDB to store and retrieve user metadata and actions.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="8">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes Lambda functions for executing specific backend business logic.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="4">
      <data key="d8">1</data>
      <data key="d9">API Gateway allows interaction (e.g., upload/download) with user-specific data in S3 home buckets via the portal.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="7">
      <data key="d8">2</data>
      <data key="d9">API Gateway triggers Service Catalog based on user requests for provisioning analytical products.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="5">
      <data key="d8">1</data>
      <data key="d9">DynamoDB returns stored metadata and traceability data to API Gateway.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="9">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions RStudio environments, deploying them onto EC2 instances.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="10">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions SageMaker Notebooks environments for data scientists.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="8" target="6">
      <data key="d8">1</data>
      <data key="d9">Lambda functions log user actions and events to DynamoDB for audit and traceability.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="8" target="11">
      <data key="d8">4</data>
      <data key="d9">Lambda functions invoke Amazon Translate via SDK for mass translation tasks.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="8" target="12">
      <data key="d8">4</data>
      <data key="d9">Lambda functions invoke Amazon Comprehend Medical via SDK to identify medical data.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="13" target="9">
      <data key="d8">3</data>
      <data key="d9">RStudio environments access sensitive Real World Evidence data stored in the S3 Data Lake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="13" target="10">
      <data key="d8">3</data>
      <data key="d9">SageMaker Notebooks access sensitive Real World Evidence data stored in the S3 Data Lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="13" target="11">
      <data key="d8">3</data>
      <data key="d9">Raw files from the Data Lake are sent to Amazon Translate for translation.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="13" target="12">
      <data key="d8">3</data>
      <data key="d9">Raw files from the Data Lake are sent to Amazon Comprehend Medical for analysis.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Sanofi with TeamWork: OnDemand Data Science Environment</data>
    <data key="d1" />
    <data key="d2">This platform provides a secure, traceable, and self-service environment for Sanofi's data scientists to analyze sensitive Real World Evidence (RWE) data. It emphasizes data segregation, auditability, and on-demand provisioning of analytical tools and access to advanced AWS machine learning capabilities.</data>
    <data key="d3">Analytics, Machine Learning, Data Lake, Web Application, Identity, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
