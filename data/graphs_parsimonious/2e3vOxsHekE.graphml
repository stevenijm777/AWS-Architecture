<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart Fire Hydrant</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">IoT device collecting acoustic data from the pipe network daily.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Ingests daily acoustic data files from IoT devices, providing authentication and security.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Persists raw acoustic data files after ingestion via API Gateway.</data>
    </node>
    <node id="3">
      <data key="d5">ECS Batch Processor</data>
      <data key="d6">ECS</data>
      <data key="d7">Performs daily batch processing of S3 files to apply processor-intensive acoustic algorithms, finding correlations in signals.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker ML Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Classifies persistent correlations identified by ECS, assigning a leak probability score using an ML model.</data>
    </node>
    <node id="5">
      <data key="d5">Human Analyst</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Receives leak probability scores from SageMaker to further classify potential leaks and initiate field investigations. Provides feedback for model retraining.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT device pushes daily acoustic data files to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway persists authenticated data files into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">New files in S3 trigger a daily batch process in ECS for acoustic signal correlation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS sends persistent correlations to SageMaker for ML classification and probability assignment.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker endpoint feeds leak probability scores to the human analyst team.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Muller Water Products - Water Intelligent Platform</data>
    <data key="d1" />
    <data key="d2">Architecture for ingesting acoustic data from IoT smart fire hydrants, processing it to find correlations, applying machine learning for leak detection probability, and presenting results to human analysts.</data>
    <data key="d3">IoT, Analytics, Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
