<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart Fire Hydrant</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Collects acoustic data from the water pipe network.</data>
    </node>
    <node id="1">
      <data key="d5" />
      <data key="d6">ApiGateway</data>
      <data key="d7">Provides secure entry point for acoustic data files.</data>
    </node>
    <node id="2">
      <data key="d5" />
      <data key="d6">S3</data>
      <data key="d7">Stores daily acoustic sound recordings.</data>
    </node>
    <node id="3">
      <data key="d5" />
      <data key="d6">ECS</data>
      <data key="d7">Runs containerized algorithms to process node-pair correlations.</data>
    </node>
    <node id="4">
      <data key="d5" />
      <data key="d6">SageMaker</data>
      <data key="d7">ML endpoint classifying persistent correlations to calculate leak probability.</data>
    </node>
    <node id="5">
      <data key="d5">Analyst</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Human analyst reviewing leak probability scores.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Hydrant pushes acoustic data via API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway persists incoming data files in S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS pulls daily files from S3 for correlation processing.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS passes persistent correlation data to SageMaker for classification.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mueller Water Products Intelligent Water Platform</data>
    <data key="d1" />
    <data key="d2">Architecture for ingesting and analyzing acoustic data from IoT water hydrants to detect leaks.</data>
    <data key="d3">IoT Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
