<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IoT Device</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Smart fire hydrants, meters, and other IoT devices collecting acoustic, pressure, and water quality data from the pipe network.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives daily acoustic signals from IoT devices, providing authentication and security before passing data to S3.</data>
    </node>
    <node id="2">
      <data key="d5">Data Lake S3</data>
      <data key="d6">S3</data>
      <data key="d7">Bucket for persisting raw acoustic signal files received via API Gateway.</data>
    </node>
    <node id="3">
      <data key="d5">Batch Processing ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Containerized service running daily batch processes with processor-intensive acoustic algorithms to find correlations in the S3 data.</data>
    </node>
    <node id="4">
      <data key="d5">ML Endpoint SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Machine learning endpoint that classifies persistent correlations received from ECS, assigning a probability (leak score).</data>
    </node>
    <node id="5">
      <data key="d5">Human Analyst</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Company analysts who receive leak scores from SageMaker, further qualify potential leaks, and provide feedback for model retraining.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Daily acoustic signals pushed from IoT devices.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Authenticated acoustic files persisted in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS batch process consumes files daily for correlation analysis.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Persistent correlations sent to SageMaker for classification.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Leak probability scores provided to human analysts.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Feedback from field analysts used for model retraining (every six weeks).</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Muller Water Products - Water Intelligent Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=XXXX</data>
    <data key="d2">This architecture describes Muller Water Products' intelligent platform for ingesting and analyzing IoT acoustic data to detect water leaks in distribution infrastructure, leveraging AWS services for data ingestion, processing, and machine learning.</data>
    <data key="d3">IoT, Analytics, Machine Learning, Data Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
