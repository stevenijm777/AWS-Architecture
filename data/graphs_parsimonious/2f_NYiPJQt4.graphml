<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-user accessing the Appway financial services portal.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user login, supporting federation with external IdPs like Active Directory.</data>
    </node>
    <node id="2">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Routes HTTPS traffic and performs SSL offloading.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon EC2 Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs multi-node Java/Tomcat Appway instances using Hazelcast clustering.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon EFS</data>
      <data key="d6">EFS</data>
      <data key="d7">Centralized, scalable shared cluster storage for EC2 nodes.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Site-to-Site VPN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Connects EC2 application cluster to customer's on-premises systems and core banking software.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts the single-page React app used by the cloud automation team.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes management endpoints for triggering serverless deployment workflows.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes deployment, provisioning, and patching tasks across environments.</data>
    </node>
    <node id="9">
      <data key="d5">AWS Organizations</data>
      <data key="d6">Organizations</data>
      <data key="d7">Aggregates and organizes dedicated single-tenant customer AWS accounts.</data>
    </node>
    <node id="10">
      <data key="d5">AWS Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Enforces compliance and baseline guardrails across the organization accounts.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User authenticates session.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">User sends web requests.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Distributes requests to cluster nodes.</data>
      <data key="d10">1.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Accesses shared persistent storage.</data>
      <data key="d10">1.2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Retrieves on-premises banking resources secure network bridge.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Applies security guardrails across AWS organization accounts.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Appway Multi-Tenant Financial Services SaaS Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=2f_NYiPJQt4</data>
    <data key="d2">Multi-tenant architecture isolating each banking customer inside its own AWS organization account. Management and guardrails are applied globally via AWS Control Tower.</data>
    <data key="d3">compute_intensive,control</data>
    <data key="d4">True</data>
  </graph>
</graphml>
