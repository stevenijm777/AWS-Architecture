<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">End User Files</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">PDF documents uploaded by users</data>
    </node>
    <node id="1">
      <data key="d5">Document Store</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded raw document files</data>
    </node>
    <node id="2">
      <data key="d5">Main Event Bus</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Handles incoming and outgoing processing events</data>
    </node>
    <node id="3">
      <data key="d5">Workflow State Machine</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates multi-step document processing pipeline</data>
    </node>
    <node id="4">
      <data key="d5">Processing Tasks</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes conversion, analysis, and post-processing steps</data>
    </node>
    <node id="5">
      <data key="d5">Custom ML Model</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Real-time endpoint analyzing page images</data>
    </node>
    <node id="6">
      <data key="d5">Managed Textract API</data>
      <data key="d6">Textract</data>
      <data key="d7">Extracts text from page images</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Uploads PDF documents to S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Emits document uploaded event</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers step function workflow execution</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Executes processing tasks via Lambda</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Publishes processing complete event</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends page images for ML analysis</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends images for text extraction</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Returns ML prediction results</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Returns extracted text</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Docebo AI Document Processing Pipeline</data>
    <data key="d1" />
    <data key="d2">Architecture processes documents by extracting text and reducing noise using ML models and AWS managed services.</data>
    <data key="d3">AI/ML Document Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
