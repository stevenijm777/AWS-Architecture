  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile &amp; Web Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">User clients submitting requests and viewing leaderboards.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for mobile and web requests.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles API requests, match start triggers, and score updates.</data>
    </node>
    <node id="3">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Triggers Lambda function after match start.</data>
    </node>
    <node id="4">
      <data key="d5">Game APIs</data>
