    <node id="5">
      <data key="d5">MongoDB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Primary database storing user and match state.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake for match data and score updates.</data>
    </node>
    <node id="7">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs Spark jobs for leaderboard ranking and estimated winnings.</data>
    </node>
    <node id="8">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for analytics on free entries and coupons.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests sent to API Gateway</data>
