  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users / Devices</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">External users and hardware devices uploading geospatial data</data>
    </node>
    <node id="1">
      <data key="d5">Data Account S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores primary geospatial data in the single data account</data>
    </node>
    <node id="2">
      <data key="d5">Data Account EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Manages streaming logic and data store services</data>
    </node>
    <node id="3">
      <data key="d5">VPC Peering</data>
      <data key="d6">VPCPeering</data>
      <data key="d7">Connects data account VPC with user processing VPCs over AWS backbone</data>
    </node>
    <node id="4">
      <data key="d5">User Processing EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts user experience logic and listens to processing queue</data>
    </node>
    <node id="5">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers S3 upload event notifications</data>
    </node>
    <node id="6">
      <data key="d5">Auto Scaling Group</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">EC2 processing instances dynamically scaled by output requirement</data>
    </node>
    <node id="7">
      <data key="d5">User Experience S3</data>
      <data key="d6">S3</data>
      <data key="d7">Direct user upload target and output processed asset storage</data>
    </node>
    <edge source="0" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">User uploads file directly to S3 via pre-signed URL</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Data read from Data Account S3 by Data Account EKS</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Data Account EKS streams data via VPC Peering</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">VPC Peering delivers data securely to User Experience EKS</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS container component listens to SQS queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS triggers processing tasks on ASG EC2 instances</data>
      <data key="d10">4</data>
