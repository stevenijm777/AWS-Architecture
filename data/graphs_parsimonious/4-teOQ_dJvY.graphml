    <data key="d0">SBB Train Condition Monitoring Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=4-teOQ_dJvY</data>
    <data key="d2">Serverless and stream processing pipeline for railway sensor data.</data>
