  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Producer</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Locomotive and trackside sensors emitting telemetry data.</data>
    </node>
    <node id="1">
      <data key="d5">Ingestion Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Ingests raw sensor data streams.</data>
    </node>
    <node id="2">
      <data key="d5">Raw Kinesis Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Buffers raw telemetry incoming from Lambda.</data>
    </node>
    <node id="3">
      <data key="d5">Kinesis Analytics</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Filters and reduces incoming telemetry streams.</data>
    </node>
    <node id="4">
      <data key="d5">Harmonized Kinesis Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Central stream holding normalized sensor data.</data>
    </node>
    <node id="5">
      <data key="d5">Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Manages data into DynamoDB and forwards to API Gateway.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores digital twin state and train condition data.</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes API interface for downstream consumers.</data>
    </node>
    <node id="8">
      <data key="d5">Consumer</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Algorithms or applications querying train status.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry sent to Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda puts raw data into Kinesis stream.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis stream feeds analytics application.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Filtered data output to central Kinesis stream.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Stream data consumed by processing Lambda.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes normalized data to DynamoDB.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda returns formatted data to API Gateway.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda retrieves state from DynamoDB.</data>
      <data key="d10">6</data>
