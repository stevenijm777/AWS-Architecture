<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Producer</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Locomotive or track sensors sending real-time data</data>
    </node>
    <node id="1">
      <data key="d5">Ingestion Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Receives sensor data in any format and forwards it to Kinesis</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Stream (Ingestion)</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Buffers incoming raw sensor data stream</data>
    </node>
    <node id="3">
      <data key="d5">Kinesis Analytics</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Filters and reduces incoming high-volume sample data</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Stream (Filtered)</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Holds harmonized and filtered data stream</data>
    </node>
    <node id="5">
      <data key="d5">Data Management Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Manages data writes to DynamoDB and handles read queries from API Gateway</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores train digital twin state and sensor data</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes API endpoint for consumers and algorithms</data>
    </node>
    <node id="8">
      <data key="d5">Consumer</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Algorithm or application querying train condition data</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Producer sends raw sensor data to ingestion Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda forwards data into Kinesis stream</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis stream feeds data into Kinesis Analytics</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Filtered data is emitted to a new Kinesis stream</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Data management Lambda reads filtered data from Kinesis stream</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda persists formatted data into DynamoDB</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="1">
      <data key="d8">2</data>
      <data key="d9">Lambda queries DynamoDB for required data</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda returns formatted response to API Gateway</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB returns queried data to Lambda</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway routes request to Data Management Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway returns data to Consumer</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Consumer requests train condition data via API Gateway</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">SBB Freight Train Digital Twin Data Platform</data>
    <data key="d1" />
    <data key="d2">Architecture for capturing, filtering, and serving train sensor data to create digital twin views for freight train inspection.</data>
    <data key="d3">IoT, Serverless, Data Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
