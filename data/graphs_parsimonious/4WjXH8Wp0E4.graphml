<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">N3/HSCN Users</data>
      <data key="d6">UserConsumerHospital</data>
      <data key="d7">NHS health and care workers accessing via N3/HSCN network</data>
    </node>
    <node id="1">
      <data key="d5">DX</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">AWS Direct Connect for secure dedicated network access</data>
    </node>
    <node id="2">
      <data key="d5">Integration Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Microservice orchestrating requests to external systems</data>
    </node>
    <node id="3">
      <data key="d5">Integration RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL database for Integration Service</data>
    </node>
    <node id="4">
      <data key="d5">FHIR Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Normalizes data into HL7 FHIR standard format</data>
    </node>
    <node id="5">
      <data key="d5">FHIR RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL database storing normalized FHIR data</data>
    </node>
    <node id="6">
      <data key="d5">Primary &amp; Social Care Settings</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Local care settings producing documents and summaries</data>
    </node>
    <node id="7">
      <data key="d5">AWS Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">Bridges local content to AWS S3</data>
    </node>
    <node id="8">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores document content</data>
    </node>
    <node id="9">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers S3 upload event messages</data>
    </node>
    <node id="10">
      <data key="d5">Lambda Function</data>
      <data key="d6">Lambda</data>
      <data key="d7">Initiates processing of document metadata and content</data>
    </node>
    <node id="11">
      <data key="d5">Document Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Handles document metadata and storage workflow</data>
    </node>
    <node id="12">
      <data key="d5">Document RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL database storing document metadata</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User request through N3/HSCN network over DX</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">DX routes traffic to Integration Service</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Integration Service queries its RDS database</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Integration Service hands off to FHIR Service</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">FHIR Service normalizes and stores data in RDS</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Primary and social care settings stream document content via Storage Gateway</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Storage Gateway mirrors content into S3</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 triggers event notification to SQS queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS triggers Lambda processing function</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda invokes Document Service</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">Document Service persists document metadata in RDS</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Document Service manages/reads content from S3 bucket</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Kainos Healthcare Data Interoperability Platform</data>
    <data key="d1" />
    <data key="d2">Microservices platform aggregating healthcare structured data (FHIR standard) and unstructured documents across NHS network.</data>
    <data key="d3">Healthcare Interoperability Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
