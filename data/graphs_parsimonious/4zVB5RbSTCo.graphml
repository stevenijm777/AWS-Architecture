<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile User / App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">External mobile application user</data>
    </node>
    <node id="1">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Blocks malicious traffic at edge level</data>
    </node>
    <node id="2">
      <data key="d5">EC2 Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Web cluster processing initial requests and detecting honeytrap hits</data>
    </node>
    <node id="3">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores user and mobile mining data</data>
    </node>
    <node id="4">
      <data key="d5">Data Pipeline</data>
      <data key="d6">DataPipeline</data>
      <data key="d7">Pushes periodic data into Athena</data>
    </node>
    <node id="5">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Analyzes behavior scores ('Gamify!') for fraud detection</data>
    </node>
    <node id="6">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives instant payment API calls</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes payment logic</data>
    </node>
    <node id="8">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores payment success/failed state</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Web traffic from mobile app to WAF</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Instant payment API call from mobile app</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Filtered traffic passed to EC2 cluster</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Suspicious IPs/honeytrap triggers fed back to WAF for blocking</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">RDS data ingested into Data Pipeline</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Data Pipeline feeds data to Athena</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">API Gateway invokes Lambda function</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda records payment status in DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Electroneum Mobile Cryptocurrency Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture showing fraud filtering using WAF, EC2, RDS, Data Pipeline, Athena, and instant payments processing via API Gateway, Lambda, and DynamoDB.</data>
    <data key="d3">Mobile &amp; Serverless Analytics</data>
    <data key="d4">True</data>
  </graph>
