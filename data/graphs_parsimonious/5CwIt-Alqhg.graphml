<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests IoT data from farm lines/shipment tracking</data>
    </node>
    <node id="1">
      <data key="d5" />
      <data key="d6">Lambda</data>
      <data key="d7">Processes incoming IoT data against defined thresholds</data>
    </node>
    <node id="2">
      <data key="d5" />
      <data key="d6">ALB</data>
      <data key="d7">Routes traffic to blockchain running on EKS</data>
    </node>
    <node id="3">
      <data key="d5">Blockchain Network</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs Hyperledger Fabric smart contracts in containers</data>
    </node>
    <node id="4">
      <data key="d5" />
      <data key="d6">DynamoDB</data>
      <data key="d7">Off-chain database for transparent, real-time query visualization</data>
    </node>
    <node id="5">
      <data key="d5" />
      <data key="d6">S3</data>
      <data key="d7">Stores exported transaction data for analytics</data>
    </node>
    <node id="6">
      <data key="d5" />
      <data key="d6">SageMaker</data>
      <data key="d7">Builds predictive analytics models for supply chain insights</data>
    </node>
    <node id="7">
      <data key="d5" />
      <data key="d6">SNS</data>
      <data key="d7">Triggers user notifications from smart contracts</data>
    </node>
    <node id="8">
      <data key="d5" />
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors EKS container nodes</data>
    </node>
    <node id="9">
      <data key="d5">Keys (CloudHSM)</data>
      <data key="d6">CloudHSM</data>
      <data key="d7">FIPS-compliant hardware security module for cryptographic key management</data>
    </node>
    <node id="10">
      <data key="d5">Drivers / Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Receives SNS alert notifications</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">IoT threshold data passed to Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda invokes ALB endpoint</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB routes requests to Hyperledger Fabric on EKS</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes off-chain transaction state into DynamoDB</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Invoked smart contract triggers SNS notification</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Metrics and logs sent to CloudWatch</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="9" id="0">
      <data key="d8">4</data>
      <data key="d9">Blockchain queries CloudHSM for key operations</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Exports data to S3 bucket</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Feeds data into SageMaker for predictive analytics</data>
      <data key="d10">6</data>
