  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IOT</data>
      <data key="d6">IoTCore</data>
      <data key="d7">AWS IoT Core for sensor data ingestion from farms and shipments</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes IoT data and evaluates thresholds</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing requests to EKS</data>
    </node>
    <node id="3">
      <data key="d5">BLOCKCHAIN</data>
      <data key="d6">EKS</data>
      <data key="d7">Hyperledger Fabric running smart contracts on Amazon EKS</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Off-chain database for real-time visualization and role-based access</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 data lake for historical blockchain data</data>
    </node>
    <node id="6">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Amazon SageMaker for predictive analytics and supply chain ML models</data>
    </node>
    <node id="7">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Amazon SNS for user and driver alerts when threshold breaches occur</data>
    </node>
    <node id="8">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors EKS cluster metrics and container health</data>
    </node>
    <node id="9">
      <data key="d5">KEYS</data>
      <data key="d6">CloudHSM</data>
      <data key="d7">Hardware Security Module for storing cryptographic keys</data>
    </node>
    <node id="10">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Drivers and supply chain participants receiving notifications</data>
    </node>
    <edge source="0" target="1" id="0">
