  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Content Originators</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Advertisers and brands uploading advertising assets.</data>
    </node>
    <node id="1">
      <data key="d5">Media Outlets</data>
      <data key="d6">UserCompanyAPI</data>
      <data key="d7">Destinations receiving processed media content.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load Balancer fronting application tier.</data>
    </node>
    <node id="3">
      <data key="d5">Firewall (WAF)</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall inspecting incoming traffic.</data>
    </node>
    <node id="4">
      <data key="d5">APP EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Web application and API tier.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Asynchronous message queue for prioritizing processing jobs.</data>
    </node>
    <node id="6">
      <data key="d5">QC / TRANS EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances performing media transcoding and quality control.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 BATCH</data>
      <data key="d6">EC2</data>
      <data key="d7">Batch processing worker fleet.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central media storage for master assets and processed versions.</data>
    </node>
    <node id="9">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN for digital video distribution.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Upload and API requests entering ELB.</data>
