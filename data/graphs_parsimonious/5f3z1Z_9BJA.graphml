<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IBM Netezza Databases</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Source databases located on-premise for life sciences client data.</data>
    </node>
    <node id="1">
      <data key="d5">Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">Ingests daily incremental data (100 GB) from on-prem databases using NFS volumes. Data is encrypted with AES256.</data>
    </node>
    <node id="2">
      <data key="d5">Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Provides a dedicated 2x10Gb network connection between on-premise and AWS, secured with SSL encryption.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Landing Zone</data>
      <data key="d6">S3</data>
      <data key="d7">Initial landing zone for ingested data from on-prem. Data is encrypted at rest (AES256). Retention period: 2 days.</data>
    </node>
    <node id="4">
      <data key="d5">Quality Cleansing EC2 Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances that pick up scripts from RDS to perform data quality and cleansing on data from the S3 Landing Zone.</data>
    </node>
    <node id="5">
      <data key="d5">RDS (Postgres)</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores metadata and ELT transformation scripts, deployed on PostgreSQL, with a future migration plan to Aurora.</data>
    </node>
    <node id="6">
      <data key="d5">S3 Transformation Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores data after quality cleansing, awaiting further transformation. Retention period: 1 day. Data is encrypted at rest (AES256).</data>
    </node>
    <node id="7">
      <data key="d5">Transformation EC2 Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances that transform data from the S3 Transformation Bucket into facts and dimensions, using scripts from RDS, before loading into Redshift.</data>
    </node>
    <node id="8">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Target data warehouse for transformed data. Initial schema setup used AWS Schema Conversion Tool. Users access via Redshift Spectrum for ad-hoc reports.</data>
    </node>
    <node id="9">
      <data key="d5">S3 Publish Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores published data from Redshift, used for daily dashboards. Retention period: 1 year and 1 month. Data is encrypted at rest (AES256).</data>
    </node>
    <node id="10">
      <data key="d5">Glacier</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Archival storage for data from the S3 Publish bucket after its retention period.</data>
    </node>
    <node id="11">
      <data key="d5">Business Users/Analysts</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Access Redshift for ad-hoc reports via Redshift Spectrum and S3 Publish for daily dashboards. Also represents developers.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premise databases send daily incremental data to Storage Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Storage Gateway ingests data into AWS via Direct Connect.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Data flows from Direct Connect into the S3 Landing Zone.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 instances for Quality Cleansing retrieve data from the S3 Landing Zone.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 Quality Cleansing instances access metadata and scripts from RDS.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Cleansed data is pushed by EC2 Quality Cleansing instances to the S3 Transformation Bucket.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS provides metadata and scripts to EC2 Quality Cleansing instances.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS provides metadata and scripts to EC2 Transformation instances.</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">RDS provides schema and metadata information to Redshift (e.g., for initial setup or ongoing schema management, as per visual).</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 Transformation instances retrieve data from the S3 Transformation Bucket.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 Transformation instances access metadata and scripts from RDS.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformed data is loaded by EC2 Transformation instances into Redshift.</data>
      <data key="d10">10</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift publishes processed data to the S3 Publish Bucket.</data>
      <data key="d10">11</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift returns query results to users.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Redshift provides status or metadata updates back to RDS (as per visual).</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Aged data from S3 Publish is moved to Glacier for archival after its retention period.</data>
      <data key="d10">12</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 Publish bucket serves dashboard data to users.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Users query Redshift for ad-hoc reports via Redshift Spectrum.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Users access the S3 Publish Bucket for daily dashboards and data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Life Sciences Data Migration to Redshift with ELT</data>
    <data key="d1">https://www.youtube.com/watch?v=EXAMPLE_VIDEO_LINK</data>
    <data key="d2">This architecture focuses on migrating data from on-prem IBM Netezza to AWS Redshift, leveraging Storage Gateway and Direct Connect for ingestion. An ELT process is implemented using EC2 instances and S3 buckets for staging and transformation, orchestrated by metadata in RDS. Retention policies are applied across S3 buckets, with Glacier used for long-term archiving. The architecture is HIPAA compliant with encryption at rest and in transit.</data>
    <data key="d3">Data Lake, Analytics, Migration, ELT, Data Warehouse</data>
    <data key="d4">True</data>
  </graph>
</graphml>
