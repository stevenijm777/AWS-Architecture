<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Customer data source</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless data sender</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streaming data sender</data>
    </node>
    <node id="3">
      <data key="d5">Customer S3</data>
      <data key="d6">S3</data>
      <data key="d7">Customer-owned destination S3 bucket</data>
    </node>
    <node id="4">
      <data key="d5">Top ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer for HEC data</data>
    </node>
    <node id="5">
      <data key="d5">Bottom ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer for Firehose data</data>
    </node>
    <node id="6">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute and cache tier</data>
    </node>
    <node id="7">
      <data key="d5">Glacier</data>
      <data key="d6">S3</data>
      <data key="d7">Cold storage archiving</data>
    </node>
    <node id="8">
      <data key="d5">Splunk S3</data>
      <data key="d6">S3</data>
      <data key="d7">Warm data storage tier</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Data sent directly to top ELB</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 archives cold data to Glacier</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 offloads unsearched data to S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Self-storage export from Splunk S3 to Customer S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Splunk Cloud Storage Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture showing data ingestion into Splunk Cloud and multi-tier storage with S3 and Glacier.</data>
    <data key="d3">Storage &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
