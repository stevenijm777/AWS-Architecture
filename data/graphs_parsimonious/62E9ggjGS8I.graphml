    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User submits request in ITSM tool.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">ITSM triggers Control Tower account factory.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions VPC into vended account.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Vended TGW attaches to central core network TGW.</data>
      <data key="d10">1</data>
