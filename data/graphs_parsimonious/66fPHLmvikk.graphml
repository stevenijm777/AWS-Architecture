<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Scientist</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Represents data scientists who manage the machine learning workflow, including pushing Docker images and interacting with SageMaker notebooks.</data>
    </node>
    <node id="1">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">The virtual private cloud that contains the core AWS services for the machine learning and application infrastructure.</data>
    </node>
    <node id="2">
      <data key="d5">ECR Registry</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores custom Docker images required for SageMaker training and endpoint deployment.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Dataset</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket used to store input datasets for model training.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Model</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket used to store trained machine learning model artifacts.</data>
    </node>
    <node id="5">
      <data key="d5">SageMaker Service</data>
      <data key="d6">SageMaker</data>
      <data key="d7">The overarching Amazon SageMaker service, which orchestrates various ML tasks from data analysis to model deployment.</data>
    </node>
    <node id="6">
      <data key="d5">SageMaker Notebook</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker Notebook instances used by data scientists to prototype, analyze data, and orchestrate model training.</data>
    </node>
    <node id="7">
      <data key="d5">SageMaker Training</data>
      <data key="d6">SageMaker</data>
      <data key="d7">The training job component within SageMaker that performs model training using specified Docker images and datasets.</data>
    </node>
    <node id="8">
      <data key="d5">SageMaker Model</data>
      <data key="d6">SageMaker</data>
      <data key="d7">The output artifact of a SageMaker training job, representing the trained machine learning model.</data>
    </node>
    <node id="9">
      <data key="d5">SageMaker Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">A real-time inference endpoint hosted by SageMaker, serving predictions from the deployed model.</data>
    </node>
    <node id="10">
      <data key="d5">Lambda Function</data>
      <data key="d6">Lambda</data>
      <data key="d7">An AWS Lambda function used to enrich raw predictions from the SageMaker endpoint before delivering them to the production application.</data>
    </node>
    <node id="11">
      <data key="d5">EC2 Production App</data>
      <data key="d6">EC2</data>
      <data key="d7">Amazon EC2 instances hosting the ContentWise production application, which consumes the enriched machine learning predictions.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Scientist pushes custom Docker images to ECR.</data>
      <data key="d10">0.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Scientist interacts with SageMaker Notebooks for experimentation and orchestration.</data>
      <data key="d10">0.2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker Training pulls custom Docker images from ECR.</data>
      <data key="d10">0.4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker Training accesses datasets from S3 Dataset bucket.</data>
      <data key="d10">0.5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">The stored model from S3 is used to create or update the SageMaker Endpoint.</data>
      <data key="d10">1.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker Notebooks initiate the model training process.</data>
      <data key="d10">0.3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker Training produces a trained model artifact.</data>
      <data key="d10">0.6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">The trained model artifact is stored in the S3 Model bucket.</data>
      <data key="d10">0.7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker Endpoint returns raw predictions to Lambda.</data>
      <data key="d10">1.4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda invokes the SageMaker Endpoint to get raw predictions.</data>
      <data key="d10">1.3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda enriches predictions and returns them to the EC2 production application.</data>
      <data key="d10">1.5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">The EC2 production application calls the Lambda function for predictions.</data>
      <data key="d10">1.2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">ContentWise Machine Learning Workflow on AWS</data>
    <data key="d1" />
    <data key="d2">ContentWise uses AWS to train, deploy, and serve machine learning models for content personalization. The workflow leverages SageMaker for model development, ECR for custom Docker images, S3 for data storage, and Lambda/EC2 for production integration. The diagram shows the flow from data scientists pushing images and interacting with notebooks, through training and model storage, to the final real-time inference serving via an endpoint and application layer.</data>
    <data key="d3">Machine Learning, AI/ML, Data Processing, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
