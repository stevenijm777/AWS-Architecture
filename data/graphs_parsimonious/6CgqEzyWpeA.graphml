<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile/PC Device</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">End-user devices (mobile, PC) requesting personalized video content. Represented visually by a mobile phone and laptop.</data>
    </node>
    <node id="1">
      <data key="d5">RAS API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Frontend for the RAS ecosystem, handling incoming rendering requests, usage plans, and API keys.</data>
    </node>
    <node id="2">
      <data key="d5">RAS Service Frontend</data>
      <data key="d6">Lambda</data>
      <data key="d7">Performs validations on rendering requests, pushes instructions to SQS, and pulls responses from another SQS queue. Also generates playlist links for CloudFront.</data>
    </node>
    <node id="3">
      <data key="d5">Rendering Instruction Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for rendering jobs pushed by the Lambda frontend, to be pulled by rendering engines.</data>
    </node>
    <node id="4">
      <data key="d5">Rendering Engines ASG</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Auto Scaling Group managing EC2 instances that act as rendering engines. Uses spot instances across multiple AZs and diversified instance types for high availability and cost efficiency.</data>
    </node>
    <node id="5">
      <data key="d5">Rendering Response Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue where rendering engines push responses upon job completion, consumed by the Lambda frontend.</data>
    </node>
    <node id="6">
      <data key="d5">Video Segments Storage</data>
      <data key="d6">S3</data>
      <data key="d7">Stores video segments uploaded by the rendering engines, acting as the origin for CloudFront.</data>
    </node>
    <node id="7">
      <data key="d5">Video CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Content Delivery Network pulling video segments from S3 and serving them to end-user devices for playback.</data>
    </node>
    <node id="8">
      <data key="d5">Spot Interruption Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Notifies about impending spot instance interruptions (2-minute notice).</data>
    </node>
    <node id="9">
      <data key="d5">Spot Interruption Handler</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by CloudWatch Events, interacts with the EC2 instance to stop pulling jobs and drain current tasks before termination.</data>
    </node>
    <node id="10">
      <data key="d5">Scaling Metrics</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects metrics from rendering instances, used by the scaling mechanism.</data>
    </node>
    <node id="11">
      <data key="d5">Scaling State Machine</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers the scaling Lambda function periodically (every 15 seconds) to evaluate scaling needs.</data>
    </node>
    <node id="12">
      <data key="d5">Scaling Handler</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by Step Functions, consumes CloudWatch metrics, calculates required capacity, and adjusts the EC2 Auto Scaling group.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests personalized video content.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway forwards rendering requests to the RAS service frontend.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda validates requests and pushes rendering instructions to the SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Frontend Lambda provides the user with a CloudFront URL to the personalized video playlist.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Rendering engines in the EC2 Auto Scaling group pull jobs from the instruction queue.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Rendering engines push job completion responses to the response queue.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Rendering engines upload processed video segments to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="10" id="0">
      <data key="d8">4</data>
      <data key="d9">Rendering instances push metrics to CloudWatch for monitoring.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Frontend Lambda pulls rendering responses from the response queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront pulls video segments from S3 as its origin.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront delivers personalized video segments to the user's device for playback.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">CloudWatch Events notifies the Lambda function of an impending spot instance interruption.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda handler interacts with the instance in the ASG to drain current jobs before termination.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">4</data>
      <data key="d9">CloudWatch metrics trigger the Step Functions state machine (implicitly via rules/alarms not fully drawn, but implied for scaling).</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">4</data>
      <data key="d9">Step Functions triggers the scaling Lambda function periodically.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="12" target="4" id="0">
      <data key="d8">4</data>
      <data key="d9">Scaling Lambda adjusts the desired capacity of the EC2 Auto Scaling group based on metrics.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Sunday Sky: Rendering as a Service (RAS)</data>
    <data key="d1">https://www.youtube.com/watch?v=EXAMPLE_LINK</data>
    <data key="d2">Sunday Sky's personalized video rendering ecosystem, named 'RAS', leveraging spot instances for cost efficiency and high availability.</data>
    <data key="d3">Media &amp; Entertainment, Serverless, Compute, Storage, CDN</data>
    <data key="d4">True</data>
  </graph>
</graphml>
