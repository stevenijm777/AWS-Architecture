  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client (Mobile / PC)</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">User device requesting personalized video</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Frontlink managing API keys and usage plans</data>
    </node>
    <node id="2">
      <data key="d5">Frontend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates rendering requests and manages queue interaction</data>
    </node>
    <node id="3">
      <data key="d5">Request SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds rendering instructions for engine workers</data>
    </node>
    <node id="4">
      <data key="d5">Response SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives immediate engine job confirmations</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Auto Scaling</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Rendering engine running on spot instances across AZs</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores rendered video segments</data>
    </node>
    <node id="7">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN serving video segments to clients</data>
    </node>
    <node id="8">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers custom scaling Lambda every 15 seconds</data>
    </node>
    <node id="9">
      <data key="d5">Scaling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Calculates required rendering capacity</data>
    </node>
    <node id="10">
      <data key="d5">CloudWatch / Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects metrics and emits spot interruption notices</data>
    </node>
    <node id="11">
      <data key="d5">Spot Interruption Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Drains instances before spot termination</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Client sends rendering request</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Client player requests video segments</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway forwards request to Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda pushes rendering instructions to request queue</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda returns playlist link to client</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 engine pulls jobs from request queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda polls response queue for job confirmation</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 engine responds immediately to response queue</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 engine uploads rendered video segments to S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">EC2 instances push metrics to CloudWatch</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront fetches video segments from S3 origin</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Step Functions triggers scaling Lambda periodically</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Scaling Lambda adjusts capacity in Auto Scaling group</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Scaling Lambda reads CloudWatch metrics</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">4</data>
      <data key="d9">CloudWatch Event triggers Lambda on spot interruption notice</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="11" target="5" id="0">
      <data key="d8">4</data>
      <data key="d9">Lambda instructs instance to drain and detach from ASG</data>
      <data key="d10">1</data>
