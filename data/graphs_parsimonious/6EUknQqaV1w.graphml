      <data key="d7">Custom microservice determining shard capacity and load balancing strategy</data>
    </node>
    <node id="5">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores security violation findings and backing state data</data>
