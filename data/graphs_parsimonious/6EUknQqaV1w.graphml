<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Cloud Provider Event Stream</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Native security event streams from various cloud providers (e.g., CloudWatch Events, Azure Activity Logs) serving as the initial data source.</data>
    </node>
    <node id="1">
      <data key="d5">Collection Kinesis Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Ingests real-time security events and resource changes for initial processing and distribution.</data>
    </node>
    <node id="2">
      <data key="d5">Graph Database</data>
      <data key="d6">Neptune</data>
      <data key="d7">Primary persistence layer for highly interconnected cloud resource data, enabling graph-based exploration and rule execution.</data>
    </node>
    <node id="3">
      <data key="d5">Search and Analytics</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Backing store used for reporting, analytical capabilities, search, and aggregations of cloud resource data.</data>
    </node>
    <node id="4">
      <data key="d5">Monitoring &amp; Metrics</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects metrics from Neptune and Elasticsearch to inform the Sharder Service about cluster capacity and health.</data>
    </node>
    <node id="5">
      <data key="d5">Sharder Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">A custom service responsible for logical grouping and intelligent distribution of data to provisioned Neptune clusters, optimizing write scale-out based on CloudWatch metrics.</data>
    </node>
    <node id="6">
      <data key="d5">Rules Kinesis Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Receives events and resource changes for propagation to the rule execution pipeline, fronting the rule engine.</data>
    </node>
    <node id="7">
      <data key="d5">Violations/Reporting DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Used as a backing store for specific use cases, and to persist detected security violations and configuration changes over time. Also powers reporting/analytical features.</data>
    </node>
    <node id="8">
      <data key="d5">Email Notifications</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Provides real-time security violation notifications to customers via email.</data>
    </node>
    <node id="9">
      <data key="d5">Slack Notifications</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Provides real-time security violation notifications to customers via Slack channels.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Security event streams from cloud providers are ingested into the collection Kinesis stream.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">Evaluated events and resource states are published to Amazon Neptune for graph-based storage.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="3">
      <data key="d8">0</data>
      <data key="d9">Collection stream also publishes data to Elasticsearch for reporting and analytics.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="6">
      <data key="d8">2</data>
      <data key="d9">Incoming events and resource changes are propagated to the rules execution pipeline.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">Data from Neptune is also used to populate Elasticsearch for enhanced search and aggregation capabilities ('50M+' resources).</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="7">
      <data key="d8">0</data>
      <data key="d9">Data from Neptune is also replicated or transformed into DynamoDB for other specific use cases and reporting.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="4">
      <data key="d8">1</data>
      <data key="d9">Neptune provides metrics to CloudWatch for monitoring and capacity assessment.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="6">
      <data key="d8">2</data>
      <data key="d9">Data or results from Neptune may be published back to the Rules Kinesis Stream for further processing or context.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="4">
      <data key="d8">1</data>
      <data key="d9">Elasticsearch provides metrics to CloudWatch for monitoring and capacity assessment.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="5">
      <data key="d8">1</data>
      <data key="d9">CloudWatch metrics are consumed by the Sharder Service to determine shard capacity and load balancing decisions.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="2">
      <data key="d8">1</data>
      <data key="d9">The Sharder Service directs writes and manages logical grouping of data within provisioned Neptune clusters for scaling.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="2">
      <data key="d8">2</data>
      <data key="d9">The rule engine (consuming from Kinesis Rules) queries the Neptune graph database to perform security checks.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="7">
      <data key="d8">2</data>
      <data key="d9">Detected security violations and rule execution results are persisted in DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="8">
      <data key="d8">2</data>
      <data key="d9">Real-time notifications about security violations are sent to customers via email.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="9">
      <data key="d8">2</data>
      <data key="d9">Real-time notifications about security violations are sent to customers via Slack.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">CloudHealth by VMware: Secure State. Manages Over 50M Assets from Billions of Events on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=dQw4w9WgXcQ</data>
    <data key="d2">Architecture for Cloud Health by VMware's Secure State platform, focusing on real-time security event collection, graph-based analysis, and sharding for scale. '50M+' label near Neptune implies processing over 50 million resources.</data>
    <data key="d3">Security, Monitoring, Data Analytics, Graph Database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
