  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis Data Streams (Collect)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Handles real-time collection of incoming cloud security event streams</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Primary graph database storing resource configuration and dynamic relationships</data>
