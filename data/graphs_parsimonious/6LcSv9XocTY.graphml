  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Customers calling into the contact center.</data>
    </node>
    <node id="1">
      <data key="d5">Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Handles incoming calls and routes interactions.</data>
    </node>
    <node id="2">
      <data key="d5">Analytics S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores event data from Amazon Connect for reporting and analytics.</data>
    </node>
    <node id="3">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries the analytics data stored in S3.</data>
    </node>
    <node id="4">
      <data key="d5">CRM Data Dip Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes a data dip to the CRM system to retrieve customer information.</data>
    </node>
    <node id="5">
      <data key="d5">Salesforce CRM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External CRM system for customer data. Represented as Salesforce.</data>
    </node>
    <node id="6">
      <data key="d5">Call Recordings S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores call recordings from Amazon Connect.</data>
    </node>
    <node id="7">
      <data key="d5">Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Processes call recordings from S3 for transcription.</data>
    </node>
    <node id="8">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Performs sentiment analysis on call recordings from S3.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users initiate calls to Amazon Connect.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Amazon Connect triggers Lambda for a data dip.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Connect stores call recordings in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Amazon Connect emits events for reporting to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries event data stored in S3 for analytics.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda queries Salesforce CRM for customer data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Salesforce CRM returns customer data to Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 triggers Transcribe for call transcription.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 triggers Comprehend for sentiment analysis of call recordings.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Intuit Global Contact Center</data>
    <data key="d1" />
    <data key="d2">Intuit's architecture for a global contact center, leveraging Amazon Connect for customer interactions, Lambda for CRM data dips, S3 for call recordings and analytics events, and AI/ML services (Transcribe, Comprehend) for post-call analysis, alongside Athena for reporting.</data>
    <data key="d3">Contact Center, Analytics, AI/ML</data>
    <data key="d4">True</data>
  </graph>
</graphml>
