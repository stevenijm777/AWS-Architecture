  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Manages external domains and internal service FQDNs.</data>
    </node>
    <node id="1">
      <data key="d5">AWS WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Web application firewall providing anti-DDoS and anti-bot protection.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Edge caching and traffic routing via behaviors to S3 or load balancer.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 (Pass Secure Load Balancer)</data>
      <data key="d6">EC2</data>
      <data key="d7">Proprietary load balancer deployed on EC2 instances.</data>
    </node>
    <node id="4">
      <data key="d5">EKS Cluster</data>
      <data key="d6">EKS</data>
      <data key="d7">Containerized application platform hosting over 100 Magento e-commerce stores.</data>
    </node>
    <node id="5">
      <data key="d5">ElasticSearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Provides search indexing capabilities.</data>
    </node>
    <node id="6">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Application caching and user session management.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 (NFS)</data>
      <data key="d6">EC2</data>
      <data key="d7">Self-managed NFS server instance.</data>
    </node>
    <node id="8">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores static assets and system logs.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">MySQL-compatible database supporting LAMP stack.</data>
    </node>
    <node id="10">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">IPsec VPN entry point for infrastructure administration.</data>
    </node>
    <node id="11">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Automates system configuration, monitoring, and alerting.</data>
    </node>
    <node id="12">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse used for business intelligence.</data>
    </node>
    <node id="13">
      <data key="d5">EC2 (Mail Server)</data>
      <data key="d6">EC2</data>
      <data key="d7">Self-managed mail server on EC2.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Incoming traffic directed from Route 53 to WAF.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Filtered traffic forwarded from WAF to CloudFront CDN.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Dynamic requests routed to custom EC2 load balancer.</data>
      <data key="d10">3a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Static asset requests served directly from S3 bucket.</data>
      <data key="d10">3b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Load balancer forwards user requests to EKS workloads.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS queries ElasticSearch for search operations.</data>
      <data key="d10">5a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS interacts with ElastiCache for session state and cache.</data>
      <data key="d10">5b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS accesses file storage on self-managed EC2 NFS server.</data>
      <data key="d10">5c</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS writes/reads static assets and logs to/from S3.</data>
      <data key="d10">5d</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS reads and writes application data to Amazon Aurora.</data>
      <data key="d10">5e</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Triboo Magento E-commerce Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=6sew_hdI6cY</data>
    <data key="d2">E-commerce infrastructure powering multi-store Magento workloads with containerized services on EKS.</data>
    <data key="d3">E-Commerce Infrastructure</data>
