  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Students/End Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Users accessing the streaming application via a URL from lightweight end-user devices.</data>
    </node>
    <node id="1">
      <data key="d5">Virtual Desktop Streaming</data>
      <data key="d6">AppStream</data>
      <data key="d7">Delivers the 'Kingdom' petrotechnical application as a streaming service to students.</data>
    </node>
    <node id="2">
      <data key="d5">Image Builder / License Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts the AppStream Image Builder for customizing images and acts as the license server for the Kingdom application.</data>
    </node>
    <node id="3">
      <data key="d5">Custom Resource Handler</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by CloudFormation custom resources to initiate customization scripts on the Image Builder.</data>
    </node>
    <node id="4">
      <data key="d5">Command Runner</data>
      <data key="d6">SystemsManager</data>
      <data key="d7">Used by Lambda to run commands and scripts on the EC2 Image Builder instance.</data>
    </node>
    <node id="5">
      <data key="d5">Template Provisioner</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Instructors use CloudFormation templates to quickly provision and customize class resources (AppStream, FSx, RDS, and Image Builder).</data>
    </node>
    <node id="6">
      <data key="d5">Project Storage</data>
      <data key="d6">FSX</data>
      <data key="d7">File system storage for Kingdom project data, mounted by AppStream instances.</data>
    </node>
    <node id="7">
      <data key="d5">Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Database for the Kingdom application, configured with SQL Express for cost optimization.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Users access AppStream streaming URL to launch Kingdom application</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">AppStream interacts with EC2 as Image Builder during provisioning</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="1">
      <data key="d8">1</data>
      <data key="d9">AppStream instances connect to EC2 license server for Kingdom</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">AppStream mounts FSx for project data via session script</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">AppStream connects to RDS for Kingdom application database</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 Image Builder configures FSx mount points in the AppStream image</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 sends signal back to CloudFormation (wait condition completion)</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda invokes Systems Manager to run commands</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Systems Manager runs customization script on EC2 Image Builder</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Custom resource in CloudFormation triggers Lambda function</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation provisions AppStream fleet using the customized image</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation provisions FSx storage</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFormation provisions RDS database</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">IHS Market Virtual Software Training</data>
    <data key="d1">https://www.youtube.com/watch?v=EXAMPLE_VIDEO_ID</data>
    <data key="d2">This architecture enables virtual instructor-led training for the Kingdom petrotechnical application. It uses AppStream to deliver the GPU-intensive software, with CloudFormation for automated provisioning and customization of the environment. EC2 serves as both the AppStream Image Builder and the Kingdom license server. FSx provides project storage, and RDS serves as the database.</data>
    <data key="d3">Virtual Desktop, Training, Software Delivery</data>
    <data key="d4">True</data>
  </graph>
