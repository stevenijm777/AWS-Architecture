<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Service Teams</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">NAB service teams, customers of the platform, running pipelines in non-production accounts.</data>
    </node>
    <node id="1">
      <data key="d5">NON-PROD Account</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Non-production environment where service teams run their pipelines and initiate promotion requests.</data>
    </node>
    <node id="2">
      <data key="d5">Kong on ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs Kong gateway to publish API endpoints for event ingestion and promotion requests.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda Functions</data>
      <data key="d6">Lambda</data>
      <data key="d7">Collection of Lambda functions (x25) to capture events, execute assessments, and handle API calls.</data>
    </node>
    <node id="4">
      <data key="d5">Build Event Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores captured build events from pipelines as key-value pairs for compliance validation.</data>
    </node>
    <node id="5">
      <data key="d5">Compliance Framework RDS PostgreSQL</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores the relational compliance framework (standards, controls, how to meet them) in PostgreSQL.</data>
    </node>
    <node id="6">
      <data key="d5">Promotion Notification SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Used to securely send promotion notifications to production accounts with fan-out capabilities.</data>
    </node>
    <node id="7">
      <data key="d5">PROD Account</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Production environment where validated deployments occur, triggered by SNS notifications and managed by internal deployment tools.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Service teams run pipelines within their non-production accounts.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="1">
      <data key="d8">1</data>
      <data key="d9">Service teams make an API call to promote from non-production account.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Pipelines in non-production account send build events to Kong running on ECS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="1">
      <data key="d8">1</data>
      <data key="d9">Promote API call goes through Kong on ECS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Logical flow of artifacts/code promotion from non-production to production environment.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Kong publishes endpoints, routing build events to Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="1">
      <data key="d8">1</data>
      <data key="d9">Kong routes promote API call to Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda captures build events and stores them in DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="1">
      <data key="d8">1</data>
      <data key="d9">Lambda retrieves build event data from DynamoDB for validation.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda queries RDS PostgreSQL for compliance framework definitions.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Upon successful compliance assessment, Lambda publishes a promotion notification to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Compliance framework data returned to Lambda for assessment execution.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">SNS fans out promotion notification to the production account, triggering deployment logic.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">NAB Compliance Framework for Cloud Workloads</data>
    <data key="d1" />
    <data key="d2">This architecture by National Australia Bank (NAB) outlines a compliance framework to automate workload migration to AWS. It ensures rapid, compliant deployment by validating build events against defined standards before promotion to production, leveraging serverless and managed database services.</data>
    <data key="d3">Compliance, Deployment, Serverless, Database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
