<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="ecs">
      <data key="d0">ECS</data>
      <data key="d1">ECS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ami">
      <data key="d0">EC2</data>
      <data key="d1">AMI</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="kms">
      <data key="d0">KMS</data>
      <data key="d1">KMS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="security_hub">
      <data key="d0">Security Hub</data>
      <data key="d1">Security Hub</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="guardduty">
      <data key="d0">GuardDuty</data>
      <data key="d1">GuardDuty</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="config">
      <data key="d0">Config</data>
      <data key="d1">Config</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="cloudwatch">
      <data key="d0">CloudWatch</data>
      <data key="d1">CloudWatch</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="cloudtrail">
      <data key="d0">CloudTrail</data>
      <data key="d1">CloudTrail</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="rds">
      <data key="d0">RDS</data>
      <data key="d1">RDS (OLTP)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="redshift">
      <data key="d0">Redshift</data>
      <data key="d1">Redshift (OLAP)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="ami" target="rds" id="0">
      <data key="d3">deploys application</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudwatch" target="s3" id="0">
      <data key="d3">export logs</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="rds" target="kms" id="0">
      <data key="d3">encryption &amp; governance</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="redshift" target="s3" id="0">
      <data key="d3">Spectrum</data>
      <data key="d4">reads_from</data>
    </edge>
  </graph>
</graphml>
