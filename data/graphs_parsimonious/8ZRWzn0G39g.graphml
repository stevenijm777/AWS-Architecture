<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="enterprise_user">
      <data key="d0">UserPartnerEnterprise</data>
      <data key="d1">Enterprise</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="end_users">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">Users</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="kms_enterprise">
      <data key="d0">KMS</data>
      <data key="d1">KMS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="api_gateway">
      <data key="d0">API Gateway</data>
      <data key="d1">API Gateway</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="business_logic">
      <data key="d0">Lambda</data>
      <data key="d1">Business Logic</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="aurora_top">
      <data key="d0">Aurora</data>
      <data key="d1">Aurora</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="aurora_right">
      <data key="d0">Aurora</data>
      <data key="d1">Aurora</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="kms_right">
      <data key="d0">KMS</data>
      <data key="d1">KMS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="fargate">
      <data key="d0">Fargate</data>
      <data key="d1">Fargate</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="enterprise_user" target="api_gateway" id="0">
      <data key="d3">requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="end_users" target="api_gateway" id="0">
      <data key="d3">requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="api_gateway" target="business_logic" id="0">
      <data key="d3">routes requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="business_logic" target="aurora_top" id="0">
      <data key="d3">queries</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="business_logic" target="aurora_right" id="0">
      <data key="d3">queries</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="business_logic" target="fargate" id="0">
      <data key="d3">invokes/triggers</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="aurora_top" target="kms_enterprise" id="0">
      <data key="d3">encrypts/decrypts</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="aurora_right" target="kms_right" id="0">
      <data key="d3">encrypts/decrypts</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate" target="dynamodb" id="0">
      <data key="d3">writes to</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
