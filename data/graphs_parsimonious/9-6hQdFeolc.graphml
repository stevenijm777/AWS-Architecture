<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Source Healthcare Institution</data>
      <data key="d6">UserConsumerHospital</data>
      <data key="d7">Originating healthcare institution sending data to Lineate Envoy.</data>
    </node>
    <node id="1">
      <data key="d5">Network Load Balancer</data>
      <data key="d6">NLB</data>
      <data key="d7">Used to expose the data and establish connectivity, handling Layer 4 TCP traffic from healthcare institutions.</data>
    </node>
    <node id="2">
      <data key="d5">Elastic Kubernetes Service</data>
      <data key="d6">EKS</data>
      <data key="d7">Envoy is built on Kubernetes, deploying containerized solutions in EKS with dedicated namespaces per customer for tenant isolation. Uses HAProxy as an Ingress Controller.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Worker Node</data>
      <data key="d6">EC2</data>
      <data key="d7">Standard EC2 instances serving as worker nodes for the EKS cluster, hosting containerized applications for Lineate Envoy.</data>
    </node>
    <node id="4">
      <data key="d5">Graviton EC2 Worker Node</data>
      <data key="d6">EC2</data>
      <data key="d7">ARM-based Graviton (m6g) EC2 instances, used as worker nodes for EKS to achieve significant cost savings (approx. 20%).</data>
    </node>
    <node id="5">
      <data key="d5">EBS GP3 Volume</data>
      <data key="d6">EBS</data>
      <data key="d7">Encrypted GP3 volumes attached to dedicated deployments per customer, ensuring data isolation and providing cost savings. Used for persistent storage by applications.</data>
    </node>
    <node id="6">
      <data key="d5">Elastic Container Registry</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores containerized images of integration engines, requirements, and solutions.</data>
    </node>
    <node id="7">
      <data key="d5">Destination Healthcare Institution</data>
      <data key="d6">UserConsumerHospital</data>
      <data key="d7">Receiving healthcare institution for processed and transformed data delivered by Lineate Envoy.</data>
    </node>
    <node id="8">
      <data key="d5">Lineate CI/CD</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Represents Lineate's development and CI/CD pipelines responsible for pushing containerized application images.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Healthcare data from institutions is ingressed via the Network Load Balancer (Layer 4 TCP).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">NLB routes incoming healthcare data traffic to the EKS cluster (via HAProxy Ingress Controller).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS deploys and manages containerized applications on EC2 worker nodes.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Internal application data flow and communication between containerized applications running on different EC2 worker nodes within the EKS cluster.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Containerized applications on EC2 worker nodes write and store processed data to dedicated EBS GP3 volumes.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Processed and transformed healthcare data is delivered from the Envoy platform to the destination healthcare institution.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Containerized applications on EC2 worker nodes read data from dedicated EBS GP3 volumes for processing.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS pulls container images from ECR for deploying containerized solutions onto its worker nodes.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lineate's CI/CD pipelines push containerized application images to ECR.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Lineate Envoy Healthcare Data Integration Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=LineateEnvoyArchitecture</data>
    <data key="d2">This architecture describes Lineate Envoy, a data integration platform for healthcare. It emphasizes multi-tenant isolation at network, compute, and storage layers, and cost optimization using Graviton EC2 instances and GP3 EBS volumes. The platform is designed to handle HIPAA compliance and geographical data residency requirements by deploying clusters across regions.</data>
    <data key="d3">Healthcare, Data Integration, Kubernetes, Cost Optimization, Multi-tenancy</data>
    <data key="d4">True</data>
  </graph>
</graphml>
