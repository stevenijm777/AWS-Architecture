<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEVELOPER</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developers creating code for applications.</data>
    </node>
    <node id="1">
      <data key="d5">GIT</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Git repositories where developers push their code. Webhooks are configured to trigger Lagoon.</data>
    </node>
    <node id="2">
      <data key="d5">LAGOOON EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">The EKS cluster running the core Lagoon open source application delivery platform.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">The EKS cluster providing environments for developers, managed by Lagoon.</data>
    </node>
    <node id="4">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Standard EC2 instances used by the EKS developer environments for base infrastructure and general workloads.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 Spot instances used by the EKS developer environments for development and non-productive infrastructure to achieve cost savings of 70-90%.</data>
    </node>
    <node id="6">
      <data key="d5">AURORA R6G</data>
      <data key="d6">Aurora</data>
      <data key="d7">Aurora database provisioned by Lagoon's EKS operator for developer environments, utilizing Graviton2 (R6G) instances for improved performance and cost-efficiency.</data>
    </node>
    <node id="7">
      <data key="d5">EBS GP3</data>
      <data key="d6">EBS</data>
      <data key="d7">EBS volumes provisioned by Lagoon's EKS operator for specialized workloads like databases or search servers, leveraging GP3 volumes for lower storage costs and better IOPS performance.</data>
    </node>
    <node id="8">
      <data key="d5">EFS</data>
      <data key="d6">EFS</data>
      <data key="d7">EFS file system provisioned by Lagoon's EKS operator for general asset storage and files that don't need anything specific.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developers create code and push it to their Git repositories.</data>
      <data key="d10">0.0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Git repository webhooks are connected to Lagoon, triggering the platform on code pushes.</data>
      <data key="d10">1.0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lagoon processes the Git events and orchestrates the deployment of environments to the developer-facing EKS cluster.</data>
      <data key="d10">1.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">The EKS cluster utilizes standard EC2 instances for its base infrastructure and workloads.</data>
      <data key="d10">2.0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">The EKS cluster leverages EC2 Spot instances for development and non-productive infrastructure where failures can be tolerated, reducing costs.</data>
      <data key="d10">2.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">An operator within the EKS cluster provisions Aurora databases as requested by developer deployments, exposing them as secrets.</data>
      <data key="d10">2.2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">An operator within the EKS cluster provisions EBS volumes for specialized workloads requiring dedicated block storage.</data>
      <data key="d10">2.3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">An operator within the EKS cluster provisions EFS file systems for general, scalable file storage for applications.</data>
      <data key="d10">2.4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Amazie.io Lagoon Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=UNKNOWN</data>
    <data key="d2">This architecture illustrates Amazie.io's Lagoon platform, an open-source application delivery platform, leveraging AWS EKS for both its core and developer environments. It highlights the use of EC2, EC2 Spot, Aurora (R6G), EBS (GP3), and EFS for compute and storage needs.</data>
    <data key="d3">Application Delivery, Developer Tools, Kubernetes</data>
    <data key="d4">True</data>
  </graph>
</graphml>
