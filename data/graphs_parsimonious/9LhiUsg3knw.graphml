<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user_clients">
      <data key="d0">UserConsumerWebMobile</data>
      <data key="d1">Web and Mobile Clients</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="appsync">
      <data key="d0">AppSync</data>
      <data key="d1">AWS AppSync</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2">
      <data key="d0">EC2</data>
      <data key="d1">Amazon EC2</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">Amazon DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_1">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_2">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="fargate">
      <data key="d0">Fargate</data>
      <data key="d1">AWS Fargate</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="couchbase">
      <data key="d0">Couchbase</data>
      <data key="d1">Couchbase</data>
      <data key="d2">third_party</data>
    </node>
    <node id="aurora">
      <data key="d0">Aurora</data>
      <data key="d1">Amazon Aurora</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="redshift">
      <data key="d0">Redshift</data>
      <data key="d1">Amazon Redshift</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="user_clients" target="appsync" id="0">
      <data key="d3">API requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="user_clients" target="ec2" id="0">
      <data key="d3">direct traffic</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="appsync" target="ec2" id="0">
      <data key="d3">queries</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="appsync" target="dynamodb" id="0">
      <data key="d3">GraphQL resolver</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="appsync" target="lambda_2" id="0">
      <data key="d3">triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="ec2" target="dynamodb" id="0">
      <data key="d3">data persistence</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="dynamodb" target="redshift" id="0">
      <data key="d3">export/analytics</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_2" target="dynamodb" id="0">
      <data key="d3">reads/writes</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate" target="dynamodb" id="0">
      <data key="d3">sync/process</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
