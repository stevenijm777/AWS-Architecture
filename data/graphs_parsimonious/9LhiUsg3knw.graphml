  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile App User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Users consuming music content and providing feedback via the MusicMatch mobile application.</data>
    </node>
    <node id="1">
      <data key="d5">Community/Users</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Community members providing feedback, edits, and translations for song lyrics and content.</data>
    </node>
    <node id="2">
      <data key="d5">Internal/Experts</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal MusicMatch staff or domain experts responsible for content editing and quality control tasks.</data>
    </node>
    <node id="3">
      <data key="d5">AppSync</data>
      <data key="d6">AppSync</data>
      <data key="d7">Provides a real-time data synchronization and API layer for client applications, distributing tasks and handling content submission.</data>
    </node>
    <node id="4">
      <data key="d5">Legacy MusicMatch</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts the initial, legacy part of the MusicMatch backend, processing incoming feedback.</data>
    </node>
    <node id="5">
      <data key="d5">Editorial Data</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational database storing editorial content, such as curated lyrics and translations.</data>
    </node>
    <node id="6">
      <data key="d5">User-Generated Data (Couchbase)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">NoSQL open-source database (Couchbase) used for storing user-generated content and data.</data>
    </node>
    <node id="7">
      <data key="d5">Task Management</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores tasks generated from user feedback and content updates, which are then distributed and managed.</data>
    </node>
    <node id="8">
      <data key="d5">Task Orchestration Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Orchestrates complex operations, such as simultaneous writing of task results to DynamoDB and content publication, triggered by AppSync.</data>
    </node>
    <node id="9">
      <data key="d5">Content Ranker</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs batch jobs to update and prioritize content based on input like streaming service rankings, contributing to task relevance.</data>
    </node>
    <node id="10">
      <data key="d5">Analytics Platform</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for analytics, extracting classifications of the most relevant content per country and language.</data>
    </node>
    <node id="11">
      <data key="d5">Ranking Contributor Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes content rankings extracted from RedShift, contributing to the overall ranking of tasks stored in DynamoDB.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile app users submit direct and indirect feedback to the legacy EC2 system.</data>
