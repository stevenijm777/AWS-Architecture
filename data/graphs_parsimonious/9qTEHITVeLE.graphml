  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Meta Manager</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS microservices running MetaManager for metadata management and schema discovery</data>
    </node>
    <node id="1">
      <data key="d5">Elasticsearch Neo4j</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">MetaStore database combining document and graph capabilities</data>
    </node>
    <node id="2">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized S3 Data Lake storing terabytes of enterprise data</data>
    </node>
    <node id="3">
      <data key="d5">Kafka</data>
      <data key="d6">MSK</data>
      <data key="d7">Enterprise streaming platform for real-time data ingestion</data>
    </node>
    <node id="4">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Amazon EMR cluster for big data processing and transformations</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational Database Service serving curated analytical data</data>
    </node>
    <node id="6">
      <data key="d5">Vertica</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Analytics data store for structured query workloads</data>
    </node>
    <node id="7">
      <data key="d5">Multiple Data Sources</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">External databases, APIs, and operational systems across business units</data>
    </node>
    <node id="8">
      <data key="d5">Applications</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External business applications consuming and producing data</data>
    </node>
    <node id="9">
      <data key="d5">DA / DS</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Data Analysts and Data Scientists consuming analytics data</data>
    </node>
