    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes data points to Aurora.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Leverages cross-account IAM role to describe client resources.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">Provides prediction insights to data collection layer.</data>
