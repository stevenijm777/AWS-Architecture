  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Crawled external data sources, regulatory, and social media data</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer fanning out ingestion traffic</data>
    </node>
    <node id="2">
      <data key="d5">Consumers (Agents)</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Policy agents and underwriters</data>
    </node>
    <node id="3">
      <data key="d5">Consumers (Web)</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Insurance carrier systems and web applications</data>
    </node>
    <node id="4">
      <data key="d5">K8S</data>
      <data key="d6">EC2</data>
      <data key="d7">Kubernetes cluster on EC2 running Keycloak, Jupyter Notebooks, Kong API Gateway, and microservices</data>
    </node>
    <node id="5">
      <data key="d5">MQ</data>
      <data key="d6">AmazonMQ</data>
      <data key="d7">Amazon MQ for message buffering between processing pipelines</data>
    </node>
    <node id="6">
      <data key="d5">VPC Peering</data>
      <data key="d6">VPCPeering</data>
      <data key="d7">Private network connection between AWS VPC and MongoDB Atlas VPC</data>
    </node>
    <node id="7">
      <data key="d5">MongoDB Atlas</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">MongoDB Atlas storing processed entity risk profile data</data>
    </node>
    <node id="8">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS Postgres for Kong API Gateway and Keycloak authentication metadata</data>
    </node>
    <node id="9">
      <data key="d5">REDIS</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">ElastiCache Redis for session and user cache management</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Data Sources send ingestion traffic into ELB</data>
