    <node id="6">
      <data key="d5">Serverless Aurora DB</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores invocation data for instant point lookup queries</data>
    </node>
    <node id="7">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Batches and converts records to Parquet</data>
    </node>
    <node id="8">
      <data key="d5">AWS Glue Schema Registry</data>
      <data key="d6">Glue</data>
      <data key="d7">Provides table schema for Parquet conversion</data>
    </node>
    <node id="9">
      <data key="d5">Data Lake S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores converted Parquet records for analytics</data>
    </node>
    <node id="10">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries aggregated metrics from S3</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
