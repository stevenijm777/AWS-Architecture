  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer Lambda Function</data>
      <data key="d6">Lambda</data>
      <data key="d7">Customer function running in external account</data>
    </node>
    <node id="1">
      <data key="d5">Ingestion Kinesis Data Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Receives CloudWatch logs from customer account</data>
    </node>
    <node id="2">
      <data key="d5">Transform Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes log streams into invocation records</data>
    </node>
    <node id="3">
      <data key="d5">Customer Config DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores customer function configs and partial invocation state</data>
    </node>
    <node id="4">
      <data key="d5">Invocation Records Kinesis Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Buffers transformed invocation records</data>
