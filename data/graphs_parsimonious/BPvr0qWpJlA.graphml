  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Caller Carrie</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">External customer initiating contact via chat, voice, or email.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Handles voice and chat interactions.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda (IVR Logic)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes logic for IVR contact flows.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs microservices connecting to external CRMs.</data>
    </node>
    <node id="4">
      <data key="d5">CRMs</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party CRM systems (e.g., Salesforce, Siebel).</data>
    </node>
    <node id="5">
      <data key="d5">Amazon SES</data>
      <data key="d6">SES</data>
      <data key="d7">Receives inbound emails from callers.</data>
    </node>
    <node id="6">
      <data key="d5">AWS Lambda (Email Ingestion)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes inbound email payloads.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores email and interaction metadata.</data>
    </node>
    <node id="8">
      <data key="d5">ContactSuite System</data>
      <data key="d6">EC2</data>
      <data key="d7">ContactSuite platform hosted on ELB, EC2, and ASG with SenseIQ KB.</data>
    </node>
    <node id="9">
      <data key="d5">Agent Andy</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Contact center agent handling customer inquiries.</data>
    </node>
    <node id="10">
      <data key="d5">Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Agent browser interface with 2FA authentication.</data>
    </node>
    <node id="11">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database holding core system data and reporting statistics.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Voice and chat incoming call.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
