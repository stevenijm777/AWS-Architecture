    <data key="d0">Vizio Smart TV Telemetry &amp; Analytics Architecture</data>
    <data key="d1" />
    <data key="d2">Real-time telemetry ingestion and analytics pipeline for Vizio smart TVs using Kinesis, Firehose, S3, RedShift, and QuickSight.</data>
    <data key="d3">Analytics &amp; Big Data</data>
    <data key="d4">True</data>
