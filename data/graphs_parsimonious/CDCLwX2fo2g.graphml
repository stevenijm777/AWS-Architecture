    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS queries DynamoDB for user recommendation results</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 writes calculated recommendation results into DynamoDB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
