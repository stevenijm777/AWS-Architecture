  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web/Mobile Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">External end users accessing the e-commerce website/app</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Routes incoming traffic to User-Item or Cart-Item microservices</data>
    </node>
    <node id="2">
      <data key="d5">ECS (User-Item API)</data>
      <data key="d6">ECS</data>
      <data key="d7">Fargate container microservice serving User-Item recommendations</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores pre-calculated user recommendation results</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (User-Item Retraining)</data>
      <data key="d6">EC2</data>
      <data key="d7">Daily batch training job producing user recommendation results</data>
    </node>
    <node id="5">
      <data key="d5">CloudWatch Schedule</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Schedules daily retraining tasks</data>
    </node>
    <node id="6">
      <data key="d5">ECS (Cart-Item API)</data>
      <data key="d6">ECS</data>
      <data key="d7">Fargate container microservice serving Cart-Item recommendations</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores trained ML model artifacts</data>
    </node>
    <node id="8">
      <data key="d5">EC2 (Cart-Item Retraining)</data>
      <data key="d6">EC2</data>
      <data key="d7">Daily batch training job producing ML model artifacts</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User sends request to e-commerce site</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes request to User-Item ECS service</data>
