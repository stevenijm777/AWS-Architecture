    <node id="4">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates CICD model publishing workflows</data>
    </node>
    <node id="5">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">High Performance Computing (HPC) cluster</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores single page web application assets and job results</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront routes web application requests to API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes authorized calls to ECS Fargate</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS interacts with DynamoDB for configuration and access management</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS instantiates model execution jobs on EC2 HPC cluster</data>
      <data key="d10">3</data>
