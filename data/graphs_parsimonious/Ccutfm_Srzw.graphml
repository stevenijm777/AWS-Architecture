<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="mobile_app">
      <data key="d0">UserConsumerMobile</data>
      <data key="d1">Mobile Client</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="kinesis_1">
      <data key="d0">Kinesis</data>
      <data key="d1">Kinesis</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="kinesis_analytics">
      <data key="d0">Kinesis Data Analytics</data>
      <data key="d1">Kinesis Data Analytics</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="kinesis_2">
      <data key="d0">Kinesis</data>
      <data key="d1">Kinesis</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_transformer">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda (Transformer)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="documentdb">
      <data key="d0">DocumentDB</data>
      <data key="d1">DocumentDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_producer">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda (Producer)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="redis">
      <data key="d0">ElastiCache</data>
      <data key="d1">Redis</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="mobile_app" target="kinesis_1" id="0">
      <data key="d3">search clicks</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kinesis_1" target="kinesis_analytics" id="0">
      <data key="d3">stream</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kinesis_analytics" target="kinesis_2" id="0">
      <data key="d3">analytics stream</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kinesis_2" target="lambda_transformer" id="0">
      <data key="d3">stream data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_transformer" target="documentdb" id="0">
      <data key="d3">write</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="documentdb" target="lambda_producer" id="0">
      <data key="d3">read</data>
      <data key="d4">reads_from</data>
    </edge>
    <edge source="lambda_producer" target="redis" id="0">
      <data key="d3">cache update</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="redis" target="mobile_app" id="0">
      <data key="d3">Search API</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
