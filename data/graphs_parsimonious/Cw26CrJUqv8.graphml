  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Logs into Salesforce UI to initiate Private Connect setup.</data>
    </node>
    <node id="1">
      <data key="d5">SFDC</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Salesforce cloud environment.</data>
    </node>
    <node id="2">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives setup requests in Control Plane VPC.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Provisions PrivateLink endpoints and stores metadata.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores customer connection metadata.</data>
    </node>
    <node id="5">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives notifications for PrivateLink state changes.</data>
    </node>
    <node id="6">
      <data key="d5">Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Ingresses VPN tunnel traffic from SFDC.</data>
    </node>
    <node id="7">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts multi-tenant connection forwarder containers.</data>
    </node>
    <node id="8">
      <data key="d5">PrivateLink (Transit VPC)</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">Transit VPC PrivateLink endpoint.</data>
    </node>
    <node id="9">
      <data key="d5">PrivateLink (Customer VPC)</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">Customer VPC PrivateLink service.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User enters PrivateLink setup details in Salesforce UI.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Control plane setup request sent to API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer data sent via site-to-site encrypted VPN tunnel.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Lambda function.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda stores customer connection metadata in DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda provisions PrivateLink connection in Transit VPC.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Transit Gateway forwards traffic to EKS connection forwarders.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Forwarder routes data to appropriate PrivateLink based on metadata.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">PrivateLink state changes trigger SNS notifications.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
