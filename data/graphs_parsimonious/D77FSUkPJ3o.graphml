  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Employee / User</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal company employees submitting expense tickets.</data>
    </node>
    <node id="1">
      <data key="d5">OpenID System</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Corporate identity provider for user authentication.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer handling incoming authentication traffic.</data>
    </node>
    <node id="3">
      <data key="d5">ECS Cluster</data>
      <data key="d6">ECS</data>
      <data key="d7">Hosts single page application container and API gateway container.</data>
    </node>
    <node id="4">
      <data key="d5">Auth Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates authentication with corporate OpenID.</data>
    </node>
    <node id="5">
      <data key="d5">Business Logic Lambdas</data>
      <data key="d6">Lambda</data>
      <data key="d7">20+ Lambdas processing ticket actions and operations.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores ticket metadata.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores financial document attachments encrypted with KMS.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User initiates authentication with OpenID.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">User routes request through load balancer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">User downloads single page web app from ECS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards request to ECS container.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS invokes Lambda for authorization helper.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API gateway container routes requests to backend Lambdas.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Uploads attachments directly to S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Auth Lambda verifies token against OpenID provider.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
