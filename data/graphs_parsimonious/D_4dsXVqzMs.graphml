<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudWatch Event</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Triggers the warning dissemination workflow on a schedule.</data>
    </node>
    <node id="1">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates Lambda state machine linear workflow.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes warning data, PDF artifact generation, and message formatting.</data>
    </node>
    <node id="3">
      <data key="d5">Warning API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Met Office API checked to confirm active warning status.</data>
    </node>
    <node id="4">
      <data key="d5">S3 (Warning State)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores warning state and JSON objects.</data>
    </node>
    <node id="5">
      <data key="d5">S3 (Customer Preferences)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores customer preference data synced from on-premises.</data>
    </node>
    <node id="6">
      <data key="d5">Messaging API</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party API to deliver SMS and email notifications.</data>
    </node>
    <node id="7">
      <data key="d5">On-Premise System</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premise system that syncs responder preferences to S3.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch Event triggers Step Functions execution.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions checks active region and queries Warning API.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions stores warning state JSON object in S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions retrieves customer preferences from S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions sends messages out via third-party Messaging API.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premise system syncs customer preferences to S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Met Office - Severe Weather Warning System Architecture</data>
    <data key="d1" />
    <data key="d2">Serverless architecture using Step Functions, Lambda, S3, API Gateway, and CloudWatch to disseminate weather warnings rapidly to first responders.</data>
    <data key="d3">Serverless Infrastructure</data>
    <data key="d4">True</data>
  </graph>
</graphml>
