  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">MongoDB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Operational database storing community application data</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers incoming change streams and delivers to raw zone S3</data>
    </node>
    <node id="2">
      <data key="d5">Raw Zone S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing raw JSON change stream data</data>
    </node>
    <node id="3">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Crawls raw data, updates catalog, deduplicates and transforms into star schema</data>
    </node>
    <node id="4">
      <data key="d5">Landing Zone S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing curated/deduplicated data</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational database holding star schema for benchmarking queries</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries curated data in landing zone for ad-hoc BI reports</data>
    </node>
    <node id="7">
      <data key="d5">Elastic Beanstalk</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Backend API querying Aurora database</data>
    </node>
    <node id="8">
      <data key="d5">CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Distributes Angular web client interface</data>
    </node>
    <node id="9">
      <data key="d5">AIS Middleware</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Middleware connecting external accounting systems to raw zone S3</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Streams change data into Firehose</data>
      <data key="d10">1</data>
