  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DATALAKE</data>
      <data key="d6">S3</data>
      <data key="d7">Stores input MRI data and receives processed results via Data Repository Tasks (DRT)</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Compute instances launched and managed by AWS Batch</data>
    </node>
    <node id="2">
      <data key="d5">BATCH</data>
      <data key="d6">Batch</data>
      <data key="d7">Orchestrates batch jobs across EC2 instances</data>
    </node>
    <node id="3">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">High-performance storage mounted to EC2 instances</data>
    </node>
    <node id="4">
      <data key="d5">EVENTBRIDGE</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Captures job status events from AWS Batch</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes job events and logs for indexing</data>
    </node>
    <node id="6">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Indexes events and logs for monitoring and Kibana visualization</data>
    </node>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Batch orchestrates reading/processing on FSx</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Batch sends job status events to EventBridge</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">FSx syncs results back to S3 Data Lake via Data Repository Task (DRT)</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">EventBridge triggers Lambda function</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda indexes events and logs into Elasticsearch</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Elasticsearch queries / status checks returned to Lambda</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Biopharma MRI Data Processing Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=EiljRL0977M</data>
    <data key="d2">The architecture processes MRI data using AWS Batch, FSx for Lustre, S3 Data Lake, EventBridge, Lambda, and Elasticsearch (OpenSearch).</data>
    <data key="d3">Batch Processing, Data Analytics, Healthcare &amp; Life Sciences</data>
    <data key="d4">True</data>
  </graph>
