<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Stores input MRI datasets and processed output results</data>
    </node>
    <node id="1">
      <data key="d5">High Performance File Storage</data>
      <data key="d6">FSX</data>
      <data key="d7">Fast storage synced with S3 via DRT for processing MRI datasets</data>
    </node>
    <node id="2">
      <data key="d5">AWS Batch</data>
      <data key="d6">Batch</data>
      <data key="d7">Orchestrates multi-day batch processing jobs</data>
    </node>
    <node id="3">
      <data key="d5">Compute Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Provisioned by AWS Batch for processing MRI data</data>
    </node>
    <node id="4">
      <data key="d5">Event Bus</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Receives status change events from AWS Batch</data>
    </node>
    <node id="5">
      <data key="d5">Indexing Function</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes events and indexes log/status details into Elasticsearch</data>
    </node>
    <node id="6">
      <data key="d5">Elasticsearch Service</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Indexes logs and status for visualization and monitoring</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 data synced to FSx storage at provisioning</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Processed output data synced back from FSx to S3 Data Lake using DRT</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Batch mounts FSx storage onto compute instances</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Batch sends status change events to EventBridge</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EventBridge triggers Lambda function</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda indexes job events and log details into Elasticsearch</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Elasticsearch queries and log retrieval</data>
      <data key="d10">3</data>
