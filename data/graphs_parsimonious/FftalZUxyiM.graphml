<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Landing S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Receives CSV files containing employee data from SuccessFactors and SAP</data>
    </node>
    <node id="1">
      <data key="d5">Validation Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates schema and structure of incoming CSV files</data>
    </node>
    <node id="2">
      <data key="d5">Staging S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores validated files ready for consumption</data>
    </node>
    <node id="3">
      <data key="d5">Loader Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered on staging bucket upload to load structured data into DynamoDB</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Key-value store containing structured employee profile data</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates creating node files, relationship files, and loading data into Neptune</data>
    </node>
    <node id="6">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Graph database modeling relationships between employees, skills, categories, and roles</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes endpoints for the Node/React web application used by employees and managers</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">File arrival in landing bucket triggers validation Lambda</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Validated files written to staging bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Staged file triggers loading Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda populates DynamoDB with structured employee data</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB data consumed through API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions generates nodes and relationships to load into Neptune graph</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Neptune graph queries served to users/managers via API Gateway</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cepsa Data Lake and Graph DB Architecture for Talent Search</data>
    <data key="d1">https://www.youtube.com/watch?v=FftalZUxyiM</data>
    <data key="d2">Data architecture using S3, Lambda, DynamoDB, Step Functions, Neptune, and API Gateway to support internal talent search.</data>
    <data key="d3">Data Analytics &amp; Graph Database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
