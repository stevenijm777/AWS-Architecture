<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile User</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">End user consuming banking services via mobile</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Segregates administration and platform traffic</data>
    </node>
    <node id="2">
      <data key="d5">API Management</data>
      <data key="d6">EC2</data>
      <data key="d7">API management layer running on EC2</data>
    </node>
    <node id="3">
      <data key="d5">Kubernetes Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Microservices hosted on Kubernetes on EC2</data>
    </node>
    <node id="4">
      <data key="d5">MongoDB on EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Document storage hosted on EC2</data>
    </node>
    <node id="5">
      <data key="d5">RDS PostgreSQL</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database service</data>
    </node>
    <node id="6">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Caching layer</data>
    </node>
    <node id="7">
      <data key="d5">Core Banking System</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Existing core banking system connected via mTLS</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User calls API via mobile app</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Load balancer forwards request to API management</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API management routes request to Kubernetes microservices</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices access document data</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices query relational database</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices read/write to cache</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices call core banking system via mTLS</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Sopra Banking Digital Banking Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=GxjMSvwcgvw</data>
    <data key="d2">Architecture for Sopra Banking Software's DXP digital banking platform based on Kubernetes microservices.</data>
    <data key="d3">Financial Services / Microservices</data>
    <data key="d4">True</data>
