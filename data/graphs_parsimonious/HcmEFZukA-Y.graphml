    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues incoming messages from the external ledger</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes queue messages and mobile requests</data>
    </node>
    <node id="7">
      <data key="d5">Atlas MongoDB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Document database keeping ledger and user state in sync</data>
    </node>
    <node id="8">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Publishes events to the downstream loyalty ecosystem</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile device contacts API Gateway for phone verification and wallet operations</data>
