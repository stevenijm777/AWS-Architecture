  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Device</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Customer mobile application interface</data>
    </node>
    <node id="1">
      <data key="d5">POS</data>
      <data key="d6">UserConsumerPOS</data>
      <data key="d7">Point of sale system at retail store</data>
    </node>
    <node id="2">
      <data key="d5">Digital Ledger</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External ledger hosting closed-loop gift card details</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for mobile device requests and external ledger messages</data>
    </node>
    <node id="4">
      <data key="d5">Pinpoint</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">Used to verify phone numbers for fraud prevention</data>
