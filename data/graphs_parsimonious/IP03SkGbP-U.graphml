<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Handles weighted DNS routing for region failover.</data>
    </node>
    <node id="1">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Distributes incoming traffic to the application tier.</data>
    </node>
    <node id="2">
      <data key="d5">Elastic Container Service</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs auxiliary microservices.</data>
    </node>
    <node id="3">
      <data key="d5">Elastic Container Registry</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores container images.</data>
    </node>
    <node id="4">
      <data key="d5">Elastic Compute Cloud</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs the core NASDAQ matching engine.</data>
    </node>
    <node id="5">
      <data key="d5">Relational Database Service</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores transactional data for the matching engine.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Global tables used for microservices database tier.</data>
    </node>
    <node id="7">
      <data key="d5">2nd Region</data>
      <data key="d6">VPC</data>
      <data key="d7">Standby region for disaster recovery and failover.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">100% traffic weight to active region.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">0% traffic weight to recovery region.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Traffic sent to ECS tasks.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Traffic sent to core EC2 instances.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">ECS pulls images from registry.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">4</data>
      <data key="d9">Microservices writing to auxiliary databases.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">7</data>
      <data key="d9">ECR image replication to second region.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">5</data>
      <data key="d9">Lifecycle Manager snapshots replicated to the second region.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">6</data>
      <data key="d9">Cross-region read replica replication.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Astana International Exchange Cloud-Native Stock Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=F_fK3yXk-x0</data>
    <data key="d2">Fully cloud-operated stock exchange architecture using multi-region deployment for high availability and failover.</data>
    <data key="d3">Finance, High Availability</data>
    <data key="d4">True</data>
  </graph>
</graphml>
