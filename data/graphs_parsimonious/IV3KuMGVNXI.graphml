  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Deep Agent</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Deep Instinct agent installed on client endpoints</data>
    </node>
    <node id="1">
      <data key="d5">Viewer Request Lambda@Edge</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Intercepts viewer requests to log real-time stats and control rate limits/updates</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Amazon CloudFront content delivery network</data>
    </node>
    <node id="3">
      <data key="d5">Origin Response Lambda@Edge</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Modifies response headers/body based on agent identification stored in DynamoDB</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB (Real-time Stats)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores real-time request statistics</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB (Agent Tracking &amp; Upgrades)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Tracks agent unique identifiers and request counts for gradual rollouts</data>
    </node>
    <node id="6">
      <data key="d5">S3 Origin</data>
      <data key="d6">S3</data>
      <data key="d7">Stores static content and agent upgrade binaries</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Agent issues GET request to CloudFront</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Viewer request function injects real-time stats into DynamoDB</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Viewer request function logs request identifiers into DynamoDB for rollout state tracking</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront fetches update/content from S3 origin</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 returns content back to CloudFront</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Deep Instinct - Real-Time Request Analysis &amp; Control with Lambda@Edge</data>
    <data key="d1" />
    <data key="d2">Architecture showing how Deep Instinct uses Lambda@Edge at Viewer Request and Origin Response stages with CloudFront, DynamoDB, and S3 for real-time statistics and gradual rolling updates.</data>
    <data key="d3">Security &amp; Real-Time Analytics</data>
    <data key="d4">True</data>
