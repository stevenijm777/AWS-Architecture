<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="1">
      <data key="d5">Deep Agent</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Cybersecurity agent deployed on client machines requesting files and updates.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Caches content and routes incoming agent requests globally.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda@Edge (Viewer Request)</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Intercepts agent requests to parse unique IDs, track stats, and evaluate upgrade eligibility.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda@Edge (Origin Response)</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Modifies original responses from S3 before delivering them to agents.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB (Statistics)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores high-volume real-time stats extracted by the viewer request function.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB (State &amp; Rollout)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Maintains state details and rate limits to coordinate rolling agent upgrades.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Origin</data>
      <data key="d6">S3</data>
      <data key="d7">Houses agent upgrade packages and static software distribution files.</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Agent sends signed GET requests containing unique identifier to CloudFront.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">CloudFront forwards cache-miss requests to S3 origin.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Viewer request function writes real-time statistics to the stats table.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Viewer request function tracks rollout state and monitors rate limits per agent.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="2" id="0">
      <data key="d8">3</data>
      <data key="d9">S3 returns requested assets to CloudFront.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Real-Time Statistics and Rolling Upgrades at the Edge</data>
    <data key="d1">https://www.youtube.com/watch?v=F0fC1Z6_WJ4</data>
    <data key="d2">Architectural representation of Deep Instinct's real-time statistics and agent upgrade distribution using Lambda@Edge, CloudFront, DynamoDB, and S3.</data>
    <data key="d3">Security, Content Delivery, Real-time Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
