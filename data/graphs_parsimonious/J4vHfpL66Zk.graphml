  <graph edgedefault="directed">
    <node id="kinesis_ingest">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Streams real-time event data into S3.</data>
    </node>
    <node id="dms_ingest">
      <data key="d5">AWS DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">Ingests relational database changes into S3.</data>
    </node>
    <node id="s3_data_lake">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Acts as landing zone and structured data lake storage.</data>
    </node>
    <node id="step_functions_orch">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates batch data processing.</data>
    </node>
    <node id="emr_process">
      <data key="d5">Amazon EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs Spark jobs to transform data to Parquet.</data>
    </node>
    <node id="athena_query">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries processed data in S3.</data>
    </node>
    <node id="redshift_dw">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for analytics and reporting.</data>
