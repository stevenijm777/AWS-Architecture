    <node id="sagemaker_ml">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs machine learning and predictive models.</data>
    </node>
    <node id="quicksight_bi">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Provides business intelligence and dashboards.</data>
    </node>
