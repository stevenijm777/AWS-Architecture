<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="1">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Allows sharing infrastructure and standard templates with TRI (sister company) to reduce development time and improve quality.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Automates deployment of a secondary cluster in Region 2 when Region 1 runs out of compute capacity.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Placement Group</data>
      <data key="d6">EC2</data>
      <data key="d7">Utilizes EC2 P3 instances for massive GPU processing power during object recognition model training.</data>
    </node>
    <node id="4">
      <data key="d5">FSx for Lustre</data>
      <data key="d6">FSX</data>
      <data key="d7">High performance file system integrated with S3 to deliver sub-millisecond latencies and high throughput to the training instances.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon S3 (Region 1)</data>
      <data key="d6">S3</data>
      <data key="d7">Primary object store holding the machine learning datasets.</data>
    </node>
    <node id="6">
      <data key="d5">Secondary EC2 Cluster (Region 2)</data>
      <data key="d6">EC2</data>
      <data key="d7">A secondary EC2 compute cluster spun up on-demand in Region 2.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3 (Region 2)</data>
      <data key="d6">S3</data>
      <data key="d7">Replicated bucket containing the dataset copy in the secondary region.</data>
    </node>
    <edge source="2" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">CloudFormation template is triggered to orchestrate and deploy the secondary cluster in Region 2.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">FSx for Lustre supplies low-latency high-throughput data directly to the EC2 Placement Group.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Cross-region S3 replication ensures data is available in Region 2.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">TRI-AD - Multi-Region High-Performance Machine Learning Training</data>
    <data key="d1">https://www.youtube.com/watch?v=F0fM_iIesA8</data>
    <data key="d2">A high-performance machine learning cluster architecture showcasing multi-region failover and scale-out capabilities using EC2, FSx for Lustre, S3 Replication, CloudFormation, and Service Catalog.</data>
    <data key="d3">Machine Learning, Storage &amp; Compute</data>
    <data key="d4">True</data>
  </graph>
</graphml>
