    </edge>
    <edge source="2" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Lift-and-shift database migration directly to EC2.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Weighted routing to legacy on-premise infrastructure.</data>
      <data key="d10">1</data>
