      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Re-platforming migration of on-prem applications to Elastic Beanstalk.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
