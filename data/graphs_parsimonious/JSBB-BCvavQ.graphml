  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premise Data Center</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">The legacy on-premise hosting infrastructure.</data>
    </node>
    <node id="1">
      <data key="d5">On-Prem Apps</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Legacy applications migrated using various re-architecting and re-platforming strategies.</data>
    </node>
    <node id="2">
      <data key="d5">On-Prem Database</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Proprietary database being migrated to modern cloud alternatives.</data>
    </node>
    <node id="3">
      <data key="d5">Route 53 Router</data>
      <data key="d6">Route53</data>
      <data key="d7">Performs weighted traffic shifting to balance load between on-premise and AWS during migration.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS hosts containerized, re-architected microservices.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless platform hosting re-architected application logic.</data>
    </node>
    <node id="6">
      <data key="d5">AWS Elastic Beanstalk</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Platform for rapid re-platforming of legacy applications with minimal changes.</data>
    </node>
    <node id="7">
      <data key="d5">AWS DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">Database Migration Service replicates and migrates data to Amazon Aurora.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Managed target relational database for migrated on-premise database workloads.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Houses the lifted-and-shifted legacy database in a self-hosted cloud environment.</data>
    </node>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Re-architecting migration of on-prem applications to Amazon EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
