  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis Data Streams</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingests real-time manufacturing machine data</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Persists raw streaming data directly into S3</data>
    </node>
    <node id="2">
      <data key="d5">Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Daisy-chained Lambda processing stage for parsing, enriching, and normalizing data</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores intermediate stage data and triggers subsequent Lambdas via DynamoDB Streams</data>
    </node>
    <node id="4">
      <data key="d5">Auxiliary Lambda (n)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes DynamoDB Streams to persist data to secondary data stores</data>
    </node>
    <node id="5">
      <data key="d5">Aurora Serverless</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational data store queried via Data API for SQL users</data>
    </node>
    <node id="6">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Provides real-time dashboards for tracking parts in manufacturing lifecycle</data>
    </node>
    <node id="7">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Scheduled ETL jobs for bulk processing data in S3</data>
    </node>
    <node id="8">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake for raw and processed manufacturing data</data>
    </node>
    <node id="9">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive SQL query service over S3 data lake</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Real-time stream data sent to processing Lambda</data>
      <data key="d10">0</data>
