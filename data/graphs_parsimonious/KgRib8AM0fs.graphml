<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile, Web &amp; Camera Apps</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Coaching video producers (Mobile App, Web Platform, Huddle Focus Cameras)</data>
    </node>
    <node id="1">
      <data key="d5" />
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded raw video content and final playable transcoded videos</data>
    </node>
    <node id="2">
      <data key="d5" />
      <data key="d6">SQS</data>
      <data key="d7">Prioritized job queues for incoming transcoding tasks</data>
    </node>
    <node id="3">
      <data key="d5" />
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors SQS queue depth metrics</data>
    </node>
    <node id="4">
      <data key="d5" />
      <data key="d6">Lambda</data>
      <data key="d7">Calculates instance-to-message ratio for custom target tracking scaling</data>
    </node>
    <node id="5">
      <data key="d5">Spot Fleet</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Manages fleet of spot instances for transcoding workloads</data>
    </node>
    <node id="6">
      <data key="d5" />
      <data key="d6">EC2</data>
      <data key="d7">Transcoding compute instances</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Uploads raw video content</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends transcoding job message to queue</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Pushes metrics on queue length and message depth</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 worker instances consume transcoding jobs</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers custom autoscaling metric evaluation</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Informs Spot Fleet to scale in or out based on current ratio</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Saves transcoded playable video output back to S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Huddle Video Transcoding Architecture at Scale</data>
    <data key="d1">https://www.youtube.com/watch?v=KgRib8AM0fs</data>
    <data key="d2">Cost-effective, highly scalable video transcoding pipeline utilizing SQS, Spot Fleet, EC2, Lambda, and CloudWatch.</data>
    <data key="d3">Media &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
