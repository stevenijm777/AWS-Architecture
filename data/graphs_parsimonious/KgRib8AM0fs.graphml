  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="1">
      <data key="d5">Mobile App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Coaches upload video using the Huddle mobile app.</data>
    </node>
    <node id="2">
      <data key="d5">Web Platform</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Coaches upload video using the web interface.</data>
    </node>
    <node id="3">
      <data key="d5">Huddle Focus Camera</data>
      <data key="d6">UserConsumerCamera</data>
      <data key="d7">Dedicated camera system uploading games directly.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Ingest &amp; Storage</data>
      <data key="d6">S3</data>
      <data key="d7">Stores both raw incoming videos and transcoded playable media.</data>
    </node>
    <node id="5">
      <data key="d5">SQS Queues</data>
      <data key="d6">SQS</data>
      <data key="d7">Prioritized queues based on performance requirements and file size.</data>
    </node>
    <node id="6">
      <data key="d5">CloudWatch Metrics</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects queue depth and scaling metrics.</data>
    </node>
    <node id="7">
      <data key="d5">Scaling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Evaluates custom ratios to calculate scaling needs.</data>
    </node>
    <node id="8">
      <data key="d5">Spot Fleet</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Manages autoscaling of Spot EC2 instances to optimize costs.</data>
    </node>
    <node id="9">
      <data key="d5">EC2 Transcoding Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs transcoding jobs in parallel.</data>
    </node>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Uploads raw video to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Enqueues transcoding task metadata.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Uploads raw video to S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Enqueues transcoding task metadata.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Uploads raw video to S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Enqueues transcoding task metadata.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda tracks SQS message volumes.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">EC2 instances process queued messages.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda pulls CloudWatch metrics.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Instructs Spot Fleet to scale in or out.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Spins up or terminates EC2 instances.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Saves transcoded files back into S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Huddle Video Transcoding Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=FqSPh9Yp0lY</data>
    <data key="d2">Cost-effective, highly scalable video ingestion and transcoding system using Spot Fleet, Lambda, SQS, and S3.</data>
    <data key="d3">Media and Entertainment, Serverless</data>
    <data key="d4">True</data>
