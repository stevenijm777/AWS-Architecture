<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Systems</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Source data warehouses and data marts on-premise.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 (Kafka / Talend / Databricks)</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs ingestion engines like Kafka, Talend, and Databricks.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Data catalog and metadata management.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central lakehouse storing source, enterprise, and product data.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores processing metrics and status.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse and read-optimized layer with Redshift Spectrum.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Serverless query engine for self-service analytics directly on S3.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Ingesting data via AWS Direct Connect to EC2 instances.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Cataloging metadata into AWS Glue.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Pumping raw and transformed data into Amazon S3 storage layers.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Writing execution metrics to Amazon RDS.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Querying S3 data via Redshift and Redshift Spectrum.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Querying Parquet/Delta files in S3 directly using Athena.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Toyota Lakehouse Architecture on AWS</data>
    <data key="d1" />
    <data key="d2">Architecture showing ingestion from on-premises to AWS lakehouse using EC2, S3, Glue, RDS, Redshift, and Athena.</data>
    <data key="d3">Data Analytics &amp; Lakehouse</data>
    <data key="d4">True</data>
  </graph>
</graphml>
