<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives alert notifications from connected IoT platform APIs</data>
    </node>
    <node id="1">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers incoming messages for decoupled processing</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes core notification processing logic</data>
    </node>
    <node id="3">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores user data, subscriber lists, and message templates</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores notification history log</data>
    </node>
    <node id="5">
      <data key="d5">SMS</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Delivers SMS alerts to field technicians' mobile phones</data>
    </node>
    <node id="6">
      <data key="d5">SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends email notifications to customers</data>
    </node>
    <node id="7">
      <data key="d5">UI</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Pushes real-time alerts to the web dashboard</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Fans out alerts to SQS queue</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers Lambda function</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Queries template and subscriber information</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Persists notification records</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Dispatches SMS text messages</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends customer email notifications</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Updates UI notifications panel</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mueller Water Products Real-Time Serverless Notification System</data>
    <data key="d1">https://www.youtube.com/watch?v=MbkLJ62jtMc</data>
    <data key="d2">Serverless real-time notification engine for water infrastructure IoT alerts.</data>
    <data key="d3">Serverless, IoT, Event-Driven</data>
    <data key="d4">True</data>
  </graph>
</graphml>
