<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="ec2">
      <data key="d0">EC2</data>
      <data key="d1">EC2</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elasticsearch">
      <data key="d0">Elasticsearch</data>
      <data key="d1">Elasticsearch</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="rds">
      <data key="d0">RDS</data>
      <data key="d1">RDS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="video_source">
      <data key="d0">ThirdParty</data>
      <data key="d1">Video Camera Feed</data>
      <data key="d2">third_party</data>
    </node>
    <node id="elemental_live">
      <data key="d0">Elemental Live</data>
      <data key="d1">Elemental Live</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elemental_mediaconnect">
      <data key="d0">MediaConnect</data>
      <data key="d1">Elemental MediaConnect</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="ec2" target="elasticsearch" id="0">
      <data key="d3">logs &amp; telemetry</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2" target="dynamodb" id="0">
      <data key="d3">state store</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2" target="rds" id="0">
      <data key="d3">relational data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="elasticsearch" target="video_source" id="0">
      <data key="d3">control signal</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="video_source" target="elemental_live" id="0">
      <data key="d3">video ingest</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="elemental_live" target="elemental_mediaconnect" id="0">
      <data key="d3">stream transport</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
