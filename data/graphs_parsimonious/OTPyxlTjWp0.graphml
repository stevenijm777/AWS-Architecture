      <data key="d1">Amazon EventBridge</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sagemaker">
      <data key="d0">SageMaker</data>
      <data key="d1">Amazon SageMaker</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="opensearch">
      <data key="d0">OpenSearch</data>
      <data key="d1">Amazon OpenSearch Service</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="producer" target="msk" id="0">
      <data key="d3">streams data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="msk" target="fargate_top" id="0">
      <data key="d3">data flow</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="msk" target="fargate_middle" id="0">
      <data key="d3">data flow</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="msk" target="fargate_bottom" id="0">
      <data key="d3">data flow</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate_top" target="msk" id="0">
      <data key="d3">data flow</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate_middle" target="msk" id="0">
      <data key="d3">data flow</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate_middle" target="emr" id="0">
      <data key="d3">submits job</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="fargate_middle" target="eventbridge" id="0">
      <data key="d3">events</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate_middle" target="opensearch" id="0">
      <data key="d3">writes index</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="fargate_bottom" target="opensearch" id="0">
