      <data key="d4">data_flow</data>
    </edge>
    <edge source="eventbridge" target="fargate_middle" id="0">
      <data key="d3">events</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="eventbridge" target="sagemaker" id="0">
      <data key="d3">events</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="sagemaker" target="eventbridge" id="0">
      <data key="d3">events</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="opensearch" target="producer" id="0">
      <data key="d3">feedback loop</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="opensearch" target="fargate_bottom" id="0">
