    <node id="3">
      <data key="d5">Proxy Layer</data>
      <data key="d6">EC2</data>
      <data key="d7">Auto Scaling group of Heimdall Data proxies</data>
    </node>
    <node id="4">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Backend relational database</data>
    </node>
    <node id="5">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Distributed L2 cache layer</data>
    </node>
    <node id="6">
      <data key="d5">Management Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Central management instance for proxy control plane</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 clients send database queries to NLB</data>
