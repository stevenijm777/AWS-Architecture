<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="plato_robot">
      <data key="d0">UserConsumerIOT</data>
      <data key="d1">Plato Robot</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="remote_devices">
      <data key="d0">UserConsumerMobile</data>
      <data key="d1">Remote Devices</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="greengrass">
      <data key="d0">IoT Greengrass</data>
      <data key="d1">AWS IoT Greengrass</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="iot_core">
      <data key="d0">IoT Core</data>
      <data key="d1">AWS IoT Core</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="iot_rule">
      <data key="d0">IoT Core</data>
      <data key="d1">IoT Rule</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="kinesis">
      <data key="d0">Kinesis</data>
      <data key="d1">Amazon Kinesis</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="opensearch">
      <data key="d0">OpenSearch</data>
      <data key="d1">Amazon OpenSearch Service</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">Amazon S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="eks">
      <data key="d0">EKS</data>
      <data key="d1">Amazon EKS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="iot_shadow">
      <data key="d0">IoT Core</data>
      <data key="d1">IoT Shadow</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="plato_robot" target="greengrass" id="0">
      <data key="d3">telemetry data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="remote_devices" target="greengrass" id="0">
      <data key="d3">commands</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="greengrass" target="iot_core" id="0">
      <data key="d3">sync</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="iot_core" target="greengrass" id="0">
      <data key="d3">sync</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="iot_core" target="iot_rule" id="0">
      <data key="d3">routes messages</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="iot_rule" target="kinesis" id="0">
      <data key="d3">stream</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kinesis" target="opensearch" id="0">
      <data key="d3">indexing</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kinesis" target="s3" id="0">
      <data key="d3">storage</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks" target="iot_core" id="0">
      <data key="d3">updates</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
