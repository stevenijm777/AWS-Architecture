    <node id="4">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational storage for enriched metadata and structured insights</data>
    </node>
    <node id="5">
      <data key="d5">OpenSearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Search index for analytical queries on enriched content</data>
    </node>
    <edge source="0" target="1" id="0">
