  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Landing Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores incoming flight, weather, and internal datasets.</data>
    </node>
    <node id="1">
      <data key="d5">Lake Formation</data>
      <data key="d6">LakeFormation</data>
      <data key="d7">Serves and governs landed data.</data>
    </node>
    <node id="2">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Performs ETL data cataloging and transformations.</data>
    </node>
    <node id="3">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Builds and trains ML models to predict weather impact.</data>
    </node>
    <node id="4">
      <data key="d5">Predictions S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores predictive model output data.</data>
    </node>
    <node id="5">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries prediction datasets directly from S3.</data>
    </node>
    <node id="6">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Provides visual dashboards for analytics.</data>
    </node>
    <node id="7">
      <data key="d5">USER</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user consumer accessing predictions.</data>
    </node>
    <node id="8">
      <data key="d5">OPS</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Operational personnel monitoring flight weather risks.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Data served out through Lake Formation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Data passed to Glue for ETL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Data ingested into SageMaker for ML processing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Cataloged data served back.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">4</data>
      <data key="d9">Predictions saved to destination S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">5</data>
      <data key="d9">Predictions queried via Athena.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
