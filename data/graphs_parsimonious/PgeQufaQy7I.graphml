<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CLIENT</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">User client requesting access to the platform</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Amazon CloudFront distribution</data>
    </node>
    <node id="2">
      <data key="d5">@EDGE</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Lambda@Edge function deciding region routing</data>
    </node>
    <node id="3">
      <data key="d5">DNS FIREWALL</data>
      <data key="d6">Route53</data>
      <data key="d7">Route 53 DNS Firewall blocking unauthorized requests</data>
    </node>
    <node id="4">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer</data>
    </node>
    <node id="5">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Elastic Kubernetes Service running microservices</data>
    </node>
    <node id="6">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS database instances</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Client request routed to CloudFront</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront routes request to Lambda@Edge</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda@Edge directs request to Route 53 DNS Firewall</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Allowed requests pass through to ALB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB distributes requests to microservices in EKS</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS microservices query Amazon RDS</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">MindTickle Multi-Region Architecture with Automated Replication</data>
    <data key="d1">https://www.youtube.com/watch?v=PgeQufaQy7I</data>
    <data key="d2">Architecture depicting global routing through CloudFront and Lambda@Edge, protected by Route 53 DNS Firewall, leading to ALB, EKS microservices, and RDS.</data>
    <data key="d3">Web &amp; Mobile Applications, Global Infrastructure</data>
    <data key="d4">True</data>
  </graph>
</graphml>
