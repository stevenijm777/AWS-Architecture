<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Ingestion Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Receives log data from customer fleet agents and appliances.</data>
    </node>
    <node id="1">
      <data key="d5">Pre-processing ECS Cluster</data>
      <data key="d6">ECS</data>
      <data key="d7">Performs pre-processing on incoming log streams.</data>
    </node>
    <node id="2">
      <data key="d5">Data Lake (25 PB)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores processed log data lake.</data>
    </node>
    <node id="3">
      <data key="d5">Search Planner ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Validates search queries and plans execution.</data>
    </node>
    <node id="4">
      <data key="d5">State/Metadata Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB table present on diagram.</data>
    </node>
    <node id="5">
      <data key="d5">Job Shadowing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Schedules and coordinates job execution based on customer data volume.</data>
    </node>
    <node id="6">
      <data key="d5">Task Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers search task requests.</data>
    </node>
    <node id="7">
      <data key="d5">State Machine</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Manages execution state and orchestration.</data>
    </node>
    <node id="8">
      <data key="d5">Filter Lambda Fleet</data>
      <data key="d6">Lambda</data>
      <data key="d7">Spins up thousands of instances to filter and enrich log data.</data>
    </node>
    <node id="9">
      <data key="d5">Intermediate S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores filtered intermediate search results.</data>
    </node>
    <node id="10">
      <data key="d5">Results Kinesis Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Streams filtered results to aggregator.</data>
    </node>
    <node id="11">
      <data key="d5">Aggregation Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Aggregates search results to return to user.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Ingested log stream passed to ECS pre-processor.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Pre-processed data written to 25 PB S3 data lake.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Search request passed to job shadowing Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Queues tasks in SQS.</data>
      <data key="d10">2a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Triggers Step Functions workflow.</data>
      <data key="d10">2b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Spins up filter Lambda instances.</data>
      <data key="d10">2c</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Filtered results stored in intermediate S3 bucket.</data>
      <data key="d10">3a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Filtered stream sent to Kinesis.</data>
      <data key="d10">3b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Direct control / signal to aggregation Lambda.</data>
      <data key="d10">3c</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Stream data fed into aggregation Lambda.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">AlertLogic Serverless Log Search and Data Ingestion Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=PoYiSKUy8sE</data>
    <data key="d2">Architecture showing a 25PB log ingestion pipeline into S3 and a massive parallel MapReduce search engine using thousands of Lambda functions coordinated via Step Functions and SQS.</data>
    <data key="d3">Security &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
