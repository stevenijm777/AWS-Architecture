<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client Display</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web browser client displaying seismic data using HTML5 Canvas and WebAssembly</data>
    </node>
    <node id="1">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Backend server running reverse proxy, Node.js, and custom data adapters</data>
    </node>
    <node id="2">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user authentication and identity management</data>
    </node>
    <node id="3">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS (Postgres) storing project configurations and role-based access control</data>
    </node>
    <node id="4">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">OSDU API Gateway endpoint for searching geoscience datasets</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage containing large-scale seismic data traces</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Client requests authentication and data display</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">User management authentication request</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Fetch project configuration and permission rights</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Search query sent to OSDU via adapter</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Parallel byte-range offset trace requests to S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">INT IVAAP Seismic Data Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=QM96Fv_NAnw</data>
    <data key="d2">Architecture of INT IVAAP client-server solution for interactive seismic visualization, leveraging AWS EC2, Cognito, RDS, API Gateway, and S3.</data>
    <data key="d3">Analytics &amp; Geoscience</data>
    <data key="d4">True</data>
  </graph>
</graphml>
