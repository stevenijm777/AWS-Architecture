<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="lora_antenna">
      <data key="d0">ThirdParty</data>
      <data key="d1">LoRa Antenna / Gateway</data>
      <data key="d2">third_party</data>
    </node>
    <node id="iot_core_lorawan">
      <data key="d0">IoT Core</data>
      <data key="d1">AWS IoT Core for LoRaWAN</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2">
      <data key="d0">EC2</data>
      <data key="d1">Amazon EC2</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="mqtt_protocol">
      <data key="d0">ThirdParty</data>
      <data key="d1">IoT MQTT Protocol</data>
      <data key="d2">third_party</data>
    </node>
    <node id="aurora">
      <data key="d0">Aurora</data>
      <data key="d1">Amazon Aurora</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="lora_antenna" target="iot_core_lorawan" id="0">
      <data key="d3">wireless data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="iot_core_lorawan" target="lambda" id="0">
      <data key="d3">triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda" target="ec2" id="0">
      <data key="d3">data payload</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2" target="mqtt_protocol" id="0">
      <data key="d3">MQTT</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
