<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Editorial System</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-prem system used by editorial teams to initiate and close voting sessions.</data>
    </node>
    <node id="1">
      <data key="d5">AWS Site-to-Site VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">Secure connectivity between on-premises systems and private AWS backend.</data>
    </node>
    <node id="2">
      <data key="d5">Voters / Clients</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End users submitting votes via mobile apps, websites, SMS, and connected TVs.</data>
    </node>
    <node id="3">
      <data key="d5">AWS WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Filters incoming user requests and enforces geo-blocking rules.</data>
    </node>
    <node id="4">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Distributes incoming voting traffic to front-end compute.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Scalable container service executing authentication and session checks.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon MemoryDB for Redis</data>
      <data key="d6">MemoryDB</data>
      <data key="d7">In-memory database running Lua scripts to process vote counts and state within 10ms.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Aggregates application logs and metrics from ALB and Fargate.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams operational log data to persistent storage.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term archive for audit trail and cross-service analytics.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Session management commands sent over secure VPN.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Opens/closes voting session state in MemoryDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">User voting requests sent to AWS WAF.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Validated traffic routed to Application Load Balancer.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB routes requests to Fargate containers.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">ALB access logs streamed to CloudWatch.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Fargate updates session and vote counters in MemoryDB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Fargate task logs sent to CloudWatch.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch streams log records to Kinesis Data Firehose.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Firehose persists aggregated logs to Amazon S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mediaset Real-Time Voting Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=QnwfcDZkwh8</data>
    <data key="d2">Real-time voting architecture designed to process millions of votes with sub-10ms latency.</data>
    <data key="d3">Serverless &amp; Real-Time Analytics</data>
    <data key="d4">True</data>
  </graph>
