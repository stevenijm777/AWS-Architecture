      <data key="d7">EBS storage tier in disaster recovery region</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3 (Region 2)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 storage tier in disaster recovery region</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Data replication from on-premises BCS to Region 1 InfoScale</data>
