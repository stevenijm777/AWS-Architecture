<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Clients / End Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">External clients whitelisting static IP addresses</data>
    </node>
    <node id="1">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Network Load Balancer with static public IP addresses</data>
    </node>
    <node id="2">
      <data key="d5">HAProxy Tier</data>
      <data key="d6">EC2</data>
      <data key="d7">Auto Scaling EC2 instances running HAProxy to handle tens of thousands of SSL cert terminations</data>
    </node>
    <node id="3">
      <data key="d5">ELB (TCP Mode)</data>
      <data key="d6">ELB</data>
      <data key="d7">Classic Load Balancer running in TCP passthrough mode</data>
    </node>
    <node id="4">
      <data key="d5">App Tier</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances running application server workloads</data>
    </node>
    <node id="5">
      <data key="d5">RDS Master</data>
      <data key="d6">RDS</data>
      <data key="d7">Primary Amazon RDS database instance</data>
    </node>
    <node id="6">
      <data key="d5">RDS Slave</data>
      <data key="d6">RDS</data>
      <data key="d7">Replica Amazon RDS database instance for failover and reporting</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">External web traffic hits static IP NLB endpoints</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB forwards traffic to HAProxy EC2 auto scaling group</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Terminated SSL traffic passed via TCP to ELB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB routes TCP traffic to application servers</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">App servers read/write to RDS primary database</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Replication from master RDS to slave RDS</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Logicworks - HIPAA-Compliant 3-Tier Web Application Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture for a HIPAA-compliant healthcare application designed by Logicworks, using NLB for fixed IP whitelisting, HAProxy on EC2 for high-volume SSL termination, ELB in TCP mode, and RDS master-slave setup.</data>
    <data key="d3">Healthcare / Compliance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
