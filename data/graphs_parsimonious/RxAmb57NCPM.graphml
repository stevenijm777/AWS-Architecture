<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Nakadi</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Distributed event bus abstraction over Kafka</data>
    </node>
    <node id="1">
      <data key="d5">Archival Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores initial 5-minute/50MB batched event files</data>
    </node>
    <node id="2">
      <data key="d5">Archival SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives object creation notifications from archival bucket</data>
    </node>
    <node id="3">
      <data key="d5">Partitioning Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Partitions incoming data and writes to RAW bucket</data>
    </node>
    <node id="4">
      <data key="d5">RAW Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores partitioned raw data</data>
    </node>
    <node id="5">
      <data key="d5">RAW SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives notifications for object creation in RAW bucket</data>
    </node>
    <node id="6">
      <data key="d5">Enrichment Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Enriches message attributes with event type and partition metadata</data>
    </node>
    <node id="7">
      <data key="d5">SNS Topic</data>
      <data key="d6">SNS</data>
      <data key="d7">Fans out messages to multiple subscribers based on event attributes</data>
    </node>
    <node id="8">
      <data key="d5">Downstream Processing SQS Queues</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues filtered by event type for downstream Spark jobs</data>
    </node>
    <node id="9">
      <data key="d5">Reformatting Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Reformats partitions from hourly to daily levels</data>
    </node>
    <node id="10">
      <data key="d5">Main Pipeline SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers reformatted data before writing to main storage</data>
    </node>
    <node id="11">
      <data key="d5">MAIN Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake serving layer for ad-hoc queries</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Nakadi batches events and writes to archival S3 bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Object creation notification sent to SQS queue</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">SQS queue triggers partitioning Lambda</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">4</data>
      <data key="d9">Lambda partitions and writes data to RAW bucket</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">5</data>
      <data key="d9">Object creation in RAW bucket triggers SQS message</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">6</data>
      <data key="d9">SQS triggers enrichment Lambda</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">7</data>
      <data key="d9">Lambda publishes enriched messages to SNS topic</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">8</data>
      <data key="d9">SNS fans out filtered messages to downstream SQS queues</data>
      <data key="d10">8a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">8</data>
      <data key="d9">SNS routes unfiltered messages to reformatting Lambda</data>
      <data key="d10">8b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">9</data>
      <data key="d9">Reformatting Lambda outputs to SQS queue</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">10</data>
      <data key="d9">SQS pipeline writes processed data to MAIN S3 bucket</data>
      <data key="d10">10</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Zalando Serverless Data Lake Architecture</data>
    <data key="d1" />
    <data key="d2">Data ingestion pipeline from Nakadi event bus through S3 archival, raw bucket enrichment, SNS fan-out, and main data lake storage.</data>
    <data key="d3">Data Lake, Analytics, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
