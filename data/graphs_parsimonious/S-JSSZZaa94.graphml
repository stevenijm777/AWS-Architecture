<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point receiving incoming traffic from clients.</data>
    </node>
    <node id="1">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Routes traffic using port forwarding via VPC Link.</data>
    </node>
    <node id="2">
      <data key="d5">EKS Cluster 1</data>
      <data key="d6">EKS</data>
      <data key="d7">Kubernetes cluster running application services.</data>
    </node>
    <node id="3">
      <data key="d5">EKS Cluster 2</data>
      <data key="d6">EKS</data>
      <data key="d7">Additional Kubernetes cluster handling containerized workloads.</data>
    </node>
    <node id="4">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Stores application logs collected from CloudWatch Logs.</data>
    </node>
    <node id="5">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects infrastructure metrics and logs.</data>
    </node>
    <node id="6">
      <data key="d5">X-Ray</data>
      <data key="d6">XRay</data>
      <data key="d7">Provides distributed tracing for microservices.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway forwards request via VPC Link to NLB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">NLB forwards traffic to top EKS cluster.</data>
      <data key="d10">2a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">NLB forwards traffic to bottom EKS cluster.</data>
      <data key="d10">2b</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Samsung Health Microservices Architecture on EKS</data>
    <data key="d1">https://www.youtube.com/watch?v=S-JSSZZaa94</data>
    <data key="d2">Architecture uses EKS, NLB port forwarding via target groups, with CloudWatch, Elasticsearch, and X-Ray for observability.</data>
    <data key="d3">Compute, Networking, Monitoring</data>
    <data key="d4">True</data>
  </graph>
</graphml>
