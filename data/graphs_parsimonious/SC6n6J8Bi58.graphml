<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">MNO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Visited Mobile Network Operator handling e-scooters and cellular devices</data>
    </node>
    <node id="1">
      <data key="d5">IPX</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">IP Exchange global private network for roaming traffic</data>
    </node>
    <node id="2">
      <data key="d5">AWS Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Provides reliable high-speed connectivity from IPX carriers</data>
    </node>
    <node id="3">
      <data key="d5">UDP NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Network Load Balancer receiving control plane UDP requests</data>
    </node>
    <node id="4">
      <data key="d5">ECS Control Plane</data>
      <data key="d6">ECS</data>
      <data key="d7">Processes GTP CreateSession requests</data>
    </node>
    <node id="5">
      <data key="d5">EC2 User Plane</data>
      <data key="d6">EC2</data>
      <data key="d7">Specialized high-speed packet processing cluster for IP traffic</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores SIM configurations and security policies</data>
    </node>
    <node id="7">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes management APIs for provisioning and configuration</data>
    </node>
    <node id="8">
      <data key="d5">Admin</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Administrator configuring system features and portal settings</data>
    </node>
    <node id="9">
      <data key="d5">Customer Backend</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Customer backend application receiving device data</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">MNO sends roaming IP traffic into IPX</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">MNO sends GTP CreateSession request to UDP NLB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">IPX forwards IP traffic to Direct Connect</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Direct Connect delivers IP packet traffic to EC2 User Plane</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">NLB responds back to MNO with session assignment parameters</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">NLB forwards CreateSession GTP request to ECS Control Plane</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS Control Plane queries Amazon Aurora for SIM configuration</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS Control Plane pushes session configuration down to EC2 User Plane</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">EC2 User Plane forwards packet payload to Customer Backend</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Aurora returns configuration settings to ECS Control Plane</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">4</data>
      <data key="d9">API Gateway updates device policy and SIM configuration in Aurora</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Admin updates configurations via API Gateway</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Customer Backend manages SIM configuration via API Gateway</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">emnify - Global Cellular Connectivity Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=SC6n6J8Bi58</data>
    <data key="d2">Cellular connectivity architecture processing control plane GTP sessions and high-throughput IP user plane traffic.</data>
    <data key="d3">Networking &amp; IoT</data>
    <data key="d4">True</data>
  </graph>
