  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Vehicle Device</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Retrofit telematics device in the customer vehicle</data>
    </node>
    <node id="1">
      <data key="d5">Driver / Customer</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Customer involved in an incident</data>
    </node>
    <node id="2">
      <data key="d5">Emergency Agent</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Human agent handling escalated emergency situations</data>
    </node>
    <node id="3">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests telematics data and evaluates rules</data>
    </node>
    <node id="4">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Evaluates accident alerts and triggers downstream actions</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Handles automated outreach to car, driver, and routing to agents</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Lex</data>
      <data key="d6">Lex</data>
      <data key="d7">Processes driver responses to classify incident details</data>
    </node>
    <node id="7">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates step-by-step incident response workflows</data>
    </node>
    <node id="8">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores full incident reports and telemetry graphs</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Analyzes incident video footage for safety and fraud detection</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Vehicle telematics and accident data sent to AWS IoT Core</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS IoT Core rules engine forwards event to Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda invokes Amazon Connect to initiate communication</data>
      <data key="d10">3a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda invokes Step Functions workflow</data>
      <data key="d10">3b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Connect routes call to human Agent</data>
      <data key="d10">4a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Amazon Connect contacts the in-vehicle device directly</data>
      <data key="d10">4b</data>
      <data key="d11">data</data>
