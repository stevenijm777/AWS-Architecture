  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API (MX3 / Grid Scheduler)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Murex trading application and RISP platform interface</data>
    </node>
    <node id="1">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Fans out job execution requests to priority queues</data>
    </node>
    <node id="2">
      <data key="d5">SQS (HIGH)</data>
      <data key="d6">SQS</data>
      <data key="d7">High-priority queue for trader submissions</data>
    </node>
    <node id="3">
      <data key="d5">SQS (MED)</data>
      <data key="d6">SQS</data>
      <data key="d7">Medium-priority queue for back-office users</data>
    </node>
    <node id="4">
      <data key="d5">SQS (LOW)</data>
      <data key="d6">SQS</data>
      <data key="d7">Low-priority queue for batch processing</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA 300</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda with 300 provisioned concurrency for high queue</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA 200</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda with 200 provisioned concurrency for medium queue</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA 100</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda with 100 provisioned concurrency for low queue</data>
    </node>
    <node id="8">
      <data key="d5">S3 (INPUT)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores non-sensitive input computation data</data>
    </node>
    <node id="9">
      <data key="d5">EFS (BINARY)</data>
      <data key="d6">EFS</data>
      <data key="d7">Mounted to Lambda for fast access to binary financial models</data>
    </node>
    <node id="10">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores calculation output results and execution status</data>
    </node>
    <node id="11">
      <data key="d5">ELASTICSEARCH</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Aggregates AWS and on-premise logs for monitoring via Grafana</data>
    </node>
    <edge source="0" target="8" id="0">
      <data key="d8">0</data>
