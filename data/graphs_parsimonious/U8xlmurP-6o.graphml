      <data key="d5">Notification Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Receives deposit alerts for company services</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Key management interaction</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
