<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Transaction File</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Customer transaction data upload</data>
    </node>
    <node id="1">
      <data key="d5">Input S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded customer transaction files</data>
    </node>
    <node id="2">
      <data key="d5">Job Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues notification jobs for uploaded files</data>
    </node>
    <node id="3">
      <data key="d5">CloudWatch Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Scheduled trigger running every 5 minutes</data>
    </node>
    <node id="4">
      <data key="d5">Queue Checker Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Checks SQS queue and triggers Step Functions</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions Workflow</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates batch processing execution</data>
    </node>
    <node id="6">
      <data key="d5">EC2 Invoker Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invoked by Step Functions to launch EC2</data>
    </node>
    <node id="7">
      <data key="d5">Batch Processing EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Windows EC2 instance performing batch compute</data>
    </node>
    <node id="8">
      <data key="d5">Config S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores initialization and configuration files</data>
    </node>
    <node id="9">
      <data key="d5">SQL Server</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores batch processing results</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Customer uploads file to S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 sends notification event to SQS queue</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch invokes Lambda on schedule</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda checks SQS queue for pending jobs</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda invokes Step Functions workflow</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes Lambda to provision EC2</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda launches EC2 instance</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 reports task state back to Step Functions</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 writes output results to SQL Server database</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 downloads dependencies/config from S3</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">FICO Transaction Processing Architecture</data>
    <data key="d1" />
    <data key="d2">Batch processing workflow using Step Functions, Lambda, EC2, S3, SQS, CloudWatch, and RDS.</data>
    <data key="d3" />
    <data key="d4">True</data>
  </graph>
</graphml>
