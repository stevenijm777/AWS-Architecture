<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Control Plane</data>
      <data key="d6">EC2</data>
      <data key="d7">Custom Kubernetes control plane running on a dedicated EC2 host</data>
    </node>
    <node id="1">
      <data key="d5">Kubernetes Pods</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker nodes/pods running multi-tenant workloads on EC2</data>
    </node>
    <node id="2">
      <data key="d5">STS</data>
      <data key="d6">STS</data>
      <data key="d7">AWS Security Token Service validating service account tokens and issuing temp credentials</data>
    </node>
    <node id="3">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">AWS Identity and Access Management defining fine-grained pod roles</data>
    </node>
    <node id="4">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Captures event logs from STS role assumptions</data>
    </node>
    <node id="5">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Ingests CloudTrail audit logs for monitoring and alerting</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Control plane injects signed service account tokens into pods</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Pod sends token directly to STS for verification</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">STS checks IAM role policies and conditions</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">5</data>
      <data key="d9">STS returns temporary credentials to pod</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">6</data>
      <data key="d9">STS emits token creation and role assumption events to CloudTrail</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">4</data>
      <data key="d9">IAM confirms permissions for requesting pod namespace</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">7</data>
      <data key="d9">CloudTrail events are ingested into Elasticsearch</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Airbnb Multi-Tenant Kubernetes Pod Security with AWS STS and IAM</data>
    <data key="d1">https://www.youtube.com/watch?v=WS2Qgx0qgCM</data>
    <data key="d2">Airbnb uses custom Kubernetes control plane on EC2 to inject cryptographically signed service account tokens into pods. Pods assume fine-grained IAM roles via STS, with audit events logged to CloudTrail and OpenSearch/Elasticsearch.</data>
    <data key="d3">Container Security &amp; Audit Logging</data>
    <data key="d4">True</data>
  </graph>
</graphml>
