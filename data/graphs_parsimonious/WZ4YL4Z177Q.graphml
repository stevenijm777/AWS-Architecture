    <node id="9">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake storing historical events</data>
    </node>
    <node id="10">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
