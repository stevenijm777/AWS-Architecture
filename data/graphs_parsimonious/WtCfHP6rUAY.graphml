<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">External client sending CQRS commands and queries</data>
    </node>
    <node id="1">
      <data key="d5">Command Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates and processes incoming CQRS write commands</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Event Store table storing system events</data>
    </node>
    <node id="3">
      <data key="d5">Streamer Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes DynamoDB streams to forward events and archive data</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Archives event store data</data>
    </node>
    <node id="5">
      <data key="d5">SNS FIFO</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes ordered events for fan-out</data>
    </node>
    <node id="6">
      <data key="d5">SQS FIFO</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue subscribed to SNS FIFO for domain event consumption</data>
    </node>
    <node id="7">
      <data key="d5">Event Handler Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Consumes business events from SQS FIFO to update projections</data>
    </node>
    <node id="8">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Read model projections optimized for access patterns</data>
    </node>
    <node id="9">
      <data key="d5">Query Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles CQRS read queries</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Client sends CQRS write command</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Client sends CQRS query request</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Emits event to Event Store</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB Stream triggers streamer Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Puts event to SNS FIFO</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Archives event data to S3</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Fan-out event to service SQS FIFO queue</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda pulls events from SQS FIFO</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Writes data to read model projection</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Query response returned to client</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Kupol Serverless CQRS Event Sourcing Architecture</data>
    <data key="d1" />
    <data key="d2">Serverless event-sourced architecture using DynamoDB, SNS FIFO, SQS FIFO, Lambda, and S3 for digital staffing platform.</data>
    <data key="d3">Serverless, Microservices, CQRS, Event-Driven</data>
    <data key="d4">True</data>
  </graph>
