<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Device</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">User accessing Alexa app on mobile</data>
    </node>
    <node id="1">
      <data key="d5">Alexa for Business</data>
      <data key="d6">AlexaForBusiness</data>
      <data key="d7">Enterprise Alexa service managing the custom skill</data>
    </node>
    <node id="2">
      <data key="d5">PM Skill Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Program Management skill logic</data>
    </node>
    <node id="3">
      <data key="d5">RDS (Aurora MySQL)</data>
      <data key="d6">RDS</data>
      <data key="d7">Database containing program management status data</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Key-value store for program abbreviations and pronunciations</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Data Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Ingests program management data into RDS</data>
    </node>
    <node id="6">
      <data key="d5">S3 Bucket (Data Extract)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores program management spreadsheet exports</data>
    </node>
    <node id="7">
      <data key="d5">S3 Bucket (Abbreviations Extract)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores abbreviations spreadsheet exports</data>
    </node>
    <node id="8">
      <data key="d5">Lambda (Abbreviations Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Ingests abbreviations into DynamoDB</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Voice request sent from Mobile Alexa app to Alexa for Business</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Alexa for Business invokes Program Management skill Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda queries RDS Aurora MySQL for program risk/status</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS returns program status data to Lambda function</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Lockheed Martin Program Management Voice Skill Architecture</data>
    <data key="d1" />
    <data key="d2">Voice application built with Alexa for Business, AWS Lambda, RDS Aurora MySQL, and DynamoDB for program status monitoring.</data>
    <data key="d3">Voice / Serverless / Database</data>
    <data key="d4">True</data>
  </graph>
