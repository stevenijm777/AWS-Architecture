<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Requests</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">150 billion incoming web requests daily.</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Receives external web traffic.</data>
    </node>
    <node id="2">
      <data key="d5">Spot Fleet</data>
      <data key="d6">EC2</data>
      <data key="d7">Processes web requests on spot instances.</data>
    </node>
    <node id="3">
      <data key="d5">EBS</data>
      <data key="d6">EBS</data>
      <data key="d7">Stores 600TB local log data.</data>
    </node>
    <node id="4">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs Spot Savior containers to process orphaned EBS volumes.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Final storage for processed log files.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Incoming web request traffic.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB routes web traffic to Spot Fleet instances.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Spot instances write uncompressed log data locally to EBS drives.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS mounts orphaned EBS volumes after spot termination.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS uploads processed log files to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Nextroll Architecture for Spot Fleet and Data Recovery</data>
    <data key="d1" />
    <data key="d2">Architecture for processing 150B daily requests using Spot Fleet, EBS, ECS, and S3.</data>
    <data key="d3">Compute, Storage, Log Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
