  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SAP Environment</data>
      <data key="d6">SAP</data>
      <data key="d7">Application layer running SAP with ABAP SDK / SLT extraction</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake / raw storage for extracted SAP records</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Data Streams</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Real-time streaming ingestion from SAP</data>
    </node>
    <node id="3">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Pub/Sub messaging notifications from SAP</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Data transformation and processing functions</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Extracts data from SAP into S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Streams data from SAP into Kinesis Data Streams</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Sends notifications / events from SAP to SNS</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Triggers Lambda function from SAP</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Syntax SAP Integration with AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=YV8e36ZywLk</data>
    <data key="d2">Architecture illustrating direct integration between an SAP environment and AWS services (S3, Kinesis Data Streams, SNS, Lambda) via an ABAP SDK / SLT.</data>
