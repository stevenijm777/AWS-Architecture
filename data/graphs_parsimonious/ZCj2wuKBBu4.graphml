<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Nike App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile app where users select sports interests.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for user request data.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Ingests data from API Gateway into the processing pipeline.</data>
    </node>
    <node id="3">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balances incoming user preference writes.</data>
    </node>
    <node id="4">
      <data key="d5">Auto Scaling</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">EC2 auto scaling fleet executing graph operations.</data>
    </node>
    <node id="5">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Graph database storing user relationships and interests.</data>
    </node>
    <node id="6">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Publishes interest update events to internal subscribers.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User preferences sent to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers intake Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda sends requests to load balancer.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB distributes load across EC2 Auto Scaling instances.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 instances execute graph writes on Neptune database.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 instances publish event notifications to SNS.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Nike Social Graph Architecture with Amazon Neptune</data>
    <data key="d1" />
    <data key="d2">Architecture of Nike's social graph processing user interest data using AWS serverless and graph database components.</data>
    <data key="d3">Database / Social Graph</data>
    <data key="d4">True</data>
  </graph>
</graphml>
