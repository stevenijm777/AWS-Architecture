  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEEPLENS</data>
      <data key="d6">DeepLens</data>
      <data key="d7">Captures user photo at the self-service hub</data>
    </node>
    <node id="1">
      <data key="d5">IDENTITY</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes user image and handles identity lookup</data>
    </node>
    <node id="2">
      <data key="d5">REKOGNITION</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Performs facial recognition on captured image</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores employee reference photos</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Caches recent location and user presence data</data>
    </node>
    <node id="5">
      <data key="d5">ALEXA</data>
      <data key="d6">AlexaForBusiness</data>
      <data key="d7">Voice device interface for self-service skills</data>
    </node>
    <node id="6">
      <data key="d5">WKSP HELPER</data>
      <data key="d6">Lambda</data>
      <data key="d7">Backend function for the Alexa Workspace Helper skill</data>
    </node>
    <node id="7">
      <data key="d5">STEP FUNCTIONS</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates approval process and provisioning workflow</data>
    </node>
    <node id="8">
      <data key="d5">WORKSPACES</data>
      <data key="d6">WorkSpaces</data>
      <data key="d7">Provisions virtual desktop for the authenticated user</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">DeepLens sends photo to Identity Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Identity Lambda passes image to Rekognition</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Identity Lambda stores photo in S3</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Identity Lambda caches user presence in DynamoDB</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Rekognition returns recognized identity to Lambda</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB returns identity details to Lambda</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">User invokes Alexa skill which triggers WKSP Helper Lambda</data>
      <data key="d10">1</data>
