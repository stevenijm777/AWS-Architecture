<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Edge Appliance (Primary)</data>
      <data key="d6">UserCompanyEdge</data>
      <data key="d7">On-premises or cloud edge appliance sending file lock requests</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">DNS routing and active-passive health checking</data>
    </node>
    <node id="2">
      <data key="d5">ELB (Primary Region)</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balances requests in primary region</data>
    </node>
    <node id="3">
      <data key="d5">EC2 (Primary Region)</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs file locking service logic</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB (Primary Region)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores file lock state records</data>
    </node>
    <node id="5">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Orchestrates failover and consistency logic between regions</data>
    </node>
    <node id="6">
      <data key="d5">ELB (Secondary Region)</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balances requests in secondary region</data>
    </node>
    <node id="7">
      <data key="d5">EC2 (Secondary Region)</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs file locking service logic in secondary region</data>
    </node>
    <node id="8">
      <data key="d5">DynamoDB (Secondary Region)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Replicated file lock state database</data>
    </node>
    <node id="9">
      <data key="d5">Edge Appliance (Secondary)</data>
      <data key="d6">UserCompanyEdge</data>
      <data key="d7">Edge appliance connected to secondary region</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Queries DNS and checks health status</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends file lock request</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Replicates lock tables between regions</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Instructs ELB to accept/reject incoming traffic during failover</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Manages secondary region ELB state during failover</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Monitors primary DynamoDB replication status</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Monitors secondary DynamoDB replication status</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Nasuni Global File Locking Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=_vjB_vF4Uec</data>
    <data key="d2">Multi-region active-passive file locking architecture with Route 53 DNS failover and DynamoDB global replication.</data>
    <data key="d3">Storage &amp; Global Systems</data>
    <data key="d4">True</data>
  </graph>
</graphml>
