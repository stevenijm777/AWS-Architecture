<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Security Hub (Members)</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Security Hub instance in a member account, aggregates local findings.</data>
    </node>
    <node id="1">
      <data key="d5">GuardDuty (Members)</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">GuardDuty instance in a member account, generates security findings.</data>
    </node>
    <node id="2">
      <data key="d5">Security Hub (Management)</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">Centralized Security Hub in the management account, aggregates findings from all member accounts.</data>
    </node>
    <node id="3">
      <data key="d5">GuardDuty (Management)</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Centralized GuardDuty in the management account, aggregates findings from all member accounts.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda (Config)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless function for configuring Security Hub and baselining findings in member accounts based on policies.</data>
    </node>
    <node id="5">
      <data key="d5">Policy Repository</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing JSON-based security policies for configuration and filtering.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda (Filter/Enrich)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless function that filters and enriches relevant security findings based on policies from S3.</data>
    </node>
    <node id="7">
      <data key="d5">Step Functions (Autoremediation)</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Workflow service to orchestrate automated remediation actions for relevant findings.</data>
    </node>
    <node id="8">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Delivers enriched security findings to external SIEM systems (e.g., Splunk).</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Findings from Security Hub in member accounts are sent to the central Security Hub.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Findings from GuardDuty in member accounts are sent to the central GuardDuty.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Aggregated findings from Management Security Hub are sent to Lambda (Filter/Enrich).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Aggregated findings from Management GuardDuty are sent to Lambda (Filter/Enrich).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda (Config) interacts with S3 Policy Repository.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda (Filter/Enrich) interacts with S3 Policy Repository to retrieve policies.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Relevant and enriched findings are sent to Step Functions for auto-remediation.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Relevant and enriched findings are sent to Kinesis Firehose for SIEM integration.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">AWS Security Foundation Architecture</data>
    <data key="d1">Not provided in prompt</data>
    <data key="d2">Centralized security management for over 100 AWS member accounts. Security findings are aggregated from member accounts to a management account, then filtered, enriched, and routed for automated remediation and SIEM integration. Policies for configuration and filtering are stored in S3.</data>
    <data key="d3">Security, Management, Automation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
