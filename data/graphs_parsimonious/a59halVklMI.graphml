  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Third Party Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Collects vehicle data at 6 second frequency into Kafka</data>
    </node>
    <node id="1">
      <data key="d5">VPC</data>
