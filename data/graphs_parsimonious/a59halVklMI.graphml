      <data key="d7">Stores customer, vehicle, and geospatial relational data</data>
    </node>
    <node id="9">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Ad-hoc SQL query tool for data analysts</data>
    </node>
    <node id="10">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for structured analytics</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
