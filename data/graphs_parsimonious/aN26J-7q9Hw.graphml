  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Mobile App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Triggers card management requests</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives web service calls</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes card processing logic and authentication</data>
    </node>
    <node id="3">
      <data key="d5">Systems Manager</data>
      <data key="d6">SystemsManager</data>
      <data key="d7">Stores secrets and electronic certificates</data>
    </node>
    <node id="4">
      <data key="d5">AWS KMS</data>
      <data key="d6">KMS</data>
