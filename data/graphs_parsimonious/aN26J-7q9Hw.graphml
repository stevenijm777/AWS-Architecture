    <node id="8">
      <data key="d5">NAT Gateway</data>
      <data key="d6">NAT</data>
      <data key="d7">Outbound internet gateway</data>
    </node>
    <node id="9">
      <data key="d5">Sentry</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party application logging service</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User initiates request from mobile app</data>
