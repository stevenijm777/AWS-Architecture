  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client Applications / Developers</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">HubSpot internal microservices submitting tasks</data>
    </node>
    <node id="1">
      <data key="d5">Enqueue EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Ingests incoming tasks</data>
    </node>
    <node id="2">
      <data key="d5">SQS Unique</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for uniqueness processing</data>
    </node>
    <node id="3">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Self-managed Kafka fallback buffer</data>
    </node>
    <node id="4">
      <data key="d5">Unique EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Performs task uniqueness verification</data>
    </node>
    <node id="5">
      <data key="d5">HBase</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data store for task uniqueness IDs</data>
    </node>
    <node id="6">
      <data key="d5">SQS Scheduler</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for scheduled tasks</data>
    </node>
    <node id="7">
      <data key="d5">Scheduler EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Saves scheduled tasks into storage</data>
    </node>
    <node id="8">
      <data key="d5">MySQL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Relational database for scheduled tasks</data>
    </node>
    <node id="9">
      <data key="d5">Schedule Watcher EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Polls MySQL for due tasks</data>
    </node>
    <node id="10">
      <data key="d5">SQS Schedule Watcher</data>
      <data key="d6">SQS</data>
      <data key="d7">Final queue for consumer execution</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Developer enqueues task request</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends message to SQS Unique queue</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Fallback path to Kafka if SQS times out</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Unique worker receives message from SQS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Worker drains Kafka messages back into SQS</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Checks uniqueness against HBase</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Passes unique tasks to SQS Scheduler</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Scheduler service receives task</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Stores task schedule in MySQL</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Schedule Watcher polls MySQL for ready tasks</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Produces ready task to final SQS queue for consumers</data>
