<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Various data sources on-premises, running data ingestion pipelines.</data>
    </node>
    <node id="1">
      <data key="d5">SFTP</data>
      <data key="d6">TransferFamily</data>
      <data key="d7">AWS Transfer for SFTP used for ingesting external data into S3.</data>
    </node>
    <node id="2">
      <data key="d5">PrivateLink</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">AWS PrivateLink used for ingesting on-premises data to the PCI account's landing S3 bucket.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Landing Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">S3 landing bucket in the PCI account. Receives raw PCI data, with S3 lifecycle policies and triggers enabled. This is where the initial ingested data lands. Also maintains an archive bucket for audit purposes.</data>
    </node>
    <node id="4">
      <data key="d5">SNS Topic</data>
      <data key="d6">SNS</data>
      <data key="d7">SNS topic subscribed by security services in EC2, triggered by S3 object creation in the landing bucket.</data>
    </node>
    <node id="5">
      <data key="d5">Security Services</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances in the PCI account running security services for data tokenization, file format conversion, and data curation. PCI scope is limited to this account.</data>
    </node>
    <node id="6">
      <data key="d5">S3 Curated Data</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket in the production account. Stores curated and tokenized data from the PCI account. Serves as a petabyte-scale data warehouse (EDW) for analytics and machine learning. This data is synced to the EDW for general purpose consumption.</data>
    </node>
    <node id="7">
      <data key="d5">Analytics &amp; ML Services</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances and other container platforms in the production account for general purpose analytics and machine learning consumption.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises data ingestion pipeline uses PrivateLink.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">External data ingests to on-premises then uses SFTP.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">SFTP ingests data into the S3 landing bucket in the PCI account.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Data ingested via PrivateLink to the S3 landing bucket in the PCI account.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 landing bucket triggers an SNS topic upon data arrival.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">SNS notifies EC2 security services for consumption and processing.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Curated and tokenized data from PCI EC2 services is ingested into the production S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Analytics and machine learning services consume curated data from the production S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Discover Financial Services Cloud Data Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=UNKNOWN_VIDEO_ID</data>
    <data key="d2">Architecture for Discover Financial Services' cloud data platform, separating PCI-compliant data processing in a dedicated PCI account from general analytics and machine learning in a production account. Handles petabyte-scale data.</data>
    <data key="d3">Data Analytics, Security, Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
