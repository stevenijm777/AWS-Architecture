<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Construction Site Camera</data>
      <data key="d6">UserConsumerCamera</data>
      <data key="d7">Cameras worldwide ingesting approximately 86,000 images per day.</data>
    </node>
    <node id="1">
      <data key="d5">SFTP</data>
      <data key="d6">TransferFamily</data>
      <data key="d7">Amazon Transfer Family (SFTP) used by each tenant to connect their camera easily.</data>
    </node>
    <node id="2">
      <data key="d5">Input S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">First injection layer where raw images are stored before processing.</data>
    </node>
    <node id="3">
      <data key="d5">Instant Processor Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function for immediate processing of newly uploaded images in the 'INSTANT' layer.</data>
    </node>
    <node id="4">
      <data key="d5">Instant Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Amazon Rekognition used in the 'INSTANT' layer to find coordinates for blurring persons and license plates.</data>
    </node>
    <node id="5">
      <data key="d5">Processed Images S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Bucket storing processed (blurred) images, serving as the platform for customers.</data>
    </node>
    <node id="6">
      <data key="d5">Batch Processor Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function for batch processing, running overnight, in the 'BATCH' layer.</data>
    </node>
    <node id="7">
      <data key="d5">Rekognition Custom Labels</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Amazon Rekognition with custom labels, trained on construction workers, used in the 'BATCH' layer to improve accuracy.</data>
    </node>
    <node id="8">
      <data key="d5">Customer Web Platform User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Customers access processed images and project progress via an S3-backed website.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Image ingestion from cameras to SFTP endpoint.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Images are uploaded to the initial S3 bucket for storage.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">New image uploads to S3 trigger the instant processing Lambda function.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Images in the input S3 bucket are processed by the batch Lambda (e.g., on a schedule).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda invokes Amazon Rekognition for instant image analysis (blurring persons/license plates).</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Processed images from instant analysis are stored in the output S3 bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Users access the processed and archived images via a platform hosted from the S3 website bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Batch Lambda invokes Amazon Rekognition with custom labels for specific object detection (e.g., construction workers).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Results from batch processing (improved accuracy findings) are stored in the output S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">B2B Multi-tenant Construction Site Monitoring and Progress Solution</data>
    <data key="d1" />
    <data key="d2">This architecture describes a B2B multi-tenant solution for construction site monitoring that processes and obfuscates images using serverless components and Amazon Rekognition, including custom labels for enhanced detection. It handles about 86,000 images daily.</data>
    <data key="d3">Image Processing, Serverless, AI/ML, Data Ingestion, Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
