<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts the data warehouse with historical user data.</data>
    </node>
    <node id="1">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Extracts and processes historical data from S3 using PySpark ETL, transforming it for Neptune.</data>
    </node>
    <node id="2">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Graph database storing historical and real-time user identities, data points, and relationships for fraud detection. Used for both initial data load and real-time lookups.</data>
    </node>
    <node id="3">
      <data key="d5">Pi Event Processor</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom system developed by Kareem engineers to process every user event (login, ride, purchase) on the app in real-time.</data>
    </node>
    <node id="4">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for streaming real-time events from the Pi Event Processor to Elastic Beanstalk.</data>
    </node>
    <node id="5">
      <data key="d5">Elastic Beanstalk</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Core codebase that processes and transforms real-time event data, writes to Neptune, performs rule-based fraud detection, and provides APIs for graph queries and blocking.</data>
    </node>
    <node id="6">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Represents end-users interacting with the Karim application, performing actions that generate events.</data>
    </node>
    <node id="7">
      <data key="d5">UI</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Internal user interface used by Kareem teams to query and view user identity details in the graph via an API.</data>
    </node>
    <node id="8">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores fraud classification decisions made by the Elastic Beanstalk application.</data>
    </node>
    <node id="9">
      <data key="d5">Ticketing System</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">An external ticketing system for manual review of high-value customers classified as potentially fraudulent.</data>
    </node>
    <node id="10">
      <data key="d5">Neptune ML</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Future integration (version 2) for training deep learning models (graph convolutional network) on the Neptune graph to improve fraud prediction accuracy, replacing the rule-based system in Elastic Beanstalk.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Historical data is extracted from S3 by EMR.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EMR runs an ETL pipeline using PySpark to load transformed historical data into the Neptune graph database.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">After an event, Elastic Beanstalk performs a second read to extract user data and surrounding neighbors from Neptune for fraud analysis.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="10" id="0">
      <data key="d8">5</data>
      <data key="d9">Neptune ML trains deep learning models using data from the Neptune graph database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Real-time user events are streamed from the Pi Event Processor into an SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The Elastic Beanstalk core codebase consumes events from the SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Processed and transformed real-time event data is written to the Neptune graph database.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Fraud classification decisions from Elastic Beanstalk's rule-based system are written to RDS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="1">
      <data key="d8">4</data>
      <data key="d9">Elastic Beanstalk provides a 'Blocking' API that interacts with RDS to manage fraud decisions and user blocking (for lower value users, automatically blocked).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Elastic Beanstalk exposes a 'CrazyWall' API allowing users/downstream tasks to query graph data about user identities.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Elastic Beanstalk exposes a 'CrazyWall' API allowing internal UIs to query graph data about user identities.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">User actions on the application generate real-time events processed by the Pi Event Processor.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Decisions for high-value customers identified as potentially fraudulent are sent to a ticketing system for manual review.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="5" id="0">
      <data key="d8">5</data>
      <data key="d9">Neptune ML's predictions or trained models will be used by Elastic Beanstalk to enhance fraud detection accuracy.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">CrazyWall</data>
    <data key="d1">N/A</data>
    <data key="d2">Karim's 'CrazyWall' fraud detection system integrates historical user data with real-time event processing. Historical data from S3 is processed via EMR and loaded into Neptune, a graph database representing user identities and relationships. Real-time user events are captured by a custom 'Pi Event Processor', streamed through SQS, and processed by Elastic Beanstalk. Beanstalk writes processed data to Neptune and performs rule-based fraud detection. Fraud decisions are stored in RDS, with high-value cases routed to a 'Ticketing System' for manual review. The system also exposes an API for other teams and a blocking API. Future plans involve integrating Neptune ML for enhanced prediction accuracy.</data>
    <data key="d3">Fraud Detection, Graph Database, Real-time Processing, Historical Data Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
