  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Data Warehouse</data>
      <data key="d6">S3</data>
      <data key="d7">Stores historical user data</data>
    </node>
    <node id="1">
      <data key="d5">EMR Cluster</data>
      <data key="d6">EMR</data>
      <data key="d7">Extracts and transforms historical data using PySpark</data>
    </node>
    <node id="2">
      <data key="d5">Neptune Graph Database</data>
      <data key="d6">Neptune</data>
      <data key="d7">Stores historical snapshot and real-time graph of user identities and attributes</data>
    </node>
    <node id="3">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Streams real-time user action events</data>
    </node>
    <node id="4">
      <data key="d5">Elastic Beanstalk</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Core codebase processing events, executing fraud rules, and querying graph</data>
    </node>
    <node id="5">
      <data key="d5">RDS Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores fraud classification decisions</data>
    </node>
    <node id="6">
      <data key="d5">API Crazywall</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API exposing graph queries to downstream consumers</data>
    </node>
    <node id="7">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Internal Careem teams/consumers querying user identities</data>
    </node>
    <node id="8">
      <data key="d5">UI</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Visualization UI to view user identity graphs</data>
    </node>
    <node id="9">
      <data key="d5">API Blocking</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API routing blocking and manual review decisions</data>
    </node>
    <node id="10">
      <data key="d5">Ticketing System</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Manual review queue for high-value customer fraud alerts</data>
    </node>
    <node id="11">
      <data key="d5">Neptune ML</data>
      <data key="d6">Neptune</data>
      <data key="d7">Planned deep learning / GCN model component on graph data</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
