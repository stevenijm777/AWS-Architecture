<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Event Bridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Periodically triggers the state machine workflow to refresh the ML model.</data>
    </node>
    <node id="1">
      <data key="d5">State Machine</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Manages the entire workflow for data pulling, training, and serving the machine learning model.</data>
    </node>
    <node id="2">
      <data key="d5">Preprocessing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invoked by the State Machine, queries Athena to pull and process customer browsing data, then pushes results to S3.</data>
    </node>
    <node id="3">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries customer browsing data from the data lake for preprocessing.</data>
    </node>
    <node id="4">
      <data key="d5">Processed Data S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores pre-processed browsing data used for model training and visually depicted as the source for served recommendations.</data>
    </node>
    <node id="5">
      <data key="d5">SageMaker Training</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Reads browsing data from S3 to train a Word2Vec algorithm using the Blazing Text container.</data>
    </node>
    <node id="6">
      <data key="d5">SageMaker Deployment</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Deploys the trained model as an endpoint, handling configuration and deployment into production.</data>
    </node>
    <node id="7">
      <data key="d5">Recommendation Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invoked by API Gateway, requests recommendations from the SageMaker endpoint and processes them.</data>
    </node>
    <node id="8">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Streamlines authentication and routing of user requests to various SageMaker endpoints, managing APIs and security.</data>
    </node>
    <node id="9">
      <data key="d5">User Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Represents the end-user interacting with the Onaz platform, browsing products, and receiving personalized recommendations.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge periodically triggers the machine learning workflow managed by the State Machine.</data>
      <data key="d10">0.0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">The State Machine invokes the Preprocessing Lambda as the first step of the workflow.</data>
      <data key="d10">0.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">The Preprocessing Lambda queries Athena to retrieve browsing data.</data>
      <data key="d10">0.2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">The Preprocessing Lambda triggers the SageMaker training job after data preparation.</data>
      <data key="d10">0.4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Data sourced by Athena (and processed by Lambda) is stored in the S3 bucket.</data>
      <data key="d10">0.3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Visually, recommendations are depicted as being served from S3 directly to the user's frontend.</data>
      <data key="d10">1.4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker Training reads the pre-processed browsing data from S3.</data>
      <data key="d10">0.5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">After training, SageMaker triggers the model deployment process.</data>
      <data key="d10">0.6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">The SageMaker endpoint returns recommended items to the Recommendation Lambda.</data>
      <data key="d10">1.3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">The Recommendation Lambda requests personalized recommendations from the SageMaker deployed endpoint.</data>
      <data key="d10">1.2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes the Recommendation Lambda to handle the request.</data>
      <data key="d10">1.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">User's browser sends a request to the API Gateway when browsing product pages.</data>
      <data key="d10">1.0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Item-Based Recommender System for Onaz</data>
    <data key="d1" />
    <data key="d2">Architecture for Onaz's item-based recommender system, using clickstream data for personalization. The workflow involves periodic model training and deployment via SageMaker, with real-time inference served through API Gateway and Lambda. The diagram visually depicts recommendations directly from S3 to the user's browser, representing the served recommendations.</data>
    <data key="d3">Machine Learning, E-commerce, Personalization</data>
    <data key="d4">True</data>
  </graph>
</graphml>
