  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Triggers the state machine workflow periodically</data>
    </node>
    <node id="1">
      <data key="d5">State Machine</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates data fetching, model training, and model serving</data>
    </node>
    <node id="2">
      <data key="d5">Lambda (Pre-processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes data retrieval and pre-processing logic</data>
    </node>
    <node id="3">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries customer browsing data from the data lake</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores processed training data and model artifacts</data>
    </node>
    <node id="5">
      <data key="d5">SageMaker (Training)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs Word2Vec model training using BlazingText container</data>
    </node>
    <node id="6">
      <data key="d5">SageMaker (Deployment)</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Deploys model endpoint into production</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Serving)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles incoming recommendation requests and invokes SageMaker endpoint</data>
    </node>
    <node id="8">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles authentication and routes API requests</data>
    </node>
    <node id="9">
      <data key="d5">Web Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">User interface browsing products</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">EventBridge triggers State Machine execution</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
