<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kafka</data>
      <data key="d6">Kinesis</data>
      <data key="d7">External Kafka clusters receiving 30,000 events per second of user activity from mobile applications.</data>
    </node>
    <node id="1">
      <data key="d5">Kafka Streams EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Managed Kubernetes cluster running Kafka Streams applications to consume event streams for real-time aggregation/counters and raw material storage.</data>
    </node>
    <node id="2">
      <data key="d5">Data Lake S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake storing raw event data for later analysis, accumulating 400 GB daily, totaling 120 TB.</data>
    </node>
    <node id="3">
      <data key="d5">Spark ML EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Another EKS cluster running Spark applications for machine learning models, processing data from S3. Hundreds of clusters started daily for resilience and cost efficiency using Spot instances.</data>
    </node>
    <node id="4">
      <data key="d5">Aggregated Metrics RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores aggregated prediction metrics for fast access, optimizing for speed.</data>
    </node>
    <node id="5">
      <data key="d5">Raw User Data Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Stores raw data for every user, optimizing for flexibility in access patterns.</data>
    </node>
    <node id="6">
      <data key="d5">Customer Dashboard</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">React application dashboard for customers to view revenue prediction and related information.</data>
    </node>
    <node id="7">
      <data key="d5">Go API EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS cluster running an API endpoint built in Go, accessed by the customer dashboard to retrieve data from data stores.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Stream of user activity events (30k events/sec).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw event data stored in S3 for later analysis (adds 400GB daily).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Real-time computed aggregations and counters.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Machine learning models in Spark applications process data from S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Output: aggregated prediction metrics from ML models.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Output: raw data for every user from ML models.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Go API receives aggregated prediction metrics from RDS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Customer dashboard (React app) interacts with the Go API endpoint.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Customer dashboard directly accesses aggregated prediction metrics from RDS (as per visual).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Go API accesses aggregated prediction metrics from RDS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Go API accesses raw user data from Redshift.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Addictive Mobile Application Analytics Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture for Addictive, an ad tech company, providing analytics products to help mobile application publishers optimize ad spending by predicting revenue per user.</data>
    <data key="d3">Analytics, Data Processing, Machine Learning</data>
    <data key="d4">True</data>
