<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Console User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">User interacting with the web console for data ingestion and system access.</data>
    </node>
    <node id="1">
      <data key="d5">User Authentication</data>
      <data key="d6">Cognito</data>
      <data key="d7">Authenticates users logging into the web console.</data>
    </node>
    <node id="2">
      <data key="d5">External Data Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Represents various external data sources including RDS instances, S3 buckets, FTP locations, and APIs, from which JD Power ingests data.</data>
    </node>
    <node id="3">
      <data key="d5">Data Lake Storage</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized storage for all ingested raw and processed data, acting as the foundation of the data lake.</data>
    </node>
    <node id="4">
      <data key="d5">Data Catalog &amp; ETL</data>
      <data key="d6">Glue</data>
      <data key="d7">Used to crawl data sources, create catalogs of data, and perform initial ETL operations, including moving data to S3.</data>
    </node>
    <node id="5">
      <data key="d5">Custom Crawler Trigger</data>
      <data key="d6">Lambda</data>
      <data key="d7">A serverless function that is triggered when Glue cannot process a file, initiating custom crawlers on Fargate.</data>
    </node>
    <node id="6">
      <data key="d5">Custom Crawlers &amp; ML Endpoints</data>
      <data key="d6">Fargate</data>
      <data key="d7">Runs custom crawlers for special file formats not handled by Glue, and hosts Jupyter Notebook/RStudio endpoints for data scientists.</data>
    </node>
    <node id="7">
      <data key="d5">Ad-hoc Query &amp; Transformation</data>
      <data key="d6">Athena</data>
      <data key="d7">Used for most data analytical and transformation activities, including converting data to Parquet format and applying cleaning rules.</data>
    </node>
    <node id="8">
      <data key="d5">Data Warehouse</data>
      <data key="d6">RedShift</data>
      <data key="d7">Serves as a data warehouse, exposing transformed data to analytical platforms for dashboard creation.</data>
    </node>
    <node id="9">
      <data key="d5">Dashboard Platform</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Analytical platform where dashboards are created using data from Redshift.</data>
    </node>
    <node id="10">
      <data key="d5">ML Development</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Platform where data scientists build and train machine learning models, utilizing Fargate-provisioned environments.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User logs into the web console and is authenticated by Cognito.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">User interaction with the data ingestion module through the web console leads to data storage in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Once authenticated, user actions in the data ingestion module can trigger a Lambda function for custom processing.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw data from various external sources (RDS, S3, FTP, APIs) is moved into S3 buckets.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue crawls data stored in S3 to create catalogs and prepare it for analysis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries and transforms data directly from S3, performing activities like Parquet conversion and cleaning.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue processes data, creates catalogs, and saves processed or cataloged data back into S3 buckets.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena utilizes the catalogs created by Glue to understand and query the data structure.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda triggers custom crawlers running on Fargate for handling special file formats that Glue cannot process natively.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Fargate is used to provision Jupyter Notebook or RStudio endpoints, providing an environment for data scientists to work on the Machine Learning platform.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Transformed and cleaned data from Athena is moved to Redshift to build a data warehouse for advanced analytics.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Redshift exposes the prepared data to an analytical platform for creating dashboards and reports.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">JD Power AI Cloud Data Lake Solution</data>
    <data key="d1" />
    <data key="d2">Architecture for JD Power's AI Cloud data lake solution, designed for ingesting various data sources, cataloging, transforming, and enabling analytics and machine learning workloads.</data>
    <data key="d3">Data Lake, Analytics, Machine Learning, Data Ingestion</data>
    <data key="d4">True</data>
  </graph>
</graphml>
