<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Garden Device</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Internet-connected small garden device with sensors (water level, humidity, temperature) running FreeRTOS and sending state updates.</data>
    </node>
    <node id="1">
      <data key="d5">Mobile Application</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">User's mobile application for receiving push notifications (e.g., low water alerts) and providing feedback or actions back to the system.</data>
    </node>
    <node id="2">
      <data key="d5">IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests sensor data from garden devices via MQTT and utilizes the device shadow service to replicate garden state, triggering topic rules for further processing.</data>
    </node>
    <node id="3">
      <data key="d5">Garden Logic Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes state changes from IoT Core topic rules, combines metadata, and interacts with Pinpoint for notifications or updates Pinpoint based on user feedback.</data>
    </node>
    <node id="4">
      <data key="d5">Pinpoint</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">Sends targeted push notifications to users based on garden state (e.g., low water), manages user segments, journeys, and campaign interactions.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Provides an endpoint for the mobile application to send user feedback and actions (e.g., 'watered plant', 'ignored notification') back to the system.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Sensor readings (water level, relative humidity, temperature) sent from the garden device via MQTT to IoT Core's device shadow.</data>
      <data key="d10">0.0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">User actions or feedback (e.g., 'I watered my plant', 'acknowledged notification') sent from the mobile application to API Gateway.</data>
      <data key="d10">1.0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Core topic rule triggers Lambda upon detection of specific garden state changes (e.g., low water level).</data>
      <data key="d10">0.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda sends enriched garden state information and user details to Pinpoint to initiate a targeted push notification campaign.</data>
      <data key="d10">0.2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="1">
      <data key="d8">1</data>
      <data key="d9">Lambda updates Pinpoint attributes or segments based on user feedback to influence future notification strategy (e.g., increasing aggressiveness for ignored notifications or giving credit for positive actions).</data>
      <data key="d10">1.2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Pinpoint sends push notifications (e.g., 'Your garden needs water!') to the user's mobile application.</data>
      <data key="d10">0.3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway forwards user feedback requests to Lambda for processing and association of meta information.</data>
      <data key="d10">1.1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Smart Garden IoT and Notification System</data>
    <data key="d1">https://www.youtube.com/watch?v=kYcI8D8x3_k</data>
    <data key="d2">This architecture describes an internet-connected small garden system that monitors plant health and provides guidance to users via a mobile application. It leverages AWS IoT Core for device data ingestion, Lambda for processing, Pinpoint for push notifications, and API Gateway for handling user feedback.</data>
    <data key="d3">IoT, Mobile, Serverless, Notifications</data>
    <data key="d4">True</data>
  </graph>
</graphml>
