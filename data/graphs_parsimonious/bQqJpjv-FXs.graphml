<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart Garden Device</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Internet-connected garden device running FreeRTOS with sensors</data>
    </node>
    <node id="1">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Handles device shadow state updates and topic rules</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes state change events and enriches metadata</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Pinpoint</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">Manages journeys, endpoint attributes, and sends push notifications</data>
    </node>
    <node id="4">
      <data key="d5">Mobile Application</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">User mobile app receiving notifications and sending user updates</data>
    </node>
    <node id="5">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Ingests user interactions and feedback from the mobile app</data>
    </node>
    <node id="6">
      <data key="d5">Metadata Database</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores plant metadata, date, plant type, and user interaction feedback</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Garden sends sensor telemetry (water level, RH, temp) to IoT Core</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">IoT Core syncs state/shadow back to garden device</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Topic Rule (TR) triggers Lambda on state changes of interest</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">4</data>
      <data key="d9">Lambda populates endpoint attributes table in Pinpoint</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">5</data>
      <data key="d9">Pinpoint sends push notifications to user's mobile app</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">6</data>
      <data key="d9">User actions and feedback are sent from mobile app to API Gateway</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">7</data>
      <data key="d9">API Gateway updates user interaction and feedback metadata in database</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda fetches plant metadata (date planted, plant type) from database</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Eden - Smart Garden Notification System</data>
    <data key="d1">https://www.youtube.com/watch?v=bQqJpjv-FXs</data>
    <data key="d2">System processes garden sensor state changes, enriches events with database metadata, triggers mobile notifications via Pinpoint, and records user feedback via API Gateway.</data>
    <data key="d3">IoT, Mobile Application, Event-Driven</data>
    <data key="d4">True</data>
  </graph>
</graphml>
