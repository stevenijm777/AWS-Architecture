<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Internal traders initiating pricing requests</data>
    </node>
    <node id="1">
      <data key="d5">External Data</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External market data source</data>
    </node>
    <node id="2">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Distributes incoming trading platform traffic</data>
    </node>
    <node id="3">
      <data key="d5">Pricing Engine</data>
      <data key="d6">ECS</data>
      <data key="d7">Routes task metadata and payload data</data>
    </node>
    <node id="4">
      <data key="d5">Pricing Workers (CPU)</data>
      <data key="d6">ECS</data>
      <data key="d7">CPU-based pricing computation workers</data>
    </node>
    <node id="5">
      <data key="d5">Pricing Workers (GPU)</data>
      <data key="d6">ECS</data>
      <data key="d7">GPU-accelerated pricing computation workers</data>
    </node>
    <node id="6">
      <data key="d5">Task Queues</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Stores job IDs and pending tasks</data>
    </node>
    <node id="7">
      <data key="d5">Processing Queues</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Stores in-flight task items being processed by workers</data>
    </node>
    <node id="8">
      <data key="d5">Pup/Sub</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">PubSub channel for result availability notifications</data>
    </node>
    <node id="9">
      <data key="d5">Payload</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Stores full trade and market data payloads and computation results</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User triggers request incorporating external market data</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">External data routed into Application Load Balancer</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">ALB routes request traffic into Pricing Engine</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Pricing engine places job ID into Task Queues</data>
      <data key="d10">3a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Pricing engine stores data payload in Redis Payload cache</data>
      <data key="d10">3b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">5</data>
      <data key="d9">CPU worker retrieves payload from Redis Payload</data>
      <data key="d10">5a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">7</data>
      <data key="d9">GPU worker fetches payload from Redis Payload</data>
      <data key="d10">7a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">4</data>
      <data key="d9">CPU pricing workers monitor and pick tasks from Task Queues</data>
      <data key="d10">4a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Popped tasks moved into Processing Queues</data>
      <data key="d10">4b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">6</data>
      <data key="d9">GPU workers monitor dedicated GPU tasks in Task Queues</data>
      <data key="d10">6a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="4" id="0">
      <data key="d8">5</data>
      <data key="d9">CPU worker saves calculation results back into Redis Payload</data>
      <data key="d10">5b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">7</data>
      <data key="d9">GPU worker stores computed results back into Redis Payload</data>
      <data key="d10">7b</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DBS Bank Quantitative Pricing Engine Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=bqZWYmRAka0</data>
    <data key="d2">Architecture for DBS Bank's quantitative pricing engine built on AWS ECS and ElastiCache for Redis.</data>
    <data key="d3">Financial Services, High-Performance Computing</data>
    <data key="d4">True</data>
  </graph>
