  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Internal traders submitting pricing requests</data>
    </node>
    <node id="1">
      <data key="d5">External Data</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External market and trade data</data>
    </node>
    <node id="2">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Routes incoming trading requests</data>
    </node>
    <node id="3">
      <data key="d5">Pricing Engine</data>
      <data key="d6">ECS</data>
      <data key="d7">Core engine component running on ECS</data>
    </node>
    <node id="4">
      <data key="d5">Pricing Workers (CPU)</data>
      <data key="d6">ECS</data>
      <data key="d7">CPU-based calculation workers</data>
    </node>
    <node id="5">
      <data key="d5">Pricing Workers (GPU)</data>
      <data key="d6">ECS</data>
      <data key="d7">GPU-accelerated calculation workers</data>
    </node>
    <node id="6">
      <data key="d5">Task Queues</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Redis task queue storing job IDs</data>
    </node>
    <node id="7">
      <data key="d5">Processing Queues</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Redis queue tracking active jobs</data>
    </node>
    <node id="8">
      <data key="d5">Pub/Sub</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Redis Pub/Sub channel for notifications</data>
    </node>
    <node id="9">
      <data key="d5">Payload</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Redis cache storing accurate payload data and results</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Users trigger pricing using external data</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">External market data sent to ALB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB forwards traffic to Pricing Engine</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Pricing Engine places job ID into Task Queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Pricing Engine stores request payload in Redis</data>
