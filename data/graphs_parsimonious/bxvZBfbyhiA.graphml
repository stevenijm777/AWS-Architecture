<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores input simulation data and output results</data>
    </node>
    <node id="1">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Orchestrates and spins up right-sized HPC nodes</data>
    </node>
    <node id="2">
      <data key="d5">HPC NODE</data>
      <data key="d6">EC2</data>
      <data key="d7">High-performance computing instances executing simulations</data>
    </node>
    <node id="3">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Ingests log streams and metrics from HPC nodes</data>
    </node>
    <node id="4">
      <data key="d5">LAMBDA (Bottom)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by CloudWatch logs to process simulation status</data>
    </node>
    <node id="5">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores simulation run records and timestamps</data>
    </node>
    <node id="6">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Distributes notification events for downstream processing</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA (Top)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes queued SNS events</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS spins up HPC nodes</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">HPC node writes simulation results back to S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">HPC node streams execution logs and status to CloudWatch</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch triggers Lambda on pattern match</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda records start/end timestamps and metadata in DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda publishes notification message to SNS</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS triggers additional Lambdas for further processing</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">OnScale: Cloud HPC Orchestration</data>
    <data key="d1">https://www.youtube.com/watch?v=kYJ4h4q3s4g</data>
    <data key="d2">Architecture for orchestrating massive parallel HPC simulations using EKS, EC2, CloudWatch, Lambda, DynamoDB, and SNS.</data>
    <data key="d3">Compute, HPC, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
