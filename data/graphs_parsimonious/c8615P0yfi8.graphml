<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Triggers the pipeline periodically</data>
    </node>
    <node id="1">
      <data key="d5">State Machine</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the machine learning workflow stages</data>
    </node>
    <node id="2">
      <data key="d5">Data Prep Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invokes Athena to query data lake and process user browsing history</data>
    </node>
    <node id="3">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries the data lake</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores training data and model artifacts</data>
    </node>
    <node id="5">
      <data key="d5">SageMaker Training</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains the Word2Vec model using BlazingText container</data>
    </node>
    <node id="6">
      <data key="d5">SageMaker Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Deployed endpoint for real-time inference</data>
    </node>
    <node id="7">
      <data key="d5">Inference Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invokes SageMaker endpoint</data>
    </node>
    <node id="8">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives recommendation requests</data>
    </node>
    <node id="9">
      <data key="d5">Frontend / User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Client web platform</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Periodic trigger from EventBridge</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Executes query against data lake</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Transitions to model training stage</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Saves processed query results to S3</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Outputs trained model artifact to S3</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Transitions to model deployment stage</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ounass Real-time Recommendation Architecture</data>
    <data key="d1" />
    <data key="d2">State machine-driven data processing, training, and deployment pipeline using SageMaker and Athena, supporting a recommendation API.</data>
    <data key="d3">Machine Learning &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
