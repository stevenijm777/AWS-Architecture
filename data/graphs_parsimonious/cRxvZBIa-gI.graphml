<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user">
      <data key="d0">UserConsumerWebMobile</data>
      <data key="d1">User / Mobile</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="alb">
      <data key="d0">ALB</data>
      <data key="d1">ALB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="eks">
      <data key="d0">EKS</data>
      <data key="d1">EKS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2">
      <data key="d0">EC2</data>
      <data key="d1">EC2</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="spot_instances">
      <data key="d0">EC2</data>
      <data key="d1">Spot Instance(s)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="aurora_global">
      <data key="d0">RDS</data>
      <data key="d1">Aurora Global</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="document_storage">
      <data key="d0">S3</data>
      <data key="d1">Document Storage</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="user" target="alb" id="0">
      <data key="d3">requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="alb" target="ec2" id="0">
      <data key="d3">routes traffic</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2" target="aurora_global" id="0">
      <data key="d3">ACID</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="ec2" target="document_storage" id="0">
      <data key="d3">NoSQL</data>
      <data key="d4">writes_to</data>
    </edge>
  </graph>
</graphml>
