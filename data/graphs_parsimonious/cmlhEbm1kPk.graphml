<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Callers / Customers</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">External callers dialing into the contact center</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Central software-defined contact center routing call interactions</data>
    </node>
    <node id="2">
      <data key="d5">Greetings Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes logic to fetch personalized greetings per country</data>
    </node>
    <node id="3">
      <data key="d5">Greetings Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores country-specific greetings and operational hours</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Lex</data>
      <data key="d6">Lex</data>
      <data key="d7">Provides natural language understanding for conversational interaction</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Translates greetings and disclaimers dynamically into multiple languages</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Polly</data>
      <data key="d6">Polly</data>
      <data key="d7">Converts translated text into localized voice audio output</data>
    </node>
    <node id="7">
      <data key="d5">Voice &amp; Text Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Stores encrypted call audio recordings and transcribed text documents</data>
    </node>
    <node id="8">
      <data key="d5">Transcription Trigger Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 object creation to initiate transcription process</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts voice recording audio files into searchable text documents</data>
    </node>
    <node id="10">
      <data key="d5">Call Center Agents / Auditors</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Searches inside transcribed text documents in S3 for compliance and auditing</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Callers initiate phone calls to Amazon Connect</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Connect invokes Lambda to retrieve country-specific settings</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Connect sends audio input to Lex for intent recognition</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Connect passes text strings to Translate</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Connect saves call voice recording files to S3 bucket</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda reads greetings data from DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Translate sends localized text to Polly to generate speech</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 object creation triggers transcription Lambda function</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda triggers Transcribe job on the audio recording</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Transcribe writes generated text file back to S3 data lake</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Agents and auditors search transcribed call text in S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Munich Re Global Serverless Contact Center Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=132X75a-y3c</data>
    <data key="d2">Serverless contact center architecture using Amazon Connect, Lex, Translate, Polly, Transcribe, Lambda, DynamoDB, and S3.</data>
    <data key="d3">Contact Center &amp; AI/ML Data Lake</data>
    <data key="d4">True</data>
  </graph>
</graphml>
