<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web user accessing propertyfinder.ae</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing incoming traffic</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS cluster managing worker nodes and pods</data>
    </node>
    <node id="3">
      <data key="d5">EC2 SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 Spot Instance in Availability Zone 1</data>
    </node>
    <node id="4">
      <data key="d5">EC2 SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 Spot Instance in Availability Zone 2</data>
    </node>
    <node id="5">
      <data key="d5">EC2 SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 Spot Instance in Availability Zone 3 (marked for termination)</data>
    </node>
    <node id="6">
      <data key="d5">EVENT BRIDGE</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Listens for EC2 Spot Instance termination notification events</data>
    </node>
    <node id="7">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by EventBridge to scale ASG and drain nodes</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User sends request to website via ALB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB routes web traffic to ingress pod running on EC2 Spot instance</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Workload distribution between AZ instances</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Workload distribution between AZ instances</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Termination warning event emitted to EventBridge</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">EventBridge triggers Lambda function</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda scales up ASG and drains terminating node</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">PropertyFinder Kubernetes EKS Architecture on 100% EC2 Spot Instances</data>
    <data key="d1">https://www.youtube.com/watch?v=cnZeOytEkIM</data>
    <data key="d2">PropertyFinder runs production Kubernetes workloads on 100% EC2 Spot instances managed via EKS, ALB, EventBridge, and Lambda for fault tolerance.</data>
    <data key="d3">Compute, Containers, Serverless, Event-Driven</data>
    <data key="d4">True</data>
  </graph>
