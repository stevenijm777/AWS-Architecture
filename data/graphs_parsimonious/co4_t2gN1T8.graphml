<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">External developer uploading GeoTIFF files</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives incoming files and requests</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores GeoTIFF and LandXML files</data>
    </node>
    <node id="3">
      <data key="d5">Third-Party Provider</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Converts GeoTIFF to LandXML</data>
    </node>
    <node id="4">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates validation Lambda functions</data>
    </node>
    <node id="5">
      <data key="d5">Lambda Validation</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates XML structure and compliance</data>
    </node>
    <node id="6">
      <data key="d5">Lambda Render</data>
      <data key="d6">Lambda</data>
      <data key="d7">Renders spatial polygons using geospatial libraries</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores validation results and document state</data>
    </node>
    <node id="8">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends notifications and alerts</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Developer uploads GeoTIFF through API Gateway</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway writes GeoTIFF to S3</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 triggers notification/sends file to third-party provider</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 event triggers Step Functions state machine</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Third-party sends converted LandXML back to S3</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes Lambda Validation</data>
      <data key="d10">6a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes Lambda Render</data>
      <data key="d10">6b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Validation/render results written to DynamoDB</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB updates trigger SNS alerts/notifications</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">AC3 Serverless Geospatial Data Processing Architecture</data>
    <data key="d1" />
    <data key="d2">Serverless pipeline converting GeoTIFF to LandXML with automated validation and notification.</data>
    <data key="d3">Serverless Data Pipeline</data>
    <data key="d4">True</data>
  </graph>
</graphml>
