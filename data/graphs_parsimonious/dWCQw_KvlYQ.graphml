  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CLIENTS</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">User devices connecting to view video streams and key moments overlays</data>
    </node>
    <node id="1">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for client connections</data>
