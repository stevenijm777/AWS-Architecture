    <node id="6">
      <data key="d5">FARGATE</data>
      <data key="d6">Fargate</data>
      <data key="d7">Extracts keyframes from various video stream formats</data>
    </node>
    <node id="7">
      <data key="d5">REKOGNITION</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Performs text recognition on keyframes to extract time information</data>
    </node>
    <node id="8">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Stream offset / key moment processing service</data>
    </node>
    <node id="9">
      <data key="d5">KINESIS ANALYTICS</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Ingests and filters pitch data feeds</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Clients send API requests</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes requests to regional ECS containers</data>
