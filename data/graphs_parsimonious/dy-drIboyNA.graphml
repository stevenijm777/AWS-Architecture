<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Write API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles incoming write API requests</data>
    </node>
    <node id="1">
      <data key="d5">Write Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Microservices written in Node.js executing write logic</data>
    </node>
    <node id="2">
      <data key="d5">Ingestion Kinesis Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Buffers incoming write event payloads</data>
    </node>
    <node id="3">
      <data key="d5">Input S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores legacy data files and drops like Medicare files</data>
    </node>
    <node id="4">
      <data key="d5">EMR (Spark)</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs Apache Spark state machine applications to validate and process data</data>
    </node>
    <node id="5">
      <data key="d5">Data Lake S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term data lake holding full longitudinal data in Parquet format</data>
    </node>
    <node id="6">
      <data key="d5">Output Kinesis Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Buffers processed output streams for read-side persistence</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores domain-driven published representations for read queries</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Indexes data from DynamoDB Streams for semantic and condition search</data>
    </node>
    <node id="9">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries the S3 data lake and DynamoDB for reporting and analytics</data>
    </node>
    <node id="10">
      <data key="d5">Read API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes read APIs for search and external consumption</data>
    </node>
    <node id="11">
      <data key="d5">Read Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes read microservices</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Write API requests trigger write Lambdas</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Write Lambdas publish change events into Kinesis</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR ingests buffered streaming events from Kinesis</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Batch file drops from S3 are ingested into EMR</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR publishes processed output events across to output Kinesis stream</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Output Kinesis stream buffers writes into DynamoDB</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB Streams replicate data into Elasticsearch</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Athena queries longitudinal Parquet data stored in the S3 data lake</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Athena queries DynamoDB for quick structured reporting</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">4</data>
      <data key="d9">Read API requests trigger read Lambdas</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Read Lambdas fetch structured records from DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Health Direct Australia - Read and Write Segregated Telehealth Data Architecture</data>
    <data key="d1" />
    <data key="d2">Divided into write-intensive (left) and read-intensive (right) pipelines separated by a central dashed line.</data>
    <data key="d3">Data Analytics &amp; Serverless Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
