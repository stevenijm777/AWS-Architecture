<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Mobile app and web client traffic.</data>
    </node>
    <node id="1">
      <data key="d5">Ingress ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Initial entry load balancer.</data>
    </node>
    <node id="2">
      <data key="d5">HAProxy Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Self-managed proxy routing traffic based on DNS.</data>
    </node>
    <node id="3">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">DNS service storing CNAME routing targets.</data>
    </node>
    <node id="4">
      <data key="d5">Blue Cluster ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Load balancer for current production cluster.</data>
    </node>
    <node id="5">
      <data key="d5">Green Cluster ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Load balancer for new release/canary cluster.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Incoming traffic to ingress ALB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Traffic forwarded to HAProxy.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">HAProxy queries Route 53 for target CNAME.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Traffic routed to active Blue cluster.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Canary traffic routed to Green cluster.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">WAG Labs Canary Deployment Architecture</data>
    <data key="d1" />
    <data key="d2">Canary deployment setup using HAProxy and Route 53 to route traffic between Blue and Green clusters.</data>
    <data key="d3">DevOps / Traffic Management</data>
    <data key="d4">True</data>
  </graph>
</graphml>
