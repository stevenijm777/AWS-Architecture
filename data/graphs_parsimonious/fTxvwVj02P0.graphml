  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CUSTOMERS</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End users accessing Simpego services via web/mobile interfaces.</data>
    </node>
    <node id="1">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS cluster running backend management software.</data>
    </node>
    <node id="2">
      <data key="d5">KINESIS FIREHOSE</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams clickstream data directly into S3 raw storage.</data>
    </node>
    <node id="3">
      <data key="d5">S3 (RAW)</data>
      <data key="d6">S3</data>
      <data key="d7">Raw S3 bucket storing clickstream JSON data.</data>
    </node>
    <node id="4">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">Serverless ETL processing data incrementally.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing transformed, clean data ready for querying.</data>
    </node>
    <node id="6">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query service accessing prepared S3 data.</data>
    </node>
    <node id="7">
      <data key="d5">PROCESS AUTOMATION</data>
      <data key="d6">EC2</data>
      <data key="d7">Core engine automating insurance workflows based on Athena analytics.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Customer web requests flow to backend on EKS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS pushes clickstream events to Kinesis Firehose.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose writes raw JSON data to RAW S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue reads raw JSON data from S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Glue writes processed data into second S3 bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Athena queries processed dataset in S3 via Glue Crawler metadata.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Process Automation engine queries Athena for business insights and automation triggers.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Simpego Serverless Data Streaming and Process Automation Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture showing clickstream collection via EKS and Kinesis Firehose, incremental ETL using AWS Glue, S3 storage, query access via Athena, and process automation.</data>
    <data key="d3">Data Lake / Serverless Analytics</data>
    <data key="d4">True</data>
