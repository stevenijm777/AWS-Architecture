<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Source / ETL</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises policy, claims, and reinsurance systems feed data via ETL</data>
    </node>
    <node id="1">
      <data key="d5">S3 (Primary Region)</data>
      <data key="d6">S3</data>
      <data key="d7">Staging bucket for ingested financial event data</data>
    </node>
    <node id="2">
      <data key="d5">S3 (DR Region)</data>
      <data key="d6">S3</data>
      <data key="d7">Secondary S3 bucket for cross-region replication of backups/snapshots</data>
    </node>
    <node id="3">
      <data key="d5">Primary App Servers</data>
      <data key="d6">EC2</data>
      <data key="d7">Primary SAP application servers</data>
    </node>
    <node id="4">
      <data key="d5">Primary HANA DB</data>
      <data key="d6">EC2</data>
      <data key="d7">Primary S/4 HANA database running on EC2 X1 family instances</data>
    </node>
    <node id="5">
      <data key="d5">Secondary App Servers</data>
      <data key="d6">EC2</data>
      <data key="d7">Secondary/HA SAP application servers</data>
    </node>
    <node id="6">
      <data key="d5">Secondary HANA DB</data>
      <data key="d6">EC2</data>
      <data key="d7">Secondary S/4 HANA database receiving synchronous/asynchronous DB replication</data>
    </node>
    <node id="7">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Automates buildout of primary and secondary SAP topology</data>
    </node>
    <node id="8">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors SAP infrastructure metrics and alerts</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Ingests data/events into primary S3 bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Loads staging data from S3 into primary S4 HANA database</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Cross-region replication of backups and snapshots to DR S3 bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">HANA database replication between primary and secondary DB nodes</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Liberty Mutual Insurance - Real-Time Closing with SAP on AWS</data>
    <data key="d1" />
    <data key="d2">Architecture illustrating SAP HANA and App Server deployment on AWS EC2, with S3 staging and cross-region DR replication.</data>
    <data key="d3">Migration &amp; Modernization, SAP on AWS</data>
    <data key="d4">True</data>
  </graph>
