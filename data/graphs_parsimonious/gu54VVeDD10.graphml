      <data key="d7">Triggers ML processing jobs via Jupyter notebooks</data>
    </node>
    <node id="1">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Runs Studio and processing jobs in a private VPC</data>
