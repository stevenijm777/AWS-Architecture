<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Sources</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">AS400, flat files, legacy and modern databases</data>
    </node>
    <node id="1">
      <data key="d5">DX</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Dedicated network connection</data>
    </node>
    <node id="2">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">Pulls data into AWS landscape</data>
    </node>
    <node id="3">
      <data key="d5">DDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Staging data lake layers (RAW, L1, L2)</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Event-driven processing between layers via streams</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Raw layer storage for serverless recovery</data>
    </node>
    <node id="6">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Query engine for serverless recovery mechanism</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Data ingested from on-premises sources</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">DirectConnect pipe to DMS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">DMS feeds data into DynamoDB</data>
      <data key="d10">3a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">DMS replicates raw data to S3</data>
      <data key="d10">3b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB streams trigger Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Trigger recovery flow</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda pushes processed data back to L1/L2 layers</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Push rebuilt data back to DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Rebuild layer within S3 using Athena</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">HDFC Life Real-Time Event-Driven Data Lake</data>
    <data key="d1" />
    <data key="d2">Architecture uses DynamoDB and Lambda for real-time processing with S3 and Athena for error recovery.</data>
    <data key="d3">Data Lake &amp; Real-Time Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
