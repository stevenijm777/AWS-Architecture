  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">JSON Deployment Descriptor</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">User-submitted deployment configuration descriptor</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives JSON deployment descriptors from users/tools</data>
    </node>
    <node id="2">
      <data key="d5">Pipeline Factory Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Parses descriptor and constructs CodePipeline on the fly</data>
    </node>
    <node id="3">
      <data key="d5">Master CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Main dynamically constructed orchestration pipeline</data>
    </node>
    <node id="4">
      <data key="d5">ServiceNow</data>
      <data key="d6">ServiceNow</data>
      <data key="d7">Change request approval integration</data>
    </node>
    <node id="5">
      <data key="d5">Approval &amp; Notification Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Checks ServiceNow change requests and triggers notifications</data>
    </node>
    <node id="6">
      <data key="d5">Email Notification</data>
      <data key="d6">SES</data>
      <data key="d7">Drawn envelope icon representing deployment email notifications</data>
    </node>
    <node id="7">
      <data key="d5">Sub CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Custom sub-pipelines invoked within task steps</data>
    </node>
    <node id="8">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Infrastructure as Code stack deployment</data>
    </node>
    <node id="9">
      <data key="d5">CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Compiles code and builds deployment artifacts</data>
    </node>
    <node id="10">
      <data key="d5">CodeDeploy</data>
      <data key="d6">CodeDeploy</data>
      <data key="d7">Deploys applications to AWS resources or on-premise targets</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">JSON descriptor submitted via API Gateway endpoint</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway invokes Pipeline Factory Lambda</data>
