<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amplify (RCC Hours)</data>
      <data key="d6">Amplify</data>
      <data key="d7">Deploys React app for Restaurant Control Center (RCC) where restaurant hours are maintained.</data>
    </node>
    <node id="1">
      <data key="d5">Step Functions (Diablo)</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates Diablo batch data pipelines loading product, pricing, and tax data into Aurora.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Core MySQL database holding store hours, products, and 100M+ pricing combinations.</data>
    </node>
    <node id="3">
      <data key="d5">Menu Exporter Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes menus out of Aurora and generates complex JSON menus.</data>
    </node>
    <node id="4">
      <data key="d5">Delivery Aggregator</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External delivery channels receiving raw menu JSON data.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives incoming webhooks from delivery aggregators.</data>
    </node>
    <node id="6">
      <data key="d5">Webhook Processor Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes webhooks and updates audit log status in Aurora.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Loads store hours into Aurora database.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Loads product, pricing, and tax details into Aurora.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Reads menu and store data from Aurora.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Sends generated JSON menus to delivery aggregators.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">4</data>
      <data key="d9">Delivery aggregators trigger webhooks reporting menu status.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">4</data>
      <data key="d9">API Gateway routes webhook payload to Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">4</data>
      <data key="d9">Lambda updates audit records in Aurora database.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Taco Bell - Menu Middleware and Data Integration Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=hf9nMAG9XoU</data>
    <data key="d2">System processes restaurant hours, products, pricing, and tax info into Amazon Aurora to dynamically generate 40k menus sent to third-party delivery aggregators with webhook feedbacks.</data>
    <data key="d3">Serverless Data Integration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
