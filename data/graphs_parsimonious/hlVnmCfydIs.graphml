  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Shopify</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">E-commerce platform sending order events.</data>
    </node>
    <node id="1">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Ingests incoming order events.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams order data to S3.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw order data.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes order metadata and executes queries.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores customer order metadata.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Handles contact center call routing.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Pinpoint</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">Checks caller country for localization.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Lex</data>
      <data key="d6">Lex</data>
      <data key="d7">Conversational AI bot to capture caller intent.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends order placement event.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Forwards event stream.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Delivers order data to bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers Lambda function on object creation.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Writes customer order metadata.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="1">
      <data key="d8">1</data>
      <data key="d9">Queries customer profile by phone number.</data>
      <data key="d10">2</data>
