<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user_developer">
      <data key="d5">Pinterest Users / Engineers</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal users running analytical queries or workflows on big data clusters.</data>
    </node>
    <node id="ec2_clusters">
      <data key="d5">Big Data Clusters (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Hadoop, Spark, and Presto clusters running on EC2.</data>
    </node>
    <node id="token_vending">
      <data key="d5">Token Vending Service</data>
      <data key="d6">EC2</data>
      <data key="d7">An internal custom service that maps Pinterest LDAP groups to AWS IAM policies.</data>
    </node>
    <node id="ldap_service">
      <data key="d5">LDAP Directory</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Pinterest's internal LDAP directory storing user group details.</data>
    </node>
    <node id="sts_service">
      <data key="d5">AWS STS</data>
      <data key="d6">STS</data>
      <data key="d7">AWS Security Token Service that creates temporary security credentials.</data>
    </node>
    <node id="iam_mp1">
      <data key="d5">Managed Policy 1 (MP1)</data>
      <data key="d6">IAM</data>
      <data key="d7">An IAM Managed Policy defining access rules for the first dataset.</data>
    </node>
    <node id="iam_mp2">
      <data key="d5">Managed Policy 2 (MP2)</data>
      <data key="d6">IAM</data>
      <data key="d7">An IAM Managed Policy defining access rules for the second dataset.</data>
    </node>
    <node id="s3_bucket_1">
      <data key="d5">S3 Bucket 1</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket containing dataset 1.</data>
    </node>
    <node id="s3_bucket_2">
      <data key="d5">S3 Bucket 2</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket containing dataset 2.</data>
    </node>
    <edge source="user_developer" target="ec2_clusters" id="0">
      <data key="d8">1</data>
      <data key="d9">User initiates jobs on EC2 using Kerberos authentication.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="ec2_clusters" target="token_vending" id="0">
      <data key="d8">1</data>
      <data key="d9">The EC2 cluster credentials provider requests temporary credentials from the Token Vending Service.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="ec2_clusters" target="iam_mp1" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 cluster uses the scoped token to gain access permitted by Managed Policy 1.</data>
      <data key="d10">6a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="ec2_clusters" target="iam_mp2" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 cluster uses the scoped token to gain access permitted by Managed Policy 2.</data>
      <data key="d10">6b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="token_vending" target="ldap_service" id="0">
      <data key="d8">1</data>
      <data key="d9">Token Vending Service queries LDAP to find the user's groups.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="token_vending" target="sts_service" id="0">
      <data key="d8">1</data>
      <data key="d9">Token Vending Service calls AssumeRole on AWS STS with the base role.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="token_vending" target="iam_mp1" id="0">
      <data key="d8">1</data>
      <data key="d9">Matches user groups and requests an STS token intersected with Managed Policy 1.</data>
      <data key="d10">5a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="token_vending" target="iam_mp2" id="0">
      <data key="d8">1</data>
      <data key="d9">Matches user groups and requests an STS token intersected with Managed Policy 2.</data>
      <data key="d10">5b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="iam_mp1" target="s3_bucket_1" id="0">
      <data key="d8">1</data>
      <data key="d9">Policy grants access to read or write data in S3 Bucket 1.</data>
      <data key="d10">7a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="iam_mp2" target="s3_bucket_2" id="0">
      <data key="d8">1</data>
      <data key="d9">Policy grants access to read or write data in S3 Bucket 2.</data>
      <data key="d10">7b</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Pinterest: Dynamic S3 Data Access Control using AWS STS</data>
    <data key="d1">https://www.youtube.com/watch?v=0bTf9_bX6Lg</data>
    <data key="d2">Whiteboard diagram illustrating Pinterest's architecture for secure, dynamic, and scalable data access to S3 buckets using AWS STS and session policies mapped via LDAP.</data>
    <data key="d3">Security &amp; Compliance, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
