  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="1">
      <data key="d5">Customer CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">The customer's active CI/CD pipeline integrated with Snyk</data>
    </node>
    <node id="2">
      <data key="d5">S3 Objects</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing code artifacts used during pipeline run</data>
    </node>
    <node id="3">
      <data key="d5">AWS CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">AWS CodePipeline service management plane</data>
    </node>
    <node id="4">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Snyk API Gateway endpoint for initial setup and authentication</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores customer configuration metadata and pipeline mappings</data>
    </node>
    <node id="6">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Coordinates the scanning workflows and processes artifacts</data>
    </node>
    <node id="7">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Tracks pipeline state and triggers the Step Functions scan</data>
    </node>
    <node id="8">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Receives subsequent execution trigger events from AWS CodePipeline</data>
    </node>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer registers and enables Snyk integration in CodePipeline</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">3</data>
      <data key="d9">CodePipeline copies workspace artifacts into the customer S3 bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">3</data>
      <data key="d9">Source files and packages are pulled or prepared for scanning operations</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS CodePipeline updates status back to Customer's console</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS CodePipeline redirects user to Snyk's API Gateway for OAuth/Configuration</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Subsequent pipeline runs trigger the Snyk Lambda function</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway writes configuration and mapping metadata to DynamoDB</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Confirms record storage to Snyk UI flow</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Updates state machine status during scan processing</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Step Functions request artifact locations and feed scan results back to CodePipeline</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">EventBridge triggers Step Functions workflow execution</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda registers event state changes in EventBridge</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Snyk Developer-First AWS CodePipeline Integration</data>
    <data key="d1">https://www.youtube.com/watch?v=FOfbE_D_Y2E</data>
    <data key="d2"> whiteboards a secure integration that allows developers to run security scans on their application code directly within AWS CodePipeline using Snyk's API and Serverless infrastructure.</data>
    <data key="d3">Developer Tools, Security</data>
    <data key="d4">True</data>
  </graph>
