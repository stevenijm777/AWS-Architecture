  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer / User</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Interacts with SmartStack via the UI, API, or CI/CD pipelines.</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Exposes REST APIs for the control plane.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Stateless microservices that coordinate deployment logic and trigger CodeBuild.</data>
    </node>
    <node id="3">
      <data key="d5">CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Executes Terraform scripts to provision the USC environment.</data>
    </node>
    <node id="4">
      <data key="d5">S3 (SmartStack)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket used to poll for custom code updates and deployment artifacts.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores state and persistence configuration data.</data>
    </node>
    <node id="6">
      <data key="d5">S3 (USC)</data>
      <data key="d6">S3</data>
      <data key="d7">Deployed S3 resource for USC storage.</data>
    </node>
    <node id="7">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational database within the deployed USC commerce environment.</data>
    </node>
    <node id="8">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores container images for deployment onto ECS.</data>
    </node>
    <node id="9">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Container service hosting the USC applications.</data>
    </node>
    <node id="10">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balances incoming customer traffic to USC containers.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Developer sends control plane and UI requests to the ALB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Developer pushes custom code or updates into the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda microservices write configuration state to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">4</data>
      <data key="d9">Lambda triggers CodeBuild execution with dynamic Terraform templates.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">5</data>
      <data key="d9">Provisioning state/context transfers across the SmartStack to USC boundary.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ultraserve SmartStack and USC Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Fms0RlypYV4</data>
    <data key="d2">SmartStack orchestrates the creation and deployment of the USC digital commerce platform on AWS using Lambda, DynamoDB, CodeBuild, and Terraform.</data>
    <data key="d3">Deployment &amp; Orchestration</data>
    <data key="d4">True</data>
  </graph>
