<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart Meters / Devices</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Physical smart meters on the power grid running Greengrass</data>
    </node>
    <node id="1">
      <data key="d5">Acquisition EC2 Tier</data>
      <data key="d6">EC2</data>
      <data key="d7">Custom acquisition service connecting to devices</data>
    </node>
    <node id="2">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Receives pushed telemetry events directly from edge devices</data>
    </node>
    <node id="3">
      <data key="d5">Processing SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers incoming data between acquisition and processing tiers</data>
    </node>
    <node id="4">
      <data key="d5">Elastic Beanstalk</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Provisions EC2 instances running SQS worker microservices</data>
    </node>
    <node id="5">
      <data key="d5">Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless replacement for Beanstalk via SQS event source mapping</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB Data Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores inventory and processed device telemetry</data>
    </node>
    <node id="7">
      <data key="d5">Kinesis Data Streams &amp; Firehose</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Streams processed metrics and device payloads</data>
    </node>
    <node id="8">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Stores long-term telemetry metrics and raw payloads</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Redshift Spectrum</data>
      <data key="d6">RedShift</data>
      <data key="d7">Executes analytical queries directly on S3 data lake</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 connects to device to pull meter readings</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Device pushes telemetry via Greengrass to AWS IoT Core</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 forwards collected readings into SQS</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">IoT Core forwards data to SQS queue</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Beanstalk instances fetch messages from SQS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda polls SQS messages</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Beanstalk microservice persists state/inventory to DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservice pushes logs, metrics, and raw payloads to Kinesis</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda writes processing results to DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose loads streamed data into S3 bucket</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift Spectrum queries data stored in S3</data>
      <data key="d10">6</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Enel Smart Meter Telemetry Processing Architecture</data>
    <data key="d1" />
    <data key="d2">Shows legacy pull-based EC2 architecture alongside modern serverless push-based IoT Core and Lambda architecture.</data>
    <data key="d3">IoT, Analytics, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
