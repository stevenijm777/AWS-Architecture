<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="video_source">
      <data key="d0">ThirdParty</data>
      <data key="d1">Live Feed Source</data>
      <data key="d2">third_party</data>
    </node>
    <node id="cloudport_live">
      <data key="d0">ThirdParty</data>
      <data key="d1">Cloudport Live</data>
      <data key="d2">third_party</data>
    </node>
    <node id="automation">
      <data key="d0">EC2</data>
      <data key="d1">Automation</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="asset_processing">
      <data key="d0">EC2</data>
      <data key="d1">Asset Processing</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="playout">
      <data key="d0">EC2</data>
      <data key="d1">Playout</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="hitless_switcher">
      <data key="d0">EC2</data>
      <data key="d1">Hitless Switcher</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="hitless_secondary">
      <data key="d0">EC2</data>
      <data key="d1">Hitless Secondary AZ</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="direct_connect">
      <data key="d0">Direct Connect</data>
      <data key="d1">Direct Connect</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="satellite">
      <data key="d0">OnPremDC</data>
      <data key="d1">Satellite Transmission</data>
      <data key="d2">on_prem</data>
    </node>
    <edge source="video_source" target="cloudport_live" id="0">
      <data key="d3">live feed</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudport_live" target="playout" id="0">
      <data key="d3">stream</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="automation" target="playout" id="0">
      <data key="d3">commands</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="s3" target="asset_processing" id="0">
      <data key="d3">media assets</data>
      <data key="d4">reads_from</data>
    </edge>
    <edge source="asset_processing" target="playout" id="0">
      <data key="d3">processed assets</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="playout" target="hitless_switcher" id="0">
      <data key="d3">primary feed</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="playout" target="hitless_secondary" id="0">
      <data key="d3">redundant feed</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="hitless_switcher" target="direct_connect" id="0">
      <data key="d3">switched stream</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="hitless_secondary" target="direct_connect" id="0">
      <data key="d3">failover stream</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="direct_connect" target="satellite" id="0">
      <data key="d3">broadcast feed</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
