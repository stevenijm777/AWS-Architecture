<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Players</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Millions of global players connecting to APIs and game servers.</data>
    </node>
    <node id="1">
      <data key="d5">EKS API</data>
      <data key="d6">EKS</data>
      <data key="d7">Handles incoming client API requests and game telemetry.</data>
    </node>
    <node id="2">
      <data key="d5">Local Game Servers</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Game data centers buffering data locally in Kafka.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon MSK</data>
      <data key="d6">MSK</data>
      <data key="d7">Regional buffering layer managing ingestion peaks.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Delta Lake data store written to via Spark streaming.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Acts as the logical metastore and access control layer.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Players interact with game APIs hosted in EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Players connect directly to on-prem game servers.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Telemetry data is routed from EKS to regional MSK.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">MirrorMaker replicates local data to regional MSK clusters.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Spark jobs streaming data from MSK to S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Riot Games - HONO over IP Data Ingest System</data>
    <data key="d1">https://www.youtube.com/watch?v=Fj-P38-0S4Y</data>
    <data key="d2">Whiteboard details ingest architecture for League of Legends, processing 8TB/day at peaks of over 500k events/sec using MSK and S3.</data>
    <data key="d3">Game Tech, Analytics &amp; Data Lakes</data>
    <data key="d4">True</data>
  </graph>
</graphml>
