    <node id="0">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives events from upstream pipelines to orchestrate stages.</data>
    </node>
    <node id="1">
      <data key="d5">Job Initiator Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by SQS to retrieve configuration and initiate orchestration.</data>
