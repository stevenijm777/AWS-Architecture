<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Orchestrates incoming event triggers from upstream data pipelines</data>
    </node>
    <node id="1">
      <data key="d5">Job Initiator Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by SQS; reads pipeline config from DynamoDB and initiates Step Functions</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores pipeline configurations as JSON and tracks job exit status</data>
    </node>
    <node id="3">
      <data key="d5">Step Function</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Coordinates detailed ETL execution steps and scales Neptune cluster</data>
    </node>
    <node id="4">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Stores property graph model of customer interactions, vertices, and edges</data>
    </node>
    <node id="5">
      <data key="d5">Gremlin</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Executes graph queries to traverse model and export data to S3</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores exported query results and data for serverless querying</data>
    </node>
    <node id="7">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Catalogs exported data in S3 for access via Athena</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">SQS triggers Job Initiator Lambda</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda reads pipeline definition and exit status from DynamoDB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda kicks off execution of Step Functions</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB configuration feeds into Step Functions coordination</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">4</data>
      <data key="d9">Step Functions scales up and loads vertices and edges to Neptune</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">5</data>
      <data key="d9">Gremlin queries traverse the graph stored in Neptune</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">6</data>
      <data key="d9">Gremlin exports query results to S3</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">7</data>
      <data key="d9">Glue catalogs data stored in S3</data>
      <data key="d10">7</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Homesite Insurance - Serverless Graph Database ETL Pipeline</data>
    <data key="d1" />
    <data key="d2">Architecture uses SQS, Lambda, DynamoDB, Step Functions, Neptune, Gremlin, S3, and Glue to process customer web data into a graph database and export results to S3.</data>
    <data key="d3">Data Lake / Analytics / Graph Database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
