    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Developer pushes image to ECR</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ECR pushes/deploys container image to EKS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS routes traffic through Transit Gateway</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Transit Gateway accesses S3 in dev account</data>
