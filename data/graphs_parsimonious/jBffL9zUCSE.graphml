      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon Simple Storage Service in vended dev account</data>
    </node>
    <node id="4">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon Elastic Kubernetes Service in centralized runtime account</data>
    </node>
    <node id="5">
      <data key="d5">TRANSIT GATEWAY</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">AWS Transit Gateway in networking account</data>
    </node>
    <node id="6">
      <data key="d5">CONTROL TOWER</data>
      <data key="d6">ControlTower</data>
      <data key="d7">AWS Control Tower managing dev accounts</data>
