<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Account Ingestion Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Receives events indicating account updates.</data>
    </node>
    <node id="1">
      <data key="d5">Ingestion Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Fetches raw transactions from RDS and batches them into SQS.</data>
    </node>
    <node id="2">
      <data key="d5">Raw Transaction Store</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores scraped bank transactions queried by the ingestion Lambda.</data>
    </node>
    <node id="3">
      <data key="d5">Transaction Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers transaction description batches to allow fanning out processing.</data>
    </node>
    <node id="4">
      <data key="d5">NLP Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Runs natural language processing model to enrich transaction description strings.</data>
    </node>
    <node id="5">
      <data key="d5">Enriched Transaction Store</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores processed and categorized transactions along with model versions.</data>
    </node>
    <node id="6">
      <data key="d5">Enriched Event Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Publishes completed transaction events to downstream applications.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers Lambda upon account update event</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Queries RDS for user transactions</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Publishes batched transaction strings to SQS queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Returns transaction records to Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Fans out messages to NLP Lambda instances</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Writes enriched transaction data to RDS</data>
      <data key="d10">5a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Emits enriched transaction completion events to Kinesis</data>
      <data key="d10">5b</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Tandem Money Transaction Processing Architecture</data>
    <data key="d1" />
    <data key="d2">Data pipeline for transaction ingestion, SQL database lookups, SQS fan-out processing with NLP Lambda, and enriched data persistence.</data>
    <data key="d3">Serverless, Data Pipeline, Machine Learning / NLP</data>
    <data key="d4">True</data>
  </graph>
</graphml>
