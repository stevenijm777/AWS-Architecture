<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Data Center</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Stores sales invoice data.</data>
    </node>
    <node id="1">
      <data key="d5">AWS VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">Secure connection from on-premise.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Database Migration Service</data>
      <data key="d6">DMS</data>
      <data key="d7">Performs change data capture (CDC) to migrate sales records.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse storing aggregated demand and sales records.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Drop Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Receives incoming order flat files from ERP.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Decouples and queues message notifications.</data>
    </node>
    <node id="6">
      <data key="d5">Initiator Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Queries file metadata and moves raw files to the data lake.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores metadata about the incoming files.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Central storage repository containing raw and refined zones.</data>
    </node>
    <node id="9">
      <data key="d5">Processing/Merge Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Merges sales/inventory data and runs demand forecasting logic.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Pipes transactional data over VPN.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Reaches AWS DMS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Loads CDC data into Redshift.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Shares structured sales records with the Data Lake.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Publishes event notification to SQS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Triggers initiator Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Requests metadata.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Writes structured files into Data Lake zones.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Returns metadata response.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 event triggers processing Lambda.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Writes refined output files back to Data Lake.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Loads completed demand results into Redshift.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Veritiv Serverless Data Lake and Sales Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=8Yf7-U0A0-w</data>
    <data key="d2">This serverless analytics pipeline automates the ingestion of demand and sales invoice data into Amazon Redshift and an Amazon S3-based data lake.</data>
    <data key="d3">Data Lake &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
