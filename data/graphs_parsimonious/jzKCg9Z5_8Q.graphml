<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="control_tower">
      <data key="d5">AWS Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Orchestrates the landing zone, account creation, and baselines.</data>
    </node>
    <node id="organizations">
      <data key="d5">AWS Organizations</data>
      <data key="d6">Organizations</data>
      <data key="d7">Organizes accounts into OUs based on the development lifecycle.</data>
    </node>
    <node id="service_catalog">
      <data key="d5">AWS Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Automates account provisioning and setup.</data>
    </node>
    <node id="sso">
      <data key="d5">AWS Single Sign-On</data>
      <data key="d6">IAM</data>
      <data key="d7">Provides centralized identity management and federation.</data>
    </node>
    <node id="config">
      <data key="d5">AWS Config</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">Monitors configuration drift and compliance across AWS accounts.</data>
    </node>
    <node id="cloudtrail">
      <data key="d5">AWS CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Aggregates audit logs into a centralized account.</data>
    </node>
    <node id="iam">
      <data key="d5">AWS IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Manages role-based access tied to single identity.</data>
    </node>
    <edge source="control_tower" target="organizations" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Control Tower sets up accounts under OUs in AWS Organizations.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="control_tower" target="service_catalog" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Control Tower leverages AWS Service Catalog to automate account creation.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Blackboard's Multi-Account Governance with AWS Control Tower</data>
    <data key="d1">https://www.youtube.com/watch?v=F_Yshx8B75Y</data>
    <data key="d2">Multi-account setup utilizing AWS Control Tower, AWS Organizations, and AWS Service Catalog to automate and enforce baseline security configurations like AWS SSO, AWS Config, AWS CloudTrail, and IAM across 120+ accounts.</data>
    <data key="d3">Management and Governance, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
