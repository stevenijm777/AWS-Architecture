<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Consumers</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-users performing Speedtests</data>
    </node>
    <node id="1">
      <data key="d5">API Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Receives speedtest reports and exposes intelligence product</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Provides 24-hour data retention and asynchronous queueing</data>
    </node>
    <node id="3">
      <data key="d5">RDS Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Holds dimension fact tables and stores aggregated speedtest insights</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Gathers, compresses, and writes reports to S3</data>
    </node>
    <node id="5">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Stores over 5 PB of uncompressed newline-separated JSON data</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Normalizes JSON into CSV for Redshift</data>
    </node>
    <node id="7">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Performs long-term aggregation and data warehousing</data>
    </node>
    <node id="8">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries historical JSON data in S3 directly</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Reports sent to API</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">API drops reports to Kinesis</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Data enriched using facts from RDS</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Enriched data written to Firehose</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Insights served to consumers</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes JSON to S3</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Triggers on new S3 objects</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Loads normalized CSV to Redshift</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Aggregates written back to RDS</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Athena queries data lake directly</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ookla Speedtest Data Pipeline Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=FqSPh9YfL-4</data>
    <data key="d2">Ookla uses a Kinesis and Lambda-driven serverless pipeline to ingest, enrich, and analyze 4,000 speedtest reports per second, processing over 5 PB of data.</data>
    <data key="d3">Data Analytics, Serverless, Real-Time Ingestion</data>
    <data key="d4">True</data>
  </graph>
</graphml>
