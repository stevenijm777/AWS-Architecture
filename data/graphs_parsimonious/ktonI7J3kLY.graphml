<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Triggers monitoring Lambda every 1 minute</data>
    </node>
    <node id="1">
      <data key="d5">Monitoring</data>
      <data key="d6">Lambda</data>
      <data key="d7">Monitors EC2 health and capacity</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores user interactions and state changes</data>
    </node>
    <node id="3">
      <data key="d5">Allocation / De-allocation</data>
      <data key="d6">Lambda</data>
      <data key="d7">Orchestrates creation and allocation/de-allocation of EC2 instances</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (Scale Up)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance running custom video logic (scaled up)</data>
    </node>
    <node id="5">
      <data key="d5">EC2 (Scale Down)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance running custom video logic (scaled down)</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">1-minute CloudWatch trigger to Monitoring Lambda</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Monitoring Lambda invokes Allocation/De-allocation Lambda if adjustment needed</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB streams trigger Allocation/De-allocation Lambda on object updates</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Allocation Lambda scales or updates top EC2 instances</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Allocation/De-allocation Lambda scales or updates bottom EC2 instances</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Grabio Serverless Orchestration and Video Application Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=ktonI7J3kLY</data>
    <data key="d2">Whiteboard diagram showing Grabio's cloud-native serverless orchestration and auto-scaling pool for EC2 video application servers using Lambda, DynamoDB, and CloudWatch.</data>
    <data key="d3">Media &amp; Serverless Orchestration</data>
    <data key="d4">True</data>
