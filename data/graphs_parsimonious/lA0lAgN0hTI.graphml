<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User / Device</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End user consuming encrypted media on various devices</data>
    </node>
    <node id="1">
      <data key="d5">Operator Portal</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Content operator portal hosting encrypted video content</data>
    </node>
    <node id="2">
      <data key="d5">Irdeto Control Endpoint</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Multi-DRM solution entrypoint</data>
    </node>
    <node id="3">
      <data key="d5">EC2 (Kubernetes Cluster)</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs Kubernetes pods for DRM modules, rules engine, and core logic</data>
    </node>
    <node id="4">
      <data key="d5">RDS (Control DB)</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores stateful info, policies, bundles, and entitlements</data>
    </node>
    <node id="5">
      <data key="d5">RDS (Data Warehouse)</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores event logs for reporting and data analytics</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User selects and downloads video content</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">User device requests DRM license</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Operator delivers encrypted video to user</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Request routed to DRM adaptation pod on EC2 cluster</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">DRM license delivered to user device</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Rules engine checks user entitlements and state</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Encrypted DRM license key returned</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Events recorded to data warehouse RDS</data>
      <data key="d10">1</data>
