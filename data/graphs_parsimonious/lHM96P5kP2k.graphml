  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Ingests high-volume ad events</data>
    </node>
    <node id="1">
      <data key="d5">Spark Streaming</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Reads real-time data stream</data>
    </node>
    <node id="2">
      <data key="d5">Raw S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores parquet raw events</data>
    </node>
    <node id="3">
      <data key="d5">Spark on EKS / Spotinst</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs auto-scaled Spark jobs</data>
    </node>
    <node id="4">
      <data key="d5">Airflow</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Orchestrates EKS and EMR batch jobs</data>
    </node>
    <node id="5">
      <data key="d5">Aggregated S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores aggregated data</data>
    </node>
    <node id="6">
      <data key="d5">Cassandra</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores fast aggregated metric time series</data>
    </node>
    <node id="7">
      <data key="d5">Presto</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Queries user snapshot data directly from S3</data>
    </node>
    <node id="8">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Reads aggregated data and populates Druid</data>
    </node>
    <node id="9">
      <data key="d5">Druid</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Multi-dimensional OLAP data store</data>
    </node>
    <node id="10">
      <data key="d5">Dashboard UI</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Visual dashboard for customers</data>
    </node>
    <edge source="0" target="1" id="0">
