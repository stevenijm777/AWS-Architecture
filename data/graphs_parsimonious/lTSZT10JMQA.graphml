  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Video Input</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Source video feed</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw videos and processed frame outputs</data>
    </node>
    <node id="2">
      <data key="d5">STEP FUNCTION</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates execution steps</data>
    </node>
    <node id="3">
      <data key="d5">Frame Extraction Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Converts video to PNG frames</data>
    </node>
    <node id="4">
      <data key="d5">Batch Dispatcher Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lists frames and dispatches parallel processing batches</data>
    </node>
    <node id="5">
      <data key="d5">Parallel Inference Lambdas</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes TensorFlow model on frame batches in parallel</data>
    </node>
    <node id="6">
      <data key="d5">Decision Engine Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Determines video editing cuts based on feature detection</data>
    </node>
    <node id="7">
      <data key="d5">ECS Cluster</data>
      <data key="d6">ECS</data>
      <data key="d7">Manages video processing tasks</data>
    </node>
    <node id="8">
      <data key="d5">EC2 Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs FFmpeg for video transcoding and editing</data>
    </node>
    <node id="9">
      <data key="d5">STREAMING PLATFORM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Destination platform for processed videos</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Video uploaded to S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 upload triggers Step Functions workflow</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Step 1: Frame extraction</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Step 2: Frame list analysis</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Step 3: Decision engine evaluation</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Step 4: Triggers ECS task</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Dispatches parallel inference tasks</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Runs on EC2 instances</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Publishes processed video to streaming platform</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">CLAP Video Automated Editing Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=lTSZT10JMQA</data>
    <data key="d2">Automated video processing pipeline using S3, Step Functions, Lambda, ECS, and EC2.</data>
    <data key="d3">Media &amp; Entertainment</data>
