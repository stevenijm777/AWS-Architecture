<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User / Backend System</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Initiates transcoding requests via SDK/API</data>
    </node>
    <node id="1">
      <data key="d5">Scheduler</data>
      <data key="d6">EC2</data>
      <data key="d7">Receives job configurations and coordinates execution</data>
    </node>
    <node id="2">
      <data key="d5">Input S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores original video source files</data>
    </node>
    <node id="3">
      <data key="d5">Master Node</data>
      <data key="d6">EC2</data>
      <data key="d7">Splits video into chunks, dispatches jobs, and stitches output</data>
    </node>
    <node id="4">
      <data key="d5">Workers (Spot Instances)</data>
      <data key="d6">EC2</data>
      <data key="d7">Kubernetes worker nodes running transcoding jobs on spot instances</data>
    </node>
    <node id="5">
      <data key="d5">Output S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores completed transcoded video files</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User sends API request to Scheduler</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Scheduler passes job configuration to Master</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Master fetches input video file from Input S3 bucket</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Master dispatches video segment jobs to worker nodes</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Master stitches segments together and writes final file to Output S3 bucket</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Workers return transcoded video chunks back to Master</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Bitmovin Distributed Video Transcoding Architecture</data>
    <data key="d1" />
    <data key="d2">Distributed video transcoding pipeline using EC2 spot instances and S3.</data>
    <data key="d3">Compute &amp; Media Services</data>
    <data key="d4">True</data>
  </graph>
</graphml>
