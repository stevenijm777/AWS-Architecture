<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue holding incoming event payloads</data>
    </node>
    <node id="1">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms payloads and calls HTTP API</data>
    </node>
    <node id="2">
      <data key="d5">AWS PrivateLink</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">Provides private connection into the Kaleido network</data>
    </node>
    <node id="3">
      <data key="d5">AWS KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Stores master keys for signing blockchain transactions</data>
    </node>
    <node id="4">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Stores node and application logs</data>
    </node>
    <node id="5">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores full backups of node data and off-chain data</data>
    </node>
    <node id="6">
      <data key="d5">Kaleido Platform &amp; Blockchain</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Private permissioned blockchain platform running EthConnect, Kafka, Registry, and IPFS</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">JSON payload sent from SQS queue to Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda forwards JSON payload over PrivateLink</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">PrivateLink routes payload into EthConnect on Kaleido platform</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Kaleido accesses KMS for transaction signing key decryption</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Kaleido Blockchain Integration Architecture</data>
    <data key="d1" />
    <data key="d2">Shows how an AWS customer account interacts with Kaleido platform services via PrivateLink and KMS.</data>
    <data key="d3">Blockchain &amp; Application Integration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
