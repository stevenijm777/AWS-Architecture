  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">External web and mobile application users</data>
    </node>
    <node id="1">
      <data key="d5">LB</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balancer routing incoming web traffic</data>
    </node>
    <node id="2">
      <data key="d5">ASG</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling Group with mixed instances policy</data>
    </node>
    <node id="3">
      <data key="d5">SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">Spot compute instances inside ASG</data>
    </node>
    <node id="4">
      <data key="d5">ON-DEMAND</data>
      <data key="d6">EC2</data>
      <data key="d7">On-Demand compute instances inside ASG</data>
    </node>
    <node id="5">
      <data key="d5">CW</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">CloudWatch service triggering batch execution</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda function calculating compute capacity requirements</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User traffic directed to Load Balancer</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Load Balancer forwards requests to Auto Scaling Group</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ASG manages Spot instance pool</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ASG manages On-Demand instance pool</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch triggers Lambda function for batch processing</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda calculates capacity and updates Auto Scaling Group</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Dream11 Microservices and Batch Processing Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture uses Auto Scaling Group mixed instance policies with Spot and On-Demand EC2 instances driven by both LB and Lambda.</data>
    <data key="d3">Compute, Scaling, Web &amp; Mobile</data>
    <data key="d4">True</data>
