  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Application EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Individual account web application running on EC2</data>
    </node>
    <node id="1">
      <data key="d5">CloudWatch Logs</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects OS and application logs via CloudWatch Agent</data>
    </node>
    <node id="2">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Captures account API call logs</data>
    </node>
    <node id="3">
      <data key="d5">Flow Logs</data>
      <data key="d6">VPC</data>
      <data key="d7">Captures network IP traffic logs</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams incoming logs from CloudWatch, CloudTrail, and Flow Logs</data>
    </node>
    <node id="5">
      <data key="d5">Log Transformer Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Normalizes, converts format, and filters actionable data</data>
    </node>
    <node id="6">
      <data key="d5">Centralized Log S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Central storage bucket in centralized account</data>
    </node>
    <node id="7">
      <data key="d5">Log Ingestion Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by S3 events to push data into Elasticsearch</data>
    </node>
    <node id="8">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Search and analytics engine for log indexing and root cause troubleshooting</data>
    </node>
    <node id="9">
      <data key="d5">Kibana</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Visualization platform for Elasticsearch data</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 application sends logs to CloudWatch agent</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch streams logs to Kinesis Firehose</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudTrail pushes audit logs to Kinesis Firehose</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Flow Logs pushes network logs to Kinesis Firehose</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis Firehose sends stream data to Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes converted logs cross-account into S3</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 object creation triggers centralized Lambda</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda pushes ingested logs to Elasticsearch</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Elasticsearch provides backend search capabilities for Kibana visualization</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Biogen Centralized Logging Architecture</data>
    <data key="d1" />
    <data key="d2">Centralized logging architecture across individual AWS accounts and a central account using S3, Lambda, Kinesis Firehose, and Elasticsearch/Kibana.</data>
    <data key="d3">Logging &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
