<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Application Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Client application server issuing database queries.</data>
    </node>
    <node id="1">
      <data key="d5">Client Lambda Function</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless application client.</data>
    </node>
    <node id="2">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Distributes database traffic across proxy nodes.</data>
    </node>
    <node id="3">
      <data key="d5">Heimdall Proxy Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Proxy instances performing query routing, caching, and connection management.</data>
    </node>
    <node id="4">
      <data key="d5">Primary Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Writable primary database node.</data>
    </node>
    <node id="5">
      <data key="d5">Secondary Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Read replica database instances.</data>
    </node>
    <node id="6">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Pub-sub cache interface for synchronizing invalidations across proxy nodes.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">App server sends queries to NLB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda function sends queries to NLB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">NLB routes traffic to Heimdall proxy instances.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Proxy directs write operations to primary database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Proxy sends invalidation signals via ElastiCache Pub-Sub.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Database Caching and Read-Write Split Architecture with Heimdall Proxy</data>
    <data key="d1">https://www.youtube.com/watch?v=mT4KDGRgo4k</data>
    <data key="d2">Architecture shows Heimdall Proxy layer using NLB, ElastiCache, and RDS databases for read-write splitting and query caching.</data>
    <data key="d3">Database / Performance / Load Balancing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
