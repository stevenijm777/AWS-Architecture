<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">External users sending requests</data>
    </node>
    <node id="1">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">DNS service routing front-end and back-end traffic</data>
    </node>
    <node id="2">
      <data key="d5">Front End ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer for Front End</data>
    </node>
    <node id="3">
      <data key="d5">Front End ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">ECS cluster running front-end microservices</data>
    </node>
    <node id="4">
      <data key="d5">Back End ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer for Back End</data>
    </node>
    <node id="5">
      <data key="d5">Back End ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">ECS cluster running back-end microservices</data>
    </node>
    <node id="6">
      <data key="d5">Amazon MQ</data>
      <data key="d6">AmazonMQ</data>
      <data key="d7">Message broker service for back-end messaging</data>
    </node>
    <node id="7">
      <data key="d5">Aurora MySQL</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational database target</data>
    </node>
    <node id="8">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">Database Migration Service used for migrating legacy database data</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User request to Route 53</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Route 53 directs front-end traffic to Front End ALB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Route 53 routes back-end request to Back End ALB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Front End ALB forwards to Front End ECS</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Front End ECS calls back-end via Route 53 DNS query</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Back End ALB forwards request to Back End ECS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Back End ECS reads/writes to Aurora MySQL</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Back End ECS generates/consumes messages with Amazon MQ</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">DMS migrates data into Aurora MySQL</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="1" id="0">
      <data key="d8">3</data>
      <data key="d9">Blue line drawn connecting DMS back across to Route 53</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Zappos Back Office Architecture with ECS, Aurora MySQL, and Amazon MQ</data>
    <data key="d1">https://www.youtube.com/watch?v=mZxF1IJEsaY</data>
    <data key="d2">Architecture showing Zappos front-end and back-end decoupling on ECS with Aurora MySQL and Amazon MQ.</data>
    <data key="d3">Web Application &amp; Database Migration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
