    <node id="6">
      <data key="d5">Crypt Keeper Microservices</data>
      <data key="d6">ECS</data>
      <data key="d7">Consists of dead message consumer, MorkDB, Morktician UI, and Lazarus re-queuer</data>
    </node>
    <node id="7">
      <data key="d5">Engineering Team</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Inspects and manages dead-lettered messages</data>
    </node>
