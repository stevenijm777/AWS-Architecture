<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Input Data Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores incoming raw marketing, customer, and transaction data.</data>
    </node>
    <node id="1">
      <data key="d5">High Priority SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for high-priority/time-sensitive task notifications.</data>
    </node>
    <node id="2">
      <data key="d5">Low Priority SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for low-priority batch processing task notifications.</data>
    </node>
    <node id="3">
      <data key="d5">Worker EC2 (High Priority)</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker instance processing high priority task messages.</data>
    </node>
    <node id="4">
      <data key="d5">Worker EC2 (Low Priority)</data>
      <data key="d6">EC2</data>
      <data key="d7">Worker instance processing low priority task messages.</data>
    </node>
    <node id="5">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors cluster metrics and health for status management.</data>
    </node>
    <node id="6">
      <data key="d5">Resource Manager EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Core controller API managing dynamic task-to-cluster mapping and auto-recovery.</data>
    </node>
    <node id="7">
      <data key="d5">RDS Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores task-to-cluster mapping and configuration details.</data>
    </node>
    <node id="8">
      <data key="d5">EMR Clusters (Spot)</data>
      <data key="d6">EMR</data>
      <data key="d7">Dynamic EMR clusters running on Spot instances via Instance Fleets for cost reduction.</data>
    </node>
    <node id="9">
      <data key="d5">Output Data Bucket (EMRFS)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores processed analytics output for downstream application usage.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers high-priority event message to High SQS.</data>
      <data key="d10">1a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers low-priority batch event message to Low SQS.</data>
      <data key="d10">1b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">High priority worker reads message from queue.</data>
      <data key="d10">2a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Low priority worker reads message from queue.</data>
      <data key="d10">2b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Worker queries Resource Manager API for optimal cluster endpoint.</data>
      <data key="d10">3a</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Worker submits high priority processing job to designated EMR cluster.</data>
      <data key="d10">7a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Worker queries Resource Manager API for optimal cluster endpoint.</data>
      <data key="d10">3b</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Worker submits low priority processing job to designated EMR cluster.</data>
      <data key="d10">7b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch feeds metrics to Resource Manager to monitor cluster health.</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Resource Manager reads/writes cluster mapping metadata.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Resource Manager provisions, recovers, or manages EMR status.</data>
      <data key="d10">6</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR processes data and writes output back to S3 bucket via EMRFS.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">From Scratch Big Data Resource Management Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture for dynamically managing big data processing workloads on EMR using custom Resource Manager on AWS.</data>
    <data key="d3">Big Data &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
