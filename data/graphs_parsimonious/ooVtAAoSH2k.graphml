<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer EC2 Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance running in the customer AWS account with CrowdStrike sensor installed</data>
    </node>
    <node id="1">
      <data key="d5">AWS CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Captures API calls and launch events in customer environment</data>
    </node>
    <node id="2">
      <data key="d5">S3 Log Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores CloudTrail audit logs</data>
    </node>
    <node id="3">
      <data key="d5">AWS SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives event notifications when log files are written to S3</data>
    </node>
    <node id="4">
      <data key="d5">AWS SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues log notification messages for CrowdStrike</data>
    </node>
    <node id="5">
      <data key="d5">Cloud Connector</data>
      <data key="d6">EC2</data>
      <data key="d7">CrowdStrike metadata enrichment service running on EC2</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 instance events logged to CloudTrail</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 bucket triggers notification to SNS upon log file creation</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS delivers notification to SQS queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Cloud Connector consumes messages from SQS queue</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Cloud Connector pulls and reads CloudTrail log files from customer S3 bucket</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">CrowdStrike AWS Cloud Connector Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture showing telemetry and log flow from a customer AWS account to CrowdStrike Cloud Connector for threat analysis.</data>
    <data key="d3">Security &amp; Incident Response</data>
    <data key="d4">True</data>
  </graph>
</graphml>
