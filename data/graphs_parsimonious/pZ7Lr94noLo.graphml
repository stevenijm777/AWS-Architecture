    <node id="9">
      <data key="d5">Container State DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Tracks container execution state</data>
    </node>
    <node id="10">
      <data key="d5">Video Output S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores recorded video files for VOD</data>
