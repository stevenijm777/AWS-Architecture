<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User / Domain Traffic</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">External user or verification request for custom domain</data>
    </node>
    <node id="1">
      <data key="d5">Edge ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Edge region load balancer receiving inbound domain requests</data>
    </node>
    <node id="2">
      <data key="d5">Edge ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Edge ECS task proxying verification requests to Main Region</data>
    </node>
    <node id="3">
      <data key="d5">Edge ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Caches distributed certificates locally in edge region</data>
    </node>
    <node id="4">
      <data key="d5">Edge SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Subscribed queue receiving certificate updates from SNS</data>
    </node>
    <node id="5">
      <data key="d5">Main Region ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Receives cross-region verification requests from edge regions</data>
    </node>
    <node id="6">
      <data key="d5">Certificate Manager (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Main Region EC2 managing SSL certificate requests and issuance</data>
    </node>
    <node id="7">
      <data key="d5">Main Region RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores certificate metadata and verification details</data>
    </node>
    <node id="8">
      <data key="d5">Main Region SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">SNS topic for broadcasting new certificates to edge SQS queues</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Domain connection / verification request arrives at Edge ELB</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Edge ELB forwards request to Edge ECS</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Edge ECS proxies cross-region request to Main Region ELB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Main Region ELB routes request to Certificate Manager on EC2</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Certificate Manager stores and retrieves certificate verification data in RDS</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Certificate Manager publishes issued SSL certificate data to SNS topic</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS fans out certificate payload to subscribed SQS queue in Edge Region</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Strikingly - Dynamic SSL Certificate Distribution Platform</data>
    <data key="d1" />
    <data key="d2">Strikingly's multi-region architecture for issuing and fanning out dynamic SSL certificates for custom domains across global edge regions.</data>
    <data key="d3">Compute, Security, Messaging &amp; Caching</data>
    <data key="d4">True</data>
  </graph>
</graphml>
