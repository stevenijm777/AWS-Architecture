<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Ingestion Kinesis Stream</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Receives all incoming system events</data>
    </node>
    <node id="1">
      <data key="d5">Fan-out Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">In-house Lambda fan-out system that separates events by topic</data>
    </node>
    <node id="2">
      <data key="d5">Topic Kinesis Streams</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Multiple topic-separated Kinesis streams</data>
    </node>
    <node id="3">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw JSON and transformed Parquet data</data>
    </node>
    <node id="4">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Normalizes, cleans up data, and converts JSON to Parquet</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries processed dataset in S3 for recommendations</data>
    </node>
    <node id="6">
      <data key="d5">Recommendation Orchestrator</data>
      <data key="d6">Lambda</data>
      <data key="d7">Schedules and triggers Athena queries and EMR clusters</data>
    </node>
    <node id="7">
      <data key="d5">Amazon EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Processes datasets to compute rankings and scores</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Ingested events sent to fan-out Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda fans out events into topic streams</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Topic streams deliver raw JSON data to S3</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue reads raw JSON from S3 (labeled '1')</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries processed dataset stored in S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue writes normalized Parquet data back to S3 (labeled '1A')</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena query results trigger recommendation workflow via Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda spins off EMR cluster on the dataset</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Depop Product Recommendation Engine Data Pipeline</data>
    <data key="d1" />
    <data key="d2">Whiteboard diagram depicting event fan-out with Kinesis/Lambda, S3 raw/processed data storage with Glue ETL, and recommendation compute with Athena, Lambda, and EMR.</data>
    <data key="d3">Analytics &amp; Data Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
