  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Ingests incoming track &amp; trace messages (6,000 calls/sec)</data>
    </node>
    <node id="1">
      <data key="d5">LAMBDA (Validation)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates message authenticity using parallel .NET Core</data>
    </node>
    <node id="2">
      <data key="d5">S3 (Ingest)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores validated raw messages</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues validated messages for downstream processing</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMO DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores key validation state and non-SQL data</data>
    </node>
    <node id="5">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Transforms non-SQL data into SQL structure for Redshift</data>
    </node>
    <node id="6">
      <data key="d5">LAMBDA (Processing)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes queued pipeline data</data>
    </node>
    <node id="7">
      <data key="d5">S3 (Processing)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores prepared data ready for Redshift loading</data>
    </node>
    <node id="8">
      <data key="d5">DATA PIPELINE</data>
      <data key="d6">DataPipeline</data>
      <data key="d7">Orchestrates fact table preparation and COPY commands into Redshift</data>
    </node>
    <node id="9">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Columnar data warehouse for fact table queries</data>
    </node>
    <node id="10">
      <data key="d5">QUICKSIGHT</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualizes fact tables using SPICE engine</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes incoming calls to Validation Lambda</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Validation Lambda performs massive traffic writes to DynamoDB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Validation Lambda stores messages into S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Validation Lambda pushes valid data to SQS queue</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS feeds message batches into Processing Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB feeds non-SQL data to EC2 for compute transformation</data>
      <data key="d10">2</data>
