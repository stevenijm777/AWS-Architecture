      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN caching content at edge locations</data>
    </node>
    <node id="4">
      <data key="d5">Lambda @ Edge</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Executes security header injection and auth checks</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts single page application static assets in region</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Web request touches Shield for DDoS protection</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Request passes from Shield to WAF</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Request passes to CloudFront distribution</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront invokes Lambda@Edge for security logic</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront fetches backend assets from S3 origin in region</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
