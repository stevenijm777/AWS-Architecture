<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Hungry customer placing order via mobile/web app</data>
    </node>
    <node id="1">
      <data key="d5">Driver</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Delivery driver using mobile app for status and location updates</data>
    </node>
    <node id="2">
      <data key="d5">Delivery Aggregator</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Delivery aggregator platform handling orders and driver locations</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">HTTP API Gateway with direct integration to EventBridge</data>
    </node>
    <node id="4">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Amazon EventBridge event bus routing order events</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">AWS Step Functions modeling order lifecycle and wait states</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda functions performing POS validation and order release</data>
    </node>
    <node id="7">
      <data key="d5">Taco Bell Store</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">In-store POS and kitchen technology</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Customer places order on delivery aggregator app</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Driver accepts order and sends location geofence events</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Delivery aggregator posts event to API Gateway</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway forwards event directly to EventBridge</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge triggers Step Functions state machine execution</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions invokes Lambda task</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda notifies Delivery Aggregator that order is accepted</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda triggers store kitchen/POS system to prepare food</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Taco Bell Order Middleware Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=sezX7CSbXTg</data>
    <data key="d2">Whiteboard diagram from This is My Architecture video featuring Taco Bell's serverless order routing platform using API Gateway, EventBridge, Step Functions, and Lambda.</data>
    <data key="d3">Serverless Event-Driven Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
