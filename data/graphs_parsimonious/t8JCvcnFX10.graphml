  <graph edgedefault="directed">
    <node id="0">
      <data key="d8">GitLab Runner Unity</data>
      <data key="d9">EKS</data>
      <data key="d10">Dedicated EKS pod running in Base Node Group in Private Subnet A for Unity build orchestration.</data>
    </node>
    <node id="1">
      <data key="d8">GitLab Runner Perf</data>
      <data key="d9">EKS</data>
      <data key="d10">Dedicated EKS pod in Base Node Group in Private Subnet A managing performance build workflows.</data>
    </node>
    <node id="2">
      <data key="d8">GitLab Job (Subnet A)</data>
      <data key="d9">EKS</data>
      <data key="d10">Worker pod in Private Subnet A running on spot instances (.16xlarge / .metal) scaling dynamically.</data>
    </node>
    <node id="3">
      <data key="d8">GitLab Job (Subnet B)</data>
      <data key="d9">EKS</data>
      <data key="d10">Worker pod in Private Subnet B executing compilation and security scanning steps.</data>
    </node>
    <node id="4">
      <data key="d8">GitLab Job (Subnet C)</data>
      <data key="d9">EKS</data>
      <data key="d10">Worker pod in Private Subnet C ensuring multi-AZ spot instance availability.</data>
    </node>
    <node id="5">
      <data key="d8">Amazon S3 Cache/Artifacts</data>
      <data key="d9">S3</data>
      <data key="d10">Amazon S3 bucket used for build caching and artifacts, accessed via VPC endpoint.</data>
    </node>
    <edge source="1" target="5" id="0">
      <data key="d11">0</data>
      <data key="d12">GitLab Runner Perf queries S3 to check for existing build cache and artifacts.</data>
      <data key="d13">0</data>
      <data key="d14">control</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d11">0</data>
      <data key="d12">GitLab Runner Perf creates and schedules a Kubernetes job pod in Subnet B.</data>
      <data key="d13">2</data>
      <data key="d14">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d11">0</data>
      <data key="d12">GitLab Job uploads generated build artifacts and updated cache back to S3.</data>
      <data key="d13">3</data>
      <data key="d14">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d11">0</data>
      <data key="d12">GitLab Job reports execution status and results back to GitLab Runner Perf.</data>
      <data key="d13">4</data>
      <data key="d14">control</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d11">0</data>
      <data key="d12">Amazon S3 returns cached dependencies and build artifacts to GitLab Runner Perf.</data>
      <data key="d13">1</data>
      <data key="d14">data</data>
    </edge>
    <data key="d0">Age of Learning - Scalable CI/CD Pipeline on Amazon EKS</data>
    <data key="d1">https://www.youtube.com/watch?v=t8JCvcnFX10</data>
    <data key="d2">EKS-based build platform scaling up to 50 spot worker instances across 3 private subnets with S3 artifact caching for 20k-25k monthly builds.</data>
