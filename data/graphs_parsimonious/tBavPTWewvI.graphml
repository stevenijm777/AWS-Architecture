<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile / Web Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">External user client sending requests</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancing routing traffic</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Elastic Kubernetes Service running microservices</data>
    </node>
    <node id="3">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational Database Service for data persistence</data>
    </node>
    <node id="4">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Apache Kafka event bus</data>
    </node>
    <node id="5">
      <data key="d5">Analytics</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Analytics team consumers and dashboards</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Requests from client to load balancer</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Traffic distributed to EKS microservices</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices read/write data to RDS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Microservices publish events to Kafka</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="1">
      <data key="d8">1</data>
      <data key="d9">Additional event streams published to Kafka</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Microservices consume events from Kafka</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Kafka streams events to analytics dashboards</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">ACV Auctions Microservices Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=tBavPTWewvI</data>
    <data key="d2">Architecture showing mobile/web requests routed through ELB to microservices on EKS, persisting to RDS, and using Kafka for inter-service event streaming and analytics.</data>
    <data key="d3">Compute, Messaging, Databases</data>
    <data key="d4">True</data>
  </graph>
</graphml>
