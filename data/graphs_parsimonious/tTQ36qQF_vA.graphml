  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Global CDN with origin failover</data>
    </node>
    <node id="1">
      <data key="d5">S3 Bucket (Website - Region 1)</data>
      <data key="d6">S3</data>
      <data key="d7">Primary static website origin</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB (Region 1)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Primary key-value database</data>
    </node>
    <node id="3">
      <data key="d5">S3 Bucket (Data - Region 1)</data>
      <data key="d6">S3</data>
      <data key="d7">Primary object store</data>
    </node>
    <node id="4">
      <data key="d5">Cognito User Pool (Region 1)</data>
      <data key="d6">Cognito</data>
      <data key="d7">Primary identity provider</data>
    </node>
    <node id="5">
      <data key="d5">S3 Bucket (Website - Region 2)</data>
      <data key="d6">S3</data>
      <data key="d7">Secondary static website origin failover</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB (Region 2)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Secondary key-value database</data>
    </node>
    <node id="7">
      <data key="d5">S3 Bucket (Data - Region 2)</data>
      <data key="d6">S3</data>
      <data key="d7">Secondary object store</data>
    </node>
    <node id="8">
      <data key="d5">Cognito User Pool (Region 2)</data>
      <data key="d6">Cognito</data>
      <data key="d7">Secondary identity provider</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Primary traffic path</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Origin failover path</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB global table replication</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">S3 cross-region replication</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">4</data>
      <data key="d9">Cognito user pool synchronization</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
