    <data key="d0">Multi-Region Serverless Architecture</data>
    <data key="d1" />
    <data key="d2">Multi-region active-passive architecture featuring automated failover and data replication for CloudFront, S3, DynamoDB, and Cognito.</data>
    <data key="d3">Compute, Storage, Database, Serverless</data>
    <data key="d4">True</data>
