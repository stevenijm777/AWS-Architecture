<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Audio Ingest Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores incoming call conversation data</data>
    </node>
    <node id="1">
      <data key="d5">Orchestrator</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates audio analysis pipeline</data>
    </node>
    <node id="2">
      <data key="d5">Speech to Text</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts audio to transcript with PII redaction</data>
    </node>
    <node id="3">
      <data key="d5">Sentiment Analysis</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Extracts sentiment from transcript text</data>
    </node>
    <node id="4">
      <data key="d5">Data Lake Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores intermediate processed results and call analytics</data>
    </node>
    <node id="5">
      <data key="d5">Search Engine</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Allows searching phone conversations by internal users</data>
    </node>
    <node id="6">
      <data key="d5">Internal Search UI</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">User interface for querying call transcripts</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Audio file triggers Step Functions</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Triggers Transcribe job</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Passes transcripts to Comprehend</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">4</data>
      <data key="d9">Saves sentiment results to S3</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">5</data>
      <data key="d9">Ingests call data into Elasticsearch</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Zillow Speech Analytics Architecture</data>
    <data key="d1" />
    <data key="d2">Whiteboard diagram illustrating Zillow's speech analytics pipeline using Step Functions, Transcribe, Comprehend, S3, and Elasticsearch.</data>
    <data key="d3">Analytics / Machine Learning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
