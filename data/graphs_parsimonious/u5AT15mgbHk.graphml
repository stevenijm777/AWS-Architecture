  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Global Accelerator</data>
      <data key="d6">GlobalAccelerator</data>
      <data key="d7">Provides Anycast static IPs to distribute incoming ad bid requests.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 (Bidders)</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs .NET C# bidding software.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 (Aerospike Database)</data>
      <data key="d6">EC2</data>
      <data key="d7">In-memory database on EC2 for microsecond audience data lookups.</data>
    </node>
    <node id="3">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Shown on diagram as alternative or legacy entry point.</data>
    </node>
    <node id="4">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Additional compute node representation.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Storage backing Vertica analytics engine.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Global Accelerator routes incoming ad bid traffic to bidder EC2 instances.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Bidders perform real-time data lookups against Aerospike DB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">The Trade Desk: Global Low-Latency Ad Bidding Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture leverages Amazon Global Accelerator to route high-volume traffic to low-latency .NET bidder EC2 instances backed by Aerospike on EC2.</data>
    <data key="d3">Ad Tech / Low Latency Systems</data>
    <data key="d4">True</data>
  </graph>
