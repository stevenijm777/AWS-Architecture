<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Loan Databases</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Internal databases like loan origination and loan management systems</data>
    </node>
    <node id="1">
      <data key="d5">External Data Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Semi-structured bureau data from external systems</data>
    </node>
    <node id="2">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">AWS Database Migration Service pulling structured and semi-structured data</data>
    </node>
    <node id="3">
      <data key="d5">RAW</data>
      <data key="d6">S3</data>
      <data key="d7">Staging layer / Data lake storing raw data</data>
    </node>
    <node id="4">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Key Management Service encrypting customer sensitive data</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Used for execution orchestration and serverless processing</data>
    </node>
    <node id="6">
      <data key="d5">GLUE</data>
      <data key="d6">Glue</data>
      <data key="d7">ETL engine performing business transformations, data quality checks, and auditing</data>
    </node>
    <node id="7">
      <data key="d5">PROCESSED</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing transformed target format data</data>
    </node>
    <node id="8">
      <data key="d5">AURORA PG</data>
      <data key="d6">Aurora</data>
      <data key="d7">Aurora PostgreSQL serving as the data mart</data>
    </node>
    <node id="9">
      <data key="d5">TABLEAU</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Business intelligence tool consuming data for dashboards and reports</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Extracts structured data from internal databases</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Extracts semi-structured bureau data from external systems</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Puts raw data into staging S3 bucket</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Glue pulls raw data from staging bucket for transformation</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Stores transformed data into target S3 bucket</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Loads transformed data into Aurora Postgres data mart</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Tableau queries presentation layer in Aurora Postgres</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Bajaj Housing Finance Serverless Data Pipeline Architecture</data>
    <data key="d1" />
    <data key="d2">Serverless data pipeline and data mart architecture built using DMS, S3, Glue, Aurora PostgreSQL, and Tableau.</data>
    <data key="d3">Data Lake &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
