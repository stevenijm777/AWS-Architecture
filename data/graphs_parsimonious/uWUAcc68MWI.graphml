  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IoT Devices</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Temperature sensors generating MQTT data</data>
    </node>
    <node id="1">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests MQTT messages</data>
    </node>
    <node id="2">
      <data key="d5">AWS IoT Rule</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Filters and routes incoming IoT messages</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Kinesis Data Firehose (Raw)</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams raw messages to storage and analytics</data>
    </node>
    <node id="4">
      <data key="d5">Amazon S3 (Raw Bucket)</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term storage for raw IoT data</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Kinesis Data Analytics</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Runs SQL queries / transforms on streaming data</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Kinesis Data Firehose (Processed)</data>
      <data key="d6">Firehose</data>
      <data key="d7">Delivers processed events to S3</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3 (Processed Bucket)</data>
      <data key="d6">S3</data>
      <data key="d7">Storage for analyzed and transformed IoT data</data>
    </node>
    <node id="8">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Publishes processed events to DynamoDB</data>
    </node>
    <node id="9">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores analytics data for low-latency retrieval by web app</data>
    </node>
    <node id="10">
      <data key="d5">Amazon Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">User authentication and access control</data>
    </node>
    <node id="11">
      <data key="d5">Amazon CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Content delivery network hosting static web app</data>
    </node>
    <node id="12">
      <data key="d5">End User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Web user accessing dashboard</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends MQTT temperature data to IoT Core</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers IoT Rule</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Routes action to Kinesis Data Firehose</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Stores raw messages in S3</data>
      <data key="d10">4a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Streams data to Kinesis Data Analytics</data>
      <data key="d10">4b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends processed stream to Firehose</data>
      <data key="d10">5a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers Lambda for database insertion</data>
      <data key="d10">5b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Saves processed JSON to S3</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes processed data to DynamoDB</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Web application queries DynamoDB every 10 seconds</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
