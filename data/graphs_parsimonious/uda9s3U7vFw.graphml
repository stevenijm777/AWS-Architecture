<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User App / Website</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Client web or mobile application.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Serves JavaScript tracking snippet.</data>
    </node>
    <node id="2">
      <data key="d5">Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Latency-based DNS routing to endpoints.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives event tracking requests.</data>
    </node>
    <node id="4">
      <data key="d5">Validation Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates events and ensures privacy compliance.</data>
    </node>
    <node id="5">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers incoming logs before storage.</data>
    </node>
    <node id="6">
      <data key="d5">Raw Data S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw gzipped log files.</data>
    </node>
    <node id="7">
      <data key="d5">SNS Topic</data>
      <data key="d6">SNS</data>
      <data key="d7">Notifies subscribers of new S3 objects.</data>
    </node>
    <node id="8">
      <data key="d5">ETL Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Normalizes and enriches log data.</data>
    </node>
    <node id="9">
      <data key="d5">Output S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores transformed data for analytics.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Downloads tracking snippet.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends event requests.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Routes request to closest API Gateway endpoint.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Forwards event payload to Lambda.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends validated log data to Firehose.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Delivers gzipped files to S3 bucket.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers ObjectCreated notification.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Invokes ETL Lambda function.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Saves transformed data to output bucket.</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Tuso AI Analytics Data Pipeline</data>
    <data key="d1" />
    <data key="d2">Serverless analytics ingestion and transformation architecture using AWS.</data>
    <data key="d3">Data Analytics &amp; Serverless Pipeline</data>
    <data key="d4">True</data>
  </graph>
</graphml>
