<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Triggers events on deployment</data>
    </node>
    <node id="1">
      <data key="d5">Systems Manager</data>
      <data key="d6">SystemsManager</data>
      <data key="d7">Monitored AWS service</data>
    </node>
    <node id="2">
      <data key="d5">EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Receives raw event streams</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms and enriches raw event data</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores raw historical event data</data>
    </node>
    <node id="5">
      <data key="d5">Timestream</data>
      <data key="d6">Timestream</data>
      <data key="d7">Stores aggregated time-series metrics</data>
    </node>
    <node id="6">
      <data key="d5">Grafana</data>
      <data key="d6">Grafana</data>
      <data key="d7">Dashboards for visualization</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Event triggered and sent to EventBridge</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">EventBridge triggers Lambda transformation</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda writes raw data to DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">4</data>
      <data key="d9">Lambda writes time-series metrics to Timestream</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">5</data>
      <data key="d9">Grafana queries Timestream for visualization dashboards</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Contino Flight Controller Architecture with AWS Control Tower</data>
    <data key="d1">https://www.youtube.com/watch?v=unFVfqj9cQ8</data>
    <data key="d2">Flight Controller is an extension to AWS Control Tower that ingests landing zone events into EventBridge, transforms them with Lambda, stores raw logs in DynamoDB and time-series data in Timestream, and visualizes them in Grafana.</data>
    <data key="d3">Monitoring &amp; Telemetry</data>
    <data key="d4">True</data>
  </graph>
</graphml>
