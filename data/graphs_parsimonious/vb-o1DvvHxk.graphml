<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Entry load balancer for user web frontend traffic</data>
    </node>
    <node id="1">
      <data key="d5">Elastic Beanstalk</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Runs application frontend/backend servers</data>
    </node>
    <node id="2">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for backend processing and Lambda invocation</data>
    </node>
    <node id="3">
      <data key="d5">Lambda (Invoice Scraper)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Retrieves invoice PDFs from supplier client portals</data>
    </node>
    <node id="4">
      <data key="d5">PDF Invoices</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Invoice documents retrieved from supplier websites</data>
    </node>
    <node id="5">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded invoice PDF files</data>
    </node>
    <node id="6">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives bucket notifications and buffers processing jobs</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Processor)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes invoice data triggered by SQS or API Gateway</data>
    </node>
    <node id="8">
      <data key="d5">Lambda (Analytics/Calculation)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Generates syntheses and calculations</data>
    </node>
    <node id="9">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Caches temporary processing data</data>
    </node>
    <node id="10">
      <data key="d5">RDS Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database for structured persistent storage</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Incoming traffic routed to Elastic Beanstalk</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Beanstalk directly reads from RDS to render frontend views</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Frontend invokes API Gateway for backend processing tasks</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway triggers invoice scraper Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Direct invocation of middle Lambda from API Gateway</data>
      <data key="d10">1a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Direct invocation of bottom Lambda from API Gateway</data>
      <data key="d10">1b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Scraper Lambda fetches PDF invoice documents</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Invoices are deposited into S3 bucket</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 events trigger messages into SQS queue</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS triggers middle processing Lambda</data>
      <data key="d10">5a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">SQS triggers bottom processing Lambda</data>
      <data key="d10">5b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Middle Lambda writes temporary cache data to ElastiCache</data>
      <data key="d10">2a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Middle Lambda persists structured data to RDS</data>
      <data key="d10">2b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Bottom Lambda writes calculation results to RDS</data>
      <data key="d10">2c</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Enoptea Serverless PHP Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture showing Elastic Beanstalk frontend coupled with a multi-Lambda serverless PHP processing pipeline using S3, SQS, ElastiCache, and RDS.</data>
    <data key="d3">Web Application &amp; Event-Driven Serverless Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
