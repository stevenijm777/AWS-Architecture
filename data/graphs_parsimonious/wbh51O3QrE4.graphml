<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Electric Vehicle</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">3-wheelers and 4-wheelers pushing telemetry data via MQTT/TCP-IP</data>
    </node>
    <node id="1">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancing entry point for vehicle telemetry data</data>
    </node>
    <node id="2">
      <data key="d5">Broker</data>
      <data key="d6">EC2</data>
      <data key="d7">Broker running on EC2 instance</data>
    </node>
    <node id="3">
      <data key="d5">Kinesis</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Kinesis Data Stream storing data for 3 days</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes alerts and routes data to SNS or S3</data>
    </node>
    <node id="5">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends real-time alerts (e.g. geofencing)</data>
    </node>
    <node id="6">
      <data key="d5">Fleet OP</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Fleet operators monitoring vehicle status and receiving alerts</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake storing e-kilometers telemetry data</data>
    </node>
    <node id="8">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Scans, curates, and transforms data for driver ratings and battery insights</data>
    </node>
    <node id="9">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries S3 data to power dashboards for fleet operators</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends data over MQTT/TCP-IP</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Routes traffic to broker</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Pushes data to Kinesis stream</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers Lambda function for event processing</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Sends urgent alerts (e.g. geofence breach)</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Stores general telemetry data into S3 data lake</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Notifies fleet operator immediately</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue extracts raw data for processing</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena queries data from S3</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Writes transformed reports (e.g. driver rating) back to S3</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Delivers dashboard insights to fleet operator</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mahindra Electric Connected Vehicle Platform</data>
    <data key="d1" />
    <data key="d2">Mahindra Electric NEMO platform architecture on AWS for connected electric vehicle data processing, real-time alerts, and analytics.</data>
    <data key="d3" />
    <data key="d4">True</data>
  </graph>
