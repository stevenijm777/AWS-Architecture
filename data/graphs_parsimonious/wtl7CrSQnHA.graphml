    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="datacenter">
      <data key="d0">OnPremDC</data>
      <data key="d1">Data Center</data>
      <data key="d2">on_prem</data>
    </node>
    <node id="lambda_2">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sagemaker">
      <data key="d0">SageMaker</data>
      <data key="d1">SageMaker</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elasticsearch">
      <data key="d0">Elasticsearch</data>
      <data key="d1">Elasticsearch</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="user">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">User</data>
      <data key="d2">user_actor</data>
    </node>
    <edge source="clinic_kafka" target="kinesis_streams" id="0">
      <data key="d3">stream data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kinesis_streams" target="lambda_1" id="0">
      <data key="d3">triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda_1" target="kinesis_firehose" id="0">
      <data key="d3">sends data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_1" target="kinesis_analytics" id="0">
      <data key="d3">sends data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kinesis_analytics" target="lambda_2" id="0">
      <data key="d3">triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda_2" target="elasticsearch" id="0">
