<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudWatch Event</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Triggers the Step Functions workflow on a scheduled basis.</data>
    </node>
    <node id="1">
      <data key="d5">Image Ingestion Orchestrator</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the sequence of Lambda functions to process new flight images.</data>
    </node>
    <node id="2">
      <data key="d5">Processing Lambdas</data>
      <data key="d6">Lambda</data>
      <data key="d7">Three Lambda functions to poll API, transfer images to S3, and write raster proxies to the local server database.</data>
    </node>
    <node id="3">
      <data key="d5">Drone Image Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores high-resolution ortho mosaics, digital terrain models, and digital elevation models.</data>
    </node>
    <node id="4">
      <data key="d5">File Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">Enables the on-premises mapping software to mount and read files directly from the S3 bucket.</data>
    </node>
    <node id="5">
      <data key="d5">3rd Party Drone Software</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Processes raw drone imagery and stores processed flights.</data>
    </node>
    <node id="6">
      <data key="d5">On-Prem Mapping Server &amp; DB</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Hosts the legacy GIS/mapping software and database storing image raster proxies.</data>
    </node>
    <node id="7">
      <data key="d5">Operations &amp; Maintenance Teams</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Internal users accessing the GIS platform to perform equipment health checks and preventive maintenance.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers orchestration workflow on a schedule.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Executes Lambdas sequentially.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Queries API for new flights and initiates transfer.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Writes raster proxy URLs to the local on-premises database.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Reads image data from S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Copies drone image files into S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">On-prem server requests image files from Storage Gateway mount.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Internal users query the mapping software to view imagery.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Marathon Oil Serverless Drone Imagery Ingestion and Mapping Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=ww5fiygF6eg</data>
    <data key="d2">Automates ingestion of drone-captured well pad imagery from a third-party platform into AWS S3, utilizing Lambda to create raster proxies for on-premises GIS systems accessing files via Storage Gateway.</data>
    <data key="d3">data_ingestion, compute_intensive</data>
    <data key="d4">True</data>
  </graph>
</graphml>
