<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Third-Party Drone Software</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Captures and processes drone images on a third-party server.</data>
    </node>
    <node id="1">
      <data key="d5">CloudWatch Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Triggers the Step Functions on a scheduled basis.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates Lambda functions to ingest and process images.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes API calls, saves images to S3, and writes raster proxies to DB.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores drone image files.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">Provides on-premises server with file-based access to S3.</data>
    </node>
    <node id="6">
      <data key="d5">On-Premises Mapping Server</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Hosts mapping software and local database for raster proxies.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Downloads drone files and stores them in S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Scheduled trigger initiates Step Functions.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Orchestrates execution of the three Lambda functions.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Queries third-party API for new images.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Stores created raster proxies in the local database.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Retrieves actual drone images stored in Amazon S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Accesses image files via Storage Gateway mount.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Marathon Oil Drone Imagery Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=sI91X0E9p0E</data>
    <data key="d2">Serverless pipeline automating drone imagery processing and local integration using AWS Storage Gateway.</data>
    <data key="d3">Media &amp; Serverless Pipelines</data>
    <data key="d4">True</data>
  </graph>
