    <node id="7">
      <data key="d5">Node Group (Cluster 2)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 worker nodes for Cluster 2</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Meta Cluster controls and provisions K8s Cluster 1 control plane</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Meta Cluster controls and provisions K8s Cluster 2 control plane</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">ELB distributes traffic to App 1 node group EC2 instances</data>
