      <data key="d11">data</data>
    </edge>
    <data key="d0">Datadog Meta Cluster Kubernetes Architecture</data>
    <data key="d1" />
    <data key="d2">Datadog uses an EC2-based Meta Cluster to manage and scale multiple individual Kubernetes cluster control planes and their corresponding ELBs and EC2 node groups.</data>
    <data key="d3">Containers &amp; Compute</data>
    <data key="d4">True</data>
