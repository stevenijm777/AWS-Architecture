  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Meta Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs the Kubernetes Meta Cluster control plane on EC2</data>
    </node>
    <node id="1">
      <data key="d5">K8s Cluster 1 Control Plane</data>
      <data key="d6">EC2</data>
      <data key="d7">Managed Kubernetes cluster control plane 1</data>
    </node>
    <node id="2">
      <data key="d5">K8s Cluster 2 Control Plane</data>
      <data key="d6">EC2</data>
      <data key="d7">Managed Kubernetes cluster control plane 2</data>
    </node>
    <node id="3">
      <data key="d5">ELB (Cluster 1)</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balances traffic for Cluster 1 node groups</data>
    </node>
    <node id="4">
      <data key="d5">Node Group - App 1</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 worker nodes for Application 1</data>
    </node>
    <node id="5">
      <data key="d5">Node Group - App 2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 worker nodes for Application 2</data>
    </node>
    <node id="6">
      <data key="d5">ELB (Cluster 2)</data>
      <data key="d6">ELB</data>
      <data key="d7">Load balances traffic for Cluster 2 node groups</data>
