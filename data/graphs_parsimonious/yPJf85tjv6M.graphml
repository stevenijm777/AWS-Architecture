      <data key="d7">Data warehouse for BI tools and aggregations</data>
    </node>
    <node id="9">
      <data key="d5">BI Tools</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Business intelligence dashboards</data>
    </node>
    <node id="10">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Automates headless browser refreshes for BI Tools</data>
    </node>
    <edge source="0" target="1" id="0">
