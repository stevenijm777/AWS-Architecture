  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Receives clickstream requests from users</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes request processing</data>
