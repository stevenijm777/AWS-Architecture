<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web / Mobile Clients</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Users generating event traffic via JavaScript on web pages</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives event payloads from web frontend JavaScript</data>
    </node>
    <node id="2">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs ad servers and microservices sending event streams</data>
    </node>
    <node id="3">
      <data key="d5">Kinesis Stream (Ingestion)</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Ingests raw event streams in Avro format using KPL</data>
    </node>
    <node id="4">
      <data key="d5">S3 (Schema &amp; Reference Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores Avro schema registry and reference data</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Processor)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes events by schema fingerprinting and schema validation from S3</data>
    </node>
    <node id="6">
      <data key="d5">Kinesis Stream (Processed)</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Processed event streams used as downstream integration points</data>
    </node>
    <node id="7">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams processed events into S3 data lake storage</data>
    </node>
    <node id="8">
      <data key="d5">S3 (Data Lake)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw Avro files and converted Parquet partitions</data>
    </node>
    <node id="9">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query engine for analytics on Parquet data</data>
    </node>
    <node id="10">
      <data key="d5">Data Scientists &amp; Analysts</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Queries data using Athena for experiments and ad-hoc analytics</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Web JavaScript sends user activity events to API Gateway</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway forwards event data into Kinesis Stream</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS services write event streams using KPL to Kinesis Stream</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Processor Lambdas trigger on incoming Kinesis events</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda reads schema and reference data from S3</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda publishes decoded and processed events to secondary Kinesis stream</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Processed Kinesis stream feeds into Kinesis Firehose</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Firehose writes raw event files into S3</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Batch process deduplicates and converts Avro files to Parquet back in S3</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries formatted Parquet data stored in S3</data>
      <data key="d10">10</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Data scientists and analysts consume query results from Athena</data>
      <data key="d10">11</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Intent - Serverless Data Ingestion and Analytics Platform</data>
    <data key="d1" />
    <data key="d2">Architecture uses API Gateway, ECS, Kinesis Data Streams, Lambda, Kinesis Firehose, S3, and Athena for serverless high-throughput event processing and analytics.</data>
    <data key="d3">Analytics &amp; Data Pipelines</data>
    <data key="d4">True</data>
  </graph>
