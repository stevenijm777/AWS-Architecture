  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">APP</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">SaaS Web Application initiating email campaigns</data>
    </node>
    <node id="1">
      <data key="d5">Aurora Postgres</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores metadata, templates, and recipient data</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores campaign recipient CSV files</data>
    </node>
    <node id="3">
      <data key="d5">ElastiCache Redis</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Custom job queue in remote region</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (Mail Merge)</data>
      <data key="d6">EC2</data>
      <data key="d7">Fleet processing job queue and merging templates</data>
    </node>
    <node id="5">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Network Load Balancer routing to MTAs</data>
    </node>
    <node id="6">
      <data key="d5">EC2 (MTA)</data>
      <data key="d6">EC2</data>
      <data key="d7">Fleet of Mail Transfer Agents using BYOIP</data>
    </node>
    <node id="7">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams delivery logs back to main account database</data>
    </node>
    <node id="8">
      <data key="d5">Internet Recipients</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External email recipients</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Enqueues processing job into ElastiCache Redis</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Exports recipient data into S3 CSV files</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Fetches templates for mail merge</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Fetches recipient CSV files</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Pulls queue jobs</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">4</data>
      <data key="d9">Sends merged email stream to NLB</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">5</data>
      <data key="d9">Routes email traffic to MTA instances</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">6</data>
      <data key="d9">Delivers emails across the internet using BYOIP</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">7</data>
      <data key="d9">Sends delivery/bounce log entries via Kinesis agent</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="1" id="0">
      <data key="d8">8</data>
      <data key="d9">Streams log metrics back to Aurora Postgres</data>
      <data key="d10">10</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">CM Group Email Delivery Subsystem Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=zhCNn7v7mvs</data>
    <data key="d2">Multi-region architecture for high-volume email delivery processing billions of emails using EC2, NLB, ElastiCache Redis, S3, Aurora Postgres, and Kinesis Firehose.</data>
    <data key="d3">Messaging, Serverless, Compute, Storage</data>
    <data key="d4">True</data>
  </graph>
