  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Central Amazon EKS cluster</data>
    </node>
    <node id="1">
      <data key="d5">EKS Manager</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Custom tool wrapping CloudFormation to provision compute, network, storage, and IAM resources for EKS</data>
    </node>
    <node id="2">
      <data key="d5">Bootstrapper</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Custom CRD tool that bootstraps namespaces and integrates RBAC with IAM</data>
    </node>
    <node id="3">
      <data key="d5">EKS Connect</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">Go-based wrapper around kubectl ensuring authenticated user/CI/CD deployment access</data>
    </node>
    <node id="4">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">AWS Identity and Access Management</data>
    </node>
    <node id="5">
      <data key="d5">Active Directory</data>
      <data key="d6">DirectoryService</data>
      <data key="d7">Enterprise Active Directory backend for user identity federation</data>
    </node>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
