  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Time-based trigger every 10 minutes</data>
    </node>
    <node id="1">
      <data key="d5">Collector</data>
      <data key="d6">Fargate</data>
      <data key="d7">Account-based discovery container process</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores collected raw resource outputs</data>
    </node>
    <node id="3">
      <data key="d5">Diff</data>
      <data key="d6">Fargate</data>
      <data key="d7">Compares current outputs to previous runs</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores difference outputs</data>
    </node>
    <node id="5">
      <data key="d5">Publisher</data>
      <data key="d6">Lambda</data>
      <data key="d7">Pushes changed state data to Elasticsearch</data>
    </node>
    <node id="6">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Inventory data repository</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Triggers Collector on schedule</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes discovered account state</data>
