<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Migration Team</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal engineers triggering migration and populating operational metadata</data>
    </node>
    <node id="1">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Chatops interface used to issue migration commands</data>
    </node>
    <node id="2">
      <data key="d5">On-Premises Servers</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Source servers being migrated to AWS</data>
    </node>
    <node id="3">
      <data key="d5">Application Discovery Service</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Collects network connection metadata and performance utilization from on-prem</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB Metadata Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores operational metadata like target accounts, subnets, IPs, and tags</data>
    </node>
    <node id="5">
      <data key="d5">Migration Factory EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Central orchestration instance driving API commands for migration</data>
    </node>
    <node id="6">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Replication tool controlling continuous block-level volume replication</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Hot Replica</data>
      <data key="d6">EC2</data>
      <data key="d7">Continuously replicated volume staging instance in AWS</data>
    </node>
    <node id="8">
      <data key="d5">Bake AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">AMI created from the hot replica instance</data>
    </node>
    <node id="9">
      <data key="d5">Shared AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">AMI shared securely across to the target AWS account</data>
    </node>
    <node id="10">
      <data key="d5">Target EC2 Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">Final provisioned instance launched in the target account</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration team writes target account configuration and tags to DynamoDB</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Migration team issues command via Slack</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Slack invokes API on Migration Factory EC2 instance</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">On-prem agent sends TCP and performance metadata to Application Discovery Service</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudEndure agent continuously replicates block data to hot replica instance</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Migration Factory retrieves network connection metadata</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Migration Factory calls API to stop CloudEndure replication</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Migration Factory triggers AMI creation from hot replica</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Migration Factory shares encrypted AMI to target account using DynamoDB metadata</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Migration Factory launches target EC2 instance with proper sizing, IP, and tags</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Replication stops on the hot replica instance</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Versent Automated AWS Server Migration Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Automated server migration factory using Slack, EC2, CloudEndure, and Application Discovery Service to reduce migration time from hours to minutes.</data>
    <data key="d3">Migration &amp; Automation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
