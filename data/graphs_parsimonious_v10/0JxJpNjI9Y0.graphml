  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Public Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-users requesting web pages like WashingtonPost.com</data>
    </node>
    <node id="1">
      <data key="d5">Developer / Newsroom</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal developers and newsroom staff</data>
    </node>
    <node id="2">
      <data key="d5">Origin ECS Proxy</data>
      <data key="d6">ECS</data>
      <data key="d7">Handles incoming traffic routing for static and dynamic requests</data>
    </node>
    <node id="3">
      <data key="d5">Static Resources</data>
      <data key="d6">S3</data>
      <data key="d7">Stores static assets such as JavaScript and CSS</data>
    </node>
    <node id="4">
      <data key="d5">Pre-Render Content</data>
      <data key="d6">S3</data>
      <data key="d7">Stores pre-rendered HTML content for high availability</data>
    </node>
    <node id="5">
      <data key="d5">Rendering Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes site rendering code on cache miss</data>
    </node>
    <node id="6">
      <data key="d5">Page Templates Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores web layout templates managed via Page Builder Admin</data>
    </node>
    <node id="7">
      <data key="d5">Content Proxy ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Proxy for retrieving content payloads</data>
    </node>
    <node id="8">
      <data key="d5">Raw JSON Cache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Caches raw JSON content payloads with TTL</data>
    </node>
    <node id="9">
      <data key="d5">CMS &amp; External APIs</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Arc CMS, third-party content management systems, or external APIs</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Public user makes HTTP request to view web page</data>
      <data key="d10">0</data>
