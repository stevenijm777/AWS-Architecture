      <data key="d9">ALB routes web traffic to EC2 cluster</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 cluster nodes access central shared storage on EFS</data>
