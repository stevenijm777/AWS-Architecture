  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Client / User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user accessing the Appway web application</data>
    </node>
    <node id="1">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user authentication and OpenID Connect integration</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing requests to EC2 cluster nodes</data>
    </node>
    <node id="3">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Appway application cluster nodes running on Amazon Linux</data>
    </node>
    <node id="4">
      <data key="d5">EFS</data>
      <data key="d6">EFS</data>
      <data key="d7">Central shared file storage for the cluster nodes</data>
    </node>
    <node id="5">
      <data key="d5">S2S VPN</data>
      <data key="d6">S2SVPN</data>
      <data key="d7">Site-to-Site VPN connecting EC2 cluster to customer network</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts React-based single-page DevOps management application</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API interface for serverless DevOps management tool</data>
    </node>
    <node id="8">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes DevOps automation tasks across customer environments</data>
    </node>
    <node id="9">
      <data key="d5">Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Enforces security guardrails and compliance rules</data>
    </node>
    <node id="10">
      <data key="d5">Organizations</data>
      <data key="d6">Organizations</data>
      <data key="d7">Manages dedicated AWS accounts per customer for strong isolation</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">User authenticates through Cognito</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
