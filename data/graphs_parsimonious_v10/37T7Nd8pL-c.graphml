<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">End Users / Document Source</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Uploads PDF documents containing text and images.</data>
    </node>
    <node id="1">
      <data key="d5">Document Store S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded PDF files.</data>
    </node>
    <node id="2">
      <data key="d5">EventBridge Main Bus</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Receives upload events and notifies downstream consumers upon completion.</data>
    </node>
    <node id="3">
      <data key="d5">Document Processing Workflow</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates multi-step page extraction, analysis, and noise filtering.</data>
    </node>
    <node id="4">
      <data key="d5">Processing Lambdas</data>
      <data key="d6">Lambda</data>
      <data key="d7">Converts pages to images and interfaces with custom ML endpoints.</data>
    </node>
    <node id="5">
      <data key="d5">SageMaker Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Custom machine learning model for analyzing page images.</data>
    </node>
    <node id="6">
      <data key="d5">Managed Textract API</data>
      <data key="d6">Textract</data>
      <data key="d7">Extracts text from processed document pages.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">End users upload raw PDF files to S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 triggers an event on EventBridge main bus upon file upload.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EventBridge triggers Step Functions workflow execution.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions executes Lambda functions to process pages.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions invokes Managed Textract API for text extraction.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions publishes event back to EventBridge notifying completion.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda sends converted page images to SageMaker real-time endpoint.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker returns image classification and analysis results back to Lambda.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Textract returns extracted text for semantic and reading-order analysis.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Docebo AI-Powered Document Cleaning and E-Learning Generation Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=37T7Nd8pL-c</data>
    <data key="d2">Orchestrates S3, EventBridge, Step Functions, Lambda, SageMaker, and Textract to reduce document noise by 80%.</data>
    <data key="d3">AI/ML Document Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
