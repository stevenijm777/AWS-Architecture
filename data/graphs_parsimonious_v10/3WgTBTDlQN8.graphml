  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Users</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">End-users submitting requests via mobile application</data>
    </node>
    <node id="1">
      <data key="d5">Web Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-users accessing platform via web browser</data>
    </node>
    <node id="2">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles entry requests from mobile and web users</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes core logic for user team creation and ingestion triggers</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Triggers events after match completion</data>
    </node>
    <node id="5">
      <data key="d5">Game APIs</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External APIs sending real-time game scores/points updates</data>
    </node>
    <node id="6">
      <data key="d5">MongoDB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Primary database for user details, teams, and leaderboards</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake storing match data and score updates</data>
    </node>
    <node id="8">
      <data key="d5">Amazon EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs Spark jobs to calculate rankings and estimated user winnings</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for running analytics on promotional offers and coupons</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile user requests to API Gateway</data>
