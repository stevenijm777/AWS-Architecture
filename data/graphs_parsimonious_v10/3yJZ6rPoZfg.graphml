<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users / Devices</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End users and handheld/mounted geospatial devices.</data>
    </node>
    <node id="1">
      <data key="d5">S3 Data Store</data>
      <data key="d6">S3</data>
      <data key="d7">Central data account storing primary geospatial datasets.</data>
    </node>
    <node id="2">
      <data key="d5">EKS (Data)</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS cluster handling streaming data back to users.</data>
    </node>
    <node id="3">
      <data key="d5">VPC Peering</data>
      <data key="d6">VPCPeering</data>
      <data key="d7">Connects data account VPC with processing VPCs.</data>
    </node>
    <node id="4">
      <data key="d5">EKS (User Pro)</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS cluster managing user services and queue listeners.</data>
    </node>
    <node id="5">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue holding upload processing events.</data>
    </node>
    <node id="6">
      <data key="d5">Auto Scaling Group</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">EC2 auto scaling groups for file processing steps.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Uploads</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket for direct user uploads and processed assets.</data>
    </node>
    <edge source="0" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">User uploads file directly via pre-signed URL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Data read from central S3 storage into Data EKS cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Data routed across VPC Peering network backbone.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Data received by User/Processing EKS cluster.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS container component listens to SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Processing task dispatched to EC2 instances in Auto Scaling Group.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 event triggers message to SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Hexagon Digital Reality Cloud Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=3yJZ6rPoZfg</data>
    <data key="d2">Architecture for streaming and processing high-precision geospatial data using EKS, S3, SQS, and Auto Scaling.</data>
    <data key="d3">Geospatial Data Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
