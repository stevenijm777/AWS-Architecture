<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Producer</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Locomotive and track sensors</data>
    </node>
    <node id="1">
      <data key="d5">Ingestion Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms raw producer payloads</data>
    </node>
    <node id="2">
      <data key="d5">Raw Kinesis Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Buffers incoming raw events</data>
    </node>
    <node id="3">
      <data key="d5">Kinesis Analytics</data>
      <data key="d6">KinesisAnalytics</data>
      <data key="d7">Filters and aggregates sample data</data>
    </node>
    <node id="4">
      <data key="d5">Central Kinesis Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Aggregates normalized data streams</data>
    </node>
    <node id="5">
      <data key="d5">Storage &amp; API Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Formats and reads/writes state</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores digital twin state</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Provides API endpoint for consumers</data>
    </node>
    <node id="8">
      <data key="d5">Consumer</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External evaluation algorithms</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Sensors send raw stream</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Pushes raw data to stream</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Stream flows to analytics</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Filtered events sent to central stream</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers storage processing Lambda</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Persists state to database</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Returns formatted data</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Reads state from DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Routes request to Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Delivers payload to consumer</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Consumer queries state</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">SBB Real-time Digital Twin Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=4-teOQ_dJvY</data>
    <data key="d2">Processes high-volume train sensor data to inspect conditions via digital twin.</data>
    <data key="d3">IoT, Serverless Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
