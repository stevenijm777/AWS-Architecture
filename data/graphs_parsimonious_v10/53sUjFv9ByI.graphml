  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Ingestion EC2 Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Spun up by data engineers to ingest raw genomic ATCG sequence data.</data>
    </node>
    <node id="1">
      <data key="d5">FSx Storage</data>
      <data key="d6">FSX</data>
      <data key="d7">Stores high-throughput genomic raw files.</data>
    </node>
    <node id="2">
      <data key="d5">Container Registry</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores versioned pipeline container images.</data>
    </node>
    <node id="3">
      <data key="d5">EKS Cluster</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs auto-scaling containerized curation workloads.</data>
    </node>
    <node id="4">
      <data key="d5">Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Persists structured matrix output datasets.</data>
    </node>
    <node id="5">
      <data key="d5">Data Scientists / Biologists</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Downstream internal users analyzing resulting data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 writes raw ingested sequencing data into FSx.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">FSx volume mounted to EKS processing nodes.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Versioned tools referenced during initial pipeline setup.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS pulls versioned pipeline container images from ECR.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Curated matrix results written into S3 Data Lake.</data>
