<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IoT Platform</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests data from farm lines and supply chain sensors</data>
    </node>
    <node id="1">
      <data key="d5">Threshold Check Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Evaluates IoT sensor thresholds</data>
    </node>
    <node id="2">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Routes requests into EKS cluster</data>
    </node>
    <node id="3">
      <data key="d5">Blockchain on EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs Hyperledger Fabric smart contracts in containers</data>
    </node>
    <node id="4">
      <data key="d5">Off-chain Database</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores off-chain ledger data for real-time query/visualization</data>
    </node>
    <node id="5">
      <data key="d5">Analytics Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Stores exported transaction data for machine learning</data>
    </node>
    <node id="6">
      <data key="d5">Predictive Models</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Generates insights and foresight on supply chain produce quality</data>
    </node>
    <node id="7">
      <data key="d5">Event Notifications</data>
      <data key="d6">SNS</data>
      <data key="d7">Invoked by smart contracts to send alert notifications</data>
    </node>
    <node id="8">
      <data key="d5">Drivers / Users</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Receives real-time notifications on mobile device</data>
    </node>
    <node id="9">
      <data key="d5">Monitoring</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors EKS cluster nodes and metrics</data>
    </node>
    <node id="10">
      <data key="d5">Key Management</data>
      <data key="d6">CloudHSM</data>
      <data key="d7">Hardware Security Module protecting blockchain cryptographic keys</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">IoT Core triggers Lambda function based on sensor data</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda forwards requests to Application Load Balancer</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB writes transaction data to EKS blockchain nodes</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Blockchain data is mirrored off-chain to DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Smart contract triggers notification on threshold exception</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">EKS container metrics and logs sent to CloudWatch</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB exports data to S3 bucket</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 feeds data into SageMaker for predictive analytics</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS alerts drivers/users regarding produce rerouting</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">CloudHSM manages cryptographic keys for blockchain operations</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Accenture Circular Supply Chain Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=5CwIt-Alqhg</data>
    <data key="d2">Circular supply chain solution using IoT, EKS (Hyperledger Fabric Blockchain), DynamoDB off-chain storage, S3/SageMaker analytics, and CloudHSM key management.</data>
    <data key="d3">IoT, Blockchain, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
