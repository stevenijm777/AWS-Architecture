<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Database</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Source database on-premises</data>
    </node>
    <node id="1">
      <data key="d5">Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">NFS volumes for daily incremental data ingestion</data>
    </node>
    <node id="2">
      <data key="d5">AWS Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">2x10G Direct Connect link</data>
    </node>
    <node id="3">
      <data key="d5">Landing Zone Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Real-time landing bucket for ingested data</data>
    </node>
    <node id="4">
      <data key="d5">Quality Cleansing</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 processing node executing quality cleansing scripts</data>
    </node>
    <node id="5">
      <data key="d5">RDS (PostgreSQL)</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores metadata and ELT transformation scripts</data>
    </node>
    <node id="6">
      <data key="d5">Transformation Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Holds cleansed data prior to Redshift loading</data>
    </node>
    <node id="7">
      <data key="d5">Transformation</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 processing node driving load and transformation into Redshift</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse storing facts and dimensions</data>
    </node>
    <node id="9">
      <data key="d5">Publish Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores published datasets for daily dashboards and reports</data>
    </node>
    <node id="10">
      <data key="d5">Glacier Storage</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term archive storage for publish bucket lifecycle</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Daily data incremental extract from source DB</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion data stream sent via Direct Connect</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Data lands in S3 Landing Zone</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Quality cleansing node picks up data from landing zone</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Reads metadata/cleansing scripts from RDS</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Writes cleansed data to transformation bucket</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformation node fetches cleansed data</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Reads transformation scripts from RDS</data>
      <data key="d10">7</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Transforms and loads data into Redshift</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Publishes data from Redshift to Publish S3 bucket</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Lifecycle retention moves old data to Glacier archive</data>
      <data key="d10">10</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Capgemini On-Premises Netezza Migration to AWS Redshift</data>
    <data key="d1">https://www.youtube.com/watch?v=5f3z1Z_9BJA</data>
    <data key="d2">Architecture showing daily automated data ingestion from on-premises database via Storage Gateway and Direct Connect into S3 landing zone, ELT processing with EC2 and RDS metadata, loading into Redshift, publishing to S3 dashboard bucket, and archiving to Glacier.</data>
    <data key="d3">Data Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
