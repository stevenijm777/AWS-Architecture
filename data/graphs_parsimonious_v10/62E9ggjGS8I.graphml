      <data key="d6">ControlTower</data>
      <data key="d7">Provisions new AWS accounts with baselines.</data>
    </node>
    <node id="3">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Deploys standardized VPC infrastructure.</data>
    </node>
    <node id="4">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">Vended account network layer.</data>
    </node>
    <node id="5">
      <data key="d5">Vended Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Transit Gateway in vended account.</data>
    </node>
    <node id="6">
      <data key="d5">Network Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Central core network Transit Gateway.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User initiates self-service request.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ITSM triggers account factory in Control Tower.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Service Catalog provisions VPC into vended account.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Vended TGW connects to central network TGW.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DISH Network Account Vending and Networking Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=62E9ggjGS8I</data>
    <data key="d2">Self-service AWS account vending architecture using Control Tower, Service Catalog, and Transit Gateway.</data>
    <data key="d3">Automation</data>
    <data key="d4">True</data>
