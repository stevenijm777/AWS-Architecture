<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client Device (Mobile / PC)</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">End-user device requesting personalized video rendering and watching playback</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles client rendering requests with usage plans and API keys</data>
    </node>
    <node id="2">
      <data key="d5">Frontend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates render requests, manages job submission and response handling</data>
    </node>
    <node id="3">
      <data key="d5">Rendering Instruction SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds rendering instructions for engine workers</data>
    </node>
    <node id="4">
      <data key="d5">Response SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives quick responses from rendering engines</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Auto Scaling (Engine Service)</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Fleet of EC2 spot instances performing video rendering jobs</data>
    </node>
    <node id="6">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded video segments</data>
    </node>
    <node id="7">
      <data key="d5">CloudFront CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Distributes video segments to end users</data>
    </node>
    <node id="8">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers scaling Lambda periodically (every 15s)</data>
    </node>
    <node id="9">
      <data key="d5">Scaling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Calculates required rendering capacity and updates Auto Scaling Group</data>
    </node>
    <node id="10">
      <data key="d5">CloudWatch / Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects rendering metrics and handles spot interruption event notifications</data>
    </node>
    <node id="11">
      <data key="d5">Spot Interruption Handler Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles 2-minute spot interruption warnings to gracefully drain instances</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Client sends video rendering request</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Client streams video segments via CloudFront</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Frontend Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda pushes rendering instructions to SQS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda returns playlist URL to client device</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 instances pull rendering jobs from SQS queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda pulls response from SQS</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 instance responds immediately with job response</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 instances render and upload video segments to S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Rendering instances push metrics to CloudWatch</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront fetches video segments from S3 origin</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Step Functions triggers scaling Lambda every 15 seconds</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Scaling Lambda reads CloudWatch metrics</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Scaling Lambda adjusts capacity in Auto Scaling group</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">CloudWatch Events notifies spot interruption to handler Lambda</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="11" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Handler Lambda signals instance to stop taking jobs and drain</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">SundaySky Rendering as a Service Ecosystem</data>
    <data key="d1">https://www.youtube.com/watch?v=6CgqEzyWpeA</data>
    <data key="d2">Architecture for SundaySky's personalized video Rendering as a Service (RaaS) using spot instances, SQS queues, Step Functions, and API Gateway.</data>
