<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Fan / Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-user browsing and purchasing tickets</data>
    </node>
    <node id="1">
      <data key="d5">CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Handles latency/geo-routing and health checks across active-active regions</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs Next.js web application for rendering pages</data>
    </node>
    <node id="3">
      <data key="d5">AppSync</data>
      <data key="d6">AppSync</data>
      <data key="d7">GraphQL API layer with WebSockets for async purchase status subscription</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles single-step retrieve and transform queries</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions Purchase</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates multi-step checkout and payment execution processes</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Global Tables replicating session and event data active-active across regions</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests page or submits API action via CDN</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes web page rendering requests to EKS Next.js app</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Routes API calls / mutations to AppSync GraphQL endpoint</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Executes single-step read/query logic in Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Executes complex purchase workflows in Step Functions</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Reads and updates session data in DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Ticketmaster Multi-Region Active-Active Serverless Checkout Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6iK4WNj6QqI</data>
    <data key="d2">Ticketmaster uses a multi-region active-active architecture powered by CloudFront latency/geo-routing, AppSync GraphQL API, EKS, Lambda, Step Functions, and DynamoDB Global Tables.</data>
    <data key="d3">E-Commerce, Serverless, Multi-Region</data>
    <data key="d4">True</data>
  </graph>
</graphml>
