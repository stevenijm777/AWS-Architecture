<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Admin</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Admin managing infrastructure as code and container images.</data>
    </node>
    <node id="1">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End users accessing applications.</data>
    </node>
    <node id="2">
      <data key="d5">Load Balancing</data>
      <data key="d6">ELB</data>
      <data key="d7">AWS Edge Load Balancer for high availability.</data>
    </node>
    <node id="3">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Amazon Elastic Container Registry.</data>
    </node>
    <node id="4">
      <data key="d5">EKS / KIC</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS running NGINX Ingress Controller.</data>
    </node>
    <node id="5">
      <data key="d5">Service A</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Backend containerized application service A.</data>
    </node>
    <node id="6">
      <data key="d5">Service B</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Backend containerized application service B.</data>
    </node>
    <node id="7">
      <data key="d5">Service C</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Backend containerized application service C.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Admin builds and pushes Docker images to ECR.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Admin configures Kubernetes via kubectl.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">3</data>
      <data key="d9">Users send web requests to AWS Load Balancer.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Load Balancer forwards web traffic to NGINX Ingress Controller on EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">EKS pulls container images from ECR.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Ingress controller routes traffic to Service A.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Ingress controller routes traffic to Service B.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Ingress controller routes traffic to Service C.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">NGINX Ingress Controller on AWS EKS Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6sY0AunanlM</data>
    <data key="d2">Architecture showing edge load balancing with NGINX Ingress Controller managing traffic inside EKS.</data>
    <data key="d3">Containers &amp; Networking</data>
    <data key="d4">True</data>
