<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Service Teams</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal NAB development teams running build pipelines in non-prod accounts</data>
    </node>
    <node id="1">
      <data key="d5">Kong on ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs Kong API Gateway to publish endpoints and receive build events</data>
    </node>
    <node id="2">
      <data key="d5">Assessment &amp; Execution Lambdas</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes logic to capture events, run compliance assessments, and trigger promotion</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores build events and key-value build evidence</data>
    </node>
    <node id="4">
      <data key="d5">RDS PostgreSQL</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores relational compliance frameworks, standards, and control metadata</data>
    </node>
    <node id="5">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends cross-account promotion notifications to production environment</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Build pipelines send build events and API calls to Kong on ECS</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Kong routes event requests to Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda stores build events in DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda evaluates DynamoDB events against compliance standards in RDS</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">On compliance success, Lambda publishes promotion notification to SNS</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">National Australia Bank - Automated Compliance and Deployment Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=7V8wTCkjOqo</data>
    <data key="d2">Automated compliance framework (Deputy) built by NAB to validate build events against standards before promoting deployments to production accounts.</data>
    <data key="d3">CI/CD &amp; Governance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
