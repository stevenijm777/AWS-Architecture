<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">External mobile application sending game API requests.</data>
    </node>
    <node id="1">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Distributes incoming game API traffic.</data>
    </node>
    <node id="2">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs game server containers to compute application logic.</data>
    </node>
    <node id="3">
      <data key="d5">Auto Scaling</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Scales underlying EC2 instances based on load.</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Detects EC2 launch completion events.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes logic to adjust ECS desired task count.</data>
    </node>
    <node id="6">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores primary relational game and player data.</data>
    </node>
    <node id="7">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Provides in-memory caching for low latency.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests enter through ALB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes API traffic to ECS container tasks.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS reads and writes persistent player data to Aurora.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS retrieves and updates cached state in ElastiCache.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Auto Scaling EC2 instance launch triggers CloudWatch Events.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch Events invokes Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda scales out ECS tasks to match EC2 capacity.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Akatsuki Scalable Mobile Game Backend</data>
    <data key="d1">https://www.youtube.com/watch?v=7dtomip_VXc</data>
    <data key="d2">High-concurrency mobile game backend supporting massive auto-scaling and rapid spike handling.</data>
    <data key="d3">Mobile &amp; Gaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
