<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">External End Users / Clients</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Access client S3 buckets</data>
    </node>
    <node id="1">
      <data key="d5">Client S3 Buckets</data>
      <data key="d6">S3</data>
      <data key="d7">Individual client data buckets (Client 1...N)</data>
    </node>
    <node id="2">
      <data key="d5">S3 Access Logs Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Dedicated bucket receiving S3 access logs</data>
    </node>
    <node id="3">
      <data key="d5">Log Parser Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Parses access logs, maps IP to numeric GeoIP country ID, and attaches client metadata</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Elasticsearch Service</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Indexes access log records and runs anomaly detection model</data>
    </node>
    <node id="5">
      <data key="d5">Amazon SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends email alert notifications to the service team upon anomaly detection</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">External access to client S3 data</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Access logs delivered to central access logs bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Log creation triggers Lambda execution</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda inserts enriched access log records into Elasticsearch</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Anomaly detector triggers SNS alert notification</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mobilewala - Real-Time Anomaly Detection using Amazon Elasticsearch Service</data>
    <data key="d1">https://www.youtube.com/watch?v=8s0wGRkiDrw</data>
    <data key="d2">Mobilewala uses Amazon Elasticsearch Service's anomaly detection feature to analyze S3 access logs in near real-time, sending alerts via SNS when suspicious access patterns are detected.</data>
    <data key="d3">Data &amp; Analytics, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
