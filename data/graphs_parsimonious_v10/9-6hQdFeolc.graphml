<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Healthcare Source</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External hospital or healthcare provider sending data</data>
    </node>
    <node id="1">
      <data key="d5">NLB</data>
      <data key="d6">NLB</data>
      <data key="d7">Network Load Balancer handling Layer 4 TCP connections</data>
    </node>
    <node id="2">
      <data key="d5">HAProxy Ingress (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">HAProxy Ingress Controller running on EC2</data>
    </node>
    <node id="3">
      <data key="d5">App Container (EC2 m6g)</data>
      <data key="d6">EC2</data>
      <data key="d7">Graviton-based worker nodes running tenant integration containers</data>
    </node>
    <node id="4">
      <data key="d5">EBS (gp3)</data>
      <data key="d6">EBS</data>
      <data key="d7">Encrypted GP3 storage volumes assigned per tenant</data>
    </node>
    <node id="5">
      <data key="d5">Healthcare Destination</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Target healthcare provider receiving processed data</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon EKS managing Kubernetes cluster and tenant namespaces</data>
    </node>
    <node id="7">
      <data key="d5">ECR</data>
      <data key="d6">ECR</data>
      <data key="d7">Elastic Container Registry storing application container images</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Layer 4 TCP healthcare traffic sent to NLB</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">NLB forwards incoming traffic to HAProxy Ingress Controller</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">HAProxy routes request to tenant pod running on m6g EC2 instance</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">App container writes/reads tenant data from EBS GP3 volume</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformed healthcare data sent to destination entity</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Container images deployed from ECR to EKS worker node</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Lineate Envoy Healthcare Data Integration Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=9-6hQdFeolc</data>
    <data key="d2">Multi-tenant healthcare data integration platform built on AWS EKS using NLB, HAProxy, Graviton EC2 instances, and encrypted EBS GP3 volumes.</data>
    <data key="d3">Healthcare &amp; Life Sciences</data>
    <data key="d4">True</data>
  </graph>
</graphml>
