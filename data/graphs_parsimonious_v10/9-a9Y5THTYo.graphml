  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal user initiating account request</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives account creation request from self-service web portal</data>
    </node>
    <node id="2">
      <data key="d5">Step Functions (AVM)</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Account Vending Machine workflow orchestrator</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores target state and metadata of account requests</data>
    </node>
    <node id="4">
      <data key="d5">Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Creates new AWS account</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions (Blueprint)</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates deployment of blueprints into created accounts</data>
    </node>
    <node id="6">
      <data key="d5">AWS Account</data>
      <data key="d6">Organizations</data>
      <data key="d7">Newly provisioned customer AWS account</data>
    </node>
    <node id="7">
      <data key="d5">E-Mail</data>
      <data key="d6">SES</data>
      <data key="d7">Notifies user upon successful completion</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User submits request via portal to API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway triggers Step Functions AVM</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions stores target account metadata in DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions invokes Control Tower to create account</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Step Functions triggers Blueprint execution</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Deploys blueprints (IAM, security, network) into target AWS Account</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers e-mail notification upon deployment completion</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
