<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kubernetes Cluster Autoscaler (K8S CA)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Monitors K8s workloads and modifies desired capacity of ASGs</data>
    </node>
    <node id="1">
      <data key="d5">Auto Scaling Groups</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Spans multiple AZs to provide diversification across Spot pools</data>
    </node>
    <node id="2">
      <data key="d5">EC2 Spot Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs Kubernetes worker nodes on 100% Spot instances</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Cluster Autoscaler adjusts desired count on Auto Scaling Groups</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Auto Scaling Groups launch and manage EC2 Spot Instances</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Skyscanner 100% Spot Instances Kubernetes Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=99nNHsbwBpg</data>
    <data key="d2">Skyscanner runs a large-scale Kubernetes cluster on 100% EC2 Spot Instances across multiple Auto Scaling Groups and Availability Zones, managed by the Kubernetes Cluster Autoscaler.</data>
    <data key="d3">Containers, Compute</data>
    <data key="d4">True</data>
  </graph>
</graphml>
