<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Giving Monolith (.NET)</data>
      <data key="d6">EC2</data>
      <data key="d7">Existing .NET monolith handling giving functionality</data>
    </node>
    <node id="1">
      <data key="d5">Apps Platform (Node)</data>
      <data key="d6">EC2</data>
      <data key="d7">Node-based apps platform</data>
    </node>
    <node id="2">
      <data key="d5">Identity Service (ECS)</data>
      <data key="d6">ECS</data>
      <data key="d7">Containers running .NET Core on Alpine Linux providing sign-in/up identity services via GraphQL API</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores event-sourced user and identity records</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Streams full event objects to other downstream microservices and back to the monolith</data>
    </node>
    <node id="5">
      <data key="d5">AWS X-Ray</data>
      <data key="d6">XRay</data>
      <data key="d7">Provides distributed tracing across microservices</data>
    </node>
    <node id="6">
      <data key="d5">SQL Server DB</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database used by the Giving monolith</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Monolith sends identity and profile requests to the ECS identity service</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Apps platform routes sign-in and sign-up calls to the ECS identity service</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Identity service writes user event data to DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Identity service puts full-form event objects onto Kinesis stream</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis sync loop feeds identity events back to the Giving monolith</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Pushpay - Monolith Decomposition with ECS, DynamoDB, and Kinesis</data>
    <data key="d1">https://www.youtube.com/watch?v=9Cg81Xgg7LQ</data>
    <data key="d2">The architecture illustrates breaking down a .NET/SQL Server monolith into microservices running on ECS, using DynamoDB for event sourcing, Kinesis for distributing events back to the monolith, and X-Ray for tracing.</data>
    <data key="d3">Application Integration, Compute, Migration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
