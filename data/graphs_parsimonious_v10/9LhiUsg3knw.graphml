  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Users</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">End-users submitting lyrics synchronization feedback</data>
    </node>
    <node id="1">
      <data key="d5">Community &amp; Internal Web Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Curators and internal editors processing tasks</data>
    </node>
    <node id="2">
      <data key="d5">Legacy Application Servers</data>
      <data key="d6">EC2</data>
      <data key="d7">Dockerized app instances handling feedback ingestion</data>
    </node>
    <node id="3">
      <data key="d5">User Data Store</data>
      <data key="d6">CouchBase</data>
      <data key="d7">NoSQL database for user-generated content</data>
    </node>
    <node id="4">
      <data key="d5">Editorial Data Store</data>
      <data key="d6">Aurora</data>
      <data key="d7">Relational DB for core editorial catalog</data>
    </node>
    <node id="5">
      <data key="d5">Task Database</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores tasks assigned to community members</data>
    </node>
    <node id="6">
      <data key="d5">GraphQL API</data>
      <data key="d6">AppSync</data>
      <data key="d7">Distributes and syncs tasks directly to users</data>
    </node>
    <node id="7">
      <data key="d5">Batch Ranking Tasks</data>
      <data key="d6">Fargate</data>
      <data key="d7">Calculates content relevance and updates task priority</data>
    </node>
    <node id="8">
      <data key="d5">Analytics Warehouse</data>
      <data key="d6">RedShift</data>
      <data key="d7">Analyzes streaming trends by country and language</data>
    </node>
    <node id="9">
      <data key="d5">Publishing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Orchestrates complex writes back to EC2/Aurora</data>
    </node>
    <node id="10">
      <data key="d5">Task Resolver Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles non-standard AppSync resolvers for DynamoDB</data>
    </node>
