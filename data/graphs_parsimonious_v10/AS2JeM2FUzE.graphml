  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External data sources including social media, regulatory data, and premium connectors</data>
    </node>
    <node id="1">
      <data key="d5">Consumers</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Underwriters, policy agents, and insurance carriers</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ELB</data>
      <data key="d7">Elastic Load Balancer fanning out crawled/connected data</data>
    </node>
    <node id="3">
      <data key="d5">K8S Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Kubernetes cluster hosting microservices, Keycloak, Jupyter Notebooks, and Kong API Gateway</data>
    </node>
    <node id="4">
      <data key="d5">MQ</data>
      <data key="d6">AmazonMQ</data>
      <data key="d7">Amazon MQ for message buffering and asynchronous processing</data>
    </node>
    <node id="5">
      <data key="d5">VPC Peering</data>
      <data key="d6">VPCPeering</data>
      <data key="d7">VPC Peering connection for private network access to MongoDB Atlas</data>
    </node>
    <node id="6">
      <data key="d5">MongoDB Atlas</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Primary database storing processed entity and risk analysis data</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS for PostgreSQL used by Kong API Gateway and Keycloak</data>
    </node>
    <node id="8">
      <data key="d5">REDIS</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Redis for session management and cache across microservices</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Data ingested from external data sources into ELB</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Consumers make API requests to Kong API Gateway running in K8S</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB fans out data into K8S microservices</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">K8S microservices push messages into Amazon MQ</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Processed data sent via VPC Peering</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">K8S pipeline consumes messages from Amazon MQ for ML processing</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">VPC Peering routes data to MongoDB Atlas</data>
