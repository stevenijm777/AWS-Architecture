<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer Lambda Function</data>
      <data key="d6">Lambda</data>
      <data key="d7">External client Lambda generating log data</data>
    </node>
    <node id="1">
      <data key="d5">Log Ingestion Kinesis Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Receives log streams from customer CloudWatch log integrations</data>
    </node>
    <node id="2">
      <data key="d5">Transform Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms raw logs into structured invocation records</data>
    </node>
    <node id="3">
      <data key="d5">Customer Metadata DB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores customer function metadata and tracks partial invocations</data>
    </node>
    <node id="4">
      <data key="d5">Invocation Records Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Streams structured invocation records to downstream processors</data>
    </node>
    <node id="5">
      <data key="d5">Aurora Ingestion Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Buffers connection pooling and writes records to Aurora</data>
    </node>
    <node id="6">
      <data key="d5">Serverless Aurora Database</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores invocation data for instant specific item querying</data>
    </node>
    <node id="7">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Batches records and converts formats using Glue integration</data>
    </node>
    <node id="8">
      <data key="d5">AWS Glue Schema Catalog</data>
      <data key="d6">Glue</data>
      <data key="d7">Defines Parquet schema conversion structure for Firehose</data>
    </node>
    <node id="9">
      <data key="d5">Data Lake Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores optimized Parquet invocation records</data>
    </node>
    <node id="10">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries aggregated metrics directly from S3 data lake</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Logs streamed from customer account to ingestion stream</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw logs passed to transform Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lookup metadata and record partial invocation updates</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Publish completed invocation records</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Retrieve customer memory and timeout metadata</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Pass invocation records to storage Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Send invocation records for batch aggregation</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Persist invocation records to Aurora</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Deliver converted Parquet batches to S3 bucket</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Provide schema metadata for Parquet format conversion</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Execute analytical SQL queries against S3 data lake</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Epsagon Serverless Lambda Monitoring Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=AzM_d7ZvzUE</data>
    <data key="d2">Architecture for ingesting customer Lambda log data, transforming into invocation records, and storing in both fast querying (Aurora) and aggregated analytics (S3 + Athena) storage layers.</data>
    <data key="d3">Monitoring &amp; Observability</data>
    <data key="d4">True</data>
  </graph>
