    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS connects out to external CRMs</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SES forwards email event to Lambda</data>
