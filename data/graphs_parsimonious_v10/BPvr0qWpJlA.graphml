  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Caller Carrie</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">End customer initiating calls, chats, or emails</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Connect</data>
      <data key="d6">Connect</data>
      <data key="d7">Handles incoming chat and voice calls</data>
    </node>
    <node id="2">
      <data key="d5">IVR Contact Flow Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes logic based on IVR inputs</data>
    </node>
    <node id="3">
      <data key="d5">ECS Microservices</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs microservices to communicate with external CRMs</data>
    </node>
    <node id="4">
      <data key="d5">CRMs</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party CRMs like Salesforce or Siebel</data>
    </node>
    <node id="5">
      <data key="d5">Amazon SES</data>
      <data key="d6">SES</data>
      <data key="d7">Ingests incoming customer emails</data>
    </node>
    <node id="6">
      <data key="d5">Email Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes email payloads from SES</data>
    </node>
    <node id="7">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores email and interaction data</data>
    </node>
    <node id="8">
      <data key="d5">Agent Andy</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Contact center agent logging in via browser</data>
    </node>
    <node id="9">
      <data key="d5">ContactSuite Application</data>
      <data key="d6">EC2</data>
      <data key="d7">ContactSuite hosted on ELB / EC2 / ASG with SenseIQ knowledge base</data>
    </node>
    <node id="10">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Database storing system metrics and configuration</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Voice and chat traffic initiated by caller</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer sends email</data>
