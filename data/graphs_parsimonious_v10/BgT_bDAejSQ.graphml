<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer / User</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal user or developer initiating access</data>
    </node>
    <node id="1">
      <data key="d5">Amazon EKS (Account A)</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS workload running in private subnet with 24-hour node rotations</data>
    </node>
    <node id="2">
      <data key="d5">NAT Gateway (Account A)</data>
      <data key="d6">NAT</data>
      <data key="d7">Provides outbound internet connectivity for Account A</data>
    </node>
    <node id="3">
      <data key="d5">AWS WAF (Account B)</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall filtering incoming web traffic</data>
    </node>
    <node id="4">
      <data key="d5">Application Load Balancer (Account B)</data>
      <data key="d6">ALB</data>
      <data key="d7">Load balancer in public subnet</data>
    </node>
    <node id="5">
      <data key="d5">Amazon EKS (Account B)</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS workload running in private subnet in Account B</data>
    </node>
    <node id="6">
      <data key="d5">On-Premises Data Center</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Corporate datacenter connected via Direct Connect</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Inbound user request to Account B fronted by AWS WAF</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS private subnets route outbound traffic through NAT Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Communication to On-Premises services via Direct Connect</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">WAF forwards inspected traffic to Application Load Balancer</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">ALB routes traffic to EKS containers in private subnet</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">GoDaddy Zero Trust Multi-Account Cloud Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=BgT_bDAejSQ</data>
    <data key="d2">Demonstrates multi-account isolation (Account A vs Account B), explicit blocking of VPC peering, NAT Gateways for outbound access, EKS node rotations, and fronting workloads with AWS WAF and ALB.</data>
    <data key="d3">Security &amp; Multi-Account Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
