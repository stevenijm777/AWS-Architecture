<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Sensors</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">100k IoT water sensors transmitting protocol data</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Ingestion point for field sensors</data>
    </node>
    <node id="2">
      <data key="d5">Transformer</data>
      <data key="d6">Lambda</data>
      <data key="d7">Standardizes multi-protocol sensor data into flow and alarm segments</data>
    </node>
    <node id="3">
      <data key="d5">Flow Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS FIFO queue for flow metrics</data>
    </node>
    <node id="4">
      <data key="d5">Alarm Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">SQS FIFO queue for alarm events</data>
    </node>
    <node id="5">
      <data key="d5">PreProcessor</data>
      <data key="d6">Lambda</data>
      <data key="d7">Real-time decision engine to filter actionable time-series data</data>
    </node>
    <node id="6">
      <data key="d5">ElasticCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory Redis cache used by PreProcessor</data>
    </node>
    <node id="7">
      <data key="d5">Post Processor</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 running batch jobs to process ~40% relevant data</data>
    </node>
    <node id="8">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores event data (e.g., lorry dumping, borewell start)</data>
    </node>
    <node id="9">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Aurora Serverless storing aggregated daily statistics</data>
    </node>
    <node id="10">
      <data key="d5">Mobile App / Web Portal</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">End-user interface displaying water usage visualizations</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Sensors push raw readings to API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway invokes Transformer Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformer pushes flow data to Flow SQS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformer pushes alarm data to Alarm SQS</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">PreProcessor reads data from Flow Queue</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">PreProcessor queries ElastiCache to evaluate data processing needs</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">PreProcessor passes filtered actionable data (approx 40%) to Post Processor</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Post Processor writes discrete event data to DynamoDB</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Post Processor writes daily aggregated data to Aurora</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Data served to end users on mobile/web applications</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Vigod Water Management IoT Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=CE03UMddoYU</data>
    <data key="d2">Architecture for ingesting, filtering, and storing 27M daily data points from IoT water sensors.</data>
    <data key="d3">IoT / Serverless / Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
