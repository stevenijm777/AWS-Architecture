    <data key="d0">Snapchat Scalable Messaging Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Cgv0kfp_6xQ</data>
    <data key="d2">EKS handles gateway and microservices, backended by ElastiCache, DynamoDB, CloudFront, and S3.</data>
    <data key="d3">Mobile Backend &amp; Microservices</data>
    <data key="d4">True</data>
