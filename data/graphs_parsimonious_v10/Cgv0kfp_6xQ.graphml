  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">iOS Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile client initiating snap uploads</data>
    </node>
    <node id="1">
      <data key="d5">Android Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Recipient mobile client receiving snaps</data>
    </node>
    <node id="2">
      <data key="d5">API Gateway (GW)</data>
      <data key="d6">EKS</data>
      <data key="d7">Ingress gateway running on EKS</data>
    </node>
    <node id="3">
      <data key="d5">Media Service</data>
      <data key="d6">EKS</data>
      <data key="d7">Handles media upload processing</data>
    </node>
    <node id="4">
      <data key="d5">Friend Graph Service</data>
      <data key="d6">EKS</data>
      <data key="d7">Manages social graph relations</data>
    </node>
    <node id="5">
      <data key="d5">Snap DB Layer</data>
      <data key="d6">EKS</data>
      <data key="d7">Custom caching/abstraction layer on EKS</data>
    </node>
    <node id="6">
      <data key="d5">Messaging Service (MGS)</data>
      <data key="d6">EKS</data>
      <data key="d7">Handles latency-sensitive message routing</data>
    </node>
    <node id="7">
      <data key="d5">Amazon CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN for low-latency media delivery</data>
    </node>
    <node id="8">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Persistent storage for media files</data>
    </node>
    <node id="9">
      <data key="d5">Amazon ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Stores active user connection and server mappings</data>
    </node>
    <node id="10">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Primary NoSQL store for persistent metadata</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends snap data to gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes upload to Media Service</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Delivers media payload to CloudFront</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Queries recipient information</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Updates state via Snap DB layer</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Writes persistent metadata to DynamoDB</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Looks up active connection ID</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Reads snap state metadata</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Pushes real-time notification to recipient</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Persists media file to S3 bucket</data>
      <data key="d10">3</data>
