<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Logs into Salesforce UI to initiate connection.</data>
    </node>
    <node id="1">
      <data key="d5">Salesforce (SFDC)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Salesforce data center and control UI.</data>
    </node>
    <node id="2">
      <data key="d5">Control Plane API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives setup requests.</data>
    </node>
    <node id="3">
      <data key="d5">Control Plane Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Provisions PrivateLink and manages configuration.</data>
    </node>
    <node id="4">
      <data key="d5">Metadata Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores customer routing metadata.</data>
    </node>
    <node id="5">
      <data key="d5">State Notifications</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives PrivateLink state changes.</data>
    </node>
    <node id="6">
      <data key="d5">Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Receives VPN traffic from SFDC.</data>
    </node>
    <node id="7">
      <data key="d5">Connection Forwarders</data>
      <data key="d6">EKS</data>
      <data key="d7">Multi-tenant containerized forwarders.</data>
    </node>
    <node id="8">
      <data key="d5">Transit VPC PrivateLink</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">Interface endpoint inside transit VPC.</data>
    </node>
    <node id="9">
      <data key="d5">Customer VPC PrivateLink</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">Endpoint service inside Customer VPC.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User enters setup details in Salesforce UI.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SFDC sends connection setup request.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Data sent from SFDC over encrypted VPN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway invokes Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda stores customer metadata.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda establishes PrivateLink connection.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Transit Gateway routes traffic to EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS routes traffic to appropriate PrivateLink.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">State changes sent to SNS.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">PrivateLink transfers data to Customer VPC.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Salesforce Private Connect Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Cw26CrJUqv8</data>
    <data key="d2">Private, secure connectivity between Salesforce and AWS customer VPCs.</data>
    <data key="d3">Networking &amp; Content Delivery, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
