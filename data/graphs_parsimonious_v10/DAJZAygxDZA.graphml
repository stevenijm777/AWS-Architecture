  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Scientist</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Creates and approves ML models in the model registry.</data>
    </node>
    <node id="1">
      <data key="d5">Model Registry</data>
      <data key="d6">ModelRegistry</data>
      <data key="d7">Central repository for trained SageMaker models in Data Science account.</data>
    </node>
    <node id="2">
      <data key="d5">ML Engineer</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Triggers automated deployment workflows across stages.</data>
    </node>
    <node id="3">
      <data key="d5">XAMD Deployment Service</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Serverless cross-account deployment orchestration app.</data>
    </node>
    <node id="4">
      <data key="d5">QA Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker endpoint running in QA account for validation.</data>
    </node>
    <node id="5">
      <data key="d5">Prod Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Production SageMaker endpoint serving live inference.</data>
    </node>
    <node id="6">
      <data key="d5">Mobile Client</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">End-user app sending inference requests.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Data scientist registers and approves model.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ML engineer invokes XAMD deployment API.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Fetches model artifact from Model Registry.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Deploys model to QA Endpoint.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Deploys validated model to Prod Endpoint.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Sends inference requests to production endpoint.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
