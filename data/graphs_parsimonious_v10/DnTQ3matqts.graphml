  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Sensor</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Physical sensor attached to fitness equipment</data>
    </node>
    <node id="1">
      <data key="d5">App</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile app used by installers and field staff</data>
    </node>
    <node id="2">
      <data key="d5">AWS Greengrass</data>
      <data key="d6">Greengrass</data>
      <data key="d7">Edge gateway running local Lambdas</data>
    </node>
    <node id="3">
      <data key="d5">AWS IoT Core</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests sensor telemetry data</data>
    </node>
    <node id="4">
      <data key="d5">API Gateway (Utilization)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Ingress for utilization data</data>
    </node>
    <node id="5">
      <data key="d5">Utilization Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes equipment utilization data</data>
    </node>
    <node id="6">
      <data key="d5">SQS (Utilization)</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers utilization processing tasks</data>
    </node>
    <node id="7">
      <data key="d5">Timeseries DB</data>
      <data key="d6">Timestream</data>
      <data key="d7">Stores historical sensor and utilization metrics</data>
    </node>
    <node id="8">
      <data key="d5">SQS (Sensor Health)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for sensor heartbeat and health logs</data>
    </node>
    <node id="9">
      <data key="d5">Sensor Health Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Monitors sensor connectivity and flags offline devices</data>
    </node>
    <node id="10">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends notifications when devices go offline</data>
    </node>
    <node id="11">
      <data key="d5">Amazon Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user authentication for reporting</data>
    </node>
    <node id="12">
      <data key="d5">API Gateway (Reporting)</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API layer for report generation portal</data>
    </node>
    <node id="13">
      <data key="d5">Reporting Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Generates aggregated reports from Timestream DB</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Sensor sends telemetry to Greengrass gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
