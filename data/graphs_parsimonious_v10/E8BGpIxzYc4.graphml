<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">MongoDB Operational DB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Operational database storing community management application data</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Buffers incoming change streams</data>
    </node>
    <node id="2">
      <data key="d5">S3 Raw Zone</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uncurated raw JSON data</data>
    </node>
    <node id="3">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Runs crawlers, cataloging, deduplication, and star schema transformations</data>
    </node>
    <node id="4">
      <data key="d5">S3 Landing Zone</data>
      <data key="d6">S3</data>
      <data key="d7">Stores curated landing zone data</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Database holding facts and dimensions in a star schema</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries data directly from the S3 Landing Zone</data>
    </node>
    <node id="7">
      <data key="d5">AWS Elastic Beanstalk</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Handles application query requests to Aurora</data>
    </node>
    <node id="8">
      <data key="d5">CloudFront CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Serves frontend static assets (Angular application)</data>
    </node>
    <node id="9">
      <data key="d5">AIS Middleware</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Integrates external accounting systems</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">MongoDB change streams sent to Firehose</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose dumps raw JSON data into S3 Raw Zone</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue crawler analyzes data in Raw Zone</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Data flow from Raw Zone to Landing Zone</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue job deduplicates and writes curated data to S3 Landing Zone</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue job transforms JSON to star schema and loads into Aurora</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Athena queries Landing Zone directly using Glue Catalog</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">4</data>
      <data key="d9">Elastic Beanstalk queries Aurora database</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Frontend sends HTTP query requests to Elastic Beanstalk backend</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="2" id="0">
      <data key="d8">5</data>
      <data key="d9">AIS middleware delivers external accounting data into Raw Zone</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">TownSquare Data Lake and Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=E8BGpIxzYc4</data>
    <data key="d2">Architecture for ingestion, processing, and querying community management data using S3, Glue, Aurora, and Athena.</data>
    <data key="d3">Data Analytics &amp; Data Lake</data>
    <data key="d4">True</data>
  </graph>
