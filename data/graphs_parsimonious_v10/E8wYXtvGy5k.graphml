<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Scanner</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Handheld scanning device used by drivers</data>
    </node>
    <node id="1">
      <data key="d5">Fargate (Ingestion API)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Consumes scans from handheld devices</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Persists scan data and emits DynamoDB Streams</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes DynamoDB Stream records</data>
    </node>
    <node id="4">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Fans out messages to multiple queue subscribers</data>
    </node>
    <node id="5">
      <data key="d5">SQS (Web Service)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for tracking website updates</data>
    </node>
    <node id="6">
      <data key="d5">Fargate (Web Service)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Processes tracking updates for website display</data>
    </node>
    <node id="7">
      <data key="d5">Website</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Public parcel tracking website</data>
    </node>
    <node id="8">
      <data key="d5">SQS (Image Processing)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for image processing services</data>
    </node>
    <node id="9">
      <data key="d5">Fargate (Image Processing)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Processes images attached to scans</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Driver sends scan payload to Fargate API</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate writes scan data to DynamoDB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB Stream triggers Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda publishes scan events to SNS</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">SNS forwards message to web processing SQS queue</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS fans out message to image processing SQS queue</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Fargate polls SQS queue for web updates</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Updates tracking visibility on public website</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Fargate polls SQS queue to process scan images</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Freightways Package Tracking Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=E8wYXtvGy5k</data>
    <data key="d2">Freightways processes over 50 million parcel scans annually using AWS Fargate, DynamoDB Streams, Lambda, SNS, and SQS for real-time tracking updates.</data>
    <data key="d3">Application Integration, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
