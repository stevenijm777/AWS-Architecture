<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Portal</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Engineer requesting AWS account provisioning</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives account requests</data>
    </node>
    <node id="2">
      <data key="d5">Validate Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Verifies user email and domain authorization</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers creation requests</data>
    </node>
    <node id="4">
      <data key="d5">Create Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes account creation and configuration logic</data>
    </node>
    <node id="5">
      <data key="d5">Organizations</data>
      <data key="d6">Organizations</data>
      <data key="d7">Manages account placement in OUs and enforces SCPs</data>
    </node>
    <node id="6">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Provisions budget alerts and baseline account resources</data>
    </node>
    <node id="7">
      <data key="d5">SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends acknowledgment notifications and credentials to users</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Submits account provisioning request</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Forwards request to Validate Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends acknowledgment notification to user</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Pushes creation payload to SQS queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers Create Lambda</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Assigns account to OU and applies SCP policies</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Deploys templates for account resources and budget alarms</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends completion notification and credentials to user</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Publicis Sapient Account Generation Engine</data>
    <data key="d1">https://www.youtube.com/watch?v=Fd2c7NDYfpo</data>
    <data key="d2">Automated account provisioning system built with serverless architecture, AWS Organizations, and CloudFormation.</data>
    <data key="d3">Management &amp; Governance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
