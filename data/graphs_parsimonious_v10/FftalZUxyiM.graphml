<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Landing Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Receives employee CSV files from HR systems</data>
    </node>
    <node id="1">
      <data key="d5">Validation Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates schema and structure of incoming CSV files</data>
    </node>
    <node id="2">
      <data key="d5">Staging Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores validated data ready for database ingestion</data>
    </node>
    <node id="3">
      <data key="d5">Load Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Loads validated data into DynamoDB</data>
    </node>
    <node id="4">
      <data key="d5">Employee Key-Value Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores structured employee profile data</data>
    </node>
    <node id="5">
      <data key="d5">Graph ETL State Machine</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates creation of node and relationship files for Neptune load</data>
    </node>
    <node id="6">
      <data key="d5">Graph Database</data>
      <data key="d6">Neptune</data>
      <data key="d7">Stores employee skill and role relationships for ranking queries</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes endpoints for the HR web application</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers validation Lambda upon file landing</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Saves validated files to staging bucket</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers ingestion Lambda</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Loads data into DynamoDB</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Serves employee profile data to API Gateway</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Loads nodes and relationships into Neptune graph DB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Serves graph relationship queries to API Gateway</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cepsa Internal Talent Matching Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=FftalZUxyiM</data>
    <data key="d2">Architecture for internal job vacancy matching using an S3 Data Lake, DynamoDB, Step Functions, Amazon Neptune, and API Gateway.</data>
    <data key="d3">Data Lake &amp; Graph Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
