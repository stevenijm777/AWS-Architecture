  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer / CI/CD Pipeline</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Enters scripts and schedules tests via UI, API, or CI/CD</data>
    </node>
    <node id="1">
      <data key="d5">Scheduler</data>
      <data key="d6">EC2</data>
      <data key="d7">Schedules synthetic tests on specified intervals</data>
    </node>
    <node id="2">
      <data key="d5">Job Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Stores test execution jobs</data>
    </node>
    <node id="3">
      <data key="d5">Monitor API</data>
      <data key="d6">EC2</data>
      <data key="d7">Receives incoming test results</data>
    </node>
    <node id="4">
      <data key="d5">Results Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues test results for processing and alerting</data>
    </node>
    <node id="5">
      <data key="d5">Public Monitors</data>
      <data key="d6">EC2</data>
      <data key="d7">New Relic managed runners performing public endpoint checks</data>
    </node>
    <node id="6">
      <data key="d5">Public</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Public website or API under test</data>
    </node>
    <node id="7">
      <data key="d5">Global Accelerator</data>
      <data key="d6">GlobalAccelerator</data>
      <data key="d7">Provides static IPs for whitelisting and secure routing from private minions</data>
    </node>
    <node id="8">
      <data key="d5">Private Monitors</data>
      <data key="d6">EC2</data>
      <data key="d7">Containerized minions running inside customer networks</data>
    </node>
    <node id="9">
      <data key="d5">Private</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Customer private network, VPC, or endpoint under test</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Script submission and scheduling request</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Pushes scheduled jobs into queue</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Job metadata routing</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Pulls public synthetic test jobs</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends test results to Results Queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Feedback loop to reschedule next run</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Executes synthetic test against public endpoint</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Routes test results to Monitor API</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Executes synthetic test against private endpoint</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Sends test results through Global Accelerator static IP</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">New Relic Synthetics Architecture with AWS Global Accelerator</data>
    <data key="d1">https://www.youtube.com/watch?v=FmhL2334GIY</data>
    <data key="d2">System processes both public and private synthetic monitoring tests using a queued event-driven pipeline on AWS.</data>
    <data key="d3">Monitoring &amp; Automated Testing</data>
    <data key="d4">True</data>
