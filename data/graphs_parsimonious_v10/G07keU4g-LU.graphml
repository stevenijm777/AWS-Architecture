  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">E-Commerce App / Web</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Mobile and web ordering applications</data>
    </node>
    <node id="1">
      <data key="d5">Restaurant POS Machines</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Point-of-sale terminals in 1200+ restaurants</data>
    </node>
    <node id="2">
      <data key="d5">E-Commerce DB (MySQL)</data>
      <data key="d6">RDS</data>
      <data key="d7">E-commerce transactional database</data>
