    <node id="6">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Serverless interactive query service for ad-hoc queries</data>
    </node>
    <node id="7">
      <data key="d5">Amazon EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Processes raw data to curated bucket and loads Redshift</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse storing hot data (last 5-6 months)</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Redshift Spectrum</data>
      <data key="d6">RedShift</data>
      <data key="d7">Queries cold data directly in S3 data lake</data>
    </node>
