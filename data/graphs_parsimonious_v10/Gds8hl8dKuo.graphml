<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">External User / Developer</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Sends requests or infrastructure declarations into the conductor system.</data>
    </node>
    <node id="1">
      <data key="d5">Incoming SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives incoming command messages from external users.</data>
    </node>
    <node id="2">
      <data key="d5">Conductor (EC2 Instance)</data>
      <data key="d6">EC2</data>
      <data key="d7">Core orchestration engine running Fugue AMI inside an Auto Scaling group.</data>
    </node>
    <node id="3">
      <data key="d5">AWS KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Handles encryption for messages and infrastructure configuration data.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores compiled infrastructure declarations and compliance policies.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Serves as the persistence layer for the conductor engine.</data>
    </node>
    <node id="6">
      <data key="d5">Internal Messaging SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Handles internal conductor message bus communication.</data>
    </node>
    <node id="7">
      <data key="d5">SNS Topic</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends real-time drift detection and notification alerts.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">External user sends SQS message to trigger conductor operations.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 conductor processes incoming SQS request.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Conductor writes and reads system state to/from DynamoDB persistence layer.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Conductor pushes internal communication messages to SQS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Conductor sends drift detection alerts via SNS topic.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 uses KMS for decrypting and authenticating requests.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Conductor downloads compiled infrastructure map and policy declarations from S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Fugue Automated Drift Detection and Enforcement Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=Gds8hl8dKuo</data>
    <data key="d2">Architecture of Fugue conductor orchestrator running in a customer's AWS account to automatically provision infrastructure, enforce compliance baselines, and remediate drift.</data>
    <data key="d3">Security and Compliance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
