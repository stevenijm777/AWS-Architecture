<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Pipeline / IoT Robots</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External data pipeline sending JSON records</data>
    </node>
    <node id="1">
      <data key="d5">S3 Bucket (JSON)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw incoming JSON records</data>
    </node>
    <node id="2">
      <data key="d5">Glue Crawler (JSON)</data>
      <data key="d6">Glue</data>
      <data key="d7">Crawls raw JSON data in S3</data>
    </node>
    <node id="3">
      <data key="d5">Glue Data Catalog</data>
      <data key="d6">Glue</data>
      <data key="d7">Stores metadata schema (column types, names, tables)</data>
    </node>
    <node id="4">
      <data key="d5">Glue Job (ETL)</data>
      <data key="d6">Glue</data>
      <data key="d7">Transforms incoming JSON data into Parquet format</data>
    </node>
    <node id="5">
      <data key="d5">S3 Bucket (Parquet)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores transformed Parquet data for historical queries</data>
    </node>
    <node id="6">
      <data key="d5">Glue Crawler (Parquet)</data>
      <data key="d6">Glue</data>
      <data key="d7">Crawls Parquet dataset in S3</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries JSON and Parquet data via Data Catalog schemas</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">JSON records written to S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue Crawler inspects raw JSON data</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue job reads recent raw JSON data</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Populates JSON schema into Data Catalog</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue job writes converted Parquet files to S3</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Glue Crawler inspects Parquet dataset</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Populates Parquet schema into Data Catalog</data>
      <data key="d10">6</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">4</data>
      <data key="d9">Athena references Glue Data Catalog schema for queries</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">iRobot Serverless Data Lake Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=GoziWpmFCS0</data>
    <data key="d2">Serverless data lake using S3, Glue (Crawlers, Catalog, Jobs), and Athena for ad-hoc querying.</data>
    <data key="d3">Data Lake &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
