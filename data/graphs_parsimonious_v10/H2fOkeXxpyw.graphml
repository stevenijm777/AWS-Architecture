    <node id="6">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Internal invocation service checking auth and locating Lambdas</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Runs customer JavaScript code inside V8 isolates across account boundary</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer deploys application code via CLI</data>
