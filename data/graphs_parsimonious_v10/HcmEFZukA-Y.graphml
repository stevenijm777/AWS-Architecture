  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Device</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Customer mobile application for 7-Eleven wallet</data>
    </node>
    <node id="1">
      <data key="d5">POS</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">In-store Point of Sale system</data>
    </node>
    <node id="2">
      <data key="d5">Digital Ledger</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External ledger storing wallet balances</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for mobile app and ledger callbacks</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Pinpoint</data>
      <data key="d6">Pinpoint</data>
      <data key="d7">Used for phone number verification</data>
    </node>
    <node id="5">
      <data key="d5">Amazon SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers incoming transaction messages from API Gateway</data>
    </node>
    <node id="6">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes messages, updates ledger and MongoDB</data>
    </node>
    <node id="7">
      <data key="d5">Atlas MongoDB</data>
      <data key="d6">MongoDBAtlas</data>
      <data key="d7">Document database storing local synchronized data</data>
    </node>
    <node id="8">
      <data key="d5">Amazon EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Publishes events to loyalty and customer notification ecosystem</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile app sends requests to API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
