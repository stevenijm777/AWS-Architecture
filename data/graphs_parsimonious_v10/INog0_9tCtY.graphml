  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Customer EC2 (ThreatStack Agent)</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs inside customer VPC, sends telemetry</data>
    </node>
    <node id="1">
      <data key="d5">Customer CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">Audit logs collected from customer environment</data>
    </node>
    <node id="2">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Apache Kafka ingestion layer</data>
    </node>
    <node id="3">
      <data key="d5">Apache Flink</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Near real-time stream processing</data>
    </node>
    <node id="4">
      <data key="d5">Near Real-Time S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores JSON data GZIP compressed</data>
    </node>
    <node id="5">
      <data key="d5">EMR Processing Cluster</data>
      <data key="d6">EMR</data>
      <data key="d7">Batch processes events into Parquet format</data>
    </node>
    <node id="6">
      <data key="d5">Long-Term S3 Data Warehouse</data>
      <data key="d6">S3</data>
      <data key="d7">Stores Parquet formatted data for 30 days</data>
    </node>
    <node id="7">
      <data key="d5">Orchestration EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Orchestrates and manages configuration-approved EMR clusters</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL queries on Parquet data</data>
    </node>
    <node id="9">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">ML models for anomaly detection</data>
    </node>
    <node id="10">
      <data key="d5">EMR Consumption Cluster</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs MapReduce / analytics jobs on long-term data</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Agent sends telemetry over the internet to Kafka</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudTrail logs sent to Kafka</data>
      <data key="d10">1</data>
