  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users (Engineers / Analysts)</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Data engineers, analysts, and scientists requesting infrastructure or data access</data>
