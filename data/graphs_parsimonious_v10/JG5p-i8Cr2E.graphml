    <node id="9">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Data storage for analytical datasets</data>
    </node>
    <node id="10">
      <data key="d5">Provisioned EC2 (Airflow / NiFi)</data>
      <data key="d6">EC2</data>
      <data key="d7">Provisioned instances running containerized data pipeline tools</data>
