<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premise Datacenter</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Building icon representing the on-premise environment receiving shifted traffic.</data>
    </node>
    <node id="1">
      <data key="d5">On-Premise Apps</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Application servers hosted on-premise.</data>
    </node>
    <node id="2">
      <data key="d5">On-Premise Database</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Proprietary SQL database hosted on-premise.</data>
    </node>
    <node id="3">
      <data key="d5">Router (Weighted Traffic Shifting)</data>
      <data key="d6">Route53</data>
      <data key="d7">DNS/Router performing weighted traffic shifting during migration.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Containerized platform for re-architected applications.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute for modern application components.</data>
    </node>
    <node id="6">
      <data key="d5">AWS Elastic Beanstalk</data>
      <data key="d6">BeanStalk</data>
      <data key="d7">Re-platformed application hosting environment.</data>
    </node>
    <node id="7">
      <data key="d5">AWS Database Migration Service</data>
      <data key="d6">DMS</data>
      <data key="d7">Migrates data from on-premise DB to Amazon Aurora.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Managed relational database engine.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Self-hosted database environment (lift-and-shift).</data>
    </node>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premise applications direct ingress traffic to Router.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Re-architecting application path from on-premise apps to EKS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">On-premise database data extracted into DMS.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Lift-and-shift migration of database to EC2.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Router shifts portion of weighted traffic back to on-premise.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Router routes traffic to EKS containers.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Router routes traffic to serverless Lambda functions.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Router routes traffic to Elastic Beanstalk apps.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">4</data>
      <data key="d9">Planned migration path from Elastic Beanstalk to Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">DMS migrates data to Amazon Aurora.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="6" id="0">
      <data key="d8">4</data>
      <data key="d9">EC2 self-hosted database serves Elastic Beanstalk applications.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Talabat Migration and Hybrid Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=JSBB-BCvavQ</data>
    <data key="d2">Architecture illustrating Talabat's digital transformation journey from an on-premise datacenter to AWS using EKS, Lambda, Beanstalk, DMS, Aurora, and EC2 with Route 53 weighted traffic shifting.</data>
    <data key="d3">Migration, Serverless, Containers</data>
    <data key="d4">True</data>
  </graph>
