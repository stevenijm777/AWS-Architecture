<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CSV &amp; Excel Files</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Raw trade data files uploaded by data providers</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3 (Raw Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Bucket storing initial raw CSV/Excel files</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda (Validation)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates incoming data files for discrepancies</data>
    </node>
    <node id="3">
      <data key="d5">Amazon S3 (Validated Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Bucket storing validated trade data files</data>
    </node>
    <node id="4">
      <data key="d5">AWS Lambda (Processing &amp; Ingestion)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes validated data and ingests into OpenSearch</data>
    </node>
    <node id="5">
      <data key="d5">AWS OpenSearch (Graviton2)</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Cluster powered by Graviton2 instances for indexing and querying trade records</data>
    </node>
    <node id="6">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user requesting trade data and reports via web or mobile</data>
    </node>
    <node id="7">
      <data key="d5">Front-End Application (FE)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Angular web frontend application</data>
    </node>
    <node id="8">
      <data key="d5">Back-End Application (BE)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Python backend application handling request routing and business logic</data>
    </node>
    <node id="9">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database used for operational/relational data retrieval</data>
    </node>
    <node id="10">
      <data key="d5">Amazon S3 (Reports)</data>
      <data key="d6">S3</data>
      <data key="d7">Bucket storing generated complex/large report files</data>
    </node>
    <node id="11">
      <data key="d5">Amazon SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends download pre-signed URLs to users for requested reports</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw trade data uploaded to S3 raw bucket</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 triggers validation Lambda function</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Validated copy stored in validated S3 bucket</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers processing Lambda function</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingests aggregated/processed data into OpenSearch</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Web user sends request to Front End UI</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Web browser or mobile app forwards request to Python Back End</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Front End responds to web browser</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Back End queries OpenSearch cluster</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Back End queries Amazon RDS</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Back End returns queried data response to user</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Back End uploads large generated reports into S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Triggers intimation email with pre-signed URL via Amazon SES</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Novantec Trade Data Ingestion and Retrieval Architecture using AWS OpenSearch</data>
    <data key="d1">https://www.youtube.com/watch?v=JYeXbUdFOdw</data>
    <data key="d2">Data ingestion pipeline processes CSV/Excel files into OpenSearch using Lambda and S3. Data retrieval uses web/mobile frontends with Python backends querying OpenSearch and RDS, delivering large reports via S3 and SES.</data>
    <data key="d3">Analytics &amp; Data Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
