<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Bitbucket</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Source repository hosting code and pull requests</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives webhook triggers from Bitbucket</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes payload and zips code artifacts</data>
    </node>
    <node id="3">
      <data key="d5">S3 (Input Bucket)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores zipped input artifacts</data>
    </node>
    <node id="4">
      <data key="d5">AWS CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Detects changed files using checksums</data>
    </node>
    <node id="5">
      <data key="d5">S3 (Output Bucket)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores only modified artifacts to trigger pipeline</data>
    </node>
    <node id="6">
      <data key="d5">AWS CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Orchestrates deployment stages and approvals</data>
    </node>
    <node id="7">
      <data key="d5">AWS CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Applies change sets to update stacks</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Webhook trigger on PR / code commit</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Invokes Lambda function</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Uploads zipped artifacts to S3</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers CodeBuild on object creation</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Uploads changed artifacts to S3</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Triggers CodePipeline execution</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Executes CloudFormation change sets</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">CleverTap Multi-Region Infrastructure Automation Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=JcHSFIZMYHc</data>
    <data key="d2">Automated infrastructure deployment architecture using Bitbucket, API Gateway, Lambda, S3, CodeBuild, CodePipeline, and CloudFormation.</data>
    <data key="d3">CI/CD &amp; DevOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
