<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Source Database</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External database (e.g., MySQL, Postgres) outside or bounded across VPC line</data>
    </node>
    <node id="1">
      <data key="d5">Orchestration Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Generates and responds to synchronization events</data>
    </node>
    <node id="2">
      <data key="d5">Config &amp; State Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores pipeline configuration, execution state, and metrics</data>
    </node>
    <node id="3">
      <data key="d5">Data Connector Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Batches requests, pulls data from source DB, logs status/metrics to DynamoDB, and stages data to S3</data>
    </node>
    <node id="4">
      <data key="d5">Staging Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores staged raw data before loading into Redshift</data>
    </node>
    <node id="5">
      <data key="d5">Redshift Loader Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles schema DDL updates and issues COPY statements to Redshift</data>
    </node>
    <node id="6">
      <data key="d5">Redshift Cluster</data>
      <data key="d6">RedShift</data>
      <data key="d7">Destination data warehouse</data>
    </node>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Logical end-to-end data pipeline flow from Source DB to Redshift</data>
      <data key="d10">10</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestration Lambda reads/writes pipeline metadata and state in DynamoDB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestration Lambda triggers Data Connector Lambda on schedule</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Orchestration Lambda triggers Redshift Loader Lambda</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Connector Lambda fetches batches of raw data from source database</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Connector Lambda updates progress state and sync metrics in DynamoDB</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Connector Lambda writes raw batch data into S3 staging bucket</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Data Connector Lambda alerts Orchestration Lambda upon successful data staging</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Staged raw data is copied from S3 into Amazon Redshift</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift Loader Lambda executes DDL updates and triggers Redshift COPY command</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DataCoral Serverless Data Integration Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=JiWHomdh1oI</data>
    <data key="d2">DataCoral's serverless platform replicates data from external customer databases into Amazon Redshift using AWS Lambda, DynamoDB, and S3.</data>
    <data key="d3">Data Engineering &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
