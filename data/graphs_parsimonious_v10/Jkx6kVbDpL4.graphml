<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">File Source</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External source generating data files and file metadata</data>
    </node>
    <node id="1">
      <data key="d5">Input S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw incoming data files</data>
    </node>
    <node id="2">
      <data key="d5">Metadata Ingest Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers incoming file metadata</data>
    </node>
    <node id="3">
      <data key="d5">Metadata Processor Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes incoming metadata and writes to RDS</data>
    </node>
    <node id="4">
      <data key="d5">PostgreSQL Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Central database storing file metadata and execution status</data>
    </node>
    <node id="5">
      <data key="d5">EMR Work Manager Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Reads RDS metadata and triggers EMR processing jobs</data>
    </node>
    <node id="6">
      <data key="d5">Spark EMR Cluster</data>
      <data key="d6">EMR</data>
      <data key="d7">Performs transformations and formatting on event files</data>
    </node>
    <node id="7">
      <data key="d5">Processed S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores transformed and formatted files ready for upload</data>
    </node>
    <node id="8">
      <data key="d5">Fan-out Work Manager Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Reads processed file metadata and triggers uploader Lambdas</data>
    </node>
    <node id="9">
      <data key="d5">Uploader Lambdas</data>
      <data key="d6">Lambda</data>
      <data key="d7">Scales up to thousands of concurrent instances to upload data to ad networks</data>
    </node>
    <node id="10">
      <data key="d5">Status Buffer Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers upload status reports to prevent RDS connection exhaustion</data>
    </node>
    <node id="11">
      <data key="d5">Status Batch Writer Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Reads batch upload statuses from SQS and updates RDS</data>
    </node>
    <node id="12">
      <data key="d5">Ad Networks</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External partner ad platforms receiving segmentation data</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Data files uploaded to input bucket</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">File metadata sent to SQS queue</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR reads raw files from S3</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Metadata queue triggers processor Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda writes file metadata into RDS</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Work Manager Lambda polls/reads file metadata</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Fan-out Work Manager reads processed file metadata</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Work Manager Lambda triggers Spark EMR cluster</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR writes processed/formatted files to output S3 bucket</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR updates processing status in RDS</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Uploader Lambdas fetch formatted data from S3</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Invokes many concurrent Uploader Lambdas</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">Uploader Lambdas send rate-limited data to partner Ad Networks</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Uploader Lambdas push success/retry status into buffer SQS queue</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Batch Writer Lambda polls status queue</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="11" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Batch updates file processing status in RDS</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Nielsen Marketing Cloud DataOut Architecture</data>
    <data key="d1" />
    <data key="d2">Handles 250 billion events per day using EMR and serverless Lambda functions, with buffer SQS queues for rate-limiting RDS updates.</data>
    <data key="d3">Data Processing &amp; Serverless</data>
    <data key="d4">True</data>
