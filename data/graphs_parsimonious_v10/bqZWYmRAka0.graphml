<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal traders triggering pricing requests</data>
    </node>
    <node id="1">
      <data key="d5">External Data</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External market data ingested into pricing requests</data>
    </node>
    <node id="2">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Routes incoming trader traffic to Pricing Engine</data>
    </node>
    <node id="3">
      <data key="d5">Pricing Engine</data>
      <data key="d6">ECS</data>
      <data key="d7">Orchestrates incoming pricing requests</data>
    </node>
    <node id="4">
      <data key="d5">Pricing Workers (CPU)</data>
      <data key="d6">ECS</data>
      <data key="d7">CPU-bound calculation tasks</data>
    </node>
    <node id="5">
      <data key="d5">Pricing Workers (GPU)</data>
      <data key="d6">ECS</data>
      <data key="d7">GPU-accelerated calculation tasks</data>
    </node>
    <node id="6">
      <data key="d5">Task Queues</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Stores job IDs for pricing tasks</data>
    </node>
    <node id="7">
      <data key="d5">Processing Queues</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Tracks active jobs being processed</data>
    </node>
    <node id="8">
      <data key="d5">Pub/Sub</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Pub/Sub channel for job completion notifications</data>
    </node>
    <node id="9">
      <data key="d5">Payload</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Stores trade payload and computation results</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User triggers request taking in external market data</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">External data sent through ALB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes request to Pricing Engine</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Pricing Engine stores request payload in Redis</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Pricing Engine puts job ID into Task Queue</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">CPU Workers retrieve payload and save results back to Redis</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">GPU Workers retrieve payload and save results back to Redis</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Workers pop job from Task Queue into Processing Queue</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CPU Workers pick up CPU jobs from Task Queue</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">GPU Workers pick up GPU jobs from Task Queue</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DBS Quantitative Pricing Engine Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=bqZWYmRAka0</data>
    <data key="d2">Architecture for high-speed quantitative pricing engine leveraging ECS compute workers and ElastiCache for Redis.</data>
    <data key="d3">Financial Services, High Performance Computing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
