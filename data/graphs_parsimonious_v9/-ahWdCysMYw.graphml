  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS Application Pods</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs tenant application pods.</data>
    </node>
    <node id="1">
      <data key="d5">Postgres Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores per-tenant schemas.</data>
    </node>
    <node id="2">
      <data key="d5">Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Routes data requests between QuickSight and Aurora.</data>
    </node>
    <node id="3">
      <data key="d5">Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Provisions tenant AWS accounts.</data>
    </node>
    <node id="4">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Single-tenant visualization dashboard.</data>
    </node>
    <node id="5">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">Connects on-prem data to QuickSight.</data>
    </node>
    <node id="6">
      <data key="d5">Customer Data</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises database sources.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Pods write/read tenant data.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Aurora serves queries to Transit Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Transit Gateway forwards data to QuickSight.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Control Tower provisions tenant account with QuickSight.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">VPN delivers on-prem data to QuickSight.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">On-prem data sent over VPN connection.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Summit Technology Group Loan Origination System</data>
    <data key="d1">https://www.youtube.com/watch?v=-ahWdCysMYw</data>
    <data key="d2">Multi-tenant SaaS application with single-tenant data consumption via QuickSight and Control Tower.</data>
