  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Public Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Public website visitors</data>
    </node>
    <node id="1">
      <data key="d5">Developer / Newsroom</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal developers and newsroom staff</data>
    </node>
    <node id="2">
      <data key="d5">ECS (Origin Proxy)</data>
      <data key="d6">ECS</data>
      <data key="d7">Handles request routing</data>
    </node>
    <node id="3">
      <data key="d5">Static Resources</data>
      <data key="d6">S3</data>
      <data key="d7">Stores JavaScript, CSS, and static assets</data>
    </node>
    <node id="4">
      <data key="d5">Pre-Render Content</data>
      <data key="d6">S3</data>
      <data key="d7">Stores pre-rendered HTML content</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Site Rendering)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Renders pages dynamically on cache miss</data>
    </node>
    <node id="6">
      <data key="d5">ECS (Content Proxy)</data>
      <data key="d6">ECS</data>
      <data key="d7">Proxies requests to internal/external CMS APIs</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores page templates and configuration</data>
    </node>
    <node id="8">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Caches raw JSON content payloads with TTL</data>
    </node>
    <node id="9">
      <data key="d5">CMS / APIs</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External CMS and third-party content APIs</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Public request to origin</data>
