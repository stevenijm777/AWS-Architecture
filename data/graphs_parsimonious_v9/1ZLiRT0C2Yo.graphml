    <node id="5">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage for application data and assets</data>
    </node>
    <node id="6">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Centralized logging and observability</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Data center traffic routed through Transit Gateway</data>
      <data key="d10">0</data>
