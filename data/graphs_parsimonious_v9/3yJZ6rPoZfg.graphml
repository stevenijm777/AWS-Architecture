    <node id="3">
      <data key="d5">VPC Peering</data>
      <data key="d6">VPCPeering</data>
      <data key="d7">Secure AWS backbone connection between accounts</data>
    </node>
    <node id="4">
      <data key="d5">AWS User Pro EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS cluster running user experience and control containers</data>
    </node>
    <node id="5">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue receiving S3 upload event notifications</data>
