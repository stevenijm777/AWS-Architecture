    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Data received by User Pro EKS</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">EKS container listens to SQS queue message</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
