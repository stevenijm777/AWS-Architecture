    <node id="6">
      <data key="d5">Auto Scaling Group</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">EC2 processing instances scaling dynamically based on workload</data>
    </node>
    <node id="7">
      <data key="d5">User Pro S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket for upload and processed data storage</data>
    </node>
    <edge source="0" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">User uploads file to S3 via pre-signed URL</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Data read from data S3 bucket by Data EKS</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Data routed across VPC Peering</data>
      <data key="d10">2</data>
