<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts the core Sixpack A/B testing engine and API service, as well as Apache Airflow for orchestration.</data>
    </node>
    <node id="1">
      <data key="d5">ElastiCache Redis</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory cache database ensuring low-latency access to active experiment configurations.</data>
    </node>
    <node id="2">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Ingests real-time metrics for immediate visualization and monitoring in Kibana.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake storing raw real-time metrics and final processed experiment results.</data>
    </node>
    <node id="4">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores transactional business and application data utilized during batch analysis.</data>
    </node>
    <node id="5">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs periodic Spark batch jobs to clean, aggregate, and join RDS data with S3 metrics.</data>
    </node>
    <node id="6">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Provides ad-hoc SQL query capability over the refined data stored in S3.</data>
    </node>
    <node id="7">
      <data key="d5">BI Dashboard</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualizes the query results from Athena to measure experiment outcomes.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Reads and updates active experiment session states.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Streams real-time metrics to Elasticsearch for visualization.</data>
      <data key="d10">1a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Streams event metrics directly to S3 for persistent storage.</data>
      <data key="d10">1b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">EMR pulls raw metrics data from S3 for processing.</data>
      <data key="d10">2b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">4</data>
      <data key="d9">Athena queries structured analytics data.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Feeds metadata and operational records to EMR.</data>
      <data key="d10">2a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Saves refined analytics and experiment datasets back to S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Populates A/B test report dashboards.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mesh Korea A/B Testing Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=40dhk6OABJE</data>
    <data key="d2">An A/B testing platform built in 3 weeks to handle up to 10,000 QPS, leveraging EKS, ElastiCache, EMR, and S3.</data>
    <data key="d3">interactive, data_ingestion, compute_intensive</data>
    <data key="d4">True</data>
  </graph>
</graphml>
