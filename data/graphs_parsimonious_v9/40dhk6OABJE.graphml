<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="eks">
      <data key="d0">EKS</data>
      <data key="d1">EKS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elasticache">
      <data key="d0">ElastiCache</data>
      <data key="d1">ElastiCache</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elasticsearch">
      <data key="d0">Elasticsearch</data>
      <data key="d1">Elasticsearch</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="kibana">
      <data key="d0">Kibana</data>
      <data key="d1">Kibana</data>
      <data key="d2">third_party</data>
    </node>
    <node id="airflow">
      <data key="d0">Airflow</data>
      <data key="d1">Airflow</data>
      <data key="d2">third_party</data>
    </node>
    <node id="rds">
      <data key="d0">RDS</data>
      <data key="d1">RDS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="emr">
      <data key="d0">EMR</data>
      <data key="d1">EMR</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="bi_dashboard">
      <data key="d0">ThirdParty</data>
      <data key="d1">BI Dashboard</data>
      <data key="d2">third_party</data>
    </node>
    <node id="athena">
      <data key="d0">Athena</data>
      <data key="d1">Athena</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="elasticache" target="elasticsearch" id="0">
      <data key="d3">logs/metrics</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="elasticache" target="s3" id="0">
      <data key="d3">export</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="rds" target="emr" id="0">
      <data key="d3">data sync</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="emr" target="s3" id="0">
      <data key="d3">write processed data</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="s3" target="athena" id="0">
      <data key="d3">queries</data>
      <data key="d4">reads_from</data>
    </edge>
    <edge source="athena" target="emr" id="0">
      <data key="d3">analytics flow</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
