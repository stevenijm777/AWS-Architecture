<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">NHS Users (N3 / HSCN Network)</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Healthcare and social care clinicians accessing patient records</data>
    </node>
    <node id="1">
      <data key="d5">AWS Direct Connect (DX)</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Secure dedicated connection from N3/HSCN network into AWS</data>
    </node>
    <node id="2">
      <data key="d5">Integration Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Microservice handling incoming clinician search requests</data>
    </node>
    <node id="3">
      <data key="d5">Integration Service RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL RDS storing integration service data</data>
    </node>
    <node id="4">
      <data key="d5">FHIR Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Microservice normalizing medical data into HL7 FHIR format</data>
    </node>
    <node id="5">
      <data key="d5">FHIR Service RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL RDS storing normalized FHIR patient records</data>
    </node>
    <node id="6">
      <data key="d5">Primary Care &amp; Social Care</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Care settings generating unstructured documents (discharge letters, clinic summaries)</data>
    </node>
    <node id="7">
      <data key="d5">AWS Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">Bridges local file systems to cloud storage</data>
    </node>
    <node id="8">
      <data key="d5">S3 Document Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores document content</data>
    </node>
    <node id="9">
      <data key="d5">SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers document arrival notifications</data>
    </node>
    <node id="10">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes document events and triggers Document Service workflow</data>
    </node>
    <node id="11">
      <data key="d5">Document Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Microservice processing document metadata and content retrieval</data>
    </node>
    <node id="12">
      <data key="d5">Document Service RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL RDS storing document metadata</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User request routed through N3 network to Direct Connect</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Direct Connect routes traffic to Integration Service</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Integration service reads/writes state to PostgreSQL RDS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Integration service hands off request to FHIR Service</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">FHIR Service persists normalized data in Postgres RDS</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Primary and Social care systems send documents to Storage Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Storage Gateway mirrors content into S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">New S3 object triggers event message into SQS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS message triggers Lambda processing function</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda initiates business process on Document Service</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">1</data>
      <data key="d9">Document Service writes metadata to PostgreSQL RDS</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Document Service reads/writes document content from S3</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Kainos Healthcare Interoperability Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=4WjXH8Wp0E4</data>
    <data key="d2">Architecture showing processing of both structured clinical FHIR data and unstructured medical documents.</data>
    <data key="d3">Healthcare Interoperability &amp; Microservices</data>
    <data key="d4">True</data>
  </graph>
</graphml>
