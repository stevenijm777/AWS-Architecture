<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Genomic Data (ATCG)</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Initial genomic data stream (hundreds to thousands of samples, hundreds of billions of ATCs and Gs).</data>
    </node>
    <node id="1">
      <data key="d5">Ad-hoc EC2 VMs</data>
      <data key="d6">EC2</data>
      <data key="d7">Used for initial ingestion of raw genomic data.</data>
    </node>
    <node id="2">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">Stores the ingested genomic data, which is then mounted by EKS for processing.</data>
    </node>
    <node id="3">
      <data key="d5">ECR (Container Repository)</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores versioned container images for pipeline execution, enabling reproducible science.</data>
    </node>
    <node id="4">
      <data key="d5">EKS Cluster</data>
      <data key="d6">EKS</data>
      <data key="d7">Scalable Kubernetes cluster for curating genomic data, pulls containers from ECR, mounts FSx, and leverages Auto Scaling for dynamic scaling (zero to hundreds of instances).</data>
    </node>
    <node id="5">
      <data key="d5">DATA LAKE</data>
      <data key="d6">S3</data>
      <data key="d7">An S3-based Data Lake that stores curated genomic data (matrices) for downstream users.</data>
    </node>
    <node id="6">
      <data key="d5">Data Scientists / Biologists</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Downstream users who perform statistical analyses and scientific reasoning over the curated data from the Data Lake.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw genomic data is ingested into ad-hoc EC2 virtual machines.</data>
      <data key="d10">0.0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingested data from EC2 VMs is written to the FSx file system.</data>
      <data key="d10">0.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">The EKS cluster mounts FSx to access the ingested genomic data for curation processes.</data>
      <data key="d10">1.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS pulls versioned container images (representing processing pipelines) from ECR.</data>
      <data key="d10">1.0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS writes the curated genomic data (matrices) as output to the S3-based Data Lake.</data>
      <data key="d10">1.2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Data Scientists and Biologists consume the curated data from the Data Lake for analysis.</data>
      <data key="d10">2.0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Biopharma Genomics Data Processing Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=YOUR_VIDEO_ID</data>
    <data key="d2">Architecture for ingesting, curating, and analyzing genomics data using EC2, FSx, ECR, EKS, and S3 for a data lake. Emphasizes scalability and version control for reproducibility.</data>
    <data key="d3">Genomics, Data Processing, Analytics, Research &amp; Development</data>
    <data key="d4">True</data>
  </graph>
</graphml>
