  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IOT</data>
      <data key="d6">IoTCore</data>
      <data key="d7">Ingests data from farm IoT sensors</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes threshold logic and invokes backend API</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Routes requests to blockchain service</data>
    </node>
    <node id="3">
      <data key="d5">BLOCKCHAIN</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs Hyperledger Fabric smart contracts in containers</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Off-chain database for real-time visualization and queries</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores off-chain data for predictive analytics</data>
    </node>
    <node id="6">
      <data key="d5">SAGEMAKER</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Builds predictive supply chain models</data>
    </node>
    <node id="7">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Sends real-time alerts upon contract events</data>
    </node>
    <node id="8">
      <data key="d5">Users / Drivers</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Receives notifications regarding produce shipment actions</data>
    </node>
    <node id="9">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors EKS cluster metrics and container auto-scaling</data>
    </node>
    <node id="10">
      <data key="d5">KEYS</data>
      <data key="d6">CloudHSM</data>
      <data key="d7">Manages cryptographic keys for blockchain security</data>
    </node>
    <edge source="0" target="1" id="0">
