<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Database</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premise database system (IBM Netezza)</data>
    </node>
    <node id="1">
      <data key="d5">Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">AWS Storage Gateway deployed on-premises</data>
    </node>
    <node id="2">
      <data key="d5">Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">2x 10G Direct Connect link</data>
    </node>
    <node id="3">
      <data key="d5">Landing Zone S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Initial ingestion landing bucket (2 days retention)</data>
    </node>
    <node id="4">
      <data key="d5">Quality Cleansing EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances executing data quality and cleansing scripts</data>
    </node>
    <node id="5">
      <data key="d5">RDS Postgres Metadata</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores metadata, pipeline orchestration, and transformation scripts</data>
    </node>
    <node id="6">
      <data key="d5">Transformation Zone S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Cleansed data bucket (1 day retention)</data>
    </node>
    <node id="7">
      <data key="d5">Transformation EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 nodes transforming data into facts and dimensions</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for analytics and reporting</data>
    </node>
    <node id="9">
      <data key="d5">Publish Zone S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Published data bucket for dashboards (1 year 1 month retention)</data>
    </node>
    <node id="10">
      <data key="d5">Glacier S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term archive storage</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">On-premise DB ingests daily increment to Storage Gateway</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Storage Gateway transfers NFS volumes via Direct Connect</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Data lands in S3 Landing Zone</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Quality cleansing nodes pick up raw data from Landing bucket</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Fetches metadata and cleansing scripts from RDS</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes cleansed data into Transformation S3 bucket</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">RDS returns cleansing rules/scripts</data>
      <data key="d10">6</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">RDS returns transformation logic</data>
      <data key="d10">10</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Transformation nodes fetch cleansed data</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Fetches transformation metadata and scripts from RDS</data>
      <data key="d10">9</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Loads transformed facts and dimensions into Amazon Redshift</data>
      <data key="d10">11</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift Spectrum publishes daily reports into Publish S3 bucket</data>
      <data key="d10">12</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Lifecycle policy transitions data to Glacier after retention period</data>
      <data key="d10">13</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Capgemini Data Ingestion and ETL Pipeline to AWS Redshift</data>
    <data key="d1" />
    <data key="d2">On-premises IBM Netezza data migration and incremental ingestion pipeline using Storage Gateway, Direct Connect, S3, EC2 ETL nodes, RDS metadata store, and Amazon Redshift.</data>
    <data key="d3">Migration &amp; Analytics</data>
    <data key="d4">True</data>
