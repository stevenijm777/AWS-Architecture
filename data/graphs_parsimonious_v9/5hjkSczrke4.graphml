    <edge source="vehicle" target="s3_raw" id="0">
      <data key="d3">REST API</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="s3_raw" target="sqs" id="0">
      <data key="d3">event</data>
      <data key="d4">triggers</data>
    </edge>
