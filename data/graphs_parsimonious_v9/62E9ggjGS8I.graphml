<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal user initiating account request</data>
    </node>
    <node id="1">
      <data key="d5">ITSM</data>
      <data key="d6">ServiceNow</data>
      <data key="d7">IT Service Management tool handling approval workflows</data>
    </node>
    <node id="2">
      <data key="d5">CONTROL TOWER</data>
      <data key="d6">ControlTower</data>
      <data key="d7">AWS Control Tower in Root Account provisioning new AWS accounts</data>
    </node>
    <node id="3">
      <data key="d5">SERVICE CATALOG</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">AWS Service Catalog in Root Account vending networking infrastructure</data>
    </node>
    <node id="4">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">VPC vended into the new account</data>
    </node>
    <node id="5">
      <data key="d5">TRANSIT GATEWAY</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Transit Gateway attachment/instance in Vended Account</data>
    </node>
    <node id="6">
      <data key="d5">TRANSIT GATEWAY</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Core Transit Gateway in central Network Account</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User triggers self-service workflow in ITSM tool</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">ITSM tool kicks off Account Factory in Control Tower upon approval</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions VPC into the vended account</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Transit Gateway attachment connects vended account VPC to central core Transit Gateway</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DISH Network Automated AWS Account Provisioning and Networking Architecture</data>
    <data key="d1" />
    <data key="d2">DISH Network uses ITSM, AWS Control Tower, AWS Service Catalog, VPC, and Transit Gateway to automate self-service AWS account vending and core network connectivity at scale.</data>
    <data key="d3">Automated Provisioning / Multi-Account Management</data>
    <data key="d4">True</data>
  </graph>
</graphml>
