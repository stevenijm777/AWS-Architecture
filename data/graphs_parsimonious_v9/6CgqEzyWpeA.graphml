  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Devices</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Mobile and PC client devices</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles entry, usage plans, and API keys</data>
    </node>
    <node id="2">
      <data key="d5">Frontend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates requests and manages playlist creation</data>
    </node>
    <node id="3">
      <data key="d5">Request SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers rendering instructions</data>
    </node>
    <node id="4">
      <data key="d5">Response SQS Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers rendering job acknowledgments</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Auto Scaling</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Spot instance fleet rendering video jobs</data>
    </node>
    <node id="6">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores rendered video segments</data>
    </node>
    <node id="7">
      <data key="d5">CloudFront CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Delivers video segments to viewers</data>
    </node>
    <node id="8">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers scaling logic periodically</data>
    </node>
    <node id="9">
      <data key="d5">Scaling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Calculates load and adjusts Auto Scaling group</data>
    </node>
    <node id="10">
      <data key="d5">CloudWatch / Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors metrics and captures spot interruption events</data>
    </node>
    <node id="11">
      <data key="d5">Spot Handler Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Drains and detaches interrupted spot instances</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Client sends rendering request</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes to Frontend Lambda</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Frontend Lambda pushes rendering job to SQS</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Frontend Lambda returns playlist URL to client</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 workers pull jobs from SQS request queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Frontend Lambda polls acknowledgment</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 workers send response to SQS queue</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 workers upload video segments to S3</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">EC2 workers push metrics to CloudWatch</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront fetches origin segments from S3</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFront streams segments to client</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Step Functions triggers scaling Lambda</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Scaling Lambda adjusts capacity in Auto Scaling Group</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">4</data>
      <data key="d9">CloudWatch Events triggers spot interruption Lambda</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="11" target="5" id="0">
      <data key="d8">4</data>
      <data key="d9">Spot handler instructs instance to drain and detach</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">SundaySky Rendering as a Service Architecture</data>
    <data key="d1" />
    <data key="d2">Video rendering pipeline using AWS Lambda, SQS, EC2 Auto Scaling, S3, CloudFront, Step Functions, and CloudWatch.</data>
    <data key="d3">Media &amp; Entertainment, Serverless, Compute</data>
    <data key="d4">True</data>
