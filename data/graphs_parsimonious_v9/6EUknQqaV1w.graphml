  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Cloud Event Streams</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Native event streams from cloud providers (e.g. AWS CloudWatch events / Azure activity logs)</data>
    </node>
    <node id="1">
      <data key="d5">COLLECT Kinesis Data Streams</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingests real-time security events</data>
    </node>
    <node id="2">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Primary graph database storing cloud resource topology and configurations</data>
    </node>
    <node id="3">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Provides search, reporting, and analytical aggregation capabilities</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors CPU, memory, and performance metrics for sharding decisions</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores detected security violations and resource configuration history</data>
    </node>
    <node id="6">
      <data key="d5">RULES Kinesis Data Streams</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Buffers incoming resource changes for rule execution pipeline</data>
    </node>
    <node id="7">
      <data key="d5">Notifications (Slack / Email)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External notification integration channels for real-time customer alerts</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Incoming cloud security events</data>
      <data key="d10">1</data>
