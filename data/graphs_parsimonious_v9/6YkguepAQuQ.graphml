<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">An Etion developer initiating code changes and infrastructure template modifications.</data>
    </node>
    <node id="1">
      <data key="d5">CodeCommit Repository</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">Stores application source code and CloudFormation infrastructure templates.</data>
    </node>
    <node id="2">
      <data key="d5">CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Orchestrates the entire CI/CD workflow from commit to deployment.</data>
    </node>
    <node id="3">
      <data key="d5">CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Builds application containers, paying only for the duration of the build.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon ECR Registry</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores the Docker container images built by CodeBuild, ready for deployment.</data>
    </node>
    <node id="5">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Manages the deployment of both application code (via container images) and underlying infrastructure (like ALB, IAM roles) using templates. It supports a three-step process (Change Set, Approve, Execute) and parallel deployments to up to 100 VPCs.</data>
    </node>
    <node id="6">
      <data key="d5">Production VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">The Virtual Private Cloud environment where the application and its infrastructure are deployed.</data>
    </node>
    <node id="7">
      <data key="d5">Elastic Container Service</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs the containerized applications within the VPC.</data>
    </node>
    <node id="8">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Manages roles and permissions required by the application components within the VPC.</data>
    </node>
    <node id="9">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Distributes incoming traffic to the ECS tasks running the application.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer commits application code or infrastructure templates to the CodeCommit repository.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">CodeCommit change triggers the CodePipeline workflow.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">CodePipeline orchestrates the CodeBuild stage, initiating the build process.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CodeBuild pushes the successfully built container image to Amazon ECR.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The availability of the container image in ECR triggers the CloudFormation deployment stage.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFormation provisions and updates resources within the target VPC.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFormation deploys and configures ECS services and task definitions.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFormation creates and manages necessary IAM roles and policies.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudFormation provisions and configures the Application Load Balancer.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Etion Healthcare Analytics CI/CD Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=YOUR_VIDEO_ID</data>
    <data key="d2">This architecture leverages AWS developer tools to create a streamlined, consistent, and governed deployment process for healthcare analytics applications, including parallel deployments to multiple customer VPCs with controlled change sets.</data>
    <data key="d3">CI/CD, Healthcare, Analytics, Containerization, Infrastructure as Code</data>
    <data key="d4">True</data>
  </graph>
</graphml>
