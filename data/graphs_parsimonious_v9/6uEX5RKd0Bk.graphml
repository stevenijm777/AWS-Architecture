<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user">
      <data key="d0">UserConsumerWebMobile</data>
      <data key="d1">User</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="pinpoint">
      <data key="d0">Pinpoint</data>
      <data key="d1">Amazon Pinpoint</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="eks_rest">
      <data key="d0">EKS</data>
      <data key="d1">Amazon EKS REST and WebSocket</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="eks_chat">
      <data key="d0">EKS</data>
      <data key="d1">Amazon EKS Chat and Notifications</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="msk">
      <data key="d0">MSK</data>
      <data key="d1">Amazon MSK</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elasticache">
      <data key="d0">ElastiCache</data>
      <data key="d1">Amazon ElastiCache for Redis</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="aurora">
      <data key="d0">Aurora</data>
      <data key="d1">Amazon Aurora</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">Amazon DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="user" target="eks_rest" id="0">
      <data key="d3">REST/WebSocket</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="pinpoint" target="user" id="0">
      <data key="d3">Notification</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_rest" target="user" id="0">
      <data key="d3">WebSocket response</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_rest" target="eks_chat" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_chat" target="eks_rest" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_chat" target="pinpoint" id="0">
      <data key="d3">Push Notifications</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_chat" target="msk" id="0">
      <data key="d3">Events</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_chat" target="elasticache" id="0">
      <data key="d3">Cache</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_chat" target="aurora" id="0">
      <data key="d3">Read</data>
      <data key="d4">reads_from</data>
    </edge>
    <edge source="eks_chat" target="dynamodb" id="0">
      <data key="d3">Write</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="msk" target="eks_chat" id="0">
      <data key="d3">Stream</data>
