<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Client</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Mobile devices making API requests to the game backend.</data>
    </node>
    <node id="1">
      <data key="d5">Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Distributes incoming application traffic across multiple targets, such as ECS tasks.</data>
    </node>
    <node id="2">
      <data key="d5">ECS Cluster</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs game logic applications within containers, processing player requests and interacting with databases.</data>
    </node>
    <node id="3">
      <data key="d5">Aurora Database</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores persistent player data and game-related information.</data>
    </node>
    <node id="4">
      <data key="d5">ElastiCache Cluster</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Provides in-memory cache for frequently accessed data to improve performance.</data>
    </node>
    <node id="5">
      <data key="d5">Auto Scaling</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Manages the automatic scaling of resources, specifically ECS tasks, in response to demand. Also, emits events for scaling actions related to EC2 as per transcript.</data>
    </node>
    <node id="6">
      <data key="d5">CloudWatch Events</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Detects events from Auto Scaling (e.g., EC2 launch completion) and triggers Lambda functions.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda Function</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invoked by CloudWatch Events to control and adjust ECS task counts via Auto Scaling.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile clients send API requests to the game backend.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes API requests to the ECS cluster for game logic processing.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards the response back to the mobile client.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS applications access player data stored in Aurora.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS applications retrieve and store cached data in ElastiCache.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS sends processed game logic responses back through ALB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Auto Scaling events (e.g., EC2 instance launch completions) are emitted and detected by CloudWatch Events.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Auto Scaling dynamically scales the number of ECS tasks/instances.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch Events triggers a Lambda function in response to Auto Scaling events.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda adjusts the Auto Scaling configuration for ECS tasks to achieve desired scaling.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Akatsuki Mobile Game Backend Architecture for Romancing SaGa Re;univerSe</data>
    <data key="d1">https://www.youtube.com/watch?v=XXXXX (example, specific link not provided)</data>
    <data key="d2">This architecture supports the mobile game 'Romancing SaGa Re;univerSe', handling over 1 million requests per minute and scaling over 700 containers during peak times. A key feature is the integrated auto-scaling of ECS, triggered by EC2 scaling events and managed by CloudWatch Events and Lambda, achieving scale-out within 2 minutes.</data>
    <data key="d3">Mobile Gaming, Backend, Auto Scaling, High Concurrency</data>
    <data key="d4">True</data>
  </graph>
</graphml>
