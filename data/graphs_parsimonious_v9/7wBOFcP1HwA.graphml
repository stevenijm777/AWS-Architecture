      <data key="d1">RDS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda">
      <data key="d0">Lambda</data>
      <data key="d1">LAMBDA</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2">
      <data key="d0">EC2</data>
      <data key="d1">EC2</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="cloudwatch">
      <data key="d0">CloudWatch</data>
      <data key="d1">CLOUDWATCH</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="user" target="cloudfront" id="0">
      <data key="d3">requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudfront" target="alb" id="0">
      <data key="d3">routes traffic</data>
