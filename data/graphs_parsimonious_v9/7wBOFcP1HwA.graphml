<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Customers making requests to the platform, referred to as 'user' in the diagram. Handles approximately 300,000 requests per minute.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Amazon CloudFront Content Delivery Network (CDN) used to serve static content and distribute incoming requests efficiently.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 used for cost-efficient storage of static content, images, 3D images, and videos.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function assisting CloudFront in determining the origin region of traffic and routing requests to appropriate backend APIs (web or mobile).</data>
    </node>
    <node id="4">
      <data key="d5">Load Balancer</data>
      <data key="d6">ELB</data>
      <data key="d7">A group of approximately 60 Load Balancers (Elastic Load Balancing) responsible for distributing incoming requests to either the legacy system or the microservices, ensuring resilience and scalability.</data>
    </node>
    <node id="5">
      <data key="d5">Legacy EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Represents the Legacy System, which is a monolithic application hosted on Amazon EC2 instances. It receives approximately 20% of the traffic from the Load Balancer.</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon Elastic Kubernetes Service (EKS) hosting the microservices architecture. It consists of approximately 250 microservices and over 1400 pods in production, handling more than 80% of the traffic.</data>
    </node>
    <node id="7">
      <data key="d5">Mongo/Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Non-SQL data services such as MongoDB and Apache Kafka, utilized by the microservices for specific functionalities and data storage requirements.</data>
    </node>
    <node id="8">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon Relational Database Service (RDS) used for relational data storage, accessed by both microservices and legacy applications.</data>
    </node>
    <node id="9">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">General Amazon EC2 instances, potentially for backend processing or specific tasks, connected to Lambda and monitored by CloudWatch.</data>
    </node>
    <node id="10">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Amazon CloudWatch used for monitoring the performance and health of EKS, Lambda functions, and EC2 instances, ensuring proper operation and resilience of the architecture.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests (approximately 300,000 per minute) arrive at CloudFront for content delivery.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront retrieves static content (images, videos) from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront delivers static content to the user.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Dynamic requests are forwarded from CloudFront to the Load Balancers.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 serves static content back to CloudFront.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda provides routing logic and information to CloudFront for traffic management.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda potentially interacts with or triggers EC2 instances for specific backend tasks.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="10" id="0">
      <data key="d8">4</data>
      <data key="d9">Lambda functions are monitored by CloudWatch.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Load Balancer routes approximately 20% of dynamic traffic to the Legacy EC2 system.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Load Balancer routes over 80% of dynamic traffic to the EKS microservices system.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Legacy EC2 applications access Amazon RDS for relational data.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">EKS microservices access non-SQL data services like Mongo and Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">EKS microservices access Amazon RDS for relational data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">4</data>
      <data key="d9">EKS instances are monitored by CloudWatch for performance and health.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Data is returned from Mongo/Kafka to EKS microservices.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Data is returned from RDS to EKS microservices.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Data is returned from RDS to Legacy EC2 applications.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">4</data>
      <data key="d9">General EC2 instances are monitored by CloudWatch.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Siera Group Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture for Siera Group's travel platform, managing high request rates (approximately 300,000 requests per minute) with a hybrid approach transitioning from a monolithic legacy system to a microservices architecture on AWS.</data>
    <data key="d3">Web Application, Microservices, Hybrid</data>
    <data key="d4">True</data>
  </graph>
</graphml>
