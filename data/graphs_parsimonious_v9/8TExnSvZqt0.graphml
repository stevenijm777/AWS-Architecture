<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Axiom SL DevOps/Developer</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Axiom SL team uses Terraform, Jenkins, and Ansible for automated deployment and configuration of the application stack.</data>
    </node>
    <node id="1">
      <data key="d5">ECS Cluster</data>
      <data key="d6">ECS</data>
      <data key="d7">Amazon ECS is used for container orchestration of the application stack.</data>
    </node>
    <node id="2">
      <data key="d5">CIS-hardened AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">CIS-hardened images are built through AMI for every environment and client, serving as the base for application deployment.</data>
    </node>
    <node id="3">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">AWS Key Management Service (KMS) provides security standards, likely for data encryption.</data>
    </node>
    <node id="4">
      <data key="d5">SecurityHub</data>
      <data key="d6">SecurityHub</data>
      <data key="d7">AWS Security Hub is used for maintaining security standards and consolidated security findings.</data>
    </node>
    <node id="5">
      <data key="d5">GuardDuty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">Amazon GuardDuty is used for continuous threat detection and monitoring.</data>
    </node>
    <node id="6">
      <data key="d5">AWS Config</data>
      <data key="d6">AWSConfig</data>
      <data key="d7">AWS Config is used to automate security response to incidents by tracking configuration changes.</data>
    </node>
    <node id="7">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Amazon CloudWatch is used for monitoring, logging, and automated security responses.</data>
    </node>
    <node id="8">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">AWS CloudTrail is used for auditing and logging API calls and events for automated security responses.</data>
    </node>
    <node id="9">
      <data key="d5">RDS (OLTP)</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS is used for OLTP (Online Transaction Processing) data workloads within the application stack.</data>
    </node>
    <node id="10">
      <data key="d5">RedShift (OLAP)</data>
      <data key="d6">RedShift</data>
      <data key="d7">Amazon Redshift is used as a data warehouse for OLAP (Online Analytical Processing) to handle extremely large volumes of client data efficiently.</data>
    </node>
    <node id="11">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 is used for warm storage capabilities in conjunction with Redshift Spectrum and provides end-to-end data encryption.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Axiom SL team orchestrates deployments and manages application lifecycle via ECS using tools like Jenkins and Ansible.</data>
      <data key="d10">0.0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Axiom SL team builds CIS-hardened AMIs for the application components.</data>
      <data key="d10">0.1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS deploys and manages application containers that interact with the RDS database.</data>
      <data key="d10">0.2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="9" id="1">
      <data key="d8">1</data>
      <data key="d9">Application running on ECS interacts with RDS for OLTP data operations.</data>
      <data key="d10">1.0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS integrates with KMS for encryption and key management for application data and resources.</data>
      <data key="d10">2.0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS events and configurations are monitored by SecurityHub for security posture management.</data>
      <data key="d10">2.1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS activity is monitored by GuardDuty for anomaly detection and threat identification.</data>
      <data key="d10">2.2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS configuration changes are tracked by AWS Config for compliance and to trigger automated security responses.</data>
      <data key="d10">2.3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">ECS logs and metrics are sent to CloudWatch for operational monitoring and alerting.</data>
      <data key="d10">2.4</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">API calls made by or to ECS are logged by CloudTrail for auditing and security analysis.</data>
      <data key="d10">2.5</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">AMI provides the base image for the application deployed to the application stack, including components that interact with RDS.</data>
      <data key="d10">0.3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">OLTP data from RDS is processed and moved to Redshift for OLAP.</data>
      <data key="d10">1.1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift queries S3 for warm storage capability using Redshift Spectrum.</data>
      <data key="d10">1.2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Data is read from S3 back to Redshift for Spectrum queries, indicating bi-directional data flow.</data>
      <data key="d10">1.3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Axiom SL's ControllerView SaaS Platform</data>
    <data key="d1" />
    <data key="d2">This architecture represents a single-tenant, isolated application stack deployed per environment per client for regulatory risk and reporting. It emphasizes automated deployment, robust security, and efficient data processing for large volumes of client data.</data>
    <data key="d3">SaaS, Financial Services, Regulatory Reporting, Data Analytics, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
