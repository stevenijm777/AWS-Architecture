  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Enterprise Users</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Users with higher compliance and regulatory needs, requiring dedicated data storage and control over encryption keys.</data>
    </node>
    <node id="1">
      <data key="d5">Enterprise CMK</data>
      <data key="d6">KMS</data>
      <data key="d7">Customer-provided KMS Customer Master Key (CMK) provisioned within their own AWS account and shared with Replicon's account.</data>
    </node>
    <node id="2">
      <data key="d5">Dedicated Enterprise Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Dedicated data storage system provisioned for enterprise users, encrypted using their shared Enterprise CMK.</data>
    </node>
    <node id="3">
      <data key="d5">Typical Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Standard users interacting with the shared multi-tenant system.</data>
    </node>
    <node id="4">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">The primary entry point for both typical and enterprise users to access the Replicon application.</data>
    </node>
    <node id="5">
      <data key="d5">Business Logic EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Part of the shared business logic layer, handling incoming requests from API Gateway and coordinating data access.</data>
    </node>
    <node id="6">
      <data key="d5">Business Logic ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Component of the shared business logic layer, working in combination with EC2 and EKS.</data>
    </node>
    <node id="7">
      <data key="d5">Business Logic EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Component of the shared business logic layer, working in combination with EC2 and ECS.</data>
    </node>
    <node id="8">
      <data key="d5">Inter-Infrastructure Intelligence (I3)</data>
      <data key="d6">Fargate</data>
      <data key="d7">A Fargate-based application API responsible for determining the correct data storage system (dedicated or shared Aurora) for each customer request.</data>
    </node>
    <node id="9">
      <data key="d5">I3 DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">The backing store for the I3 Fargate application, containing routing information for customer data.</data>
    </node>
    <node id="10">
      <data key="d5">Shared Multi-tenant Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">The default multi-tenant data storage system for typical users, encrypted with Replicon's platform-provided KMS key.</data>
    </node>
    <node id="11">
      <data key="d5">Replicon's KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Replicon's platform-provided KMS key used for encrypting data at rest in the shared multi-tenant Aurora system.</data>
    </node>
