<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="client_1_bucket">
      <data key="d0">S3</data>
      <data key="d1">Client 1 Bucket</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="client_2_bucket">
      <data key="d0">S3</data>
      <data key="d1">Client 2 Bucket</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="client_n_bucket">
      <data key="d0">S3</data>
      <data key="d1">Client N Bucket</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3_access_logs">
      <data key="d0">S3</data>
      <data key="d1">S3 Access Logs</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_enrichment">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elasticsearch">
      <data key="d0">Elasticsearch</data>
      <data key="d1">Elasticsearch</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="anomaly_detection">
      <data key="d0">Elasticsearch</data>
      <data key="d1">Anomaly Detection</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sns_notifications">
      <data key="d0">SNS</data>
      <data key="d1">SNS</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="client_1_bucket" target="s3_access_logs" id="0">
      <data key="d3">Access logs</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="client_2_bucket" target="s3_access_logs" id="0">
      <data key="d3">Access logs</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="client_n_bucket" target="s3_access_logs" id="0">
      <data key="d3">Access logs</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="s3_access_logs" target="lambda_enrichment" id="0">
      <data key="d3">Log file trigger</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda_enrichment" target="elasticsearch" id="0">
      <data key="d3">Enriched log data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="elasticsearch" target="sns_notifications" id="0">
      <data key="d3">Alerts</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="anomaly_detection" target="elasticsearch" id="0">
      <data key="d3">Anomaly query</data>
      <data key="d4">reads_from</data>
    </edge>
  </graph>
</graphml>
