<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobilewala Service Team</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">The Mobilewala service team receives email notifications from SNS for detected anomalies and investigates further.</data>
    </node>
    <node id="1">
      <data key="d5">Client 1 Data Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">An S3 bucket holding data for Client 1. Access to this bucket generates logs.</data>
    </node>
    <node id="2">
      <data key="d5">Client 2 Data Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">An S3 bucket holding data for Client 2. Access to this bucket generates logs.</data>
    </node>
    <node id="3">
      <data key="d5">Client N Data Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">An S3 bucket holding data for Client N. Access to this bucket generates logs.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Access Logs Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">A dedicated S3 bucket where access logs from all client data buckets are delivered.</data>
    </node>
    <node id="5">
      <data key="d5">Log Processor Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered when new logs land in the S3 Access Logs bucket. It parses log values, extracts fields like client name, maps IP addresses to country IDs, and adds custom fields before inserting data into Elasticsearch.</data>
    </node>
    <node id="6">
      <data key="d5">Anomaly Detector</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Amazon Elasticsearch Service (now OpenSearch Service) is used with its anomaly detection feature. It learns access patterns for each client (filtered by client name) and uses the numeric country ID to detect anomalies. Originally referred to as Amazon Elasticsearch Service in the transcript.</data>
    </node>
    <node id="7">
      <data key="d5">Anomaly Alert Topic</data>
      <data key="d6">SNS</data>
      <data key="d7">Amazon SNS is used to send email notifications to the service team when Elasticsearch detects an anomaly.</data>
    </node>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Access to Client 1's S3 bucket generates access logs that are delivered to the S3 Access Logs bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Access to Client 2's S3 bucket generates access logs that are delivered to the S3 Access Logs bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Access to Client N's S3 bucket generates access logs that are delivered to the S3 Access Logs bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">New access logs landing in the S3 Access Logs bucket trigger the Lambda function.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">The Lambda function processes the logs and inserts the extracted and enhanced data into Elasticsearch.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Upon detecting an anomaly, Elasticsearch triggers an alert via an SNS topic.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS sends email notifications to the Mobilewala service team, alerting them of the detected anomaly.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Mobilewala S3 Access Log Anomaly Detection</data>
    <data key="d1">https://www.youtube.com/watch?v=EXAMPLE</data>
    <data key="d2">This architecture by Mobilewala uses S3 access logs, Lambda, Elasticsearch's anomaly detection feature, and SNS to proactively detect suspicious access patterns to client data stored in S3 buckets. Lambda processes logs to add custom fields like client name and geographic details for effective anomaly detection.</data>
    <data key="d3">Security, Monitoring, Data Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
