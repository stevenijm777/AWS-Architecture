<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="healthcare_in">
      <data key="d0">ThirdParty</data>
      <data key="d1">Healthcare System</data>
      <data key="d2">third_party</data>
    </node>
    <node id="nlb">
      <data key="d0">NLB</data>
      <data key="d1">NLB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="eks">
      <data key="d0">EKS</data>
      <data key="d1">EKS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ecr">
      <data key="d0">ECR</data>
      <data key="d1">ECR</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2_hap">
      <data key="d0">EC2</data>
      <data key="d1">EC2 (HAP)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2_m6g">
      <data key="d0">EC2</data>
      <data key="d1">EC2 (m6g)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ebs">
      <data key="d0">EBS</data>
      <data key="d1">EBS (gp3)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="healthcare_out">
      <data key="d0">ThirdParty</data>
      <data key="d1">Healthcare System</data>
      <data key="d2">third_party</data>
    </node>
    <edge source="healthcare_in" target="nlb" id="0">
      <data key="d3">inbound requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="nlb" target="ec2_hap" id="0">
      <data key="d3">routes traffic</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ecr" target="ec2_m6g" id="0">
      <data key="d3">container image deployment</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2_hap" target="ec2_m6g" id="0">
      <data key="d3">processed data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2_m6g" target="ebs" id="0">
      <data key="d3">persistent storage</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="ec2_m6g" target="healthcare_out" id="0">
      <data key="d3">outbound data</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
