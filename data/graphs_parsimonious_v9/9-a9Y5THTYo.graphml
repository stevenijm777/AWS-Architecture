<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Vitesco Technologies User</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">An internal user at Vitesco Technologies requesting a new AWS account via a self-developed web portal.</data>
    </node>
    <node id="1">
      <data key="d5">Self-developed Web Portal API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives the account creation requests initiated by users through their internal web portal.</data>
    </node>
    <node id="2">
      <data key="d5">Account Vending Machine (AVM)</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the entire account creation process, managing steps from request initiation to blueprint deployment. Referred to as the 'account vending machine' in the transcript.</data>
    </node>
    <node id="3">
      <data key="d5">Account State Database</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores all information describing the target state of the account, including user input and dynamically generated data like VPC CIDA ranges and account IDs. Ensures idempotency of the process.</data>
    </node>
    <node id="4">
      <data key="d5">Control Tower Account Creation</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Responsible for creating the actual AWS accounts. This is currently done via a custom Service Catalog item because Control Tower does not provide an API for this functionality.</data>
    </node>
    <node id="5">
      <data key="d5">New AWS Account</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">The target AWS account provisioned for the Vitesco Technologies user, configured with company blueprints.</data>
    </node>
    <node id="6">
      <data key="d5">Blueprint Deployment</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Deploys various configurations, or 'blueprints', into the newly created AWS account. These blueprints include IAM, security services (e.g., SecurityHub, GuardDuty, AWS Config), and network configurations (e.g., VPC, subnets, Route53, Transit Gateway attachment).</data>
    </node>
    <node id="7">
      <data key="d5">Email Notification Service</data>
      <data key="d6">SES</data>
      <data key="d7">Sends an email notification to the user once the account is fully deployed and configured, providing access instructions and outlining account owner responsibilities.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User submits a request for a new AWS account via a self-developed web portal, which sends the request to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway forwards the account request to the Account Vending Machine (AVM) Step Functions workflow.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">The AVM Step Functions writes the desired target state and metadata of the account to DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">The AVM Step Functions triggers AWS Control Tower (via a custom Service Catalog item) to create the new AWS account.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">After account creation, the AVM Step Functions triggers the Blueprint Deployment Step Functions to apply necessary configurations.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">The AVM Step Functions reads from DynamoDB to ensure idempotency and retrieve current account state during the process.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">AWS Control Tower provisions the new AWS account.</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">The Blueprint Deployment Step Functions applies various configurations (IAM, security, network blueprints) to the newly provisioned AWS Account.</data>
      <data key="d10">7</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Once all blueprints are deployed, the Blueprint Deployment Step Functions sends a notification via SES.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">The user receives an email notification confirming the new AWS account is ready, along with access details and responsibilities.</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Vitesco Technologies Cloud Foundation Account Vending Machine</data>
    <data key="d1">https://www.youtube.com/watch?v=EXAMPLE_LINK</data>
    <data key="d2">This architecture depicts Vitesco Technologies' Cloud Foundation, an end-to-end automated cloud landing zone. It enables internal users to quickly create AWS accounts that are configured according to company standards and AWS best practices. The diagram focuses on the initial account provisioning and blueprint deployment process.</data>
    <data key="d3">Account Management, Governance, Automation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
