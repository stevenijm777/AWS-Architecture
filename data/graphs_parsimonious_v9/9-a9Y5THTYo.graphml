<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user">
      <data key="d0">UserCompanyDeveloper</data>
      <data key="d1">User</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="api_gateway">
      <data key="d0">API Gateway</data>
      <data key="d1">API Gateway</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="step_functions_avm">
      <data key="d0">Step Functions</data>
      <data key="d1">Step Functions (AVM)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="control_tower">
      <data key="d0">Control Tower</data>
      <data key="d1">Control Tower</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="step_functions_blueprint">
      <data key="d0">Step Functions</data>
      <data key="d1">Step Functions (Blue Print)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="aws_account">
      <data key="d0">AWS Account</data>
      <data key="d1">AWS Account</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="email">
      <data key="d0">Email</data>
      <data key="d1">E-Mail</data>
      <data key="d2">third_party</data>
    </node>
    <edge source="user" target="api_gateway" id="0">
      <data key="d3">requests account</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="api_gateway" target="step_functions_avm" id="0">
      <data key="d3">triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="step_functions_avm" target="dynamodb" id="0">
      <data key="d3">stores metadata</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="step_functions_avm" target="control_tower" id="0">
      <data key="d3">provisions account</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="step_functions_avm" target="step_functions_blueprint" id="0">
      <data key="d3">invokes blueprint</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="step_functions_blueprint" target="aws_account" id="0">
      <data key="d3">configures account</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="step_functions_blueprint" target="email" id="0">
      <data key="d3">sends notification</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="email" target="user" id="0">
      <data key="d3">notifies user</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
