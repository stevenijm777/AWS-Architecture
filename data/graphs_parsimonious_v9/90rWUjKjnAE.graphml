      <data key="d1">EFS</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="developer" target="git" id="0">
      <data key="d3">pushes code</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="git" target="lagoon_eks" id="0">
      <data key="d3">triggers build</data>
      <data key="d4">triggers</data>
