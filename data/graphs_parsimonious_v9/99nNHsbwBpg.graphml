<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Skyscanner Users</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">External users of Skyscanner, generating 60,000 to 70,000 queries per second at peak. Represents the inbound traffic to the Kubernetes cluster.</data>
    </node>
    <node id="1">
      <data key="d5">KBS Cluster Autoscaler</data>
      <data key="d6">EC2</data>
      <data key="d7">A custom application (Kubernetes Cluster Autoscaler) running on an EC2 instance, responsible for manipulating the desired count of EC2 instances within the Auto Scaling Groups. It processes instance metadata for termination notices and coordinates node draining.</data>
    </node>
    <node id="2">
      <data key="d5">Kubernetes Node ASG 1</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">An Auto Scaling Group for Kubernetes worker nodes. It spans multiple Availability Zones and provides diversification of instance types (e.g., C3s, C4s, C5s, M4s, R3s) to enhance resilience when running 100% on Spot Instances.</data>
    </node>
    <node id="3">
      <data key="d5">Kubernetes Node ASG 2</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">A second Auto Scaling Group for Kubernetes worker nodes, further contributing to the diversification of instance types and Spot capacity pools for increased stability and cost savings.</data>
    </node>
    <node id="4">
      <data key="d5">Kubernetes Worker Nodes</data>
      <data key="d6">EC2</data>
      <data key="d7">A fleet of 120-130 EC2 Spot Instances (e.g., C5, C4, M5, C8X, C9X class types) distributed across multiple Availability Zones. These instances host the Kubernetes pods and services. One instance is visually marked for termination, illustrating the Spot termination handling.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Inbound user queries and traffic enter the Kubernetes cluster, as depicted by the visual arrow pointing to the 'KBS CA' node (acknowledging that typical data flow would involve a Load Balancer to worker nodes directly).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">The Kubernetes Cluster Autoscaler manipulates the desired count of EC2 instances within Auto Scaling Group 1.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The Kubernetes Cluster Autoscaler manipulates the desired count of EC2 instances within Auto Scaling Group 2.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Auto Scaling Group 1 provisions, manages, and scales the EC2 Spot instances that serve as Kubernetes worker nodes.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Auto Scaling Group 2 provisions, manages, and scales the EC2 Spot instances that serve as Kubernetes worker nodes.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 instances periodically provide metadata (including Spot termination notices) to a script, which in turn informs the Kubernetes Cluster Autoscaler for proactive node management.</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Skyscanner Kubernetes Cluster on EC2 Spot Instances</data>
    <data key="d1" />
    <data key="d2">Skyscanner's production Kubernetes clusters running 100% on EC2 Spot Instances across multiple regions and Availability Zones. The architecture leverages diversified Auto Scaling Groups and a custom Kubernetes Cluster Autoscaler to handle spot instance terminations and manage the desired node count effectively for high-scale, cost-optimized operations.</data>
    <data key="d3">Compute, Container, Management, Cost Optimization</data>
    <data key="d4">True</data>
  </graph>
</graphml>
