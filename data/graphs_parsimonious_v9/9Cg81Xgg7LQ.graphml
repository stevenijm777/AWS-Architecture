<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="giving">
      <data key="d0">EC2</data>
      <data key="d1">Giving (.NET)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="apps">
      <data key="d0">EC2</data>
      <data key="d1">Apps (Node)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ecs">
      <data key="d0">ECS</data>
      <data key="d1">ECS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="kinesis">
      <data key="d0">Kinesis</data>
      <data key="d1">Kinesis</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="xray">
      <data key="d0">X-Ray</data>
      <data key="d1">X-Ray</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sql_server">
      <data key="d0">SQL Server</data>
      <data key="d1">SQL Server</data>
      <data key="d2">third_party</data>
    </node>
    <edge source="giving" target="ecs" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="apps" target="ecs" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ecs" target="dynamodb" id="0">
      <data key="d3" />
      <data key="d4">writes_to</data>
    </edge>
    <edge source="ecs" target="kinesis" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kinesis" target="giving" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
