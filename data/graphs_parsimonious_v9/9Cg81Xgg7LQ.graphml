<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Giving Platform Monolith (.NET)</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">The existing .NET monolith application, part of Pushpay's giving platform, which is being decomposed and now interacts with the new Identity Service.</data>
    </node>
    <node id="1">
      <data key="d5">SQL Server</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">The relational database used by the existing Giving Platform monolith.</data>
    </node>
    <node id="2">
      <data key="d5">Apps Platform (Node)</data>
      <data key="d6">UserCompanyInternalPlatform</data>
      <data key="d7">An existing application platform, described as 'Node', which now integrates with the new Identity Service for user sign-in and sign-up functionality.</data>
    </node>
    <node id="3">
      <data key="d5">Identity Service</data>
      <data key="d6">ECS</data>
      <data key="d7">The new .NET Core microservice, running in containers on Alpine Linux within ECS, responsible for user identity functions like sign-in, sign-up, and profile management, exposed via a GraphQL API.</data>
    </node>
    <node id="4">
      <data key="d5">Identity Service Data Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">A NoSQL database used by the Identity Service to store user events and profile information as part of an event sourcing architecture.</data>
    </node>
    <node id="5">
      <data key="d5">Event Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">A Kinesis Data Stream that receives events from DynamoDB for distribution to other microservices (e.g., fraud detection) and for feeding back into the monolith to ensure data synchronization.</data>
    </node>
    <node id="6">
      <data key="d5">Distributed Tracing</data>
      <data key="d6">XRay</data>
      <data key="d7">An observability service adopted to provide insights and trace requests flowing through the distributed system, especially the new microservices.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The Giving Platform monolith makes requests to the new Identity Service via its GraphQL API for user management.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">The Giving Platform monolith interacts with its SQL Server database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The Apps Platform makes requests to the new Identity Service via its GraphQL API for user management (e.g., sign-up, sign-in).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">The Identity Service stores events generated by user actions (e.g., sign-in events) into DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">4</data>
      <data key="d9">The Identity Service sends tracing data and operational insights to X-Ray for monitoring and debugging distributed requests.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Events from DynamoDB are published to the Kinesis Data Stream for further processing and distribution.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">3</data>
      <data key="d9">Events from the Kinesis Data Stream are fed back into the Giving Platform monolith to synchronize user information and ensure consistency.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Pushpay's Monolith Decomposition into Microservices</data>
    <data key="d1">https://www.youtube.com/watch?v=EXAMPLE_VIDEO_ID</data>
    <data key="d2">Architecture showing Pushpay's decomposition of a .NET monolith into microservices using ECS, DynamoDB, and Kinesis, with X-Ray for observability and an event sourcing pattern.</data>
    <data key="d3">SaaS,Microservices,Event-Driven,DotNet</data>
    <data key="d4">True</data>
  </graph>
</graphml>
