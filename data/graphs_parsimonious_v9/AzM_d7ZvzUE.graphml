  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client Lambda Function</data>
      <data key="d6">Lambda</data>
      <data key="d7">Customer's Lambda function producing CloudWatch logs</data>
    </node>
    <node id="1">
      <data key="d5">Logs Kinesis Data Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingests streamed CloudWatch log chunks from customer accounts</data>
    </node>
    <node id="2">
      <data key="d5">Transform Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Transforms log chunks into normalized invocation records</data>
    </node>
    <node id="3">
      <data key="d5">Customer Metadata DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores customer configuration, limits, and partial invocation state</data>
    </node>
    <node id="4">
      <data key="d5">Invocation Records Stream</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Central stream for clean invocation records</data>
    </node>
    <node id="5">
      <data key="d5">Aurora Writer Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Writes invocation records to Aurora with controlled concurrency</data>
    </node>
    <node id="6">
      <data key="d5">Serverless Aurora Database</data>
      <data key="d6">Aurora</data>
      <data key="d7">Fast query storage for individual invocation lookups</data>
    </node>
    <node id="7">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Batches records and performs Parquet format conversion</data>
    </node>
    <node id="8">
      <data key="d5">AWS Glue Schema Catalog</data>
      <data key="d6">Glue</data>
      <data key="d7">Defines Data Lake schema for Parquet conversion in Firehose</data>
    </node>
    <node id="9">
      <data key="d5">S3 Data Lake Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores formatted invocation Parquet files for analytics</data>
    </node>
    <node id="10">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Queries aggregated metrics over S3 data lake</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudWatch logs streamed into Kinesis</data>
