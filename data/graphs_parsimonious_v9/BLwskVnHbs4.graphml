<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="codecommit">
      <data key="d0">CodeCommit</data>
      <data key="d1">CODECOMMIT</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="codepipeline">
      <data key="d0">CodePipeline</data>
      <data key="d1">CODEPIPELINE</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="cloudformation">
      <data key="d0">CloudFormation</data>
      <data key="d1">CLOUDFORMATION</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="iam">
      <data key="d0">IAM</data>
      <data key="d1">IAM</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="network">
      <data key="d0">VPC</data>
      <data key="d1">NETWORK</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="database">
      <data key="d0">RDS</data>
      <data key="d1">DATABASE</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="compute">
      <data key="d0">EC2</data>
      <data key="d1">COMPUTE</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="edge">
      <data key="d0">CloudFront</data>
      <data key="d1">EDGE</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="codecommit" target="codepipeline" id="0">
      <data key="d3" />
      <data key="d4">triggers</data>
    </edge>
    <edge source="codepipeline" target="cloudformation" id="0">
      <data key="d3" />
      <data key="d4">triggers</data>
    </edge>
    <edge source="cloudformation" target="network" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudformation" target="database" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudformation" target="compute" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudformation" target="edge" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="iam" target="cloudformation" id="0">
      <data key="d3" />
      <data key="d4">authenticates</data>
    </edge>
  </graph>
</graphml>
