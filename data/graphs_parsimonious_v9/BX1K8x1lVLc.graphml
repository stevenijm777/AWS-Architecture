    </node>
    <node id="aurora">
      <data key="d0">Aurora</data>
      <data key="d1">Aurora</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elasticache">
      <data key="d0">ElastiCache</data>
      <data key="d1">ElastiCache</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="users" target="cloudfront" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudfront" target="s3" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudfront" target="ec2" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2" target="eks" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks" target="ecr" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks" target="aurora" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks" target="elasticache" id="0">
      <data key="d3" />
