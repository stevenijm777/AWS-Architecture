<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="alb">
      <data key="d0">ALB</data>
      <data key="d1">ALB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ecs_user_item">
      <data key="d0">ECS</data>
      <data key="d1">User-Item ECS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2_user_item">
      <data key="d0">EC2</data>
      <data key="d1">User-Item EC2</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ecs_cart_item">
      <data key="d0">ECS</data>
      <data key="d1">Cart-Item ECS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2_cart_item">
      <data key="d0">EC2</data>
      <data key="d1">Cart-Item EC2</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="cloudwatch_schedule">
      <data key="d0">CloudWatch</data>
      <data key="d1">CloudWatch Schedule</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="alb" target="ecs_user_item" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="alb" target="ecs_cart_item" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ecs_user_item" target="dynamodb" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="dynamodb" target="ecs_user_item" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="dynamodb" target="ec2_user_item" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2_user_item" target="dynamodb" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="s3" target="ecs_cart_item" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2_cart_item" target="s3" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2_cart_item" target="ecs_cart_item" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudwatch_schedule" target="ec2_user_item" id="0">
      <data key="d3" />
      <data key="d4">triggers</data>
    </edge>
  </graph>
</graphml>
