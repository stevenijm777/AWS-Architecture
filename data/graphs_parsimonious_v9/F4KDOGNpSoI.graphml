  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">End users scanning QR codes or NFC tags on bottles</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Global CDN entry point for short URL requests</data>
    </node>
    <node id="2">
      <data key="d5">Lambda@Edge</data>
      <data key="d6">LambdaAtEdge</data>
      <data key="d7">Processes incoming requests globally at edge locations</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Global table storing short URL mappings</data>
    </node>
    <node id="4">
      <data key="d5">CloudFront Logs S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw access logs from CloudFront</data>
    </node>
    <node id="5">
      <data key="d5">Log Processor Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Enriches access logs with IP location and user agent data</data>
    </node>
    <node id="6">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams enriched log data to storage</data>
    </node>
    <node id="7">
      <data key="d5">Analytics S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores transformed logs for querying</data>
    </node>
    <node id="8">
      <data key="d5">Admin Users</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal contributors managing short URLs and analytics</data>
    </node>
    <node id="9">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">REST API interface for admin management</data>
    </node>
    <node id="10">
      <data key="d5">Admin Backend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles user permissions, URL transformations, and queries</data>
    </node>
    <node id="11">
      <data key="d5">Amazon Aurora RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores user permissions and application metadata</data>
    </node>
    <node id="12">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Executes interactive queries on transformed log data</data>
    </node>
    <node id="13">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Optimizes files in S3 for Athena query performance</data>
    </node>
