<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="cloudformation">
      <data key="d0">CloudFormation</data>
      <data key="d1">CloudFormation</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="aws_sar">
      <data key="d0">Serverless Application Repository</data>
      <data key="d1">AWS SAR</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="web_mobile_client">
      <data key="d0">UserConsumerWebMobile</data>
      <data key="d1">Web/Mobile Client</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="cognito">
      <data key="d0">Cognito</data>
      <data key="d1">Cognito</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="api_gw">
      <data key="d0">API Gateway</data>
      <data key="d1">API GW</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="iot_core">
      <data key="d0">IoT Core</data>
      <data key="d1">IoT Core</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="greengrass">
      <data key="d0">IoT Greengrass</data>
      <data key="d1">Greengrass</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="web_mobile_client" target="cognito" id="0">
      <data key="d3">authenticates</data>
      <data key="d4">authenticates</data>
    </edge>
    <edge source="web_mobile_client" target="api_gw" id="0">
      <data key="d3">API requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="web_mobile_client" target="iot_core" id="0">
      <data key="d3">data flow</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="iot_core" target="dynamodb" id="0">
      <data key="d3">writes data</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="greengrass" target="iot_core" id="0">
      <data key="d3">data flow</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
