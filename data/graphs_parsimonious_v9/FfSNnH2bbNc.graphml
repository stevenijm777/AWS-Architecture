<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="satellite">
      <data key="d0">ThirdParty</data>
      <data key="d1">Satellite</data>
      <data key="d2">third_party</data>
    </node>
    <node id="ec2_spot">
      <data key="d0">EC2</data>
      <data key="d1">EC2 Spot</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="rds">
      <data key="d0">RDS</data>
      <data key="d1">RDS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elasticache">
      <data key="d0">ElastiCache</data>
      <data key="d1">ElastiCache</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="fargate">
      <data key="d0">Fargate</data>
      <data key="d1">AWS Fargate</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="users">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">Users</data>
      <data key="d2">user_actor</data>
    </node>
    <edge source="satellite" target="ec2_spot" id="0">
      <data key="d3">data stream</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2_spot" target="s3" id="0">
      <data key="d3">store data</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="ec2_spot" target="rds" id="0">
      <data key="d3">store metadata</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="s3" target="fargate" id="0">
      <data key="d3">read/write data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="rds" target="fargate" id="0">
      <data key="d3">metadata query</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="rds" target="lambda" id="0">
      <data key="d3">query metadata</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate" target="elasticache" id="0">
      <data key="d3">cache data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="users" target="fargate" id="0">
      <data key="d3">web traffic</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="users" target="lambda" id="0">
      <data key="d3">api request</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
