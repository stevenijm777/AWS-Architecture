<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="developers">
      <data key="d0">UserCompanyDeveloper</data>
      <data key="d1">Developers</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="dc">
      <data key="d0">OnPremDC</data>
      <data key="d1">Data Center</data>
      <data key="d2">on_prem</data>
    </node>
    <node id="gitlab">
      <data key="d0">GitLab</data>
      <data key="d1">GitLab</data>
      <data key="d2">third_party</data>
    </node>
    <node id="jenkins">
      <data key="d0">Jenkins</data>
      <data key="d1">Jenkins</data>
      <data key="d2">third_party</data>
    </node>
    <node id="onprem_nodes">
      <data key="d0">OnPremDC</data>
      <data key="d1">Windows / Linux / macOS</data>
      <data key="d2">on_prem</data>
    </node>
    <node id="vpn">
      <data key="d0">VPN Connection</data>
      <data key="d1">VPN Connection</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="vpc">
      <data key="d0">VPC</data>
      <data key="d1">Amazon VPC</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2_api">
      <data key="d0">EC2</data>
      <data key="d1">EC2 API</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="spot_instances">
      <data key="d0">EC2</data>
      <data key="d1">Spot Instances</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="developers" target="gitlab" id="0">
      <data key="d3">Merge Requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="dc" target="vpn" id="0">
      <data key="d3">Direct connection</data>
      <data key="d4">network</data>
    </edge>
    <edge source="gitlab" target="jenkins" id="0">
      <data key="d3">Triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="jenkins" target="onprem_nodes" id="0">
      <data key="d3">Build jobs</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="vpn" target="vpc" id="0">
      <data key="d3" />
      <data key="d4">network</data>
    </edge>
    <edge source="vpc" target="ec2_api" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2_api" target="spot_instances" id="0">
      <data key="d3">Provisions</data>
      <data key="d4">triggers</data>
    </edge>
  </graph>
</graphml>
