<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="internet_gw">
      <data key="d0">Internet Gateway</data>
      <data key="d1">INTERNET GW</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sqs">
      <data key="d0">SQS</data>
      <data key="d1">SQS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sns">
      <data key="d0">SNS</data>
      <data key="d1">SNS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="vpc_endpoints">
      <data key="d0">VPC Endpoints</data>
      <data key="d1">VPC ENDPOINTS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="transit_gw">
      <data key="d0">Transit Gateway</data>
      <data key="d1">TRANSIT GW</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="vpn">
      <data key="d0">VPN</data>
      <data key="d1">VPN</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="router">
      <data key="d0">Router</data>
      <data key="d1">ROUTER</data>
      <data key="d2">on_prem</data>
    </node>
    <node id="organizations">
      <data key="d0">Organizations</data>
      <data key="d1">ORGANIZATIONS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="scps">
      <data key="d0">Organizations</data>
      <data key="d1">SCPs</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="config">
      <data key="d0">Config</data>
      <data key="d1">CONFIG</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="guardduty">
      <data key="d0">GuardDuty</data>
      <data key="d1">GUARDDUTY</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="security_hub">
      <data key="d0">Security Hub</data>
      <data key="d1">SECURITY HUB</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="internet_gw" target="s3" id="0">
      <data key="d3">public traffic</data>
      <data key="d4">network</data>
    </edge>
    <edge source="s3" target="vpc_endpoints" id="0">
      <data key="d3">private access</data>
      <data key="d4">network</data>
    </edge>
    <edge source="sqs" target="vpc_endpoints" id="0">
      <data key="d3">private access</data>
      <data key="d4">network</data>
    </edge>
    <edge source="sns" target="vpc_endpoints" id="0">
      <data key="d3">private access</data>
      <data key="d4">network</data>
    </edge>
    <edge source="vpc_endpoints" target="transit_gw" id="0">
      <data key="d3">routing</data>
      <data key="d4">network</data>
    </edge>
    <edge source="transit_gw" target="vpn" id="0">
      <data key="d3">peering</data>
      <data key="d4">network</data>
    </edge>
    <edge source="vpn" target="router" id="0">
      <data key="d3">ipsec tunnel</data>
      <data key="d4">network</data>
    </edge>
    <edge source="organizations" target="scps" id="0">
      <data key="d3">policy enforcement</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="organizations" target="config" id="0">
      <data key="d3">governance</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="config" target="security_hub" id="0">
      <data key="d3">compliance findings</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="guardduty" target="security_hub" id="0">
      <data key="d3">threat findings</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
