<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="datalake">
      <data key="d0">S3</data>
      <data key="d1">Data Lake</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2_neo4j">
      <data key="d0">EC2</data>
      <data key="d1">EC2 (Neo4j)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="fargate_producer">
      <data key="d0">Fargate</data>
      <data key="d1">Fargate</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="msk">
      <data key="d0">MSK</data>
      <data key="d1">MSK</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="fargate_consumer">
      <data key="d0">Fargate</data>
      <data key="d1">Fargate</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="opensearch">
      <data key="d0">OpenSearch</data>
      <data key="d1">OpenSearch</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="http_sink">
      <data key="d0">ThirdParty</data>
      <data key="d1">HTTP Sink</data>
      <data key="d2">third_party</data>
    </node>
    <node id="crm">
      <data key="d0">ThirdParty</data>
      <data key="d1">CRM</data>
      <data key="d2">third_party</data>
    </node>
    <edge source="datalake" target="msk" id="0">
      <data key="d3">data stream</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2_neo4j" target="msk" id="0">
      <data key="d3">graph data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate_producer" target="msk" id="0">
      <data key="d3">events</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="msk" target="fargate_consumer" id="0">
      <data key="d3">consume records</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="msk" target="lambda" id="0">
      <data key="d3">trigger</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="fargate_consumer" target="opensearch" id="0">
      <data key="d3">index data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda" target="http_sink" id="0">
      <data key="d3">http POST</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="http_sink" target="crm" id="0">
      <data key="d3">sync</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
