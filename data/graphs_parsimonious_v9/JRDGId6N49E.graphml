  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Used to share infrastructure patterns and catalog software</data>
    </node>
    <node id="1">
      <data key="d5">AWS CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Provisions compute resources across regions</data>
    </node>
    <node id="2">
      <data key="d5">EC2 Placement Group (Region 1)</data>
      <data key="d6">EC2</data>
      <data key="d7">P3 compute instances for ML training</data>
    </node>
    <node id="3">
      <data key="d5">FSx for Lustre</data>
      <data key="d6">FSX</data>
      <data key="d7">High performance file system attached to EC2</data>
    </node>
    <node id="4">
      <data key="d5">S3 Bucket (Region 1)</data>
      <data key="d6">S3</data>
      <data key="d7">Primary training data bucket</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Cluster (Region 2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Secondary compute cluster provisioned on demand</data>
    </node>
    <node id="6">
      <data key="d5">S3 Bucket (Region 2)</data>
      <data key="d6">S3</data>
      <data key="d7">Replicated training data bucket</data>
    </node>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Spins up cluster in Region 2 when Region 1 capacity is full</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">3</data>
      <data key="d9">Provides high performance storage access to training instances</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 Cross-Region Replication</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">TRI Machine Learning Cluster Architecture</data>
    <data key="d1" />
    <data key="d2">Architecture for ML model training with multi-region failover and high-performance storage.</data>
    <data key="d3">Machine Learning Multi-Region Infrastructure</data>
    <data key="d4">True</data>
