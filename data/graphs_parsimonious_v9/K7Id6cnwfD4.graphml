<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="pharmacists">
      <data key="d0">UserCompanyAgent</data>
      <data key="d1">Pharmacists</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="payers">
      <data key="d0">UserPartnerEnterprise</data>
      <data key="d1">Payers</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="pharmacist_portal">
      <data key="d0">ThirdParty</data>
      <data key="d1">Pharmacist Portal App</data>
      <data key="d2">third_party</data>
    </node>
    <node id="eks">
      <data key="d0">EKS</data>
      <data key="d1">Amazon Elastic Kubernetes Service (EKS)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="cognito">
      <data key="d0">Cognito</data>
      <data key="d1">Amazon Cognito</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="memorydb">
      <data key="d0">MemoryDB</data>
      <data key="d1">Amazon MemoryDB for Redis</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="msk">
      <data key="d0">MSK</data>
      <data key="d1">Amazon Managed Streaming for Apache Kafka (MSK)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="quicksight">
      <data key="d0">QuickSight</data>
      <data key="d1">Amazon QuickSight</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="aurora">
      <data key="d0">Aurora</data>
      <data key="d1">Amazon Aurora</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="pharmacists" target="pharmacist_portal" id="0">
      <data key="d3">accesses</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="payers" target="msk" id="0">
      <data key="d3">streams data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="pharmacist_portal" target="eks" id="0">
      <data key="d3">LAUNCH</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="pharmacist_portal" target="eks" id="1">
      <data key="d3">ALERT</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks" target="cognito" id="0">
      <data key="d3">authenticates</data>
      <data key="d4">authenticates</data>
    </edge>
    <edge source="eks" target="memorydb" id="0">
      <data key="d3">FETCH</data>
      <data key="d4">reads_from</data>
    </edge>
    <edge source="msk" target="eks" id="0">
      <data key="d3">streams to</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
