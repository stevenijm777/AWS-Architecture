      <data key="d5">Fanout SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues messages for talent platform consumption</data>
    </node>
    <node id="8">
      <data key="d5">ECS Containers</data>
      <data key="d6">ECS</data>
      <data key="d7">Serves backend data for talent platform</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Partner endpoints fetched by ingestion Lambda</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
