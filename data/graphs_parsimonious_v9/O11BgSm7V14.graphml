    <node id="5">
      <data key="d5">ML Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Enriches and categorizes lean job data using ML/NLP models</data>
    </node>
    <node id="6">
      <data key="d5">SNS Topic</data>
      <data key="d6">SNS</data>
      <data key="d7">Fans out job notifications</data>
