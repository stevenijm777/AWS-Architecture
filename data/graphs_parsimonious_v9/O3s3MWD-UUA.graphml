<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user">
      <data key="d0">UserConsumerWebMobile</data>
      <data key="d1">User</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="payment_schemes">
      <data key="d0">ThirdParty</data>
      <data key="d1">Payment schemes</data>
      <data key="d2">third_party</data>
    </node>
    <node id="waf">
      <data key="d0">WAF</data>
      <data key="d1">AWS WAF</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="alb">
      <data key="d0">ALB</data>
      <data key="d1">Application Load Balancer</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="direct_connect">
      <data key="d0">Direct Connect</data>
      <data key="d1">AWS Direct Connect</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="eks">
      <data key="d0">EKS</data>
      <data key="d1">Amazon Elastic Kubernetes Service (Amazon EKS)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="nitro_enclaves">
      <data key="d0">Nitro Enclaves</data>
      <data key="d1">AWS Nitro Enclaves</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ledger_service">
      <data key="d0">EKS</data>
      <data key="d1">Ledger Service</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="account_service">
      <data key="d0">EKS</data>
      <data key="d1">Account Service</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="cards_service">
      <data key="d0">EKS</data>
      <data key="d1">Cards Service</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="tokenization_service">
      <data key="d0">Nitro Enclaves</data>
      <data key="d1">Tokenization Service</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="keyspaces">
      <data key="d0">Keyspaces</data>
      <data key="d1">Amazon Keyspaces (for Apache Cassandra)</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="user" target="payment_schemes" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="payment_schemes" target="direct_connect" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="direct_connect" target="ledger_service" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ledger_service" target="direct_connect" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="account_service" target="keyspaces" id="0">
      <data key="d3" />
      <data key="d4">writes_to</data>
    </edge>
    <edge source="cards_service" target="keyspaces" id="0">
      <data key="d3" />
      <data key="d4">writes_to</data>
    </edge>
  </graph>
</graphml>
