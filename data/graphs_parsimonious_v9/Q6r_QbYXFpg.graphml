<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Console / S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts the frontend administration console UI</data>
    </node>
    <node id="1">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles SAML authentication flow for end users</data>
    </node>
    <node id="2">
      <data key="d5">SAML IdP</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Customer identity provider for SAML authentication</data>
    </node>
    <node id="3">
      <data key="d5">Customer Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Deployed in customer environment to sync users and groups</data>
    </node>
    <node id="4">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes API endpoints for receiving directory information</data>
    </node>
    <node id="5">
      <data key="d5">Backend CRUD &amp; Automation Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes CRUD operations for DB and determines workspace delta jobs</data>
    </node>
    <node id="6">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores platform data, business logic, user/group mappings</data>
    </node>
    <node id="7">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues provisioning and modification tasks</data>
    </node>
    <node id="8">
      <data key="d5">Trigger Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invoked by SQS to trigger AWS Step Functions execution</data>
    </node>
    <node id="9">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates workspace provisioning workflows and handles wait states</data>
    </node>
    <node id="10">
      <data key="d5">Workspaces</data>
      <data key="d6">WorkSpaces</data>
      <data key="d7">Target WorkSpaces instances provisioned inside customer AWS account</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Redirects to customer SAML IdP for authentication</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Returns SAML assertion to Cognito</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Customer Lambda pushes user/group directory data via API Gateway</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway forwards directory payload to central backend Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Backend Lambda executes CRUD operations on RDS database</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Backend Lambda places required provisioning jobs into SQS queue</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">SQS triggers Lambda execution</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda starts Step Functions state machine execution</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Step Functions orchestrates creation/modification of Amazon WorkSpaces</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Synchronet - Automated Amazon WorkSpaces Provisioning Platform</data>
    <data key="d1" />
    <data key="d2">Architectural overview of Synchronet's platform for automated Amazon WorkSpaces provisioning and user management across multi-tenant/customer environments.</data>
    <data key="d3">End User Computing, Automation, Serverless Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
