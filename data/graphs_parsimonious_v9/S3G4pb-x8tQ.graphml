<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user_clients">
      <data key="d0">UserConsumerWebMobile</data>
      <data key="d1">Users / Clients</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">Amazon S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_etl">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda ETL</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="api_gateway">
      <data key="d0">API Gateway</data>
      <data key="d1">Amazon API Gateway</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">Amazon DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_processing">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda Processing</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="opensearch">
      <data key="d0">OpenSearch</data>
      <data key="d1">Amazon OpenSearch Service</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="bedrock">
      <data key="d0">Bedrock</data>
      <data key="d1">Amazon Bedrock</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="user_clients" target="s3" id="0">
      <data key="d3">Data Upload</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="user_clients" target="api_gateway" id="0">
      <data key="d3">API Request</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="s3" target="lambda_etl" id="0">
      <data key="d3">Triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda_etl" target="opensearch" id="0">
      <data key="d3">Writes Vector Index</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="api_gateway" target="lambda_processing" id="0">
      <data key="d3">Triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda_processing" target="dynamodb" id="0">
      <data key="d3">Reads/Writes Session &amp; Metadata</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_processing" target="opensearch" id="0">
      <data key="d3">Vector Search Query</data>
      <data key="d4">reads_from</data>
    </edge>
    <edge source="lambda_processing" target="bedrock" id="0">
      <data key="d3">Invoke Model</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
