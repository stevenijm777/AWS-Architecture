<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="api_gateway">
      <data key="d0">API Gateway</data>
      <data key="d1">API Gateway</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_top">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_bottom">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="step_functions">
      <data key="d0">Step Functions</data>
      <data key="d1">Step Functions</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ses">
      <data key="d0">SES</data>
      <data key="d1">SES</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="secrets_manager">
      <data key="d0">Secrets Manager</data>
      <data key="d1">Secrets Manager</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="api_gateway" target="lambda_top" id="0">
      <data key="d3">triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="api_gateway" target="lambda_bottom" id="0">
      <data key="d3">data flow</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="api_gateway" target="secrets_manager" id="0">
      <data key="d3">authenticates</data>
      <data key="d4">authenticates</data>
    </edge>
    <edge source="lambda_top" target="step_functions" id="0">
      <data key="d3">starts execution</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda_bottom" target="dynamodb" id="0">
      <data key="d3">writes data</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="step_functions" target="ses" id="0">
      <data key="d3">sends email</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="step_functions" target="dynamodb" id="0">
      <data key="d3">writes state</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="dynamodb" target="lambda_bottom" id="0">
      <data key="d3">reads data</data>
      <data key="d4">reads_from</data>
    </edge>
  </graph>
</graphml>
