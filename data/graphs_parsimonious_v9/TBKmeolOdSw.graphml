<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="users">
      <data key="d0">UserConsumerWebMobile</data>
      <data key="d1">USERS</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="cloudfront">
      <data key="d0">CloudFront</data>
      <data key="d1">CLOUDFRONT</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="alb">
      <data key="d0">ALB</data>
      <data key="d1">ALB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="fargate">
      <data key="d0">Fargate</data>
      <data key="d1">FARGATE</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="efs">
      <data key="d0">EFS</data>
      <data key="d1">EFS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="aurora">
      <data key="d0">Aurora</data>
      <data key="d1">AURORA</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="iot_sensor">
      <data key="d0">ThirdParty</data>
      <data key="d1">IOT SENSOR</data>
      <data key="d2">third_party</data>
    </node>
    <node id="s2s_vpn">
      <data key="d0">VPN</data>
      <data key="d1">S2S VPN</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="transit_gw">
      <data key="d0">Transit Gateway</data>
      <data key="d1">TRANSITGW</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="client_vpn">
      <data key="d0">VPN</data>
      <data key="d1">CLIENT VPN</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="client_user">
      <data key="d0">UserCompanyAdmin</data>
      <data key="d1">Client User</data>
      <data key="d2">user_actor</data>
    </node>
    <edge source="users" target="cloudfront" id="0">
      <data key="d3">requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="users" target="alb" id="0">
      <data key="d3">api requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudfront" target="s3" id="0">
      <data key="d3">fetches assets</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="alb" target="fargate" id="0">
      <data key="d3">routes traffic</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate" target="efs" id="0">
      <data key="d3">mounts storage</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="fargate" target="aurora" id="0">
      <data key="d3">reads/writes data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="iot_sensor" target="s2s_vpn" id="0">
      <data key="d3">sensor data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="s2s_vpn" target="transit_gw" id="0">
      <data key="d3">routes traffic</data>
      <data key="d4">network</data>
    </edge>
    <edge source="transit_gw" target="alb" id="0">
      <data key="d3">routes traffic</data>
      <data key="d4">network</data>
    </edge>
    <edge source="client_vpn" target="transit_gw" id="0">
      <data key="d3">routes traffic</data>
      <data key="d4">network</data>
    </edge>
    <edge source="client_user" target="client_vpn" id="0">
      <data key="d3">connects</data>
      <data key="d4">network</data>
    </edge>
  </graph>
</graphml>
