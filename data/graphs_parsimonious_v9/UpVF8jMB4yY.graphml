      <data key="d1">AWS Transfer</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_app">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="cloudfront">
      <data key="d0">CloudFront</data>
      <data key="d1">Amazon CloudFront</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="customers">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">Customers</data>
      <data key="d2">user_actor</data>
    </node>
    <edge source="datastore_1" target="s3_storage" id="0">
      <data key="d3">Files</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="s3_storage" target="redshift" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_pull" target="datastore_2" id="0">
      <data key="d3">pulls data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_pull" target="redshift" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="redshift" target="eventbridge" id="0">
      <data key="d3">events</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="eventbridge" target="ses" id="0">
