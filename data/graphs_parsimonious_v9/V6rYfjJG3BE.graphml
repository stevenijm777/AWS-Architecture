<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="users">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">Users</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="ec2">
      <data key="d0">EC2</data>
      <data key="d1">Amazon EC2</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elasticache">
      <data key="d0">ElastiCache</data>
      <data key="d1">Amazon ElastiCache</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="rds">
      <data key="d0">RDS</data>
      <data key="d1">Amazon RDS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="opensearch">
      <data key="d0">OpenSearch</data>
      <data key="d1">Amazon OpenSearch Service</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="kinesis">
      <data key="d0">Kinesis</data>
      <data key="d1">Amazon Kinesis</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">Amazon DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="users" target="ec2" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2" target="elasticache" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2" target="rds" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2" target="kinesis" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kinesis" target="lambda" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
