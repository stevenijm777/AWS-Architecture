<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="s3_ingest">
      <data key="d0">S3</data>
      <data key="d1">Amazon S3 (Ingest)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sns_ingest">
      <data key="d0">SNS</data>
      <data key="d1">Amazon SNS (Ingest)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sqs_transformer">
      <data key="d0">SQS</data>
      <data key="d1">Amazon SQS (Transformer)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2_transformer">
      <data key="d0">EC2</data>
      <data key="d1">Amazon EC2 Auto Scaling (Transformer)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="rds_tracking">
      <data key="d0">RDS</data>
      <data key="d1">Amazon RDS (Tracking)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3_warehouse">
      <data key="d0">S3</data>
      <data key="d1">Amazon S3 (Warehouse)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sns_warehouse">
      <data key="d0">SNS</data>
      <data key="d1">Amazon SNS (Warehouse)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sqs_aggregator">
      <data key="d0">SQS</data>
      <data key="d1">Amazon SQS (Aggregator)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2_aggregator">
      <data key="d0">EC2</data>
      <data key="d1">Amazon EC2 (Aggregator)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="athena">
      <data key="d0">Athena</data>
      <data key="d1">Amazon Athena</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="user_consumer">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">Consumer</data>
      <data key="d2">user_actor</data>
    </node>
    <edge source="s3_ingest" target="sns_ingest" id="0">
      <data key="d3">notification</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="sns_ingest" target="sqs_transformer" id="0">
      <data key="d3">message</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="sqs_transformer" target="ec2_transformer" id="0">
      <data key="d3">process</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2_transformer" target="s3_warehouse" id="0">
      <data key="d3">write object</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="s3_warehouse" target="sns_warehouse" id="0">
      <data key="d3">notification</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="sns_warehouse" target="sqs_aggregator" id="0">
      <data key="d3">message</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="sqs_aggregator" target="ec2_aggregator" id="0">
      <data key="d3">aggregate</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="athena" target="s3_warehouse" id="0">
      <data key="d3">read data</data>
      <data key="d4">reads_from</data>
    </edge>
    <edge source="user_consumer" target="athena" id="0">
      <data key="d3">query</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
