<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="webex_apps">
      <data key="d0">ThirdParty</data>
      <data key="d1">Webex Services/Applications</data>
      <data key="d2">third_party</data>
    </node>
    <node id="eks_llm_proxy">
      <data key="d0">EKS</data>
      <data key="d1">Amazon EKS Cloud (LLM Proxy)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sagemaker">
      <data key="d0">SageMaker</data>
      <data key="d1">Amazon SageMaker</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="bedrock">
      <data key="d0">Bedrock</data>
      <data key="d1">Amazon Bedrock</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="external_llm">
      <data key="d0">ThirdParty</data>
      <data key="d1">External LLM Providers</data>
      <data key="d2">third_party</data>
    </node>
    <node id="msk">
      <data key="d0">MSK</data>
      <data key="d1">Amazon Managed Streaming for Apache Kafka (Amazon MSK)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">Amazon Simple Storage Service (Amazon S3)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="glue">
      <data key="d0">Glue</data>
      <data key="d1">AWS Glue</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="athena">
      <data key="d0">Athena</data>
      <data key="d1">Amazon Athena</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="webex_apps" target="eks_llm_proxy" id="0">
      <data key="d3">requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_llm_proxy" target="sagemaker" id="0">
      <data key="d3">inference</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_llm_proxy" target="bedrock" id="0">
      <data key="d3">inference</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_llm_proxy" target="external_llm" id="0">
      <data key="d3">inference</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="eks_llm_proxy" target="msk" id="0">
      <data key="d3">metrics/logging</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
