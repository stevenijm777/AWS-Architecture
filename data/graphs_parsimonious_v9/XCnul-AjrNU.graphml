<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">User</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="api_gateway">
      <data key="d0">API Gateway</data>
      <data key="d1">Amazon API Gateway</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_main">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">Amazon DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">Amazon S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="step_functions">
      <data key="d0">Step Functions</data>
      <data key="d1">AWS Step Functions</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sagemaker">
      <data key="d0">SageMaker</data>
      <data key="d1">Amazon SageMaker</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_worker">
      <data key="d0">Lambda</data>
      <data key="d1">AWS Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="user" target="api_gateway" id="0">
      <data key="d3">1</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="user" target="s3" id="0">
      <data key="d3">2</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="api_gateway" target="lambda_main" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_main" target="dynamodb" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_main" target="step_functions" id="0">
      <data key="d3">2</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="s3" target="lambda_main" id="0">
      <data key="d3">2</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="s3" target="user" id="0">
      <data key="d3">9</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="step_functions" target="sagemaker" id="0">
      <data key="d3">3-7</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="sagemaker" target="lambda_worker" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_worker" target="step_functions" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_worker" target="dynamodb" id="0">
      <data key="d3" />
      <data key="d4">writes_to</data>
    </edge>
    <edge source="lambda_worker" target="user" id="0">
      <data key="d3">8</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
