<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Data Lake Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores raw ingested data (up to 13TB daily) and processed batch Parquet files.</data>
    </node>
    <node id="1">
      <data key="d5">SNS Topic</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives events from S3 and triggers processing and error-handling Lambdas.</data>
    </node>
    <node id="2">
      <data key="d5">Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Cleanses, enriches data, and writes metadata to DynamoDB.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB Metadata Store</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Provides high throughput and low latency for metadata operations.</data>
    </node>
    <node id="4">
      <data key="d5">ECS Batch Service</data>
      <data key="d6">ECS</data>
      <data key="d7">Async RESTful Web API service that batches JSON outputs into Parquet format.</data>
    </node>
    <node id="5">
      <data key="d5">Error Handling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Copies erroneous files back into S3 upon processing failures.</data>
    </node>
    <node id="6">
      <data key="d5">End Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Consumes processed Parquet data from S3.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 bucket triggers SNS event upon file arrival.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">End users consume processed data from S3.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS triggers data processing Lambda functions.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">SNS notifies error handling Lambda upon processing failure.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Internal retry mechanism within processing Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing Lambda writes metadata to DynamoDB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS reads metadata from DynamoDB to perform batch processing.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS writes batched Parquet files back to S3.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">Error handling Lambda copies bad files back to S3 for debugging.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Autodesk Serverless Near-Real-Time Data Pipeline</data>
    <data key="d1" />
    <data key="d2">Serverless pipeline replacing Spark-based data processing using S3, SNS, Lambda, DynamoDB, and ECS.</data>
    <data key="d3">Analytics, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
