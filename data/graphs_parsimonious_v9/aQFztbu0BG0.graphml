    <data key="d0">Discover Financial Services PCI and Prod Data Processing Architecture</data>
    <data key="d1" />
    <data key="d2">Data ingests into a PCI-compliant account via SFTP and PrivateLink, gets tokenized via EC2, and moves to a Prod account for analytics.</data>
    <data key="d3">Data Ingestion &amp; Tokenization</data>
    <data key="d4">True</data>
