  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Data Sources</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises data sources sending raw data</data>
    </node>
    <node id="1">
      <data key="d5">AWS Transfer for SFTP</data>
      <data key="d6">TransferFamily</data>
      <data key="d7">Ingests external SFTP data into AWS</data>
    </node>
    <node id="2">
      <data key="d5">AWS PrivateLink</data>
      <data key="d6">PrivateLink</data>
      <data key="d7">Provides private connectivity from on-prem to S3</data>
    </node>
    <node id="3">
      <data key="d5">S3 Landing Bucket (PCI)</data>
      <data key="d6">S3</data>
      <data key="d7">Landing S3 bucket in PCI account containing raw data</data>
    </node>
    <node id="4">
      <data key="d5">Amazon SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives triggers on new file uploads</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Tokenization Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Performs tokenization and file format conversion</data>
    </node>
    <node id="6">
      <data key="d5">S3 Curated Bucket (Prod)</data>
      <data key="d6">S3</data>
      <data key="d7">Curated S3 bucket residing in the Prod account</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Analytics &amp; ML</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs analytics and machine learning workloads on tokenized data</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">On-premises data sent via SFTP</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">On-premises pipeline data routed through PrivateLink</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">SFTP ingests data into landing S3 bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">PrivateLink delivers data into S3 landing bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">S3 triggers event notifications to SNS</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">SNS notifies EC2 tokenization service</data>
