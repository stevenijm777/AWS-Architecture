<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="eks">
      <data key="d0">EKS</data>
      <data key="d1">EKS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="hpc_node">
      <data key="d0">EC2</data>
      <data key="d1">HPC Node</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="cloudwatch">
      <data key="d0">CloudWatch</data>
      <data key="d1">CloudWatch</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_bottom">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_top">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sns">
      <data key="d0">SNS</data>
      <data key="d1">SNS</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="eks" target="hpc_node" id="0">
      <data key="d3">provisions</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="hpc_node" target="s3" id="0">
      <data key="d3">stores output</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="hpc_node" target="cloudwatch" id="0">
      <data key="d3">logs status</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloudwatch" target="lambda_bottom" id="0">
      <data key="d3">triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda_bottom" target="dynamodb" id="0">
      <data key="d3">persists state</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="lambda_bottom" target="sns" id="0">
      <data key="d3">publishes notification</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="sns" target="lambda_top" id="0">
      <data key="d3">triggers action</data>
      <data key="d4">triggers</data>
    </edge>
  </graph>
</graphml>
