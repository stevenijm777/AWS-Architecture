<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="user">
      <data key="d0">UserConsumerWebMobile</data>
      <data key="d1">User</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="cdn">
      <data key="d0">CloudFront</data>
      <data key="d1">CDN</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="appsync">
      <data key="d0">AppSync</data>
      <data key="d1">AppSync</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="api_gateway">
      <data key="d0">API Gateway</data>
      <data key="d1">API Gateway</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="dynamodb">
      <data key="d0">DynamoDB</data>
      <data key="d1">DynamoDB</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sqs">
      <data key="d0">SQS</data>
      <data key="d1">SQS</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="user" target="cdn" id="0">
      <data key="d3">requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cdn" target="s3" id="0">
      <data key="d3">static content</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cdn" target="appsync" id="0">
      <data key="d3">GraphQL API requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cdn" target="api_gateway" id="0">
      <data key="d3">REST API requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="appsync" target="lambda" id="0">
      <data key="d3">invokes</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="appsync" target="dynamodb" id="0">
      <data key="d3">direct data resolver</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="api_gateway" target="lambda" id="0">
      <data key="d3">invokes</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda" target="dynamodb" id="0">
      <data key="d3">read/write data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda" target="sqs" id="0">
      <data key="d3">enqueue messages</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="sqs" target="lambda" id="0">
      <data key="d3">triggers worker</data>
      <data key="d4">triggers</data>
    </edge>
  </graph>
</graphml>
