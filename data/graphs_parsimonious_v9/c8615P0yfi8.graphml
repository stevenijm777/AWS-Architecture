<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="eventbridge">
      <data key="d0">EventBridge</data>
      <data key="d1">EventBridge</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="state_machine">
      <data key="d0">Step Functions</data>
      <data key="d1">State Machine</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_batch">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="athena">
      <data key="d0">Athena</data>
      <data key="d1">Athena</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sagemaker_prep">
      <data key="d0">SageMaker</data>
      <data key="d1">SageMaker</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sagemaker_model">
      <data key="d0">SageMaker</data>
      <data key="d1">SageMaker</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda_api">
      <data key="d0">Lambda</data>
      <data key="d1">Lambda</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="api_gateway">
      <data key="d0">API Gateway</data>
      <data key="d1">API Gateway</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="user">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">User / Client</data>
      <data key="d2">user_actor</data>
    </node>
    <edge source="eventbridge" target="state_machine" id="0">
      <data key="d3">triggers</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="state_machine" target="lambda_batch" id="0">
      <data key="d3">orchestrates</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="state_machine" target="sagemaker_prep" id="0">
      <data key="d3">orchestrates</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="state_machine" target="sagemaker_model" id="0">
      <data key="d3">orchestrates</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda_batch" target="athena" id="0">
      <data key="d3">queries</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="athena" target="s3" id="0">
      <data key="d3">fetches data</data>
      <data key="d4">reads_from</data>
    </edge>
    <edge source="sagemaker_prep" target="s3" id="0">
      <data key="d3">reads/writes data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="sagemaker_prep" target="sagemaker_model" id="0">
      <data key="d3">passes processed data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="lambda_api" target="sagemaker_model" id="0">
      <data key="d3">queries inference endpoint</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="api_gateway" target="lambda_api" id="0">
      <data key="d3">invokes</data>
      <data key="d4">triggers</data>
    </edge>
    <edge source="user" target="api_gateway" id="0">
      <data key="d3">sends request</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
