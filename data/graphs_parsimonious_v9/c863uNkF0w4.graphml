<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="cloudformation">
      <data key="d0">CloudFormation</data>
      <data key="d1">CloudFormation</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="kinesis">
      <data key="d0">Kinesis</data>
      <data key="d1">Kinesis</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ecs">
      <data key="d0">ECS</data>
      <data key="d1">ECS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="api_gateway">
      <data key="d0">API Gateway</data>
      <data key="d1">API Gateway</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2_auto_scaling">
      <data key="d0">Auto Scaling</data>
      <data key="d1">EC2 Auto Scaling</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="ec2_spot">
      <data key="d0">EC2</data>
      <data key="d1">EC2 Spot Instances (Fleet)</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="systems_manager">
      <data key="d0">Systems Manager</data>
      <data key="d1">Systems Manager (Parameter Store)</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="kinesis" target="s3" id="0">
      <data key="d3">archive</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kinesis" target="ecs" id="0">
      <data key="d3">stream data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ecs" target="ec2_auto_scaling" id="0">
      <data key="d3">scale</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="api_gateway" target="ecs" id="0">
      <data key="d3">requests</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="ec2_auto_scaling" target="ec2_spot" id="0">
      <data key="d3">manage fleet</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
