<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="ddos">
      <data key="d0">ThirdParty</data>
      <data key="d1">DDOS</data>
      <data key="d2">third_party</data>
    </node>
    <node id="cloud_waf">
      <data key="d0">ThirdParty</data>
      <data key="d1">Cloud WAF</data>
      <data key="d2">third_party</data>
    </node>
    <node id="bot_protection">
      <data key="d0">ThirdParty</data>
      <data key="d1">Bot Protection</data>
      <data key="d2">third_party</data>
    </node>
    <node id="runtime_agents">
      <data key="d0">ThirdParty</data>
      <data key="d1">Runtime Agents</data>
      <data key="d2">third_party</data>
    </node>
    <node id="msk">
      <data key="d0">MSK</data>
      <data key="d1">Streaming for Kafka</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="elasticsearch">
      <data key="d0">OpenSearch</data>
      <data key="d1">Elasticsearch</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="emr">
      <data key="d0">EMR</data>
      <data key="d1">EMR</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="eks">
      <data key="d0">EKS</data>
      <data key="d1">EKS</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="ddos" target="msk" id="0">
      <data key="d3">events/metrics</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="cloud_waf" target="msk" id="0">
      <data key="d3">events/metrics</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="bot_protection" target="msk" id="0">
      <data key="d3">events/metrics</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="runtime_agents" target="msk" id="0">
      <data key="d3">events/metrics</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="msk" target="elasticsearch" id="0">
      <data key="d3">streaming logs</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="msk" target="s3" id="0">
      <data key="d3">archival</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
