<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="factory">
      <data key="d0">OnPremDC</data>
      <data key="d1">Factory</data>
      <data key="d2">on_prem</data>
    </node>
    <node id="kafka">
      <data key="d0">Kafka</data>
      <data key="d1">Kafka</data>
      <data key="d2">third_party</data>
    </node>
    <node id="emr">
      <data key="d0">EMR</data>
      <data key="d1">EMR</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="redshift">
      <data key="d0">Redshift</data>
      <data key="d1">Redshift</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="aurora">
      <data key="d0">Aurora</data>
      <data key="d1">Aurora</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="bi_reports">
      <data key="d0">UserCompanyAnalyst</data>
      <data key="d1">BI Reports</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="realtime_apps">
      <data key="d0">UserConsumerWeb</data>
      <data key="d1">Real-Time Apps</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="external_systems">
      <data key="d0">ThirdParty</data>
      <data key="d1">External Systems</data>
      <data key="d2">third_party</data>
    </node>
    <edge source="factory" target="kafka" id="0">
      <data key="d3">streams data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="kafka" target="emr" id="0">
      <data key="d3">ingests data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="emr" target="s3" id="0">
      <data key="d3">stores raw data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="emr" target="aurora" id="0">
      <data key="d3">writes hot data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="s3" target="redshift" id="0">
      <data key="d3">loads data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="redshift" target="bi_reports" id="0">
      <data key="d3">serves analytics</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="redshift" target="realtime_apps" id="0">
      <data key="d3">serves queries</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="aurora" target="realtime_apps" id="0">
      <data key="d3">serves real-time data</data>
      <data key="d4">data_flow</data>
    </edge>
    <edge source="external_systems" target="aurora" id="0">
      <data key="d3">syncs metadata</data>
      <data key="d4">data_flow</data>
    </edge>
  </graph>
</graphml>
