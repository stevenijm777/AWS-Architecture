<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Content Supplier</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External content studio providing video mezzanine files</data>
    </node>
    <node id="1">
      <data key="d5">INGEST</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket where raw incoming mezzanine files land</data>
    </node>
    <node id="2">
      <data key="d5">ARCHIVE</data>
      <data key="d6">S3</data>
      <data key="d7">S3 Glacier archive storage for long-term media asset storage</data>
    </node>
    <node id="3">
      <data key="d5">DISTRIBUTION</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket for storing processed assets ready for delivery</data>
    </node>
    <node id="4">
      <data key="d5">Distribution Endpoint</data>
      <data key="d6">UserConsumerTV</data>
      <data key="d7">OTT consumer playback devices and platform targets</data>
    </node>
    <node id="5">
      <data key="d5">EVENTS</data>
      <data key="d6">Lambda</data>
      <data key="d7">Event bus routing system built with microservices and messaging</data>
    </node>
    <node id="6">
      <data key="d5">PROCESSING</data>
      <data key="d6">EC2</data>
      <data key="d7">Containerized worker fleet handling transcoding and asset processing</data>
    </node>
    <node id="7">
      <data key="d5">SECURITY</data>
      <data key="d6">KMS</data>
      <data key="d7">Security and key management service for locking down asset buckets</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Content supplier uploads mezzanine video files into Ingest bucket</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Ingested assets are moved into long-term Glacier archive</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Ingest pipeline emits state events to the event bus</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Direct transfer of archived content to distribution bucket when applicable</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Processing fleet pulls archived files out to perform transcoding</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Final media delivered from distribution bucket to consumer endpoints</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Events notify worker fleets to trigger asset processing jobs</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Transcoded assets uploaded into distribution storage bucket</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Deluxe One Media Processing Pipeline Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=S8d0I6k2m5A</data>
    <data key="d2">Deluxe One architecture for media ingestion, archival, event-driven compute microservices, and distribution.</data>
    <data key="d3">Media &amp; Entertainment</data>
    <data key="d4">True</data>
  </graph>
