<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d4" for="edge" attr.name="type" attr.type="string" />
  <key id="d3" for="edge" attr.name="label" attr.type="string" />
  <key id="d2" for="node" attr.name="type" attr.type="string" />
  <key id="d1" for="node" attr.name="name" attr.type="string" />
  <key id="d0" for="node" attr.name="service" attr.type="string" />
  <graph edgedefault="directed">
    <node id="dev">
      <data key="d0">UserCompanyDeveloper</data>
      <data key="d1">DEV</data>
      <data key="d2">user_actor</data>
    </node>
    <node id="s3">
      <data key="d0">S3</data>
      <data key="d1">S3</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sns">
      <data key="d0">SNS</data>
      <data key="d1">SNS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="lambda">
      <data key="d0">Lambda</data>
      <data key="d1">LAMBDA</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="cloudformation">
      <data key="d0">CloudFormation</data>
      <data key="d1">CLOUDFORMATION</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="sqs">
      <data key="d0">SQS</data>
      <data key="d1">SQS</data>
      <data key="d2">aws_service</data>
    </node>
    <node id="eks">
      <data key="d0">EKS</data>
      <data key="d1">EKS</data>
      <data key="d2">aws_service</data>
    </node>
    <edge source="dev" target="s3" id="0">
      <data key="d3">GIT</data>
      <data key="d4">writes_to</data>
    </edge>
    <edge source="s3" target="sns" id="0">
      <data key="d3" />
      <data key="d4">triggers</data>
    </edge>
    <edge source="sns" target="lambda" id="0">
      <data key="d3" />
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda" target="cloudformation" id="0">
      <data key="d3" />
      <data key="d4">triggers</data>
    </edge>
    <edge source="lambda" target="sqs" id="0">
      <data key="d3" />
      <data key="d4">data_flow</data>
    </edge>
    <edge source="sqs" target="eks" id="0">
      <data key="d3" />
      <data key="d4">triggers</data>
    </edge>
  </graph>
</graphml>
