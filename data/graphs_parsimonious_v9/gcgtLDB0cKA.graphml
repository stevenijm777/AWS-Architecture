    <data key="d0">OMC International DUKC Platform Serverless Architecture</data>
    <data key="d1" />
    <data key="d2">The architecture processes port sensor data for vessel routing, supporting both real-time querying via DynamoDB and historical querying via Athena and S3.</data>
    <data key="d3">IoT, Serverless, Data Analytics</data>
    <data key="d4">True</data>
