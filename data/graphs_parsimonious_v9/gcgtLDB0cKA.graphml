    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Streams pass data to Kinesis Data Firehose</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose writes parquet formatted historical data into S3 bucket</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Users make requests via API Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway calls query Lambda function</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda queries DynamoDB directly for recent/hot data</data>
      <data key="d10">2a</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda calls Athena to query older/historical data</data>
      <data key="d10">2b</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries historical S3 bucket</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
