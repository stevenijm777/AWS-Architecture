  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Port Sensors</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Environmental sensors for wind, wave, and tide</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Managed Streaming for Apache Kafka</data>
      <data key="d6">MSK</data>
      <data key="d7">Ingests streaming data from port sensors</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda function</data>
      <data key="d6">Lambda</data>
      <data key="d7">Event source mapping processes MSK messages</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB Table</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Hot storage location with TTL set for retention</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB Stream</data>
      <data key="d6">DynamoDBStream</data>
      <data key="d7">Captures table updates for archival pipeline</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Converts messages to Parquet format and delivers to S3</data>
    </node>
    <node id="6">
      <data key="d5">Amazon S3 Bucket (Historical)</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term historical data storage</data>
    </node>
    <node id="7">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End-users or external systems requesting port data</data>
    </node>
    <node id="8">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for user data requests</data>
    </node>
    <node id="9">
      <data key="d5">AWS Lambda function</data>
      <data key="d6">Lambda</data>
      <data key="d7">Decision logic function routing requests to DynamoDB or Athena</data>
    </node>
    <node id="10">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive query engine for S3 historical data</data>
    </node>
    <node id="11">
      <data key="d5">Amazon S3 Bucket (Predictions)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores output from prediction service</data>
    </node>
    <node id="12">
      <data key="d5">Amazon Elastic Container Service (Amazon ECS)</data>
      <data key="d6">ECS</data>
      <data key="d7">Runs prediction container service forecasting up to 2 weeks</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Port sensors send messages to MSK</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda reads messages from MSK via event source mapping</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda puts processed data into DynamoDB table</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB streams table changes</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
