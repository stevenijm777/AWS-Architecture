    <node id="2">
      <data key="d5">Routing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles regional routing based on latency, load, and specs</data>
    </node>
    <node id="3">
      <data key="d5">Virtual Connection Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Communicates with Fargate cluster fronting virtual resources</data>
    </node>
    <node id="4">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Regional orchestrator managing game allocation</data>
    </node>
    <node id="5">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Stores available EC2 instance state and capacity</data>
    </node>
    <node id="6">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs Service Manager, Game engine, and Streaming Agent</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores game binaries and 3D model assets</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Sends launch request with model details</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Forwards request to regional routing logic</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Passes routing decision to connection handler</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Bidirectional WebSocket communication for cluster state and launch triggers</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Dispatches launch details to target EC2 node</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Queries cache for available instance capacity</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Service Manager registers EC2 availability in cache</data>
