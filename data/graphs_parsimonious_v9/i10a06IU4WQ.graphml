  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users / Services</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Internal Pinterest users or automated workflows authenticating via Kerberos</data>
    </node>
    <node id="1">
      <data key="d5">EC2 Data Clusters</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts data engineering services like Hadoop, Spark, and Presto</data>
    </node>
    <node id="2">
      <data key="d5">Token Vending Service</data>
      <data key="d6">ThirdParty</data>
