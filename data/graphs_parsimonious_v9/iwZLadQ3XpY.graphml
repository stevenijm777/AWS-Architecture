<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Players / Game Clients</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Players connecting globally via game client</data>
    </node>
    <node id="1">
      <data key="d5">Game Servers / Data Center</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premise game servers running local Kafka clusters with MirrorMaker</data>
    </node>
    <node id="2">
      <data key="d5">EKS API</data>
      <data key="d6">EKS</data>
      <data key="d7">API service running in Elastic Kubernetes Service</data>
    </node>
    <node id="3">
      <data key="d5">Regional MSK Clusters</data>
      <data key="d6">MSK</data>
      <data key="d7">Amazon Managed Streaming for Apache Kafka for regional data buffering</data>
    </node>
    <node id="4">
      <data key="d5">Delta Lake in S3</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake storage for Delta Lake</data>
    </node>
    <node id="5">
      <data key="d5">Glue Data Catalog</data>
      <data key="d6">Glue</data>
      <data key="d7">Meta store and permissions layer</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Game clients send API requests to EKS</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Players connect to regional game servers</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">MirrorMaker replicates local Kafka data to regional MSK</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS streams event data into regional MSK clusters</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Spark streaming writes data from MSK to S3 Delta Lake</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Riot Games - HONO over IP Data Ingest Architecture</data>
    <data key="d1" />
    <data key="d2">Data ingestion pipeline for League of Legends game data.</data>
    <data key="d3">Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
