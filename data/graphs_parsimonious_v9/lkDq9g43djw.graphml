    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">10 million requests per day</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Traffic distributed to left compute domain</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Traffic distributed to right compute domain</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">3000 requests per second to Aurora</data>
      <data key="d10">0</data>
