    <node id="7">
      <data key="d5">API Service Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Fetches real-time or predicted parking data.</data>
    </node>
    <node id="8">
      <data key="d5">CodeCommit Repository</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">Stores application code and CloudFormation templates.</data>
    </node>
    <node id="9">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for public user requests.</data>
    </node>
