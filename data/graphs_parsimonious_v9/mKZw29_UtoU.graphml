    <node id="5">
      <data key="d5">SageMaker Model Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains and serves long-term occupancy predictions.</data>
    </node>
    <node id="6">
      <data key="d5">Step Functions Workflow</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates data cleaning, training, and model deployment.</data>
