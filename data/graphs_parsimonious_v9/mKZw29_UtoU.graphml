  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Parking Lot Sensors</data>
      <data key="d6">UserConsumerIOT</data>
      <data key="d7">Sends current parking occupancy data.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Ingests real-time streaming data.</data>
    </node>
    <node id="2">
      <data key="d5">Data Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Cleans data and writes to S3 and DynamoDB.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores historical parking data in Parquet format.</data>
