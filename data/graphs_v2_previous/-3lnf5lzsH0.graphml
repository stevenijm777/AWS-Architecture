<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS</data>
      <data key="d6">VPC</data>
      <data key="d7">Public cloud telemetry data sources including S3, SNS, SQS, CloudTrail, and GuardDuty.</data>
    </node>
    <node id="1">
      <data key="d5">ON-PREM</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises log sources sending syslog and Kafka telemetry events.</data>
    </node>
    <node id="2">
      <data key="d5">APACHE METRON</data>
      <data key="d6">EC2</data>
      <data key="d7">Real-time stream processing layer responsible for log parsing, contextual intelligence enrichment, and profiling.</data>
    </node>
    <node id="3">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Amazon EMR cluster running ETL jobs to transform persistent telemetry data into Amazon S3.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Serverless Security Data Lake storing persistent telemetry data (250 million events per day).</data>
    </node>
    <node id="5">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Amazon Athena executing SQL queries for log mining, analytics, forensics, and long-term security profiling.</data>
    </node>
    <node id="6">
      <data key="d5">SOAR</data>
      <data key="d6">EC2</data>
      <data key="d7">Blitz SOAR platform performing incident response orchestration and automated context tagging.</data>
    </node>
    <node id="7">
      <data key="d5">ALERTS</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">SOC analysts receiving triaged alerts on a single pane of glass or mobile devices.</data>
    </node>
    <node id="8">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF used for automated or semi-automated threat mitigation and source blocking.</data>
    </node>
    <edge source="0" target="2">
      <data key="d8">0</data>
      <data key="d9">AWS telemetry events pulled into Apache Metron using Apache NiFi workflows.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">On-premise syslog and Kafka streams ingested directly into Apache Metron.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">1</data>
      <data key="d9">Persistent telemetry data in Metron HDFS picked up by EMR jobs.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="6">
      <data key="d8">2</data>
      <data key="d9">Alerts pushed from Apache Metron into Blitz SOAR platform.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="4">
      <data key="d8">1</data>
      <data key="d9">EMR transforms and stores persistent telemetry into S3 Security Data Lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="5">
      <data key="d8">1</data>
      <data key="d9">Athena queries data stored long-term in S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="2">
      <data key="d8">1</data>
      <data key="d9">Feedback loop returning long-term security profiles and model insights from Athena back to Apache Metron.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="7">
      <data key="d8">2</data>
      <data key="d9">Enriched alerts presented to SOC analysts for investigation.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="8">
      <data key="d8">2</data>
      <data key="d9">Analyst triggers automated mitigation rules on AWS WAF.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">MakeMyTrip: Building Next Generation SOC</data>
    <data key="d1">https://www.youtube.com/watch?v=-3lnf5lzsH0</data>
    <data key="d2">MakeMyTrip built a next-gen SOC system ingesting 5,000 events per second across hybrid data sources into Apache Metron, leveraging an EMR and Athena serverless Security Data Lake indexing 250 million events per day, integrated with automated SOAR incident response.</data>
    <data key="d3">Security, Data Lake &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
