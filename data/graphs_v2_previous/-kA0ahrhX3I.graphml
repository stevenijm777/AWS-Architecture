<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon Macie (Main Account)</data>
      <data key="d6">Macie</data>
      <data key="d7">Scans S3 buckets for sensitive PII data and generates findings.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3 (Central Findings Bucket)</data>
      <data key="d6">S3</data>
      <data key="d7">Central bucket storing finding metadata without storing PII.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Executes SQL queries against Macie findings stored in S3.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualizes findings and risk metrics in dashboard reports.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Automates ETL, aggregation, and loading of findings data.</data>
    </node>
    <node id="5">
      <data key="d5">MySQL Data Lake</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom MySQL data lake for aggregated finding metrics.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Macie (Production Account 1)</data>
      <data key="d6">Macie</data>
      <data key="d7">Scans local production account S3 buckets.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3 (Production Account 1)</data>
      <data key="d6">S3</data>
      <data key="d7">Production S3 bucket scanned for sensitive data.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon Macie (Production Account 2)</data>
      <data key="d6">Macie</data>
      <data key="d7">Scans local production account S3 buckets.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon S3 (Production Account 2)</data>
      <data key="d6">S3</data>
      <data key="d7">Production S3 bucket scanned for sensitive data.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Amazon Macie exports finding metadata to the central S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="5">
      <data key="d8">2</data>
      <data key="d9">Findings data is stored and dropped into the MySQL data lake.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="1">
      <data key="d8">1</data>
      <data key="d9">Amazon Athena queries finding metadata stored in the S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="1">
      <data key="d8">1</data>
      <data key="d9">Amazon QuickSight reads processed data from S3 for executive dashboards.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Oportun: Increasing the Accuracy of SensitiveData Discovery Using Amazon Macie</data>
    <data key="d1">https://www.youtube.com/watch?v=-kA0ahrhX3I</data>
    <data key="d2">Architecture for automated sensitive data discovery and DSPM across multi-account AWS environments using Amazon Macie, S3, Athena, QuickSight, and MySQL.</data>
    <data key="d3">Security, Data Lake &amp; Analytics</data>
    <data key="d4">True</data>
  </graph>
