<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Migration Team</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Operations team triggering and configuring migration pipelines.</data>
    </node>
    <node id="1">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">ChatOps platform used to send CLI commands to trigger the automated migration factory.</data>
    </node>
    <node id="2">
      <data key="d5">On-Premises Server</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Source environment server targeted for migration.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Application Discovery Service</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Gathers server metadata, performance utilization, and TCP connection details.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores operational metadata, RTO/RPO requirements, target subnets, IPs, and tags.</data>
    </node>
    <node id="5">
      <data key="d5">Migration Factory EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Orchestrates API calls across services to automate server staging, AMI baking, and target launching.</data>
    </node>
    <node id="6">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Manages continuous block-level data replication from source servers to AWS.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Hot Replica</data>
      <data key="d6">EC2</data>
      <data key="d7">Staging instance receiving block replication prior to AMI creation.</data>
    </node>
    <node id="8">
      <data key="d5">Target EC2 Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">Final launched instance running in the target AWS account.</data>
    </node>
    <edge source="0" target="4">
      <data key="d8">0</data>
      <data key="d9">Migration team populates target configurations, sizing, and tags into DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="0" target="1">
      <data key="d8">3</data>
      <data key="d9">Migration team issues start command via Slack.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="5">
      <data key="d8">3</data>
      <data key="d9">Slack webhook calls API on Migration Factory EC2 instance.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">1</data>
      <data key="d9">Application Discovery Service agent collects TCP metrics and utilization data from source server.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="7">
      <data key="d8">2</data>
      <data key="d9">Continuous block-level volume replication to the EC2 hot replica.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="3">
      <data key="d8">3</data>
      <data key="d9">Migration Factory queries Application Discovery Service for TCP connectivity and metrics.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="4">
      <data key="d8">3</data>
      <data key="d9">Migration Factory reads target account, network, and tagging metadata from DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="6">
      <data key="d8">3</data>
      <data key="d9">Migration Factory invokes CloudEndure API to stop block replication.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="7">
      <data key="d8">3</data>
      <data key="d9">Migration Factory triggers AMI baking from the stopped hot replica.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="8">
      <data key="d8">3</data>
      <data key="d9">Migration Factory shares encrypted AMI and launches target EC2 instance with metadata applied.</data>
      <data key="d10">7</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="7">
      <data key="d8">3</data>
      <data key="d9">CloudEndure stops active replication on the hot replica instance.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Versent: The Migration Factory</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Automated migration factory leveraging Slack ChatOps, DynamoDB, CloudEndure block-level replication, Application Discovery Service, and cross-account AMI sharing to migrate servers in ~10 minutes.</data>
    <data key="d3">Migration, Automation, Cloud Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
