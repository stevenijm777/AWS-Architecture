<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded raw video files from users to trigger the processing workflow.</data>
    </node>
    <node id="1">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates media processing jobs across MediaConvert, Rekognition, Transcribe, and metadata extraction.</data>
    </node>
    <node id="2">
      <data key="d5">Elemental MediaConvert</data>
      <data key="d6">MediaConvert</data>
      <data key="d7">Generates playback proxy videos suitable for browser playback and visual verification.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Analyzes video to detect celebrities, violence, nudity, and visual metadata indexed by timecode.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts audio streams from video content into text transcripts.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Performs text analytics on transcripts to extract entities and profanity occurrences.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Acts as temporary metadata storage holding timecoded analysis, technical specifications, and AI insights.</data>
    </node>
    <node id="7">
      <data key="d5">Reach Engine (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Part of the Reach Engine core platform running on EC2 instances for metadata search and orchestration.</data>
    </node>
    <node id="8">
      <data key="d5">Reach Engine (EKS)</data>
      <data key="d6">EKS</data>
      <data key="d7">Container orchestration layer for Reach Engine hosting backend services.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">S3 file upload event triggers Step Functions state machine execution.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">Step Functions initiates transcode job in Elemental MediaConvert.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="3">
      <data key="d8">0</data>
      <data key="d9">Step Functions triggers Amazon Rekognition for video analysis.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="4">
      <data key="d8">0</data>
      <data key="d9">Step Functions triggers Amazon Transcribe for speech-to-text conversion.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="6">
      <data key="d8">0</data>
      <data key="d9">MediaConvert stores technical proxy metadata in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="6">
      <data key="d8">0</data>
      <data key="d9">Rekognition writes visual metadata and timecodes to DynamoDB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="5">
      <data key="d8">0</data>
      <data key="d9">Transcribe passes generated text transcript to Amazon Comprehend.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="6">
      <data key="d8">0</data>
      <data key="d9">Comprehend stores extracted text entities and analytics in DynamoDB.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="7">
      <data key="d8">0</data>
      <data key="d9">Reach Engine on EC2 ingests metadata stored in DynamoDB.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="8">
      <data key="d8">0</data>
      <data key="d9">Reach Engine on EKS ingests metadata stored in DynamoDB.</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Levels Beyond: Digital Content Orchestration</data>
    <data key="d1">https://www.youtube.com/watch?v=07lfvavMdfU</data>
    <data key="d2">Media to Cloud architecture by Levels Beyond using AWS Step Functions, AI/ML services (Rekognition, Transcribe, Comprehend), Elemental MediaConvert, DynamoDB, and Reach Engine on EC2/EKS.</data>
    <data key="d3">Media &amp; Entertainment, Machine Learning, Serverless Orchestration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
