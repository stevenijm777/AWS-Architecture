<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developer requesting a new development/staging environment for a business vertical via the Orion portal.</data>
    </node>
    <node id="1">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Provides DNS resolution for the Orion portal.</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer routing traffic to EKS and application pods.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Amazon Elastic Kubernetes Service managing containerized workloads, scaled from 100 to 10,000+ pods.</data>
    </node>
    <node id="4">
      <data key="d5">SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">100% AWS Spot instances hosting pods and Kubernetes jobs, using AWS Node Termination Handler for graceful draining.</data>
    </node>
    <node id="5">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives events whenever a microservice creation job is triggered.</data>
    </node>
    <node id="6">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers job state messages to enable task resumption in case of Spot instance termination.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Developer accesses Orion portal over HTTPS, sending a DNS lookup request to Route 53.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">Route 53 resolves DNS to the Application Load Balancer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">ALB forwards request to EKS for orchestration.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="4">
      <data key="d8">0</data>
      <data key="d9">ALB routes incoming web traffic to target pods running on Spot instances.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="5">
      <data key="d8">1</data>
      <data key="d9">EKS pod triggers job creation for microservices and sends an event to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="6">
      <data key="d8">1</data>
      <data key="d9">SNS fans out job state event messages to SQS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="4">
      <data key="d8">1</data>
      <data key="d9">Replacement jobs running on Spot nodes poll SQS to pick up and complete unfinished microservice deployments.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">OLX Autos: Building Developer Platform for Rapid Global Expansion</data>
    <data key="d1">https://www.youtube.com/watch?v=1aYoIZvabbk</data>
    <data key="d2">OLX Autos built an internal developer platform called Orion to automate environment creation across 11 countries. The backend runs 100% on AWS Spot instances, scaling up to 10,000+ pods on EKS. To survive Spot terminations, job creation events are sent via SNS to SQS, allowing replacement jobs on Spot nodes to resume pending microservice deployments seamlessly.</data>
    <data key="d3">DevOps, Containerization, Event-Driven</data>
    <data key="d4">True</data>
  </graph>
</graphml>
