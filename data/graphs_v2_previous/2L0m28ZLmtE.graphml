    <node id="8">
      <data key="d5">R Studio</data>
      <data key="d6">EC2</data>
      <data key="d7">Dedicated RStudio workspace environment on EC2</data>
    </node>
    <node id="9">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker notebook instance with encrypted 100GB storage</data>
    </node>
    <node id="10">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Orchestrates calls to Translate and Comprehend Medical SDKs</data>
    </node>
    <node id="11">
      <data key="d5">Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Translates bulk raw documents from auto-detected language</data>
    </node>
    <node id="12">
      <data key="d5">Comprehend Medical</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Extracts medical entities and metadata from raw data</data>
    </node>
    <node id="13">
      <data key="d5">Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Secure central data lake holding sensitive medical data</data>
    </node>
