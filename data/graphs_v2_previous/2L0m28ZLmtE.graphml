  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Data Scientists / Users</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">30 to 40 data scientists accessing the analytics web portal</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN distribution serving static website assets with SSL certificate</data>
    </node>
    <node id="2">
      <data key="d5">S3 (Web Portal)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores static web assets for the analytics portal</data>
    </node>
    <node id="3">
      <data key="d5">Sanofi SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sanofi corporate single sign-on identity provider</data>
    </node>
    <node id="4">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles federated authentication integration with Sanofi SSO</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for dynamic requests and user portal actions</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
