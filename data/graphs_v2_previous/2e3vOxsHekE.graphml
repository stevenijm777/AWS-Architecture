<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Fire Hydrant</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">IoT acoustic devices attached to pipe network collecting daily noise signals.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles security and authentication layer for ingesting acoustic files.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores and persists daily acoustic signal files.</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Executes daily batch processing microservices for intensive acoustic correlation algorithms.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">ML endpoint providing leak probability scores from persistent correlation data.</data>
    </node>
    <node id="5">
      <data key="d5">ANALYST</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Human analyst team evaluating leak probabilities to schedule field investigations.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Daily acoustic files are pushed securely through API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">API Gateway authenticates and persists files into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">Daily batch process kicks off processing on ECS container microservices.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="4">
      <data key="d8">0</data>
      <data key="d9">Persistent acoustic correlation data is passed to SageMaker endpoint for classification.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="5">
      <data key="d8">0</data>
      <data key="d9">Leak probability scores are delivered to human analyst team.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="4">
      <data key="d8">0</data>
      <data key="d9">Field investigation feedback is sent back every 6 weeks to retrain SageMaker model.</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Mueller Water Products: A Water Intelligent Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=2e3vOxsHekE</data>
    <data key="d2">System processes daily acoustic signal data collected from fire hydrants to detect and predict pipe network water leaks.</data>
    <data key="d3">IoT, Machine Learning, Data Ingestion &amp; Batch Processing</data>
    <data key="d4">True</data>
  </graph>
