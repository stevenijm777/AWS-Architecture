  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client Devices</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Web and mobile devices requesting personalized video rendering and playing streams.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point enforcing usage plans and API keys to manage customer load.</data>
    </node>
    <node id="2">
      <data key="d5">RAS Frontend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates incoming render requests, enqueues jobs, and polls for completed playlist links.</data>
    </node>
    <node id="3">
      <data key="d5">SQS Jobs Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds incoming rendering job instructions.</data>
    </node>
    <node id="4">
      <data key="d5">SQS Responses Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Stores immediate completion responses and playlist file locations.</data>
    </node>
    <node id="5">
      <data key="d5">Rendering EC2 Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Spot instances processing and rendering personalized video segments.</data>
    </node>
    <node id="6">
      <data key="d5">Auto Scaling Group</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Manages fleet size across multiple Availability Zones with diversified instance types.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores rendered video segments accessible via CDN.</data>
    </node>
    <node id="8">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN serving video segments from S3 origin to user players.</data>
    </node>
    <node id="9">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers the scaling evaluation workflow every 15 seconds.</data>
    </node>
    <node id="10">
      <data key="d5">Scaling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Calculates required rendering capacity from CloudWatch metrics and updates the ASG.</data>
    </node>
    <node id="11">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects rendering performance metrics and emits spot interruption notices.</data>
    </node>
    <node id="12">
      <data key="d5">Interruption Handler Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles spot termination warnings by draining jobs and detaching instances.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Client requests personalized video bill.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="0" target="8">
      <data key="d8">0</data>
      <data key="d9">Client requests video segments playback via CloudFront.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes request to RAS Frontend Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">Lambda validates request and pushes rendering job to SQS Jobs Queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="0">
      <data key="d8">0</data>
      <data key="d9">Lambda returns playlist link back to client device player.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="5">
      <data key="d8">0</data>
      <data key="d9">EC2 rendering engines pull jobs when capacity is available.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="2">
      <data key="d8">0</data>
      <data key="d9">RAS Frontend Lambda polls responses queue for playlist link.</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="4">
      <data key="d8">0</data>
      <data key="d9">Rendering engines send quick responses and playlist info to SQS Responses Queue.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="7">
      <data key="d8">0</data>
      <data key="d9">EC2 rendering instances upload rendered video segments to S3.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="11">
      <data key="d8">1</data>
      <data key="d9">Rendering EC2 instances push custom performance metrics to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="8" target="7">
      <data key="d8">0</data>
      <data key="d9">CloudFront pulls video segments from S3 origin.</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="9" target="10">
      <data key="d8">1</data>
      <data key="d9">Step Functions triggers custom scaling Lambda every 15 seconds.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="10" target="6">
      <data key="d8">1</data>
      <data key="d9">Scaling Lambda instructs Auto Scaling Group to scale instance count up or down.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="11" target="12">
      <data key="d8">2</data>
      <data key="d9">CloudWatch Events notifies Lambda of incoming spot interruption notice.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="12" target="5">
      <data key="d8">2</data>
      <data key="d9">Interruption Handler Lambda calls API on target EC2 instance to stop pulling new jobs and drain current ones.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="12" target="6">
      <data key="d8">2</data>
      <data key="d9">Lambda detaches interrupted EC2 instance from Auto Scaling Group.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">SundaySky: Create Personalized Videos in Real Time on GPU-based Spot Instances for Video Rendering</data>
    <data key="d1">https://www.youtube.com/watch?v=6CgqEzyWpeA</data>
    <data key="d2">SundaySky's Rendering as a Service (RAS) pipeline powered by AWS serverless and EC2 Spot instances with custom auto-scaling and spot interruption management.</data>
    <data key="d3">Media &amp; Entertainment, Serverless, Compute</data>
    <data key="d4">True</data>
