<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis Data Streams (Collect)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Collects native cloud provider security event streams in real time.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Primary schema-less graph database storing interconnected cloud resource data (50M+ resources).</data>
    </node>
    <node id="2">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Backing store providing search, aggregations, and reporting/analytics.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Backing store that tracks resource configuration changes and detected security violations.</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Data Streams (Rules)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Fronts the rule execution pipeline for evaluating security rules against resource state.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects CPU, memory, and performance metrics from database clusters.</data>
    </node>
    <node id="6">
      <data key="d5">Sharder Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Intelligent service that evaluates CloudWatch metrics to load balance write sharding across Neptune clusters.</data>
    </node>
    <node id="7">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Receives real-time security violation notifications.</data>
    </node>
    <node id="8">
      <data key="d5">Email</data>
      <data key="d6">SES</data>
      <data key="d7">Receives real-time security violation notifications.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Collection framework ingests resource state changes into Amazon Neptune.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="0" target="4">
      <data key="d8">2</data>
      <data key="d9">Incoming events and resource changes are queued into Rules Kinesis Data Stream.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">Resource data is synced to Elasticsearch for search and analytical reporting.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="3">
      <data key="d8">0</data>
      <data key="d9">Resource configurations and state changes are synced to DynamoDB.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="5">
      <data key="d8">1</data>
      <data key="d9">Neptune exports performance metrics like CPU and memory to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="4">
      <data key="d8">2</data>
      <data key="d9">Neptune returns graph evaluation data to the rule processing stream.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="5">
      <data key="d8">1</data>
      <data key="d9">Elasticsearch exports cluster metrics to CloudWatch.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="1">
      <data key="d8">2</data>
      <data key="d9">Rules engine queries Neptune graph database to perform security checks.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="3">
      <data key="d8">2</data>
      <data key="d9">Detected security violations are stored in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="7">
      <data key="d8">2</data>
      <data key="d9">Real-time violation alerts are pushed to Slack.</data>
      <data key="d10">2'</data>
