    </edge>
    <edge source="4" target="8">
      <data key="d8">2</data>
      <data key="d9">Real-time violation alerts are sent via Email.</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="6">
      <data key="d8">1</data>
      <data key="d9">Sharder Service reads CloudWatch metrics to determine database capacity.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="1">
      <data key="d8">1</data>
      <data key="d9">Sharder Service provides logical data grouping and write routing feedback loop to Neptune.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
