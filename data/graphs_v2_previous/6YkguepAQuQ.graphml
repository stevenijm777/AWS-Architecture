<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Dev</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developer who commits code changes and modifies CloudFormation template definitions.</data>
    </node>
    <node id="1">
      <data key="d5">CodeCommit</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">AWS source control repository storing application code and CloudFormation templates.</data>
    </node>
    <node id="2">
      <data key="d5">CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Build service that spins up containers to compile code and produce application images.</data>
    </node>
    <node id="3">
      <data key="d5">Registry</data>
      <data key="d6">ECR</data>
      <data key="d7">Amazon Elastic Container Registry holding compiled container images ready for deployment.</data>
    </node>
    <node id="4">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Infrastructure-as-Code deployment engine implementing Change Set, Approval, and Execution stages.</data>
    </node>
    <node id="5">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">Isolated network environment deployed per client (up to 100 parallel client VPCs).</data>
    </node>
    <node id="6">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Elastic Container Service running deployed task definitions inside the target VPC.</data>
    </node>
    <node id="7">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">AWS IAM managing roles and permissions inside the VPC container environment.</data>
    </node>
    <node id="8">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer distributing traffic inside the target VPC.</data>
    </node>
    <node id="9">
      <data key="d5">CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Overall CI/CD pipeline orchestrator driving source, build, and deploy stages.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Developer commits application code and template updates to CodeCommit.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">CodeCommit commit triggers container compilation build in CodeBuild.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">CodeBuild outputs compiled container image to Amazon ECR Registry.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="4">
      <data key="d8">0</data>
      <data key="d9">Build completion initiates CloudFormation deploy stage.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="5">
      <data key="d8">0</data>
      <data key="d9">Approved CloudFormation change set provisions ECS, IAM, and ALB components across target VPCs.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Aetion: Deploy Applications  Provision Cloud Resources with AWS Developer Tools</data>
    <data key="d1">https://www.youtube.com/watch?v=6YkguepAQuQ</data>
    <data key="d2">Architecture features parallel multi-tenant VPC deployments governed by a single standardized CloudFormation template with a 3-step change set approval workflow.</data>
    <data key="d3">DevOps &amp; Deployment</data>
    <data key="d4">True</data>
  </graph>
</graphml>
