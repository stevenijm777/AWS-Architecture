<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Browser</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Client web browser used by users to log into PixelStrings interface.</data>
    </node>
    <node id="1">
      <data key="d5">WEB SERVER / JOB MANAGER</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance hosting the web front-end interface and job management orchestration service.</data>
    </node>
    <node id="2">
      <data key="d5">DATABASE</data>
      <data key="d6">RDS</data>
      <data key="d7">Database storing cached video clip metadata and job execution status.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda function running MediaInfo tool to extract media metadata.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">User-managed S3 bucket storing raw input and processed output video files.</data>
    </node>
    <node id="5">
      <data key="d5">G3</data>
      <data key="d6">EC2</data>
      <data key="d7">GPU-accelerated EC2 instance cluster executing video retiming, deinterlacing, upscaling, and noise removal.</data>
    </node>
    <node id="6">
      <data key="d5">IMF</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance executing Interoperable Master Format wrapping processes.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">User logs into web interface and passes S3 bucket credentials.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="0">
      <data key="d8">0</data>
      <data key="d9">Web server returns web interface status and session.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="3">
      <data key="d8">0</data>
      <data key="d9">Job manager triggers Lambda function to extract clip metadata.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">Job Manager saves extracted clip metadata to database.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="5">
      <data key="d8">1</data>
      <data key="d9">Job Manager dispatches processing tasks to GPU cluster.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="1">
      <data key="d8">0</data>
      <data key="d9">Web server queries database to display clip metadata in user web browser.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="4">
      <data key="d8">0</data>
      <data key="d9">Lambda accesses user S3 bucket to read file headers.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="1">
      <data key="d8">0</data>
      <data key="d9">Lambda returns extracted media metadata to Job Manager.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="3">
      <data key="d8">0</data>
      <data key="d9">S3 returns file header details to Lambda.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="4">
      <data key="d8">1</data>
      <data key="d9">G3 GPU cluster writes final encoded video files to customer S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">PixelStrings by Cinnafilm: A Flexible &amp; Scalable Platform for Video Audio Optimization &amp; Conversion</data>
    <data key="d1">https://www.youtube.com/watch?v=BZ32w0SSAoY</data>
    <data key="d2">PixelStrings video processing platform architecture on AWS utilizing GPU-accelerated EC2 instances, serverless Lambda metadata extraction, and RDS caching.</data>
    <data key="d3">Media &amp; Entertainment</data>
    <data key="d4">True</data>
  </graph>
</graphml>
