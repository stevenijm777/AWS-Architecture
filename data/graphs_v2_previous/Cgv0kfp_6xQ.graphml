<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">iOS</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">iOS mobile client app sending snaps.</data>
    </node>
    <node id="1">
      <data key="d5">Android</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Android mobile client app receiving pushes and messages.</data>
    </node>
    <node id="2">
      <data key="d5">Gateway</data>
      <data key="d6">EKS</data>
      <data key="d7">API Gateway service running in EKS cluster (900+ EKS clusters with 1000+ instances each).</data>
    </node>
    <node id="3">
      <data key="d5">Media</data>
      <data key="d6">EKS</data>
      <data key="d7">Media delivery microservice inside EKS.</data>
    </node>
    <node id="4">
      <data key="d5">MCS</data>
      <data key="d6">EKS</data>
      <data key="d7">Messaging Connection Service managing persistent client connections.</data>
    </node>
    <node id="5">
      <data key="d5">Friend Graph</data>
      <data key="d6">EKS</data>
      <data key="d7">Friend Graph microservice handling relationship logic.</data>
    </node>
    <node id="6">
      <data key="d5">Snap DB</data>
      <data key="d6">EKS</data>
      <data key="d7">Custom database abstraction layer in EKS handling transactions, TTL, and ephemeral data state.</data>
    </node>
    <node id="7">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Edge location CDN for fast content delivery.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Persistent object store for snap media.</data>
    </node>
    <node id="9">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory cache mapping active client connection IDs and server IDs.</data>
    </node>
    <node id="10">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Primary metadata datastore holding 400TB+ of data, running nightly scans of 2B+ rows/min.</data>
    </node>
    <edge source="0" target="2">
      <data key="d8">0</data>
      <data key="d9">iOS app sends snap payload to Gateway</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">0</data>
      <data key="d9">Gateway routes traffic to Media service</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="4">
      <data key="d8">1</data>
      <data key="d9">Gateway forwards messaging traffic to MCS</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="7">
      <data key="d8">0</data>
      <data key="d9">Media service sends content to CloudFront for recipient caching</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="5">
      <data key="d8">0</data>
      <data key="d9">Media service checks friend relationships via Friend Graph</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="9">
      <data key="d8">1</data>
      <data key="d9">MCS looks up active server connection IDs in ElastiCache</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="6">
      <data key="d8">1</data>
      <data key="d9">MCS writes/queries state via Snap DB layer</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="1">
      <data key="d8">1</data>
      <data key="d9">MCS pushes real-time message/notification to Android client</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="10">
      <data key="d8">1</data>
      <data key="d9">Snap DB syncs persistent metadata to DynamoDB</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="8">
      <data key="d8">0</data>
      <data key="d9">CloudFront reads/persists media objects in S3</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Snap: Journey of a Snap on Snapchat Using AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=Cgv0kfp_6xQ</data>
    <data key="d2">Architecture handles 300M+ DAU, 5B+ Snaps/day, 10M QPS+, running across 900+ EKS clusters.</data>
    <data key="d3">Mobile &amp; Web Apps, Media &amp; Messaging</data>
    <data key="d4">True</data>
  </graph>
</graphml>
