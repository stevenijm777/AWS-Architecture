  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">UserCompanyAgent</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Independent insurance agents accessing the application.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Delivers the single page application frontend to agents and routes backend API requests.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing static web application assets for the SPA frontend.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for backend API calls.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda Authorizer</data>
      <data key="d6">Lambda</data>
      <data key="d7">Custom Lambda authorizer executing validation logic on access tokens.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless Python Lambda function handling core business logic.</data>
    </node>
    <node id="6">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances hosting legacy Tomcat Java application logic awaiting migration.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Regional DynamoDB table used to cache user session data across Availability Zones.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Agents access the single page application via CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="2">
      <data key="d8">0</data>
      <data key="d9">CloudFront fetches static SPA content from the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="3">
      <data key="d8">1</data>
      <data key="d9">Frontend API requests are routed through CloudFront to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="4">
      <data key="d8">1</data>
      <data key="d9">API Gateway triggers Lambda Authorizer to validate permissions.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="5">
      <data key="d8">1</data>
      <data key="d9">API Gateway routes authorized calls to the main Python Lambda function.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="6">
      <data key="d8">1</data>
      <data key="d9">Main Lambda calls the legacy Tomcat application on EC2 for unmigrated functionality.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="5" target="7">
      <data key="d8">1</data>
      <data key="d9">Main Lambda reads and updates cached regional user session data in DynamoDB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="5">
      <data key="d8">1</data>
      <data key="d9">Legacy Tomcat application returns results back to the main Lambda function.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Main Street America Insurance: The Independent Agent Portal, Breaking up the Monolith</data>
    <data key="d1">https://www.youtube.com/watch?v=wjtSHyENv0I</data>
    <data key="d2">Architecture detailing the modernization of an independent insurance agent application from legacy on-premises Tomcat servers to an AWS serverless stack using the strangler fig pattern.</data>
    <data key="d3">Serverless, Migration, Application Modernization</data>
    <data key="d4">True</data>
  </graph>
