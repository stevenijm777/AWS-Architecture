<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d12" for="edge" attr.name="id" attr.type="string" />
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Drones</data>
      <data key="d6">UserCompanyDrone</data>
      <data key="d7">Drones operated by third-party pilots to inspect well pads routines.</data>
    </node>
    <node id="1">
      <data key="d5">3rd Party Software</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External software processing imagery into ortho mosaics, terrain models, and elevation models.</data>
    </node>
    <node id="2">
      <data key="d5">CloudWatch Event</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Scheduled CloudWatch Event triggering the state machine workflow.</data>
    </node>
    <node id="3">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates the sequence of Lambda functions.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes API checks, triggers image transfer to S3, and creates raster proxy metadata.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket storing drone image files.</data>
    </node>
    <node id="6">
      <data key="d5">Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">Enables the on-premises mapping software to access S3 directly.</data>
    </node>
    <node id="7">
      <data key="d5">On-Prem Server</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises mapping software server used by internal maintenance and operations teams.</data>
    </node>
    <node id="8">
      <data key="d5">On-Prem Database</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises database storing raster proxy metadata.</data>
    </node>
    <edge source="0" target="1">
      <data key="d8">0</data>
      <data key="d9">Captured drone imagery is uploaded to the 3rd party software.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="1" target="5">
      <data key="d8">1</data>
      <data key="d9">3rd party software saves image files to S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="2" target="3">
      <data key="d8">1</data>
      <data key="d9">Scheduled CloudWatch Event triggers Step Functions state machine.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="3" target="4">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="1">
      <data key="d8">1</data>
      <data key="d9">Lambda calls 3rd party API to check for new flight data and imagery.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
      <data key="d12">0</data>
    </edge>
    <edge source="4" target="8">
      <data key="d8">1</data>
      <data key="d9">Lambda creates raster proxies and writes metadata to local database.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="6" target="5">
      <data key="d8">2</data>
      <data key="d9">Storage Gateway retrieves image files directly from S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <edge source="7" target="6">
      <data key="d8">2</data>
      <data key="d9">On-prem server queries Storage Gateway for image files.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
      <data key="d12">0</data>
    </edge>
    <data key="d0">Marathon Oil: Automating Drone Image Processing to Monitor Equipment Health</data>
    <data key="d1">https://www.youtube.com/watch?v=ww5fiygF6eg</data>
    <data key="d2">Marathon Oil uses AWS serverless services (Step Functions, Lambda, S3) combined with Storage Gateway to automatically ingest, store, and serve drone imagery to on-premises mapping systems.</data>
    <data key="d3">Serverless, Storage &amp; Hybrid Cloud</data>
    <data key="d4">True</data>
  </graph>
</graphml>
