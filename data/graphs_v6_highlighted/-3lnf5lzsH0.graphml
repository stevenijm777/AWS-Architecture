<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Public cloud telemetry log sources including S3, SNS, SQS, CloudTrail, and GuardDuty.</data>
    </node>
    <node id="1">
      <data key="d5">ON-PREM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises log sources ingested via Syslog or Apache Kafka.</data>
    </node>
    <node id="2">
      <data key="d5">APACHE METRON</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Core big data security framework handling real-time ingestion, parsing, profiling, and contextual enrichment.</data>
    </node>
    <node id="3">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Amazon EMR cluster that transforms persistent HDFS telemetry data into optimized storage formats for S3.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Amazon S3 bucket serving as long-term serverless Security Data Lake storing months to years of telemetry.</data>
    </node>
    <node id="5">
      <data key="d5">ATHENA</data>
      <data key="d6">Athena</data>
      <data key="d7">Amazon Athena querying engine used for log mining, analytics, and security forensics.</data>
    </node>
    <node id="6">
      <data key="d5">SOAR</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Security Orchestration, Automation, and Response platform (Blitz) for contextual alert enrichment.</data>
    </node>
    <node id="7">
      <data key="d5">ALERTS</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Single pane of glass alert presentation to SOC Analysts via mobile or Jira.</data>
    </node>
    <node id="8">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">AWS WAF endpoint executing automated or analyst-driven mitigation responses like IP blocking.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry logs ingested from AWS services into Apache Metron using Apache NiFi workflows.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises telemetry logs streamed into Apache Metron via Syslog/Kafka.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Persistent telemetry in Metron HDFS picked up by EMR job.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Real-time alerts passed from Apache Metron to SOAR engine (Blitz).</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR transforms and stores telemetry into Amazon S3 Security Data Lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries security telemetry data residing in S3 for forensics and analytics.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Long-term profiles and behavioral models generated in Data Lake fed back to Apache Metron for enrichment.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Contextualized alert details presented to SOC Analysts.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Mitigation actions executed on WAF to block threats.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">MakeMyTrip Next-Gen SOC Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-3lnf5lzsH0</data>
    <data key="d2">MakeMyTrip's Next-Gen SOC processing ~5,000 events/sec and 250M events/day using Apache Metron and an AWS-backed Security Data Lake for real-time detection and response.</data>
    <data key="d3">Security, Data Analytics, Log Management</data>
    <data key="d4">True</data>
  </graph>
</graphml>
