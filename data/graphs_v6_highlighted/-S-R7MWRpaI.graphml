<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">SN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Supernode running Edge Engine that listens to regular nodes and reports telemetry</data>
    </node>
    <node id="1">
      <data key="d5">N</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Edge node running Edge Engine (e.g. Android/iOS device)</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Elastic Kubernetes Service running microservices and MDS discovery service</data>
    </node>
    <node id="3">
      <data key="d5">MongoDB</data>
      <data key="d6">DocumentDB</data>
      <data key="d7">Document database storing edge service mesh proximity cluster metadata</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores profile data and hierarchical peer associations</data>
    </node>
    <node id="5">
      <data key="d5">Kinesis Data Streams</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Ingests real-time API logs and business logic telemetry (up to ~1000 msg/sec)</data>
    </node>
    <node id="6">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Buffers and delivers log streams to long-term S3 storage</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Archive destination for all network telemetry and logs</data>
    </node>
    <node id="8">
      <data key="d5">Snowflake</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data warehouse running SQL queries directly over data archived in S3</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Supernode registers with EKS and MDS discovery service</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Supernode streams API logs and telemetry to Kinesis Data Streams</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Edge node registers via Supernode to EKS and MDS</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS reads/writes proximity cluster metadata to MongoDB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS manages profiles and peer associations in DynamoDB</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis Data Streams forwards data to Kinesis Data Firehose</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis Data Firehose loads telemetry data into S3 bucket</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Snowflake queries archived telemetry directly from S3</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mimic Edge Engine Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-S-R7MWRpaI</data>
    <data key="d2">Edge Engine orchestrates edge nodes (e.g. mobile devices/tablets) via Amazon EKS, MongoDB, DynamoDB, and streams logs via Kinesis to S3 and Snowflake.</data>
    <data key="d3">Edge Computing, Analytics, Database</data>
    <data key="d4">True</data>
  </graph>
</graphml>
