<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Runs multi-tenant loan origination application pods with tenant-isolated pods.</data>
    </node>
    <node id="1">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">PostgreSQL database storing multi-tenant data separated by schemas per tenant.</data>
    </node>
    <node id="2">
      <data key="d5">Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Peers QuickSight tenant VPC with the Postgres Aurora VPC.</data>
    </node>
    <node id="3">
      <data key="d5">Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Provisions single-tenant AWS accounts using Account Factory for Terraform.</data>
    </node>
    <node id="4">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Provides single-tenant reporting and data visualization for end customers.</data>
    </node>
    <node id="5">
      <data key="d5">VPN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Connects tenant AWS account to on-premises customer databases.</data>
    </node>
    <node id="6">
      <data key="d5">Cust Data</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises bank database providing additional data to combine with LOS data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS application pods write and read tenant data from isolated Aurora schemas.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Aurora serves queries routed through Transit Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Transit Gateway delivers Aurora data to QuickSight in the tenant account.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Control Tower provisions single-tenant AWS account pre-configured with QuickSight.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">VPN forwards on-premises data to QuickSight to join with Aurora LOS metrics.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">On-premises customer data flows across the VPN connection.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Summit Technology Group Single-Tenant Data Consumption Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-ahWdCysMYw</data>
    <data key="d2">Architecture illustrating multi-tenant SaaS running on EKS and Aurora with single-tenant data visualization and on-prem integration using Control Tower, QuickSight, Transit Gateway, and VPN.</data>
    <data key="d3">SaaS / Analytics / Multi-Tenant Isolation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
