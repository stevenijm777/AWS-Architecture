<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon Macie (Central)</data>
      <data key="d6">Macie</data>
      <data key="d7">Central Macie administrator service aggregating sensitive data discovery findings (achieving 95% accuracy for SSNs and ITINs).</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3 (Central Findings)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Central S3 bucket storing findings metadata (no actual PII) generated by Macie scans.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Interactive SQL query service used to query Macie findings stored in the central S3 bucket.</data>
    </node>
    <node id="3">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">ETL service executing automated workflows to extract, aggregate, and load findings data.</data>
    </node>
    <node id="4">
      <data key="d5">MySQL Data Lake</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom MySQL-based data lake holding aggregated security findings.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Business intelligence dashboard visualizing top risky buckets and PII counts for data owners.</data>
    </node>
    <node id="6">
      <data key="d5">Security Engineers</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Security engineers reviewing dashboard reports and coordinating remediation with bucket owners.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon Macie (Member Account 1)</data>
      <data key="d6">Macie</data>
      <data key="d7">Macie instance deployed in production member account scanning local S3 buckets.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon S3 (Member Account 1)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Production S3 bucket scanned for sensitive member data.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon Macie (Member Account 2)</data>
      <data key="d6">Macie</data>
      <data key="d7">Macie instance deployed in secondary production account.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon S3 (Member Account 2)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Secondary production S3 bucket scanned for sensitive member data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Central Macie outputs findings metadata to the central S3 findings bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Central S3 findings data is read by AWS Glue for automated aggregation processes.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Central S3 findings data is loaded into the custom MySQL data lake.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries findings metadata directly from the central S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">QuickSight queries Athena to generate visual security and DSPM dashboards.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Security engineers analyze QuickSight dashboards to identify risky buckets and drive remediation.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Member Macie performs automated sensitive data discovery scans on local S3 buckets.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Member Macie sends discovery findings metadata to the central S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">0</data>
      <data key="d9">Secondary member Macie scans local production S3 buckets.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Opportune Automated Sensitive Data Discovery and DSPM Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-kA0ahrhX3I</data>
    <data key="d2">Architecture for automated data security posture management (DSPM) across multi-account S3 environments using Amazon Macie, Athena, Glue, MySQL, and QuickSight.</data>
    <data key="d3">Data Security &amp; DSPM</data>
    <data key="d4">True</data>
  </graph>
</graphml>
