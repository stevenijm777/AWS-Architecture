<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Migration Team</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Human migration team triggering and controlling migration automation.</data>
    </node>
    <node id="1">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">ChatOps interface used by the migration team to execute migration triggers.</data>
    </node>
    <node id="2">
      <data key="d5">On-Prem</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Source on-premises server environment containing data and applications to be migrated.</data>
    </node>
    <node id="3">
      <data key="d5">App Discovery Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Collects network connection data and performance utilization metrics from on-premises servers.</data>
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores operational metadata including RTO/RPO requirements, tags, target account, subnets, and IPs.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Migration Factory</data>
      <data key="d6">EC2</data>
      <data key="d7">Orchestrator instance executing automated API calls to discover, stop replication, bake AMIs, and launch target instances.</data>
    </node>
    <node id="6">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Replication engine orchestrating continuous block-level volume replication to AWS.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Hot Replica</data>
      <data key="d6">EC2</data>
      <data key="d7">Staging EC2 instance continuously receiving replicated block storage volumes from on-premises.</data>
    </node>
    <node id="8">
      <data key="d5">EC2 Target Account</data>
      <data key="d6">EC2</data>
      <data key="d7">Final EC2 instance launched in the target account with applied metadata, sizing, and firewall configurations.</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration team populates operational metadata and target configurations in DynamoDB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration team issues a single command in Slack to initiate automated cutover.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Slack calls API on EC2 Migration Factory instance to trigger migration workflow.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises servers send network connection and utilization metadata to Application Discovery Service.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Continuous block-level volume replication flows from on-premises server to EC2 Hot Replica.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory queries Application Discovery Service API for server connection metrics.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory makes API call to CloudEndure to freeze continuous replication.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 Migration Factory bakes AMI, shares it with target account using DynamoDB metadata, and launches the target EC2 instance.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudEndure stops volume replication on the staging EC2 Hot Replica instance.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Versent Automated AWS Cloud Migration Factory</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Architecture reduces server migration time from 4 hours to ~10 minutes via automated ChatOps triggers, live block replication, and AMI bake/share automation.</data>
    <data key="d3">Migration, Automation</data>
    <data key="d4">True</data>
  </graph>
</graphml>
