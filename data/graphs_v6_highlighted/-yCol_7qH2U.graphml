<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Data scientist uploading model serialized artifacts (.pkl) and config files.</data>
    </node>
    <node id="1">
      <data key="d5">UI Portal</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom web user interface providing seamless model onboarding steps.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Fargate (API)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Backend platform API service handling model upload requests.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon OpenSearch Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data store acting as the central model registry.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon S3</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores uploaded serialized model pickle files and library code.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Managed Streaming for Apache Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Event bus topic orchestrating build triggers and status events.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon EC2</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Build host running Docker to assemble SageMaker-compatible container images.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon ECR</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Container registry storing built model Docker images.</data>
    </node>
    <node id="8">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Managed service hosting auto-scaling model inferencing endpoints.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon EventBridge</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Captures asynchronous endpoint state changes from SageMaker.</data>
    </node>
    <node id="10">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Processes endpoint change events and relays messages to MSK.</data>
    </node>
    <node id="11">
      <data key="d5">AWS Fargate (Consumer)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Consumer application that updates OpenSearch and status in the UI.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User uploads model files via the UI Portal.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">UI Portal triggers platform API on AWS Fargate.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API creates an initial entry in the OpenSearch model registry.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">API stores model artifacts into Amazon S3.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">API writes build initiation event to MSK topic.</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">MSK event triggers EC2 build machine.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">MSK topic triggers Fargate consumer app.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 build process fetches artifacts from Amazon S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 builds and pushes container image to ECR.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 configures scaling policies and creates SageMaker endpoint.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">SageMaker emits endpoint status change events to EventBridge.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">EventBridge invokes Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda publishes notification to MSK topic.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Consumer app updates model registry with endpoint details.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Consumer app updates deployment status on the UI Portal.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Experian Custom Model Onboarding Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=-yCol_7qH2U</data>
    <data key="d2">Architecture enables data scientists to onboard custom ML models in days/clicks using automated container builds on EC2, ECR, SageMaker, and asynchronous status tracking via MSK and EventBridge.</data>
    <data key="d3">Machine Learning &amp; Event-Driven Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
