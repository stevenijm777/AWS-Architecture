<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user uploading photos and requesting animations.</data>
    </node>
    <node id="1">
      <data key="d5">API</data>
      <data key="d6">EC2</data>
      <data key="d7">API server hosted on EC2; issues pre-signed S3 upload URLs and handles status polling.</data>
    </node>
    <node id="2">
      <data key="d5">Main SQS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Main input queue receiving animation requests.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Dynamic routing Lambda function evaluating GPU spot capacity across regions.</data>
    </node>
    <node id="4">
      <data key="d5">GPU</data>
      <data key="d6">EC2</data>
      <data key="d7">Main region EC2 GPU fleet (mix of On-Demand and Spot instances) processing deep learning animations.</data>
    </node>
    <node id="5">
      <data key="d5">Local SQS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Local region SQS queue holding active jobs and completion notifications.</data>
    </node>
    <node id="6">
      <data key="d5">State Manager</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance processing job completion messages.</data>
    </node>
    <node id="7">
      <data key="d5">MySQL</data>
      <data key="d6">RDS</data>
      <data key="d7">RDS MySQL database tracking job state and metadata.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores uploaded source images and generated output video artifacts.</data>
    </node>
    <node id="9">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN caching and distributing generated animation videos via signed URLs.</data>
    </node>
    <node id="10">
      <data key="d5">Secondary SQS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">SQS queues located in 5+ secondary AWS regions.</data>
    </node>
    <node id="11">
      <data key="d5">Secondary GPU</data>
      <data key="d6">EC2</data>
      <data key="d7">GPU fleets deployed in 5+ secondary AWS regions.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests pre-signed S3 URL from API server.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="1" id="1">
      <data key="d8">3</data>
      <data key="d9">User polls API server for animation status.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="0" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">User directly uploads source image to S3 using pre-signed URL.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">User requests completed video artifact via CloudFront signed URL.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API server pushes animation request to Main SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">API queries job completion status from MySQL database.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda pulls message from Main SQS queue.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda routes message to Local SQS queue in the main region.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda routes message to Secondary SQS queue in one of 5+ regions based on spot capacity.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">GPU instance writes generated video artifact to S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">GPU instance sends completion status notification to Local SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Main region GPU instance pulls job from Local SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">State Manager consumes completion notification from Local SQS queue.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">State Manager updates task status and metadata in MySQL RDS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">CloudFront fetches and caches video artifact from S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Secondary region GPU instance pulls job from Secondary SQS queue.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">MyHeritage Deep Nostalgia Multi-Region Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=0-db3wFRfSc</data>
    <data key="d2">Deep Nostalgia architecture processes millions of AI photo animations using dynamic cross-region Lambda routing to tap into EC2 GPU spot instance capacity across 5+ AWS regions.</data>
    <data key="d3">Media Processing, Multi-Region Compute, Queue-Based Decoupling</data>
    <data key="d4">True</data>
  </graph>
</graphml>
