  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Uploads raw video/media content</data>
    </node>
    <node id="1">
      <data key="d5">Amazon S3</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Entry bucket for uploaded media files</data>
    </node>
    <node id="2">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates transcoding, technical metadata extraction, visual analysis, and transcript processing</data>
    </node>
    <node id="3">
      <data key="d5">AWS Elemental MediaConvert</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Generates proxy media files for browser playback and visual verification</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Rekognition</data>
      <data key="d6">Rekognition</data>
      <data key="d7">Extracts visual tags, celebrities, violence, and nudity associated with video timecodes</data>
    </node>
    <node id="5">
      <data key="d5">Amazon Transcribe</data>
      <data key="d6">Transcribe</data>
      <data key="d7">Converts audio track into text transcripts</data>
    </node>
    <node id="6">
      <data key="d5">Amazon Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Analyzes transcript text for entities and profanity detection</data>
    </node>
    <node id="7">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Temporary store for all extracted metadata, proxies, and AI/ML tags</data>
    </node>
    <node id="8">
      <data key="d5">Amazon EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts Reach Engine platform infrastructure</data>
    </node>
    <node id="9">
      <data key="d5">Amazon ECS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Runs Reach Engine container workloads for playback, search, and client orchestration</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
