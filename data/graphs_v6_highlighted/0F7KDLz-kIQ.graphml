  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Route 53 (External)</data>
      <data key="d6">Route53</data>
      <data key="d7">External DNS entry point for incoming client API requests</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN layer receiving traffic from external Route 53</data>
    </node>
    <node id="2">
      <data key="d5">Route 53 (Internal)</data>
      <data key="d6">Route53</data>
      <data key="d7">Internal DNS used for real-time dynamic weighted traffic splitting between containerized and serverless backends</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Container orchestration service running core business logic</data>
    </node>
    <node id="4">
      <data key="d5">Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Serverless compute engine executing ECS container tasks</data>
    </node>
    <node id="5">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">API management layer routing requests to serverless Lambda functions</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute functions absorbing traffic spikes during ECS auto-scaling windows</data>
    </node>
    <node id="7">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors ECS container load and system health metrics</data>
    </node>
    <node id="8">
      <data key="d5">AWS SDK</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Programmatically updates internal Route 53 traffic weights based on CloudWatch metrics</data>
    </node>
    <node id="9">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory caching store for volatile data and fast response performance</data>
    </node>
    <node id="10">
      <data key="d5">Document DB</data>
      <data key="d6">DocumentDB</data>
      <data key="d7">Document database used for high-read and unstructured property data</data>
    </node>
    <node id="11">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database used for standard transactional CRUD operations</data>
    </node>
    <node id="12">
      <data key="d5">ElasticSearch</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Used for property search engine queries and application log aggregation/troubleshooting</data>
    </node>
    <node id="13">
      <data key="d5">CDK</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Infrastructure as Code tool used for defining and deploying all cloud infrastructure</data>
    </node>
