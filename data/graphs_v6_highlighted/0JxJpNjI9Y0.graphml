<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Public Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Public users initiating web page request traffic.</data>
    </node>
    <node id="1">
      <data key="d5">ECS Origin</data>
      <data key="d6">ECS</data>
      <data key="d7">Origin cluster running on ECS that handles traffic routing upon CDN cache misses.</data>
    </node>
    <node id="2">
      <data key="d5">Static Resources</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing static web assets like JavaScript and CSS files.</data>
    </node>
    <node id="3">
      <data key="d5">Newsroom / Developer</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Newsroom staff managing page layouts and developers deploying site rendering code.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">AWS Lambda executing site rendering code dynamically on full cache misses (5-10% of traffic).</data>
    </node>
    <node id="5">
      <data key="d5">Pre-rendered Content</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket storing pre-rendered HTML web pages for high-availability access.</data>
    </node>
    <node id="6">
      <data key="d5">ECS Proxy</data>
      <data key="d6">ECS</data>
      <data key="d7">Secondary ECS cluster acting as a proxy to fetch external content over the internet.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">DynamoDB table storing web templates and page layout configurations created by newsroom users.</data>
    </node>
    <node id="8">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">In-memory cache storing raw JSON content objects with a TTL.</data>
    </node>
    <node id="9">
      <data key="d5">CMS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External content management systems and third-party APIs (sports, weather, etc.).</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Public users issue requests for web pages to the ECS Origin.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS Origin fetches static assets (JS/CSS) from the Static Resources S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS Origin checks S3 for pre-rendered HTML content.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Developers deploy site rendering JavaScript code to AWS Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Newsroom users store page template configurations and layouts in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">On cache misses, Lambda calls the ECS Proxy to fetch required external content objects.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda saves rendered HTML output to the Pre-rendered Content S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Lambda reads web template configurations from DynamoDB during dynamic page rendering.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS Proxy checks/stores raw JSON content objects into ElastiCache with a specified TTL.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">ECS Proxy fetches raw story, media, or API content from external CMS services over the internet.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Washington Post Arc Publishing Web Rendering Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=0JxJpNjI9Y0</data>
    <data key="d2">Web rendering and content management architecture for Arc Publishing at Washington Post, handling dynamic rendering, caching with ElastiCache/S3, and template storage via DynamoDB.</data>
    <data key="d3">Web Application, Serverless, Caching &amp; CDN</data>
    <data key="d4">True</data>
  </graph>
</graphml>
