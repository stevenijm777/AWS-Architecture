  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Transit Gateway</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Interconnects AWS accounts and VPCs with on-premises data centers in Texas and Washington.</data>
    </node>
    <node id="1">
      <data key="d5">Data Center (TX, WA)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises enterprise data centers in Texas and Washington state.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Load balances incoming requests within the application VPC across compute instances.</data>
    </node>
    <node id="3">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts standardized Kubernetes clusters running thousands of application containers.</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects logs and operational metrics, integrated with Prometheus for centralized monitoring.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Object storage bucket available within the AWS environment.</data>
    </node>
    <node id="6">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational database service consumed by application services.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Transit Gateway routes incoming hybrid network traffic to the ELB within the application VPC.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises data centers connect bi-directionally to AWS Transit Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB distributes application traffic across Kubernetes compute nodes running on EC2.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Application containers on EC2 query and persist application data in Amazon RDS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 container workloads emit log and metric data to CloudWatch for observability.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">T-Mobile Standardized Kubernetes Deployment and Hybrid Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=1ZLiRT0C2Yo</data>
    <data key="d2">Architecture illustrating T-Mobile's standardized GitOps-driven Kubernetes infrastructure deployment spanning hybrid data centers and AWS regions/local zones.</data>
    <data key="d3">Hybrid Cloud, Containers, Automation</data>
    <data key="d4">True</data>
