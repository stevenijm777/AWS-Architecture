<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user accessing the Orion portal to create or manage application environments.</data>
    </node>
    <node id="1">
      <data key="d5">ROUTE 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Handles DNS resolution for the Orion portal.</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Application Load Balancer distributing incoming web portal traffic to cluster pods.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Container orchestrator running 10,000+ pods and managing microservice provisioning jobs.</data>
    </node>
    <node id="4">
      <data key="d5">SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">100% EC2 Spot Instances hosting underlying worker nodes and Kubernetes pods for optimal cost efficiency.</data>
    </node>
    <node id="5">
      <data key="d5">SNS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Receives deployment status and event updates when microservice jobs start or fail.</data>
    </node>
    <node id="6">
      <data key="d5">SQS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Queues microservice deployment job events for state tracking and task recovery.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User initiates request to Orion portal, resolving DNS via Route 53.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 routes request to Application Load Balancer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB forwards web request to application pods running on EC2 Spot Instances.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Microservice creation jobs managed by EKS trigger status events to SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS fans out job status events to SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Replacement pods on Spot instances inspect SQS for unfinished tasks to complete interrupted deployments.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">OLX Autos Internal Developer Platform Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=1aYoIZvabbk</data>
    <data key="d2">OLX Autos built an internal developer platform (Orion) on Amazon EKS with 100% EC2 Spot instances to accelerate deployment velocity across 11 global markets. Amazon SNS and SQS manage state consistency during spot termination events.</data>
    <data key="d3">Compute, Containers, Messaging</data>
    <data key="d4">True</data>
  </graph>
</graphml>
