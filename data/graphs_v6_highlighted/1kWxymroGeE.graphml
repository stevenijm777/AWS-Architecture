<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Application Data Types</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Monolith application data categorized into binary, relational, key-value configuration, and sensitive encrypted data.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores unstructured binary blob data and key-value document data.</data>
    </node>
    <node id="2">
      <data key="d5">Aurora Serverless</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores core relational data defining applications, isolated per tenant/customer.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Offloads configuration and key-value pair data from relational database for higher agility and lower cost.</data>
    </node>
    <node id="4">
      <data key="d5">Secrets Manager</data>
      <data key="d6">SecretsManager</data>
      <data key="d7">Stores sensitive encrypted data directly, avoiding pre-encryption in the relational database.</data>
    </node>
    <node id="5">
      <data key="d5">KMS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Generates per-tenant KMS keys for data encryption at rest and enables Bring Your Own Key (BYOK) strategies.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Binary blob data directed to S3 storage.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Core relational data directed to Aurora Serverless.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Configuration key-value data offloaded to DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Sensitive encrypted data stored directly in Secrets Manager.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">KMS provides per-tenant encryption key management to S3.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">KMS provides per-tenant encryption key management to Aurora Serverless.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">KMS provides per-tenant encryption key management to DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">OutSystems Monolith Data Decomposition Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=1kWxymroGeE</data>
    <data key="d2">OutSystems decomposes monolith data into purpose-built AWS storage and database services (S3, Aurora Serverless, DynamoDB, Secrets Manager) using KMS per-tenant encryption keys for multi-tenancy isolation and BYOK support.</data>
    <data key="d3">Data Decomposition, Multi-Tenant Security, Serverless Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
