<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USERS</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End users presenting digital credentials (e.g., vaccine pass PDF, photo, or screenshot).</data>
    </node>
    <node id="1">
      <data key="d5">CREDENTIAL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Digital credential payload submitted by users for pre-verification.</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Entry point balancing incoming verification traffic.</data>
    </node>
    <node id="3">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall executing sanity checks on request headers and content length.</data>
    </node>
    <node id="4">
      <data key="d5">EKS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">EKS cluster hosting backend microservices that perform credential verification.</data>
    </node>
    <node id="5">
      <data key="d5">TERRAFORM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Infrastructure as Code tool used to provision and reproduce identical environments.</data>
    </node>
    <node id="6">
      <data key="d5">SHIELD ADVANCED</data>
      <data key="d6">Shield</data>
      <data key="d7">DDoS protection service providing access to Shield Response Team during traffic spikes.</data>
    </node>
    <node id="7">
      <data key="d5">AUTOSCALING</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Automatically scales EKS compute resources out during peak events and in during normal workload.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User submits digital credential to application.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Credential request hits the Elastic Load Balancer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB passes request to WAF for header inspection and security checks.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ELB forwards verified requests to microservices running on EKS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Matter Verifier API Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=1xLjtJnfZes</data>
    <data key="d2">Architecture of Matter's Verifier API for verifying New Zealand My Vaccine Pass credentials using AWS EKS, WAF, Shield Advanced, and Auto Scaling.</data>
    <data key="d3">Security, Compute, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
