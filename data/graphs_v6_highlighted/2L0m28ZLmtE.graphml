  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Data scientists and analysts accessing the analytics platform.</data>
    </node>
    <node id="1">
      <data key="d5">SANOFI SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Corporate single sign-on system for enterprise identity federation.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN distribution holding the SSL certificate for secure frontend access.</data>
    </node>
    <node id="3">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user authentication and identity federation with Sanofi SSO.</data>
    </node>
    <node id="4">
      <data key="d5">Static Website S3</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Hosts static web portal assets.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles dynamic REST API routing for portal functionalities and audit logging.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores user metadata and full audit logs of user actions on the portal.</data>
    </node>
    <node id="7">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Deploys standardized CloudFormation products with isolated configurations.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless functions executing SDK calls to AI/ML services.</data>
    </node>
    <node id="9">
      <data key="d5">RStudio</data>
      <data key="d6">EC2</data>
      <data key="d7">Isolated EC2 environment running RStudio for analytics.</data>
    </node>
    <node id="10">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Encrypted SageMaker Notebook instance with 100 GB storage for individual user workloads.</data>
    </node>
    <node id="11">
      <data key="d5">Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Translates raw text files at scale into target languages.</data>
    </node>
    <node id="12">
      <data key="d5">Comprehend Medical</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Performs medical entity detection and de-identification in raw text.</data>
    </node>
    <node id="13">
      <data key="d5">Data Lake</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Central secure repository storing sensitive health and analytics data.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Users request web portal through CloudFront distribution.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront retrieves static portal assets from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Cognito federates authentication with corporate Sanofi SSO.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Web portal initiates authentication workflow with Cognito.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Portal frontend sends API calls to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Portal sends provisioning requests to Service Catalog.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway records user actions and retrieves metadata in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">API Gateway invokes Lambda function for AI processing.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions isolated RStudio EC2 instances.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions encrypted SageMaker Notebook instances.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda invokes Amazon Translate for raw text translation.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="12" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda invokes Comprehend Medical for medical entity detection.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
