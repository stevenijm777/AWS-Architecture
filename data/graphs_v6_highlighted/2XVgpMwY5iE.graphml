  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Pathologist</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Annotates medical images on EKS and validates model predictions.</data>
    </node>
    <node id="1">
      <data key="d5">Hospital</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sends raw medical images (~5TB per project) to the input S3 bucket.</data>
    </node>
    <node id="2">
      <data key="d5">S3 (Input)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores uploaded raw medical image datasets.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Hosts the labeling platform for pathologists and runs model inference.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains machine learning models per project in parallel.</data>
    </node>
    <node id="5">
      <data key="d5">S3 (Output)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores trained model artifacts and evaluation results.</data>
    </node>
    <node id="6">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">Provides high-performance file storage for SageMaker during model training.</data>
    </node>
    <node id="7">
      <data key="d5">IAM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Manages security and compliance controls required for health data storage (HDS).</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Pathologists upload medical image files (~5TB) to the input S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Hospitals submit raw patient image data to the input S3 bucket.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Input images are retrieved from S3 by the Kubernetes labeling platform for pathologist annotation.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Enriched and labeled data is passed from EKS to SageMaker to train project-specific models.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker uses FSx high-performance storage to achieve 30x faster training speeds.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker exports trained models and output results to the output S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Trained models and results are exported from S3 back to EKS for validation and inference.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">IAM secures access control and ensures HDS compliance for training pipelines.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
