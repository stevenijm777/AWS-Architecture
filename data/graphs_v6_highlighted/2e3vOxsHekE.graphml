<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Fire Hydrant</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Smart fire hydrant IoT device collecting acoustic signals from the pipe network.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Handles security and authentication for incoming IoT data transfers.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores and persists daily acoustic signal data files.</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Runs intensive microservices to process acoustic signals and identify node pair correlations.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">ML endpoint classifying persistent correlations to assign leak probability scores.</data>
    </node>
    <node id="5">
      <data key="d5">Analyst</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Human analyst reviewing leak scores to direct field investigations.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Fire hydrants push recorded acoustic signal files daily via API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway securely forwards and persists acoustic files into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Daily batch process in ECS reads acoustic files from S3 for signal correlation processing.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ECS sends identified persistent correlations to the SageMaker ML endpoint.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker feeds leak probability scores to the human analyst team.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mueller Water Products Intelligent Water Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=2e3vOxsHekE</data>
    <data key="d2">An intelligent water platform ingesting acoustic IoT data from smart fire hydrants to predict and classify pipe leaks using ECS and SageMaker.</data>
    <data key="d3">IoT, Machine Learning, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
