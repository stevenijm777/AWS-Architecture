  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">C</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Client application or end-user interacting with the Appway SaaS environment.</data>
    </node>
    <node id="1">
      <data key="d5">COGNITO</data>
      <data key="d6">Cognito</data>
      <data key="d7">Handles user authentication using OpenID Connect, supporting direct user management or federation with corporate IdPs.</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Performs SSL offloading and distributes incoming client HTTP/HTTPS requests to the backend EC2 cluster.</data>
    </node>
    <node id="3">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs Appway Java web application nodes inside Tomcat across multiple Availability Zones, clustered via Hazelcast.</data>
    </node>
    <node id="4">
      <data key="d5">EFS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Provides central shared persistent cluster storage for all Appway backend nodes.</data>
    </node>
    <node id="5">
      <data key="d5">S2S VPN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Establishes dedicated secure IPsec VPN tunnels to on-premises customer networks and core banking systems.</data>
    </node>
    <node id="6">
      <data key="d5">CONTROL TOWER</data>
      <data key="d6">ControlTower</data>
      <data key="d7">Applies guardrails and governance policies across all provisioned customer accounts.</data>
    </node>
    <node id="7">
      <data key="d5">ORGANIZATIONS</data>
      <data key="d6">Organizations</data>
      <data key="d7">Manages dedicated AWS accounts per tenant to guarantee strong multi-tenant isolation.</data>
    </node>
    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Hosts the React-based single-page application used by the cloud automation team.</data>
    </node>
    <node id="9">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes management APIs called by the admin portal UI.</data>
    </node>
    <node id="10">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes administrative tasks such as provisioning accounts, deploying clusters, and managing software updates.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Client authenticates through Cognito using OpenID Connect.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Client sends application request traffic to the ALB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Client connects securely to private on-premises backend systems via S2S VPN.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB offloads SSL and routes requests to EC2 application cluster nodes.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 application instances access shared central storage on Amazon EFS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Control Tower applies automated guardrails and security policies across AWS Organizations.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">React single-page app hosted on S3 makes REST calls to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway triggers Lambda functions to perform backend environment operations.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Appway Multi-Tenant SaaS Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=2f_NYiPJQt4</data>
    <data key="d2">Appway deploys isolated customer accounts managed via AWS Organizations and Control Tower, utilizing an EC2-based multi-AZ web cluster with central EFS storage and a serverless management plane.</data>
    <data key="d3">SaaS Platform, Financial Services, Serverless Management, Security Governance</data>
    <data key="d4">True</data>
  </graph>
