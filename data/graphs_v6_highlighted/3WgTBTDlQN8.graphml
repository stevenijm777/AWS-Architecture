  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Mobile Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Mobile device application for daily fantasy sports users.</data>
    </node>
    <node id="1">
      <data key="d5">Web Client</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Desktop browser interface for daily fantasy sports users.</data>
    </node>
    <node id="2">
      <data key="d5">API</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point handling incoming user requests from web and mobile applications.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless compute processing user requests, game updates, and data pipeline triggers.</data>
    </node>
    <node id="4">
      <data key="d5">CW</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Triggers Lambda function after match start event.</data>
    </node>
    <node id="5">
      <data key="d5">GAME APIs</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External game feed provider sending score and point updates.</data>
    </node>
    <node id="6">
      <data key="d5">MongoDB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Primary operational database storing user data, match details, and leaderboards.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Centralized data lake storing match data and score updates.</data>
    </node>
    <node id="8">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs Spark jobs to process leaderboard calculations and estimate winnings.</data>
    </node>
    <node id="9">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse used for analytics on user promotions, coupons, and free entries.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Mobile users submit API requests.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Web users submit API requests.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
