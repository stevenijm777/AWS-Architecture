<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User / Devices</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">External users and hardware devices generating geospatial data.</data>
    </node>
    <node id="1">
      <data key="d5">S3 (Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized S3 bucket in the Data account holding licensed geospatial data.</data>
    </node>
    <node id="2">
      <data key="d5">EKS (Data)</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS cluster in the Data account managing data streaming back to users.</data>
    </node>
    <node id="3">
      <data key="d5">VPC Peering</data>
      <data key="d6">VPC</data>
      <data key="d7">VPC Peering connection linking Data account to Dev, QA, and Production processing accounts over the AWS backbone.</data>
    </node>
    <node id="4">
      <data key="d5">EKS (Processing)</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS cluster in the Processing account running containerized microservices for user experience and job coordination.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue holding S3 event notification messages for file processing jobs.</data>
    </node>
    <node id="6">
      <data key="d5">ASG</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto Scaling Groups hosting EC2 instances tailored with specific CPU and memory profiles for processing tasks.</data>
    </node>
    <node id="7">
      <data key="d5">S3 (Processing)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket in the User/Processing account for direct uploads and processed asset outputs.</data>
    </node>
    <edge source="0" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">User uploads file directly to S3 using pre-signed URL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Geospatial data stored in S3 is accessed by EKS in the Data account.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS routes streaming data to VPC Peering router.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">VPC Peering securely shares data across AWS backbone to EKS in processing environments.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">EKS microservice component polls and listens to SQS queue for incoming messages.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">EKS sends task orchestration signal to Auto Scaling Group EC2 processing instances.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Messages from SQS queue are picked up to initiate processing steps in ASG instances.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 upload completion triggers an event notification sent to SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Hexagon Cloud-Based Geospatial Data Processing Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=3yJZ6rPoZfg</data>
    <data key="d2">Hexagon Digital Reality cloud platform uses a multi-account architecture connected via VPC Peering. Users upload geospatial data directly to S3 via pre-signed URLs, triggering SQS notifications processed by EKS containers orchestrating tasks across specialized Auto Scaling Group EC2 instances.</data>
    <data key="d3">Data Processing, Geospatial, Containerization</data>
    <data key="d4">True</data>
  </graph>
</graphml>
