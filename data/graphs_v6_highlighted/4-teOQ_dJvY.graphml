<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">PRODUCER</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External locomotive/track sensors producing approximately 3 million data samples daily.</data>
    </node>
    <node id="1">
      <data key="d5">LAMBDA (Top)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Ingestion Lambda function taking raw sensor data in any format.</data>
    </node>
    <node id="2">
      <data key="d5">KINESIS (Top)</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Ingestion Kinesis stream buffering incoming raw sensor payloads.</data>
    </node>
    <node id="3">
      <data key="d5">KINESIS ANALYTICS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Analytics application filtering out irrelevant data and reducing volume to critical metrics.</data>
    </node>
    <node id="4">
      <data key="d5">KINESIS (Middle)</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Central harmonized Kinesis stream collecting normalized data from all ingestion streams.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA (Bottom)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Data management Lambda handling read/write operations for DynamoDB and API Gateway responses.</data>
    </node>
    <node id="6">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">NoSQL database holding train state and digital twin condition data.</data>
    </node>
    <node id="7">
      <data key="d5">API GW</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">REST API interface providing consumer applications access to digital twin data.</data>
    </node>
    <node id="8">
      <data key="d5">CONSUMER</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External algorithm or system requesting and receiving train condition assessments.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Locomotive sensors send raw sensor data to ingestion Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Ingestion Lambda forwards payload into top Kinesis stream.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw stream feeds data into Kinesis Data Analytics.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Filtered and normalized data is sent to central harmonized Kinesis stream.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Harmonized Kinesis stream triggers bottom processing Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Processing Lambda formats and updates state data in DynamoDB digital twin store.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Processing Lambda delivers formatted state payload to API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">DynamoDB returns digital twin condition state to processing Lambda upon request.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway returns digital twin data to external consumer/algorithm.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">SBB Cargo Digital Twin Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=4-teOQ_dJvY</data>
    <data key="d2">Real-time train sensor ingestion and digital twin processing architecture using AWS Serverless and Kinesis services.</data>
    <data key="d3">IoT / Real-time Analytics / Serverless Architecture</data>
    <data key="d4">True</data>
  </graph>
</graphml>
