<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosts the API service based on a customized Sixpack open-source core engine handling high QPS.</data>
    </node>
    <node id="1">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">ElastiCache Redis service storage offering low latency for A/B testing data.</data>
    </node>
    <node id="2">
      <data key="d5">Elasticsearch</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Receives real-time metrics for search and indexing.</data>
    </node>
    <node id="3">
      <data key="d5">Kibana</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Provides real-time dashboards and visualization for metrics stored in Elasticsearch.</data>
    </node>
    <node id="4">
      <data key="d5">Airflow</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Apache Airflow hosted on EKS to manage and orchestrate periodic data refinement jobs.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores relational service operational data.</data>
    </node>
    <node id="6">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Executes periodic ETL and data refinement processing.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Central storage / data lake for real-time metric logs and refined batch datasets.</data>
    </node>
    <node id="8">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">Runs serverless queries on processed datasets residing in S3.</data>
    </node>
    <node id="9">
      <data key="d5">BI Dashboard</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Displays A/B test results and analytics generated via Athena queries.</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Real-time metric data is streamed from ElastiCache Redis to Elasticsearch.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Real-time metrics are concurrently sent from ElastiCache to S3 for persistent storage.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Service data from RDS is processed by EMR for data cleaning and ETL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Refined data output from EMR is stored into S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Data stored in S3 is queried by Athena.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Athena query results feed into the BI Dashboard for visualization.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mesh Korea A/B Testing Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=40dhk6OABJE</data>
    <data key="d2">Mesh Korea's A/B testing platform designed to handle ~10,000 QPS, using EKS for API services, ElastiCache Redis for fast service storage, Elasticsearch/Kibana for real-time metric visualization, Airflow for workflow orchestration, and RDS/EMR/S3/Athena for data refinement and BI analytics.</data>
    <data key="d3">Analytics &amp; Data Lakes, Compute</data>
    <data key="d4">True</data>
  </graph>
</graphml>
