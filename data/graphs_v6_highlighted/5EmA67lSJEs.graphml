  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Content Originators</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Advertisers and brands uploading content via UI, API, or Java media uploader agent</data>
    </node>
    <node id="1">
      <data key="d5">Media Outlets</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Broadcasters and digital outlets retrieving published ad media</data>
    </node>
    <node id="2">
      <data key="d5">ELB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Front-end load balancer routing UI, API, and agent check-in traffic</data>
    </node>
    <node id="3">
      <data key="d5">Firewall</data>
      <data key="d6">WAF</data>
      <data key="d7">Web Application Firewall monitoring ELB traffic to block promiscuous requests</data>
    </node>
    <node id="4">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN distributing digital video advertisements with S3 origin</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Ad cloud storage holding master files and transcoded ad variations</data>
    </node>
    <node id="6">
      <data key="d5">APP</data>
      <data key="d6">EC2</data>
      <data key="d7">Application server fleet fronted by UI/API for user interaction</data>
    </node>
    <node id="7">
      <data key="d5">SQS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Priority-based asynchronous message queues supporting time-sensitive deliveries</data>
    </node>
    <node id="8">
      <data key="d5">QC / TRANS</data>
      <data key="d6">EC2</data>
      <data key="d7">Transcoding and quality control EC2 worker fleet converting assets into broadcast-ready formats</data>
    </node>
    <node id="9">
      <data key="d5">BATCH</data>
      <data key="d6">EC2</data>
      <data key="d7">Batch processing EC2 fleet running custom work distribution applications</data>
    </node>
