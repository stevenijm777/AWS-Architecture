<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Database</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Legacy database (IBM Netezza) holding source data on-premises.</data>
    </node>
    <node id="1">
      <data key="d5">Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">On-premises gateway ingesting daily increments (~100 GB) via NFS volumes with AES-256 encryption.</data>
    </node>
    <node id="2">
      <data key="d5">Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Dual 10Gbps dedicated hybrid connection with SSL encryption.</data>
    </node>
    <node id="3">
      <data key="d5">Landing S3 Bucket</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Landing zone bucket storing ingested real-time raw data with a 2-day retention policy.</data>
    </node>
    <node id="4">
      <data key="d5">Transformation S3 Bucket</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Intermediate storage for cleansed data with a 1-day retention policy.</data>
    </node>
    <node id="5">
      <data key="d5">Publish S3 Bucket</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores published data for daily dashboards and reports with 1 year and 1 month retention.</data>
    </node>
    <node id="6">
      <data key="d5">Glacier</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Long-term archival storage for published data after expiration.</data>
    </node>
    <node id="7">
      <data key="d5">Quality Cleansing EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 compute node running data quality and cleansing routines using metadata from RDS.</data>
    </node>
    <node id="8">
      <data key="d5">Transformation EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 compute node transforming cleansed data into facts and dimensions.</data>
    </node>
    <node id="9">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">PostgreSQL instance holding ELT metadata, pipeline orchestration logic, and transformation scripts.</data>
    </node>
    <node id="10">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Target cloud data warehouse accessed via Redshift Spectrum for reporting and publishing.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises database feeds data into Storage Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Storage Gateway transmits daily increments via Direct Connect.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Direct Connect delivers ingested data to the Landing S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Quality Cleansing EC2 instance reads raw data from Landing S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Transformation EC2 instance pulls cleansed data from Transformation S3 bucket.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lifecycle rule moves expired published data from Publish S3 to S3 Glacier for long-term retention.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Quality Cleansing EC2 pushes cleansed data to Transformation S3 bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS supplies metadata and cleansing scripts to Quality Cleansing EC2.</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS supplies metadata and transformation rules to Transformation EC2.</data>
      <data key="d10">5'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift publishes formatted report data into Publish S3 bucket using Redshift Spectrum.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">IBM Netezza to AWS Redshift Migration Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=5f3z1Z_9BJA</data>
    <data key="d2">Architecture for migrating on-premises IBM Netezza data warehouse services to AWS Redshift utilizing an ELT pipeline, S3 tiering, and HIPAA-compliant encryption.</data>
    <data key="d3">Data Migration, Analytics, Data Pipeline</data>
    <data key="d4">True</data>
  </graph>
</graphml>
