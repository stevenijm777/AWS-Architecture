<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Vehicles</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Collect anonymized sensor data and visual inspections from millions of driving vehicles.</data>
    </node>
    <node id="1">
      <data key="d5">REST API</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Ingestion REST API hosted in a dedicated AWS account.</data>
    </node>
    <node id="2">
      <data key="d5">S3 (Ingestion)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores raw ingested telemetry data prior to processing.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Buffers incoming messages and drives worker autoscaling.</data>
    </node>
    <node id="4">
      <data key="d5">EKS (Process)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Processes ~10 million observations per day, scaling dynamically between 100 and 800 worker nodes.</data>
    </node>
    <node id="5">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates complex algorithms (e.g. construction zone extraction) with execution parallelism.</data>
    </node>
    <node id="6">
      <data key="d5">S3 (Store)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores preprocessed, formatted structured data.</data>
    </node>
    <node id="7">
      <data key="d5">Elasticsearch</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Provides cost-effective document-based storage and self-indexing for fast searches.</data>
    </node>
    <node id="8">
      <data key="d5">CockroachDB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Relational database deployed in EKS to handle frequent table updates.</data>
    </node>
    <node id="9">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Exposes stored data and analytics endpoints to city planners and enterprise users.</data>
    </node>
    <node id="10">
      <data key="d5">EKS (Consume)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Serving cluster running a secured REST API for end customers.</data>
    </node>
    <node id="11">
      <data key="d5">WebApp</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Web application interface providing platform insights directly to end customers.</data>
    </node>
    <node id="12">
      <data key="d5">City Planners</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Enterprise customers, road operators, and city planners.</data>
    </node>
    <node id="13">
      <data key="d5">Customers</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End users consuming live mobility intelligence and web analytics.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Vehicles send anonymized sensor data to ingestion REST API.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">REST API writes raw data into initial ingestion S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Ingested data triggers/queues tasks into SQS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS processing workers pull messages from SQS, scaling based on queue depth.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS workers trigger Step Functions state machines for parallel algorithm execution.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS processes and stores document-based insights into Elasticsearch.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS performs frequent relational updates into CockroachDB.</data>
      <data key="d10">2''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions output formatted structured data into Store S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Stored data in S3 is served via API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Elasticsearch serves search data to EKS consume cluster.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">CockroachDB serves relational query data to EKS consume cluster.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">CockroachDB feeds data to the Web Application.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">API Gateway provides data insights to city planners and operators.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="13" id="0">
      <data key="d8">3</data>
      <data key="d9">EKS consume cluster serves secured REST API to end customers.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="13" id="0">
      <data key="d8">3</data>
      <data key="d9">WebApp serves web interface insights to customers.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mobileye Dynamic RAM Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=5hjkSczrke4</data>
    <data key="d2">Dynamic RAM platform collecting anonymized sensor data from vehicles to provide mobility intelligence and live event insights.</data>
    <data key="d3">Data Processing, Analytics, Automotive</data>
    <data key="d4">True</data>
  </graph>
</graphml>
