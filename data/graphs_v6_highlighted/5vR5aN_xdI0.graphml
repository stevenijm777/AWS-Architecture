<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Customer serverless source pushing data directly to Splunk HEC.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Kinesis Data Firehose</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Customer stream ingestion service sending data to dedicated Firehose ELB.</data>
    </node>
    <node id="2">
      <data key="d5">Customer S3 Bucket</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Customer-owned bucket receiving exported logs via Dynamic Data Self Storage.</data>
    </node>
    <node id="3">
      <data key="d5">ELB (HEC)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Load balancer handling HTTP Event Collector (HEC) ingestion traffic.</data>
    </node>
    <node id="4">
      <data key="d5">ELB (Firehose)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Load balancer handling Kinesis Firehose traffic using sticky sessions.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon EC2 Indexers</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Splunk compute instances in an Auto Scaling group with fast local cache tier.</data>
    </node>
    <node id="6">
      <data key="d5">Splunk S3 Bucket</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Splunk storage tier for offloaded/evicted cache data and backend clustering.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon S3 Glacier</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Long-term cold storage archive for compliance and short-term rehydration.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda pushes event data to the HTTP Event Collector load balancer.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Kinesis Data Firehose sends stream data to Firehose ELB.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">HEC load balancer routes incoming events to EC2 Indexers.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Firehose load balancer uses sticky sessions to route to EC2 Indexers.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 Indexers offload non-frequently searched data to Splunk S3 Bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 Indexers archive compliance or historical data directly to Amazon S3 Glacier.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Dynamic Data Self Storage exports data directly to customer S3 Bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Splunk Cloud Data Ingestion and Tiered Storage Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=5vR5aN_xdI0</data>
    <data key="d2">Separation of storage and compute on Splunk Cloud using EC2 caching, S3 storage, Glacier archiving, and dynamic self-storage export to customer S3 bucket.</data>
    <data key="d3">Data Ingestion, Tiered Storage, Hybrid Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
