<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Internal stakeholder initiating automated self-service account provisioning workflows.</data>
    </node>
    <node id="1">
      <data key="d5">ITSM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">IT Service Management platform orchestrating automated account creation approvals and triggers.</data>
    </node>
    <node id="2">
      <data key="d5">Control Tower</data>
      <data key="d6">ControlTower</data>
      <data key="d7">AWS Control Tower Account Factory in the Root account provisioning baselined vended AWS accounts.</data>
    </node>
    <node id="3">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">AWS Service Catalog in the Root account provisioning pre-approved infrastructure templates like tagged VPCs.</data>
    </node>
    <node id="4">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">Virtual Private Cloud provisioned into the vended account with environment tags applied.</data>
    </node>
    <node id="5">
      <data key="d5">Transit Gateway (Vended)</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Transit Gateway attachment in the vended account automatically managed by STNO orchestrator.</data>
    </node>
    <node id="6">
      <data key="d5">Transit Gateway (Network)</data>
      <data key="d6">TransitGateway</data>
      <data key="d7">Central core Transit Gateway in the Network account interconnecting hundreds of vended account VPCs.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User submits request in ITSM for automated AWS account creation.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">ITSM triggers AWS Control Tower Account Factory upon workflow approval.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Service Catalog provisions tagged VPC infrastructure into the new vended account.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Attaches vended account VPC to the central core Transit Gateway in the Network account based on VPC tags.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">DISH Network Automated Self-Service Multi-Account Provisioning Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=62E9ggjGS8I</data>
    <data key="d2">Architecture showing automated multi-account vending and network attachment using ITSM, AWS Control Tower, AWS Service Catalog, and AWS Transit Gateway.</data>
    <data key="d3">Automation, Multi-Account Management, Hybrid Networking</data>
    <data key="d4">True</data>
  </graph>
</graphml>
