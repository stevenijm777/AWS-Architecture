<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ECR</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores custom Docker container images built with SageMaker container libraries.</data>
    </node>
    <node id="1">
      <data key="d5">S3 DATASET</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores training datasets used by SageMaker.</data>
    </node>
    <node id="2">
      <data key="d5">S3 MODEL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Stores trained model artifacts exported from SageMaker.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Used for data analysis via notebooks, custom model training with hyperparameter optimization, and hosting prediction endpoints.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Enriches raw endpoint responses with additional data for real-time requests.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts the production application infrastructure that initiates real-time calls.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker pulls custom Docker images from ECR for training and inference delivery.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker reads dataset from S3 DATASET bucket for model training.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SageMaker exports trained model artifacts to S3 MODEL bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker endpoint returns raw predictions to Lambda for response enrichment.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">AWS Lambda calls SageMaker endpoint to get prediction responses.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Production infrastructure on EC2 initiates real-time calls to AWS Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">ContentWise Machine Learning Architecture on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=66fPHLmvikk</data>
    <data key="d2">ContentWise uses Amazon SageMaker, AWS Lambda, Amazon EC2, ECR, and Amazon S3 to build, train, and serve machine learning recommendation models.</data>
    <data key="d3">Machine Learning, Serverless, Compute</data>
    <data key="d4">True</data>
  </graph>
