<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Client devices (mobile/PC) requesting personalized videos and receiving playback streams.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point that applies usage plans and API keys to manage incoming request load.</data>
    </node>
    <node id="2">
      <data key="d5">AWS Lambda (Frontend)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates requests, enqueues rendering jobs, polls response queue, and returns playlist links.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon SQS (Request Queue)</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds rendering job instructions for EC2 engine instances.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon SQS (Response Queue)</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives immediate acknowledgments/responses from rendering engines.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon EC2 Auto Scaling</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Runs spot EC2 instances across multiple AZs with diversified instance types for video rendering.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded rendered video segments.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN serving video segments to user devices from S3 origin.</data>
    </node>
    <node id="8">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers the scaling Lambda function every 15 seconds.</data>
    </node>
    <node id="9">
      <data key="d5">AWS Lambda (Scaling)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Calculates required rendering capacity and updates Auto Scaling target capacity.</data>
    </node>
    <node id="10">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects metrics from EC2 instances and emits spot instance interruption events.</data>
    </node>
    <node id="11">
      <data key="d5">AWS Lambda (Spot Interruption)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles spot interruption notifications, instructing instance to drain jobs and detach from ASG.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User sends personalized video request to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway forwards valid request to Frontend Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda pushes rendering job instructions to Request SQS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda returns playlist file link to user device.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 rendering instances pull jobs from Request SQS when capacity is available.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Frontend Lambda polls immediate response from Response SQS.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 rendering engine sends immediate response to Response SQS.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">EC2 rendering engine uploads rendered video segments to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">EC2 Auto Scaling instances push rendering metrics to CloudWatch.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront pulls video segments from S3 origin.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront streams video segments to client device player.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Step Functions triggers scaling Lambda function every 15 seconds.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Scaling Lambda adjusts capacity in EC2 Auto Scaling group.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">CloudWatch sends 2-minute spot interruption warning event to Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda notifies EC2 instance to stop fetching jobs, drain active work, and detach from ASG.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Sunday Sky Rendering as a Service Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6CgqEzyWpeA</data>
    <data key="d2">Video rendering pipeline utilizing EC2 Spot instances, SQS queues, AWS Lambda, CloudFront, and S3, with custom spot interruption handling and custom 15-second metric-based scaling.</data>
    <data key="d3">Media Processing, Auto Scaling, Serverless, Spot Instances</data>
    <data key="d4">True</data>
  </graph>
