<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis Data Streams (Collect)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Ingests native cloud security event streams and resource updates (50M+ resources).</data>
    </node>
    <node id="1">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Primary graph database persisting cloud resource configurations and topology.</data>
    </node>
    <node id="2">
      <data key="d5">Elasticsearch</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Backing store for search, aggregations, and reporting/analytics capabilities.</data>
    </node>
    <node id="3">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Monitors operational performance metrics (CPU, memory) from Neptune and Elasticsearch.</data>
    </node>
    <node id="4">
      <data key="d5">Shard Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom microservice that dynamically load-balances data across provisioned Neptune clusters based on CloudWatch metrics.</data>
    </node>
    <node id="5">
      <data key="d5">Kinesis Data Streams (Rules)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Fronts the rule execution pipeline for evaluating security checks against resource changes.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores historical resource configuration changes and detected security violations.</data>
    </node>
    <node id="7">
      <data key="d5">Notifications</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External notification channels including Slack, email, and Splunk for real-time alerts.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Publishes evaluated cloud resource states (50M+ items) into Neptune.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Propagates event changes to the rule execution pipeline.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Replicates resource data to Elasticsearch for search and aggregations.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Persists resource configuration changes into DynamoDB over time.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Emits operational performance metrics (CPU, memory) to CloudWatch.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Provides graph context back for rule evaluation.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Shard service reads CPU and memory metrics from CloudWatch to assess Neptune cluster capacity.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">Sharding decision feedback flows back to balance customer data loading at ingestion.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">3</data>
      <data key="d9">Executes security checks over the graph topology in Neptune.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Stores detected security violations in DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Triggers real-time security alerts to external notification channels (Slack, email, Splunk).</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">CloudHealth SecureState Real-Time Security Monitoring Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=6EUknQqaV1w</data>
    <data key="d2">CloudHealth SecureState monitors 50M+ cloud resources using a graph-backed data pipeline, dynamic sharding, and real-time rule evaluation.</data>
    <data key="d3">Security, Real-time Data Pipeline, Graph Databases</data>
    <data key="d4">True</data>
  </graph>
</graphml>
