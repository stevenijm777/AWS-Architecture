gZM&ei=3iZoavyXJIOp0_wP5vK_6A4&caps=asr&opi=112496729&xoaf=5&xowf=1&hl=en&ip=0.0.0.0&ipbits=0&expire=1785235790&sparams=ip%2Cipbits%2Cexpire%2Cv%2Cei%2Ccaps%2Copi%2Cxoaf&signature=9D27ACDB109D826F160994B9E25BC2B2298E664D.C77617EC9FC4EDA7AE7134EF921B687EB8E7B977&key=yt8&lang=en&fmt=ttml", "name": "English", "impersonate": true}, {"ext": "srt", "url": "https://www.youtube.com/api/timedtext?v=mmM_JnYygZM&ei=3iZoavyXJIOp0_wP5vK_6A4&caps=asr&opi=112496729&xoaf=5&xowf=1&hl=en&ip=0.0.0.0&ipbits=0&expire=1785235790&sparams=ip%2Cipbits%2Cexpire%2Cv%2Cei%2Ccaps%2Copi%2Cxoaf&signature=9D27ACDB109D826F160994B9E25BC2B2298E664D.C77617EC9FC4EDA7AE7134EF921B687EB8E7B977&key=yt8&lang=en&fmt=srt", "name": "English", "impersonate": true}, {"ext": "vtt", "url": "https://www.youtube.com/api/timedtext?v=mmM_JnYygZM&ei=3iZoavyXJIOp0_wP5vK_6A4&caps=asr&opi=112496729&xoaf=5&xowf=1&hl=en&ip=0.0.0.0&ipbits=0&expire=1785235790&sparams=ip%2Cipbits%2Cexpire%2Cv%2Cei%2Ccaps%2Copi%2Cxoaf&signature=9D27ACDB109D826F160994B9E25BC2B2298E664D.C77617EC9FC4EDA7AE7134EF921B687EB8E7B977&key=yt8&lang=en&fmt=vtt", "name": "English", "impersonate": true}]}, "comment_count": 2, "chapters": [{"start_time": 0, "end_time": 21.0, "title": "<Untitled Chapter 1>"}, {"start_time": 21.0, "title": "Nice to have you here. Ronald. Can you briefly describe what Shopline is about?", "end_time": 64.0}, {"start_time": 64.0, "title": "There are some common problems with POS system.", "end_time": 69.0}, {"start_time": 69.0, "title": "First, we have the inventory management.", "end_time": 106.0}, {"start_time": 106.0, "title": "These are some common problems of POS system.", "end_time": 115.0}, {"start_time": 115.0, "title": "They are also more technical challenges", "end_time": 134.0}, {"start_time": 134.0, "title": "First, lers take a look at this chart of the e-commerce platform infrastructure of Shopline.", "end_time": 158.0}, {"start_time": 158.0, "title": "a POS client, which is a mobile app", "end_time": 161.0}, {"start_time": 161.0, "title": "and a Web Application for POS Admin", "end_time": 164.0}, {"start_time": 164.0, "title": "First, we need authentication integration", "end_time": 210.0}, {"start_time": 210.0, "title": "Great, I see that you've chosen the API gateway service of AWS", "end_time": 215.0}, {"start_time": 215.0, "title": "Can you explain the reasons why you chose this service?", "end_time": 219.0}, {"start_time": 219.0, "title": "The main reason is that API Gateway is a fully-managed service.", "end_time": 269.0}, {"start_time": 269.0, "title": "You've mentioned that our back-end data would also need synchronisation", "end_time": 303.0}, {"start_time": 303.0, "title": "Then we'll need to add a small ECS cluster in our own infrastructure", "end_time": 349.0}, {"start_time": 349.0, "title": "We've been using a lot of ECS cluster", "end_time": 371.0}, {"start_time": 371.0, "title": "Finally, extend our Open API to support SSO authentication.", "end_time": 408.0}, {"start_time": 408.0, "title": "What's the road map in the future for you?", "end_time": 513}], "like_count": 56, "channel": "Amazon Web Services", "channel_follower_count": 843000, "channel_is_verified": true, "uploader": "Amazon Web Services", "uploader_id": "@amazonwebservices", "uploader_url": "https://www.youtube.com/@amazonwebservices", "upload_date": "20200224", "timestamp": 1582581660, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "display_id": "mmM_JnYygZM", "fulltitle": "SHOPLINE: Building E-Commerce O2O platform on AWS (Cantonese)", "duration_string": "8:33", "is_live": false, "was_live": false, "epoch": 1785210590, "format": "137 - 1920x1080 (1080p)+140 - audio only (medium)", "format_id": "137+140", "ext": "mp4", "protocol": "https+https", "format_note": "1080p+medium", "filesize_approx": 124661856, "tbr": 1943.478, "width": 1920, "height": 1080, "resolution": "1920x1080", "fps": 30, "dynamic_r