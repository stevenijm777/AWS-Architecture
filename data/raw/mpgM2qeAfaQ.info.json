FQgBFQAAAAAYASUAAMhCPQCAokN4AQ==&rs=AOn4CLD-TvTAmyO5EuVZY4-rUHsiH1aHVQ", "height": 110, "width": 196, "preference": -7, "id": "31", "resolution": "196x110"}, {"url": "https://i.ytimg.com/vi/mpgM2qeAfaQ/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=&rs=AOn4CLCrl6zEsj_VT6-eDQ6RXLZKqOKaPQ", "height": 138, "width": 246, "preference": -7, "id": "32", "resolution": "246x138"}, {"url": "https://i.ytimg.com/vi/mpgM2qeAfaQ/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=&rs=AOn4CLDgtNc3-uNiLNeY6ZnEostVh6NhsA", "height": 188, "width": 336, "preference": -7, "id": "33", "resolution": "336x188"}, {"url": "https://i.ytimg.com/vi/mpgM2qeAfaQ/hqdefault.jpg", "height": 360, "width": 480, "preference": -7, "id": "34", "resolution": "480x360"}, {"url": "https://i.ytimg.com/vi_webp/mpgM2qeAfaQ/hqdefault.webp", "preference": -6, "id": "35"}, {"url": "https://i.ytimg.com/vi/mpgM2qeAfaQ/sddefault.jpg", "height": 480, "width": 640, "preference": -5, "id": "36", "resolution": "640x480"}, {"url": "https://i.ytimg.com/vi_webp/mpgM2qeAfaQ/sddefault.webp", "preference": -4, "id": "37"}, {"url": "https://i.ytimg.com/vi/mpgM2qeAfaQ/hq720.jpg", "preference": -3, "id": "38"}, {"url": "https://i.ytimg.com/vi_webp/mpgM2qeAfaQ/hq720.webp", "preference": -2, "id": "39"}, {"url": "https://i.ytimg.com/vi/mpgM2qeAfaQ/maxresdefault.jpg", "preference": -1, "id": "40"}, {"url": "https://i.ytimg.com/vi_webp/mpgM2qeAfaQ/maxresdefault.webp", "preference": 0, "id": "41"}], "thumbnail": "https://i.ytimg.com/vi/mpgM2qeAfaQ/sddefault.jpg", "description": "Learn more about This Is My Architecture at - https://amzn.to/2UxGWgQ.\nBrain Power presents how they, together with AWS Professional Services, built a system to analyze body language to gauge attention, engagement, and enjoyment in near real-time. This system helps analyze clinical trial videos of children with autism and/or ADHD. The system uses Brain Power's method, affectionately called Fidgetology, to quantitatively summarize fidgeting and other body motions as a behavioral biomarker. It can use accessible technologies such as webcams and mobile devices to stream video directly to Amazon Kinesis Video Streams and later to Amazon Rekognition to detect face positions. Raw data is ingested into Amazon Kinesis Data Streams and consumed by AWS Lambda functions to analyze and mathematically compute attention and body motion metrics. A visualization web app is provided to retrieve processed metrics to both visualize and alert on anomalies.\n\nHost: Heitor Lessa, Specialist Solutions Architect, AWS\nCustomer: Runpeng Liu, Software Developer, Brain Power\n\nSubscribe: \nMore AWS videos http://bit.ly/2O3zS75 \nMore AWS events videos http://bit.ly/316g9t4\n\n#AWS", "channel_id": "UCd6MoB9NC6uYN2grvUNT-Zg", "channel_url": "https://www.youtube.com/channel/UCd6MoB9NC6uYN2grvUNT-Zg", "duration": 461, "view_count": 2330, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=mpgM2qeAfaQ", "categories": ["Science & Technology"], "tags": ["AWS", "Amazon Web Services", "Cloud", "cloud computing", "AWS Cloud", "Brain Power Fidgetology", "Heitor Lessa", "Runpeng Liu", "Amazon API Gateway", "Amazon Kinesis Video Streams", "Amazon Kinesis", "AWS Lambda", "Amazon Rekognition", "TMA", "This is My Architecture"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 1, "chapters": [{"start_time": 0, "title": "Introduction", "end_time": 74}, {"start_time": 74, "title": "AWS Video Streaming", "end_time": 141}, {"start_time": 141, "title": "Amazon Recognition", "end_time": 195}, {"start_time": 195, "title": "Post Processing", "end_time": 303}, {"start_time": 303, "title": "Conclusion", "end_time": 461}], "like_count": 47, "channel": "Amazon Web Services", "channel_follower_count": 845000