<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Production S3 Buckets (member AWS accounts)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 buckets in the connected production AWS accounts. Macie inventories them and the team selects which ones to scan. Fused from the two member-account S3 icons.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Macie</data>
      <data key="d6">Macie</data>
      <data key="d7">Data discovery tool connected across multiple AWS accounts, with production accounts prioritized. Quickly inventories all S3 buckets and runs manual or scheduled scans. Automated sensitive data discovery accuracy is 95% for patterns/regexes such as SSNs and ITINs. Fused from the three Macie icons.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon S3 (Macie findings bucket)</data>
      <data key="d6">S3</data>
      <data key="d7">Company-owned bucket set up per connected account to receive Macie results. Holds only metadata (e.g. number of SSNs per bucket); no PII or sensitive data.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL-based query tool that looks into the findings buckets and queries the findings information.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Dashboards showing the top 10/20/30 risky buckets by PII type and their owners, used to drive remediation. Other BI tools such as Tableau or Power BI could be used instead.</data>
    </node>
    <node id="5">
      <data key="d5">MySQL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">MySQL data lake built by the company, into which findings data is dropped to identify bucket owners and support remediation.</data>
    </node>
    <node id="6">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Automations that get, load and aggregate the findings data for reporting to data owners. No arrow is drawn to it on the board.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie inventories and scans the selected production S3 buckets (manual or scheduled) for sensitive data. From the audio; no arrow drawn.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie writes scan findings (metadata only, e.g. counts of SSNs per bucket) to the findings S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue automations get, load and aggregate the findings data. From the audio; no arrow drawn.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Findings data is dropped into the MySQL data lake for owner identification and remediation reporting.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena queries the findings stored in the S3 bucket with SQL.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">QuickSight reads the findings from the S3 bucket (via Athena, per the speaker) to build dashboards of risky buckets by PII type and owner.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Oportun: Sensitive Data Discovery and DSPM with Amazon Macie</data>
    <data key="d1">https://www.youtube.com/watch?v=-kA0ahrhX3I</data>
    <data key="d2">Multi-account Amazon Macie scans production S3 buckets for sensitive member data (SSNs, ITINs, government IDs). Findings (metadata only, no PII) land in a company-owned S3 bucket, are queried with Athena, visualized in QuickSight, and loaded into a MySQL data lake with Glue automations to identify bucket owners and remediate. Reported accuracy of automated sensitive data discovery for patterns such as SSNs and ITINs is 95%.</data>
    <data key="d3">Security, Data Protection, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
