<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ON-PREM</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises source servers to be migrated. The Application Discovery Service agent and the CloudEndure live migration agent are installed on them.</data>
    </node>
    <node id="1">
      <data key="d5">APP DISCOVERY SERVICE</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">AWS Application Discovery Service. Collects inbound and outbound TCP connections and performance utilization from the on-premises servers, used to pick the instance types to provision in AWS. Queried through API calls by the migration factory.</data>
    </node>
    <node id="2">
      <data key="d5">CLOUDENDURE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">CloudEndure live migration service. Continuous block-by-block volume replication from the on-premises server to AWS. The migration factory calls its API to stop replication at cutover.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 (HOT REPLICA)</data>
      <data key="d6">EC2</data>
      <data key="d7">Hot replicated instance in AWS that receives the continuously replicated volumes from on-premises. It is the source for the baked AMI.</data>
    </node>
    <node id="4">
      <data key="d5">MIGRATION TEAM</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Migration team. Fills DynamoDB with operational metadata and starts the migration with one Slack command.</data>
    </node>
    <node id="5">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores operational metadata entered by the migration team: RTOs, RPOs, infrastructure owners, business owners, the tags to place on the EC2 instance (about 10 tags per server), target account, subnet, IP address and instance type. The transcript says this metadata drives AMI sharing and instance launch, though no arrow is drawn to the factory. Future: instance types from TSO Logic will be stored here.</data>
    </node>
    <node id="6">
      <data key="d5">SLACK</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Slack. The migration team issues one command, which calls the API on the migration factory EC2 instance to start the migration.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 (MIGRATION FACTORY)</data>
      <data key="d6">EC2</data>
      <data key="d7">Migration factory instance. Exposes an API called from Slack and performs all integrations through API calls: Application Discovery Service, CloudEndure, AMI baking, AMI sharing to the target account and starting the target instance. Moves a server in about 10 minutes.</data>
    </node>
    <node id="8">
      <data key="d5">BAKE AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">AMI baked by the migration factory from the hot replicated instance, so the on-premises data now lives in an AMI.</data>
    </node>
    <node id="9">
      <data key="d5">SHARED AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">AMI shared with encryption to the target account (across the dashed divider). The target account is determined from the metadata in DynamoDB.</data>
    </node>
    <node id="10">
      <data key="d5">EC2 (TARGET ACCOUNT)</data>
      <data key="d6">EC2</data>
      <data key="d7">Final migrated instance started in the target account from the shared AMI, with the instance type, specific IP address, subnet and about 10 tags taken from the DynamoDB metadata.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">The Discovery agent installed on the on-premises server sends inbound and outbound TCP connections and performance utilization to Application Discovery Service.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">The CloudEndure agent continuously replicates volumes block by block from the on-premises server to the hot replica in AWS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudEndure stops the replication on the hot replica instance.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The migration team fills DynamoDB with operational metadata: RTOs, RPOs, owners, tags, target account, subnet and IP.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">The migration team issues one command in Slack to start the migration.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Slack calls the API on the migration factory EC2 instance, which starts the migration.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">The migration factory calls the Application Discovery Service API to gather the inbound and outbound TCP connections.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">The migration factory calls the CloudEndure API to stop replication.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">The migration factory makes an API call to bake the AMI from the hot replicated instance.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">The migration factory shares the AMI, with encryption, to the target account identified from the DynamoDB metadata.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">The migration factory starts the instance in the target account, applying the instance type, specific IP address and tags from the DynamoDB metadata.</data>
      <data key="d10">7</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Versent Migration Factory: Automated On-Premises to AWS Server Migration</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Versent's automated migration factory, started from a single Slack command, moves servers from on-premises to AWS. Agents for Application Discovery Service and CloudEndure are installed on the on-premises server. The migration team fills DynamoDB with operational metadata. The migration factory EC2 instance orchestrates everything through API calls: it gathers TCP connections from Discovery Service, stops CloudEndure replication, bakes an AMI, shares it (encrypted) to the target account and starts the instance there. Migration time per server dropped from about 3-4 hours done manually to about 10 minutes. Planned next step: take instance types from TSO Logic, store them in DynamoDB and use them instead of the Discovery Service performance metrics. The dashed vertical line separates the migration account from the target account.</data>
    <data key="d3">Migration, Automation, DevOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
