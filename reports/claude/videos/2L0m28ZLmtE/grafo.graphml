<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Sanofi data scientists accessing the Data Analytics web portal. Started with 5-10 beta testers and grew to 30-40 users within 2-3 weeks.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Distribution in front of the static website, used to reduce costs; it also holds the certificate.</data>
    </node>
    <node id="2">
      <data key="d5">Amazon S3 (Static Website Portal)</data>
      <data key="d6">S3</data>
      <data key="d7">Static web portal hosted with the S3 static website feature. Entry point from which users reach authentication, the dynamic API and product provisioning.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Authenticates portal users through identity federation with Sanofi SSO.</data>
    </node>
    <node id="4">
      <data key="d5">Sanofi SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sanofi corporate Single Sign-On, the identity provider federated with Cognito.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Dynamic part of the portal, used to implement data traceability.</data>
    </node>
    <node id="6">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores user metadata and all actions performed on the Data Analytics portal; gives strong traceability of users and of each piece of data used in the environment.</data>
    </node>
    <node id="7">
      <data key="d5">AWS Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Portfolio of products (SageMaker and RStudio) that users provision from the portal. Products are built with CloudFormation templates for repeatable deployments, with emphasis on security and user isolation.</data>
    </node>
    <node id="8">
      <data key="d5">RStudio (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">RStudio environment provisioned as a Service Catalog product for data scientists.</data>
    </node>
    <node id="9">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker Notebooks provisioned through Service Catalog: encrypted, with a 100 GB disk for data, and traced. Each user has their own notebook and can only reach the data set they are entitled to.</data>
    </node>
    <node id="10">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda functions that call Translate and Comprehend / Comprehend Medical through the SDK, for bulk translation of raw files and for identifying data in raw files.</data>
    </node>
    <node id="11">
      <data key="d5">Amazon Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Bulk translation of raw files from a language detected automatically by Comprehend into a target language chosen by the user.</data>
    </node>
    <node id="12">
      <data key="d5">Amazon Comprehend Medical</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Identifies data / metadata inside raw files. Comprehend is also used to detect the source language automatically before translation.</data>
    </node>
    <node id="13">
      <data key="d5">Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Holds highly sensitive Real World Evidence data. Users extract data from the Data Lake into their own home-user S3 bucket and process it in RStudio, SageMaker, Translate or Comprehend. Data is segregated, encrypted, audited, accessible only under predefined rights, and cannot be downloaded to a workstation.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests the web portal through the CloudFront distribution.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront fetches the static website from the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront delivers the portal to the user.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">The portal sends the user to Cognito for authentication.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Static content is returned to CloudFront.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The portal calls API Gateway for its dynamic part (traceability).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">From the portal, users ask Service Catalog to provision a product.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Cognito federates the authentication to Sanofi SSO.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Cognito returns the authenticated session to the portal.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Sanofi SSO returns the user's identity to Cognito.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway writes and reads user metadata and portal actions in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway returns the response to the portal.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB returns metadata and traceability records to API Gateway.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions the RStudio product from its CloudFormation template.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions an encrypted, per-user SageMaker Notebook with a 100 GB disk.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls Translate through the SDK to translate raw files in bulk into the target language chosen by the user.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="12" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls Comprehend / Comprehend Medical through the SDK to detect the language and identify data in raw files.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Translate returns the translated content to Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="12" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Comprehend Medical returns the detected entities / metadata to Lambda.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="13" target="8" id="0">
      <data key="d8">4</data>
      <data key="d9">Stated in the audio, not drawn: data extracted from the Data Lake into the user's home bucket is processed in RStudio.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="13" target="9" id="0">
      <data key="d8">4</data>
      <data key="d9">Stated in the audio, not drawn: data extracted from the Data Lake into the user's home bucket is processed in SageMaker.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="13" target="10" id="0">
      <data key="d8">4</data>
      <data key="d9">Stated in the audio, not drawn: raw files from the Data Lake / home bucket are processed by the Lambda functions for Translate and Comprehend.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Sanofi Darwin Real World Evidence Data Analytics Portal for Data Scientists</data>
    <data key="d1">https://www.youtube.com/watch?v=2L0m28ZLmtE</data>
    <data key="d2">Secure data science ecosystem built by Sanofi with partner Teamwork for Real World Evidence data. A static S3 web portal behind CloudFront, authenticated through Cognito federated with Sanofi SSO, with a dynamic part on API Gateway and DynamoDB for traceability. Users self-provision SageMaker and RStudio through Service Catalog and use Translate and Comprehend Medical through Lambda. Sensitive data stays inside the environment (Data Lake and per-user home buckets) and cannot be downloaded. In production since early August; grew from 5-10 beta testers to 30-40 users in 2-3 weeks.</data>
    <data key="d3">Analytics, Machine Learning, Healthcare, Security, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
