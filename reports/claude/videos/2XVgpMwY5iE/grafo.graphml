<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Hospital</data>
      <data key="d6">UserConsumerHospital</data>
      <data key="d7">Hospitals, biologists and clients send medical images and data to S3. Hospitals later use the validated model for inference.</data>
    </node>
    <node id="1">
      <data key="d5">S3 (input images)</data>
      <data key="d6">S3</data>
      <data key="d7">Buckets receiving medical images from hospitals and clients; about 5 TB of data per project. Data is kept in the project's region (e.g. Germany).</data>
    </node>
    <node id="2">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Kubernetes product: labelling platform where pathologists annotate images, review model results and validate or reject models. Also hosts inference once a model is validated and frozen.</data>
    </node>
    <node id="3">
      <data key="d5">Pathologist</data>
      <data key="d6">UserCompanyDomainExpert</data>
      <data key="d7">Pathologist or doctor who enriches data by annotating and labelling images, and validates or rejects the trained model.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains one model per project using the same Docker containers as the previous pipelines, which made migration easy. Thousands of trainings in parallel, more than 30x faster, up to 30% infrastructure cost savings.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">File system used with SageMaker training for IO performance.</data>
    </node>
    <node id="6">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Security and fine-grained control of data access; helps document and meet medical certifications.</data>
    </node>
    <node id="7">
      <data key="d5">S3 (models)</data>
      <data key="d6">S3</data>
      <data key="d7">Bucket where the trained model and results are saved. HDS certification demonstrates health data security.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Hospitals and clients send medical images to S3 buckets (about 5 TB per project).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Images are loaded into the Kubernetes product to be shown to pathologists.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Enriched, annotated data is used to train a model per project in SageMaker.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Pathologist annotates and labels the images on the platform.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">The trained model is saved in an S3 bucket.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">FSx provides high IO performance storage for training. Direction taken from the world model; the board line has no arrowhead.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">IAM provides security and access control for training data. Direction taken from the world model; the board line has no arrowhead.</data>
      <data key="d10">4'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Model and results are exported back to the Kubernetes product for the pathologist to validate or reject; a validated model is frozen and used for inference on EKS. HDS label on the arrow.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Kinaï (as transcribed): Medical Image Annotation and Per-Project ML Training on EKS and SageMaker</data>
    <data key="d1">https://www.youtube.com/watch?v=2XVgpMwY5iE</data>
    <data key="d2">Healthcare company building technology for research and clinical studies, guiding pathologists and doctors in analysing medical images. Hospitals send images to S3 (about 5 TB per project); pathologists annotate them on an EKS-hosted labelling platform; SageMaker trains one model per project with FSx and IAM; models are stored in S3 and exported back to EKS for validation and then inference. Benefits: scientists work on several projects at once and switch in seconds, thousands of trainings in parallel, training more than 30x faster, up to 30% infrastructure cost savings (pay only when resources are used). Compliance: HDS certification and data kept in the project's region (e.g. Germany).</data>
    <data key="d3">Healthcare, Machine Learning, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
