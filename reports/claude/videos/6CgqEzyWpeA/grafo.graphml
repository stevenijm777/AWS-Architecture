<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Phone or Computer</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Viewer's mobile or PC device with the video player. Opens a link to a personalized video (e.g. a monthly telco bill), receives a playlist, and requests video segments.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">First stop for rendering requests. Usage plans and API keys per customer are used to control the load on the rendering farm.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda (RaaS Service Frontend)</data>
      <data key="d6">Lambda</data>
      <data key="d7">RaaS service frontend. Validates the rendering request, pushes rendering instructions to the request SQS queue, pulls the engine's response from the response SQS queue within the same invocation, and returns a link to a playlist file.</data>
    </node>
    <node id="3">
      <data key="d5">SQS (Rendering Request Queue)</data>
      <data key="d6">SQS</data>
      <data key="d7">Bottom queue on the whiteboard. Holds rendering instructions; engine services pull rendering jobs from it when they have capacity.</data>
    </node>
    <node id="4">
      <data key="d5">SQS (Response Queue)</data>
      <data key="d6">SQS</data>
      <data key="d7">Top queue on the whiteboard. The rendering engine responds here immediately so the response is as quick as possible; the same Lambda invocation pulls from it.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Auto Scaling (Spot Rendering Engines)</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Rendering engine service running entirely on EC2 Spot instances. Instances span multiple Availability Zones with diversified instance types for high availability. Instances push CloudWatch metrics. On spot interruption, an instance stops pulling from the queue, drains its current jobs (expected to finish within the two-minute notice), and is detached from the group.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the video segments uploaded by the rendering engine; origin for CloudFront. The playlist file contains links to these segments.</data>
    </node>
    <node id="7">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Serves video segments to the player, pulling them from the S3 origin.</data>
    </node>
    <node id="8">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers the scaling Lambda function every 15 seconds.</data>
    </node>
    <node id="9">
      <data key="d5">Lambda (Scaling)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered by Step Functions every 15 seconds. Consumes CloudWatch metrics pushed by the rendering instances and, when higher traffic is expected, tells the Auto Scaling group to increase the number of in-service instances.</data>
    </node>
    <node id="10">
      <data key="d5">CloudWatch Events / Metrics</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Receives metrics pushed from the rendering instances. Emits a CloudWatch event when a specific spot instance ID is about to be reclaimed (two-minute interruption notice).</data>
    </node>
    <node id="11">
      <data key="d5">Lambda (Spot Interruption Handler)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Invoked by a CloudWatch event carrying the instance ID about to be reclaimed. Calls that instance's API to stop pulling rendering requests and drain current jobs, then detaches the instance from the Auto Scaling group.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">The viewer's device sends the rendering request to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">The player requests video segments through the CloudFront link.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway passes the request to the RaaS frontend Lambda.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">After validation, the Lambda pushes rendering instructions to the request queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">The same Lambda invocation polls the response queue for the engine's response. Direction follows the drawn arrow.</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">The Lambda returns a link to the playlist file, which contains links to the video segments.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Rendering engines in the Auto Scaling group pull rendering jobs when they have capacity.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">The rendering engine responds immediately to the response queue.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">The rendering engine uploads video segments to S3.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Rendering instances push metrics to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront pulls the video segment from the S3 origin and plays it to the user.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Step Functions triggers the scaling Lambda every 15 seconds.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">The scaling Lambda consumes the CloudWatch metrics to calculate required capacity. Direction follows the drawn arrow.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">When higher traffic is expected, the Lambda tells the Auto Scaling group to increase the number of in-service instances.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">A CloudWatch event notifies the Lambda that a specific spot instance ID is about to be reclaimed.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">The Lambda calls the instance's API to stop pulling from the queue and drain current jobs, then detaches the instance from the Auto Scaling group.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">SundaySky: Rendering as a Service (RaaS) for Personalized Video on EC2 Spot</data>
    <data key="d1">https://www.youtube.com/watch?v=6CgqEzyWpeA</data>
    <data key="d2">SundaySky's rendering-as-a-service ecosystem for personalized video. Generates billions of videos yearly and millions daily. Rendering runs entirely on EC2 Spot instances spread across multiple Availability Zones with diversified instance types for high availability. Custom scaling mechanism based on CloudWatch metrics, evaluated every 15 seconds via Step Functions and Lambda. Custom handling of the two-minute spot interruption notice via CloudWatch Events and Lambda. Planned next step: use Auto Scaling group instance weights to represent rendering capacity.</data>
    <data key="d3">Media, Compute, Serverless</data>
    <data key="d4">True</data>
  </graph>
</graphml>
