<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">COLLECT (Kinesis Data Streams)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Receives resource state published by the collection framework, which evaluates the cloud providers' native security event streams (e.g. CloudWatch, Azure Activity Log). Billions of events per day across three major cloud providers.</data>
    </node>
    <node id="1">
      <data key="d5">Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Primary persistence and graph database for highly interconnected cloud resource data. 50M+ resources and growing. Chosen for graph-based exploration, read scale-out for rule execution, and being schema-less (agnostic of varied resource configurations). Provisioned clusters hold logically sharded customer data.</data>
    </node>
    <node id="2">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Backing store for search, aggregations, reporting and analytics over cloud resource data. Emits metrics to CloudWatch.</data>
    </node>
    <node id="3">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Backing store for other use cases such as how resource configurations change over time; also persists detected security violations from rule execution.</data>
    </node>
    <node id="4">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects metrics (CPU, memory and other parameters) from Neptune and Elasticsearch, used by the sharder service.</data>
    </node>
    <node id="5">
      <data key="d5">Sharder Service (SHARD)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom service that scales writes out by logically grouping data across provisioned Neptune clusters. Uses CloudWatch metrics from Neptune and Elasticsearch to determine shard capacity (whether a Neptune cluster is full) and load-balance customer data.</data>
    </node>
    <node id="6">
      <data key="d5">RULES (Kinesis Data Streams)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Fronts the rule execution pipeline. The rule engine determines which rules to run for a given event and resource change (potentially thousands of rules) and executes them over the Neptune graph.</data>
    </node>
    <node id="7">
      <data key="d5">Notifications (Slack / Email / Splunk)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Real-time notification channels for customers: Slack, email, Splunk and similar.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">A consumer of the collect stream publishes cloud resources into Neptune (50M+ resources).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">The incoming event is propagated to the rule execution pipeline.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Resource data is stored in Elasticsearch as a backing store for search, aggregation and analytics.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Resource data is stored in DynamoDB as a backing store, e.g. for configuration changes over time.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Neptune metrics (CPU, memory, etc.) are sent to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Resource changes, once persisted, are propagated to the rule execution pipeline.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Elasticsearch metrics are sent to CloudWatch.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The sharder service uses CloudWatch metrics to determine shard capacity of the provisioned Neptune clusters.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Shard capacity information flows back to guide write placement, load-balancing customer data across Neptune clusters.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Rules (potentially thousands) are executed over the Neptune graph database to perform security checks.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Detected security violations are persisted in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Real-time notifications are sent to customers through Slack, email, Splunk and similar channels.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">CloudHealth by VMware: Secure State - Real-Time Cloud Security Monitoring with Amazon Neptune</data>
    <data key="d1">https://www.youtube.com/watch?v=6EUknQqaV1w</data>
    <data key="d2">CloudHealth Secure State is a cloud security and monitoring platform. It ingests billions of events per day from three major cloud providers, persists 50M+ resources in Neptune (with Elasticsearch and DynamoDB as backing stores), scales writes through a sharder service driven by CloudWatch metrics, and runs thousands of rules via a Kinesis-fronted rule engine that stores violations in DynamoDB and notifies customers through Slack, email and Splunk.</data>
    <data key="d3">Security, Graph Database, Streaming, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
