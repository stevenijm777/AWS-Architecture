<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">EKS (MetaManager)</data>
      <data key="d6">EKS</data>
      <data key="d7">MetaManager, the 'brains of the grid', running as a microservice architecture on EKS. Abstracts users from the complexity of the technology needed to move data. The front end connects to it. Discovers tables, schemas and APIs, and applies data protection rules on data moving in and out of the data lake.</data>
    </node>
    <node id="1">
      <data key="d5">Elasticsearch / Neo4j (MetaStore)</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">MetaStore holding the discovered meta information; a combination of a document database (Elasticsearch) and a graph database (Neo4j).</data>
    </node>
    <node id="2">
      <data key="d5">Kafka (600 topics)</data>
      <data key="d6">MSK</data>
      <data key="d7">Enterprise streaming platform shared across all the group's companies. 600 topics, 250 GB, 7-day average retention period. Brings data from sources in different networks, countries and technologies into the data lake, and connects data back to the business.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Used together with Kafka to bring data into the centralized data lake; exchanges data with applications/APIs in both directions.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Data Lake (60 TB)</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized data lake where all data is stored, around 60 TB today. Data moves in and out, with protection applied by the MetaManager.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon RDS (consumption store)</data>
      <data key="d6">RDS</data>
      <data key="d7">Data store receiving data from the data lake for consumption; data can be published or consumed via APIs or OLTP.</data>
    </node>
    <node id="6">
      <data key="d5">Vertica (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Vertica analytics database hosted on EC2, receiving data from the data lake for traditional analytics.</data>
    </node>
    <node id="7">
      <data key="d5">Multiple Data Sources</data>
      <data key="d6">RDS</data>
      <data key="d7">Multiple source databases across different networks, countries and technologies. Their tables, schemas and APIs are discovered by the MetaManager.</data>
    </node>
    <node id="8">
      <data key="d5">Applications</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Business applications and APIs (e.g. the loyalty application). Data is consumed from them and brought back to the business, for example as push notifications and cross-brand campaigns.</data>
    </node>
    <node id="9">
      <data key="d5">DA/DS (Data Analysts / Data Scientists)</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Data analysts and data scientists who consume the data, run models and build dashboards. Drawn without arrows on the whiteboard.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">MetaManager stores the discovered meta information in the MetaStore (document + graph database).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka streams the collected data into the S3 data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Kafka delivers data back to the business systems.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR writes the collected data into the S3 data lake.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Data is brought back to business applications, e.g. loyalty app push notifications and cross-brand campaigns.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Data from the data lake is sent to RDS for consumption.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Data from the data lake is sent to Vertica for analytics.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">3</data>
      <data key="d9">Data flows out of the data lake to the Kafka enterprise streaming platform.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">EMR reads data from the data lake.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Data analysts and data scientists consume data from RDS. Stated in the audio; no arrow drawn.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Data analysts and data scientists consume data from Vertica to run models and build dashboards. Stated in the audio; no arrow drawn.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">MetaManager discovers the tables, schemas and APIs of the multiple data sources.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Data from the multiple sources is streamed into Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Data from applications/APIs is ingested through EMR.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Majid Al Futtaim - The Grid: Enterprise Data Lake and Streaming Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=9qTEHITVeLE</data>
    <data key="d2">Data platform ('the Grid') built on three pillars: collect, protect and connect the data. An EKS-based MetaManager discovers metadata and stores it in a MetaStore (Elasticsearch + Neo4j). Kafka and EMR bring data from multiple sources into an S3 data lake (60 TB). Data is published to RDS and Vertica for data analysts and data scientists, and flows back to business applications through the enterprise streaming platform. Infrastructure is defined as code and spun up and down on demand; the first MVP reached production in six months. Business benefit: a 360-degree customer view enabling cross-brand campaigns.</data>
    <data key="d3">Analytics, Data Lake, Streaming, Big Data</data>
    <data key="d4">True</data>
  </graph>
</graphml>
