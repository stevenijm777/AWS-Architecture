<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">IOS</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">iOS Snapchat app; the sender in the walkthrough. Connects through the gateway (GW) to the backend services.</data>
    </node>
    <node id="1">
      <data key="d5">Android</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Android Snapchat app; the recipient in the walkthrough. Holds a persistent connection to a server, through which messages are pushed. Later retrieves the media from CloudFront using the media ID (stated verbally, not drawn).</data>
    </node>
    <node id="2">
      <data key="d5">MEDIA</data>
      <data key="d6">EKS</data>
      <data key="d7">Media delivery service running on EKS. Receives the snap via the gateway and sends it to CloudFront. Part of 900+ EKS clusters, many with 1000+ instances.</data>
    </node>
    <node id="3">
      <data key="d5">MCS</data>
      <data key="d6">EKS</data>
      <data key="d7">Messaging service running on EKS. Latency-sensitive: looks up the connection/server ID in ElastiCache and pushes the message to the recipient. Also calls FRIEND GRAPH and SNAP DB.</data>
    </node>
    <node id="4">
      <data key="d5">SNAP DB</data>
      <data key="d6">EKS</data>
      <data key="d7">Snap's own database layer running on EKS as a front end to DynamoDB. Adds transactions, TTL, efficient handling of ephemeral data and incremental state synchronization to reduce load and cost on DynamoDB.</data>
    </node>
    <node id="5">
      <data key="d5">FRIEND GRAPH</data>
      <data key="d6">EKS</data>
      <data key="d7">Friend graph microservice running on EKS, called by the messaging service.</data>
    </node>
    <node id="6">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Receives the snap media from the media delivery service so that it is closer to the recipient; media is later fetched from here by media ID.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Persists the snap media (images/video).</data>
    </node>
    <node id="8">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Stores connection ID / server ID metadata used to find the server holding the persistent connection to the recipient client. The media ID is also persisted here.</data>
    </node>
    <node id="9">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores snap metadata (including media ID) behind SnapDB. 400 TB of data. Nightly scans at 2 billion rows per minute for friend suggestions and deletion of ephemeral data.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">The iOS app uses the gateway (GW, a custom-built EKS service) to talk to the media delivery service and upload the snap.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Through the gateway (GW), the iOS app sends the message to the messaging service (MCS).</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">The media delivery service sends the snap to CloudFront so it is closer to the recipient.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">The messaging service calls the friend graph service.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">The messaging service writes the snap metadata (including media ID) to SnapDB.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">The messaging service looks up the connection ID / server ID in ElastiCache to find the server holding the persistent connection to the recipient.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">The message is pushed to the Android recipient through the gateway over the persistent connection; latency-sensitive.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">SnapDB stores the metadata in DynamoDB under the covers (400 TB; nightly scans at 2B rows/min).</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">The snap media is persisted in S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Snap: Snapchat send and receive snap platform on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=Cgv0kfp_6xQ</data>
    <data key="d2">End-to-end lifecycle of sending and receiving a snap on Snapchat. Scale: 300M+ daily active users, 5B+ snaps per day, 10M+ QPS. 900+ EKS clusters, many with 1000+ instances. Moving to this architecture reduced P50 send latency by 24%. Compute cost is kept low with auto-scaling and Graviton instance types. The 'GW' gateway (a custom-built EKS service) is drawn as a label without an icon and is not modelled as a node.</data>
    <data key="d3">Containers, Messaging, Media Delivery, Databases</data>
    <data key="d4">True</data>
  </graph>
</graphml>
