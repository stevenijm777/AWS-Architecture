<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer (CLI)</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developer writes code in JavaScript or TypeScript and deploys it using the Forge CLI. Thousands of customers.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 Deployment Web Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Web service that receives deployments from the CLI. Sits behind an ALB so it can scale to handle load from thousands of customers. Translates the customer's JavaScript function into a Lambda function deployment request.</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores deployment state (in progress, completed, failed) so the result can be reported back to the user.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues deployment requests to decouple ingestion from Lambda creation and avoid Lambda control plane rate limits.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 Backend Deployment Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Backend service that reads deployment requests from SQS and creates the Lambda in its own time, when allowed, so it is not rate limited.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Lambda (Customer Code)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Runs customer code in a separate AWS account (account boundary) containing nothing else. Multi-tenant: a Lambda can be shared between multiple customers. A V8 isolate is spun up on every request and deleted after the invocation so no state or global variables leak between customers. No data is stored in the Lambda.</data>
    </node>
    <node id="6">
      <data key="d5">User (Browser)</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Browser that invokes the deployed app and renders the returned page fragment.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Invocation Service</data>
      <data key="d6">EC2</data>
      <data key="d7">Internal service that checks security permissions (whether the user is allowed to execute the Lambda), finds the right Lambda for that user and product, and invokes it with the correct parameters.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer deploys JavaScript/TypeScript code via the CLI to the deployment web service.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Stores deployment state to track progress (completed, failed, etc.).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Queues the deployment request onto SQS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Backend service reads deployment requests from SQS at its own pace (arrow drawn from EC2 to SQS).</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Creates the Lambda function with the customer code in the separate customer account, across the account boundary, when not rate limited.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda returns data, which may be gathered from other systems or products. Stated in the audio; no return arrow is drawn.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Browser calls the internal service to invoke the app.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">After checking permissions and finding the right Lambda, the service invokes it, sending the correct parameters.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">A page fragment is constructed and returned to the browser, which renders it. Stated in the audio; no return arrow is drawn.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Atlassian Forge: Secure Multi-Tenant Serverless App Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=H2fOkeXxpyw</data>
    <data key="d2">Atlassian Forge lets customers, developers and third-party vendors build custom apps that extend Atlassian products. There are two parts: deployment of customer code (CLI -&gt; EC2 web service -&gt; DynamoDB state + SQS queue -&gt; backend EC2 -&gt; Lambda creation) and invocation (browser -&gt; internal EC2 service -&gt; Lambda). The green line is an account boundary: customer code Lambdas run in their own separate AWS account, isolated from the Forge platform account. Lambdas are multi-tenant, and a V8 isolate is created per request for isolation.</data>
    <data key="d3">Serverless, SaaS, Multi-Tenant, Security, Developer Platform</data>
    <data key="d4">True</data>
  </graph>
</graphml>
