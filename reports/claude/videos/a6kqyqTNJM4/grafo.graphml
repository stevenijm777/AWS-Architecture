<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End customers of the travel platform (Almosafer example); about 300k requests per minute on average.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN receiving all user traffic; first layer of scaling and resiliency.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Cost-efficient storage serving static content and images for a content-heavy platform.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Decides which region and which device the traffic comes from, giving intelligence at the edge for routing and better customer serving.</data>
    </node>
    <node id="4">
      <data key="d5">Load Balancer</data>
      <data key="d6">ELB</data>
      <data key="d7">About 60 load balancers. Decide whether traffic is backend service or web (frontend) traffic, and route between legacy systems and new microservices.</data>
    </node>
    <node id="5">
      <data key="d5">Legacy</data>
      <data key="d6">EC2</data>
      <data key="d7">Legacy monolithic systems still hosted on EC2, being gradually migrated to microservices.</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Core for all backend and micro-frontend services. About 80% of services migrated; more than 250 microservices on over 1400 pods in production.</data>
    </node>
    <node id="7">
      <data key="d5">Amazon RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Managed SQL database for services that need proper transactional capabilities.</data>
    </node>
    <node id="8">
      <data key="d5">Mongo / Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Self-managed MongoDB instances on EC2 for the NoSQL needs of most services; Kafka plays a major role in the event-driven part of the microservices system.</data>
    </node>
    <node id="9">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts self-managed software: MongoDB instances and internal monitoring tools such as Prometheus and the ELK stack for metrics and log monitoring.</data>
    </node>
    <node id="10">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Used to make sure pod health is in proper shape; part of the end-to-end monitoring view.</data>
    </node>
    <node id="11">
      <data key="d5">Slack / PagerDuty</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Alerting system that all monitoring ties into, keeping the team on top of everything happening. Mentioned in audio only, not drawn on the whiteboard.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User traffic (about 300k requests per minute) goes through CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Traffic is forwarded from CloudFront to the load balancers.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 serves static content and images through CloudFront.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda decides the region and device of the traffic to steer how CloudFront serves and routes requests.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Load balancer routes backend and frontend traffic to microservices on EKS.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Load balancer routes traffic to legacy monolithic systems hosted on EC2.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Services that need transactional SQL read from and write to RDS.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Most services use self-managed MongoDB (NoSQL) and Kafka for event-driven communication.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch monitors pod health of the EKS services.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Metrics and logs from services are monitored by self-managed Prometheus and the ELK stack on EC2.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">Prometheus and ELK monitoring ties into alerting through Slack and PagerDuty.</data>
      <data key="d10">1'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch monitoring ties into alerting through Slack and PagerDuty.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Seera Group: Scalable Microservices Travel Platform on Amazon EKS</data>
    <data key="d1">https://www.youtube.com/watch?v=a6kqyqTNJM4</data>
    <data key="d2">Seera Group (transcribed as 'Syrah Group'; Almosafer brand example) handles about 300k requests per minute. Traffic enters through CloudFront, with S3 for static content and Lambda for region/device decisions. Around 60 load balancers route between frontend and backend and between legacy monoliths on EC2 and microservices on EKS (80% migrated, 250+ microservices, 1400+ pods). The data layer is self-managed MongoDB on EC2, RDS and Kafka. Monitoring uses CloudWatch, Prometheus and ELK, with alerting through Slack and PagerDuty.</data>
    <data key="d3">Containers, Microservices, Travel, Migration, Content Delivery, Monitoring</data>
    <data key="d4">True</data>
  </graph>
</graphml>
