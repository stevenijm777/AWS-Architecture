<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Tenant / Website User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Tenant using the web onboarding wizard to pick options and create events; also the website client that receives static content back from the CDN (drawn with bidirectional arrows).</data>
    </node>
    <node id="1">
      <data key="d5">Customer (Omni-channel)</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Customer buying through the mobile app, the website or third-party resellers / OTAs (Expedia, Viator, GetYourGuide); also covers the mobile check-in application.</data>
    </node>
    <node id="2">
      <data key="d5">CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">First point every client request hits. Returns static content from S3 and routes dynamic requests to AppSync or API Gateway.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Bucket acting as an HTTP server for the static website: ticket offering, event descriptions and pictures.</data>
    </node>
    <node id="4">
      <data key="d5">AppSync</data>
      <data key="d6">AppSync</data>
      <data key="d7">GraphQL gateway. Resolvers invoke Lambda; direct DynamoDB resolvers are sometimes used and reused through AppSync pipeline resolvers.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Shared business logic for all channels (AppSync and API Gateway). Fans out to subroutines via SQS messages, reprocesses those messages later, and interacts with DynamoDB.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Multi-tenancy: all tenants share the same tables, partitioned by a partition key per tenant.</data>
    </node>
    <node id="7">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Regular REST endpoint (third-party API) built for resellers / OTAs; hits the same Lambdas as the other channels.</data>
    </node>
    <node id="8">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Messages for fan-out during tenant setup and for deferred work after check-in (customer service, post-experience, review reminder email), processed later by Lambda.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Tenant uses the web wizard; the request first hits the CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="1">
      <data key="d8">2</data>
      <data key="d9">Website user starts the customer journey; the request hits the CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="2">
      <data key="d8">3</data>
      <data key="d9">Client requests dynamic content through the CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer request via a reseller / OTA channel first hits the CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="1">
      <data key="d8">4</data>
      <data key="d9">Check-in via the mobile check-in application (look up the booking or scan the ticket).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CDN forwards the request to the AppSync GraphQL gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="1">
      <data key="d8">3</data>
      <data key="d9">For dynamic content the CDN hits AppSync (GraphQL).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="2">
      <data key="d8">4</data>
      <data key="d9">Check-in request follows the same flow into AppSync.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Reseller requests go to the third-party REST API on API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">CDN requests static content from the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">CDN returns the static content to the client for browsing and navigation.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 returns the ticket offering, descriptions and pictures to the CDN.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Resolvers tell Lambda to fan out to different subroutines.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="1">
      <data key="d8">3</data>
      <data key="d9">A node of the graph is processed using Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="2">
      <data key="d8">4</data>
      <data key="d9">AppSync invokes Lambda for check-in processing.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Direct DynamoDB resolvers, reusable through AppSync pipeline resolvers.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda puts a batch of SQS messages (fan-out).</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="1">
      <data key="d8">4</data>
      <data key="d9">Lambda puts messages in SQS for anything that happens after check-in (customer service, post-experience).</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda interacts with DynamoDB to finish setting up the tenancy (partitioned by tenant).</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="1">
      <data key="d8">3</data>
      <data key="d9">Lambda reads from / writes to DynamoDB.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="2">
      <data key="d8">4</data>
      <data key="d9">Lambda interacts with DynamoDB for the check-in.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">DynamoDB returns data to Lambda (drawn as a bidirectional arrow).</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="1">
      <data key="d8">4</data>
      <data key="d9">DynamoDB returns booking data to Lambda.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway hits the same Lambdas used by the mobile and website channels.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">SQS messages are later reprocessed by Lambda.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="5" id="1">
      <data key="d8">4</data>
      <data key="d9">Messages are processed later by Lambda; an email is then sent to the customer asking for a review.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Anchor: Serverless Multi-Tenant Ticketing Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=c-1GXhOOOww</data>
    <data key="d2">Anchor is a ticketing platform for daytime experiences (Statue of Liberty cruises, Niagara Falls, Alcatraz Island, NYC Ferry) with more than 40 tenants, over 20 of them onboarded in the last six months. Fully serverless: CDN in front of S3 static hosting, AppSync GraphQL gateway, API Gateway REST endpoint for third-party resellers, a shared Lambda layer, DynamoDB with per-tenant partition keys, and SQS for fan-out and deferred processing.</data>
    <data key="d3">Serverless, Multi-Tenant SaaS, Ticketing, Web and Mobile</data>
    <data key="d4">True</data>
  </graph>
</graphml>
