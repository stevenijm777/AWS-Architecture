<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">TWD/CNN Center (Atlanta on-prem)</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Techwood / CNN Center site in Atlanta. Linear Ops QCs the master files here and sends them to S3 via Aspera. It receives the cloud playout as a unicast signal over Direct Connect (Evertz CloudBridge endpoint). An on-site auto changeover switch selects between Techwood playout, CNN Center playout and cloud playout. The signal is compressed and sent to the uplink.</data>
    </node>
    <node id="1">
      <data key="d5">S3 master file storage</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the master files for all brands. Files are registered in Evertz Mediator before being transferred to EC2.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 playout fleet (Evertz ORT)</data>
      <data key="d6">EC2</data>
      <data key="d7">Three identical EC2 icons fused into one node, one per AZ in us-east-1. Each AZ runs 10 channels (30 in total), each channel with a primary and a backup. The instances run Evertz ORT software and play files out with Evertz playtime. Evertz CloudBridge carries the signal from EC2 back to site. Supported by auto scaling groups.</data>
    </node>
    <node id="3">
      <data key="d5">ASG</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Auto scaling groups supporting the primary and backup EC2 playout instances. Multi-AZ redundancy targets five-nines availability.</data>
    </node>
    <node id="4">
      <data key="d5">Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Carries the playout back to prem as a unicast signal, to Atlanta (X chain) and to Hudson Yards in New York (BCP). The connection is bookended by Evertz CloudBridge in AWS, Atlanta and New York.</data>
    </node>
    <node id="5">
      <data key="d5">ATL uplink</data>
      <data key="d6">UserConsumerSatellite</data>
      <data key="d7">Atlanta satellite uplink that distributes the compressed signal to affiliates.</data>
    </node>
    <node id="6">
      <data key="d5">NYC uplink (BCP)</data>
      <data key="d6">UserConsumerSatellite</data>
      <data key="d7">New York (Hudson Yards) uplink for the BCP solution, carrying 8 channels.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Master files QC'd in Atlanta are sent via Aspera to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">The signal is compressed and brought to the Atlanta uplink for distribution to affiliates.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Once registered in Evertz Mediator, files are transferred to the local EC2 instances running Evertz ORT.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Playout from Evertz playtime leaves over Direct Connect as a unicast signal, using Evertz CloudBridge.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Auto scaling groups support the primary and backup EC2 playout instances. Stated in the transcript; no arrow is drawn.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">X chain: the tertiary path to air, back to prem in Atlanta, where an auto changeover switch selects between Techwood, CNN Center and cloud playout.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">BCP path: Direct Connect to Hudson Yards (New York), 8 channels fed to an uplink.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">WarnerMedia HBO Cloud Linear Playout</data>
    <data key="d1">https://www.youtube.com/watch?v=hMK2NJ-q9nc</data>
    <data key="d2">Cloud linear playout in AWS us-east-1 supporting 30 channels (10 channels per AZ, each with primary and backup). It started as a business continuity (BCP) solution and became a tertiary path to air (the X chain). Master files are stored in S3, played out from EC2 running Evertz software, and returned over Direct Connect to Atlanta and New York for uplink to affiliates. It was deployed with about 40 CloudFormation YAML templates and targets five-nines availability across AZs.</data>
    <data key="d3">Media &amp; Entertainment, Broadcast, Linear Playout, Business Continuity</data>
    <data key="d4">True</data>
  </graph>
</graphml>
