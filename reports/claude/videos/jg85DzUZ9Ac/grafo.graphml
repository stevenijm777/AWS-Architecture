<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">OnPrem</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises database storing sales data at invoice level plus other key attributes.</data>
    </node>
    <node id="1">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">VPN connection through which the on-premises sales data is piped into AWS.</data>
    </node>
    <node id="2">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">Uses DMS with CDC (change data capture) to pull the on-prem data and populate the Redshift cluster.</data>
    </node>
    <node id="3">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Redshift cluster. Receives on-prem sales data from DMS and makes it available to the data lake and to other analytics and reports. Also receives the final merged demand data from the complex Lambda; business users and leadership query it daily with many different tools.</data>
    </node>
    <node id="4">
      <data key="d5">Data Lake</data>
      <data key="d6">LakeFormation</data>
      <data key="d7">Data lake with raw and refined S3 buckets. An event-driven S3 trigger on the bucket launches the next Lambda job.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Drop Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">S3 drop bucket receiving order-level flat files and demand data from the ERP system.</data>
    </node>
    <node id="6">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Kicked off when files land in the drop bucket; handles messaging and launches the initiator Lambda.</data>
    </node>
    <node id="7">
      <data key="d5">Initiator Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Initiator Lambda job. Talks to DynamoDB to pull metadata and key information about incoming files, then populates the data lake in the appropriate raw/refined structures.</data>
    </node>
    <node id="8">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores metadata and other key information about the files coming through the pipeline.</data>
    </node>
    <node id="9">
      <data key="d5">Complex Lambda (Merge &amp; Demand)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Complex Lambda job launched by the data lake S3 event. Merges order sales and inventory sales data sets, applies business logic, rules and exceptions, creates a new file, and applies Python statsmodels packages to produce current and future demand; output is fed into Redshift.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Invoice-level sales data from the on-premises database is piped through the VPN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS with CDC pulls the data arriving through the VPN.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS populates the Redshift cluster with the sales data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift makes the sales data available to the data lake.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">The event-driven S3 trigger on the data lake bucket launches the complex Lambda job.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Files landing in the S3 drop bucket kick off an SQS message.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS launches the initiator Lambda job.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">The initiator Lambda talks to DynamoDB and pulls metadata and key information about the incoming files.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">The Lambda pushes the file data into the appropriate structures in the data lake raw and refined buckets.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The merged orders/inventory data and computed demand output is fed into Redshift for business users to query.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Veritiv: Sales and Demand Analytics Data Lake Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=jg85DzUZ9Ac</data>
    <data key="d2">Veritiv (Fortune 500 B2B distributor) built an order and demand analytics pipeline on AWS. On-prem invoice-level sales data is replicated via VPN and DMS CDC into Redshift and the data lake. ERP order flat files land in an S3 drop bucket and go through SQS and an initiator Lambda (metadata in DynamoDB) into the data lake; an event-driven Lambda then merges the data sets, computes demand and loads Redshift for daily business queries. Delivered in 4-5 weeks by a small agile team. Future work: CloudFormation automation, SageMaker/ML.</data>
    <data key="d3">Analytics, Data Lake, Serverless, Migration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
