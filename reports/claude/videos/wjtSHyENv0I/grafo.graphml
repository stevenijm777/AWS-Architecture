<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Independent insurance agents of Main Street America who request the single page application and make backend calls.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Serves the single page application from the S3 bucket to the agents (previously served by Apache) and forwards backend calls to API Gateway.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Bucket hosting the modernized single page application, delivered through CloudFront.</data>
    </node>
    <node id="3">
      <data key="d5">API GATEWAY</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for backend calls, replacing load-balanced on-prem Tomcat servers. First invokes the Lambda authorizer, then calls the backend Lambda.</data>
    </node>
    <node id="4">
      <data key="d5">AUTHORIZER LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda authorizer that validates that the caller has access.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless Python Lambda that scales up and down easily. Hosts the modernized functions (new features, significant enhancements, significant bug fixes) and calls the legacy application for functionality not yet migrated. Instances run across Availability Zones.</data>
    </node>
    <node id="6">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Legacy Tomcat application that still holds functionality not yet migrated (e.g., user management). Being slowly strangled; called by the Lambda and calls back down to it.</data>
    </node>
    <node id="7">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Regional table used to cache user information. Shared across Lambda instances in different Availability Zones, so the cache remains accessible without a pause if one AZ goes down.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Agents request the single page application.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="1">
      <data key="d8">1</data>
      <data key="d9">Agents make calls to the backend.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront delivers the single page application to the agents.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Backend calls come into API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">The single page application is served from the S3 bucket through CloudFront.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway first uses the Lambda authorizer to validate that the caller has access.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway makes the calls to the serverless Python Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda caches and reads user information in the regional DynamoDB table.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">For functionality not yet migrated (e.g., user management), the Lambda calls up to the legacy Tomcat application.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The legacy application calls back down to the Lambda.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">American Family Group (Main Street America): Strangler-Pattern Modernization of a Legacy Agent Application to Serverless</data>
    <data key="d1">https://www.youtube.com/watch?v=wjtSHyENv0I</data>
    <data key="d2">Legacy application for independent insurance agents being incrementally modernized (strangling the Tomcat application). New features, significant enhancements and significant bug fixes are moved into a serverless Python stack. Benefits: 25 on-prem servers shut down, user satisfaction up 25%, 10% new users, lower cost than on-prem servers.</data>
    <data key="d3">Modernization, Serverless, Migration, Insurance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
