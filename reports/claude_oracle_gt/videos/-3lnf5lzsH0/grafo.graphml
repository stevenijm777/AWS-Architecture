<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 (AWS telemetry source)</data>
      <data key="d6">S3</data>
      <data key="d7">Public cloud telemetry source; events pulled into Apache Metron via Apache NiFi workflows.</data>
    </node>
    <node id="1">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Public cloud telemetry source integrated via Apache NiFi workflows.</data>
    </node>
    <node id="2">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Public cloud telemetry source integrated via Apache NiFi workflows.</data>
    </node>
    <node id="3">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">CloudTrail log messages are ingested and parsed into JSON by Apache Metron.</data>
    </node>
    <node id="4">
      <data key="d5">GuardDuty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">GuardDuty log messages are ingested and parsed into JSON by Apache Metron.</data>
    </node>
    <node id="5">
      <data key="d5">On-Prem</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premise data sources; standard syslog or Kafka integration directly into Apache Metron.</data>
    </node>
    <node id="6">
      <data key="d5">Apache Metron</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Heart of the next-gen SOC (drawn with an EC2 icon). Parses telemetry into JSON, enriches events with contextual intelligence (geolocation, AS number, server role such as flight/hotel/payment), and builds short-term profiles in the stream processing layer. Persists data in HDFS. About 20 data sources, about 5000 events per second.</data>
    </node>
    <node id="7">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR job picks up persisted data from Metron's HDFS and transforms it into S3. Part of the security data lake.</data>
    </node>
    <node id="8">
      <data key="d5">S3 (Security Data Lake)</data>
      <data key="d6">S3</data>
      <data key="d7">Serverless security data lake storing telemetry for months to years; about 250 million events indexed per day. Migrated from an on-prem HDFS setup.</data>
    </node>
    <node id="9">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL queries and analytics over S3 for log mining, analytics, forensics and threat hunting. Generates models/profiles over months of telemetry that are fed back to Apache Metron.</data>
    </node>
    <node id="10">
      <data key="d5">SOAR (Blitz)</data>
      <data key="d6">EC2</data>
      <data key="d7">Security orchestration and response platform called Blitz (open source on GitHub). Takes alerts from Metron, adds further context (reverse DNS, whois lookup), presents the alert in a single pane of glass (mobile handset or Jira integration), and integrates with WAF, firewall and internal routers for mitigation.</data>
    </node>
    <node id="11">
      <data key="d5">SOC Analyst (Alerts)</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Receives enriched alerts and responds at the click of a button, for example by blocking a source. Reduces investigation and triage time.</data>
    </node>
    <node id="12">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Mitigation target; settings are modified to block malicious sources as the incident response.</data>
    </node>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry events from S3 pulled into Apache Metron (via Apache NiFi workflows).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry events from SNS pulled into Apache Metron (via Apache NiFi workflows).</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry events from SQS pulled into Apache Metron (via Apache NiFi workflows).</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudTrail logs pulled into Apache Metron (via Apache NiFi workflows).</data>
      <data key="d10">0'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">GuardDuty findings pulled into Apache Metron (via Apache NiFi workflows).</data>
      <data key="d10">0''''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">On-prem events ingested directly via syslog or Kafka integration.</data>
      <data key="d10">0'''''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Persisted data in Metron's HDFS is picked up by an EMR job.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Metron sends the alert to the SOAR platform (Blitz).</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR job transforms the HDFS data and writes it to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena runs SQL queries and analytics on the data in S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Feedback loop: long-term (months-long) models and profiles from the security data lake are fed back into Apache Metron for more accurate enrichment and profiling.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Enriched alert presented to the SOC analyst in a single pane of glass (mobile handset or Jira integration).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">SOAR sends the control action that modifies WAF settings to block the threat.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Analyst responds to the incident at the click of a button, for example blocking a source.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">MakeMyTrip: Next-Gen SOC with Apache Metron and a Serverless Security Data Lake</data>
    <data key="d1">https://www.youtube.com/watch?v=-3lnf5lzsH0</data>
    <data key="d2">Next-gen SOC built from the ground up by MakeMyTrip. Hybrid data ingest (public cloud and on-prem) into Apache Metron, a security data lake (EMR, S3, Athena) with a feedback loop of long-term profiles, and a SOAR platform (Blitz) for semi-automated incident response through WAF, firewall and router integrations. Scale: about 20 data sources, about 5000 events per second, about 250 million events indexed per day in the data lake. Example use case: detecting server compromise through deviation in the producer-consumer ratio (PCR).</data>
    <data key="d3">Security, Analytics, Data Lake, Incident Response</data>
    <data key="d4">True</data>
  </graph>
</graphml>
