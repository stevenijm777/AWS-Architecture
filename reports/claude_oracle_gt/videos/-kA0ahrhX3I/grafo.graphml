<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3 - Production data</data>
      <data key="d6">S3</data>
      <data key="d7">Production S3 buckets in the connected production AWS accounts. Hold sensitive member data (SSNs, ITINs, government IDs). Macie inventories all buckets and the team chooses which to scan.</data>
    </node>
    <node id="1">
      <data key="d5">Macie - Production accounts</data>
      <data key="d6">Macie</data>
      <data key="d7">Macie enabled in each connected production account. Data discovery tool that quickly inventories all S3 buckets and runs manual or scheduled sensitive data scans. About 95% accuracy for pattern/regex types such as SSNs and ITINs.</data>
    </node>
    <node id="2">
      <data key="d5">Macie - Central account</data>
      <data key="d6">Macie</data>
      <data key="d7">Macie in the central security account, to which the multiple production accounts are connected. Delivers findings to the results S3 bucket. Goal: improve data security posture management (DSPM).</data>
    </node>
    <node id="3">
      <data key="d5">S3 - Metadata of risky data</data>
      <data key="d6">S3</data>
      <data key="d7">Findings bucket owned by the company in its own account. Holds metadata only, no PII or sensitive data, e.g. the number of SSNs found per bucket.</data>
    </node>
    <node id="4">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL-based query tool that queries the findings in the S3 bucket.</data>
    </node>
    <node id="5">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Automations that get, load and aggregate the findings data for reporting.</data>
    </node>
    <node id="6">
      <data key="d5">MySQL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">MySQL data lake built by the company, where findings data is also dropped to help identify bucket owners.</data>
    </node>
    <node id="7">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Dashboards showing the top 10/20/30 risky buckets by PII type and their owners, used to drive remediation (delete, archive, remove unused buckets). Tableau or Power BI mentioned as alternatives.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie inventories and scans the selected production S3 buckets for sensitive data (manual or scheduled scans).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Findings from the connected production accounts flow to the central Macie account. Inferred from the transcript; not drawn on the board.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie writes findings (metadata only, e.g. count of SSNs per bucket) to the results S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Findings data is returned from the bucket to Athena.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Findings data is dropped into the MySQL data lake.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Findings data feeds the QuickSight dashboards of top risky buckets by PII type and owner.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena runs SQL queries against the findings bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Glue automations get, load and aggregate the findings data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">QuickSight requests findings information from the S3 bucket (via Athena).</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Oportun: Sensitive Data Discovery and Data Security Posture Management with Amazon Macie</data>
    <data key="d1">https://www.youtube.com/watch?v=-kA0ahrhX3I</data>
    <data key="d2">Oportun (financial services) uses Amazon Macie across multiple AWS accounts to find sensitive member data (SSNs, ITINs, government IDs) in production S3 buckets. Findings (metadata only, no PII) land in an S3 bucket the company owns, are queried with Athena, processed by Glue automations, loaded into a MySQL data lake and visualized in QuickSight to identify the riskiest buckets and their owners for remediation (delete, archive, remove bucket). Reported accuracy of automated sensitive data discovery for pattern/regex types such as SSNs and ITINs is 95%.</data>
    <data key="d3">Security, Data Protection, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
