<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On Premise Infra</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises servers to be migrated. The Application Discovery agent and the CloudEndure live migration agent are installed on them.</data>
    </node>
    <node id="1">
      <data key="d5">Application Discovery Service</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Collects inbound and outbound TCP connections and performance utilization from on-premises servers, used for firewall rules and instance sizing.</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Operational metadata filled in by the migration team: RTO, RPO, infrastructure and business owners, about 10 tags per server, target account, subnet, IP and instance type.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Migration Factory</data>
      <data key="d6">EC2</data>
      <data key="d7">Migration orchestration and processing. Exposes an API called from Slack and does all integrations via API calls: App Discovery, CloudEndure, AMI bake, AMI share and instance launch. About 10 minutes per server instead of 3-4 hours.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 Hot Replica</data>
      <data key="d6">EC2</data>
      <data key="d7">Replicated data of on-premises servers. Continuous block-by-block volume replication through CloudEndure.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Migrated Instance (Target Account)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance to which the on-premises server has been migrated. Launched in the target account from the shared AMI with the instance type, specific IP, subnet and about 10 tags.</data>
    </node>
    <node id="6">
      <data key="d5">Migration Team</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Fills DynamoDB with metadata and issues a single Slack command to start the migration.</data>
    </node>
    <node id="7">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Chat interface. One command from the migration team calls the API on the migration factory EC2 instance.</data>
    </node>
    <node id="8">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">CloudEndure live migration. Block-level continuous volume replication from on-premises to AWS; replication is stopped via API at cutover.</data>
    </node>
    <node id="9">
      <data key="d5">Bake AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">AMI baked from the hot replicated instance, so the on-premises data now lives in an AMI.</data>
    </node>
    <node id="10">
      <data key="d5">Shared AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">AMI shared with encryption to the target account, which is determined from the DynamoDB metadata.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">The Application Discovery agent on the on-premises server sends inbound/outbound TCP connections and performance utilization.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">The CloudEndure agent continuously replicates volumes block by block from the on-premises server to the hot replica in AWS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Returns the TCP connection data, used for firewall rules.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">The migration factory reads the DynamoDB metadata: target account, instance type, IP, subnet and tags.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">API call to the Application Discovery Service to gather inbound and outbound TCP connections.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">API call to CloudEndure to stop the replication.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">The migration factory bakes the AMI from the hot replicated instance via an API call.</data>
      <data key="d10">7</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Shares the AMI, with encryption, to the target account.</data>
      <data key="d10">9</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Starts the instance in the target account with the instance type, specific IP, firewall rules and about 10 tags.</data>
      <data key="d10">10</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">The migration team fills DynamoDB with operational metadata: RTO, RPO, owners, tags, target account, subnet and IP.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">The migration team issues one command in Slack.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Slack calls the API on the migration factory EC2 instance, which starts the migration.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudEndure stops the replication on the hot replica.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudEndure API response to the migration factory.</data>
      <data key="d10">6</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Versent Migration Factory: Automated On-Premises to AWS Server Migration</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Versent's automated migration factory. It uses AWS Application Discovery Service for TCP connections and performance metadata, CloudEndure for block-level replication, DynamoDB for operational metadata and tags, and an EC2 migration factory triggered from Slack that bakes an AMI, shares it encrypted to the target account and launches the instance. Migration time per server dropped from about 3-4 hours to about 10 minutes. Future work: use TSO Logic instance type recommendations stored in DynamoDB.</data>
    <data key="d3">Migration, Automation, DevOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
