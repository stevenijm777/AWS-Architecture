<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Distribution in front of the static website; used to reduce costs and holds the certificate. Entry point for the portal users (data scientists).</data>
    </node>
    <node id="1">
      <data key="d5">S3 — Static Web App</data>
      <data key="d6">S3</data>
      <data key="d7">Static web portal (Data Analytics portal) hosted with the S3 static website feature.</data>
    </node>
    <node id="2">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Authenticates portal users through identity federation with the Sanofi SSO.</data>
    </node>
    <node id="3">
      <data key="d5">Sanofi SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sanofi corporate single sign-on; identity source federated with Cognito.</data>
    </node>
    <node id="4">
      <data key="d5">ApiGateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Dynamic part of the portal; used to implement data traceability.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">User activity log: stores user metadata and all actions performed on the Data Analytics portal; strong traceability of each piece of data used in the environment.</data>
    </node>
    <node id="6">
      <data key="d5">ServiceCatalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Portfolio of products (SageMaker and R Studio) that users provision from the portal. Products are built with CloudFormation for repeatable, secure, per-user isolated deployments.</data>
    </node>
    <node id="7">
      <data key="d5">R Studio</data>
      <data key="d6">EC2</data>
      <data key="d7">R Studio (proprietary app) running on EC2; one machine per user, provisioned through Service Catalog, with access only to that user's own data set.</data>
    </node>
    <node id="8">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker Notebooks provisioned through Service Catalog; encrypted, with a 100 GB disk for data, traced, one notebook per user with access only to that user's own data set.</data>
    </node>
    <node id="9">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda functions that call Translate and Comprehend through the SDK for bulk translation of raw files and identification of data/metadata in raw files.</data>
    </node>
    <node id="10">
      <data key="d5">Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Bulk translation of raw files from an automatically detected source language to a target language chosen by the user.</data>
    </node>
    <node id="11">
      <data key="d5">Comprehend Medical</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Comprehend is used to automatically detect the source language; Comprehend Medical specifically is used to identify data/metadata within raw files (NLP).</data>
    </node>
    <node id="12">
      <data key="d5">S3 — Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Data Lake holding very sensitive data that must stay in the environment and cannot be downloaded to a workstation. Each user has their own home bucket; data is segregated, encrypted, audited and accessible according to predefined rights.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront serves the static web portal hosted on S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">The web portal authenticates users with Cognito.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">The dynamic part of the portal calls API Gateway for traceability.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">From the portal, users provision products through Service Catalog.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Cognito federates identities with the Sanofi SSO.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway stores user metadata and all portal actions in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions a per-user R Studio machine (CloudFormation-based product).</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions a per-user encrypted SageMaker Notebook with a 100 GB disk (CloudFormation-based product).</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls Comprehend through the SDK to detect the source language, and Comprehend Medical to identify data/metadata in raw files.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls Translate through the SDK to bulk-translate raw files to the target language chosen by the user.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="12" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Data extracted into the user's home bucket in the Data Lake is processed in R Studio (stated in the audio, not drawn).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="12" target="8" id="0">
      <data key="d8">4</data>
      <data key="d9">Data extracted into the user's home bucket in the Data Lake is processed in SageMaker (stated in the audio, not drawn).</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="12" target="9" id="0">
      <data key="d8">4</data>
      <data key="d9">Raw files from the Data Lake are processed by the Lambda functions for Translate and Comprehend (stated in the audio, not drawn).</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Sanofi Darwin: Secure Data Science Portal for Real World Evidence Data</data>
    <data key="d1">https://www.youtube.com/watch?v=2L0m28ZLmtE</data>
    <data key="d2">Sanofi and Teamwork built a secure data analytics portal on AWS for data scientists working on Real World Evidence data in the Darwin ecosystem. Static web portal on S3 behind CloudFront, authentication through Cognito federated with the Sanofi SSO, traceability through API Gateway and DynamoDB, self-service provisioning of R Studio and SageMaker through Service Catalog, and translation / medical NLP through Lambda with Translate and Comprehend Medical. Sensitive data stays in the environment in a segregated S3 Data Lake with one home bucket per user. In production since early August; grew from 5-10 beta testers to 30-40 users in 2-3 weeks. Lake Formation is being considered for the future.</data>
    <data key="d3">Machine Learning, Analytics, Data Lake, Healthcare, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
