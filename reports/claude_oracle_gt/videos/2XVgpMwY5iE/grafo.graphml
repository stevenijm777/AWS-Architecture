<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Hospitals / Biologists / Clients</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Hospitals, biologists and clients send medical images. Also the end users of the validated model for inference.</data>
    </node>
    <node id="1">
      <data key="d5">Pathologist</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Enriches the data by annotating and labeling images; reviews model results and validates or rejects the model.</data>
    </node>
    <node id="2">
      <data key="d5">S3 Raw Images Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores incoming medical images; about 5 TB of data per project. Data stays in the project's region.</data>
    </node>
    <node id="3">
      <data key="d5">EKS Product Platform</data>
      <data key="d6">EKS</data>
      <data key="d7">Product on Kubernetes: labeling platform for pathologists, displays model results, and serves inference once the model is validated and frozen.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker Training</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains one model per project using the same Docker containers as the previous pipelines (easy migration). Thousands of parallel trainings, more than 30x faster, up to 30% infrastructure cost savings.</data>
    </node>
    <node id="5">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">Used with SageMaker training for IO performance.</data>
    </node>
    <node id="6">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Security and fine-grained control of data access; supports documenting and complying with certifications such as HDS.</data>
    </node>
    <node id="7">
      <data key="d5">S3 Model Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the trained model and results.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Hospitals, biologists and clients send medical images to S3 buckets (about 5 TB per project).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Pathologist enriches the data by annotating and labeling the images.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="1">
      <data key="d8">2</data>
      <data key="d9">Pathologist validates or rejects the model; once validated the model is frozen and moved to inference on the same Kubernetes platform, used by the hospital.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Images are loaded into the product on Kubernetes.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Images are shown to the pathologists in the labeling platform.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="1">
      <data key="d8">2</data>
      <data key="d9">Results are shown to the pathologist.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Enriched (annotated) data is used to train one model per project in SageMaker.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">The trained model is saved in an S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">FSx provides high IO performance storage for training.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">IAM provides security and data access control for training.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Model and results are exported into the product on Kubernetes.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Kinai - Medical Image Labeling and Per-Project Model Training on EKS and SageMaker</data>
    <data key="d1">https://www.youtube.com/watch?v=2XVgpMwY5iE</data>
    <data key="d2">Healthcare company building technology for research and clinical studies, guiding pathologists and doctors in analyzing medical images. Benefits versus the previous static infrastructure: scientists work on several projects at once and switch project in seconds, thousands of trainings in parallel, training more than 30 times faster, infrastructure cost reduced by up to 30% (pay only when resources are used). Compliance: HDS certification, data kept in the project's region (e.g. a German project keeps data in Germany).</data>
    <data key="d3">Healthcare, Machine Learning, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
