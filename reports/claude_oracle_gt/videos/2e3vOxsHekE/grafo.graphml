<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart Fire Hydrant</data>
      <data key="d6">UserConsumerEdge</data>
      <data key="d7">IoT edge devices (smart fire hydrants) in a large-scale IoT network. Record acoustic signals daily that measure noises on the pipe network; signals are correlated between multiple fire hydrants.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Ingestion entry point for the daily acoustic files. Provides authentication and security; chosen over direct S3 upload because of the heavy focus on IoT security.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Persists the acoustic signal files pushed through API Gateway.</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Daily batch process on container microservices. Processes each file as a node pair to find correlations in the acoustic signals, including persistent correlations occurring over many days. Chosen over Lambda because the acoustic algorithms are very processor intensive.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker ML Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">ML endpoint that classifies persistent correlations and assigns a leak probability (leak score). Model is retrained about every six weeks using feedback from the field.</data>
    </node>
    <node id="5">
      <data key="d5">Analyst</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Human analyst team that receives the leak score, reviews the persistent correlation, talks with the water utility to rule out other nearby noise sources, and updates the leak status to field investigation required. Field feedback is used to retrain the model.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Correlated acoustic signal files are pushed through API Gateway on a daily basis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">After authentication and security checks, the files are pushed and persisted in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Daily batch process in ECS processes each file as a node pair to look for correlations in the acoustic signals.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Persistent correlations are sent to the SageMaker ML endpoint for further classification and probability assignment.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Leak score (probability) is fed to the human analyst team for further classification of the leak.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Feedback from the field is used about every six weeks to further classify and retrain the model so it improves over time.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Mueller Water Products - Water Intelligence Platform (Acoustic Leak Detection)</data>
    <data key="d1">https://www.youtube.com/watch?v=2e3vOxsHekE</data>
    <data key="d2">Water intelligence platform that ingests daily acoustic data from smart fire hydrants through API Gateway into S3, runs daily batch correlation processing on ECS, classifies persistent correlations with a SageMaker ML endpoint to produce a leak probability, and feeds the score to human analysts. Field feedback is used roughly every six weeks to retrain the model. Benefits: reduced non-revenue water loss and ecological protection.</data>
    <data key="d3">IoT, Machine Learning, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
