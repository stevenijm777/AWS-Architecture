<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Applications</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Business applications and APIs (e.g. the loyalty app) that send data into the platform and receive data back, such as push notifications and cross-brand offers.</data>
    </node>
    <node id="1">
      <data key="d5">EKS - Meta Manager / Frontend</data>
      <data key="d6">EKS</data>
      <data key="d7">Microservice architecture on EKS hosting the frontend and the Meta Manager, the 'brains of the grid'. It abstracts users from the complexity of moving data, discovers tables, schemas and APIs, and applies data protection rules on data going in and out of the data lake.</data>
    </node>
    <node id="2">
      <data key="d5">Multiple Data Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data sources spread across different networks, countries and technologies (tables, schemas, APIs).</data>
    </node>
    <node id="3">
      <data key="d5">Elastic Search &amp; Neo4J</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">MetaStore: a combination of document database (Elasticsearch) and graph database (Neo4J) storing the discovered meta information.</data>
    </node>
    <node id="4">
      <data key="d5">Kafka</data>
      <data key="d6">MSK</data>
      <data key="d7">Kafka, the enterprise streaming platform shared across all the group's companies. About 600 topics, 250 GB, average retention period of seven days.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized data lake where all data is stored; around 60 TB today.</data>
    </node>
    <node id="6">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Used together with Kafka to bring data into the data lake, and to move data out to the consumption stores and applications.</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Consumption data store. Data can be published or consumed via APIs or OLTP; used by data analysts and data scientists.</data>
    </node>
    <node id="8">
      <data key="d5">Vertica</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Analytical consumption data store used by data analysts and data scientists for traditional analytics and running models.</data>
    </node>
    <edge source="0" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Data from applications and APIs is consumed into the platform.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Meta Manager stores the discovered meta information in the MetaStore (document and graph database).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Meta Manager discovers which tables, schemas and APIs exist in the data sources.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Data from the various sources is streamed into Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Data from the various sources is ingested through EMR.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka streams the data into the S3 data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Data is read out of the data lake by EMR for consumption, with Meta Manager protection rules applied.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="1">
      <data key="d8">3</data>
      <data key="d9">Data from the lake is read by EMR to be delivered back to applications.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Data from the lake is published to the Kafka enterprise streaming platform to connect back to the business.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR writes the collected data into the S3 data lake.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="1">
      <data key="d8">3</data>
      <data key="d9">Application data is stored in the data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Data is sent to RDS for consumption via APIs or OLTP.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Data is sent to Vertica for analytics by data analysts and data scientists.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="0" id="0">
      <data key="d8">3</data>
      <data key="d9">Data is brought back to business applications (e.g. push notifications, cross-brand campaigns, 360-degree customer view).</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Majid Al Futtaim - The Grid: Enterprise Data Lake and Streaming Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=9qTEHITVeLE</data>
    <data key="d2">The 'Grid' data platform is built on three pillars: collect, protect and connect the data. A Meta Manager on EKS discovers metadata and stores it in a MetaStore (Elasticsearch and Neo4J). Kafka and EMR bring data from many sources into an S3 data lake, and data is served to RDS and Vertica and back to business applications. Infrastructure is defined as code and spun up and down on demand; the first MVP reached production in six months. Business benefit: a 360-degree customer view across brands such as Vox Cinemas and Carrefour, enabling cross-brand marketing campaigns.</data>
    <data key="d3">Analytics, Data Lake, Streaming, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
