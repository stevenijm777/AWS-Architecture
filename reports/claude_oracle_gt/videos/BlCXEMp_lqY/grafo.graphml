<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Vizio Smart TVs</data>
      <data key="d6">UserConsumerTV</data>
      <data key="d7">Millions of connected devices generating logs, performance telemetry and user (application usage) data. Billions of events per month. Data is sent in different formats with no fixed schema.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Streams</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Front door to the cloud; everything is piped through Kinesis. Runs an 8-shard pipeline that has not yet needed to be scaled.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Takes the data as is and delivers it into Redshift; raw data is also stored in S3.</data>
    </node>
    <node id="3">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for events/logs/user data. Only a subset of the columns is imported. Columnar storage gives optimized IO for large aggregations over billions of rows. Replaced an earlier Aurora experiment; everything was reloaded without data loss.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term data store for raw historical events/logs/user data, kept forever for future use. Allows reloading the data warehouse if needed.</data>
    </node>
    <node id="5">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualization and reporting. Uses the built-in in-memory SPICE database; custom SQL queries download subsets of data from Redshift into SPICE datasets for fast slicing, dicing and reports.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">TVs send logs, performance telemetry and user data directly to Kinesis Data Streams, in varying formats without a fixed schema.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Stream data is piped from Kinesis Data Streams through Kinesis Firehose.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose takes the data as is and loads it into Redshift; only a subset of the columns is ingested into the data warehouse.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw data is stored in S3 as its long-term home, kept forever for future use and reloads.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Custom SQL queries download subsets of data from Redshift into QuickSight SPICE datasets for visualization and reports.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Vizio Smart TV Telemetry Analytics Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=BlCXEMp_lqY</data>
    <data key="d2">Vizio ingests logs, performance telemetry and user data from millions of connected smart TVs (billions of events per month) through Kinesis Data Streams and Kinesis Firehose into Redshift and S3, and visualizes it with QuickSight (SPICE). Built with AWS Professional Services: first prototype in a few weeks, production in about the fourth or fifth week, roughly six weeks from zero to users running reports. Aurora was tried first but did not aggregate billions of rows well; data was reloaded into Redshift without data loss.</data>
    <data key="d3">Analytics, IoT, Data Warehouse, Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
