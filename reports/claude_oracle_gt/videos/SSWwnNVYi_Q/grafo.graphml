<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">NHS Digital internal users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Internal teams within NHS Digital who log in to analyse data.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 public gateway (Guacamole)</data>
      <data key="d6">EC2</data>
      <data key="d7">Public gateway on the left of the dotted line. Users log in to Guacamole and land in a sandbox where they can view and analyse data but cannot get it out.</data>
    </node>
    <node id="2">
      <data key="d5">Directory Service (AD)</data>
      <data key="d6">DirectoryService</data>
      <data key="d7">Authenticates users. The user's role is also used in the data processing tools (Apache Ranger) so users only see the data they are meant to see.</data>
    </node>
    <node id="3">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs analytics jobs and provides a consistent compute layer. Reads data from S3. Chosen over Cloudera and on-prem options for flexibility and scale. Tooling mentioned: Apache Ranger, RStudio, JupyterHub, Hue.</data>
    </node>
    <node id="4">
      <data key="d5">S3 data store</data>
      <data key="d6">S3</data>
      <data key="d7">Stores existing data sets converted to Parquet. Encrypted at rest and in transit.</data>
    </node>
    <node id="5">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Provides the key used to encrypt the data. Other information in the system is also encrypted.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 data processing (Parquet conversion)</data>
      <data key="d6">EC2</data>
      <data key="d7">Processes existing data sets, converts them to Parquet and puts them into S3.</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Drawn in the secure sandbox with an arrow from KMS. Its role is not described in the transcript.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Internal users log in to the Guacamole public gateway on EC2.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Users are authenticated via Directory Service; their role determines data access.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR reads the Parquet data from S3 to run analytics jobs. Direction follows the drawn arrow.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 uses a KMS key to encrypt the data at rest.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Arrow drawn from KMS to RDS; taken to mean KMS also encrypts other information in the system.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Existing data sets are converted to Parquet and written to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">NHS Digital - Secure Data Access Environment on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=SSWwnNVYi_Q</data>
    <data key="d2">Secure data access environment for NHS Digital, replacing legacy systems. Users enter through a public Guacamole gateway on EC2, authenticate via Directory Service, and work in a sandbox from which data cannot be extracted. Data sets are converted to Parquet, stored in S3 encrypted with KMS, and analysed with EMR. Analytics jobs that took hours now take minutes or seconds.</data>
    <data key="d3">Analytics, Security, Healthcare, Big Data</data>
    <data key="d4">True</data>
  </graph>
</graphml>
