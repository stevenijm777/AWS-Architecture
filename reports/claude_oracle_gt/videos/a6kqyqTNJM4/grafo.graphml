<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Almosafer customers; about 300k requests per minute on average.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN entry point for all traffic; first layer of scaling and resiliency.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Cost-efficient storage serving static content and images for a content-heavy platform.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Edge logic that determines the region and device of incoming traffic to decide routing.</data>
    </node>
    <node id="4">
      <data key="d5">Load Balancer</data>
      <data key="d6">ELB</data>
      <data key="d7">About 60 load balancers. They decide whether traffic is backend or web/frontend, and route between legacy systems and new microservices.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 - Legacy application</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts the remaining legacy monolithic systems that are being migrated gradually to microservices.</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Core for all backend and micro-frontend services. About 80% of services migrated; 250+ microservices on 1400+ pods in production.</data>
    </node>
    <node id="7">
      <data key="d5">MongoDB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Self-managed MongoDB instances on EC2; NoSQL store used by most services.</data>
    </node>
    <node id="8">
      <data key="d5">Kafka</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Backbone for the event-driven part of the microservices system.</data>
    </node>
    <node id="9">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Managed SQL databases for services that need proper transactions.</data>
    </node>
    <node id="10">
      <data key="d5">EC2 - Monitoring tools (Prometheus, ELK)</data>
      <data key="d6">EC2</data>
      <data key="d7">Self-managed monitoring tools on EC2: Prometheus for an internal view of every service, and the ELK stack for log monitoring.</data>
    </node>
    <node id="11">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">AWS-native monitoring used to check that pod health is in good shape.</data>
    </node>
    <node id="12">
      <data key="d5">Slack / PagerDuty</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Alerting system that keeps the team informed of what is happening. Mentioned in the audio, not drawn on the board.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User traffic (about 300k requests per minute) enters through CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront forwards dynamic traffic to the load balancers.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 serves static content and images through CloudFront.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda determines the region and device of the traffic and decides how it is routed.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes traffic for legacy systems to the monoliths on EC2.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes backend and frontend traffic to microservices on EKS.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices read and write NoSQL data in self-managed MongoDB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices exchange events through Kafka.</data>
      <data key="d10">4'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Services that need transactions read and write SQL data in RDS.</data>
      <data key="d10">4''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="11" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch monitors pod health. Inferred from the audio.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">Service metrics and logs are collected by Prometheus and ELK on EC2. Inferred from the audio.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="12" id="0">
      <data key="d8">1</data>
      <data key="d9">Alerts from the monitoring tools are sent to Slack and PagerDuty.</data>
      <data key="d10">1'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">1</data>
      <data key="d9">Alarms are sent to Slack and PagerDuty.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Seera Group: Scalable Microservices Travel Platform on Amazon EKS</data>
    <data key="d1">https://www.youtube.com/watch?v=a6kqyqTNJM4</data>
    <data key="d2">Seera Group (Almosafer) travel platform. About 300k requests per minute pass through CloudFront, with S3 for static content and Lambda for region/device routing decisions. About 60 load balancers route between frontend and backend and between legacy EC2 monoliths and EKS microservices. About 80% of services have been migrated to EKS: 250+ microservices on 1400+ pods. Data layer: self-managed MongoDB on EC2, RDS for transactional SQL, Kafka for event-driven communication. Monitoring: CloudWatch, Prometheus and ELK on EC2, with alerts to Slack and PagerDuty.</data>
    <data key="d3">Containers, Microservices, Migration &amp; Modernization, Travel</data>
    <data key="d4">True</data>
  </graph>
</graphml>
