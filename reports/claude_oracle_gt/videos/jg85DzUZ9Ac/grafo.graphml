<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Sales Database</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">On-premises database storing sales data at invoice level plus other key attributes.</data>
    </node>
    <node id="1">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">On-prem data is piped through the VPN into AWS.</data>
    </node>
    <node id="2">
      <data key="d5">DMS (CDC)</data>
      <data key="d6">DMS</data>
      <data key="d7">Uses DMS with change data capture (CDC) to pull the on-prem data and populate the Redshift cluster.</data>
    </node>
    <node id="3">
      <data key="d5">Redshift Cluster</data>
      <data key="d6">RedShift</data>
      <data key="d7">Receives on-prem sales data from DMS and the demand data from the complex Lambda. Makes data available to the data lake and to other analytics and reports outside the lake. Business users and leadership query it daily with many different tools.</data>
    </node>
    <node id="4">
      <data key="d5">S3 Drop Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Drop bucket receiving flat files at the order level and demand data from the ERP system. File landing kicks off SQS.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Handles messaging; launches the initiator Lambda job.</data>
    </node>
    <node id="6">
      <data key="d5">Initiator Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Initiator Lambda job: talks to DynamoDB and pulls metadata and other key information about incoming files, then uses it to populate the data lake in the appropriate structures.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores metadata and other key information about the input files coming through the pipeline.</data>
    </node>
    <node id="8">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake with raw and refined buckets. An event-driven S3 trigger launches the next Lambda job. Also receives data from Redshift.</data>
    </node>
    <node id="9">
      <data key="d5">Complex Processing Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Complex Lambda job: merges order sales and inventory datasets from the two pipelines, applies logic, rules and exceptions, creates a new file and applies Python stats model packages to produce current and future demand data, then feeds it into Redshift.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Invoice-level sales data from the on-prem database is piped through the VPN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS with CDC pulls the data coming through the VPN.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS populates the Redshift cluster.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift makes the data available to the data lake.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Files landing in the drop bucket kick off an SQS message.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS launches the initiator Lambda job.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Initiator Lambda queries DynamoDB for information about the incoming files.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda pushes the data into the appropriate structures in the raw and refined buckets of the data lake.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">DynamoDB returns file metadata and other key information.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Event-driven S3 trigger on the data lake bucket launches the complex Lambda job.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="9" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Merged and statistically modeled demand data is fed into Redshift for daily querying.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Veritiv: Sales and Demand Analytics Data Lake Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=jg85DzUZ9Ac</data>
    <data key="d2">Veritiv (Fortune 500 B2B distributor) builds near-real-time order and demand analytics. On-prem invoice-level sales data is replicated via VPN and DMS (CDC) into Redshift; ERP flat files land in an S3 drop bucket and go through SQS, an initiator Lambda (metadata from DynamoDB) and into the S3 data lake (raw and refined buckets); an event-driven complex Lambda merges datasets and applies Python statistical models to produce demand data loaded into Redshift. Delivered in four to five weeks by a small agile team. Future work: CloudFormation automation, SageMaker/machine learning.</data>
    <data key="d3">Analytics, Data Lake, Serverless, Migration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
