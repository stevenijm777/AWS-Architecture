<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developers</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developers write code and push it to a GitHub repo, which triggers an event. They later view analysis results through the UI or the API.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Captures the GitHub push event, does triage and some analysis, and creates an analysis request.</data>
    </node>
    <node id="2">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue of analysis requests. Used to level the load so the Fargate service is not overwhelmed, and to drive Fargate auto-scaling.</data>
    </node>
    <node id="3">
      <data key="d5">ECS Fargate (Autoscan analysis)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Auto-scaling Fargate service plugged into the SQS queue. Polls the queue, clones the code from GitHub, analyses it and pushes an analysis report. Uses only ephemeral storage, no external storage. The largest code base was stated as 9 megabytes in the transcript (possibly a transcription error for a larger size). Currently supports non-compiled languages such as TypeScript and Python.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (API / UI)</data>
      <data key="d6">EC2</data>
      <data key="d7">Receives analysis reports through an API and stores them in the database. Also serves the UI and API that users call to see results.</data>
    </node>
    <node id="5">
      <data key="d5">Aurora</data>
      <data key="d6">Aurora</data>
      <data key="d7">Stores incoming reports as temporary storage (used as a queuing mechanism) and the final analysis reports ready for users. Plan is to replace the Aurora queue with a proper SQS queue.</data>
    </node>
    <node id="6">
      <data key="d5">ECS Fargate (Compute Engine)</data>
      <data key="d6">Fargate</data>
      <data key="d7">Compute Engine implemented as a Fargate cluster. Polls the database to extract reports, computes many code quality metrics, updates the database and creates the final analysis report.</data>
    </node>
    <node id="7">
      <data key="d5">non-aws ElasticSearch</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">In-house Elasticsearch service (not Amazon's) storing additional data in a search-optimised format. Planned move to the managed Amazon version.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developers push a code change to a GitHub repo; the resulting event is captured by Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Users call the UI or the API to see analysis results.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">After triage, Lambda creates an analysis request and puts it on the SQS queue.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">The Fargate service polls the queue for analysis requests; the queue also drives its auto-scaling.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">After cloning and analysing the code, Fargate pushes an analysis report to the EC2 API.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EC2 stores the received report in Aurora as temporary storage.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="1">
      <data key="d8">2</data>
      <data key="d9">EC2 queries Aurora for the analysis results.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">Results are returned to users through the UI or API.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">The Compute Engine polls the database to extract reports (Aurora used as a queue).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Aurora returns the analysis report data to EC2.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">After computing code quality metrics, the Compute Engine updates the database.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="1">
      <data key="d8">1</data>
      <data key="d9">The Compute Engine creates the final analysis report, ready to be consumed by users.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Stores additional data in a search-optimised format in the in-house Elasticsearch.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">SonarSource: SonarCloud Autoscan Code Analysis Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=u3ZwnulzLnU</data>
    <data key="d2">SonarCloud Autoscan: GitHub push events are captured by Lambda, queued in SQS, analysed by an auto-scaling Fargate service, and reported through an EC2 API into Aurora. A Fargate Compute Engine polls Aurora (used as a temporary queue) to compute code quality metrics and stores search data in an in-house Elasticsearch. Up to 150k analyses per week; the ecosystem supports around 300,000 organizations. Planned: move to managed Amazon Elasticsearch, replace the Aurora queue with a proper SQS queue, and add compiled languages (Java, C#).</data>
    <data key="d3">DevTools, Serverless, Containers, Code Analysis</data>
    <data key="d4">True</data>
  </graph>
</graphml>
