<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Drone</data>
      <data key="d6">UserCompanyDrone</data>
      <data key="d7">Drones flown by licensed third-party pilots to every well pad on a routine basis, replacing manual inspection by people. Captures well pad imagery.</data>
    </node>
    <node id="1">
      <data key="d5">Third-party imagery processing software</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Processes drone imagery and creates three files per well pad: an orthomosaic (high-resolution top-down view), a digital terrain model and a digital elevation model. Files are stored on the third-party server and exposed via API.</data>
    </node>
    <node id="2">
      <data key="d5">CloudWatch Event</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Scheduled CloudWatch event that calls the Step Functions workflow.</data>
    </node>
    <node id="3">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">State machine consisting of three separate Lambda functions: check whether new imagery is available, pull images from the third party into S3, and create raster proxies.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda - check for new imagery</data>
      <data key="d6">Lambda</data>
      <data key="d7">First Lambda function: calls the third-party software via API to determine whether new images and new flights are available.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda - pull images to S3</data>
      <data key="d6">Lambda</data>
      <data key="d7">Second Lambda function: invoked if a new flight or image is found; takes the images from the third party and stores them in an S3 bucket.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda - create raster proxies</data>
      <data key="d6">Lambda</data>
      <data key="d7">Third Lambda function: takes the S3 images and creates raster proxies, which serve like URLs so the on-prem server knows how to fetch the images. No change to the on-prem application is needed.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket in the Marathon Oil environment storing the processed imagery data.</data>
    </node>
    <node id="8">
      <data key="d5">Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">Allows the on-premises mapping software to read image files from the S3 bucket.</data>
    </node>
    <node id="9">
      <data key="d5">On-premises database &amp; server (mapping software)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-prem mapping software server handles user queries; its local database stores the raster proxies. The software cannot read directly from S3 without raster proxies. Used by maintenance and operations teams to identify equipment issues, preventative maintenance and overall well pad health.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Drone imagery is loaded into the third-party software, which processes it into three files per well pad.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Second Lambda takes the images from the third-party server.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch event calls the step function on a scheduled basis.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes the first Lambda function.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">If a new flight or image is found, the second Lambda function is called.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes the third Lambda function.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda calls the third-party API to check whether new images or flights are available.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Images are stored in the S3 bucket.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Raster proxies are stored in the local server's database.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Third Lambda takes the S3 images to create raster proxies.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Storage Gateway finds the image files in the S3 bucket for display to the end user.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">When a user views images, the mapping software goes out via Storage Gateway using the raster proxy.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Marathon Oil: Serverless Drone Imagery Ingestion for Well Pad Monitoring</data>
    <data key="d1">https://www.youtube.com/watch?v=ww5fiygF6eg</data>
    <data key="d2">Drone imagery of well pads is processed by third-party software, pulled into S3 on a schedule by a Step Functions workflow of three Lambda functions, and exposed to on-premises mapping software through raster proxies and Storage Gateway.</data>
    <data key="d3">Serverless, Energy, Hybrid Cloud, Storage, Geospatial Imagery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
