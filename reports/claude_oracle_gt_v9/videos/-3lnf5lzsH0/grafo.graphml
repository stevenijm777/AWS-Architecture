      <data key="d11">data</data>
    </edge>
    <edge source="6" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Persistent data in Apache Metron's HDFS is picked up by an EMR job.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Alert from Apache Metron sent to the SOAR platform (Blitz), which adds context such as reverse DNS and whois lookup.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry events from SNS pulled into Apache Metron through Apache NiFi workflows.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry events from SQS pulled into Apache Metron through Apache NiFi workflows.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudTrail logs pulled into Apache Metron through Apache NiFi workflows and parsed into JSON.</data>
      <data key="d10">0'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">GuardDuty logs pulled into Apache Metron through Apache NiFi workflows and parsed into JSON.</data>
      <data key="d10">0''''</data>
