    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">Enriched alert presented to the SOC analyst in a single pane of glass (mobile handset or Jira integration).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="11" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Control packet to modify WAF settings (e.g. block the offending source).</data>
