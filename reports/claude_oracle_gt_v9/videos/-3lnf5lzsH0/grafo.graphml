<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">OnPremDC</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premise data sources. Events are pulled directly into Apache Metron through standard syslog or Kafka integration.</data>
    </node>
    <node id="1">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR job that picks up persistent data from Apache Metron's HDFS and transforms it into S3. Part of the security data lake.</data>
    </node>
    <node id="2">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL queries and analytics over S3 for log mining, analytics and forensics. Used to generate models/profiles over months of telemetry that feed back into Apache Metron.</data>
    </node>
    <node id="3">
      <data key="d5">S3 #1</data>
      <data key="d6">S3</data>
      <data key="d7">Public cloud telemetry source (S3) integrated through Apache NiFi workflows into Apache Metron.</data>
    </node>
    <node id="4">
      <data key="d5">S3 #2</data>
      <data key="d6">S3</data>
      <data key="d7">Security data lake storage. Houses telemetry events for months or years; about 250 million events indexed per day. Migrated from on-prem HDFS to a serverless data lake.</data>
    </node>
    <node id="5">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Mitigation target. An analyst can respond to an incident at the click of a button, e.g. by blocking a source. Similar integrations exist for firewalls and internal routers.</data>
    </node>
    <node id="6">
      <data key="d5">Apache Metron</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Heart of the next-gen SOC (stream processing). Parses telemetry (syslog, CloudTrail, GuardDuty) into JSON, enriches events with contextual intelligence (geolocation, AS number, server role such as flight/hotel/payment) and builds short-term profiles. HDFS backbone. About 20 data sources, about 5000 events per second.</data>
    </node>
    <node id="7">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Public cloud telemetry source integrated through Apache NiFi workflows into Apache Metron.</data>
    </node>
    <node id="8">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Public cloud telemetry source integrated through Apache NiFi workflows into Apache Metron.</data>
    </node>
    <node id="9">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">CloudTrail log messages pulled into Apache Metron and parsed into JSON.</data>
    </node>
    <node id="10">
      <data key="d5">GuardDuty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">GuardDuty log messages pulled into Apache Metron and parsed into JSON.</data>
    </node>
    <node id="11">
      <data key="d5">SOAR (Blitz)</data>
      <data key="d6">EC2</data>
      <data key="d7">Security orchestration and response platform called Blitz (open source on GitHub). Takes alerts from Metron, adds extra context (reverse DNS, whois lookup), presents the alert in a single pane of glass (mobile, Jira integration) and integrates with WAF, firewalls and internal routers for mitigation.</data>
    </node>
    <node id="12">
      <data key="d5">UserCompanyAnalyst</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">SOC analyst who receives enriched alerts (mobile handset or Jira) and triggers the response at the click of a button, reducing triage/investigation time.</data>
    </node>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">On-prem events pulled directly into Apache Metron through standard syslog or Kafka integration.</data>
      <data key="d10">0'''''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR job transforms the persistent HDFS data and writes it into S3 (security data lake).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Feedback loop: models/profiles built over months of telemetry in the data lake are fed back into Apache Metron for more accurate enrichment/profiling.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry events from S3 pulled into Apache Metron through Apache NiFi workflows.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
