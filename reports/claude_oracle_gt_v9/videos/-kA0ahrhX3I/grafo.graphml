<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Macie #1</data>
      <data key="d6">Macie</data>
      <data key="d7">Macie enabled in the connected production AWS accounts. Quickly inventories all S3 buckets; the team chooses which buckets to scan. Scans are manual or scheduled. Automated sensitive data discovery accuracy about 95% for critical patterns (SSNs, ITINs).</data>
    </node>
    <node id="1">
      <data key="d5">Macie #2</data>
      <data key="d6">Macie</data>
      <data key="d7">Macie in the central security account. Data discovery tool connecting multiple AWS accounts; publishes the scan findings to the findings S3 bucket.</data>
    </node>
    <node id="2">
      <data key="d5">S3 — Production data</data>
      <data key="d6">S3</data>
      <data key="d7">Production S3 buckets in the connected accounts holding member data (SSNs, ITINs, government IDs) that Macie scans.</data>
    </node>
    <node id="3">
      <data key="d5">S3 — Metadata of risky data</data>
      <data key="d6">S3</data>
      <data key="d7">Findings bucket owned by Oportun in its own account. Contains only metadata (e.g. number of SSNs or ITINs per bucket); no PII or sensitive information.</data>
    </node>
    <node id="4">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL-based query tool that queries the Macie findings in the S3 bucket to identify findings and bucket owners.</data>
    </node>
    <node id="5">
      <data key="d5">Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Automations that get, load and aggregate the findings data for reporting.</data>
    </node>
    <node id="6">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Dashboards showing the top 10/20/30 risky buckets by PII type and their owners, used to drive remediation with data owners. Other BI tools such as Tableau or Power BI could be used.</data>
    </node>
    <node id="7">
      <data key="d5">MySQL</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">MySQL data lake built by Oportun, into which the findings data is also dropped.</data>
    </node>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie findings (metadata only, e.g. count of SSNs per bucket) are written to the findings S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie inventories and scans the production S3 buckets (manual or scheduled scans) for sensitive data.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Findings information is returned to Athena.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Findings data is dropped into the MySQL data lake.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Findings data feeds the dashboard of top risky buckets by PII type and owners.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena runs SQL queries against the findings bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Automations with Glue get, load and aggregate the findings data.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">QuickSight reads the findings information from the S3 bucket (via Athena) for dashboards.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Oportun: Sensitive Data Discovery and Remediation with Amazon Macie</data>
    <data key="d1">https://www.youtube.com/watch?v=-kA0ahrhX3I</data>
    <data key="d2">Oportun (financial services) uses Amazon Macie across multiple production AWS accounts to find sensitive member data (SSNs, ITINs, government IDs) in S3 buckets. Findings (metadata only, no PII) land in an S3 bucket owned by Oportun, are queried with Athena, processed with Glue automations, dropped into a MySQL data lake, and visualized in QuickSight dashboards (top risky buckets by PII type and owners) to drive remediation with data owners (delete, archive, or remove unused buckets). Goal: improve data security posture management (DSPM). Macie automated sensitive data discovery accuracy was about 95% for critical patterns such as SSNs and ITINs.</data>
    <data key="d3">Security, Data Protection, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
