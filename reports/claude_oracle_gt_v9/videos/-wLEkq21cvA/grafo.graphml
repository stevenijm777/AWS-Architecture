<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Application Discovery Service</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Agent installed on on-premises servers. Provides inbound and outbound TCP connections (metadata on on-premises instances) and performance utilization used to choose instance types.</data>
    </node>
    <node id="1">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Operational metadata filled in by the migration team: RTOs, RPOs, infrastructure and business owners, around 10 tags to place on the EC2 instance, target account, subnet, IP address, instance type. Used to drive AMI sharing and instance launch.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 Migration Factory</data>
      <data key="d6">EC2</data>
      <data key="d7">Migration orchestration and processing. Exposes an API called from Slack; makes API calls to Application Discovery Service and CloudEndure, bakes the AMI, shares it (encrypted) to the target account and starts the instance. Whole flow takes about 10 minutes instead of 3-4 hours.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Hot Replica</data>
      <data key="d6">EC2</data>
      <data key="d7">Replicated data of on-premises servers. Continuous block-by-block volume replication via the CloudEndure live migration agent; the AMI is baked from it.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 Migrated Instance (Target Account)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance to which the on-premises server has been migrated, in the target account. Launched from the shared AMI with instance type, specific IP address, subnet and around 10 tags from DynamoDB.</data>
    </node>
    <node id="5">
      <data key="d5">Migration Team</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Fills DynamoDB with operational metadata and issues one command in Slack to kick off a migration.</data>
    </node>
    <node id="6">
      <data key="d5">On Premise Infra</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises servers with the Application Discovery agent and the CloudEndure live migration agent installed.</data>
    </node>
    <node id="7">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Chat interface from which the migration is kicked off with a single command that calls the API on the migration factory EC2 instance.</data>
    </node>
    <node id="8">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">CloudEndure live migration: continuous block-by-block volume replication from on-premises to AWS. Replication is stopped via API call at cutover.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Returns TCP connection data (and performance utilization) to the migration factory.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">API call to Application Discovery Service to gather TCP inbound and outbound connections.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">API call to CloudEndure to stop the replication.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Migration factory bakes the AMI, shares it encrypted to the target account using DynamoDB metadata, then starts the instance with instance type, IP and tags.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration team fills in operational metadata: RTO, RPO, owners, tags, target account, subnet, IP.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Migration team issues one command in Slack to start the migration.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Discovery agent on the on-premises servers reports inbound/outbound TCP connections and performance utilization.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Continuous block-by-block volume replication from on-premises servers to the hot replica in AWS (CloudEndure agent).</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Slack calls the API on the migration factory EC2 instance, starting the migration.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudEndure responds; replication is stopped so the AMI can be baked from the hot replica.</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Versent Automated Migration Factory: On-Premises to AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Automated server migration from on-premises to AWS using Application Discovery Service, CloudEndure block replication, DynamoDB metadata and an EC2-based migration factory triggered from Slack. Reduces migration time from about 3-4 hours per server to about 10 minutes. Future plan: use TSO Logic instance type recommendations stored in DynamoDB instead of Discovery Service performance metrics.</data>
    <data key="d3">Migration, Automation, Compute</data>
    <data key="d4">True</data>
  </graph>
</graphml>
