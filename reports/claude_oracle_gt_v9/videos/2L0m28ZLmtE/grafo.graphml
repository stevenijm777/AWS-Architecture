<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Distribution in front of the static website; used to reduce costs and holds the certificate. Entry point for users.</data>
    </node>
    <node id="1">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Authenticates portal users through identity federation with Sanofi SSO.</data>
    </node>
    <node id="2">
      <data key="d5">S3 — Static Web App</data>
      <data key="d6">S3</data>
      <data key="d7">Static website (S3 static website hosting) serving the Data Analytics portal.</data>
    </node>
    <node id="3">
      <data key="d5">S3 — Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake holding highly sensitive data. Each user has their own home-user S3 bucket; data is segregated, encrypted, audited and accessible only according to predefined rights. Data must stay in the environment and cannot be downloaded to a workstation.</data>
    </node>
    <node id="4">
      <data key="d5">ApiGateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Dynamic part of the portal, used to implement data traceability.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">User activity log: stores user metadata and all actions performed on the Data Analytics portal; strong traceability of each data item used.</data>
    </node>
    <node id="6">
      <data key="d5">ServiceCatalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Portfolio of products (SageMaker and RStudio) that users provision from the portal; products are built with CloudFormation for repeatable, secured and isolated per-user environments.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda functions calling Translate and Comprehend through the SDK for bulk translation of raw files and identification of metadata.</data>
    </node>
    <node id="8">
      <data key="d5">EC2 — R Studio</data>
      <data key="d6">EC2</data>
      <data key="d7">RStudio (proprietary app) hosted on EC2, provisioned per user as a Service Catalog product.</data>
    </node>
    <node id="9">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">SageMaker notebooks, encrypted with a 100 GB disk to store data; one notebook per user, traced, giving access only to that user's data set.</data>
    </node>
    <node id="10">
      <data key="d5">Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Bulk translation of raw files from an automatically detected language to a target language chosen by the user.</data>
    </node>
    <node id="11">
      <data key="d5">Comprehend Medical</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Specifically Comprehend Medical: identifies data/metadata within raw files. Comprehend is also used to detect the source language automatically before translation.</data>
    </node>
    <node id="12">
      <data key="d5">Sanofi SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sanofi corporate SSO acting as identity provider federated with Cognito.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront distribution serves the static web portal hosted on S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="12" id="0">
      <data key="d8">0</data>
      <data key="d9">Identity federation with Sanofi SSO.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">The portal authenticates users with Cognito.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Dynamic part of the portal calls API Gateway for data traceability.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">User requests provisioning of the RStudio product from the portal.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="1">
      <data key="d8">2</data>
      <data key="d9">User requests provisioning of the SageMaker product from the portal.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">4</data>
      <data key="d9">Data extracted into the user's home bucket in the data lake is processed in RStudio.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="9" id="0">
      <data key="d8">4</data>
      <data key="d9">Data extracted into the user's home bucket in the data lake is processed in SageMaker.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Raw files from the data lake are processed by the Lambdas for Translate / Comprehend NLP.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Stores user metadata and all actions performed on the portal.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions RStudio (via CloudFormation).</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions an encrypted per-user SageMaker notebook with a 100 GB disk (via CloudFormation).</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls the Comprehend SDK to detect the source language and, with Comprehend Medical, to identify metadata in raw files.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls the Translate SDK to bulk-translate raw files into the target language chosen by the user.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Sanofi Darwin Real World Evidence Data Science Portal</data>
    <data key="d1">https://www.youtube.com/watch?v=2L0m28ZLmtE</data>
    <data key="d2">Secured self-service data analytics portal built by Sanofi with partner Teamwork for data scientists working on Real World Evidence data. A static web portal (S3 + CloudFront) with Cognito federation to Sanofi SSO, traceability through API Gateway and DynamoDB, Service Catalog products (SageMaker notebooks, RStudio), NLP through Lambda with Translate and Comprehend Medical, and a segregated S3 data lake. Data must stay inside the environment and cannot be downloaded. In production since early August; grew from 5-10 beta testers to 30-40 users within 2-3 weeks.</data>
    <data key="d3">Data Science, Machine Learning, Analytics, Healthcare, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
