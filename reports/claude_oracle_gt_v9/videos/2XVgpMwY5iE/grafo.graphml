<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Hospitals / Biologists / Clients</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Hospitals, biologists and clients send medical images. Hospitals also use the validated model at the end.</data>
    </node>
    <node id="1">
      <data key="d5">Pathologist</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Enriches the data by annotating and labeling the medical images. Validates or refuses the trained model.</data>
    </node>
    <node id="2">
      <data key="d5">Kubernetes Product (Labeling Platform)</data>
      <data key="d6">EKS</data>
      <data key="d7">Product running on Kubernetes that serves as the labeling platform for pathologists. Displays images, model and results. Inference for validated (frozen) models also runs on Kubernetes.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Buckets</data>
      <data key="d6">S3</data>
      <data key="d7">Stores incoming medical images (about 5 TB of data per project) and the trained models. Data stays in the project's region (e.g. Germany for a German project).</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker Training</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains one model per project on the enriched data. Reuses the same Docker containers as the previous static infrastructure, which made migration easy. Thousands of trainings in parallel, training more than 30 times faster, infrastructure cost savings of up to 30%.</data>
    </node>
    <node id="5">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">Used with SageMaker training for I/O performance.</data>
    </node>
    <node id="6">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Security and fine-grained control over data access; helps document and comply with certifications such as HDS.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Hospitals, biologists and clients upload medical images into S3 buckets (about 5 TB per project).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">The pathologist enriches the data by annotating and labeling the images.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="1">
      <data key="d8">1</data>
      <data key="d9">The pathologist validates or refuses the model; a validated model is frozen and moved to inference on Kubernetes.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">The platform shows the images to the pathologists.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Inferred, not stated in the audio: enriched/annotated data written back to S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Enriched data is used to train a model per project in SageMaker, using the same Docker containers.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Images are loaded from S3 into the Kubernetes product.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="1">
      <data key="d8">1</data>
      <data key="d9">The model and results are exported into the Kubernetes product to be shown to the pathologist.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Inferred role: SageMaker relies on IAM for permissions to access the data.</data>
      <data key="d10">1''</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The trained model is stored in an S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">FSx provides high I/O performance storage for training.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Inferred role: IAM enforces security and data access control for training.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Kinaï (as heard in transcript): Medical Image Labeling and Per-Project Model Training on EKS and SageMaker</data>
    <data key="d1">https://www.youtube.com/watch?v=2XVgpMwY5iE</data>
    <data key="d2">Healthcare company building technology for research and clinical studies, guiding pathologists and doctors in analyzing medical images. Hospitals, biologists and clients upload images to S3 (about 5 TB per project). A Kubernetes (EKS) product acts as the labeling platform for pathologists. Enriched data trains one model per project on SageMaker with FSx (I/O performance) and IAM (security). Models are stored in S3 and exported with results back to the Kubernetes product for validation by the pathologist; validated models are frozen and moved to inference, also on Kubernetes, and used by hospitals. Benefits: scientists work on multiple projects at once, switch projects in seconds and run thousands of trainings in parallel; training is more than 30 times faster; infrastructure cost is reduced by up to 30% (dynamic infrastructure, no payment for unused resources). Compliance: HDS certification, data kept in-region (e.g. German project data stays in Germany).</data>
    <data key="d3">Healthcare, Machine Learning, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
