<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Cloud provider security event streams</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Native security event streams from cloud providers (e.g. CloudWatch events, Azure activity log). A collection framework evaluates events, determines the current state of the resource and publishes it. Three major cloud providers supported; billions of events per day.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Streams (Collect)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Collection stream into which the current state of cloud resources is published. A consumer publishes the resources into Neptune.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Data Streams (Rules)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Fronts the rule execution pipeline. Incoming events along with resource changes are propagated here; the rule engine determines which rules (possibly thousands) to execute for a given event and runs them over the Neptune graph.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Primary persistence; graph database for highly interconnected cloud resource data, enabling graph-based exploration. Chosen for read scale-out for rule execution and for being schema-less (agnostic to varied resource configurations). 50M+ resources collected and monitored. Provisioned clusters with customer data load balanced by the sharder service.</data>
    </node>
    <node id="4">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Backing store for search, aggregations, reporting and analytical use cases. Its CloudWatch metrics are also used by the sharder service.</data>
    </node>
    <node id="5">
      <data key="d5">Shard Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sharder service used to scale writes out; provides logical grouping of data stored in provisioned Neptune clusters. Uses CloudWatch metrics (CPU, memory and other parameters) from Neptune and Elasticsearch to determine shard capacity and load balance customers' data; this information flows back to drive write placement decisions.</data>
    </node>
    <node id="6">
      <data key="d5">Slack, email, Splunk</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Real-time notification channels to customers for detected security violations (Slack, email, Splunk and the like).</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Backing store for other use cases such as visualizing how resource configurations changed over time; also persists detected security violations.</data>
    </node>
    <node id="8">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Metrics from Neptune and Elasticsearch (CPU, memory and other parameters) used by the sharder service to determine whether a Neptune cluster is full.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Collection framework evaluates incoming security events, determines current resource state and publishes resources into the Kinesis data stream (billions of events per day).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Stream consumer publishes the ingested cloud resources into Amazon Neptune (50M+ resources).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Incoming events are propagated to the rule execution pipeline, fronted by the rules Kinesis data stream.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Detected security violations are persisted in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Real-time notifications of security violations sent to customers through Slack, email, Splunk and similar channels.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Resource data also stored in Elasticsearch as a backing store for search, aggregation, reporting and analytics.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Resource data also stored in DynamoDB as a backing store, e.g. for how resource configurations changed over time.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Neptune metrics (CPU, memory and other parameters) emitted to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Resource changes, once persisted, are propagated to the rule execution pipeline; rules are exercised over the Neptune graph to perform security checks.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Elasticsearch metrics emitted to CloudWatch.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Sharder service uses CloudWatch metrics to determine shard capacity of the provisioned Neptune clusters and load balance customers' data; the information flows back to guide writes.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">CloudHealth by VMware: Secure State real-time cloud security and monitoring pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=6EUknQqaV1w</data>
    <data key="d2">CloudHealth Secure State collects cloud provider security event streams, publishes resource state into Kinesis Data Streams, persists it in Amazon Neptune (primary graph store) with Elasticsearch and DynamoDB as backing stores, scales writes through a sharder service driven by CloudWatch metrics, and executes rules through a second Kinesis stream, persisting violations in DynamoDB and notifying customers via Slack, email and Splunk. Scale: billions of events per day, 50M+ resources, three major cloud providers.</data>
    <data key="d3">Security, Analytics, Graph Database, Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
