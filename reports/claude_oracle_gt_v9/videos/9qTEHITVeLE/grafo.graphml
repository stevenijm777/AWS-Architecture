<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Frontend / Applications / Data Analysts &amp; Data Scientists</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Frontend that connects to the MetaManager; business applications and APIs that publish and consume data; data analysts and data scientists who consume data, run models and build dashboards.</data>
    </node>
    <node id="1">
      <data key="d5">EKS - MetaManager</data>
      <data key="d6">EKS</data>
      <data key="d7">MetaManager, the 'brains of the Grid', built as a microservice architecture on EKS. Abstracts the complexity of the technology needed to move data, discovers tables, schemas and APIs, and applies data protection rules.</data>
    </node>
    <node id="2">
      <data key="d5">Multiple Data Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data sources spread across different networks, countries and technologies (tables, schemas, APIs).</data>
    </node>
    <node id="3">
      <data key="d5">Elastic Search &amp; Neo4J</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">MetaStore: a combination of a document database (Elasticsearch) and a graph database (Neo4J) that stores the discovered metadata.</data>
    </node>
    <node id="4">
      <data key="d5">Vertica</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Analytical data store that receives data from the data lake for consumption.</data>
    </node>
    <node id="5">
      <data key="d5">S3 Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized data lake holding around 60 TB. All data is stored in S3.</data>
    </node>
    <node id="6">
      <data key="d5">Kafka</data>
      <data key="d6">MSK</data>
      <data key="d7">Kafka enterprise streaming platform shared across all the companies: 600 topics, 250 GB, 7-day average retention period.</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Relational data store that receives data from the data lake; data can be published or consumed through APIs or OLTP.</data>
    </node>
    <node id="8">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Used together with Kafka to bring data into the data lake, and to move data out to the consumption stores and applications.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">The frontend connects to the MetaManager.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Data from applications and APIs is consumed into the platform.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Discovered metadata is stored in the MetaStore (document + graph database).</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">The MetaManager discovers which tables, schemas and APIs exist in the data sources.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Data from the sources is streamed into Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Data from the sources is ingested with EMR.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Data leaves the data lake through EMR for consumption, with the MetaManager's protection rules applied.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="1">
      <data key="d8">3</data>
      <data key="d9">Data is read from the data lake to be brought back to the business.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Data from the data lake is published to the Kafka enterprise streaming platform.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka streams the data into the S3 data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR writes the collected data into the S3 data lake.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="1">
      <data key="d8">3</data>
      <data key="d9">Application data is written into the data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Data is sent to RDS for consumption by analysts and data scientists.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Data is sent to Vertica for consumption by analysts and data scientists.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="0" id="0">
      <data key="d8">3</data>
      <data key="d9">Data is brought back to business applications, e.g. for cross-brand campaigns and push notifications.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Majid Al Futtaim - The Grid: Enterprise Data Platform (Collect, Protect, Connect)</data>
    <data key="d1">https://www.youtube.com/watch?v=9qTEHITVeLE</data>
    <data key="d2">Majid Al Futtaim's data platform, 'the Grid', built on three pillars: collect, protect and connect the data. A MetaManager (microservices on EKS) abstracts the complexity and stores metadata in a MetaStore (Elasticsearch + Neo4J). Kafka and EMR bring data from multiple sources into an S3 data lake (~60 TB). Data is served to RDS and Vertica for analysts and data scientists and connected back to business applications through an enterprise streaming platform. All infrastructure is defined as code and can be spun up and down; the first MVP reached production in six months. Business benefit: a 360-degree customer view enabling cross-brand marketing campaigns.</data>
    <data key="d3">Analytics, Data Lake, Streaming, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
