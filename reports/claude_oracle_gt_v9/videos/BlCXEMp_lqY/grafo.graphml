<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Vizio Smart TV</data>
      <data key="d6">UserConsumerTV</data>
      <data key="d7">Millions of connected devices generating logs, performance telemetry and application usage (user) data; billions of events per month. TVs talk directly to Kinesis.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Streams</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Front door to the cloud; everything is piped through it. 8-shard pipeline that has not yet needed scaling. Data arrives in different formats with no fixed schema.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Takes the data as is and delivers it to Redshift and S3.</data>
    </node>
    <node id="3">
      <data key="d5">Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for events/logs/user data. Only a subset of columns is imported. Columnar storage gives optimized IO for large aggregations over billions of rows. Replaced an earlier Aurora experiment; reloaded from S3 and streams without data loss.</data>
    </node>
    <node id="4">
      <data key="d5">QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualization and reporting. Uses the in-memory SPICE engine; custom SQL queries load subsets of data from Redshift into SPICE datasets for fast slicing and dicing.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term store of raw historical events/logs/user data, kept forever for future use; allows reloading the data warehouse.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">TVs send logs, performance telemetry and user data directly to Kinesis Data Streams.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Response/acknowledgment back to the TV (not described in the audio).</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Stream data in any format is piped to Firehose.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose takes the data as is and loads it into Redshift (subset of columns).</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw data stored in S3 for long-term retention.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Return/acknowledgment from Redshift to Firehose (not described in the audio).</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Query results are downloaded into SPICE in-memory datasets for reports.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">QuickSight runs custom SQL queries against Redshift.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Return from S3 to Firehose (not detailed in the audio); S3 data can be reloaded into Redshift when needed.</data>
      <data key="d10">4'</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Vizio Smart TV Telemetry Analytics Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=BlCXEMp_lqY</data>
    <data key="d2">Vizio ingests logs, performance telemetry and user data from millions of connected smart TVs (billions of events per month) through Kinesis Data Streams and Firehose into Redshift and S3, visualized with QuickSight. Built with AWS Professional Services: prototype in a few weeks, production in about six weeks. Aurora was tried first but did not aggregate billions of rows well, so they migrated to Redshift.</data>
    <data key="d3">Analytics, IoT, Data Warehouse, Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
