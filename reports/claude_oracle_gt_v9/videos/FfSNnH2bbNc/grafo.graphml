<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Satellite</data>
      <data key="d6">UserConsumerSatellite</data>
      <data key="d7">Existing satellites from organizations such as NASA. Delivers a series of modestly processed and corrected imagery tiles throughout each day.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 Spot</data>
      <data key="d6">EC2</data>
      <data key="d7">Large cluster of Spot instances spun up as quickly as possible to post-process incoming imagery (further correction and conversion to more accessible formats), then spun back down.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the bulk imagery data as relatively large compressed chunks. About 5 PB in total, catalogue spanning about 30 years (mostly the last 10), growing about 100 GB per day. Read partially using HTTP range requests.</data>
    </node>
    <node id="3">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores imagery metadata; used to look up which source imagery corresponds to a tile or area of interest.</data>
    </node>
    <node id="4">
      <data key="d5">AWS Fargate</data>
      <data key="d6">Fargate</data>
      <data key="d7">Cluster serving map web tiles. A map load is sliced into about 16 tiles, each an individual request. Stitches image parts together, downsamples to the right resolution, then applies colour correction (RGB) or colour mapping (intensity values) on the fly.</data>
    </node>
    <node id="5">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Redis used as a central cache for already generated tiles. Common tiles (such as the whole-US view) are computed once and then served from cache.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Series of Lambda functions that compute a time series from the source data cube: build the tile of interest, clip it to the farmer's custom field area, compute a summary (e.g. mean greenness), repeated about 1000 times.</data>
    </node>
    <node id="7">
      <data key="d5">Users</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Farmers using the web app: view a map of the United States with the most up-to-date imagery, select layer and time frame, and supply their field boundaries.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Satellite imagery tiles arrive throughout the day for post-processing.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Stores processed bulk imagery outputs (about 100 GB per day).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Stores imagery metadata.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9" />
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Returns the small image subsections to be stitched together.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Returns imagery data to be clipped to the field and summarised.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9" />
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Returns source imagery metadata.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Returns imagery metadata.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Reads from and writes generated tiles to the Redis cache as needed.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Looks up which source imagery corresponds to the requested tile.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">HTTP range requests to read only the needed part of each compressed object.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Serves the stitched, downsampled and colour-corrected or colour-mapped tile back to the user.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Returns cached tiles so common tiles are not recomputed.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Looks up the imagery needed for the area of interest.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Reads the required imagery.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Returns the computed time series (e.g. mean greenness of the field over the year).</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">User loads the map; about 16 individual web tile requests, with selected layer and time frame.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Farmer's custom field area of interest is passed to the series of Lambda functions.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Indigo Carbon: Serverless Satellite Imagery Processing for Regenerative Agriculture</data>
    <data key="d1">https://www.youtube.com/watch?v=FfSNnH2bbNc</data>
    <data key="d2">Indigo Carbon ingests satellite imagery (e.g. from NASA) with EC2 Spot clusters, stores bulk data in S3 and metadata in RDS, serves map web tiles on the fly from Fargate with a Redis cache in ElastiCache, and computes per-field time series with Lambda functions. Catalogue spans about 30 years (mostly the last 10), about 5 PB in total, growing about 100 GB per day. On-the-fly processing saves orders of magnitude of cost.</data>
    <data key="d3">Serverless, Analytics, Geospatial, Agriculture, Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
