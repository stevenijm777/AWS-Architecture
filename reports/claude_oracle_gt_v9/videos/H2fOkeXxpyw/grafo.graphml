<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Developer (Forge CLI)</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developer writes code in JavaScript or TypeScript and deploys it with the Forge CLI. To them it looks like a normal JavaScript function.</data>
    </node>
    <node id="1">
      <data key="d5">Deployment Web Service (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Web service that developers deploy code to. Sits behind an ALB so it can scale to handle load from thousands of customers. Stores deployment state in DynamoDB and queues deployment requests on SQS instead of creating Lambdas directly.</data>
    </node>
    <node id="2">
      <data key="d5">DynamoDB (Deployment State)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores the state of all deployments, e.g. progress, completed or failed, so the result can be reported back to the user.</data>
    </node>
    <node id="3">
      <data key="d5">SQS (Deployment Request Queue)</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues deployment requests because the Lambda control plane limits how many Lambdas can be created in a given time interval. Decouples ingestion from Lambda creation to avoid rate limiting.</data>
    </node>
    <node id="4">
      <data key="d5">Deployment Worker (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Back-end service that reads deployment requests from SQS and creates the Lambda in its own time, when allowed, so it is not rate limited.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Customer Code)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Runs customer code translated into Lambda functions. Lives in a separate AWS account that contains nothing else; the Forge account and the Lambda account do not touch each other. Multi-tenant: a Lambda can be shared between customers. On every request a V8 isolate (a JavaScript V8 engine construct, like a tiny empty virtual machine) is spun up to run the customer's code and deleted afterwards, so global variables and state are not shared across invocations. No data is stored in the Lambda.</data>
    </node>
    <node id="6">
      <data key="d5">Browser (End User)</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">User's browser that triggers invocation of the deployed app and renders the returned page fragment.</data>
    </node>
    <node id="7">
      <data key="d5">Invocation Service (EC2)</data>
      <data key="d6">EC2</data>
      <data key="d7">Internal service that checks security permissions (is the user allowed to execute that Lambda), finds the right Lambda for that user and product, and invokes it with the correct parameters.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer deploys JavaScript/TypeScript code via the CLI to the web service.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Store deployment state to track progress of the deployment.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Queue the deployment request onto SQS to avoid Lambda control plane rate limits.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Report back to the user what happened to the deployment.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Read deployment state (in progress, completed, failed).</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Back-end service reads deployment requests from the queue at its own pace.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Creates the Lambda function with the customer code when allowed; the Lambda is in a different account across the account boundary.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda returns data and a page fragment is constructed and returned to the browser, which renders it.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Browser calls the internal service to invoke the app.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">After the permission check and Lambda lookup, invokes the Lambda and sends the correct parameters.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Atlassian Forge: Multi-Tenant Custom App Deployment and Invocation Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=H2fOkeXxpyw</data>
    <data key="d2">Atlassian Forge lets customers, developers and third-party vendors build custom apps that extend Atlassian products. Two parts: deployment of customer code (CLI -&gt; EC2 web service -&gt; DynamoDB state + SQS queue -&gt; EC2 worker -&gt; Lambda creation) and invocation (browser -&gt; EC2 internal service -&gt; Lambda -&gt; page fragment back to browser). Customer Lambdas run in a separate AWS account from the Forge platform; Lambdas are multi-tenant and isolated per request with V8 isolates. Serves thousands of customers.</data>
    <data key="d3">Serverless, SaaS, Multi-Tenancy, Security, Developer Platform</data>
    <data key="d4">True</data>
  </graph>
</graphml>
