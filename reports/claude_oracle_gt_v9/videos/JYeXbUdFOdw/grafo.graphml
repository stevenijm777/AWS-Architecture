<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 buckets: raw data in CSV or Excel format is uploaded here; a validated copy is stored in a different folder; reports with more than 10,000 records are uploaded here for download via pre-signed URL.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda #1</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered when raw data is uploaded; validates the data. Discrepancies are highlighted, otherwise a validated copy is uploaded to a different folder in S3.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda #2</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered once the validated copy is available; processes the validated data and ingests it into the OpenSearch cluster.</data>
    </node>
    <node id="3">
      <data key="d5">UserConsumerWeb</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">User accessing the data through the web application (Angular front end via the web browser) or the mobile application (requests go directly to the backend).</data>
    </node>
    <node id="4">
      <data key="d5">OpenSearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Amazon OpenSearch cluster on Graviton2 instances (25 to 30 percent operating cost savings, roughly 100K dollars). Query templates are created and mapped to relevant indexes; OpenSearch analyzer is used to fine-tune queries and enhance performance; an aggregated layer on top of the processed data serves complex reports such as trend analysis and aggregation reports. About 5 billion records, responses within 2 to 4 seconds.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS, part of the data layer queried by the backend application.</data>
    </node>
    <node id="6">
      <data key="d5">SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends a notification to the user to download large reports (more than 10,000 records) using a pre-signed URL.</data>
    </node>
    <node id="7">
      <data key="d5">Novetiq backend</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Backend application developed in Python. Receives requests from the web browser or directly from the mobile app, queries the data layer and returns the response to the user.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw data upload (CSV/Excel) to S3 triggers the Lambda that validates the data.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">The validated copy in S3 triggers the Lambda that processes the validated data.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The request goes back to the browser; also used to download large reports using the pre-signed URL.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">A notification is sent to the user via SES to download the report using the pre-signed URL.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Validation of the raw data; any discrepancy within the data is highlighted.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="1">
      <data key="d8">0</data>
      <data key="d9">A copy of the validated data is uploaded to a different folder within the S3 buckets.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Processing Lambda accesses the validated data in S3.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Processed data is ingested into the OpenSearch cluster (query templates mapped to indexes, aggregated layer for complex reports).</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">User sends the request to the front-end web application (Angular) via the web browser.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Request goes from the browser to the backend application (Python); mobile app requests go directly to the backend.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Data layer returns the response to the backend application.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Backend sends the request to the data layer.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Response is sent back to the user via the backend application; 15 to 20 complex parameters within 2 to 4 seconds.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">When a requested report has more than 10,000 records, the report is uploaded to the S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cybex Trade Data Processing and Retrieval with Amazon OpenSearch (Novetiq)</data>
    <data key="d1">https://www.youtube.com/watch?v=JYeXbUdFOdw</data>
    <data key="d2">Event-driven data ingestion and retrieval architecture for Cybex export/import trade data and reports. Grew from 1.5 billion records to about 5 billion (more than 3.5x) on the same architecture, still returning data and reports with 15 to 20 complex parameters within 2 to 4 seconds. Graviton2 instances for Amazon OpenSearch save 25 to 30 percent of operating cost (roughly 100K dollars). Reports with more than 10,000 records are uploaded to S3 and delivered through an SES notification with a pre-signed URL. Users access the data through a web application (Angular front end) or a mobile application; the backend is developed in Python.</data>
    <data key="d3">Analytics, Data Processing, Serverless, Search</data>
    <data key="d4">True</data>
  </graph>
</graphml>
