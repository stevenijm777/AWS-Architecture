<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Almosafer customers; about 300k requests per minute on average.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Cost-efficient storage for static content and images; the platform is heavy on content.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN entry point for all traffic (about 300k requests per minute).</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Edge logic that decides which region and device the traffic comes from in order to route requests; first layer of scaling and resiliency.</data>
    </node>
    <node id="4">
      <data key="d5">Load Balancer</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Roughly 60 load balancers; decide between backend service traffic and web (frontend) traffic, and route between legacy systems and new microservices.</data>
    </node>
    <node id="5">
      <data key="d5">Mongo DB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Self-managed MongoDB instances on EC2 for services that need NoSQL; Kafka (drawn as MONGO/KAFKA) plays a major role for the event-driven microservices.</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Core for all backend and micro-frontend services; about 80% of services migrated; more than 250 microservices on over 1400 pods in production.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 - Legacy application</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts the legacy monolithic systems that are being gradually migrated to microservices.</data>
    </node>
    <node id="8">
      <data key="d5">EC2 - Monitoring tools</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts self-managed tools such as Prometheus and the ELK stack for monitoring and logs; tied to alerting through Slack and PagerDuty.</data>
    </node>
    <node id="9">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Managed SQL database for services that need proper transactions.</data>
    </node>
    <node id="10">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">AWS-native monitoring used to check that pod health is in proper shape; tied to the alerting system.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">User traffic (about 300k requests per minute) goes through CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 serves static content and images to CloudFront.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront requests static content and images from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront invokes Lambda to determine the region and device of the traffic.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Traffic is forwarded to the load balancers (about 60).</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda returns the routing decision to CloudFront.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes frontend and backend traffic to the microservices on EKS.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes traffic to the legacy application on EC2.</data>
      <data key="d10">6'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">The load balancer returns responses to CloudFront.</data>
      <data key="d10">10</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">MongoDB/Kafka returns data and events to the microservices.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices read/write NoSQL data in self-managed MongoDB and use Kafka for event-driven communication.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Services that need transactional SQL query RDS.</data>
      <data key="d10">7'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS services return responses to the load balancer.</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch monitors pod health.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Self-managed Prometheus and ELK on EC2 monitor every service and its logs; alerts go to Slack and PagerDuty.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">The legacy application returns responses to the load balancer.</data>
      <data key="d10">9'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">RDS returns query results to the microservices.</data>
      <data key="d10">8'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Seera Group: Scalable Microservices Travel Platform (Almosafer) on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=a6kqyqTNJM4</data>
    <data key="d2">Seera Group's Almosafer travel platform receives about 300k requests per minute through CloudFront, with S3 for static content and Lambda for edge routing decisions. Around 60 load balancers route between frontend/backend and between legacy EC2 monoliths and EKS microservices (80% migrated, 250+ microservices, 1400+ pods). The data layer is self-managed MongoDB on EC2, RDS and Kafka. Monitoring uses CloudWatch, Prometheus and ELK, with alerting to Slack and PagerDuty.</data>
    <data key="d3">Travel, Microservices, Containers, Content Delivery, Migration, Monitoring</data>
    <data key="d4">True</data>
  </graph>
</graphml>
