<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">TWD/CNN Center (Atlanta on-prem)</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Techwood / CNN Center on-prem site in Atlanta. Linear Ops QCs the master files here. Receives the cloud playout as a unicast signal, compresses it and brings it to the uplink. An on-site auto changeover switch selects between Techwood playout, CNN Center playout and cloud playout. Evertz CloudBridge endpoint in Atlanta.</data>
    </node>
    <node id="1">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores all master files for all the brands. Files arrive via Aspera and are registered in Evertz Mediator.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 (Evertz ORT playout)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instances running Evertz ORT software; files are played out using Evertz Playtime. 10 channels per AZ in us-east-1 (30 channels total), each channel with a primary and a backup. Supported by Auto Scaling groups. Multi-AZ redundancy targeting five nines availability. Evertz CloudBridge carries the signal from the ORT back to site.</data>
    </node>
    <node id="3">
      <data key="d5">Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">Carries the playout back to prem as a unicast signal. Evertz CloudBridge bookends the connection (AWS, New York, Atlanta). Also carries the BCP path to Hudson Yards in New York.</data>
    </node>
    <node id="4">
      <data key="d5">Uplink (ATL / NYC)</data>
      <data key="d6">UserCompanyEdge</data>
      <data key="d7">Satellite uplinks for distribution to affiliates. The Atlanta uplink is fed from the on-prem site after compression; the NYC (Hudson Yards) uplink is fed by the BCP path with 8 channels.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Master files QC'd by Linear Ops in Atlanta are sent via Aspera up to S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">The signal is compressed and brought to the uplink for distribution to affiliates.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Once registered in Evertz Mediator, the files are transferred to the local EC2 running Evertz ORT.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Playout from Evertz Playtime goes out via Direct Connect, using Evertz CloudBridge.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Playout returns to prem as a unicast signal: the 'X chain', a tertiary path to air.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">BCP path: Direct Connect to Hudson Yards (NYC), 8 channels, also fed to an uplink. Stated in the audio; not in the connection ledger.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">WarnerMedia HBO: Cloud Linear Playout</data>
    <data key="d1">https://www.youtube.com/watch?v=hMK2NJ-q9nc</data>
    <data key="d2">Cloud linear playout for HBO/WarnerMedia in AWS us-east-1 supporting 30 channels. It started as a BCP (business continuity) solution. Deployed through about 40 scrubbed CloudFormation YAML templates as a repeatable process (deployment only, not a runtime participant). Multi-AZ redundancy targeting five nines availability. Evertz CloudBridge bookends the connection between AWS, New York and Atlanta. Future plans: live venue inputs on the ORT with switching between live and pre-recorded content, and muxing/compression in the cloud to hand off directly to an MVPD.</data>
    <data key="d3">Media &amp; Entertainment, Linear Playout, Business Continuity, Hybrid Connectivity</data>
    <data key="d4">True</data>
  </graph>
</graphml>
