<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Independent Agents</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Independent insurance agents of Main Street America who request the single-page application and make back-end API calls.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Serves the single-page application from the S3 bucket to the agents. Replaces the former Apache server.</data>
    </node>
    <node id="2">
      <data key="d5">S3 SPA Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Bucket hosting the modernized single-page application (previously served from Apache).</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for back-end calls; replaces load-balanced on-prem Tomcat servers. First calls the Lambda authorizer, then the back-end Lambda.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda Authorizer</data>
      <data key="d6">Lambda</data>
      <data key="d7">Separate Lambda for ACL: modern Lambda authorizer that validates the caller has access.</data>
    </node>
    <node id="5">
      <data key="d5">Python Backend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless Python Lambda that scales up and down easily. Hosts the functions already modernized and decides whether to handle the request itself or call the legacy Tomcat application for functions not yet migrated.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 Legacy Tomcat Application</data>
      <data key="d6">EC2</data>
      <data key="d7">Legacy Tomcat application still hosting un-migrated functionality such as user management; being slowly strangled. No autoscaling, no spot.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB User Cache</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores/caches user information. Regional, so Lambda instances in any Availability Zone can access the cache, and it survives the loss of an Availability Zone without a pause. Needed because successive API calls may hit different Lambda instances, so caching locally is not possible.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Agents request the single-page application.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The application makes back-end calls to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront fetches the single-page application from the S3 bucket origin.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront serves the single-page application to the agents.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 returns the single-page application assets to CloudFront.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway first invokes the Lambda authorizer to validate that the caller has access.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway calls the serverless Python Lambda.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway returns the API response to the agent's application.</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Authorizer returns the access validation result to API Gateway.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda caches / looks up user information in DynamoDB.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">For functions not yet migrated (e.g. user management), the Lambda calls the legacy Tomcat application.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda returns the response to API Gateway.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The legacy Tomcat application calls back / returns its result to the Lambda.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Cached user information is returned to the Lambda.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">American Family Group (Main Street America) - Legacy Agent Application Modernization with Strangler Pattern</data>
    <data key="d1">https://www.youtube.com/watch?v=wjtSHyENv0I</data>
    <data key="d2">Legacy application for independent agents being incrementally modernized (strangler pattern) from on-prem Apache and load-balanced Tomcat/Java servers to a serverless stack. New features, significant enhancements and significant bug fixes are moved to serverless Python Lambdas; remaining functions (e.g. user management) still run in the Tomcat application. Benefits: 25 on-prem servers shut down, user satisfaction up 25%, 10% new users, lower cost.</data>
    <data key="d3">Modernization, Serverless, Migration, Insurance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
