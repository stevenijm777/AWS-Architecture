<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">UserCompanyDrone</data>
      <data key="d6">UserCompanyDrone</data>
      <data key="d7">Drones flown by licensed third-party pilots that routinely capture imagery of every well pad, replacing manual inspection by people.</data>
    </node>
    <node id="1">
      <data key="d5">Imagery process (into three files per well pad)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Third-party software and server that processes drone imagery into three files per well pad: an orthomosaic (high-resolution top-down view), a digital terrain model and a digital elevation model. Exposes an API to check for new flights and images.</data>
    </node>
    <node id="2">
      <data key="d5">on-premises database &amp; server</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-prem mapping software. The database stores the raster proxies; the server handles user queries. The server cannot read imagery directly from S3 without raster proxies. No application change was needed to use Storage Gateway. Used by maintenance and operations teams to spot equipment issues, plan preventative maintenance and check well pad health.</data>
    </node>
    <node id="3">
      <data key="d5">CloudWatch Event</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">CloudWatch event running on a scheduled basis that calls the Step Functions workflow.</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket in the Marathon Oil environment storing the processed imagery data.</data>
    </node>
    <node id="5">
      <data key="d5">StorageGateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">Lets the on-prem mapping software read image files from the S3 bucket, using the raster proxies.</data>
    </node>
    <node id="6">
      <data key="d5">StepFunctions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Workflow of three Lambda steps: test whether new imagery data is available; pull images from the third party to S3; process images into raster proxies.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda - check for new imagery</data>
      <data key="d6">Lambda</data>
      <data key="d7">First Lambda: calls the third-party software API to determine whether new images or new flights are available.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda - pull imagery to S3</data>
      <data key="d6">Lambda</data>
      <data key="d7">Second Lambda: called when a new flight or image is found; takes the images from the third party and stores them in the S3 bucket.</data>
    </node>
    <node id="9">
      <data key="d5">Lambda - create raster proxies</data>
      <data key="d6">Lambda</data>
      <data key="d7">Third Lambda: turns the S3 images into raster proxies, which act like URLs telling the on-prem server how to fetch the images (the on-prem software cannot read directly from S3). The raster proxies are stored in the on-prem server's database.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Drone imagery is loaded into the third-party software, which creates three files per well pad.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">The third-party API responds with the availability of new images or flights.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Image files are pulled from the third-party server.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">When a user views images, the mapping software uses the raster proxy to request the image files via Storage Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">The CloudWatch event calls the Step Functions workflow on a scheduled basis.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Write acknowledgment from S3.</data>
      <data key="d10">9</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 images are read to create the raster proxies.</data>
      <data key="d10">13</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Image files are returned from S3 to Storage Gateway.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Storage Gateway finds the image files in the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Image files are delivered to the on-prem mapping server and displayed to the end user.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes the first Lambda to check for new imagery.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">If new imagery is found, Step Functions invokes the second Lambda.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Step Functions invokes the third Lambda to create raster proxies.</data>
      <data key="d10">11</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">The Lambda calls the third-party API to check whether new images or flights are available.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Returns the check result to the workflow (new flight or image found).</data>
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">The Lambda requests the image files from the third party.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">The Lambda stores the images in the S3 bucket.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Returns completion of the image pull to the workflow.</data>
      <data key="d10">10</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">The Lambda accesses the images stored in S3.</data>
      <data key="d10">12</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Raster proxies (URL-like references) are stored in the on-prem server's database.</data>
      <data key="d10">14</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Marathon Oil: Serverless Drone Imagery Processing for Well Pad Monitoring</data>
    <data key="d1">https://www.youtube.com/watch?v=ww5fiygF6eg</data>
    <data key="d2">Drones flown by licensed third-party pilots capture well pad imagery, which third-party software processes into three files per well pad (orthomosaic, digital terrain model, digital elevation model). A scheduled CloudWatch event calls a Step Functions workflow of three Lambda functions: check for new imagery, pull it to S3, and create raster proxies stored in the on-prem database. The on-prem mapping software reads the imagery from S3 via Storage Gateway for maintenance and operations teams.</data>
    <data key="d3">Serverless, Hybrid Storage, Energy, Image Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
