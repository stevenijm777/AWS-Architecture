<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Prem</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premise data sources; standard syslog or Kafka integration pulls events directly into Apache Metron.</data>
    </node>
    <node id="1">
      <data key="d5">S3 (telemetry source)</data>
      <data key="d6">S3</data>
      <data key="d7">AWS public cloud telemetry source; events are pulled into Apache Metron via Apache NiFi workflows.</data>
    </node>
    <node id="2">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">AWS public cloud telemetry source; events are pulled into Apache Metron via Apache NiFi workflows.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">AWS public cloud telemetry source; events are pulled into Apache Metron via Apache NiFi workflows.</data>
    </node>
    <node id="4">
      <data key="d5">CloudTrail</data>
      <data key="d6">CloudTrail</data>
      <data key="d7">AWS public cloud telemetry source; CloudTrail log messages are parsed into JSON by Apache Metron.</data>
    </node>
    <node id="5">
      <data key="d5">GuardDuty</data>
      <data key="d6">GuardDuty</data>
      <data key="d7">AWS public cloud telemetry source; GuardDuty log messages are parsed into JSON by Apache Metron.</data>
    </node>
    <node id="6">
      <data key="d5">Apache Metron</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Heart of the next-gen SOC. Parses telemetry into JSON, enriches events with contextual intelligence (geolocation, AS number, server role such as flight/hotel/payment), does stream profiling over limited time windows, and detects abnormal behaviour (e.g. producer-consumer ratio deviation). About 20 data sources, about 5000 events per second. Persists data in HDFS.</data>
    </node>
    <node id="7">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">EMR job picks up persistent data from Apache Metron's HDFS and transforms it into S3. Part of the security data lake.</data>
    </node>
    <node id="8">
      <data key="d5">S3 (Security Data Lake)</data>
      <data key="d6">S3</data>
      <data key="d7">Serverless security data lake storage holding telemetry for months to years; about 250 million events indexed per day.</data>
    </node>
    <node id="9">
      <data key="d5">Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL queries and analytics over S3 for log mining, analytics, forensics and threat hunting; builds long-term models/profiles that are fed back to Apache Metron.</data>
    </node>
    <node id="10">
      <data key="d5">SOAR (Blitz)</data>
      <data key="d6">EC2</data>
      <data key="d7">Security orchestration and response platform called Blitz (open source on GitHub). Takes alerts from Metron, adds further context (reverse DNS, whois lookup), presents them in a single pane of glass (mobile, Jira integration) and integrates with WAF, firewalls and internal routers for response.</data>
    </node>
    <node id="11">
      <data key="d5">SOC Analyst (Alerts)</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">SOC analyst receives enriched alerts on a mobile handset or via Jira and responds at the click of a button, e.g. blocking a source.</data>
    </node>
    <node id="12">
      <data key="d5">WAF</data>
      <data key="d6">WAF</data>
      <data key="d7">Response integration target; settings are modified to mitigate threats, e.g. blocking a source.</data>
    </node>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">On-prem events pulled directly into Apache Metron via syslog or Kafka integration.</data>
      <data key="d10">0'''''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry events pulled from S3 into Apache Metron (via Apache NiFi workflows).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry events pulled from SNS into Apache Metron (via Apache NiFi workflows).</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Telemetry events pulled from SQS into Apache Metron (via Apache NiFi workflows).</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudTrail logs ingested into Apache Metron and parsed into JSON.</data>
      <data key="d10">0'''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">GuardDuty logs ingested into Apache Metron and parsed into JSON.</data>
      <data key="d10">0''''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Persistent data in Apache Metron's HDFS is picked up by an EMR job.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Alerts from Apache Metron are sent to the SOAR platform (Blitz).</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR job transforms the persistent HDFS data and writes it to S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena runs SQL queries and analytics on S3 data (log mining, analytics, forensics).</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Feedback loop: models/profiles built over months of telemetry are fed back into Apache Metron for more accurate enrichment and profiling.</data>
      <data key="d10">3</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="11" id="0">
      <data key="d8">2</data>
      <data key="d9">Enriched alert (reverse DNS, whois) presented to the SOC analyst in a single pane of glass via mobile or Jira.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="10" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">Control packet to modify WAF settings and mitigate the threat (e.g. block the source).</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9" />
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="11" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Analyst triggers a response action at the click of a button (e.g. block a source).</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="12" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9" />
      <data key="d10">4</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">MakeMyTrip Next-Gen SOC with Apache Metron and Serverless Security Data Lake</data>
    <data key="d1">https://www.youtube.com/watch?v=-3lnf5lzsH0</data>
    <data key="d2">MakeMyTrip built a next-gen SOC from the ground up: hybrid data ingest (AWS and on-prem) into Apache Metron for parsing, enrichment and profiling; a serverless security data lake (EMR, S3, Athena) for long-term telemetry with a feedback loop into Metron; and a SOAR platform (Blitz, open source) for semi-automated incident response, e.g. via WAF. Scale: about 20 data sources, about 5000 events per second, about 250 million events indexed per day.</data>
    <data key="d3">Security, Analytics, Data Lake</data>
    <data key="d4">True</data>
  </graph>
</graphml>
