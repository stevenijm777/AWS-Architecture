<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Application Discovery Service</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Agent installed on on-premises servers. Provides inbound and outbound TCP connections and performance utilization used to determine the instance types to provision in AWS.</data>
    </node>
    <node id="1">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Filled by the migration team with operational metadata: RTOs, RPOs, infrastructure owners, business owners, tags to be placed on the EC2 instance (around 10 tags per server), target account, subnet, IP and instance type. Future: store TSO Logic instance types here.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 Migration Factory (orchestration and processing)</data>
      <data key="d6">EC2</data>
      <data key="d7">Migration factory that moves the server from on-premises to AWS and performs all integrations via API calls: gathers TCP connections from Application Discovery Service, calls CloudEndure to stop replication, bakes the AMI, shares the AMI (encrypted) with the target account using DynamoDB metadata, and starts the instance. The whole flow takes about 10 minutes instead of 3-4 hours.</data>
    </node>
    <node id="3">
      <data key="d5">EC2 Hot Replica</data>
      <data key="d6">EC2</data>
      <data key="d7">Hot replicated instance holding the continuously replicated block-level data of the on-premises servers (CloudEndure). Source for the baked AMI.</data>
    </node>
    <node id="4">
      <data key="d5">EC2 Migrated Instance (target account)</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 instance in the target account to which the on-premises server has been migrated. Launched from the shared AMI with the instance type, specific IP address, subnet and about 10 tags taken from DynamoDB.</data>
    </node>
    <node id="5">
      <data key="d5">Migration Team</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Fills DynamoDB with operational metadata and issues a single command in Slack to kick off the migration.</data>
    </node>
    <node id="6">
      <data key="d5">On Premise Infra</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises servers on which the Application Discovery agent and the CloudEndure live migration agent are installed.</data>
    </node>
    <node id="7">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Chat interface from which the migration is kicked off with one command that calls the API on the EC2 migration factory.</data>
    </node>
    <node id="8">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">CloudEndure live migration: continuous block-by-block volume replication from the on-premises server to AWS. Replication is stopped via API call at migration time.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Returns the TCP inbound/outbound connection metadata to the migration factory.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">API call to Application Discovery Service to gather the inbound and outbound TCP connections.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">API call to CloudEndure to stop the replication.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Shares the baked AMI (encrypted) with the target account using DynamoDB metadata, then starts the instance with the instance type, specific IP and about 10 tags.</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration team fills DynamoDB with operational metadata: RTOs, RPOs, owners, tags, target account, subnet, IP.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Migration team issues one command in Slack to kick off the migration.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Discovery agent installed on the on-premises server sends inbound/outbound TCP connections and performance utilization metadata.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudEndure agent continuously replicates volumes block by block from the on-premises server to the hot replica in AWS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Slack calls the API on the EC2 migration factory, which starts the migration.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudEndure stops the replication and responds; the migration factory then bakes the AMI from the hot replica.</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Versent Migration Factory: Automated On-Premises to AWS Server Migration</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Versent automated server migration from on-premises to AWS, reducing migration time from about 3-4 hours per server to about 10 minutes. Uses Application Discovery Service for TCP connection and performance metadata, CloudEndure for continuous block-level replication, DynamoDB for operational metadata, and an EC2-based migration factory triggered from Slack that bakes an AMI, shares it (encrypted) with the target account and launches the tagged instance. Future: use TSO Logic instance type recommendations stored in DynamoDB instead of Discovery Service performance metrics.</data>
    <data key="d3">Migration, Automation, DevOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
