<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">UserCompanyDeveloper</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">End user (developer) who opens the Orion portal to request a new environment, providing the environment name, business use case and business vertical.</data>
    </node>
    <node id="1">
      <data key="d5">Route53</data>
      <data key="d6">Route53</data>
      <data key="d7">DNS resolution for the Orion portal URL; resolves to the Application Load Balancer.</data>
    </node>
    <node id="2">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer that forwards the request to the Kubernetes pods.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Container orchestrator running all workloads. Uses 100% Spot instances for cost efficiency. The main application pod creates one Kubernetes job per microservice (an environment for a business vertical may need 70+ microservices). AWS Node Termination Handler listens for Spot termination events and drains nodes so workloads shift to another node. Scaled from 100 pods to 10,000+ pods.</data>
    </node>
    <node id="4">
      <data key="d5">SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives an event whenever a job is triggered to create a microservice and fans the message out to SQS.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds job state messages. A replacement job watches the queue to detect unfinished jobs (e.g. a microservice launch interrupted by Spot termination) and completes them, keeping a consistent state for provisioning and maintenance of environments.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User opens the Orion portal URL; DNS resolution goes to Amazon Route 53.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Route 53 resolves the DNS to the Application Load Balancer.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB sends the environment-creation request (name, business use case, business vertical) to the application pod running on EKS.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Each Kubernetes job triggered to create a microservice sends an event to Amazon SNS.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The replacement job watches (polls) SQS for unfinished jobs and completes the pending microservice launch.</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SNS fans out the job message to SQS, storing the job state.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">OLX Autos: Orion Internal Developer Platform on Amazon EKS with 100% Spot Instances</data>
    <data key="d1">https://www.youtube.com/watch?v=1aYoIZvabbk</data>
    <data key="d2">OLX Autos (operating in 11 countries) built an internal developer platform (Orion portal) to reduce time to market and increase deployment velocity. Users request replica environments; an application pod on Amazon EKS (100% Spot instances) creates one Kubernetes job per microservice. Job state is published through SNS to SQS so that a replacement job can resume unfinished work after a Spot termination.</data>
    <data key="d3">Containers, DevOps, Cost Optimization, Application Integration</data>
    <data key="d4">True</data>
  </graph>
</graphml>
