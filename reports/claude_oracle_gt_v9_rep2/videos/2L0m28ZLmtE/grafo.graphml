<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Distribution in front of the static website; used to reduce costs and holds the certificate. Entry point for users.</data>
    </node>
    <node id="1">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Identifies portal users through identity federation with the Sanofi SSO.</data>
    </node>
    <node id="2">
      <data key="d5">S3 — Static Web App</data>
      <data key="d6">S3</data>
      <data key="d7">Static website (S3 static website feature) hosting the Data Analytics portal.</data>
    </node>
    <node id="3">
      <data key="d5">S3 — Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Data lake holding highly sensitive data. Users extract data into their own home-user S3 bucket; data is segregated, encrypted, audited, accessible only per predefined rights, and cannot be downloaded to a workstation.</data>
    </node>
    <node id="4">
      <data key="d5">ApiGateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Dynamic part of the portal, used to implement data traceability.</data>
    </node>
    <node id="5">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">User activity log: stores user metadata and all actions performed on the Data Analytics portal; strong traceability of users and of each dataset used.</data>
    </node>
    <node id="6">
      <data key="d5">ServiceCatalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Portfolio of products (SageMaker and RStudio) built via CloudFormation, offered to users from the portal; repeatable deployments with a focus on security and user isolation.</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda functions that call Translate and Comprehend / Comprehend Medical directly through the SDK.</data>
    </node>
    <node id="8">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">RStudio (proprietary app) provisioned per user as a Service Catalog product.</data>
    </node>
    <node id="9">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Per-user SageMaker notebooks, encrypted, with a 100 GB disk for data, and traced; each user only accesses the dataset they are entitled to.</data>
    </node>
    <node id="10">
      <data key="d5">Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Bulk translation of raw files from an automatically detected language to a target language chosen by the user.</data>
    </node>
    <node id="11">
      <data key="d5">Comprehend</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Specifically Comprehend Medical: identifies data/metadata inside raw files. Comprehend is also used to auto-detect the source language for translation.</data>
    </node>
    <node id="12">
      <data key="d5">Sanofi SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sanofi corporate SSO acting as the identity provider federated with Cognito.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront serves the static web portal hosted in S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="12" id="0">
      <data key="d8">0</data>
      <data key="d9">Identity federation with the Sanofi SSO.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">The portal authenticates users with Cognito.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">The portal calls API Gateway for the dynamic part (traceability).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">The user requests provisioning of the RStudio product from the portal.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="6" id="1">
      <data key="d8">2</data>
      <data key="d9">The user requests provisioning of the SageMaker product from the portal.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">4</data>
      <data key="d9">Data extracted from the data lake into the user's home bucket is processed in RStudio. Inferred from the audio, not a drawn arrow.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="9" id="0">
      <data key="d8">4</data>
      <data key="d9">Data extracted from the data lake into the user's home bucket is processed in SageMaker. Inferred from the audio, not a drawn arrow.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Raw files from the data lake / home bucket are processed by the Lambda functions for Translate and Comprehend. Inferred from the audio, not a drawn arrow.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Stores and reads user metadata and all portal actions in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions the RStudio environment (via CloudFormation).</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Service Catalog provisions an encrypted per-user SageMaker notebook with a 100 GB disk (via CloudFormation).</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls Comprehend through the SDK to auto-detect the language, and Comprehend Medical to identify metadata in raw files.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls Translate through the SDK for bulk translation of raw files into the target language chosen by the user.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Sanofi Darwin - Secure Data Analytics Portal for Data Scientists (Real World Evidence)</data>
    <data key="d1">https://www.youtube.com/watch?v=2L0m28ZLmtE</data>
    <data key="d2">Sanofi and partner Teamwork built a secure self-service data science portal on AWS for the Darwin Real World Evidence ecosystem. A static S3 website behind CloudFront authenticates users via Cognito federated with Sanofi SSO. API Gateway and DynamoDB provide traceability. Service Catalog provisions per-user RStudio and SageMaker environments. Lambda functions call Translate and Comprehend / Comprehend Medical. Sensitive data stays in the S3 data lake and per-user home buckets and cannot be downloaded to workstations. In production since early August; grew from 5-10 beta testers to 30-40 users within 2-3 weeks. Lake Formation is being considered for the future.</data>
    <data key="d3">Analytics, Machine Learning, Data Lake, Healthcare, Security</data>
    <data key="d4">True</data>
  </graph>
</graphml>
