<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Hospitals / Biologists / Clients</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Hospitals, biologists and clients send medical images. Hospitals later use the validated model.</data>
    </node>
    <node id="1">
      <data key="d5">Pathologist</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Enriches the data by annotating and labelling images; validates or refuses the trained model.</data>
    </node>
    <node id="2">
      <data key="d5">Kubernetes Product (Labelling Platform)</data>
      <data key="d6">EKS</data>
      <data key="d7">Kinaï product running on Kubernetes: labelling platform for pathologists, shows model results, and hosts inference once the model is validated and frozen.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Buckets</data>
      <data key="d6">S3</data>
      <data key="d7">Buckets holding the incoming medical images (about 5 TB of data per project) and the trained model. Data is kept in the project's region (e.g. Germany).</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker Training</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains one model per project. Existing pipelines were containerised in Docker and the same Docker image is reused in SageMaker, making migration easy. Thousands of trainings in parallel; training more than 30 times faster.</data>
    </node>
    <node id="5">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">Used with SageMaker training for IO performance.</data>
    </node>
    <node id="6">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Security and fine-grained control of data access; helps document and comply with certifications (HDS).</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Hospitals and clients send medical images to S3 buckets (about 5 TB per project).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Pathologist enriches the data by annotating and labelling the images.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="1">
      <data key="d8">2</data>
      <data key="d9">Pathologist validates or refuses the model; a validated model is frozen and moved to inference on Kubernetes.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Images (and later model results) are shown to the pathologist.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9" />
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Enriched (annotated) data is used to train one model per project in SageMaker.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Images are loaded into the Kubernetes product to be shown to pathologists.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="1">
      <data key="d8">2</data>
      <data key="d9">Model and results are exported to the Kubernetes product to be shown to the pathologist.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker relies on IAM for security.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The trained model is stored in an S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">FSx provides high IO performance storage for training.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">IAM provides access control over the data used in training.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Kinaï - Medical Image Labelling and Per-Project Model Training on EKS and SageMaker</data>
    <data key="d1">https://www.youtube.com/watch?v=2XVgpMwY5iE</data>
    <data key="d2">Kinaï builds technology for research and clinical studies, guiding pathologists and doctors in analysing medical images. Dynamic infrastructure after migrating to SageMaker: scientists work on several projects at once and switch project in seconds, thousands of trainings can run in parallel, training is more than 30 times faster, and infrastructure cost is reduced by up to 30% (no payment for unused resources). Compliance: HDS certification for health data security; data stays in the region of the project (e.g. a German project keeps its data in Germany).</data>
    <data key="d3">Healthcare, Machine Learning, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
