<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart Fire Hydrant</data>
      <data key="d6">UserConsumerEdge</data>
      <data key="d7">IoT fire hydrants that record acoustic signals measuring noises on the pipe network. Signals are recorded daily and correlated between multiple fire hydrants.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for the daily acoustic files. Provides authentication and security; chosen instead of writing directly to S3 because of the heavy focus on IoT security.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Persists the acoustic files pushed through API Gateway.</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Container microservices running a daily batch process in which each file is processed as a node pair to look for correlations in the acoustic signals, including persistent correlations that occur over many days. Chosen over Lambda because the acoustic algorithms are very processor intensive.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker ML Endpoint</data>
      <data key="d6">SageMaker</data>
      <data key="d7">ML endpoint that further classifies persistent correlations and assigns a leak probability (leak score). The model is retrained about every six weeks using feedback from the field.</data>
    </node>
    <node id="5">
      <data key="d5">Analyst</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Human analyst team that receives the leak score, reviews the persistent correlation, checks with the water utility for other nearby noise sources, and updates the leak status to field investigation required.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Correlated acoustic signal files are pushed through API Gateway on a daily basis.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">After authentication and security checks, the files are pushed and persisted in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">A daily batch process in ECS processes each file as a node pair to look for correlations in the acoustic signals.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Persistent correlations are sent to the SageMaker ML endpoint to be classified and assigned a leak probability.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">The leak score (probability) is fed to the human analyst team, who further classify the leak.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Feedback from the field is used about every six weeks to further classify and retrain the model, so it improves over time.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Mueller Water Products: Water Intelligence Platform for Acoustic Leak Detection</data>
    <data key="d1">https://www.youtube.com/watch?v=2e3vOxsHekE</data>
    <data key="d2">Water intelligence platform that ingests data from a large-scale IoT network of meters, smart fire hydrants, pressure monitoring and water quality devices. Acoustic data from fire hydrants is ingested daily, batch processed for correlations, and scored by an ML model for leak probability so human analysts can focus on the most important noise sources. Benefits: reduction of non-revenue water loss and ecological protection. Future: heavier focus on ML and analytics, plus additional data sources such as flow and pressure.</data>
    <data key="d3">IoT, Machine Learning, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
