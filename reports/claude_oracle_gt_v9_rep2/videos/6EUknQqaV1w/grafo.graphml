<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Cloud Provider Security Event Streams</data>
      <data key="d6">UserCompanyDataStream</data>
      <data key="d7">Cloud providers' native security event streams (e.g., CloudWatch, Azure Activity Log). Three major cloud providers supported; billions of events per day. A collection framework evaluates events and determines the current state of each resource.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Streams (Collect)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Collection stream: the collection framework publishes cloud resources here. A consumer publishes the resources into Neptune.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Data Streams (Rules)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Fronts the rule execution pipeline. Receives incoming events along with resource changes; the rule engine determines which rules (potentially thousands) to execute, exercised over the Neptune graph.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Primary persistence. Graph database for highly interconnected cloud resource data; 50M+ resources collected and monitored. Chosen for graph-based exploration, read scale-out for rule execution, and being schema-less (agnostic to varied resource configurations). Provisioned clusters, with writes scaled via sharding.</data>
    </node>
    <node id="4">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Backing store for search, aggregations, reporting and analytics use cases.</data>
    </node>
    <node id="5">
      <data key="d5">Shard Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sharder service that scales writes out by logically grouping data across provisioned Neptune clusters. Uses CloudWatch metrics (CPU, memory and other parameters) from Neptune and Elasticsearch to determine shard capacity and load balance customers' data; the information flows back to drive decisions at the front of the pipeline.</data>
    </node>
    <node id="6">
      <data key="d5">Slack, email, Splunk</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Real-time notification channels for customers when security violations are detected.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Backing store for use cases such as how resource configurations changed over time; also persists detected security violations.</data>
    </node>
    <node id="8">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Metrics from Neptune and Elasticsearch (CPU, memory, etc.) used by the sharder service to determine shard capacity.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Security events are evaluated by the collection framework and the resulting resources are published into the Kinesis data stream.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">A consumer publishes the ingested cloud resources into Neptune (50M+ resources).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Incoming events are propagated to the rule execution pipeline, fronted by a Kinesis data stream.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Detected security violations are persisted in DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Real-time notifications of security violations are sent to customers via Slack, email, Splunk and similar channels.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Resource data is also stored in Elasticsearch as a backing store for search, aggregations and reporting.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Resource data is also stored in DynamoDB as a backing store, e.g., for configuration changes over time.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Neptune metrics (CPU, memory and other parameters) are reported to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Resource changes, once persisted, are propagated to the rule execution pipeline.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Elasticsearch metrics are reported to CloudWatch.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The sharder service uses CloudWatch metrics to determine shard capacity of the provisioned Neptune clusters and load balance customer data.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">CloudHealth Secure State by VMware: Real-Time Cloud Security Monitoring with Neptune</data>
    <data key="d1">https://www.youtube.com/watch?v=6EUknQqaV1w</data>
    <data key="d2">Cloud security and monitoring platform that collects billions of events per day from three major cloud providers, tracks 50M+ resources in a Neptune graph, uses Elasticsearch and DynamoDB as backing stores, scales writes with a sharder service driven by CloudWatch metrics, and runs thousands of rules through a Kinesis-fronted rule engine with real-time notifications.</data>
    <data key="d3">Security, Analytics, Graph Database, Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
