<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">UserConsumerWeb</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Front end / consuming applications and users that connect to the platform; data is brought back to the business (e.g., loyalty application push notifications).</data>
    </node>
    <node id="1">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Meta Manager: the brains of the Grid, running as a microservice architecture on EKS. Abstracts the complexity of the technology needed to move data, discovers tables, schemas and APIs, and applies data protection rules.</data>
    </node>
    <node id="2">
      <data key="d5">Multiple Data Sources</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data sources spread across different networks, countries and technologies (tables, schemas, APIs).</data>
    </node>
    <node id="3">
      <data key="d5">Elastic Search &amp; Neo4J</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">MetaStore: combination of document and graph database storing the discovered meta information.</data>
    </node>
    <node id="4">
      <data key="d5">Vertica</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Data store for consumption by data analysts and data scientists (traditional analytics, models); data can be published or consumed via APIs.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Centralized data lake; around 60 terabytes of data. All data is stored in S3.</data>
    </node>
    <node id="6">
      <data key="d5">MSK</data>
      <data key="d6">MSK</data>
      <data key="d7">Kafka enterprise streaming platform shared across all companies: 600 topics, 250 gigabytes, seven-day average retention period.</data>
    </node>
    <node id="7">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Data store for consumption by data analysts and data scientists; data can be published or consumed via APIs or OLTP.</data>
    </node>
    <node id="8">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Used in combination with Kafka to bring data into the data lake and to process data going in and out of it.</data>
    </node>
    <edge source="0" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Data from applications (also consumed through APIs) comes into the platform.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Discovered meta information is stored in the MetaStore (document and graph database).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Meta Manager discovers which tables, schemas and APIs exist in the data sources.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Data from the various sources is streamed into Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Data from the various sources is brought in using EMR.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">Data goes out of the data lake to Kafka.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR reads data out of the data lake for processing.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="1">
      <data key="d8">2</data>
      <data key="d9">Data is read from the data lake to be sent to the consumption data stores.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka streams the data into the S3 data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR writes collected data into the S3 data lake.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="5" id="1">
      <data key="d8">2</data>
      <data key="d9">Processed data is written back to the data lake.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Data is sent to RDS for consumption by data analysts and data scientists.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Data is sent to Vertica for consumption by data analysts and data scientists.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="0" id="0">
      <data key="d8">3</data>
      <data key="d9">Data is brought back to the business applications to connect with users (e.g., push notifications and offers).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Majid Al Futtaim - The Grid: Enterprise Data Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=9qTEHITVeLE</data>
    <data key="d2">Data platform called 'The Grid' built around three pillars: collect, protect and connect data. Infrastructure is fully defined as code by the DevOps team and can be spun up and down on demand (e.g., for integration tests); first MVP in production in six months. Provides a 360 view of customers across businesses (e.g., Vox Cinemas and Carrefour) enabling cross-marketing campaigns and push notifications.</data>
    <data key="d3">Analytics, Data Lake, Streaming</data>
    <data key="d4">True</data>
  </graph>
</graphml>
