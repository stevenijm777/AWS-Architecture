<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">User accesses PixelStrings through a regular web browser (Chrome recommended) over a regular internet connection; logs in, creates an account, enters S3 keys, uploads clips to their own S3 bucket, defines workflows (Wormhole retiming, SpaceTime deinterlacing, Dark Energy noise removal/retexturing, output codec, optional IMF), sees a cost estimate and submits jobs.</data>
    </node>
    <node id="1">
      <data key="d5">Web Server / Job Manager</data>
      <data key="d6">EC2</data>
      <data key="d7">PixelStrings server hosting the web server and the job manager. Only a single instance so far (real-time failover to another server is planned). Web server handles about 100 users; job manager runs up to 200 jobs in parallel per region (limited by the G3 allocation). The web server does not talk directly to the job manager; it reads metadata from the database. High availability focuses on the G3 instances: on a timeout the job manager shuts down the failed GPU instance and starts a new one so the job can continue.</data>
    </node>
    <node id="2">
      <data key="d5">G3 GPU Instances (Asset Manager)</data>
      <data key="d6">EC2</data>
      <data key="d7">G3 GPU-accelerated instances for video processing and encoding (Wormhole, SpaceTime, Dark Energy). One job per GPU instance, running in parallel. The asset manager copies the input clip from S3 to the local disk; outputs are first written to local disk, then the job manager is told, and the job manager tells the asset manager to upload the output back to the customer's S3 bucket. Clusters are available in US West, US East and Ireland to avoid large egress/copy costs from the users' S3 buckets.</data>
    </node>
    <node id="3">
      <data key="d5">IMF</data>
      <data key="d6">EC2</data>
      <data key="d7">Converts/wraps processed videos into Interoperable Master Format (IMF), which is required for publishing to Netflix. Selected in the workflow, with IMF metadata entered by the user in the browser.</data>
    </node>
    <node id="4">
      <data key="d5">Database (unspecified AWS database service)</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Database that caches the video clip metadata. The job manager saves metadata to it and the web server reads from it.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Customer-managed S3 bucket (under the customer's account) holding user-uploaded input clips and the processed output videos. The user enters S3 keys in the browser so the job manager can access the bucket.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda (MediaInfo)</data>
      <data key="d6">Lambda</data>
      <data key="d7">MediaInfo running inside a Lambda function; captures metadata of each video clip in the S3 bucket (used, for example, to estimate processing cost from clip length). Calls run in the background, so metadata fills in on the browser every second or two.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User logs in, creates an account and enters their S3 keys on the PixelStrings web server.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">User uploads input video clips to the S3 bucket they manage.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Job manager invokes the Lambda function (MediaInfo) to get metadata for each clip.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Cache processed metadata in database (job manager saves the metadata).</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="1">
      <data key="d8">0</data>
      <data key="d9">Web server queries the database for metadata (it does not talk directly to the job manager).</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Web server shows the clips and their metadata (filled in every second or two) and the cost estimate in the browser.</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Job manager sends one job to each G3 GPU instance (up to 200 parallel jobs per region) and tells the asset manager to copy the input clip to the local disk.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="1">
      <data key="d8">1</data>
      <data key="d9">Tell asset manager to put data into S3 (copy the output clip back to the customer's bucket).</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Tell job manager video processing is done (GPU processing and encoding finished, output written to local disk).</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset manager copies the output clip from local disk back to the customer's S3 bucket.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">For an IMF job, the output is not copied to S3 directly; instead the processed and encoded data is sent to IMF for wrapping.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">After IMF wrapping, the result is copied back to the customer's S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Cached metadata is returned to the web server.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Clip data is read from S3 so MediaInfo can extract the metadata.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset manager copies the input clip from the customer's S3 bucket to the local disk of the G3 instance.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">Output files are made available to the user from their S3 bucket.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9" />
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda accesses the clips in the S3 bucket.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda returns the clip metadata to the job manager.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cinefilm PixelStrings: GPU-Accelerated Video Processing Platform on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=BZ32w0SSAoY</data>
    <data key="d2">PixelStrings is a web-accessed service for GPU-accelerated video retiming (Wormhole), deinterlacing (SpaceTime), and noise removal/retexturing (Dark Energy). Users bring their own S3 bucket and enter S3 keys in the browser. A single EC2 instance hosts the web server and job manager; G3 GPU instances process jobs in parallel (up to 200 jobs per region); optional IMF wrapping for Netflix delivery. GPU clusters are in US West, US East and Ireland.</data>
    <data key="d3">Media &amp; Entertainment, Video Processing, GPU Computing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
