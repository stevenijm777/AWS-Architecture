<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">iOS Client (Sender)</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Snapchat iOS app that sends the snap; talks to the backend through Snap's gateway (an EKS service).</data>
    </node>
    <node id="1">
      <data key="d5">Android Client (Recipient)</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Recipient Snapchat client; holds a persistent connection to a gateway server through which messages are pushed.</data>
    </node>
    <node id="2">
      <data key="d5">Media Delivery Service</data>
      <data key="d6">EKS</data>
      <data key="d7">Media delivery service running on EKS; sends the snap media to CloudFront and persists it in S3 so that it is close to the recipient.</data>
    </node>
    <node id="3">
      <data key="d5">MCS Messaging Service</data>
      <data key="d6">EKS</data>
      <data key="d7">Messaging service on EKS; orchestrates permission checks, metadata persistence and delivery to the recipient. Receiving is very latency sensitive.</data>
    </node>
    <node id="4">
      <data key="d5">Friend Graph</data>
      <data key="d6">EKS</data>
      <data key="d7">EKS service that checks whether the sender has permission to send snaps to the recipient.</data>
    </node>
    <node id="5">
      <data key="d5">SnapDB</data>
      <data key="d6">EKS</data>
      <data key="d7">Snap's own database front end to DynamoDB running on EKS; implements higher-level features such as transactions, TTL, efficient handling of ephemeral data and incremental state synchronization to reduce the load on DynamoDB and keep costs under control.</data>
    </node>
    <node id="6">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Receives the snap media so it is close to the recipient; media is retrieved through it using the media ID.</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Persists the snap media (images, video).</data>
    </node>
    <node id="8">
      <data key="d5">ElastiCache</data>
      <data key="d6">ElastiCache</data>
      <data key="d7">Session metadata: connection ID / server ID identifying the server holding the persistent connection to the recipient client. The media ID is also persisted here.</data>
    </node>
    <node id="9">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores snap metadata (including the media ID); 400 TB of data. Nightly scans run at 2 billion rows per minute, e.g. for friend suggestions and deleting ephemeral data.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">The iOS app uses the gateway (an EKS service) to talk to the media delivery service and upload the snap media.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">The iOS app sends the snap message through the gateway to the MCS messaging service.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">The media service sends the snap to CloudFront so it is closer to the recipient.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">MCS asks Friend Graph whether the sender has permission to send snaps.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">MCS persists the snap metadata (including the media ID) in SnapDB.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">MCS looks up the connection ID / server ID of the recipient's persistent connection in ElastiCache.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">The message is pushed to the recipient through the gateway over the persistent connection.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Friend Graph returns the permission check result.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">SnapDB stores the metadata in DynamoDB under the covers.</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">SnapDB returns the result to MCS.</data>
      <data key="d10">9</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">The snap media is persisted in S3.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">The media (image or video) is retrieved from S3 through CloudFront using the media ID.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">ElastiCache returns the session metadata identifying the server the client is already connected to.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">DynamoDB returns the result / stored metadata to SnapDB.</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Snap: Snapchat Send and Receive Snap Platform on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=Cgv0kfp_6xQ</data>
    <data key="d2">Snapchat platform on AWS: 300M+ daily active users, 5B+ snaps/day, 10M+ QPS. 900+ EKS clusters, many with 1000+ instances. Moving to this architecture reduced P50 send-snap latency by 24%. Compute cost is kept low with auto-scaling and Graviton instance types. Clients reach the EKS services through a gateway (GW) that is itself an EKS service built by Snap.</data>
    <data key="d3">Containers, Messaging, Media Delivery, Databases</data>
    <data key="d4">True</data>
  </graph>
</graphml>
