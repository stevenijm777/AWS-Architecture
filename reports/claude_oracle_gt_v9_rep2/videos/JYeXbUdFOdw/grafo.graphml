<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Buckets holding raw data uploaded as CSV or Excel files, a separate folder for the validated copy, and large reports (more than 10,000 records) downloaded through a pre-signed URL. Also represents the Angular front-end application reached from the web browser.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda #1</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered when raw data is uploaded; validates the data. Discrepancies are highlighted; otherwise a validated copy is uploaded to a different folder in S3.</data>
    </node>
    <node id="2">
      <data key="d5">Lambda #2</data>
      <data key="d6">Lambda</data>
      <data key="d7">Triggered when the validated copy is available; processes the validated data and ingests it into the OpenSearch cluster.</data>
    </node>
    <node id="3">
      <data key="d5">UserConsumerWeb</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">User retrieving data through the web application (web browser) or the mobile application. Mobile requests go directly to the backend application.</data>
    </node>
    <node id="4">
      <data key="d5">OpenSearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Amazon OpenSearch cluster on Graviton2 instances (25 to 30 percent operating cost saving, roughly 100K dollars). Query templates mapped to relevant indexes, OpenSearch analyzer used to fine-tune queries and enhance performance, and an aggregated layer built on the processed data for complex reports such as trend analysis. About 5 billion records, responses within 2 to 4 seconds.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Amazon RDS, part of the data layer queried by the backend application.</data>
    </node>
    <node id="6">
      <data key="d5">SES</data>
      <data key="d6">SES</data>
      <data key="d7">Sends a notification to the user to download a large report using the pre-signed URL.</data>
    </node>
    <node id="7">
      <data key="d5">Novetiq backend</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Backend application developed in Python. Receives requests from the web browser and the mobile apps, queries the data layer and returns the response to the user. Uploads reports with more than 10,000 records to S3.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw CSV/Excel upload to the S3 bucket triggers the validation Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Availability of the validated copy triggers the processing Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The request goes back to the browser from the front-end application.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">The user is notified via SES to download the report using the pre-signed URL.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Validated copy of the data is uploaded to a different folder in the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="1">
      <data key="d8">0</data>
      <data key="d9">Discrepancies found in the data are highlighted.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Processing Lambda accesses the validated data in S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Processed data is ingested into the OpenSearch cluster.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">1</data>
      <data key="d9">User sends the request to the Angular front-end application through the web browser.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Request goes from the browser to the Python backend application; mobile apps call the backend directly.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Data layer returns the result to the backend.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Backend sends the request to the data layer.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Response is sent back to the user through the backend application.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">Reports with more than 10,000 records are uploaded to the S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cybex trade data processing and retrieval with Amazon OpenSearch (Novetiq)</data>
    <data key="d1">https://www.youtube.com/watch?v=JYeXbUdFOdw</data>
    <data key="d2">Event-driven data ingestion and retrieval architecture for Cybex export/import trade data. Grew from 1.5 billion to about 5 billion records (more than 3.5x) on the same architecture; reports with 15 to 20 complex parameters are served within 2 to 4 seconds. Graviton2 instances for OpenSearch save 25 to 30 percent of operating cost (roughly 100K dollars). Reports over 10,000 records are delivered asynchronously through S3 and SES with a pre-signed URL.</data>
    <data key="d3">Analytics, Data Processing, Serverless, Search</data>
    <data key="d4">True</data>
  </graph>
</graphml>
