<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">UserConsumerWeb</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Internal teams within NHS Digital accessing the data access environment.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 - Auth service (Guacamole gateway)</data>
      <data key="d6">EC2</data>
      <data key="d7">Public gateway where users log into Guacamole; from there they enter a sandbox where they can view and analyse data but cannot take data out of the system.</data>
    </node>
    <node id="2">
      <data key="d5">EC2 - Data processing and conversion to Parquet</data>
      <data key="d6">EC2</data>
      <data key="d7">Processes existing datasets and converts them to Parquet format before storing them in S3.</data>
    </node>
    <node id="3">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Drawn inside the secure side of the environment; no flow explicitly described in the audio.</data>
    </node>
    <node id="4">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs analytics jobs and provides a consistent compute layer; reads data from S3. Apache Ranger ensures users only see the data they are allowed to see. Chosen over Cloudera and on-prem options for flexibility and scale. Jobs that took hours now take minutes or seconds. Tooling such as RStudio, JupyterHub and Hue.</data>
    </node>
    <node id="5">
      <data key="d5">DirectoryService</data>
      <data key="d6">DirectoryService</data>
      <data key="d7">Active Directory used to authenticate users; the user's role is also used by the data processing tools to grant access to the right data.</data>
    </node>
    <node id="6">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the converted Parquet files, always encrypted (at rest and in transit).</data>
    </node>
    <node id="7">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Provides the keys used to encrypt the data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Internal users log into the public gateway (Guacamole).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Gateway authenticates the user against directory services.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">User is given a sandbox session where data can be analysed but not extracted.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Existing datasets are converted to Parquet format and put into S3.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR requests the data for analytics jobs.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Directory returns the authentication result and user role.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9" />
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">S3 requests an encryption key from KMS for the data.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR reads the Parquet data from S3 to run analytics jobs.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">KMS provides the key used to encrypt the data at rest.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">NHS Digital Data Access Environment on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=SSWwnNVYi_Q</data>
    <data key="d2">Secure data access environment for NHS Digital internal teams. Users log in via a public gateway (Guacamole on EC2) into a sandbox where they can analyse data but cannot extract it. Authentication is via Directory Service; user roles drive data access with Apache Ranger. Existing datasets are converted to Parquet and stored in S3, encrypted with KMS keys (at rest and in transit). EMR runs analytics jobs on S3 data; jobs that took hours now take minutes or seconds. Tooling includes RStudio, JupyterHub and Hue.</data>
    <data key="d3">Analytics, Security, Healthcare, Big Data</data>
    <data key="d4">True</data>
  </graph>
</graphml>
