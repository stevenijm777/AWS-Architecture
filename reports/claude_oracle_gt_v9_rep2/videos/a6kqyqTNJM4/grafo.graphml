<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Almosafer customers; about 300k requests per minute on average.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN that receives all user traffic; first layer of scaling and resiliency.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Cost-efficient storage serving static content and images for a content-heavy platform.</data>
    </node>
    <node id="3">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Edge logic that determines which region and device the traffic comes from, to decide request routing.</data>
    </node>
    <node id="4">
      <data key="d5">Load Balancer</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">About 60 load balancers; decide between backend service traffic and web (frontend) traffic, and route between legacy systems and new microservices.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 Legacy Application</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts the remaining legacy monolithic systems that are being gradually migrated to microservices.</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Core for all backend and micro-frontend services; about 80% of services migrated; 250+ microservices on 1400+ pods in production.</data>
    </node>
    <node id="7">
      <data key="d5">Mongo DB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Self-managed MongoDB instances on EC2 for services needing NoSQL; Kafka, drawn on the same box, supports the event-driven microservices.</data>
    </node>
    <node id="8">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Managed SQL database for services that need proper transactions.</data>
    </node>
    <node id="9">
      <data key="d5">EC2 Monitoring Tools</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts self-managed monitoring tools such as Prometheus and the ELK stack for log monitoring; tied to alerting through Slack and PagerDuty.</data>
    </node>
    <node id="10">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">AWS-native monitoring used to check pod health; tied to alerting through Slack and PagerDuty.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User traffic (about 300k requests per minute) goes through CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront requests static content and images from S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront invokes Lambda to evaluate the request's region and device.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront forwards dynamic traffic to the load balancers.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 returns static content and images to CloudFront.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda returns the routing decision to CloudFront.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Load balancer routes traffic to legacy systems on EC2.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Load balancer routes backend or frontend traffic to microservices on EKS.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Load balancer returns the response to CloudFront.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Legacy application responds to the load balancer.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Microservices read and write the self-managed MongoDB; event-driven services use Kafka.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Services that need transactions query RDS.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS services respond to the load balancer.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch monitors pod health. Not a drawn arrow; inferred from the monitoring description.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Prometheus and ELK on EC2 monitor every service's metrics and logs. Not a drawn arrow; inferred from the monitoring description.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">MongoDB results (and Kafka events) return to the microservices.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">RDS returns query results to the microservices.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Seera Group: Scalable Microservices Travel Platform (Almosafer) on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=a6kqyqTNJM4</data>
    <data key="d2">Seera Group's Almosafer travel platform receives about 300k requests per minute through CloudFront, with S3 for static content and Lambda for region/device routing decisions. Around 60 load balancers route traffic between frontend and backend and between legacy EC2 monoliths and EKS microservices (about 80% migrated; 250+ microservices on 1400+ pods). The data layer uses self-managed MongoDB on EC2, RDS for transactional SQL, and Kafka for event-driven services. Monitoring uses CloudWatch, Prometheus and ELK, with alerting through Slack and PagerDuty.</data>
    <data key="d3">Microservices, Containers, Travel, Migration, Content Delivery</data>
    <data key="d4">True</data>
  </graph>
</graphml>
