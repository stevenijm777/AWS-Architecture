<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">UserConsumerMobile</data>
      <data key="d6">UserConsumerMobile</data>
      <data key="d7">Tenants using the onboarding wizard web application and customers using the mobile app or website; also the mobile check-in application that looks up bookings and scans tickets.</data>
    </node>
    <node id="1">
      <data key="d5">UserConsumerAPI</data>
      <data key="d6">UserConsumerAPI</data>
      <data key="d7">Third-party resellers / OTAs (e.g., Expedia, Viator, GetYourGuide) selling the offerings through a third-party REST API implemented for them.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket serving as an HTTP server for static content: event descriptions, ticket offering and pictures.</data>
    </node>
    <node id="3">
      <data key="d5">AppSync</data>
      <data key="d6">AppSync</data>
      <data key="d7">GraphQL gateway. Resolvers invoke Lambda; direct DynamoDB resolvers are also used and can be mapped and reused through AppSync pipeline resolvers.</data>
    </node>
    <node id="4">
      <data key="d5">ApiGateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Regular REST endpoint for resellers/OTAs; hits the same Lambdas used by the owned mobile app and website channels.</data>
    </node>
    <node id="5">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds fan-out messages for tenant setup subroutines and post check-in work (customer service, post-experience, review reminder email) that Lambda processes later.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Shared business logic for tenants and customers, invoked through AppSync and API Gateway. Fans out to subroutines by sending SQS messages and later reprocesses them; interacts with DynamoDB.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores all tenant data. Multi-tenancy: tables are shared and everything is partitioned by tenant using partition keys.</data>
    </node>
    <node id="8">
      <data key="d5">CDN</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">CDN, the first thing every client request hits. Returns static content from S3 and routes dynamic requests to AppSync or API Gateway.</data>
    </node>
    <edge source="0" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Tenant wizard web application (or check-in app) request first hits the CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="8" id="1">
      <data key="d8">2</data>
      <data key="d9">Customer starts the journey on the website or mobile app; the request first hits the CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Reseller / OTA request first hits the CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">S3 serves the event descriptions and pictures to the CDN.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">AppSync resolvers invoke Lambda to process the GraphQL node and fan out to subroutines.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="8" id="0">
      <data key="d8">2</data>
      <data key="d9">AppSync returns the GraphQL response for dynamic content through the CDN.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway hits the same Lambdas used by the other channels.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Messages are later processed by Lambda (e.g., sending the review reminder email after check-in).</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda sends a set of SQS messages (tenant setup fan-out, post check-in tasks).</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda interacts with DynamoDB to finish setting up the tenancy; data is partitioned by tenant.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">2</data>
      <data key="d9">Dynamic content: direct DynamoDB resolvers return data to AppSync, reusable through pipeline resolvers.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">CDN forwards the dynamic request to AppSync, the GraphQL gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CDN routes the reseller request to the REST endpoint on API Gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Response returned to the reseller through the CDN.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">CDN requests the static content hosted on the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="0" id="0">
      <data key="d8">2</data>
      <data key="d9">CDN returns the content to the client so the customer can browse and navigate.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Anchor: Multi-Tenant Serverless Ticketing Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=c-1GXhOOOww</data>
    <data key="d2">Anchor is a ticketing platform with more than 40 tenants (20+ onboarded in the last six months) for daytime experiences such as Statue of Liberty cruises, Niagara Falls, Alcatraz Island and NYC Ferry. Omni-channel: mobile app, website and third-party resellers (OTAs such as Expedia, Viator, GetYourGuide). Fully serverless: CDN, S3 static hosting, AppSync GraphQL, API Gateway REST, Lambda, SQS and DynamoDB with tenant partition keys.</data>
    <data key="d3">Serverless, Multi-Tenant SaaS, Ticketing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
