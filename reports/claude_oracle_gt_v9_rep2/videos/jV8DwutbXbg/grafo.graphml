<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis #1 (account updated event stream)</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Receives an event containing an account ID when an upstream account aggregation service has updated a user's account (triggered by schedule or when the user logs in/refreshes the app). Only one Lambda can be attached per shard and it processes sequentially.</data>
    </node>
    <node id="1">
      <data key="d5">Lambda - Reads user data from RDS and puts it to SQS</data>
      <data key="d6">Lambda</data>
      <data key="d7">Purposely very lean and fast. Runs a SQL query against RDS for the user's transactions, groups them into batches of about 100 and publishes the transaction description strings to SQS.</data>
    </node>
    <node id="2">
      <data key="d5">RDS - Stores transactional data</data>
      <data key="d6">RDS</data>
      <data key="d7">Holds raw transactions (date, description, amount) written by the upstream account aggregation service that collects data from third-party UK banks.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue of batched raw transaction description strings. Introduced to fan out processing because the Kinesis-attached Lambda could not keep up with tens of millions of transactions.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda - Hosts NLP model to extract required information</data>
      <data key="d6">Lambda</data>
      <data key="d7">Second Lambda tier that scales out massively. Hosts a parser generated with ANTLR from a domain-specific grammar compiled to Python, with glue logic. Processing takes a few seconds. Extracts merchant name, merchant location, currencies, exchange rates and dates. Bundled with Python dependencies and C extensions by a custom open source tool; deployed through Jenkins and CloudFormation.</data>
    </node>
    <node id="5">
      <data key="d5">RDS - Stores the extracted data</data>
      <data key="d6">RDS</data>
      <data key="d7">Table with columns for all extracted fields. Stores processed transactions together with the version of the model that was run, for later analysis, comparison and model iteration.</data>
    </node>
    <node id="6">
      <data key="d5">Kinesis #2 (processing finished event stream)</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Event stream signalling that the customer's transactions have been processed; other parts of the organization trigger from it, e.g. to refresh the app with friendly descriptions.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Account-updated event carrying the account ID triggers the lean Lambda.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SQL query requesting the transactions for the given user.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Publishes messages with batches of about 100 transaction description strings.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Returns the user's raw transactions.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9" />
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Queue messages fan out to many concurrent NLP Lambda invocations with the batched raw descriptions.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9" />
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes the extracted/enriched transaction fields along with the model version used.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Publishes an event that the customer's transactions have finished processing, for downstream consumers.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9" />
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9" />
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Tandem: Transaction Enrichment Pipeline with NLP on Lambda</data>
    <data key="d1">https://www.youtube.com/watch?v=jV8DwutbXbg</data>
    <data key="d2">Tandem bank enriches aggregated bank transaction data. An account-updated event on Kinesis triggers a lean Lambda that reads the user's transactions from RDS and batches them into SQS. A fan-out tier of Lambda functions hosting an ANTLR-based NLP parser extracts merchant, location, currency, exchange rate and dates, stores the results with the model version in RDS, and publishes a completion event to a second Kinesis stream. Tens of millions of transactions; SQS was introduced because a Kinesis shard allows only one sequential Lambda consumer. Model deployed via Jenkins and CloudFormation (not drawn).</data>
    <data key="d3">Serverless, Data Pipeline, Machine Learning, NLP, Financial Services</data>
    <data key="d4">True</data>
  </graph>
</graphml>
