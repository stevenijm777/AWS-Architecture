<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Amazon Macie</data>
      <data key="d6">Macie</data>
      <data key="d7">Data discovery tool connected to multiple AWS accounts (production accounts first). It automatically inventories all S3 buckets and runs manual or scheduled scans. About 95% accuracy for critical sensitive types (SSN, ITIN). Fused from the Macie icons in the main account and the two connected accounts.</data>
    </node>
    <node id="1">
      <data key="d5">Scanned production S3 buckets (connected accounts)</data>
      <data key="d6">S3</data>
      <data key="d7">S3 buckets in the connected production AWS accounts. Macie inventories them, and the team selects which ones to scan for sensitive member data (SSNs, ITINs, government IDs). Fused from the two member-account S3 icons.</data>
    </node>
    <node id="2">
      <data key="d5">Macie findings bucket (main account)</data>
      <data key="d6">S3</data>
      <data key="d7">Bucket owned by the team in its own account that receives Macie findings. It holds only metadata, such as the number of SSNs per bucket, with no PII or sensitive data.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Athena</data>
      <data key="d6">Athena</data>
      <data key="d7">SQL-based query tool that queries the findings in the S3 bucket to identify risky buckets and their owners.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Dashboards (alongside tools such as Tableau or Power BI) that show the top 10, 20 or 30 risky buckets by PII type and their owners, to drive remediation.</data>
    </node>
    <node id="5">
      <data key="d5">AWS Glue</data>
      <data key="d6">Glue</data>
      <data key="d7">Automations that get, load and aggregate the findings data for reporting.</data>
    </node>
    <node id="6">
      <data key="d5">MySQL data lake</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">MySQL-based data lake built by Opportune, where the findings data is also dropped.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie inventories the S3 buckets and runs manual or scheduled sensitive data discovery scans on the selected buckets.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Macie sends the findings (metadata only, such as the count of SSNs per bucket, with no PII) to the team-owned S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Glue automations get, load and aggregate the findings data.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">The findings data is also dropped into the MySQL data lake.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Athena runs SQL queries on the findings stored in the S3 bucket.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">The findings data is read through Athena and loaded into the QuickSight dashboards.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">QuickSight visualizes the findings data from the S3 bucket and shows the top risky buckets by PII type and their owners.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Opportune - Sensitive Data Discovery and DSPM with Amazon Macie</data>
    <data key="d1">https://www.youtube.com/watch?v=-kA0ahrhX3I</data>
    <data key="d2">Opportune provides financial services to underserved members. Its goal is to find where sensitive member data (SSNs, ITINs, government IDs) lives in S3 and improve its data security posture management (DSPM). Macie is connected to multiple AWS accounts, starting with production accounts. It inventories every S3 bucket, and the team chooses which buckets to scan. Scans can be manual or scheduled. The findings contain only metadata, such as counts of SSNs per bucket, with no PII, and are stored in a bucket the team owns. Athena queries the findings, Glue automations load and aggregate the data, and the data is also dropped into a MySQL data lake. QuickSight (or Tableau/Power BI) dashboards show the top 10, 20 or 30 risky buckets by PII type and their owners, which drives remediation: delete, archive or remove buckets. Macie automated sensitive data discovery accuracy is about 95% for patterns and regexes such as SSNs and ITINs.</data>
    <data key="d3">Security, Data Discovery, Data Security Posture Management, Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
