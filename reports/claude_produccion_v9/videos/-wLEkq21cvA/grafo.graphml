<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ON-PREM</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">On-premises source servers. The Application Discovery agent and the CloudEndure live migration agent are installed on them.</data>
    </node>
    <node id="1">
      <data key="d5">SLACK</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">ChatOps entry point: the migration team issues a single command that starts the migration.</data>
    </node>
    <node id="2">
      <data key="d5">MIGRATION TEAM</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Operations team that triggers migrations from Slack and fills DynamoDB with operational metadata.</data>
    </node>
    <node id="3">
      <data key="d5">APP DISCOVERY SERVICE</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Collects inbound/outbound TCP connections and performance utilization, which are used to choose the instance types to provision in AWS.</data>
    </node>
    <node id="4">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores operational metadata: RTOs, RPOs, infrastructure and business owners, about 10 tags per server, target account, subnet, IP address and instance type.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 (MIGRATION FACTORY)</data>
      <data key="d6">EC2</data>
      <data key="d7">Migration factory that exposes an API called from Slack and runs all integrations through API calls (Discovery, CloudEndure, AMI bake/share, launching the target).</data>
    </node>
    <node id="6">
      <data key="d5">EC2 HOT REPLICA</data>
      <data key="d6">EC2</data>
      <data key="d7">Staging instance that receives continuous block-by-block volume replication from the on-prem server. It is the source used to bake the AMI.</data>
    </node>
    <node id="7">
      <data key="d5">CLOUDENDURE</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">CloudEndure live migration does continuous block-level volume replication. The factory tells it, via API, to stop replication before cutover.</data>
    </node>
    <node id="8">
      <data key="d5">EC2 TARGET</data>
      <data key="d6">EC2</data>
      <data key="d7">Final instance in the target account, launched with the instance type, specific IP and about 10 tags from DynamoDB.</data>
    </node>
    <node id="9">
      <data key="d5">BAKE AMI / SHARED AMI</data>
      <data key="d6">AMI</data>
      <data key="d7">AMI baked from the hot replica, then shared with encryption to the target account set in DynamoDB.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Discovery agent on the on-prem servers sends inbound/outbound TCP connection metadata and performance utilization.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudEndure agent replicates volumes continuously, block by block, from on-prem to the AWS hot replica.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Slack calls the API on the migration factory EC2 instance, which starts the migration.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Migration team fills DynamoDB with RTO/RPO, owners, tags, target account, subnet and IP.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration team issues one Slack command to start the migration.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">API call to gather the server's inbound/outbound TCP connections.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">API call to CloudEndure to control replication.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">API call to bake an AMI from the hot replica, then share it with encryption to the target account.</data>
      <data key="d10">5</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Reads the target account, instance type, IP and tags stored in DynamoDB.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Starts the target instance in the target account with the sizing, firewall rules, specific IP and about 10 tags. End-to-end time is about 10 minutes.</data>
      <data key="d10">7</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudEndure stops replication on the hot replica instance.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Versent Automated Migration Factory (On-Prem to AWS)</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2">Versent built a migration factory that automates moving servers from on-premises to AWS. Migration time dropped from about 3-4 hours per server (manual) to about 10 minutes. Planned next step: use TSO Logic (acquired by AWS) instead of Discovery Service performance metrics to choose instance types, and store them in DynamoDB.</data>
    <data key="d3">Migration, Automation, ChatOps</data>
    <data key="d4">True</data>
  </graph>
</graphml>
