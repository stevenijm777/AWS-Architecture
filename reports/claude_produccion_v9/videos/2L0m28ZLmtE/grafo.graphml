<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Sanofi SSO</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Sanofi corporate identity provider, federated with Cognito to authenticate portal users.</data>
    </node>
    <node id="1">
      <data key="d5">User</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Sanofi Real World Evidence data scientists. About 30-40% of their analyses run on smart/big data sets with RStudio, SageMaker and NLP/translation tools. Usage grew from 5-10 beta testers to 30-40 users within 2-3 weeks.</data>
    </node>
    <node id="2">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Distribution in front of the S3 static website. Lowers costs and holds the TLS certificate.</data>
    </node>
    <node id="3">
      <data key="d5">Cognito</data>
      <data key="d6">Cognito</data>
      <data key="d7">Identifies users through identity federation with Sanofi SSO.</data>
    </node>
    <node id="4">
      <data key="d5">S3 (Web Portal)</data>
      <data key="d6">S3</data>
      <data key="d7">Static part of the data analytics portal, hosted with the S3 static website feature.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Dynamic part of the portal. Handles the data traceability APIs and NLP/translation requests.</data>
    </node>
    <node id="6">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores user metadata and every action performed on the portal, giving strong traceability and audit of each piece of data used in the environment.</data>
    </node>
    <node id="7">
      <data key="d5">Service Catalog</data>
      <data key="d6">ServiceCatalog</data>
      <data key="d7">Portfolio of products (SageMaker, RStudio) that users provision themselves from the portal. Products are built with CloudFormation for repeatable, secure and isolated per-user environments.</data>
    </node>
    <node id="8">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lambda functions that use the AWS SDK to call Translate (mass translation of raw files) and Comprehend Medical (identifying data and metadata in raw files).</data>
    </node>
    <node id="9">
      <data key="d5">R Studio</data>
      <data key="d6">EC2</data>
      <data key="d7">RStudio workspace that each user provisions for themselves through Service Catalog.</data>
    </node>
    <node id="10">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">One SageMaker notebook per user, encrypted, with a 100 GB disk for data, and traced. Each user can access only their own authorized data set.</data>
    </node>
    <node id="11">
      <data key="d5">Translate</data>
      <data key="d6">Translate</data>
      <data key="d7">Mass translation of raw files from a source language detected automatically with Comprehend into a target language chosen by the user.</data>
    </node>
    <node id="12">
      <data key="d5">Comprehend Medical</data>
      <data key="d6">Comprehend</data>
      <data key="d7">Pre-trained service that identifies medical data and metadata in raw files.</data>
    </node>
    <node id="13">
      <data key="d5">Data Lake</data>
      <data key="d6">S3</data>
      <data key="d7">Very sensitive data. It must stay inside the environment and cannot be downloaded to workstations. Data is segregated, encrypted, controlled and audited. Users extract data into their own home S3 bucket, with predefined per-user access rights, and process it in RStudio, SageMaker, Translate or Comprehend.</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Sanofi SSO identity federation with Cognito.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Users open the static web portal through the CloudFront distribution.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront fetches the static website assets from the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Cognito authenticates users who access the S3-hosted portal.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Dynamic portal requests (traceability, user actions) sent through API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">Users request workspace products from the Service Catalog portfolio through the portal.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Writes user metadata and the audit trail of every portal action to DynamoDB.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">API Gateway sends translation and NLP requests to the Lambda functions.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">2</data>
      <data key="d9">Provisions a dedicated RStudio environment for the user (CloudFormation-based product).</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="10" id="0">
      <data key="d8">2</data>
      <data key="d9">Provisions an encrypted, traced per-user SageMaker notebook with a 100 GB disk.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls the Translate SDK to translate raw files in bulk into the target language chosen by the user.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="12" id="0">
      <data key="d8">3</data>
      <data key="d9">Lambda calls the Comprehend Medical SDK to identify medical data and metadata in raw files.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="13" target="9" id="0">
      <data key="d8">4</data>
      <data key="d9">Added from the audio: users extract data from the Data Lake into their home bucket and process it in RStudio. The data never leaves the environment.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="13" target="10" id="0">
      <data key="d8">4</data>
      <data key="d9">Added from the audio: users extract data from the Data Lake into their home bucket and process it in SageMaker. Access follows predefined per-user rights.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Sanofi Darwin Real World Evidence Data Science Portal on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=2L0m28ZLmtE</data>
    <data key="d2">Secure data science portal for Sanofi CMO Real World Evidence data scientists, built with partner Teamwork. A static website on S3 is served through CloudFront, which also holds the certificate and lowers costs. Users sign in through Cognito federated with Sanofi SSO. The dynamic part (API Gateway + DynamoDB) records user metadata and every action, so data use is strongly traceable. Service Catalog products built with CloudFormation give each user their own isolated workspace: an encrypted SageMaker notebook with a 100 GB disk, or RStudio. Lambda functions call Translate and Comprehend Medical through the SDK. The Data Lake holds very sensitive data that must stay inside the environment and cannot be downloaded. Each user has a home S3 bucket with predefined access rights. The portal went live in early August; it targeted 5-10 beta testers and grew to 30-40 users in 2-3 weeks.</data>
    <data key="d3">Healthcare, Data Science, Machine Learning, NLP, Static Web Portal, Self-service Provisioning</data>
    <data key="d4">True</data>
  </graph>
</graphml>
