  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Pathologist</data>
      <data key="d6">UserCompanyDomainExpert</data>
      <data key="d7">Pathologist who annotates and labels medical images on the EKS platform, then validates or rejects the trained models.</data>
    </node>
    <node id="1">
      <data key="d5">Hospital</data>
      <data key="d6">UserConsumerHospital</data>
      <data key="d7">Hospitals, biologists and clients who send medical images and later use the validated model for inference.</data>
    </node>
    <node id="2">
      <data key="d5">EKS (Kubernetes product / labeling platform)</data>
      <data key="d6">EKS</data>
      <data key="d7">Kinaï product on Kubernetes. Labeling platform for pathologists, model validation, and inference serving once the model is validated. HDS certification.</data>
    </node>
    <node id="3">
      <data key="d5">S3 (Images / Enriched Data)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the medical images uploaded by customers (about 5 TB per project) and the enriched, annotated data.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">Trains one model per project. Existing pipelines were containerized in Docker and reused in SageMaker, which made migration easy. Training is 30x faster, thousands of trainings can run in parallel, and costs are up to 30% lower because no idle resources are paid for.</data>
    </node>
    <node id="5">
      <data key="d5">S3 (Models)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the trained models and results before they are exported to the Kubernetes product.</data>
    </node>
    <node id="6">
      <data key="d5">FSx</data>
      <data key="d6">FSX</data>
      <data key="d7">High-performance storage used by SageMaker training for I/O performance.</data>
    </node>
    <node id="7">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">Fine-grained data access control and documentation for medical compliance (HDS). Data stays in the project's region (for example, Germany).</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Pathologist annotates and labels the images on the labeling platform, then validates or rejects the models.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Hospitals and biologists upload medical images to S3 buckets (about 5 TB per project).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">Hospital uses the validated model running in inference on Kubernetes.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Enriched, labeled data is written back to S3.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Images are loaded into the Kubernetes product to be shown to pathologists.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Enriched data is used to train one model per project in SageMaker.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">SageMaker training uses FSx for high I/O performance.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">IAM provides security and data access control (HDS compliance).</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The trained model is stored in an S3 bucket.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Model and results are exported to the Kubernetes product for pathologist validation and then inference. HDS certification.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Kinaï - Medical Image Labeling and ML Training Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=2XVgpMwY5iE</data>
    <data key="d2">Hospitals and biologists upload medical images (about 5 TB per project) to S3. Pathologists annotate them in a Kubernetes (EKS) labeling platform. The enriched data trains one model per project in SageMaker, using Dockerized pipelines plus FSx and IAM. Models are stored in S3 and exported back to EKS for pathologist validation and then inference used by hospitals. Reported benefits: thousands of trainings can run in parallel, training is 30x faster, and infrastructure costs dropped by up to 30% (dynamic infrastructure). Compliance: HDS certification, and data stays in the same region as the project (for example, Germany).</data>
    <data key="d3">Healthcare, Machine Learning, Data Labeling, Kubernetes</data>
    <data key="d4">True</data>
  </graph>
</graphml>
