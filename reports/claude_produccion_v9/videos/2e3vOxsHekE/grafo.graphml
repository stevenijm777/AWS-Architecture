<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Fire Hydrant</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Smart fire hydrant IoT devices. They collect acoustic data measuring noises on the pipe network, recorded daily and correlated across multiple hydrants.</data>
    </node>
    <node id="1">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Receives the daily acoustic signal files. Provides the authentication and security layer, which is why devices do not push straight to S3 (heavy focus on IoT security).</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Persists the incoming acoustic signal files.</data>
    </node>
    <node id="3">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Container microservices running a daily batch process. Each file is processed as a node pair to find correlations and persistent correlations (over many days). Chosen over Lambda because the acoustic algorithms are very processor-intensive.</data>
    </node>
    <node id="4">
      <data key="d5">SageMaker</data>
      <data key="d6">SageMaker</data>
      <data key="d7">ML endpoint that classifies persistent correlations and assigns a leak probability score. Retrained with field feedback about every 6 weeks to reduce false positives.</data>
    </node>
    <node id="5">
      <data key="d5">ANALYST</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Human analyst team. Receives leak scores, reviews the persistent correlation, checks with the water utility for other nearby noise sources, and updates the leak status to 'field investigation required'.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Daily correlated acoustic signal files are pushed through API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Authenticated and secured files are pushed to and persisted in S3.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Daily batch process on ECS processes each file as a node pair to find acoustic correlations.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Persistent correlations are sent to the SageMaker ML endpoint for classification and a leak probability.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Leak score (probability) is fed to the human analyst team for further classification and field investigation scheduling.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Mueller Water Products - Water Intelligence Platform (Acoustic Leak Detection)</data>
    <data key="d1">https://www.youtube.com/watch?v=2e3vOxsHekE</data>
    <data key="d2">Large-scale IoT network (meters, smart fire hydrants, pressure and water quality devices). Smart hydrants record correlated acoustic signals on the pipe network every day. Files go through API Gateway for authentication and security (strong focus on IoT security) and are persisted in S3. A daily ECS batch processes node pairs to find correlations and persistent correlations (over many days). A SageMaker endpoint assigns a leak probability, and analysts qualify the leaks and mark them for field investigation. Field feedback is used about every 6 weeks to retrain the model. Planned: add flow and pressure data.</data>
    <data key="d3">IoT, Machine Learning, Batch Processing, Containers</data>
    <data key="d4">True</data>
  </graph>
</graphml>
