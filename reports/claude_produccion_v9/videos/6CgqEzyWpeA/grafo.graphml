<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Client Devices</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Mobile/PC player that requests the personalized video (e.g., monthly bill) and streams the segments.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN that serves the video segments listed in the playlist and pulls them from the S3 origin.</data>
    </node>
    <node id="2">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point of the RAS ecosystem. Usage plans and API keys per customer control the load on the render farm.</data>
    </node>
    <node id="3">
      <data key="d5">RAS Frontend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">RAS service frontend. Validates rendering requests, pushes rendering instructions to SQS, and in the same invocation pulls the response from the responses queue to return the playlist link.</data>
    </node>
    <node id="4">
      <data key="d5">SQS Jobs Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds rendering instructions. Engine services pull jobs when they have capacity.</data>
    </node>
    <node id="5">
      <data key="d5">SQS Responses Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Gives a fast response from the rendering engine, including the playlist file link.</data>
    </node>
    <node id="6">
      <data key="d5">Rendering EC2 Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Rendering engine on Spot instances across multiple AZs with diverse instance types. Uploads video segments to S3 and pushes custom metrics to CloudWatch.</data>
    </node>
    <node id="7">
      <data key="d5">Auto Scaling Group</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Manages the pool of rendering Spot instances. Instances are detached when interrupted. Planned: instance-type weights.</data>
    </node>
    <node id="8">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the rendered video segments referenced by the playlist file. Origin for CloudFront.</data>
    </node>
    <node id="9">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers the custom scaling Lambda every 15 seconds.</data>
    </node>
    <node id="10">
      <data key="d5">Scaling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Reads the CloudWatch metrics pushed by the rendering instances, calculates expected traffic, and tells the ASG to raise or lower the number of in-service instances.</data>
    </node>
    <node id="11">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects custom rendering metrics. CloudWatch Events sends the Spot instance interruption notice (2-minute warning).</data>
    </node>
    <node id="12">
      <data key="d5">Interruption Handler Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">On a Spot interruption, calls an API on the instance to stop pulling jobs and drain current renders (they finish within the 2-minute window), then detaches the instance from the ASG.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests the personalized video (e.g., monthly bill) through API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Player requests video segments through the CloudFront links.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFront pulls video segments from the S3 origin and plays them to the user.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">API Gateway routes the request to the RAS frontend Lambda after usage plan/API key checks.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda validates the request and pushes rendering instructions to the jobs queue.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Playlist file link returned to the player on the client device.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Rendering engines on Spot instances pull jobs when they have capacity.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">The same Lambda invocation pulls the response (playlist link) from the queue.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Engine responds immediately to the responses queue with the playlist info.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Rendering engine uploads the rendered video segments to S3.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="11" id="0">
      <data key="d8">3</data>
      <data key="d9">Rendering instances push custom performance metrics to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="9" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Step Functions triggers the scaling Lambda every 15 seconds.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="10" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Scaling Lambda tells the ASG to increase or decrease the number of in-service instances based on expected traffic.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="12" id="0">
      <data key="d8">2</data>
      <data key="d9">CloudWatch Event notifies that a specific instance ID is about to be reclaimed (2-minute Spot interruption notice).</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="11" target="10" id="0">
      <data key="d8">3</data>
      <data key="d9">Scaling Lambda reads the CloudWatch metrics to calculate the capacity it needs (stated in the audio).</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="12" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">API call telling the instance to stop pulling rendering requests and drain its current jobs.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="12" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">After draining, the instance is detached from the Auto Scaling Group.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Sundaysky Rendering as a Service (RAS) - Personalized Video Rendering on Spot Instances</data>
    <data key="d1">https://www.youtube.com/watch?v=6CgqEzyWpeA</data>
    <data key="d2">Personalized video experiences, for example a monthly telco bill as a video. Rendering runs entirely on EC2 Spot instances spread across multiple AZs with diverse instance types. Scale: billions of videos a year and millions a day. Planned next step: ASG instance weights so scaling can be expressed in units of rendering capacity.</data>
    <data key="d3">Media, Video Rendering, Serverless, Compute, Spot Instances, Auto Scaling</data>
    <data key="d4">True</data>
  </graph>
</graphml>
