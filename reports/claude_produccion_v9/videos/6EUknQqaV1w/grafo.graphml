<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis Data Streams (Collect)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Collection stream. The collection framework evaluates the cloud providers' native security events (CloudWatch events, Azure activity log), determines the current resource state and publishes the resources here. Handles billions of events per day from 3 cloud providers.</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Neptune</data>
      <data key="d6">Neptune</data>
      <data key="d7">Primary persistence, used as a graph database for highly interconnected cloud resource data. Chosen because it is schema-less (agnostic to varied resource configurations across providers) and provides the read scale-out needed to execute rules. Stores 50M+ resources across multiple provisioned clusters.</data>
    </node>
    <node id="2">
      <data key="d5">Elasticsearch</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">Backing store for reporting, analytics, search and aggregations, so customers can slice and dice the resource data.</data>
    </node>
    <node id="3">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Backing store for visualizing how resource configurations change over time. Also persists the security violations detected by the rule engine.</data>
    </node>
    <node id="4">
      <data key="d5">Kinesis Data Streams (Rules)</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Fronts the rule execution pipeline. The rule engine decides which rules (potentially thousands) to execute for each event and its resource changes, and runs them against the Neptune graph.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects CPU, memory and other metrics from Neptune and Elasticsearch. The sharder uses these metrics to determine shard capacity.</data>
    </node>
    <node id="6">
      <data key="d5">Sharder Service</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Custom service for write scale-out. It logically groups data across the provisioned Neptune clusters, uses CloudWatch metrics to decide whether a cluster is full, and load-balances customer data.</data>
    </node>
    <node id="7">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Real-time security violation notification channel for customers.</data>
    </node>
    <node id="8">
      <data key="d5">Email</data>
      <data key="d6">SES</data>
      <data key="d7">Real-time security violation email notifications. Other supported channels include Splunk.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">The consumer publishes the ingested cloud resources (50M+) into Neptune.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">The incoming event is propagated to the rule execution pipeline.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Resource data is sent to Elasticsearch for reporting, analytics and search.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Resource data is sent to DynamoDB to track configuration history over time.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Neptune CPU, memory and other metrics are published to CloudWatch.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">Persisted resource changes are propagated to the rule execution pipeline.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">Elasticsearch metrics are published to CloudWatch.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="4" target="1" id="0">
      <data key="d8">3</data>
      <data key="d9">The rule engine runs thousands of rules over the Neptune graph to perform security checks, using Neptune's read scale-out.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">3</data>
      <data key="d9">Detected security violations are persisted in DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">3</data>
      <data key="d9">Real-time violation notification is sent to Slack.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">3</data>
      <data key="d9">Real-time violation notification is sent by email.</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">The sharder consumes CloudWatch metrics to determine the shard capacity of the Neptune clusters.</data>
      <data key="d10">1</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="6" target="1" id="0">
      <data key="d8">2</data>
      <data key="d9">Feedback loop: shard placement decisions load-balance customer data across the provisioned Neptune clusters (write scale-out).</data>
      <data key="d10">2</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">CloudHealth Secure State by VMware - Real-time Cloud Security and Compliance Monitoring</data>
    <data key="d1">https://www.youtube.com/watch?v=6EUknQqaV1w</data>
    <data key="d2">A cloud security and monitoring platform for 3 major cloud providers. It processes billions of events per day covering 50M+ cloud resources, and that number keeps growing. Ingestion starts from the cloud providers' native security event streams (CloudWatch events, Azure activity log). A collection framework works out the current state of each resource and publishes it to Kinesis. Neptune is the primary graph store: it is schema-less and provides read scale-out. A custom sharder scales writes across the provisioned Neptune clusters. The rule engine runs thousands of rules per event and sends notifications to Slack, email, Splunk and similar channels.</data>
    <data key="d3">Security, Compliance, Data Pipeline, Graph Database, Real-time Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
