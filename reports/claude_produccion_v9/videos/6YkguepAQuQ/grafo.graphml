<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Dev</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developer who commits code and CloudFormation templates. Can change the build and the infrastructure by changing the repository.</data>
    </node>
    <node id="1">
      <data key="d5">CodePipeline</data>
      <data key="d6">CodePipeline</data>
      <data key="d7">Orchestrates the source, build and deploy stages. Runs parallel deploy stages for up to 100 customers.</data>
    </node>
    <node id="2">
      <data key="d5">CodeCommit</data>
      <data key="d6">CodeCommit</data>
      <data key="d7">Source repository holding the application code, build specification and CloudFormation templates.</data>
    </node>
    <node id="3">
      <data key="d5">CodeBuild</data>
      <data key="d6">CodeBuild</data>
      <data key="d7">Starts a build container and is paid for only during the build. Outputs an application container image after a successful build. The build is controlled by the developer through the repository.</data>
    </node>
    <node id="4">
      <data key="d5">Registry</data>
      <data key="d6">ECR</data>
      <data key="d7">Stores the built application container image so it is ready to deploy.</data>
    </node>
    <node id="5">
      <data key="d5">CloudFormation</data>
      <data key="d6">CloudFormation</data>
      <data key="d7">Deploy stage, chosen over CodeDeploy, the ECS deployer or Lambda so that the infrastructure is deployed too. Uses one baseline template for all production VPCs. Runs a 3-step process: Change Set -&gt; Approve -&gt; Execute. Deploys in parallel to up to 100 customer VPCs, with a per-customer configuration (VPC name, ECS cluster).</data>
    </node>
    <node id="6">
      <data key="d5">VPC</data>
      <data key="d6">VPC</data>
      <data key="d7">Per-customer production VPC where the deployed product runs. Each customer has its own VPC.</data>
    </node>
    <node id="7">
      <data key="d5">ECS</data>
      <data key="d6">ECS</data>
      <data key="d7">Elastic Container Service task definition running the application image.</data>
    </node>
    <node id="8">
      <data key="d5">IAM</data>
      <data key="d6">IAM</data>
      <data key="d7">IAM roles and permissions deployed as part of the application infrastructure.</data>
    </node>
    <node id="9">
      <data key="d5">ALB</data>
      <data key="d6">ALB</data>
      <data key="d7">Application Load Balancer deployed as part of the application infrastructure.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer commits code changes (including CloudFormation templates) to CodeCommit.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Once the image is in the registry, the pipeline starts the CloudFormation deploy stage (Change Set -&gt; Approve -&gt; Execute), in parallel for up to 100 customers.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">The pipeline moves the new commit to the build stage, which triggers CodeBuild.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">After a successful build, CodeBuild pushes the application container image to the ECR registry.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudFormation deploys the same baseline template consistently to each customer VPC.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Deploys the ECS task definition running the application image.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Deploys IAM roles and permissions.</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Deploys the Application Load Balancer.</data>
      <data key="d10">2''</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Etion - CI/CD Pipeline Deploying Application and Infrastructure via CloudFormation</data>
    <data key="d1">https://www.youtube.com/watch?v=6YkguepAQuQ</data>
    <data key="d2">Healthcare analytics company (epidemiology, real-world evidence). It streamlines the process from developer commit to production using CodePipeline: CodeCommit (source), CodeBuild (container build, pay only for build duration), ECR (image registry), and CloudFormation (deploy stage). CloudFormation templates live in the developer repositories and define the whole application infrastructure (ECS task definition, IAM roles, ALB). Developer environments are kept separate from production/client QA environments. A single baseline template is deployed in parallel stages to up to 100 customer VPCs, each with a small configuration (VPC name, ECS cluster name). The deploy stage is governed in three steps: 1) Change Set, 2) Approve (by someone with the right permissions), 3) Execute.</data>
    <data key="d3">DevOps, CI/CD, Infrastructure as Code, Containers, Healthcare Analytics</data>
    <data key="d4">True</data>
  </graph>
</graphml>
