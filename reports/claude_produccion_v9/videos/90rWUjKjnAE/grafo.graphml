<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEVELOPER</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developers write code and push it to their Git repositories. Everything they want deployed is defined in the repo (infrastructure as code).</data>
    </node>
    <node id="1">
      <data key="d5">GIT</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Git repositories with webhooks connected to Lagoon. Feature branches and pull requests trigger environment deployments.</data>
    </node>
    <node id="2">
      <data key="d5">LAGOON EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Lagoon core (open source application delivery platform) running on EKS. It listens to repository webhooks, decides what needs to be done and deploys to the hosting zones. Migrated from OpenShift to Kubernetes for flexibility and to stay on the bleeding edge.</data>
    </node>
    <node id="3">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Hosting EKS cluster where developer environments are deployed. Operators running on the cluster detect storage needs and provision storage or databases transparently.</data>
    </node>
    <node id="4">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">On-demand EC2 instances that run the base infrastructure and production workload. The plan is to move more of it to Spot over time.</data>
    </node>
    <node id="5">
      <data key="d5">EC2 SPOT</data>
      <data key="d6">EC2</data>
      <data key="d7">EC2 Spot instances for development and non-production workloads that can tolerate pod failure or termination. Cost savings of 70–90% compared with on-demand EC2.</data>
    </node>
    <node id="6">
      <data key="d5">AURORA R6G</data>
      <data key="d6">Aurora</data>
      <data key="d7">Aurora on Graviton2 (ARM) R6g instances. Databases are provisioned on demand by an operator during deployment and exposed back to the project as a set of secrets. R6g was first rolled out to non-production with no regressions found and is now moving to production.</data>
    </node>
    <node id="7">
      <data key="d5">EBS GP3</data>
      <data key="d6">EBS</data>
      <data key="d7">EBS gp3 volumes for specialized workloads such as databases and search servers (OpenSearch, Solr). Adopted when announced (test workloads mid-December 2020) and then rolled out to every platform during maintenance windows. Lower storage cost and better IOPS.</data>
    </node>
    <node id="8">
      <data key="d5">EFS</data>
      <data key="d6">EFS</data>
      <data key="d7">Shared file system for regular application assets that need no special storage. The operator selects it automatically.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developer creates code and pushes it to the Git repository.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Git webhooks notify Lagoon of pushes, new feature branches or opened pull requests.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Lagoon goes to the hosting zone and deploys everything the environment needs to the hosting EKS cluster.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS runs the base and production workload on regular EC2 instances.</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">EKS runs development and non-production workloads on EC2 Spot instances (70–90% cost savings).</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Workloads use an Aurora R6g database, provisioned by an operator when requested during deployment. Credentials are exposed to the project as secrets.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Specialized workloads (databases, OpenSearch/Solr) get EBS gp3 volumes, provisioned automatically by the operator.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Regular application file assets are stored on EFS, selected automatically by the operator.</data>
      <data key="d10">0''</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Amazee.io Lagoon - Open Source Application Delivery Platform on Amazon EKS</data>
    <data key="d1">https://www.youtube.com/watch?v=90rWUjKjnAE</data>
    <data key="d2">Lagoon is Amazee.io's open source application delivery platform. It lets developers deploy applications to Kubernetes without needing deep Kubernetes knowledge. It uses infrastructure as code: everything to be deployed is defined in the Git repository. Git webhooks trigger Lagoon, which deploys environments (feature branches, pull requests) into hosting EKS clusters. The platform migrated from OpenShift to Kubernetes/EKS. Planned next steps: move more workloads from EC2 to Spot, move more to R6g, and lower costs with Savings Plans.</data>
    <data key="d3">Containers, Kubernetes, DevOps, GitOps, Cost Optimization, Storage</data>
    <data key="d4">True</data>
  </graph>
</graphml>
