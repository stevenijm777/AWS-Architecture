<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">META MANAGER</data>
      <data key="d6">EKS</data>
      <data key="d7">The 'brains' of the grid. A microservice architecture on EKS that a frontend (F.E.) connects to. It hides the complexity of the data movement technology, discovers tables, schemas and APIs, orchestrates data movement, and applies data protection to data coming into and out of the data lake.</data>
    </node>
    <node id="1">
      <data key="d5">ELASTICSEARCH NEO4J (MetaStore)</data>
      <data key="d6">OpenSearch</data>
      <data key="d7">MetaStore that combines a document database (Elasticsearch) and a graph database (Neo4j). Stores and indexes the discovered metadata.</data>
    </node>
    <node id="2">
      <data key="d5">S3 DATA LAKE</data>
      <data key="d6">S3</data>
      <data key="d7">Central data lake holding all collected data, about 60 TB today.</data>
    </node>
    <node id="3">
      <data key="d5">KAFKA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Enterprise streaming platform shared across all MAF companies. 600 topics, 250 GB, 7-day average retention. Streams data from distributed sources (different networks, countries and technologies) into the data lake.</data>
    </node>
    <node id="4">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Used together with Kafka to bring data into the data lake. Processes data and exchanges it with applications and APIs.</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Consumption data store. Data can be published or consumed through APIs or OLTP.</data>
    </node>
    <node id="6">
      <data key="d5">VERTICA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Analytics data store used by data analysts and data scientists for traditional analytics.</data>
    </node>
    <node id="7">
      <data key="d5">MULTIPLE DATA SOURCES</data>
      <data key="d6">RDS</data>
      <data key="d7">Distributed source databases across different networks, countries and technologies.</data>
    </node>
    <node id="8">
      <data key="d5">APPLICATIONS</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Business applications and APIs (for example, the loyalty app). Data is consumed from them and sent back to the business to connect with customers (push notifications, cross campaigns).</data>
    </node>
    <node id="9">
      <data key="d5">DA/DS</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Data analysts and data scientists who consume data, run models and build dashboards.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Discovered metadata is stored and indexed in the MetaStore (document and graph database).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Meta Manager orchestrates data movement through the Kafka streaming platform.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR reads data from the S3 data lake for processing.</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">Protected data from the data lake is sent to RDS for consumption through APIs or OLTP.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="7" id="0">
      <data key="d8">4</data>
      <data key="d9">Reverse direction of the bidirectional arrow: the enterprise streaming platform sends data back to the sources and the business.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Kafka streams data into the S3 data lake (7-day retention in Kafka).</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="8" id="0">
      <data key="d8">4</data>
      <data key="d9">Processed data is sent back to the business applications to connect with customers (for example, loyalty app push notifications).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="2" id="0">
      <data key="d8">2</data>
      <data key="d9">EMR writes data into the S3 data lake (about 60 TB).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">3</data>
      <data key="d9">Data is sent to Vertica for analytics.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Data analysts and data scientists consume data (supported by the audio).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="9" id="0">
      <data key="d8">3</data>
      <data key="d9">Data analysts and data scientists run models and build dashboards on Vertica (supported by the audio).</data>
      <data key="d10">1'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Meta Manager discovers tables, schemas and APIs from the data sources (supported by the audio and the pink line on the whiteboard).</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="7" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Data is collected from multiple sources across networks and countries into Kafka (600 topics, 250 GB).</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">Data from applications and APIs is ingested by EMR.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Majid Al Futtaim - 'The Grid' Enterprise Data Platform (Collect, Protect, Connect)</data>
    <data key="d1">https://www.youtube.com/watch?v=9qTEHITVeLE</data>
    <data key="d2">Data platform built around three goals: collect, protect and connect data across 14 countries and several business units (retail, real estate, malls, entertainment). The infrastructure is defined as code by the DevOps team and can be spun up and down on demand (for example, for IT tests). The MVP reached production in 6 months. Business result: a 360-degree customer view across Vox Cinemas and Carrefour, which enables cross-brand marketing campaigns and push notifications.</data>
    <data key="d3">Data Lake, Analytics, Streaming, Metadata Management, Customer 360</data>
    <data key="d4">True</data>
  </graph>
</graphml>
