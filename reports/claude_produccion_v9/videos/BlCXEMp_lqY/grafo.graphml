<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart TV</data>
      <data key="d6">UserConsumerTV</data>
      <data key="d7">Vizio smart TVs (millions of connected devices) send logs, performance telemetry and user/application usage data directly to Kinesis. Data comes in different formats and columns with no fixed schema.</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Streams</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Front door to the cloud; everything is piped through it. Runs an 8-shard pipeline that has not yet needed resharding. Handles billions of events per month.</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Takes the data as-is from Kinesis Data Streams and dumps it into Redshift, and stores the raw data in S3.</data>
    </node>
    <node id="3">
      <data key="d5">S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Long-term raw data store kept forever for future use, since storage is cheap. Used to reload the full dataset into Redshift without data loss when migrating away from Aurora.</data>
    </node>
    <node id="4">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Columnar data warehouse that receives only a subset of the columns. Optimized IO for large aggregations over billions of rows. Replaced an earlier Aurora experiment.</data>
    </node>
    <node id="5">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Visualization and reporting. Uses the built-in in-memory SPICE engine, which is loaded from Redshift with custom SQL queries for fast slicing and dicing of the data.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">TVs send logs, performance telemetry and user data directly to Kinesis Data Streams.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Stream data is piped to Kinesis Data Firehose.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose ingests the data as-is into Redshift (a subset of the columns).</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Raw data is stored in S3 permanently and can be used to reload the warehouse.</data>
      <data key="d10">2'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Custom SQL queries load data subsets from Redshift into QuickSight SPICE datasets for reporting.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Vizio Smart TV Telemetry Analytics Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=BlCXEMp_lqY</data>
    <data key="d2">Vizio collects logs, performance telemetry and user data from millions of connected smart TVs (billions of events per month). Kinesis Data Streams is the ingestion front door. Kinesis Data Firehose delivers raw data to S3 for permanent storage and a subset of columns to Redshift. QuickSight with SPICE is used for reporting. The data is not tied to a fixed schema. Aurora was tried earlier but did not aggregate billions of rows well. The pipeline went to production in about 6 weeks with help from AWS Professional Services.</data>
    <data key="d3">Analytics, Data Ingestion, Streaming, Data Warehousing, IoT/Telemetry, Business Intelligence</data>
    <data key="d4">True</data>
  </graph>
</graphml>
