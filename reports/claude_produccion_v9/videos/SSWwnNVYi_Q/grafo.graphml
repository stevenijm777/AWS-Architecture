<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Users (NHS Digital internal teams)</data>
      <data key="d6">UserCompanyAnalyst</data>
      <data key="d7">Internal NHS Digital teams who log in to analyse data. The service is expanding to more teams.</data>
    </node>
    <node id="1">
      <data key="d5">EC2 Gateway (Guacamole)</data>
      <data key="d6">EC2</data>
      <data key="d7">Public gateway on the public side of the dotted line. Users log in to Apache Guacamole here and are then placed in the secure sandbox.</data>
    </node>
    <node id="2">
      <data key="d5">AD</data>
      <data key="d6">DirectoryService</data>
      <data key="d7">Active Directory/Directory Services authenticates users. User roles are also used by the data processing tools (Apache Ranger) to control which data each user can see.</data>
    </node>
    <node id="3">
      <data key="d5">EMR</data>
      <data key="d6">EMR</data>
      <data key="d7">Runs the analytics jobs and provides a consistent compute layer. Reads data from S3. Apache Ranger provides fine-grained access control. Chosen over Cloudera and on-prem options for its flexibility and scale. Jobs went from hours to minutes or seconds.</data>
    </node>
    <node id="4">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Database within the secure environment, encrypted with KMS keys.</data>
    </node>
    <node id="5">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores existing NHS datasets migrated and converted to Parquet format. The data is confidential and always encrypted, both at rest and in transit.</data>
    </node>
    <node id="6">
      <data key="d5">KMS</data>
      <data key="d6">KMS</data>
      <data key="d7">Provides the keys that encrypt the data in S3 and other information in the system. Data is encrypted at all times.</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Sandbox</data>
      <data key="d6">EC2</data>
      <data key="d7">Secure sandbox compute environment where users look at and analyse data but cannot take it out of the system. Tools include RStudio, JupyterHub and Hue.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Internal users log in to the public gateway (Guacamole).</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Users authenticate through Directory Services. Their roles drive data access permissions (Apache Ranger).</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">EMR reads the Parquet datasets from S3 to run the analytics jobs.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">2</data>
      <data key="d9">KMS provides the keys that encrypt the confidential data in S3, both at rest and in transit.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="4" id="0">
      <data key="d8">2</data>
      <data key="d9">KMS provides the encryption keys for RDS.</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The sandbox environment reads data in S3 for analysis. Data cannot leave the system.</data>
      <data key="d10">0'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">NHS Digital - Data Access Environment on AWS</data>
    <data key="d1">https://www.youtube.com/watch?v=SSWwnNVYi_Q</data>
    <data key="d2">This is NHS Digital's data access environment. It is replacing legacy systems. Users connect through a public gateway (Guacamole on EC2) and authenticate with Directory Services. They then work in a secure sandbox where they can analyse data but cannot take it out. Datasets are converted to Parquet and stored in S3, and they are encrypted with KMS at rest and in transit. EMR runs the analytics jobs, and Apache Ranger enforces role-based fine-grained access. Analytics jobs that used to take hours now take minutes or seconds, and audit is stronger. Tooling includes RStudio, JupyterHub and Hue. The long-term goal is machine learning.</data>
    <data key="d3">Analytics, Big Data, Security, Healthcare</data>
    <data key="d4">True</data>
  </graph>
</graphml>
