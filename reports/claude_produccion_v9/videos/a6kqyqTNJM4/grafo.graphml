<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">USER</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">End customers of travel brands (e.g., Almosafer); about 300k requests per minute on average, from different regions and devices.</data>
    </node>
    <node id="1">
      <data key="d5">CLOUDFRONT</data>
      <data key="d6">CloudFront</data>
      <data key="d7">CDN entry point that serves customers more effectively; Almosafer is a content-heavy platform.</data>
    </node>
    <node id="2">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Cost-efficient storage for static content and images.</data>
    </node>
    <node id="3">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Edge logic that detects the region and device traffic comes from and decides routing; provides the first layer of scaling and resiliency.</data>
    </node>
    <node id="4">
      <data key="d5">LOAD BALANCER</data>
      <data key="d6">ELB</data>
      <data key="d7">About 60 load balancers; decide whether traffic is backend or web (frontend) and route between legacy and new microservices for gradual migration.</data>
    </node>
    <node id="5">
      <data key="d5">LEGACY</data>
      <data key="d6">EC2</data>
      <data key="d7">Legacy monolithic systems still hosted on EC2 while they are being migrated to microservices.</data>
    </node>
    <node id="6">
      <data key="d5">EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Core platform for backend and micro-frontend services; about 80% of services migrated; more than 250 microservices on over 1400 pods in production.</data>
    </node>
    <node id="7">
      <data key="d5">MONGO/ KAFKA</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Self-managed MongoDB instances on EC2 for NoSQL needs (most services); Kafka is the backbone for event-driven microservices.</data>
    </node>
    <node id="8">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Managed relational databases for functions that need SQL transactions.</data>
    </node>
    <node id="9">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts self-managed third-party software (MongoDB, Kafka, and monitoring tools such as Prometheus and the ELK stack for logs).</data>
    </node>
    <node id="10">
      <data key="d5">CLOUDWATCH</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">AWS-native monitoring that checks service and pod health; feeds alerting through Slack and PagerDuty.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User requests (about 300k per minute) enter through the CloudFront CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront forwards requests to the load balancers (about 60).</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 serves static content and images to CloudFront.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda decides routing based on the region and device the traffic comes from.</data>
      <data key="d10">1'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes legacy traffic to monolithic services on EC2.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Routes backend and frontend traffic to microservices on EKS.</data>
      <data key="d10">3'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices read and write NoSQL data in MongoDB and publish/consume events through Kafka.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Microservices that need SQL transactions use RDS.</data>
      <data key="d10">4'</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Self-managed monitoring tools on EC2 (Prometheus, ELK stack) give an internal view of every service and its logs; feeds alerts through Slack and PagerDuty.</data>
      <data key="d10">0'</data>
      <data key="d11">meta</data>
    </edge>
    <edge source="10" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudWatch monitors system metrics and pod health across services.</data>
      <data key="d10">0</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Seera Group - Travel Platform Architecture (Almosafer) with CloudFront, EKS Microservices and Legacy Migration</data>
    <data key="d1">https://www.youtube.com/watch?v=a6kqyqTNJM4</data>
    <data key="d2">Almosafer receives about 300k requests per minute. There are about 60 load balancers that route traffic between legacy monolith (EC2) and microservices (EKS). About 80% of services have been migrated to EKS, with more than 250 microservices running on over 1400 pods in production. The data layer uses self-managed MongoDB/Kafka on EC2 and RDS. Monitoring uses CloudWatch plus self-managed Prometheus and ELK, with alerts through Slack and PagerDuty.</data>
    <data key="d3">Web Application, Microservices, Containers, Legacy Migration, CDN, Monitoring</data>
    <data key="d4">True</data>
  </graph>
</graphml>
