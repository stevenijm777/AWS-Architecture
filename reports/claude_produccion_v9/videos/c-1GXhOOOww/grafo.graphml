<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Tenant Web App (Onboarding Wizard)</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">New tenants use a web wizard that walks them through the steps for setting up an event or tenancy.</data>
    </node>
    <node id="1">
      <data key="d5">Customer Channels (Mobile/Web/OTA)</data>
      <data key="d6">UserConsumerWebMobile</data>
      <data key="d7">Customers come through several channels: the mobile app, owned websites, or third-party resellers (OTAs such as Expedia, Viator and GetYourGuide). A check-in mobile app is also used.</data>
    </node>
    <node id="2">
      <data key="d5">CDN</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Every client request hits the CDN first. It serves static content from S3 and routes dynamic requests to AppSync or API Gateway.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 bucket used as an HTTP server for static content, such as event descriptions and pictures.</data>
    </node>
    <node id="4">
      <data key="d5">AppSync</data>
      <data key="d6">AppSync</data>
      <data key="d7">GraphQL gateway. Its resolvers invoke Lambda, and it also uses direct DynamoDB resolvers that can be reused through pipeline resolvers.</data>
    </node>
    <node id="5">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Regular REST third-party API built for OTA resellers. Reaches the same backend logic as the owned channels.</data>
    </node>
    <node id="6">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Business logic. Fans out to subroutines by putting messages on SQS and reprocesses those messages later.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Multi-tenant data store. Tenants share tables, and every item is partitioned by a tenant partition key.</data>
    </node>
    <node id="8">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queue for asynchronous fan-out and post-check-in work, such as customer service and review-reminder emails.</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">The tenant onboarding web app first hits the CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">1</data>
      <data key="d9">Customer requests from the mobile app, website or OTA reseller first hit the CDN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">The CDN routes dynamic requests to the AppSync GraphQL gateway.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">The CDN fetches static offering content (descriptions, pictures) from S3 and returns it to the client. The arrow is drawn bidirectional.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">3</data>
      <data key="d9">OTA reseller requests go through the CDN to the third-party REST API on API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">AppSync resolvers invoke Lambda to fan out to different subroutines.</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">2</data>
      <data key="d9">AppSync direct DynamoDB resolver. Can be reused through AppSync pipeline resolvers.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">3</data>
      <data key="d9">API Gateway forwards to the same backend as the other channels. The arrow is drawn toward AppSync; the audio says it hits the same Lambdas.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda puts a set of messages on SQS for later processing.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda reads and writes DynamoDB to finish setting up the tenant. The arrow is drawn bidirectional. Data is partitioned by tenant key.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">SQS messages are reprocessed by Lambda later.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Anchor Serverless Multi-Tenant Ticketing Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=c-1GXhOOOww</data>
    <data key="d2">Anchor is a ticketing platform for daytime experiences, such as Statue of Liberty cruises, Niagara Falls, Alcatraz and NYC Ferry. It has more than 40 tenants, with more than 20 onboarded in the last 6 months. Customers come through several channels: the mobile app, websites and OTA resellers. A check-in mobile app uses the same AppSync -&gt; Lambda -&gt; DynamoDB/SQS flow. Work after check-in, such as customer service and review-reminder emails, is queued in SQS and processed later by Lambda.</data>
    <data key="d3">Serverless, Multi-tenancy, GraphQL, Web/Mobile, Ticketing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
