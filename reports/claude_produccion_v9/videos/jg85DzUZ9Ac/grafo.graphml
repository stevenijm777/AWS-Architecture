<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">ONPREM</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">On-premises database storing sales data at invoice level with key attributes.</data>
    </node>
    <node id="1">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7">VPN connection through which on-premises sales data is piped into AWS.</data>
    </node>
    <node id="2">
      <data key="d5">DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">Database Migration Service using CDC (change data capture) to pull sales data and populate Redshift.</data>
    </node>
    <node id="3">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">S3 drop bucket receiving order-level flat files and demand data from the ERP system.</data>
    </node>
    <node id="4">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Handles messaging; file arrivals in the drop bucket kick off SQS messages.</data>
    </node>
    <node id="5">
      <data key="d5">LAMBDA 1</data>
      <data key="d6">Lambda</data>
      <data key="d7">Initiator Lambda job; pulls file metadata from DynamoDB and pushes data into the appropriate Data Lake structures (raw/refined buckets).</data>
    </node>
    <node id="6">
      <data key="d5">DYNAMODB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores metadata and key information about incoming files in the pipeline.</data>
    </node>
    <node id="7">
      <data key="d5">DATA LAKE</data>
      <data key="d6">S3</data>
      <data key="d7">S3-based data lake with raw and refined buckets; event-driven S3 trigger launches the processing Lambda.</data>
    </node>
    <node id="8">
      <data key="d5">LAMBDA 2</data>
      <data key="d6">Lambda</data>
      <data key="d7">Complex Lambda job: merges order sales and inventory sales datasets, applies business rules and exceptions, creates a new file, and applies Python stats model packages to forecast current and future demand.</data>
    </node>
    <node id="9">
      <data key="d5">REDSHIFT</data>
      <data key="d6">RedShift</data>
      <data key="d7">Redshift cluster; holds sales data and processed demand data; business users and leadership query it daily with various tools.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">On-premises invoice-level sales data piped through the VPN.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS with CDC pulls the sales data coming through the VPN.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS populates the Redshift cluster with sales data.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Flat files landing in the S3 drop bucket kick off SQS messages.</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">SQS launches the initiator Lambda job.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Initiator Lambda pulls metadata and key information about incoming files from DynamoDB.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda pushes file data into the appropriate Data Lake structures (raw and refined buckets).</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="9" id="0">
      <data key="d8">0</data>
      <data key="d9">Sales data made available to the data lake and read back into Redshift for analytics and reports.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Event-driven S3 trigger on the Data Lake bucket launches the complex processing Lambda.</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="8" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Lambda merges order and inventory sales datasets, applies rules and Python stats models, and creates a new demand file.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="8" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">Processed demand data fed into Redshift for daily querying by business users and leadership.</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Veritiv - Sales and Demand Analytics Data Lake Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=jg85DzUZ9Ac</data>
    <data key="d2">Veritiv (Fortune 500 distributor) built a pipeline for timely, accurate order and demand analytics during COVID-19. Invoice-level sales data is replicated from on-premises to Redshift through VPN and DMS (CDC). Order and demand flat files from the ERP go through S3, SQS, Lambda, DynamoDB and the Data Lake, then a processing Lambda (Python stats models), and finally Redshift. A small agile team delivered it in 4 to 5 weeks without increasing costs. Planned next steps are CloudFormation automation and SageMaker/ML.</data>
    <data key="d3">Analytics, Data Lake, Serverless, Database Migration, ETL</data>
    <data key="d4">True</data>
  </graph>
</graphml>
