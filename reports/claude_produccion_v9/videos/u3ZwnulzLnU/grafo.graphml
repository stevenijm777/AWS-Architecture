<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">DEVELOPERS</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Developers write code and push it to GitHub repos. They later view results through the UI or the API.</data>
    </node>
    <node id="1">
      <data key="d5">GITHUB</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">External GitHub repositories. A code push triggers an event (webhook).</data>
    </node>
    <node id="2">
      <data key="d5">LAMBDA</data>
      <data key="d6">Lambda</data>
      <data key="d7">Captures the GitHub push event, does triage and analysis, and creates an analysis request.</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Analysis request queue. It levels the load so the Fargate cluster isn't overwhelmed, and the Fargate service auto-scaling is plugged directly into it.</data>
    </node>
    <node id="4">
      <data key="d5">ECS FARGATE</data>
      <data key="d6">Fargate</data>
      <data key="d7">Auto-scaling worker service that pulls the queue, clones the code (largest code base is 9 MB) using only ephemeral storage, analyzes it, and pushes analysis reports.</data>
    </node>
    <node id="5">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts the API that receives analysis reports, plus the UI/API that users use to get results.</data>
    </node>
    <node id="6">
      <data key="d5">AURORA</data>
      <data key="d6">Aurora</data>
      <data key="d7">Database that stores reports and state. It is also used as temporary report storage, working like a queue (planned to be replaced by a proper SQS queue).</data>
    </node>
    <node id="7">
      <data key="d5">ECS FARGATE Compute Engine</data>
      <data key="d6">Fargate</data>
      <data key="d7">The Compute Engine. It pulls the database to extract reports, computes code quality metrics, updates the database with the final analysis report, and writes optimized search data.</data>
    </node>
    <node id="8">
      <data key="d5">ES</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">In-house Elasticsearch service (not Amazon yet; a move to the managed Amazon version is planned). Stores shared data in an optimized format for search.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Developers push code changes to the GitHub repo.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Placeholder - see corrected edge below.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">SonarSource SonarCloud AutoScan Code Analysis Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=u3ZwnulzLnU</data>
    <data key="d2">SonarCloud AutoScan by SonarSource. It supports 27 programming languages and up to 150k analyses per week, with around 300,000 organizations in the ecosystem. Currently it supports only non-compiled languages (TypeScript, Python, etc.); Java and C# are planned. Future plans: move to a managed Elasticsearch service and replace the Aurora-based queue with a proper SQS queue.</data>
    <data key="d3">DevTools, Code Analysis, Serverless, Containers, Queue-based Processing</data>
    <data key="d4">True</data>
  </graph>
</graphml>
