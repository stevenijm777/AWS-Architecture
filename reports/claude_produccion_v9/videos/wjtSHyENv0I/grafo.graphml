<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Independent Agents</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7">Independent insurance agents of Main Street America who use the application.</data>
    </node>
    <node id="1">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Serves the modernized single page application (previously hosted on Apache) and routes API calls to the backend.</data>
    </node>
    <node id="2">
      <data key="d5">S3 (SPA Bucket)</data>
      <data key="d6">S3</data>
      <data key="d7">Stores the static assets of the single page application.</data>
    </node>
    <node id="3">
      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for backend calls. Replaced the load-balanced on-prem Tomcat servers.</data>
    </node>
    <node id="4">
      <data key="d5">Lambda Authorizer</data>
      <data key="d6">Lambda</data>
      <data key="d7">Modern custom Lambda authorizer. API Gateway invokes it first to check that the caller has access.</data>
    </node>
    <node id="5">
      <data key="d5">Lambda (Python Backend)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Serverless Python Lambda that scales up and down easily. Runs the modernized functions (new features, significant enhancements, significant bug fixes) and calls the legacy Tomcat app for functionality not migrated yet. Uses DynamoDB for caching because each invocation may hit a different Lambda instance.</data>
    </node>
    <node id="6">
      <data key="d5">EC2 (Legacy Tomcat Java App)</data>
      <data key="d6">EC2</data>
      <data key="d7">Legacy Tomcat Java application that still hosts functionality not migrated yet, such as user management. It is being gradually strangled.</data>
    </node>
    <node id="7">
      <data key="d5">DynamoDB (User Session Cache)</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Regional table that caches user information. Lambdas running in different Availability Zones (A and B) share the cache, so if one AZ fails the others keep access without interruption.</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Agents request the single page application through CloudFront.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">CloudFront retrieves the static SPA assets from the S3 bucket.</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">Backend API calls from the SPA are routed to API Gateway.</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">API Gateway first invokes the Lambda authorizer to check that the user has access.</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Authorized calls are forwarded to the serverless Python Lambda.</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">The Lambda caches and retrieves user information in the regional DynamoDB table, which Lambdas in all AZs share.</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">For functionality not migrated yet (e.g., user management), the Lambda calls the legacy Tomcat app on EC2.</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="6" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">The legacy Tomcat app calls back down to the serverless Lambda with the results.</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">American Family Group / Main Street America - Independent Agent Application Modernization (Strangler Pattern)</data>
    <data key="d1">https://www.youtube.com/watch?v=wjtSHyENv0I</data>
    <data key="d2">A legacy Java/Tomcat app for independent insurance agents is being modernized step by step with the strangler pattern. The SPA moved from on-prem Apache to S3 + CloudFront. Backend calls moved from load-balanced on-prem Tomcat servers to API Gateway + Lambda. Functionality that has not been migrated yet (e.g., user management) still runs on Tomcat on EC2. Code moves to the serverless Python stack when there is a new feature, a significant enhancement or a significant bug fix. Results: 25 on-prem servers shut down, user satisfaction up 25%, 10% new users, and lower cost than on-prem servers.</data>
    <data key="d3">Application Modernization, Serverless, Legacy Migration, Web Application, Insurance</data>
    <data key="d4">True</data>
  </graph>
</graphml>
