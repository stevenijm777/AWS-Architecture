<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Infrastructure</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Source servers to be migrated</data>
    </node>
    <node id="1">
      <data key="d5">AWS Application Discovery Service</data>
      <data key="d6">AppDiscovery</data>
      <data key="d7">Gathers TCP inbound and outbound connection data</data>
    </node>
    <node id="2">
      <data key="d5">CloudEndure Replication Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">Receives block-by-block replication</data>
    </node>
    <node id="3">
      <data key="d5">Migration Team</data>
      <data key="d6">UserCompanyAgent</data>
      <data key="d7" />
    </node>
    <node id="4">
      <data key="d5">DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">Stores migration metadata, tags, subnet, and IP config</data>
    </node>
    <node id="5">
      <data key="d5">Slack</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Used by team to initiate migration commands</data>
    </node>
    <node id="6">
      <data key="d5">Migration Factory EC2 Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">Orchestrates discovery, CloudEndure, and target provisioning</data>
    </node>
    <node id="7">
      <data key="d5">CloudEndure</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Live migration service API and console</data>
    </node>
    <node id="8">
      <data key="d5">Target Account EC2</data>
      <data key="d6">EC2</data>
      <data key="d7">Final migrated instance in target account</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">AppDiscovery agent gathers inventory and connection data</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Continuous block-by-block replication to AWS staging</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">AppDiscovery returns inbound and outbound connection info</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Team populates metadata into DynamoDB</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration team issues execution command via Slack</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">Slack triggers Migration Factory EC2 instance</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="1" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration factory requests TCP dependency data</data>
      <data key="d10">2</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">Migration factory orchestrates CloudEndure cutover</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">Shares AMI and provisions instance in target account</data>
      <data key="d10">6</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">CloudEndure status and response to migration factory</data>
      <data key="d10">5</data>
      <data key="d11">meta</data>
    </edge>
    <data key="d0">Automated Cloud Migration with CloudEndure Migration Factory</data>
    <data key="d1">https://www.youtube.com/watch?v=-wLEkq21cvA</data>
    <data key="d2" />
    <data key="d3" />
    <data key="d4">True</data>
  </graph>
