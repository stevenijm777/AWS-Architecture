    <node id="5">
      <data key="d5">Developer / End User</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Accesses the Orion portal to provision environments</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Resolves DNS queries to ALB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Forwards incoming requests to application pods in EKS</data>
