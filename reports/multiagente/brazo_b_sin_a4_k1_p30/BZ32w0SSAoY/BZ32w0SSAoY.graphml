  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User Web Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Accesses service via standard web browser</data>
    </node>
    <node id="1">
      <data key="d5">PixelStrings Server</data>
      <data key="d6">EC2</data>
      <data key="d7">Hosts web server and job manager</data>
    </node>
    <node id="2">
      <data key="d5">Database</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Caches metadata and job state</data>
    </node>
    <node id="3">
      <data key="d5">Customer S3 Bucket</data>
      <data key="d6">S3</data>
      <data key="d7">Stores input and output media clips</data>
    </node>
    <node id="4">
      <data key="d5">Metadata Extraction Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Runs MediaInfo inside Lambda</data>
    </node>
    <node id="5">
      <data key="d5">G3 GPU Processing Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">GPU-enabled instances with asset manager</data>
    </node>
    <node id="6">
      <data key="d5">IMF Processing Instance</data>
      <data key="d6">EC2</data>
      <data key="d7">Handles Interoperable Master Format processing</data>
    </node>
    <edge source="0" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">User uploads input clips to S3 bucket</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User accesses web server to initiate jobs</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Web server returns UI response to browser</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Job manager invokes Lambda to extract media metadata</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Job manager saves metadata to database</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Job manager commands asset manager on G3 cluster to process clip</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Web server reads cached job/clip metadata</data>
      <data key="d10">8</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 returns file header info to Lambda</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset manager copies clip from S3 to G3 local disk</data>
