<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Smart TVs</data>
      <data key="d6">UserConsumerTV</data>
      <data key="d7">Generates telemetry and log data</data>
    </node>
    <node id="1">
      <data key="d5">Kinesis Data Streams</data>
      <data key="d6">KinesisDataStream</data>
      <data key="d7">Ingestion front door</data>
    </node>
    <node id="2">
      <data key="d5">Kinesis Data Firehose</data>
      <data key="d6">Firehose</data>
      <data key="d7">Streams data to Redshift and S3</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7">Data warehouse for analytics</data>
    </node>
    <node id="4">
      <data key="d5">Amazon QuickSight</data>
      <data key="d6">QuickSight</data>
      <data key="d7">Uses in-built SPICE in-memory engine for fast visualization</data>
    </node>
    <node id="5">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Indefinite storage for raw data</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">TVs send log data directly to Kinesis</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Acknowledgement/response back to TVs</data>
      <data key="d10">0'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Data piped from Kinesis Data Streams into Firehose</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose dumps data to S3 for permanent storage</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Firehose loads data into Redshift</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Redshift load status feedback</data>
      <data key="d10">3'</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Redshift returns queried dataset to QuickSight SPICE</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">QuickSight SPICE executes SQL queries against Redshift</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 staging acknowledgement/read</data>
      <data key="d10">2'</data>
      <data key="d11">control</data>
    </edge>
    <data key="d0">Smart TV Telemetry Ingestion and Analytics Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=BlCXEMp_lqY</data>
    <data key="d2" />
    <data key="d3" />
    <data key="d4">True</data>
  </graph>
