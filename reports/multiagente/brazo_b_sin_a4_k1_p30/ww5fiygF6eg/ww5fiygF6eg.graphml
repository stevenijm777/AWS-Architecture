  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Drones</data>
      <data key="d6">UserCompanyDrone</data>
      <data key="d7">Flown by third-party pilots</data>
    </node>
    <node id="1">
      <data key="d5">Third-Party Imagery Software &amp; Server</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Processes raw drone imagery into files per well pad</data>
    </node>
    <node id="2">
      <data key="d5">On-Premises Database &amp; Server</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Hosts mapping software and local database for raster proxies</data>
    </node>
    <node id="3">
      <data key="d5">Amazon CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Triggers the pipeline via scheduled events</data>
    </node>
    <node id="4">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores drone imagery</data>
    </node>
    <node id="5">
      <data key="d5">AWS Storage Gateway</data>
      <data key="d6">StorageGateway</data>
      <data key="d7">Provides on-prem mapping software access to S3 imagery</data>
    </node>
    <node id="6">
      <data key="d5">AWS Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates three Lambda functions</data>
    </node>
    <node id="7">
      <data key="d5">Lambda (Check Status)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Checks third-party API for available images</data>
    </node>
    <node id="8">
      <data key="d5">Lambda (Ingest Imagery)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Downloads images from third party and writes to S3</data>
    </node>
    <node id="9">
      <data key="d5">Lambda (Create Raster Proxies)</data>
      <data key="d6">Lambda</data>
      <data key="d7">Generates raster proxies and updates on-premises database</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Upload drone imagery to third-party software</data>
