    <node id="5">
      <data key="d5">Response Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives rapid job acknowledgement polled by frontend Lambda</data>
    </node>
    <node id="6">
      <data key="d5">EC2 Spot Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Rendering engine running on diversified Spot instances</data>
    </node>
    <node id="7">
      <data key="d5">EC2 Auto Scaling</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Manages Spot fleet diversity and capacity</data>
