      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Entry point for incoming rendering requests</data>
    </node>
    <node id="3">
      <data key="d5">RaaS Frontend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates request payload and checks response queue</data>
