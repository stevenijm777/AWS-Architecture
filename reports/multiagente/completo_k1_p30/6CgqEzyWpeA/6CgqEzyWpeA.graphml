    <node id="8">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores rendered video segments</data>
    </node>
    <node id="9">
      <data key="d5">Auto Scaling Controller Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Custom scaling logic triggered every 15 seconds</data>
    </node>
    <node id="10">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Orchestrates periodic 15-second scaling cycle</data>
    </node>
    <node id="11">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects rendering engine metrics and alerts</data>
    </node>
    <node id="12">
      <data key="d5">CloudWatch Events</data>
      <data key="d6">EventBridge</data>
      <data key="d7">Receives spot termination warning events</data>
