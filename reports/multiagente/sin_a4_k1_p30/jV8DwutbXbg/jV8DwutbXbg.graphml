<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Ingests account update events</data>
    </node>
    <node id="1">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Lean and fast function to fetch transactions and batch</data>
    </node>
    <node id="2">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Stores user transactions queried by Lambda</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Buffers batched transactions (e.g., 100 per batch)</data>
    </node>
    <node id="4">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Executes compiled Antler rules on transaction batches</data>
    </node>
    <node id="5">
      <data key="d5">RDS</data>
      <data key="d6">RDS</data>
      <data key="d7">Receives processed rule outputs</data>
    </node>
    <node id="6">
      <data key="d5">Kinesis</data>
      <data key="d6">Kinesis</data>
      <data key="d7">Receives published event results</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Kinesis stream event triggers first Lambda</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">SQL query to fetch user transactions</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">Batches transactions and publishes messages to SQS queue</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Returns user transactions to Lambda</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Batched messages trigger processing Lambda</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Writes evaluation results to RDS</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Publishes results to outbound Kinesis stream</data>
      <data key="d10">5'</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Event-Driven Batch Rule Processing Pipeline</data>
    <data key="d1">https://www.youtube.com/watch?v=jV8DwutbXbg</data>
    <data key="d2" />
    <data key="d3" />
    <data key="d4">True</data>
  </graph>
</graphml>
