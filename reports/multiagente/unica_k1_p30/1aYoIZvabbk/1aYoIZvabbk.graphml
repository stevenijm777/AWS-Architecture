  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">User</data>
      <data key="d6">UserCompanyDeveloper</data>
      <data key="d7">Requests environment provisioning via Orion portal</data>
    </node>
    <node id="1">
      <data key="d5">Amazon Route 53</data>
      <data key="d6">Route53</data>
      <data key="d7">Handles DNS resolution for Orion portal</data>
    </node>
    <node id="2">
      <data key="d5">Amazon Application Load Balancer</data>
      <data key="d6">ALB</data>
      <data key="d7">Routes incoming traffic to application pods</data>
    </node>
    <node id="3">
      <data key="d5">Amazon EKS</data>
      <data key="d6">EKS</data>
      <data key="d7">Container orchestrator managing 10,000+ pods</data>
    </node>
    <node id="4">
      <data key="d5">Amazon EC2 Spot Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">100% spot instances with AWS Node Termination Handler</data>
    </node>
    <node id="5">
      <data key="d5">Microservice Jobs</data>
      <data key="d6">ThirdParty</data>
      <data key="d7">Kubernetes jobs spinning up microservices (M.S. 1, M.S. 2, M.S. 3)</data>
    </node>
    <node id="6">
      <data key="d5">Amazon SNS</data>
      <data key="d6">SNS</data>
      <data key="d7">Receives events when microservice provisioning jobs start</data>
    </node>
    <node id="7">
      <data key="d5">Amazon SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Maintains job state queue for replacement jobs to track unfinished work</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User accesses Orion portal URL</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DNS resolves to ALB</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">ALB routes environment request to pods on Spot</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">EKS orchestrates pods on underlying Spot nodes</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">0</data>
      <data key="d9">Application pod launches Kubernetes jobs for each microservice</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">Job publishes state event to SNS</data>
      <data key="d10">4</data>
