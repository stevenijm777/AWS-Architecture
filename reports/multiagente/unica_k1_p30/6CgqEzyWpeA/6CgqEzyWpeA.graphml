      <data key="d5">API Gateway</data>
      <data key="d6">ApiGateway</data>
      <data key="d7">Configured with usage plans and API keys to control load</data>
    </node>
    <node id="2">
      <data key="d5">RAS Frontend Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Validates requests and returns playlist link</data>
    </node>
    <node id="3">
      <data key="d5">Rendering Instructions Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Holds rendering instructions for engine instances</data>
    </node>
    <node id="4">
      <data key="d5">Response Queue</data>
      <data key="d6">SQS</data>
      <data key="d7">Receives immediate responses polled by frontend Lambda</data>
    </node>
    <node id="5">
      <data key="d5">Rendering Engine Instances</data>
      <data key="d6">EC2</data>
      <data key="d7">Spot instances across multiple AZs with diversified types</data>
    </node>
    <node id="6">
      <data key="d5">Auto Scaling Group</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">Manages spot instance fleet</data>
    </node>
    <node id="7">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Stores uploaded video segments</data>
    </node>
    <node id="8">
      <data key="d5">CloudFront</data>
      <data key="d6">CloudFront</data>
      <data key="d7">Pulls video segments from S3 origin to play to user</data>
    </node>
    <node id="9">
      <data key="d5">Step Functions</data>
      <data key="d6">StepFunctions</data>
      <data key="d7">Triggers scaling Lambda every 15 seconds</data>
    </node>
    <node id="10">
      <data key="d5">Scaling Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Consumes metrics and scales the Auto Scaling group</data>
    </node>
    <node id="11">
      <data key="d5">CloudWatch</data>
      <data key="d6">CloudWatch</data>
      <data key="d7">Collects rendering metrics and issues spot interruption events</data>
    </node>
    <node id="12">
      <data key="d5">Interruption Handler Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Handles spot interruption notices and signals instance to drain</data>
