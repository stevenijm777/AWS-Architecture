<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">Web Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">Chrome recommended; used to access platform and configure workflows</data>
    </node>
    <node id="1">
      <data key="d5">Web Server / Job Manager</data>
      <data key="d6">EC2</data>
      <data key="d7">Single instance handling UI (~100 users) and orchestrating jobs</data>
    </node>
    <node id="2">
      <data key="d5">Database</data>
      <data key="d6">RDS</data>
      <data key="d7">Caches and stores video clip metadata</data>
    </node>
    <node id="3">
      <data key="d5">AWS Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Runs MediaInfo to inspect video clips and extract metadata</data>
    </node>
    <node id="4">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">Customer-managed bucket storing input clips and processed output</data>
    </node>
    <node id="5">
      <data key="d5">G3 GPU Cluster</data>
      <data key="d6">EC2</data>
      <data key="d7">Runs Asset Manager, Wormhole, Spacetime, Dark Energy; up to 200 jobs per region</data>
    </node>
    <node id="6">
      <data key="d5">IMF</data>
      <data key="d6">EC2</data>
      <data key="d7">Interoperable Master Format wrapping instance</data>
    </node>
    <edge source="0" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">User uploads input video clips to customer S3 bucket</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">User connects to web server and enters S3 bucket keys</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="1" target="0" id="0">
      <data key="d8">0</data>
      <data key="d9">Web server delivers UI and populates metadata in browser</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">Job Manager saves extracted metadata into the database</data>
      <data key="d10">6</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Job Manager submits parallel processing jobs and instructs Asset Manager</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="2" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Web Server queries cached metadata from the database</data>
      <data key="d10">7</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda accesses clips in S3 bucket to extract metadata</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="3" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Lambda delivers extracted metadata back to Job Manager</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">S3 returns clip info to Lambda function</data>
      <data key="d10">4</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset Manager copies input clip from S3 to G3 local disk</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">Asset Manager copies processed output clip back to S3 bucket</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">2</data>
      <data key="d9">G3 sends encoded output to IMF for IMF wrapping</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Cinefilm PixelStrings Video Processing Platform</data>
    <data key="d1">https://www.youtube.com/watch?v=BZ32w0SSAoY</data>
    <data key="d2" />
    <data key="d3" />
    <data key="d4">True</data>
  </graph>
</graphml>
