  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">CLI</data>
      <data key="d6">UserConsumerDeveloper</data>
      <data key="d7">Developer deploying app code</data>
    </node>
    <node id="1">
      <data key="d5">EC2 (Deployment Service)</data>
      <data key="d6">EC2</data>
      <data key="d7">Deployment ingestion service</data>
