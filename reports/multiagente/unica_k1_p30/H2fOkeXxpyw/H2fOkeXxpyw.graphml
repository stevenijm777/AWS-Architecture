      <data key="d7">Stores deployment state and progress</data>
    </node>
    <node id="3">
      <data key="d5">SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">Queues deployment requests to avoid Lambda control plane rate limits</data>
    </node>
    <node id="4">
      <data key="d5">EC2 (Lambda Creation Service)</data>
      <data key="d6">EC2</data>
      <data key="d7">Reads requests from SQS and creates Lambdas</data>
    </node>
    <node id="5">
      <data key="d5">Browser</data>
      <data key="d6">UserConsumerWeb</data>
      <data key="d7">End user browser client</data>
    </node>
    <node id="6">
      <data key="d5">EC2 (Invocation Service)</data>
      <data key="d6">EC2</data>
      <data key="d7">Checks permissions and routes invocation to appropriate Lambda</data>
    </node>
    <node id="7">
      <data key="d5">Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">Multi-tenant Lambda running V8 isolates per customer request in dedicated account</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">CLI deploys code to deployment service</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
