      <data key="d9">Backend service polls/reads deployment requests from SQS</data>
      <data key="d10">3</data>
      <data key="d11">control</data>
    </edge>
    <edge source="4" target="7" id="0">
      <data key="d8">0</data>
      <data key="d9">Creates and configures Lambda function in customer account</data>
      <data key="d10">4</data>
