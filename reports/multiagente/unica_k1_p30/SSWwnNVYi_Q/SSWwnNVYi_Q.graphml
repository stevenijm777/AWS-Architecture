    <node id="7">
      <data key="d5">EC2</data>
      <data key="d6">EC2</data>
      <data key="d7" />
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">Users log in to Guacamole gateway</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
