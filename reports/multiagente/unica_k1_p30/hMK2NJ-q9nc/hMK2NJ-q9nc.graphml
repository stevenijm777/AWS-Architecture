<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">S3</data>
      <data key="d6">S3</data>
      <data key="d7">stores linear master files for all brands</data>
    </node>
    <node id="1">
      <data key="d5">Auto Scaling Group</data>
      <data key="d6">AutoScaling</data>
      <data key="d7">supports primary and backup EC2 playout instances</data>
    </node>
    <node id="2">
      <data key="d5">EC2 (Evertz ORT)</data>
      <data key="d6">EC2</data>
      <data key="d7">10 channels per AZ across 3 AZs; primary and backup running Evertz ORT and playtime software</data>
    </node>
    <node id="3">
      <data key="d5">Direct Connect</data>
      <data key="d6">DirectConnect</data>
      <data key="d7">transports unicast playout signal back to on-prem facilities</data>
    </node>
    <node id="4">
      <data key="d5">TWD / CNN Center</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">Techwood and CNN Center playout facility with auto changeover switch for tertiary X chain</data>
    </node>
    <node id="5">
      <data key="d5">NYC Uplink</data>
      <data key="d6">UserConsumerSatellite</data>
      <data key="d7">Hudson Yards BCP uplink feeding 8 channels</data>
    </node>
    <node id="6">
      <data key="d5">ATL Uplink</data>
      <data key="d6">UserConsumerSatellite</data>
      <data key="d7">Atlanta uplink distributing playout signal to affiliates</data>
    </node>
    <edge source="0" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">master files transferred to local EC2 instances running Evertz ORT</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">playout stream sent as unicast signal across Direct Connect</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">tertiary X chain path sent to on-prem changeover switch at Techwood / CNN Center</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="5" id="0">
      <data key="d8">1</data>
      <data key="d9">BCP stream sends 8 channels to Hudson Yards uplink</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="6" id="0">
      <data key="d8">0</data>
      <data key="d9">signal compressed and sent to uplink for affiliate distribution</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">WarnerMedia HBO Cloud Linear Playout Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=hMK2NJ-q9nc</data>
    <data key="d2" />
    <data key="d3" />
    <data key="d4">True</data>
  </graph>
</graphml>
