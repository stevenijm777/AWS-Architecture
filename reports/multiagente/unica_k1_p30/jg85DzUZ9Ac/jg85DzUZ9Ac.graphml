<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d11" for="edge" attr.name="type" attr.type="string" />
  <key id="d10" for="edge" attr.name="seq" attr.type="string" />
  <key id="d9" for="edge" attr.name="notes" attr.type="string" />
  <key id="d8" for="edge" attr.name="flow_id" attr.type="long" />
  <key id="d7" for="node" attr.name="notes" attr.type="string" />
  <key id="d6" for="node" attr.name="service" attr.type="string" />
  <key id="d5" for="node" attr.name="name" attr.type="string" />
  <key id="d4" for="graph" attr.name="graph_usable" attr.type="boolean" />
  <key id="d3" for="graph" attr.name="categories" attr.type="string" />
  <key id="d2" for="graph" attr.name="notes" attr.type="string" />
  <key id="d1" for="graph" attr.name="link" attr.type="string" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="0">
      <data key="d5">On-Premises Database</data>
      <data key="d6">OnPremDC</data>
      <data key="d7">stores sales data at invoice level</data>
    </node>
    <node id="1">
      <data key="d5">VPN</data>
      <data key="d6">VPN</data>
      <data key="d7" />
    </node>
    <node id="2">
      <data key="d5">AWS DMS</data>
      <data key="d6">DMS</data>
      <data key="d7">uses CDC</data>
    </node>
    <node id="3">
      <data key="d5">Amazon Redshift</data>
      <data key="d6">RedShift</data>
      <data key="d7" />
    </node>
    <node id="4">
      <data key="d5">Data Lake</data>
      <data key="d6">LakeFormation</data>
      <data key="d7">raw and refined S3 buckets</data>
    </node>
    <node id="5">
      <data key="d5">Amazon S3</data>
      <data key="d6">S3</data>
      <data key="d7">drop bucket for flat files</data>
    </node>
    <node id="6">
      <data key="d5">Amazon SQS</data>
      <data key="d6">SQS</data>
      <data key="d7">handles messaging services</data>
    </node>
    <node id="7">
      <data key="d5">Initiator Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7" />
    </node>
    <node id="8">
      <data key="d5">Amazon DynamoDB</data>
      <data key="d6">DynamoDB</data>
      <data key="d7">stores file metadata</data>
    </node>
    <node id="9">
      <data key="d5">Complex Lambda</data>
      <data key="d6">Lambda</data>
      <data key="d7">merges datasets and applies Python stats models</data>
    </node>
    <edge source="0" target="1" id="0">
      <data key="d8">0</data>
      <data key="d9">pipes sales data through VPN</data>
      <data key="d10">0</data>
      <data key="d11">data</data>
    </edge>
    <edge source="1" target="2" id="0">
      <data key="d8">0</data>
      <data key="d9">DMS pulls data across VPN via CDC</data>
      <data key="d10">1</data>
      <data key="d11">data</data>
    </edge>
    <edge source="2" target="3" id="0">
      <data key="d8">0</data>
      <data key="d9">populates Redshift cluster</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="3" target="4" id="0">
      <data key="d8">0</data>
      <data key="d9">makes data available to data lake</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="4" target="9" id="0">
      <data key="d8">1</data>
      <data key="d9">event-driven S3 trigger launches complex Lambda</data>
      <data key="d10">4</data>
      <data key="d11">control</data>
    </edge>
    <edge source="5" target="6" id="0">
      <data key="d8">1</data>
      <data key="d9">lands flat files and kicks off SQS message</data>
      <data key="d10">0</data>
      <data key="d11">control</data>
    </edge>
    <edge source="6" target="7" id="0">
      <data key="d8">1</data>
      <data key="d9">launches initiator Lambda job</data>
      <data key="d10">1</data>
      <data key="d11">control</data>
    </edge>
    <edge source="7" target="8" id="0">
      <data key="d8">1</data>
      <data key="d9">queries DynamoDB for file metadata</data>
      <data key="d10">2</data>
      <data key="d11">data</data>
    </edge>
    <edge source="7" target="4" id="0">
      <data key="d8">1</data>
      <data key="d9">populates raw and refined data lake structures</data>
      <data key="d10">3</data>
      <data key="d11">data</data>
    </edge>
    <edge source="9" target="3" id="0">
      <data key="d8">1</data>
      <data key="d9">feeds merged demand analytics back into Redshift</data>
      <data key="d10">5</data>
      <data key="d11">data</data>
    </edge>
    <data key="d0">Veritiv Serverless Data Lake and Demand Analytics Architecture</data>
    <data key="d1">https://www.youtube.com/watch?v=jg85DzUZ9Ac</data>
    <data key="d2" />
    <data key="d3" />
    <data key="d4">True</data>
  </graph>
</graphml>
